;; Run with ./otium benchmarks/loops.ot.
;; Each row reports nanoseconds and allocated bytes per 128-element call.
(require otium.memory :as memory)

(def n 128)

(def repetitions 100000)

(def items (range n))

(def linked
  (let loop ((i (- n 1))
             (out '()))
    (if (< i 0)
        out
        (loop (- i 1) (cons i out)))))

(def (pass x)
  x)

(def (keep? x)
  (< x 64))

(def (measure name work)
  (let warm ((i 0))
    (when (< i 1000)
      (work)
      (warm (+ i 1))))
  (let samples ((sample 0))
    (when (< sample 5)
      (let ((start (current-jiffy))
            (bytes (memory/allocated)))
        (let repeat ((i 0))
          (when (< i repetitions)
            (work)
            (repeat (+ i 1))))
        (let ((used (- (memory/allocated) bytes))
              (elapsed (- (current-jiffy) start)))
          (println name
                   " "
                   (/ (* elapsed 1000000000.0) (* repetitions (jiffies-per-second)))
                   " "
                   (/ used (inexact repetitions)))))
      (samples (+ sample 1)))))

(measure "while" (fn () (let ((i 0)) (while (< i n) (set! i (+ i 1))))))
(measure "named-while" (fn () (let loop ((i 0)) (when (< i n) (loop (+ i 1))))))
(measure "dotimes"
         (fn ()
           (dotimes (i n)
             (pass i))))
(measure "named-loop"
         (fn ()
           (let loop ((i 0))
             (when (< i n)
               (pass i)
               (loop (+ i 1))))))
(measure "for-range"
         (fn ()
           (for ((i :range n))
             (pass i))))
(measure "reduce-list" (fn () (reduce + 0 linked)))
(measure "reduce-array" (fn () (reduce + 0 items)))
(measure "named-reduce-list"
         (fn ()
           (let loop ((xs linked)
                      (acc 0))
             (if (null? xs)
                 acc
                 (loop (cdr xs) (+ acc (car xs)))))))
(measure "named-reduce-array"
         (fn ()
           (let loop ((i 0)
                      (acc 0))
             (if (= i n)
                 acc
                 (loop (+ i 1) (+ acc (get items i)))))))
(measure "for-sum-list" (fn () (for ((x :in linked) (total :sum x)) => total)))
(measure "for-sum-array" (fn () (for ((x :in items) (total :sum x)) => total)))
(measure "range" (fn () (range n)))
(measure "named-range"
         (fn ()
           (let ((out (array)))
             (let loop ((i 0))
               (when (< i n)
                 (push! out i)
                 (loop (+ i 1))))
             out)))
(measure "for-each-list" (fn () (for-each pass linked)))
(measure "for-each-array" (fn () (for-each pass items)))
(measure "named-each-list"
         (fn ()
           (let loop ((xs linked))
             (unless (null? xs)
               (pass (car xs))
               (loop (cdr xs))))))
(measure "named-each-array"
         (fn ()
           (let loop ((i 0))
             (when (< i n)
               (pass (get items i))
               (loop (+ i 1))))))
(measure "for-in-list"
         (fn ()
           (for ((x :in linked))
             (pass x))))
(measure "for-in-array"
         (fn ()
           (for ((x :in items))
             (pass x))))
(measure "for-named-list"
         (fn ()
           (for next ((x :in linked))
             (pass x)
             (if (keep? x)
                 (next)
                 (next)))))
(measure "map-list" (fn () (map pass linked)))
(measure "map-array" (fn () (map pass items)))
(measure "named-map-list"
         (fn ()
           (let loop ((xs linked)
                      (out '()))
             (if (null? xs)
                 (reverse out)
                 (loop (cdr xs) (cons (pass (car xs)) out))))))
(measure "named-map-array"
         (fn ()
           (let ((out (array)))
             (let loop ((i 0))
               (when (< i n)
                 (push! out (pass (get items i)))
                 (loop (+ i 1))))
             out)))
(measure "for-collect-list" (fn () (for ((x :in linked) (out :collect (pass x))) => out)))
(measure "for-collect-array" (fn () (for ((x :in items) (out :collect (pass x))) => out)))
(measure "for-collect-array-array" (fn () (for ((x :in items) (out :collect-array (pass x))) => out)))
(measure "filter-list" (fn () (filter keep? linked)))
(measure "filter-array" (fn () (filter keep? items)))
(measure "named-filter-list"
         (fn ()
           (let loop ((xs linked)
                      (out '()))
             (if (null? xs)
                 (reverse out)
                 (loop (cdr xs)
                       (if (keep? (car xs))
                           (cons (car xs) out)
                           out))))))
(measure "named-filter-array"
         (fn ()
           (let ((out (array)))
             (let loop ((i 0))
               (when (< i n)
                 (let ((x (get items i))) (when (keep? x) (push! out x)))
                 (loop (+ i 1))))
             out)))
(measure "for-filter-list" (fn () (for ((x :in linked) (out :collect x :when (keep? x))) => out)))
(measure "for-filter-array" (fn () (for ((x :in items) (out :collect x :when (keep? x))) => out)))
