;; fannkuch-redux: count pancake flips over every permutation. Upstream's only
;; reference is a four-thread SBCL program that generates specialised code;
;; this is the usual single-threaded algorithm, visiting permutations in the
;; same order so the checksum matches.
(require plb.support :as support)

(def (fannkuch n)
  (let ((perm1 (for ((i :range n) (out :collect-array i)) => out))
        (perm (copy perm1))
        (count (copy perm1))
        (max-flips 0)
        (checksum 0)
        (permutation 0)
        (r n)
        (done #f))
    (while (not done)
      (while (> r 1)
        (put! count (- r 1) r)
        (set! r (- r 1)))
      (dotimes (i n)
        (put! perm i (get perm1 i)))
      (let ((flips 0)
            (k (get perm 0)))
        (while (> k 0)
          (let ((i 0)
                (j k))
            (while (< i j)
              (let ((swap (get perm i)))
                (put! perm i (get perm j))
                (put! perm j swap))
              (set! i (+ i 1))
              (set! j (- j 1))))
          (set! flips (+ flips 1))
          (set! k (get perm 0)))
        (set! max-flips (max max-flips flips))
        (set! checksum
              (if (even? permutation)
                  (+ checksum flips)
                  (- checksum flips))))
      ;; Rotate the first r+1 elements until a count is still positive.
      (let ((advanced #f))
        (while (not advanced)
          (if (= r n)
              (begin
                (set! done #t)
                (set! advanced #t))
              (let ((first (get perm1 0)))
                (dotimes (i r)
                  (put! perm1 i (get perm1 (+ i 1))))
                (put! perm1 r first)
                (put! count r (- (get count r) 1))
                (if (> (get count r) 0)
                    (set! advanced #t)
                    (set! r (+ r 1)))))))
      (set! permutation (+ permutation 1)))
    (println checksum)
    (println (str "Pfannkuchen(" n ") = " max-flips))))

(fannkuch (support/argument 0 7))
