;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Tests of string <-> bytevector conversions.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def failed-tests '())

(def (test name actual expected)
  (unless (equal? actual expected)
    (display "******** FAILED TEST ******** ")
    (display name)
    (newline)
    (set! failed-tests (cons name failed-tests))))

(def (string-bytevector-tests random-stress-tests random-stress-test-max-size)
  ;; lint: allow(liftable-function) Preserve the upstream local test helper.
  (def (test-roundtrip bvec tostring tobvec)
    (let ((s1 (tostring bvec))
          (b2 (tobvec s1))
          (s2 (tostring b2)))
      (test "round trip of string conversion" (string=? s1 s2) #t)))

  (def random
    (let ((a 701)
          (x 1)
          (c 743483)
          (m 524287))
      (def (random14 n)
        (set! x (remainder (+ (* a x) c) (+ m 1)))
        (remainder (quotient x 8) n))
      (def (loop q r n)
        (if (zero? q)
            (remainder r n)
            (loop (quotient q 16384) (+ (* 16384 r) (random14 16384)) n)))
      (fn (n)
        (if (< n 16384)
            (random14 n)
            (loop (quotient n 16384) (random14 16384) n)))))

  (def (random-bytevector n)
    (let ((size (random n))
          (bv (make-bytevector size)))
      (dotimes (i size)
        (bytevector-u8-set! bv i (random 128)))
      bv))

  ;; lint: allow(unused-binding) Retain the upstream unused even-length helper.
  (def (random-bytevector2 n)
    (let ((size (random n))
          (size (if (odd? size)
                    (+ size 1)
                    size))
          (bv (make-bytevector size)))
      (dotimes (i size)
        (bytevector-u8-set! bv i (random 128)))
      bv))

  ;; lint: allow(unused-binding) Retain the upstream unused multiple-of-four helper.
  (def (random-bytevector4 n)
    (let ((size (random n))
          (size (* 4 (exact (round (/ size 4)))))
          (bv (make-bytevector size)))
      (dotimes (i size)
        (bytevector-u8-set! bv i (random 128)))
      bv))

  (test-roundtrip (random-bytevector 10) utf8->string string->utf8)
  (dotimes (i random-stress-tests)
    (test-roundtrip (random-bytevector random-stress-test-max-size) utf8->string string->utf8)))

(def (benchmark-main)
  (let ((count (bench-read))
        (input1 (bench-read))
        (input2 (bench-read))
        (output (bench-read)))
    (run-ported-benchmark (str "bv2string:" input1 ":" input2 ":" count)
                          count
                          (fn ()
                            (string-bytevector-tests (bench-hide count input1) (bench-hide count input2))
                            (length failed-tests))
                          (fn (result) (equal? result output)))))
