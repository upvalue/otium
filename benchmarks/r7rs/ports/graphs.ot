;;;; ==== util.ss ====

;; Fold over list elements, associating to the left.
(def fold
  (fn (lst folder state)
    ;;        (assert (list? lst)
    ;;            lst)
    ;;        (assert (procedure? folder)
    ;;            folder)
    (let loop-1 ((lst lst)
                 (state state))
      (if (null? lst)
          (begin state)
          (begin (loop-1 (cdr lst) (folder (car lst) state)))))))

;; Given the size of a vector and a procedure which
;; sends indicies to desired vector elements, create
;; and return the vector.
(def proc->vector
  (fn (size f)
    ;;    (assert (and (integer? size)
    ;;                 (exact? size)
    ;;                 (>= size 0))
    ;;      size)
    ;;    (assert (procedure? f)
    ;;      f)
    (if (zero? size)
        (array)
        (let ((x (bench-make-array size (f 0))))
          (let loop ((i 1))
            (when (< i size)
              (put! x i (f i))
              (loop (+ i 1))))
          x))))

(def vector-fold
  (fn (vec folder state)
    ;;        (assert (vector? vec)
    ;;            vec)
    ;;        (assert (procedure? folder)
    ;;            folder)
    (let ((len (length vec)))
      (let loop-2 ((i 0)
                   (state state))
        (if (= i len)
            (begin state)
            (begin (loop-2 (+ i 1) (folder (get vec i) state))))))))

;; AZIZ: rnrs has vector-map, this is not even used
;;(define vector-map
;;    (lambda (vec proc)
;;        (proc->vector (vector-length vec)
;;            (lambda (i)
;;                (proc (vector-ref vec i))))))

;; Given limit, return the list 0, 1, ..., limit-1.
(def giota
  (fn (limit)
    ;;        (assert (and (integer? limit)
    ;;                (exact? limit)
    ;;                (>= limit 0))
    ;;            limit)
    (let _-*- ((limit limit)
               (res '()))
      (if (zero? limit)
          res
          (let ((limit (- limit 1))) (_-*- limit (cons limit res)))))))

;; Fold over the integers [0, limit).
(def gnatural-fold
  (fn (limit folder state)
    ;;        (assert (and (integer? limit)
    ;;                (exact? limit)
    ;;                (>= limit 0))
    ;;            limit)
    ;;        (assert (procedure? folder)
    ;;            folder)
    (let loop-3 ((i 0)
                 (state state))
      (if (= i limit)
          (begin state)
          (begin (loop-3 (+ i 1) (folder i state)))))))

;; Iterate over the integers [0, limit).
(def gnatural-for-each
  (fn (limit proc!)
    ;;        (assert (and (integer? limit)
    ;;                (exact? limit)
    ;;                (>= limit 0))
    ;;            limit)
    ;;        (assert (procedure? proc!)
    ;;            proc!)
    (let loop-4 ((i 0))
      (if (= i limit)
          nil
          (begin
            (proc! i)
            (loop-4 (+ i 1)))))))

(def natural-for-all?
  (fn (limit ok?)
    ;;        (assert (and (integer? limit)
    ;;                (exact? limit)
    ;;                (>= limit 0))
    ;;            limit)
    ;;        (assert (procedure? ok?)
    ;;            ok?)
    (let _-*- ((i 0)) (or (= i limit) (and (ok? i) (_-*- (+ i 1)))))))

(def natural-there-exists?
  (fn (limit ok?)
    ;;        (assert (and (integer? limit)
    ;;                (exact? limit)
    ;;                (>= limit 0))
    ;;            limit)
    ;;        (assert (procedure? ok?)
    ;;            ok?)
    (let _-*- ((i 0)) (and (not (= i limit)) (or (ok? i) (_-*- (+ i 1)))))))

(def there-exists?
  (fn (lst ok?)
    ;;        (assert (list? lst)
    ;;            lst)
    ;;        (assert (procedure? ok?)
    ;;            ok?)
    (let _-*- ((lst lst)) (and (not (null? lst)) (or (ok? (car lst)) (_-*- (cdr lst)))))))

;;; ==== ptfold.ss ====

;; Fold over the tree of permutations of a universe.
;; Each branch (from the root) is a permutation of universe.
;; Each node at depth d corresponds to all permutations which pick the
;; elements spelled out on the branch from the root to that node as
;; the first d elements.
;; Their are two components to the state:
;;       The b-state is only a function of the branch from the root.
;;       The t-state is a function of all nodes seen so far.
;; At each node, b-folder is called via
;;       (b-folder elem b-state t-state deeper accross)
;; where elem is the next element of the universe picked.
;; If b-folder can determine the result of the total tree fold at this stage,
;; it should simply return the result.
;; If b-folder can determine the result of folding over the sub-tree
;; rooted at the resulting node, it should call accross via
;;       (accross new-t-state)
;; where new-t-state is that result.
;; Otherwise, b-folder should call deeper via
;;       (deeper new-b-state new-t-state)
;; where new-b-state is the b-state for the new node and new-t-state is
;; the new folded t-state.
;; At the leaves of the tree, t-folder is called via
;;       (t-folder b-state t-state accross)
;; If t-folder can determine the result of the total tree fold at this stage,
;; it should simply return that result.
;; If not, it should call accross via
;;       (accross new-t-state)
;; Note, fold-over-perm-tree always calls b-folder in depth-first order.
;; I.e., when b-folder is called at depth d, the branch leading to that
;; node is the most recent calls to b-folder at all the depths less than d.
;; This is a gross efficiency hack so that b-folder can use mutation to
;; keep the current branch.
(def fold-over-perm-tree
  (fn (universe b-folder b-state t-folder t-state)
    ;;        (assert (list? universe)
    ;;            universe)
    ;;        (assert (procedure? b-folder)
    ;;            b-folder)
    ;;        (assert (procedure? t-folder)
    ;;            t-folder)
    (let _-*- ((universe universe)
               (b-state b-state)
               (t-state t-state)
               (accross (fn (final-t-state) final-t-state)))
      (if (null? universe)
          (t-folder b-state t-state accross)
          (let _-**- ((in universe)
                      (out '())
                      (t-state t-state))
            (let ((first (car in))
                  (rest (cdr in))
                  (accross (if (null? rest)
                               accross
                               (fn (new-t-state) (_-**- rest (cons first out) new-t-state)))))
              (b-folder first
                        b-state
                        t-state
                        (fn (new-b-state new-t-state) (_-*- (fold out cons rest) new-b-state new-t-state accross))
                        accross)))))))

;;; ==== minimal.ss ====

;; A directed graph is stored as a connection matrix (vector-of-vectors)
;; where the first index is the `from' vertex and the second is the `to'
;; vertex.  Each entry is a bool indicating if the edge exists.
;; The diagonal of the matrix is never examined.
;; Make-minimal? returns a procedure which tests if a labelling
;; of the verticies is such that the matrix is minimal.
;; If it is, then the procedure returns the result of folding over
;; the elements of the automoriphism group.  If not, it returns #f.
;; The folding is done by calling folder via
;;       (folder perm state accross)
;; If the folder wants to continue, it should call accross via
;;       (accross new-state)
;; If it just wants the entire minimal? procedure to return something,
;; it should return that.
;; The ordering used is lexicographic (with #t > #f) and entries
;; are examined in the following order:
;;       1->0, 0->1
;;
;;       2->0, 0->2
;;       2->1, 1->2
;;
;;       3->0, 0->3
;;       3->1, 1->3
;;       3->2, 2->3
;;       ...
(def make-minimal?
  (fn (max-size)
    ;;        (assert (and (integer? max-size)
    ;;                (exact? max-size)
    ;;                (>= max-size 0))
    ;;            max-size)
    (let ((iotas (proc->vector (+ max-size 1) giota))
          (perm (bench-make-array max-size 0)))
      (fn (size graph folder state)
        ;;                (assert (and (integer? size)
        ;;                        (exact? size)
        ;;                        (<= 0 size max-size))
        ;;                    size
        ;;                    max-size)
        ;;                (assert (vector? graph)
        ;;                    graph)
        ;;                (assert (procedure? folder)
        ;;                    folder)
        (fold-over-perm-tree (get iotas size)
                             (fn (perm-x x state deeper accross)
                               (case (cmp-next-vertex graph perm x perm-x)
                                 ((less) #f)
                                 ((equal) (put! perm x perm-x) (deeper (+ x 1) state))
                                 ((more) (accross state))
                                 (else
                                   ;;                                (assert #f)
                                   (error #f "???"))))
                             0
                             (fn (_leaf-depth state accross)
                               ;;                        (assert (eqv? leaf-depth size)
                               ;;                            leaf-depth
                               ;;                            size)
                               (folder perm state accross))
                             state)))))

;; Given a graph, a partial permutation vector, the next input and the next
;; output, return 'less, 'equal or 'more depending on the lexicographic
;; comparison between the permuted and un-permuted graph.
(def cmp-next-vertex
  (fn (graph perm x perm-x)
    (let ((from-x (get graph x))
          (from-perm-x (get graph perm-x)))
      (let _-*- ((y 0))
        (if (= x y)
            'equal
            (let ((x->y? (get from-x y))
                  (perm-y (get perm y)))
              (cond
                ((eq? x->y? (get from-perm-x perm-y))
                 (let ((y->x? (get (get graph y) x)))
                   (cond
                     ((eq? y->x? (get (get graph perm-y) perm-x)) (_-*- (+ y 1)))
                     (y->x? 'less)
                     (else 'more))))
                (x->y? 'less)
                (else 'more))))))))

;;; ==== rdg.ss ====

;; Fold over rooted directed graphs with bounded out-degree.
;; Size is the number of verticies (including the root).  Max-out is the
;; maximum out-degree for any vertex.  Folder is called via
;;       (folder edges state)
;; where edges is a list of length size.  The ith element of the list is
;; a list of the verticies j for which there is an edge from i to j.
;; The last vertex is the root.
(def fold-over-rdg
  (fn (size max-out folder state)
    ;;        (assert (and (exact? size)
    ;;                (integer? size)
    ;;                (> size 0))
    ;;            size)
    ;;        (assert (and (exact? max-out)
    ;;                (integer? max-out)
    ;;                (>= max-out 0))
    ;;            max-out)
    ;;        (assert (procedure? folder)
    ;;            folder)
    (let ((root (- size 1))
          (edge? (proc->vector size (fn (_from) (bench-make-array size #f))))
          (edges (bench-make-array size '()))
          (out-degrees (bench-make-array size 0))
          (minimal-folder (make-minimal? root))
          (non-root-minimal? (let ((cont (fn (_perm _state accross)
                                           ;;                                    (assert (eq? state #t)
                                           ;;                                        state)
                                           (accross #t))))
                               (fn (size) (minimal-folder size edge? cont #t))))
          (root-minimal? (let ((cont (fn (perm _state accross)
                                       ;;                                    (assert (eq? state #t)
                                       ;;                                        state)
                                       (case (cmp-next-vertex edge? perm root root)
                                         ((less) #f)
                                         ((equal more) (accross #t))
                                         (else
                                           ;;                                            (assert #f)
                                           (error #f "???"))))))
                           (fn () (minimal-folder root edge? cont #t)))))
      (let _-*- ((vertex 0)
                 (state state))
        (cond
          ((not (non-root-minimal? vertex)) state)
          ((= vertex root)
           ;;                        (assert
           ;;                            (begin
           ;;                                (gnatural-for-each root
           ;;                                    (lambda (v)
           ;;                                        (assert (= (vector-ref out-degrees v)
           ;;                                                (length (vector-ref edges v)))
           ;;                                            v
           ;;                                            (vector-ref out-degrees v)
           ;;                                            (vector-ref edges v))))
           ;;                                #t))
           (let ((reach? (make-reach? root edges))
                 (from-root (get edge? root)))
             (let _-*- ((v 0)
                        (outs 0)
                        (efr '())
                        (efrr '())
                        (state state))
               (cond
                 ((not (or (= v root) (= outs max-out)))
                  (put! from-root v #t)
                  (let ((state (_-*- (+ v 1) (+ outs 1) (cons v efr) (cons (get reach? v) efrr) state)))
                    (put! from-root v #f)
                    (_-*- (+ v 1) outs efr efrr state)))
                 ((and (natural-for-all? root (fn (v) (there-exists? efrr (fn (r) (get r v))))) (root-minimal?))
                  (put! edges root efr)
                  (folder (proc->vector size (fn (i) (get edges i))) state))
                 (else state)))))
          (else (let ((from-vertex (get edge? vertex)))
                  (let _-**- ((sv 0)
                              (outs 0)
                              (state state))
                    (if (= sv vertex)
                        (begin
                          (put! out-degrees vertex outs)
                          (_-*- (+ vertex 1) state))
                        (let ((state
                                ;; no sv->vertex, no vertex->sv
                                (_-**- (+ sv 1) outs state))
                              (from-sv (get edge? sv))
                              (sv-out (get out-degrees sv))
                              (state (if (= sv-out max-out)
                                         state
                                         (begin
                                           (put! edges sv (cons vertex (get edges sv)))
                                           (put! from-sv vertex #t)
                                           (put! out-degrees sv (+ sv-out 1))
                                           (let ((state
                                                   ;; sv->vertex, no vertex->sv
                                                   (_-**- (+ sv 1) outs state))
                                                 (state (if (= outs max-out)
                                                            state
                                                            (begin
                                                              (put! from-vertex sv #t)
                                                              (put! edges vertex (cons sv (get edges vertex)))
                                                              (let ((state
                                                                      ;; sv->vertex, vertex->sv
                                                                      (_-**- (+ sv 1) (+ outs 1) state)))
                                                                (put! edges vertex (cdr (get edges vertex)))
                                                                (put! from-vertex sv #f)
                                                                state)))))
                                             (put! out-degrees sv sv-out)
                                             (put! from-sv vertex #f)
                                             (put! edges sv (cdr (get edges sv)))
                                             state)))))
                          (if (= outs max-out)
                              state
                              (begin
                                (put! edges vertex (cons sv (get edges vertex)))
                                (put! from-vertex sv #t)
                                (let ((state
                                        ;; no sv->vertex, vertex->sv
                                        (_-**- (+ sv 1) (+ outs 1) state)))
                                  (put! from-vertex sv #f)
                                  (put! edges vertex (cdr (get edges vertex)))
                                  state)))))))))))))

;; Given a vector which maps vertex to out-going-edge list,
;; return a vector  which gives reachability.
(def make-reach?
  (fn (size vertex->out)
    (let ((res (proc->vector size
                             (fn (v)
                               (let ((from-v (bench-make-array size #f)))
                                 (put! from-v v #t)
                                 (for-each (fn (x) (put! from-v x #t)) (get vertex->out v))
                                 from-v)))))
      (gnatural-for-each size
                         (fn (m)
                           (let ((from-m (get res m)))
                             (gnatural-for-each size
                                                (fn (f)
                                                  (let ((from-f (get res f)))
                                                    (when (get from-f m)
                                                      (gnatural-for-each size
                                                                         (fn (t)
                                                                           (when (get from-m t)
                                                                             (put! from-f t #t)))))))))))
      res)))

;;; ==== test input ====

;; Produces all directed graphs with N verticies, distinguished root,
;; and out-degree bounded by 2, upto isomorphism.

(def (run n)
  (fold-over-rdg n 2 cons '()))

(def (benchmark-main)
  (let ((count (bench-read))
        (input1 (bench-read))
        (output (bench-read))
        (s2 (number->string count))
        (s1 (number->string input1))
        (name "graphs"))
    (run-ported-benchmark (string-append name ":" s1 ":" s2)
                          count
                          (fn () (length (run (bench-hide count input1))))
                          (fn (result) (= result output)))))
