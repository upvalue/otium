;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot
;;; MAZEFUN -- Constructs a maze in a purely functional way,
;;; written by Marc Feeley.

(def (foldr f base lst)
  (def (foldr-aux lst)
    (if (null? lst)
        base
        (f (car lst) (foldr-aux (cdr lst)))))

  (foldr-aux lst))

(def (foldl f base lst)
  (def (foldl-aux base lst)
    (if (null? lst)
        base
        (foldl-aux (f base (car lst)) (cdr lst))))

  (foldl-aux base lst))

(def (maze-for lo hi f)
  (def (maze-for-aux lo)
    (if (< lo hi)
        (cons (f lo) (maze-for-aux (+ lo 1)))
        '()))

  (maze-for-aux lo))

(def (concat-lists lists)
  (foldr append '() lists))

(def (list-read lst i)
  (if (= i 0)
      (car lst)
      (list-read (cdr lst) (- i 1))))

(def (list-write lst i val)
  (if (= i 0)
      (cons val (cdr lst))
      (cons (car lst) (list-write (cdr lst) (- i 1) val))))

(def (list-remove-pos lst i)
  (if (= i 0)
      (cdr lst)
      (cons (car lst) (list-remove-pos (cdr lst) (- i 1)))))

(def (duplicates? lst)
  (if (null? lst)
      #f
      (or (member (car lst) (cdr lst)) (duplicates? (cdr lst)))))

(def (make-matrix n m init)
  (maze-for 0 n (fn (i) (maze-for 0 m (fn (j) (init i j))))))

(def (matrix-read mat i j)
  (list-read (list-read mat i) j))

(def (matrix-write mat i j val)
  (list-write mat i (list-write (list-read mat i) j val)))

(def (matrix-size mat)
  (cons (length mat) (length (car mat))))

(def (matrix-map f mat)
  (map (fn (lst) (map f lst)) mat))

(def initial-random 0)

(def (next-random-number current-random)
  (remainder (+ (* current-random 3581) 12751) 131072))

(def (shuffle lst)
  (shuffle-aux lst initial-random))

(def (shuffle-aux lst current-random)
  (if (null? lst)
      '()
      (let ((new-random (next-random-number current-random)))
        (let ((i (remainder new-random (length lst))))
          (cons (list-read lst i) (shuffle-aux (list-remove-pos lst i) new-random))))))

(def (make-maze n m) ; n and m must be odd
  (if (not (and (odd? n) (odd? m)))
      'error
      (let ((cave (make-matrix n
                               m
                               (fn (i j)
                                 (if (and (even? i) (even? j))
                                     (cons i j)
                                     #f))))
            (possible-holes (concat-lists (maze-for 0
                                              n
                                              (fn (i)
                                                (concat-lists (maze-for 0
                                                                  m
                                                                  (fn (j)
                                                                    (if (equal? (even? i) (even? j))
                                                                        '()
                                                                        (list (cons i j)))))))))))
        (cave-to-maze (pierce-randomly (shuffle possible-holes) cave)))))

(def (cave-to-maze cave)
  (matrix-map (fn (x)
                (if x
                    '_
                    '*))
              cave))

(def (pierce pos cave)
  (let ((i (car pos))
        (j (cdr pos)))
    (matrix-write cave i j pos)))

(def (pierce-randomly possible-holes cave)
  (if (null? possible-holes)
      cave
      (let ((hole (car possible-holes))) (pierce-randomly (cdr possible-holes) (try-to-pierce hole cave)))))

(def (try-to-pierce pos cave)
  (let ((_i (car pos))
        (_j (cdr pos)))
    (let ((ncs (neighboring-cavities pos cave)))
      (if (duplicates? (map (fn (nc) (matrix-read cave (car nc) (cdr nc))) ncs))
          cave
          (pierce pos (foldl (fn (c nc) (change-cavity c nc pos)) cave ncs))))))

(def (change-cavity cave pos new-cavity-id)
  (let ((i (car pos))
        (j (cdr pos)))
    (change-cavity-aux cave pos new-cavity-id (matrix-read cave i j))))

(def (change-cavity-aux cave pos new-cavity-id old-cavity-id)
  (let ((i (car pos))
        (j (cdr pos)))
    (let ((cavity-id (matrix-read cave i j)))
      (if (equal? cavity-id old-cavity-id)
          (foldl (fn (c nc) (change-cavity-aux c nc new-cavity-id old-cavity-id))
                 (matrix-write cave i j new-cavity-id)
                 (neighboring-cavities pos cave))
          cave))))

(def (neighboring-cavities pos cave)
  (let ((size (matrix-size cave)))
    (let ((n (car size))
          (m (cdr size)))
      (let ((i (car pos))
            (j (cdr pos)))
        (append (if (and (> i 0) (matrix-read cave (- i 1) j))
                    (list (cons (- i 1) j))
                    '())
                (if (and (< i (- n 1)) (matrix-read cave (+ i 1) j))
                    (list (cons (+ i 1) j))
                    '())
                (if (and (> j 0) (matrix-read cave i (- j 1)))
                    (list (cons i (- j 1)))
                    '())
                (if (and (< j (- m 1)) (matrix-read cave i (+ j 1)))
                    (list (cons i (+ j 1)))
                    '()))))))

(def (benchmark-main)
  (let ((count (bench-read))
        (rows (bench-read))
        (cols (bench-read))
        (output (bench-read)))
    (run-ported-benchmark (str "mazefun:" rows ":" cols ":" count)
                          count
                          (fn () (make-maze (bench-hide count rows) (bench-hide count cols)))
                          (fn (result) (equal? result output)))))
