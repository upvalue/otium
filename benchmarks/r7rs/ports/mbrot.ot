;; MBROT -- Generate a Mandelbrot set in an array of arrays.
;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def (count r i step x y)
  (let ((max-count 64)
        (radius-squared 16.0)
        (cr (+ r (* (inexact x) step)))
        (ci (+ i (* (inexact y) step))))
    (let loop ((zr cr)
               (zi ci)
               (c 0))
      (if (= c max-count)
          c
          (let ((zr-squared (* zr zr))
                (zi-squared (* zi zi)))
            (if (> (+ zr-squared zi-squared) radius-squared)
                c
                (let ((new-zr (+ (- zr-squared zi-squared) cr))
                      (new-zi (+ (* 2.0 (* zr zi)) ci)))
                  (loop new-zr new-zi (+ c 1)))))))))

(def (mbrot matrix r i step n)
  (for ((y :range (- n 1) -1 -1))
    (for ((x :range (- n 1) -1 -1))
      (put! (get matrix x) y (count r i step x y)))))

(def (test n)
  (let ((matrix (bench-make-array n nil)))
    (for ((i :range (- n 1) -1 -1))
      (put! matrix i (bench-make-array n nil)))
    (mbrot matrix -1.0 -0.5 0.005 n)
    (get (get matrix 0) 0)))

(def (benchmark-main)
  (let ((count (bench-read))
        (input (bench-read))
        (output (bench-read))
        (name (str "mbrot:" input ":" count)))
    (run-ported-benchmark name count (fn () (test (bench-hide count input))) (fn (result) (= result output)))))
