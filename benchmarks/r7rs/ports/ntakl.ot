;; NTAKL -- The TAKeuchi function using lists and an alternative boolean expression.
;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def (listn n)
  (if (= n 0)
      '()
      (cons n (listn (- n 1)))))

(def l18 (listn 18))

(def l12 (listn 12))

(def l6 (listn 6))

(def (mas x y z)
  (if (not (shorter? y x))
      z
      (mas (mas (cdr x) y z) (mas (cdr y) z x) (mas (cdr z) x y))))

;; Keep the conditional form: its difference from takl is what this measures.
(def (shorter? x y)
  (cond
    ((null? y) #f)
    ((null? x) #t)
    (else (shorter? (cdr x) (cdr y)))))

(def (benchmark-main)
  (let ((count (bench-read))
        (input1 (bench-read))
        (input2 (bench-read))
        (input3 (bench-read))
        (output (bench-read))
        (name (str "ntakl:" (length input1) ":" (length input2) ":" (length input3) ":" count)))
    (run-ported-benchmark name
                          count
                          (fn () (mas (bench-hide count input1) (bench-hide count input2) (bench-hide count input3)))
                          (fn (result) (equal? (length result) output)))))
