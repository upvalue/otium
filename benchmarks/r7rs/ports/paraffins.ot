;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot
;;; PARAFFINS -- Compute how many paraffins exist with N carbon atoms.

(def (gen n)
  (let ((half-n (quotient n 2))
        (radicals (bench-make-array (+ half-n 1) '(H))))

    (def (rads-of-size n)
      (let loop1 ((ps (three-partitions (- n 1)))
                  (lst '()))
        (if (null? ps)
            lst
            (let ((p (car ps))
                  (nc1 (get p 0))
                  (nc2 (get p 1))
                  (nc3 (get p 2)))
              (let loop2 ((rads1 (get radicals nc1))
                          (lst (loop1 (cdr ps) lst)))
                (if (null? rads1)
                    lst
                    (let loop3 ((rads2 (if (= nc1 nc2)
                                           rads1
                                           (get radicals nc2)))
                                (lst (loop2 (cdr rads1) lst)))
                      (if (null? rads2)
                          lst
                          (let loop4 ((rads3 (if (= nc2 nc3)
                                                 rads2
                                                 (get radicals nc3)))
                                      (lst (loop3 (cdr rads2) lst)))
                            (if (null? rads3)
                                lst
                                (cons (array 'C (car rads1) (car rads2) (car rads3)) (loop4 (cdr rads3) lst))))))))))))

    (def (bcp-generator j)
      (if (odd? j)
          '()
          (let loop1 ((rads1 (get radicals (quotient j 2)))
                      (lst '()))
            (if (null? rads1)
                lst
                (let loop2 ((rads2 rads1)
                            (lst (loop1 (cdr rads1) lst)))
                  (if (null? rads2)
                      lst
                      (cons (array 'BCP (car rads1) (car rads2)) (loop2 (cdr rads2) lst))))))))

    (def (ccp-generator j)
      (let loop1 ((ps (four-partitions (- j 1)))
                  (lst '()))
        (if (null? ps)
            lst
            (let ((p (car ps))
                  (nc1 (get p 0))
                  (nc2 (get p 1))
                  (nc3 (get p 2))
                  (nc4 (get p 3)))
              (let loop2 ((rads1 (get radicals nc1))
                          (lst (loop1 (cdr ps) lst)))
                (if (null? rads1)
                    lst
                    (let loop3 ((rads2 (if (= nc1 nc2)
                                           rads1
                                           (get radicals nc2)))
                                (lst (loop2 (cdr rads1) lst)))
                      (if (null? rads2)
                          lst
                          (let loop4 ((rads3 (if (= nc2 nc3)
                                                 rads2
                                                 (get radicals nc3)))
                                      (lst (loop3 (cdr rads2) lst)))
                            (if (null? rads3)
                                lst
                                (let loop5 ((rads4 (if (= nc3 nc4)
                                                       rads3
                                                       (get radicals nc4)))
                                            (lst (loop4 (cdr rads3) lst)))
                                  (if (null? rads4)
                                      lst
                                      (cons (array 'CCP (car rads1) (car rads2) (car rads3) (car rads4))
                                            (loop5 (cdr rads4) lst))))))))))))))

    (let loop ((i 1))
      (if (> i half-n)
          (array (bcp-generator n) (ccp-generator n))
          (begin
            (put! radicals i (rads-of-size i))
            (loop (+ i 1)))))))

(def (three-partitions m)
  (let loop1 ((lst '())
              (nc1 (quotient m 3)))
    (if (< nc1 0)
        lst
        (let loop2 ((lst lst)
                    (nc2 (quotient (- m nc1) 2)))
          (if (< nc2 nc1)
              (loop1 lst (- nc1 1))
              (loop2 (cons (array nc1 nc2 (- m (+ nc1 nc2))) lst) (- nc2 1)))))))

(def (four-partitions m)
  (let loop1 ((lst '())
              (nc1 (quotient m 4)))
    (if (< nc1 0)
        lst
        (let loop2 ((lst lst)
                    (nc2 (quotient (- m nc1) 3)))
          (if (< nc2 nc1)
              (loop1 lst (- nc1 1))
              (let ((start (max nc2 (- (quotient (+ m 1) 2) (+ nc1 nc2)))))
                (let loop3 ((lst lst)
                            (nc3 (quotient (- m (+ nc1 nc2)) 2)))
                  (if (< nc3 start)
                      (loop2 lst (- nc2 1))
                      (loop3 (cons (array nc1 nc2 nc3 (- m (+ nc1 (+ nc2 nc3)))) lst) (- nc3 1))))))))))

(def (nb n)
  (let ((x (gen n))) (+ (length (get x 0)) (length (get x 1)))))

(def (benchmark-main)
  (let ((count (bench-read))
        (input (bench-read))
        (output (bench-read)))
    (run-ported-benchmark (str "paraffins:" input ":" count)
                          count
                          (fn () (nb (bench-hide count input)))
                          (fn (result) (= result output)))))
