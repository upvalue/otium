;;; PNPOLY - Test if a point is contained in a 2D polygon.

;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def (pt-in-poly2 xp yp x y)
  (let loop ((c #f)
             (i (- (length xp) 1))
             (j 0))
    (cond
      ((< i 0) c)
      ((or (and (or (> (get yp i) y) (>= y (get yp j))) (or (> (get yp j) y) (>= y (get yp i))))
           (>= x (+ (get xp i) (/ (* (- (get xp j) (get xp i)) (- y (get yp i))) (- (get yp j) (get yp i))))))
       (loop c (- i 1) i))
      (else (loop (not c) (- i 1) i)))))

(def (run input1 input2)
  (let ((count 0)
        (xp (list-to-array (array-to-list input1)))
        (yp (list-to-array (array-to-list input2))))
    (when (pt-in-poly2 xp yp .5 .5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp .5 1.5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -.5 1.5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp .75 2.25) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp 0. 2.01) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -.5 2.5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -1. -.5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -1.5 .5) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -2.25 -1.) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp .5 -.25) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp .5 -1.25) (set! count (+ count 1)))
    (when (pt-in-poly2 xp yp -.5 -2.5) (set! count (+ count 1)))
    count))

(def (benchmark-main)
  (let ((count (bench-read))
        (input1 (bench-read))
        (input2 (bench-read))
        (output (bench-read)))
    (run-ported-benchmark (str "pnpoly:" count)
                          count
                          (fn () (run (bench-hide count input1) (bench-hide count input2)))
                          (fn (result) (and (number? result) (= result output))))))
