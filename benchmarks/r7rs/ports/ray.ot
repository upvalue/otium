;; RAY -- Port of the upstream R7RS benchmark.
;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def (make-point x y z)
  [x y z])

(def (point-x p)
  (get p 0))

(def (point-y p)
  (get p 1))

(def (point-z p)
  (get p 2))

(def (sq x)
  (* x x))

(def (mag x y z)
  (sqrt (+ (sq x) (sq y) (sq z))))

(def (unit-vector x y z)
  (let ((d (mag x y z))) (make-point (/ x d) (/ y d) (/ z d))))

(def (distance p1 p2)
  (mag (- (point-x p1) (point-x p2)) (- (point-y p1) (point-y p2)) (- (point-z p1) (point-z p2))))

(def (minroot a b c)
  (if (zero? a)
      (/ (- c) b)
      (let ((disc (- (sq b) (* 4.0 a c))))
        (if (negative? disc)
            #f
            (let ((discrt (sqrt disc))
                  (minus-b (- b))
                  (two-a (* 2.0 a)))
              (min (/ (+ minus-b discrt) two-a) (/ (- minus-b discrt) two-a)))))))

(def *world* '())

(def eye (make-point 0.0 0.0 200.0))

(def (tracer pathname res)
  (when (file-exists? pathname) (delete-file pathname))
  (with ((p (open-output-file pathname)))
        (let ((extent (* res 100)))
          (display-to p "P2 ")
          (write-to p extent)
          (display-to p " ")
          (write-to p extent)
          (display-to p " 255")
          (newline p)
          (for ((y :range 0 extent))
            (for ((x :range 0 extent))
              (write-to p (color-at (+ -50.0 (/ (inexact x) (inexact res))) (+ -50.0 (/ (inexact y) (inexact res)))))
              (newline p))))))

(def (color-at x y)
  (let ((ray (unit-vector (- x (point-x eye)) (- y (point-y eye)) (- (point-z eye)))))
    (exact (round (* (sendray eye ray) 255.0)))))

(def (sendray pt ray)
  (let ((x (first-hit pt ray))
        (s (get x 0))
        (int (get x 1)))
    (if s
        (* (lambert s int ray) (surface-color s))
        0.0)))

(def (first-hit pt ray)
  (let loop ((lst *world*)
             (surface #f)
             (hit #f)
             (dist 1e308))
    (if (null? lst)
        [surface hit]
        (let ((s (car lst)))
          (let ((h (intersect s pt ray)))
            (if h
                (let ((d (distance h pt)))
                  (if (< d dist)
                      (loop (cdr lst) s h d)
                      (loop (cdr lst) surface hit dist)))
                (loop (cdr lst) surface hit dist)))))))

(def (lambert s int ray)
  (let ((n (normal s int)))
    (max 0.0 (+ (* (point-x ray) (point-x n)) (* (point-y ray) (point-y n)) (* (point-z ray) (point-z n))))))

(def (make-sphere color radius center)
  [color radius center])

(def (sphere-color s)
  (get s 0))

(def (sphere-radius s)
  (get s 1))

(def (sphere-center s)
  (get s 2))

(def (defsphere x y z r c)
  (let ((s (make-sphere c r (make-point x y z))))
    (set! *world* (cons s *world*))
    s))

(def (surface-color s)
  (sphere-color s))

(def (intersect s pt ray)
  (sphere-intersect s pt ray))

(def (sphere-intersect s pt ray)
  (let ((xr (point-x ray))
        (yr (point-y ray))
        (zr (point-z ray))
        (c (sphere-center s))
        (n (minroot (+ (sq xr) (sq yr) (sq zr))
                    (* 2.0
                       (+ (* (- (point-x pt) (point-x c)) xr)
                          (* (- (point-y pt) (point-y c)) yr)
                          (* (- (point-z pt) (point-z c)) zr)))
                    (+ (sq (- (point-x pt) (point-x c)))
                       (sq (- (point-y pt) (point-y c)))
                       (sq (- (point-z pt) (point-z c)))
                       (- (sq (sphere-radius s)))))))
    (if n
        (make-point (+ (point-x pt) (* n xr)) (+ (point-y pt) (* n yr)) (+ (point-z pt) (* n zr)))
        #f)))

(def (normal s pt)
  (sphere-normal s pt))

(def (sphere-normal s pt)
  (let ((c (sphere-center s)))
    (unit-vector (- (point-x c) (point-x pt)) (- (point-y c) (point-y pt)) (- (point-z c) (point-z pt)))))

(def (ray-test res output-file)
  (set! *world* '())
  (defsphere 0.0 -300.0 -1200.0 200.0 0.8)
  (defsphere -80.0 -150.0 -1200.0 200.0 0.7)
  (defsphere 70.0 -100.0 -1200.0 200.0 0.9)
  (for ((x :range -2 3))
    (for ((z :range 2 8))
      (defsphere (* (inexact x) 200.0) 300.0 (* (inexact z) -400.0) 40.0 0.75)))
  (tracer output-file res))

(def (run input output)
  (ray-test input output)
  'ok)

(def (benchmark-main)
  (let ((count (bench-read))
        (input (bench-read))
        (output-file (bench-read))
        (output (bench-read)))
    (run-ported-benchmark (str "ray:" count)
                          count
                          (fn () (run (bench-hide count input) (bench-hide count output-file)))
                          (fn (result) (equal? result output)))))
