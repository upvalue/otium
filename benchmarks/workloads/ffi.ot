;; Bound C calls, scalar reads and struct field reads, the calls a terminal
;; renderer makes for every cell.

(require otium.ffi :as ffi)

(def libc (ffi/open-library '("/usr/lib/libSystem.B.dylib" "libc.so.6")))

(def c-abs (ffi/bind libc "abs" '(int) 'int #f))

(def Cell (ffi/define-struct! 'Cell '((size size-t) (fg u32) (bg u32) (bold bool))))

(let ((p (ffi/alloc 'u64 1))
      (cell (ffi/alloc Cell 1))
      (i 0)
      (sum 0))
  (ffi/set! p 'u64 0 3)
  (ffi/field-set! cell Cell '(fg) 4)
  (while (< i 300000)
    (set! sum (+ sum (c-abs -2) (ffi/ref p 'u64 0) (ffi/field-ref cell Cell '(fg))))
    (set! i (+ i 1)))
  (ffi/free! p)
  (ffi/free! cell)
  (if (= sum 2700000)
      nil
      (error "ffi sum was wrong")))
