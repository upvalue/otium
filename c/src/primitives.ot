;; Derived runtime operations used by the shared core library.

;; The text form of core functions the native compiler may inline, by name.
;; Boot files fill it as they load; see lib/otium/compiler/known.ot.
(def %inline-bodies {})

(def (identity value) value)
(def (inc value) (+ value 1))
(def (dec value) (- value 1))
(def (zero? value) (= value 0))
(def (true? value) (eq? value #t))
(def (false? value) (eq? value #f))
(def (even? value) (= (remainder value 2) 0))
(def (odd? value) (not (even? value)))
(def (set-applied! object key value)
  (cond
    ((instance? object) (slot-set! object key value))
    ((record? object) (record-set! object key value))
    (else (put! object key value)))
  value)

(def (for-each f sequence)
  (cond
    ((nil? sequence) nil)
    ((array? sequence)
     (let ((n (length sequence)) (i 0))
       (while (< i n)
         (f (get sequence i))
         (set! i (+ i 1)))))
    ((list? sequence)
     (let ((rest sequence))
       (while (pair? rest)
         (f (car rest))
         (set! rest (cdr rest)))))
    (else (error "for-each: expected a proper list or array")))
  nil)

(def (reverse sequence)
  (cond
    ((nil? sequence) '())
    ((array? sequence)
     (let ((out []) (i (- (length sequence) 1)))
       (while (>= i 0)
         (push! out (get sequence i))
         (set! i (- i 1)))
       out))
    ((list? sequence)
     (let loop ((rest sequence) (out '()))
       (if (null? rest) out (loop (cdr rest) (cons (car rest) out)))))
    (else (error "reverse: expected a proper list or array"))))

(def (append . sequences)
  (let ((rest sequences) (reversed '()) (tail '()))
    (while (pair? rest)
      (let ((part (car rest)))
        (unless (list? part) (error "append: expected proper lists"))
        (if (null? (cdr rest))
            (set! tail part)
            (while (pair? part)
              (set! reversed (cons (car part) reversed))
              (set! part (cdr part)))))
      (set! rest (cdr rest)))
    (while (pair? reversed)
      (set! tail (cons (car reversed) tail))
      (set! reversed (cdr reversed)))
    tail))

;; append of two sequences, which the compiler calls for (append a b) to
;; skip building the rest list. Same results and errors as append.
(def (%append2 a b)
  (unless (list? b) (error "append: expected proper lists"))
  (cond
    ((null? a) b)
    ((pair? a)
     ;; Copy a forward, each new pair's cdr filled in by the next, checking
     ;; as it goes that a ends in () and has no cycle: slow follows at half
     ;; speed and meets rest only in a cycle.
     (let ((head (cons (car a) b)))
       (let loop ((last head) (rest (cdr a)) (slow a) (step #f))
         (cond
           ((pair? rest)
            (let ((p (cons (car rest) b)) (slow (if step (cdr slow) slow)))
              (when (eq? slow rest) (error "append: expected proper lists"))
              (set-cdr! last p)
              (loop p (cdr rest) slow (not step))))
           ((null? rest) head)
           (else (error "append: expected proper lists"))))))
    (else (error "append: expected proper lists"))))

(def (positive? value) (> value 0))
(def (negative? value) (< value 0))

(def (list->string chars)
  (unless (list? chars) (error "list->string: expected proper list"))
  (let ((out (buffer)))
    (for-each (fn (c)
                (unless (char? c) (error "list->string: expected characters"))
                (buffer-push! out c))
              chars)
    (buffer->string out)))

(def (string . chars) (list->string chars))

(def (string-join separator sequence)
  (unless (string? separator) (error "string-join: expected string separator"))
  (let ((out (buffer)) (started #f))
    (for-each (fn (item)
                (when started (buffer-push! out separator))
                (buffer-push! out item)
                (set! started #t))
              sequence)
    (buffer->string out)))

(def (string-upcase text) (list->string (map char-upcase (string->list text))))
(def (string-downcase text) (list->string (map char-downcase (string->list text))))

(def (string-trim text)
  (let ((start 0) (end (string-length text)))
    (while (and (< start end) (char-whitespace? (string-ref text start)))
      (set! start (+ start 1)))
    (while (and (> end start) (char-whitespace? (string-ref text (- end 1))))
      (set! end (- end 1)))
    (substring text start end)))

(def (string-starts-with? text prefix)
  (and (<= (string-length prefix) (string-length text))
       (equal? (substring text 0 (string-length prefix)) prefix)))
(def (string-ends-with? text suffix)
  (let ((n (string-length text)) (m (string-length suffix)))
    (and (<= m n) (equal? (substring text (- n m)) suffix))))
(def (string-contains? text part) (not (nil? (string-index text part))))

(def- %split-default (cons nil nil))

(def (string-split text &optional (separator %split-default))
  (let ((out []) (n (string-length text)) (start 0))
    (if (eq? separator %split-default)
        (begin
          (while (< start n)
            (while (and (< start n) (char-whitespace? (string-ref text start)))
              (set! start (+ start 1)))
            (let ((end start))
              (while (and (< end n) (not (char-whitespace? (string-ref text end))))
                (set! end (+ end 1)))
              (when (> end start) (push! out (substring text start end)))
              (set! start end))))
        (let ((m (string-length separator)) (done #f))
          (when (= m 0) (error "string-split: empty separator"))
          (while (not done)
            (let ((at (string-index text separator start)))
              (if (nil? at)
                  (begin (push! out (substring text start)) (set! done #t))
                  (begin
                    (push! out (substring text start at))
                    (set! start (+ at m))))))))
    out))

(def (string-replace text from to)
  (unless (string? to) (error "string-replace: expected replacement string"))
  (unless (string? text) (error "string-replace: expected source string"))
  (if (= (string-length from) 0) text (string-join to (string-split text from))))

(def (update! collection key f . args)
  (put! collection key (apply f (get collection key) args)))

(def (call-with-cleanup thunk cleanup)
  (%call-with-cleanup thunk cleanup))

(defparam current-input-port (%standard-input))
(defparam current-output-port (%standard-output))
(defparam current-error-port (%standard-error))

(def (display . values) (apply display-to (current-output-port) values))
(def print display)
(def (write . values) (apply write-to (current-output-port) values))
(def (newline &optional (port (current-output-port))) (write-char #\newline port))
(def (println . values) (apply %display-line-to (current-output-port) values))

(def (close-input-port port)
  (when (output-port? port) (error "close-input-port: wrong port direction"))
  (close-port port))
(def (close-output-port port)
  (when (input-port? port) (error "close-output-port: wrong port direction"))
  (close-port port))
(def open-binary-input-file open-input-file)
(def open-binary-output-file open-output-file)

(def quit exit)
(def type-descriptor? class?)

(defgeneric (update-instance instance old-slots))
(defmethod (update-instance instance old-slots) nil)

(ns otium.process)
(def (write-error text) (display-to (current-error-port) text))

;; UI frames call otium.dev without --dev too, so the state they read is here
;; rather than in c/src/dev.ot, which only the development server loads.
(ns otium.dev)
(defonce %active #f)
(defonce %threaded #f)
;; When the running request or frame should pause, in %clock milliseconds; 0
;; means never.
(defonce %deadline-at 0)
(def (%enabled?) %active)
(def (%deadline value) (if (= value -1) %deadline-at (set! %deadline-at value)))
