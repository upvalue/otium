(require otium.ffi :as ffi)
(require otium.test :refer (check fails? report))
(def aggregate-lib (otium.ffi/open-library (list aggregate-fixture)))
(def Point (otium.ffi/define-struct! 'Point '((x double) (y double))))
(def translate (otium.ffi/bind aggregate-lib "translate" (list Point 'double 'double) Point #t))
(def point (otium.ffi/alloc Point 1))
(otium.ffi/field-set! point Point '(x) 10.0)
(otium.ffi/field-set! point Point '(y) 20.0)
(def moved (translate point 2.0 3.0))
(check 12.0 (otium.ffi/field-ref moved Point '(x)))
(check 23.0 (otium.ffi/field-ref moved Point '(y)))
(check 10.0 (otium.ffi/field-ref point Point '(x)))
(check 2 (otium.ffi/allocation-count))
(check #t (fails? (fn () (translate otium.ffi/null 1.0 1.0))))
(check #t (fails? (fn () (translate (otium.ffi/view point 0 8) 1.0 1.0))))
(check #t (fails? (fn () (translate point #f 1.0))))
(def misaligned (otium.ffi/alloc 'u8 17))
(check #t (fails? (fn () (translate (otium.ffi/view misaligned 1 16) 1.0 1.0))))
(otium.ffi/free! misaligned)
(check 2 (otium.ffi/allocation-count))
(def SavedPoint Point)
(set! Point (otium.ffi/define-struct! 'Point '((x u8))))
(def again (translate moved 1.0 1.0))
(check 13.0 (otium.ffi/field-ref again SavedPoint '(x)))
(check 12.0 (otium.ffi/field-ref moved SavedPoint '(x)))
(otium.ffi/free! again)
(otium.ffi/free! moved)
(otium.ffi/free! point)
(check #t (fails? (fn () (translate point 1.0 1.0))))

(def Mixed (otium.ffi/define-struct! 'Mixed '((tag u8) (value double))))
(def mixed-call (otium.ffi/bind aggregate-lib "mixed" (list Mixed) Mixed #t))
(def mixed-input (otium.ffi/alloc Mixed 1))
(otium.ffi/field-set! mixed-input Mixed '(tag) 4)
(otium.ffi/field-set! mixed-input Mixed '(value) 3.5)
(def mixed-result (mixed-call mixed-input))
(check 5 (otium.ffi/field-ref mixed-result Mixed '(tag)))
(check 7.0 (otium.ffi/field-ref mixed-result Mixed '(value)))
(otium.ffi/free! mixed-input)
(otium.ffi/free! mixed-result)

(def Large (otium.ffi/define-struct! 'Large (list (list 'points (list 'array SavedPoint 3)) '(tag u64))))
(def large-call (otium.ffi/bind aggregate-lib "large" (list Large) Large #t))
(def large-input (otium.ffi/alloc Large 1))
(otium.ffi/field-set! large-input Large '(points 2 y) 7.0)
(def large-result (large-call large-input))
(check 17.0 (otium.ffi/field-ref large-result Large '(points 2 y)))
(check 1 (otium.ffi/field-ref large-result Large '(tag)))
(check 7.0 (otium.ffi/field-ref large-input Large '(points 2 y)))
(otium.ffi/free! large-input)
(check 17.0 (otium.ffi/field-ref large-result Large '(points 2 y)))
(otium.ffi/free! large-result)
(check #f (otium.ffi/free! otium.ffi/null))
(check 0 (otium.ffi/allocation-count))
(def (capture-error thunk)
  (try (thunk) (catch (otium.ffi/error? problem) problem)))
(def argument-error (capture-error (fn () (translate otium.ffi/null 1.0 1.0))))
(check 'call (otium.ffi/error-operation argument-error))
(check aggregate-fixture (otium.ffi/error-library argument-error))
(check "translate" (otium.ffi/error-symbol argument-error))
(check 0 (otium.ffi/error-argument argument-error))
(check 16 (otium.ffi/sizeof (otium.ffi/error-expected-type argument-error)))
(check 8 (otium.ffi/offset-of (otium.ffi/error-expected-type argument-error) '(y)))
(def byte-call (otium.ffi/bind aggregate-lib "echo_u8" '(u8) 'u8 #t))
(def byte-error (capture-error (fn () (byte-call -1))))
(check 'range (otium.ffi/error-reason byte-error))
(check 'u8 (otium.ffi/error-expected-type byte-error))
(check 0 (otium.ffi/error-argument byte-error))
(def arity-error (capture-error (fn () (byte-call))))
(check #f (otium.ffi/error-argument arity-error))
(check #f (otium.ffi/error-expected-type arity-error))
(def high-call (otium.ffi/bind aggregate-lib "high_u64" '() 'u64 #t))
(def result-error (capture-error (fn () (high-call))))
(check #f (otium.ffi/error-argument result-error))
(check 'u64 (otium.ffi/error-expected-type result-error))
(def selected-path (string-append "./" aggregate-fixture))
(def alias-library (otium.ffi/open-library (list selected-path)))
(def alias-call (otium.ffi/bind alias-library "echo_u8" '(u8) 'u8 #t))
(def alias-error (capture-error (fn () (alias-call -1))))
(check selected-path (otium.ffi/error-library alias-error))
(check aggregate-fixture (otium.ffi/error-library byte-error))
(def binding-error (capture-error (fn () (otium.ffi/bind alias-library "missing_symbol" '() 'int #t))))
(check 'bind (otium.ffi/error-operation binding-error))
(check selected-path (otium.ffi/error-library binding-error))
(check "missing_symbol" (otium.ffi/error-symbol binding-error))
(check #f (otium.ffi/error-argument binding-error))
(report "ffi aggregate structs and errors")
