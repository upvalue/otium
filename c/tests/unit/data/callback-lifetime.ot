;; Loaded after the public callbacks suite, with collection at every allocation.
(def cleanup-count 0)
(def cleanup-callback
  (otium.ffi/callback '(int) 'int
    (fn (x) (defer (error "callback failure") (set! cleanup-count (+ cleanup-count 1))))))
(check "callback failure"
       (try (call-n cleanup-callback 3) (catch (error? c) (condition-message c))))
(check 3 cleanup-count)
(otium.ffi/free-callback! cleanup-callback)

;; A native reference retains the procedure even after its Otium wrapper is lost.
(store-callback (otium.ffi/callback '(int) 'int (let ((factor 9)) (fn (x) (* factor x)))))
(test-collect)
(check 27 (call-stored 3))

;; Releasing from within the callback must not free the executing trampoline.
(def self nil)
(set! self (otium.ffi/callback '(int) 'int (fn (x) (otium.ffi/free-callback! self) (test-collect) (+ x 7))))
(check 7 (call-n self 1))
(check 'released (reason (fn () (call-n self 1))))
(check #f (resource-closable? self))
(check #f (resource-closable? otium.ffi/null))

;; Pending conditions remain rooted while later callbacks allocate and signal.
(def retained-error
  (otium.ffi/callback '(int) 'int
    (fn (x) (test-collect) (error (string-append "failure " (number->string x))))))
(check "failure 0"
       (try (call-n retained-error 4) (catch (error? c) (condition-message c))))
(otium.ffi/free-callback! retained-error)
(dotimes (i 100)
  (let ((cb (otium.ffi/callback '(int) 'int (fn (x) (+ x 1)))))
    (check 3 (call-n cb 2))
    (otium.ffi/free-callback! cb)))
(check 1 (otium.ffi/callback-count))
(check 0 (otium.ffi/allocation-count))

(def handler-escape (otium.ffi/callback '(int) 'int (fn (x) (error "handler escape"))))
(check 'escape
       (reason (fn ()
         (restart-case
           (handler-bind ((error? (fn (c) (invoke-restart 'outside))))
             (call-n handler-escape 1))
           (outside () 'wrong)))))
(otium.ffi/free-callback! handler-escape)

(def native ((otium.ffi/bind callback-extra "native_callback" '() 'callback-pointer #t)))
(check 6 (call-n native 3))
(check #f (resource-closable? native))
(check 'type (reason (fn () (otium.ffi/free-callback! native))))
(def native-slot ((otium.ffi/bind callback-extra "native_callback_slot" '() 'pointer #t)))
(check 6 (call-n (otium.ffi/ref native-slot 'callback-pointer 0) 3))

;; Pointer results have unknown extent and do not acquire allocation ownership.
(def original (otium.ffi/alloc 'u8 4))
(def returned ((otium.ffi/bind lib "echo_pointer" '(pointer) 'pointer #t) original))
(check #f (resource-closable? returned))
(check #f (resource-closable? (otium.ffi/view returned 0 16)))
(check 'type (reason (fn () (otium.ffi/free! returned))))
(otium.ffi/free! original)
(check #t (otium.ffi/pointer=? original returned))
