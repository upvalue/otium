;; Loaded after the public ownership suite, with collection at every allocation.
(def destroyed 0)
(def storage (otium.ffi/alloc 'u8 8))
(def managed (otium.ffi/own storage (fn (p) (set! destroyed (+ destroyed 1)) (otium.ffi/free! p))))
(def derived (otium.ffi/view managed 1 4))
(check #t (resource-closable? managed))
(check #f (resource-closable? derived))
(check #f (resource-closable? otium.ffi/null))
(check #t (fails? (fn () (otium.ffi/free! derived))))
(otium.ffi/free! managed)
(check 1 destroyed)
(check #t (fails? (fn () (otium.ffi/ref derived 'u8 0))))
(otium.ffi/free! managed)
(check 1 destroyed)

(def reentrant nil)
(set! reentrant (otium.ffi/own otium.ffi/null (fn (p) (set! destroyed (+ destroyed 1)) (close reentrant nil))))
(close reentrant nil)
(check 2 destroyed)
(check #t (fails? (fn () (otium.ffi/own otium.ffi/null 42))))
(check #t (fails? (fn () (otium.ffi/own managed (fn (p) nil)))))
(check 0 (otium.ffi/allocation-count))
