#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build=${OTIUM_BUILD:-$root/../build}
case $(uname -s) in Darwin) extension=dylib ;; *) extension=so ;; esac
# Native helpers are built on first use, so a fresh checkout only needs Chez,
# Meson and a C compiler for the REPL and development server.
native() {
  if [ ! -f "$build/libotium-$1.$extension" ]; then
    [ -d "$build/meson-info" ] || meson setup "$build" "$root/.." > /dev/null
    meson compile -C "$build" "otium-$1:shared_library" > /dev/null
  fi
}
# Resolve the optional FFI helper just as the REPL resolves line editing.
# Loading it remains lazy, and an explicit environment override wins.
if [ "${OTIUM_FFI_LIBRARY+x}" != x ]; then
  OTIUM_FFI_LIBRARY="$build/libotium-ffi.$extension"
  export OTIUM_FFI_LIBRARY
fi
for argument do
  case "$argument" in
    --) break ;;
    serve|--dev|--dev=*)
      OTIUM_DEV_LIBRARY="$build/libotium-dev.$extension"
      native dev
      export OTIUM_DEV_LIBRARY
      break ;;
  esac
done
interactive=yes
explicit_repl=no
skip=no
for argument do
  if [ "$skip" = yes ]; then skip=no; continue; fi
  case "$argument" in
    --) break ;;
    -L|--path|--project) skip=yes ;;
    --load) skip=yes; interactive=no ;;
    --load=*|--help|-h) interactive=no ;;
    --repl) explicit_repl=yes ;;
    --*) ;;
    *) interactive=no ;;
  esac
done
if [ "$explicit_repl" = yes ]; then interactive=yes; fi
if [ "$interactive" = yes ] && { { [ -t 0 ] && [ -t 1 ]; } || [ "${OTIUM_DEV_LIBRARY+x}" = x ]; }; then
  OTIUM_LINE_LIBRARY="$build/libotium-line.$extension"
  native line
  export OTIUM_LINE_LIBRARY
fi
chez=${CHEZ:-chez}
if [ -z "${CHEZ:-}" ] && ! command -v chez >/dev/null 2>&1; then
  chez=scheme
fi
exec "$chez" \
  --compile-imported-libraries --libdirs "$root" --script "$root/main.ss" "$@"
