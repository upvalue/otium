(import (chezscheme) (prefix (otium values) v:))

(define checks 0)
(define (check expected actual)
  (unless (equal? expected actual) (error 'check "unexpected result" expected actual))
  (set! checks (+ checks 1)))
(define (fails? thunk)
  (guard (c [else #t]) (thunk) #f))

;; Exercise both fixed arities and the variadic fallback.
(do ([n 0 (+ n 1)]) ((= n 8))
  (let* ([xs (iota n)] [a (apply v:array xs)])
    (check n (v:collection-length a))
    (check xs (map (lambda (i) (v:get a i)) xs))
    (check (apply string-append (map number->string xs)) (apply v:str xs))
    (check a (v:push! a))
    (check a (v:push! a 'last))
    (check 'last (v:pop! a))
    (check n (v:collection-length a))
    (v:push! a 'a 'b 'c)
    (let* ([c (v:pop! a)] [b (v:pop! a)] [first (v:pop! a)])
      (check '(c b a) (list c b first)))))

(let ([a (v:array)])
  (do ([i 0 (+ i 1)]) ((= i 100)) (v:push! a i))
  (check (iota 100) (map (lambda (i) (v:get a i)) (iota 100))))
(check #t (fails? (lambda () (v:push! #f 1))))
(check #t (fails? (lambda () (v:push! #f))))

(check "" (v:buffer->string (v:buffer)))
(check "seed" (v:buffer->string (v:buffer "seed")))
(check "123" (v:buffer->string (v:buffer 123)))
(check #t (fails? (lambda () (v:buffer 1 2))))
(check "x12#t" (v:str "x" 12 #t))

(for-each
  (lambda (writer expected)
    (let ([port (open-output-string)])
      (parameterize ([current-output-port port]) (writer "x"))
      (writer "x" port)
      (writer "x" port 'ignored)
      (check expected (get-output-string port))))
  (list v:otium-write v:otium-display)
  '("\"x\"\"x\"\"x\"" "xxx"))

(for-each
  (lambda (seq)
    (let ([seen '()])
      (v:collection-for-each (lambda (x) (set! seen (cons x seen))) seq)
      (check '(3 2 1) seen)))
  (list '(1 2 3) (v:array 1 2 3)))
(for-each
  (lambda (seq)
    (v:collection-for-each (lambda (x) (error 'check "unexpected element" x)) seq))
  (list '() (void) (v:array)))
(let ([seen '()])
  (v:collection-for-each (lambda (x y) (set! seen (cons (+ x y) seen)))
    '(1 2) (v:array 10 20))
  (check '(22 11) seen))
(let ([t (v:table 'a 1 'b 2)])
  (v:collection-for-each t '(a b)))
(check #t (fails? (lambda () (v:collection-for-each values 42))))

(printf "values: ~a checks passed\n" checks)
