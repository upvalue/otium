;; DESTRUC -- Destructive operation benchmark.

(define (append-to-tail! x y)
  (if (null? x)
      y
      (let ((a x) (b (cdr x)))
        (while (not (null? b))
          (set! a b)
          (set! b (cdr b)))
        (set-cdr! a y)
        x)))

(define (empty-list-copies n)
  (let ((i n) (result '()))
    (while (> i 0)
      (set! result (cons '() result))
      (set! i (- i 1)))
    result))

(define (middle-node! list i)
  (let ((j (quotient (length list) 2)) (node list))
    (while (> j 0)
      (set-car! node i)
      (set! node (cdr node))
      (set! j (- j 1)))
    node))

(define (split-half! outer-cell i)
  (let ((list (car outer-cell))
        (n (quotient (length (car outer-cell)) 2)))
    (if (= n 0)
        (begin
          (set-car! outer-cell '())
          (car outer-cell))
        (let ((j n) (node list))
          (while (> j 1)
            (set-car! node i)
            (set! node (cdr node))
            (set! j (- j 1)))
          (let ((tail (cdr node)))
            (set-cdr! node '())
            tail)))))

(define (destructive n m)
  (let ((lists (empty-list-copies 10)) (i n))
    (while (> i 0)
      (if (null? (car lists))
          (let ((cursor lists))
            (while (pair? cursor)
              (when (null? (car cursor))
                (set-car! cursor (cons '() '())))
              (append-to-tail! (car cursor) (empty-list-copies m))
              (set! cursor (cdr cursor))))
          (let ((left lists) (right (cdr lists)))
            (while (pair? right)
              (set-cdr! (middle-node! (car right) i)
                        (split-half! left i))
              (set! left (cdr left))
              (set! right (cdr right)))))
      (set! i (- i 1)))
    lists))

(define (benchmark-main)
  (let ((count (bench-read))
        (input1 (bench-read))
        (input2 (bench-read))
        (output (bench-read))
        (name (str "destruc:" input1 ":" input2 ":" count)))
    (run-ported-benchmark name count
      (lambda () (destructive (bench-hide count input1) (bench-hide count input2)))
      (lambda (result) (equal? result output)))))
