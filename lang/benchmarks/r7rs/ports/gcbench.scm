;; Allocation benchmark adapted from the Ellis/Boehm collector benchmark.

(define (make-node left right) [left right 0 0])
(define (make-empty-node) [0 0 0 0])
(define (node-left node) (get node 0))
(define (node-right node) (get node 1))
(define (set-node-left! node value) (put! node 0 value))
(define (set-node-right! node value) (put! node 1 value))

(define (gcbench stretch-depth)
  (define (tree-size depth) (- (expt 2 (+ depth 1)) 1))
  (define (iterations depth)
    (quotient (* 2 (tree-size stretch-depth)) (tree-size depth)))
  (define (populate depth node)
    (when (> depth 0)
      (let ((next-depth (- depth 1)))
        (set-node-left! node (make-empty-node))
        (set-node-right! node (make-empty-node))
        (populate next-depth (node-left node))
        (populate next-depth (node-right node)))))
  (define (make-tree depth)
    (if (<= depth 0)
        (make-empty-node)
        (make-node (make-tree (- depth 1)) (make-tree (- depth 1)))))
  (define (construct depth)
    (let ((count (iterations depth)) (i 0))
      (while (< i count)
        (populate depth (make-empty-node))
        (set! i (+ i 1)))
      (set! i 0)
      (while (< i count)
        (make-tree depth)
        (set! i (+ i 1)))))

  (let ((long-depth (- stretch-depth 2))
        (array-size (* 4 (tree-size long-depth)))
        (long-tree (make-empty-node)))
    (make-tree stretch-depth)
    (populate long-depth long-tree)
    (let ((numbers (bench-make-array array-size 0.0)) (i 0))
      (while (< i (quotient array-size 2))
        (put! numbers i (/ 1.0 (inexact (+ i 1))))
        (set! i (+ i 1)))
      (let ((depth 4))
        (while (<= depth long-depth)
          (construct depth)
          (set! depth (+ depth 2))))
      (let ((check-index (min 1000 (- (quotient (length numbers) 2) 1))))
        (and (array? long-tree)
             (= (get numbers check-index)
                (/ 1.0 (inexact (+ check-index 1)))))))))

(define (benchmark-main)
  (let ((count (bench-read))
        (input (bench-read))
        (ignored-output (bench-read))
        (name (str "gcbench:" input ":" count)))
    (run-ported-benchmark name count
      (lambda () (gcbench (bench-hide count input)))
      (lambda (result) result))))
