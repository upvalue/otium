;; Memory-system benchmark using Zaks's permutation generator.

(def (permutations initial)
  (let ((current initial)
        (perms (list initial)))
    (def (reverse-prefix x n tail)
      (if (= n 0)
          tail
          (reverse-prefix (cdr x) (- n 1) (cons (car x) tail))))
    (def (flip n)
      (set! current (reverse-prefix current n (drop n current)))
      (set! perms (cons current perms)))
    (def (generate n)
      (when (> n 1)
        (let ((j (- n 1)))
          (while (> j 0)
            (generate (- n 1))
            (flip n)
            (set! j (- j 1))))
        (generate (- n 1))))
    (generate (length initial))
    perms))

(def (sum-lists lists)
  (let ((outer lists)
        (sum 0))
    (while (pair? outer)
      (let ((inner (car outer)))
        (while (pair? inner)
          (set! sum (+ sum (car inner)))
          (set! inner (cdr inner))))
      (set! outer (cdr outer)))
    sum))

(def (one-to-n n)
  (let ((result '()))
    (while (> n 0)
      (set! result (cons n result))
      (set! n (- n 1)))
    result))

(def (factorial n)
  (if (= n 0)
      1
      (* n (factorial (- n 1)))))

(def (run-mperm m n k ell)
  (let ((name (str "mperm:" m ":" n ":" k ":" ell))
        (queue (bench-make-array k '())))
    (def (fill-queue i end)
      (while (< i end)
        (put! queue i (permutations (one-to-n n)))
        (set! i (+ i 1))))
    (def (flush-queue)
      (let ((i 0))
        (while (< i k)
          (let ((source (+ i ell)))
            (put! queue
                  i
                  (if (< source k)
                      (get queue source)
                      '())))
          (set! i (+ i 1)))))
    (fill-queue 0 (- k ell))
    (run-ported-benchmark name
                          m
                          (fn ()
                            (fill-queue (- k ell) k)
                            (flush-queue)
                            queue)
                          (fn (result)
                            (let ((first (get result 0))
                                  (recent (get result (max 0 (- k ell 1)))))
                              (and (or (and (null? first) (null? recent))
                                       (and (pair? first) (pair? recent) (equal? (car first) (car recent))))
                                   (= (sum-lists first) (/ (* n (+ n 1) (factorial n)) 2))))))))

(def (benchmark-main)
  (let ((m (bench-read))
        (n (bench-read))
        (k (bench-read))
        (ell (bench-read))
        (ignored-output (bench-read)))
    (run-mperm (bench-hide m m) (bench-hide m n) (bench-hide m k) (bench-hide m ell))))
