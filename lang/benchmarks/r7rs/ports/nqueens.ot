;; NQUEENS -- Compute the number of solutions to the n-queens problem.
;; lint: allow-file(unbound-name) benchmarks/r7rs/run.py prepends benchmarks/r7rs/lib/benchmark.ot

(def (nqueens n)
  (def (iota1 n)
    (def (loop i result)
      (if (= i 0)
          result
          (loop (- i 1) (cons i result))))
    (loop n '()))

  (def (ok? row distance placed)
    (if (null? placed)
        #t
        (and (not (= (car placed) (+ row distance)))
             (not (= (car placed) (- row distance)))
             (ok? row (+ distance 1) (cdr placed)))))

  (def (search x y placed)
    (if (null? x)
        (if (null? y)
            1
            0)
        (+ (if (ok? (car x) 1 placed)
               (search (append (cdr x) y) '() (cons (car x) placed))
               0)
           (search (cdr x) (cons (car x) y) placed))))

  (search (iota1 n) '() '()))

(def (benchmark-main)
  (let ((count (bench-read))
        (input (bench-read))
        (output (bench-read))
        (name (str "nqueens:" input ":" count)))
    (run-ported-benchmark name count (fn () (nqueens (bench-hide count input))) (fn (result) (= result output)))))
