;; Allocation benchmark adapted from the Ellis/Boehm collector benchmark via
;; ecraven/r7rs-benchmarks.

(def (gcbench-make-node left right) [left right 0 0])
(def (gcbench-empty-node) [0 0 0 0])
(def (gcbench-left node) (get node 0))
(def (gcbench-right node) (get node 1))
(def (gcbench-set-left! node value) (put! node 0 value))
(def (gcbench-set-right! node value) (put! node 1 value))

(def (gcbench-make-array n fill)
  (let ((out (array)) (i 0))
    (while (< i n)
      (push! out fill)
      (set! i (+ i 1)))
    out))

(def (gcbench stretch-depth)
  (def (tree-size depth) (- (expt 2 (+ depth 1)) 1))
  (def (iterations depth)
    (quotient (* 2 (tree-size stretch-depth)) (tree-size depth)))
  (def (populate depth node)
    (when (> depth 0)
      (let ((next-depth (- depth 1)))
        (gcbench-set-left! node (gcbench-empty-node))
        (gcbench-set-right! node (gcbench-empty-node))
        (populate next-depth (gcbench-left node))
        (populate next-depth (gcbench-right node)))))
  (def (make-tree depth)
    (if (<= depth 0)
        (gcbench-empty-node)
        (gcbench-make-node (make-tree (- depth 1)) (make-tree (- depth 1)))))
  (def (construct depth)
    (let ((count (iterations depth)) (i 0))
      (while (< i count)
        (populate depth (gcbench-empty-node))
        (set! i (+ i 1)))
      (set! i 0)
      (while (< i count)
        (make-tree depth)
        (set! i (+ i 1)))))

  (let ((long-depth (- stretch-depth 2))
        (array-size (* 4 (tree-size long-depth)))
        (long-tree (gcbench-empty-node)))
    (make-tree stretch-depth)
    (populate long-depth long-tree)
    (let ((numbers (gcbench-make-array array-size 0.0)) (i 0))
      (while (< i (quotient array-size 2))
        (put! numbers i (/ 1.0 (inexact (+ i 1))))
        (set! i (+ i 1)))
      (let ((depth 4))
        (while (<= depth long-depth)
          (construct depth)
          (set! depth (+ depth 2))))
      (let ((check-index (min 1000 (- (quotient (length numbers) 2) 1))))
        (and (array? long-tree)
             (= (get numbers check-index)
                (/ 1.0 (inexact (+ check-index 1)))))))))

(if (gcbench 15) nil (error "gcbench result was incorrect"))
