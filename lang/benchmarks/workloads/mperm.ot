;; Memory-system benchmark using Zaks's permutation generator, adapted from
;; ecraven/r7rs-benchmarks.

(def (mperm-make-array n fill)
  (let ((out (array))
        (i 0))
    (while (< i n)
      (push! out fill)
      (set! i (+ i 1)))
    out))

(def (mperm-permutations initial)
  (let ((current initial)
        (perms (list initial)))
    (def (reverse-prefix x n tail)
      (if (= n 0)
          tail
          (reverse-prefix (cdr x) (- n 1) (cons (car x) tail))))
    (def (flip n)
      (set! current (reverse-prefix current n (drop n current)))
      (set! perms (cons current perms)))
    (def (generate n)
      (when (> n 1)
        (let ((j (- n 1)))
          (while (> j 0)
            (generate (- n 1))
            (flip n)
            (set! j (- j 1))))
        (generate (- n 1))))
    (generate (length initial))
    perms))

(def (mperm-sum-lists lists)
  (let ((outer lists)
        (sum 0))
    (while (pair? outer)
      (let ((inner (car outer)))
        (while (pair? inner)
          (set! sum (+ sum (car inner)))
          (set! inner (cdr inner))))
      (set! outer (cdr outer)))
    sum))

(def (mperm-one-to-n n)
  (let ((result '()))
    (while (> n 0)
      (set! result (cons n result))
      (set! n (- n 1)))
    result))

(def (mperm-factorial n)
  (if (= n 0)
      1
      (* n (mperm-factorial (- n 1)))))

(def (mperm m n k ell)
  (let ((queue (mperm-make-array k '()))
        (iteration 0))
    (def (fill-queue i end)
      (while (< i end)
        (put! queue i (mperm-permutations (mperm-one-to-n n)))
        (set! i (+ i 1))))
    (def (flush-queue)
      (let ((i 0))
        (while (< i k)
          (let ((source (+ i ell)))
            (put! queue
                  i
                  (if (< source k)
                      (get queue source)
                      '())))
          (set! i (+ i 1)))))
    (fill-queue 0 (- k ell))
    (while (< iteration m)
      (fill-queue (- k ell) k)
      (flush-queue)
      (set! iteration (+ iteration 1)))
    queue))

(let ((n 8))
  (let ((result (mperm 8 n 2 1)))
    (let ((first (get result 0))
          (expected (/ (* n (+ n 1) (mperm-factorial n)) 2)))
      (if (and (pair? first) (= (mperm-sum-lists first) expected))
          nil
          (error "mperm result was incorrect")))))
