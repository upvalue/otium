;; FFT -- Fast Fourier Transform, translated from Numerical Recipes in C.

(define (four1 data)
  (let ((n (length data))
        (two-pi 6.28318530717959)
        (i 0)
        (j 0))
    ;; Bit reversal.
    (while (< i n)
      (when (< i j)
        (let ((temporary (get data i)))
          (put! data i (get data j))
          (put! data j temporary))
        (let ((temporary (get data (+ i 1))))
          (put! data (+ i 1) (get data (+ j 1)))
          (put! data (+ j 1) temporary)))
      (let ((m (quotient n 2)))
        (while (and (>= m 2) (>= j m))
          (set! j (- j m))
          (set! m (quotient m 2)))
        (set! j (+ j m)))
      (set! i (+ i 2)))

    ;; Danielson-Lanczos section.
    (let ((mmax 2))
      (while (< mmax n)
        (let ((theta (/ two-pi (inexact mmax)))
              (half-sine (sin (* 0.5 theta)))
              (wpr (* -2.0 (* half-sine half-sine)))
              (wpi (sin theta))
              (wr 1.0)
              (wi 0.0)
              (m 0))
          (while (< m mmax)
            (set! i m)
            (while (< i n)
              (set! j (+ i mmax))
              (let ((temporary-real
                      (- (* wr (get data j)) (* wi (get data (+ j 1)))))
                    (temporary-imaginary
                      (+ (* wr (get data (+ j 1))) (* wi (get data j)))))
                (put! data j (- (get data i) temporary-real))
                (put! data (+ j 1) (- (get data (+ i 1)) temporary-imaginary))
                (put! data i (+ (get data i) temporary-real))
                (put! data (+ i 1) (+ (get data (+ i 1)) temporary-imaginary)))
              (set! i (+ j mmax)))
            (let ((new-wr (+ (- (* wr wpr) (* wi wpi)) wr))
                  (new-wi (+ (+ (* wi wpr) (* wr wpi)) wi)))
              (set! wr new-wr)
              (set! wi new-wi))
            (set! m (+ m 2))))
        (set! mmax (* mmax 2))))))

(define (benchmark-main)
  (let ((count (bench-read))
        (size (bench-read))
        (fill (bench-read))
        (output (bench-read))
        (name (str "fft:" size ":" count)))
    (run-ported-benchmark name count
      (lambda ()
        (let ((data (bench-make-array size fill)))
          (four1 data)
          (get data 0)))
      (lambda (result) (= result output)))))
