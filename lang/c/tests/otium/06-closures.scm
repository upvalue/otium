; Copies of immutable bindings, shared mutable bindings, and forwarded captures.
(println "immutable:" (((fn (x) (fn () x)) 17)))
(let ((x 1))
  (def read (fn () x))
  (set! x 2)
  (println "write-after-capture:" (read)))
(let ((x 0))
  (def read (fn () x))
  (def increment (fn () (set! x (+ x 1))))
  (increment)
  (increment)
  (println "sibling-mutation:" (read)))
(def make-counter
  (fn (x) (list (fn () x) (fn () (set! x (+ x 1))))))
(let ((counter (make-counter 9)))
  ((car (cdr counter)))
  (println "parameter-mutation:" ((car counter))))
(println "forwarded-capture:" ((((fn (x) (fn () (fn () x))) 23))))
(let ((x 5))
  (def maker (fn () (fn () (set! x (+ x 1)))))
  ((maker))
  (println "forwarded-write:" x))
(let ((x 7))
  (def read (fn () x))
  (let ((x 1)) (set! x 99))
  (println "shadowed-write:" (read)))
(println "mutual-recursion:"
  ((fn (n)
     (def even (fn (x) (if (= x 0) #t (odd (- x 1)))))
     (def odd (fn (x) (if (= x 0) #f (even (- x 1)))))
     (even n)) 100))
(let ((saved '()) (i 0))
  (while (< i 3)
    (let ((x i))
      (set! saved (cons (fn () (set! x (+ x 10)) x) saved)))
    (set! i (+ i 1)))
  (println "separate-iterations:" ((car saved)) ((car (cdr saved))) ((car saved))))
(let ((saved '()) (i 0))
  (while (< i 3)
    (let ((x i)) (set! saved (cons (fn () x) saved)))
    (set! i (+ i 1)))
  (println "immutable-iterations:" ((car saved)) ((car (cdr saved)))))
(println "rest-capture:" (((fn (x & rest) (fn () (cons x rest))) 1 2 3)))
(println "dynamic-capture:"
  (((fn (x) (fn () (try (error "capture") (catch (error? e) x)))) 31)))
(let ((x 0))
  (unwind-protect (set! x 2) (set! x (+ x 3)))
  (println "dynamic-mutation:" x))
(def closure-global 3)
(def read-global (fn () closure-global))
(set! closure-global 8)
(println "global-reload:" (read-global))
(let ((closure-global 100))
  (println "eval-namespace:" (eval 'closure-global)))
