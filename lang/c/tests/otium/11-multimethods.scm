(require (otium.generic :as g :refer (Number String)))
(define checks 0)
(define (check expected actual)
  (unless (equal? expected actual)
    (error (str "multimethod check " checks ": expected " expected ", got " actual)))
  (set! checks (+ checks 1)))
(define (code form)
  (try (begin (eval form) 'no-error)
    (catch (error? e) (get e :code))))
(define-type Button)
(define-type PointerDown)
(define-type OtherWidget)
(define button (g/make Button 'label "7" 'enabled? #f))
(check #t (eq? Button (g/dispatch-type button)))
(check 'user/Button (g/type-name Button))
(check :table (type button))
(check #t (table? button))
(check #t (g/typed-map? button))
(check #t (g/field-has? button 'enabled?))
(check #f (g/field-ref button 'enabled?))
(check 42 (g/field-ref button 'missing 42))
(check 'missing-field (code '(g/field-ref button 'missing)))
(check "8" (g/field-set! button 'label "8"))
(check #f (g/field-has? (g/make Button) 'label))
(check 2 (g/field-ref (g/make Button 'x 1 'x 2) 'x))
(check #t (g/field-delete! button 'enabled?))
(check #f (g/field-delete! button 'enabled?))
(check '(label) (let ((ks (g/field-keys button))) (set-car! ks 'nope) (g/field-keys button)))
(check 'invalid-field-operation (code '(g/make Button 'x)))
(check 'invalid-field-operation (code '(g/make Button 1 2)))
(check 'invalid-specializer (code '(g/make Number)))
(g/field-set! button 'type OtherWidget)
(check #t (eq? Button (g/dispatch-type button)))
(check #f (eq? (g/make Button) (g/make Button)))
(check #t (eq? Button (g/dispatch-type (copy button))))
(g/field-set! button 'gone nil)
(check #f (g/field-has? button 'gone))
(check #t (eq? Number (g/dispatch-type 1)))
(check #t (eq? Number (g/dispatch-type 1.5)))
(check #t (eq? g/Nil (g/dispatch-type nil)))
(check #t (eq? g/Null (g/dispatch-type '())))
(check #t (eq? g/Boolean (g/dispatch-type #f)))
(check #t (eq? String (g/dispatch-type "s")))
(check #t (eq? g/Symbol (g/dispatch-type 's)))
(check #t (eq? g/Keyword (g/dispatch-type :s)))
(check #t (eq? g/Pair (g/dispatch-type '(1))))
(check #t (eq? g/Vector (g/dispatch-type [1])))
(check #t (eq? g/Hashtable (g/dispatch-type {})))
(check #t (eq? g/Procedure (g/dispatch-type +)))
(check #t (eq? g/TypeDescriptor (g/dispatch-type Button)))
(define-generic (event! widget event))
(define saved event!)
(define down (g/make PointerDown))
(check #t (procedure? event!))
(check :function (type event!))
(check #t (eq? g/Procedure (g/dispatch-type event!)))
(check 'missing-method (code '(event! button down)))
(define-method (event! widget event) 'fallback)
(define-method (event! (widget Button) event) 'button)
(check 'button (event! button down))
(check 'fallback (event! 1 2))
(define-method (event! widget (event PointerDown)) 'pointer)
(check 'ambiguous-method (code '(event! button down)))
(define-method (event! (widget Button) (event PointerDown)) 'exact)
(check 'exact (event! button down))
(define-method (event! (widget Button) (event PointerDown)) 'replacement)
(check 'replacement (saved button down))
(check 4 (length (g/generic-methods event!)))
(for-each (lambda (s) (set-car! s #f)) (g/generic-methods event!))
(check 'replacement (event! button down))
(check #t (g/remove-method! event! (list Button PointerDown)))
(check 'ambiguous-method (code '(event! button down)))
(check #f (g/remove-method! event! (list Button PointerDown)))
(check 'invalid-signature (code '(g/remove-method! event! (list Button))))
(g/remove-method! event! (list #f PointerDown))
(check 'button (event! button down))
(check 'wrong-arity (code '(event! button)))
(check 'wrong-arity (code '(define-method (event! x) x)))
(check 'invalid-specializer (code '(define-method (event! (x +) y) x)))
(check 'not-generic (code '(define-method (+ x y) x)))
(check 'invalid-declaration (code '(define-method (event! x x) x)))
(check 'invalid-declaration (code '(define-method (event! (x Button) y) (define-type Local))))
(check 'button (event! button down))
(define-type Button)
(define-generic (event! x y))
(check #t (eq? saved event!))
(check #t (eq? Button (g/dispatch-type button)))
(check 'button (saved button down))
(check 'binding-conflict (code '(define-generic (event! x))))
(define old-type Button)
(reset-type! Button)
(check #f (eq? old-type Button))
(check #t (eq? old-type (g/dispatch-type button)))
(check 'button (event! button down))
(check 'fallback (event! (g/make Button) down))
(reset-generic! (event! x))
(check #f (eq? saved event!))
(check 'button (saved button down))
(check 'missing-method (code '(event! button)))
(define bad 10)
(check 'binding-conflict (code '(define-type bad)))
(reset-type! bad)
(check #t (g/type-descriptor? bad))
(check 'binding-conflict (code '(reset-type! absent)))
(define-generic (zero))
(define-method (zero) 42)
(check 42 (zero))
(define-generic (combine a b))
(define-method (combine (a Number) (b Number)) (+ a b))
(define-method (combine (a String) (b String)) (str a b))
(check 7 (apply combine '(3 4)))
(check "ab" (combine "a" "b"))
(define-generic (map-only x))
(define-method (map-only (x g/Hashtable)) #t)
(check 'missing-method (code '(map-only button)))
(define-generic (three a b c))
(define-method (three (a Number) b (c Number)) 'two)
(define-method (three a (b Number) c) 'one)
(check 'ambiguous-method (code '(three 1 2 3)))
(define-method (three (a Number) (b Number) (c Number)) 'three)
(check 'three (three 1 2 3))
(define-generic (ident x))
(define-method (ident x) x)
(check #t (eq? button (ident button)))
(define marker {:type 'error :message "marker"})
(define-method (ident x) (error marker))
(check #t (try (ident button) (catch (error? e) (eq? e marker))))
(define-generic (recur x))
(define-method (recur x) (g/remove-method! recur (list #f)) (recur x))
(check 'missing-method (code '(recur 1)))
(check 'invalid-declaration (code '(lambda () (define-type Local))))
(check 'invalid-declaration (code '(lambda () (define-generic (local x)))))
(check 'invalid-declaration (code '(if #f (reset-type! Button) 1)))
(check 'invalid-declaration (code '(lambda () (when #f (define-method (event! x) x)))))
(defmacro declaration (name) `(define-type ,name))
(declaration Generated)
(check 'user/Generated (g/type-name Generated))
;; Descriptor and generic identity hashes must survive table growth and moving GC.
(define identities (table Button 'type saved 'generic))
(dotimes (i 1000) (put! identities i (array i)))
(check 'type (get identities Button))
(check 'generic (get identities saved))
;; Tail calls through generic dispatch must use VM frames, not the C stack.
(define-generic (countdown n result))
(define-method (countdown (n Number) result)
  (if (= n 0) result (countdown (- n 1) (+ result 1))))
(check 20000 (countdown 20000 0))
(require (otium.generic :as g :reload))
(check #t (eq? Number g/Number))
(check 42 (let ((define-method (lambda (x) x))) (define-method 42)))
(check 'invalid-declaration (code '(define-method)))
(println "multimethod checks:" checks)
