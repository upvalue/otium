(import (chezscheme) (otium runtime) (otium runtime-documentation))
(define (check actual expected)
  (unless (equal? actual expected) (error 'documentation "unexpected result" actual expected)))
(evaluate '(ns docs-test))
(evaluate '(define answer "The answer." 42))
(check (evaluate 'answer) 42)
(check (evaluate '(describe 'answer)) "The answer.")
(evaluate '(define literal "A string value."))
(check (evaluate 'literal) "A string value.")
(check (evaluate '(describe 'literal)) "")
(evaluate '(define (square x) "Square the input." (define y x) (* y y)))
(check (evaluate '(square 6)) 36)
(check (evaluate '(describe 'square)) "Procedure parameters: (x). Square the input.")
(evaluate '(defmacro twice (x) "Double an expression." (define y x) `(+ ,y ,y)))
(check (evaluate '(twice 5)) 10)
(check (evaluate '(describe 'twice)) "Macro parameters: (x). Double an expression.")
(evaluate '(defonce saved "Original documentation." 7))
(evaluate '(defonce saved "Replacement documentation." 8))
(check (evaluate 'saved) 7)
(check (evaluate '(describe 'saved)) "Original documentation.")
(check (evaluate '(describe 'hashtable-ref)) "")
(check (evaluate '(describe 'eval)) (runtime-documentation 'eval))
(evaluate '(define eval "My evaluator." 123))
(check (evaluate '(describe 'eval)) "My evaluator.")
(evaluate '(define answer 9))
(check (evaluate '(describe 'answer)) "")
(display "Docstrings, runtime fallback, redefinition, and defonce passed\n")
