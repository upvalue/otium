(import (chezscheme) (prefix (chezscheme) chez/) (otium runtime) (prefix (otium generic-core) gm:))
(define checks 0)
(define (check label expected actual)
  (unless (equal? expected actual) (error 'check label expected actual))
  (set! checks (+ checks 1)))
(define (run x) (evaluate '(require chez)) (evaluate x))
(define (code form)
  (guard (c [(and (irritants-condition? c) (pair? (condition-irritants c)))
             (car (condition-irritants c))]
            [else (raise c)])
    (run form) 'no-error))
(run '(require otium.generic :as g :refer (Number String)))
(run '(defclass Button (label :init "") (enabled? :init #f)))
(run '(defclass PointerDown))
(run '(def button (g/make Button)))
(run '(def down (g/make PointerDown)))
(check "qualified diagnostic name" 'user/Button (run '(g/type-name Button)))
(run '(require chez))
(for-each
 (lambda (pair)
   (check "builtin identity" #t
     (run `(eq? (g/dispatch-type ,(car pair)) ,(cadr pair)))))
 '((1 g/Number) (1.2 g/Number) (1+2i g/Number) (#f g/Boolean)
   (#\a g/Character) ("x" g/String) ('a g/Symbol) ('() g/Null)
   ('(a) g/Pair) ((chez/vector 1) g/Vector) ((chez/make-bytevector 2) g/Bytevector)
   ((chez/make-eq-hashtable) g/Hashtable) (+ g/Procedure) (Button g/TypeDescriptor)
   ((chez/void) g/Nil) ((keyword "test") g/Keyword)
   ((array) g/Vector) ((table) g/Hashtable)))
(run '(defgeneric (event! widget event)))
(run '(def saved event!))
(run '(defmethod (event! widget event) 'fallback))
(run '(defmethod (event! (widget Button) event) 'button))
(run '(defmethod (event! widget (event PointerDown)) 'pointer))
(check "ambiguity exposed" 'ambiguous-method (code '(event! button down)))
(check "remove absent" #f (run '(g/remove-method! event! (list Button PointerDown))))
(check "invalid signature" 'invalid-signature (code '(g/remove-method! event! (list Button))))
(run '(g/remove-method! event! (list #f PointerDown)))
(check "fallback exposed" 'button (run '(event! button down)))
(check "wrong arity" 'wrong-arity (code '(event! button)))
(check "wrong method arity" 'wrong-arity (code '(defmethod (event! a) a)))
(check "bad specializer" 'invalid-specializer (code '(defmethod (event! (a +) b) a)))
(check "not generic" 'not-generic (code '(defmethod (+ a b) a)))
(check "duplicate parameter" 'invalid-declaration (code '(defmethod (event! a a) a)))
(check "failed body compilation" 'invalid-declaration
  (code '(defmethod (event! (x Button) y) (defclass Local) 1)))
(collect)
(check "failed registration unchanged" 'button (run '(event! button down)))
(run '(defclass Button))
(run '(defgeneric (event! x y)))
(check "reload keeps identities" #t (run '(and (eq? saved event!) (eq? Button (g/dispatch-type button)))))
(check "reload keeps methods" 'button (run '(saved button down)))
(check "arity change rejected" 'binding-conflict (code '(defgeneric (event! x))))
(run '(def old-button-type Button))
(run '(reset-class! Button))
(check "reset descriptor fresh" #f (run '(eq? old-button-type Button)))
(check "old object stays old" #t (run '(eq? old-button-type (g/dispatch-type button))))
(check "old signature stays" 'button (run '(event! button down)))
(check "new descriptor fallback" 'fallback (run '(event! (g/make Button) down)))
(run '(reset-generic! (event! x)))
(check "reset generic fresh" #f (run '(eq? saved event!)))
(check "old generic intact" 'button (run '(saved button down)))
(check "reset clears methods" 'missing-method (code '(event! button)))
(run '(defclass Button))
(run '(defgeneric (event! x)))
(run '(def bad 10))
(check "collision" 'binding-conflict (code '(defclass bad)))
(run '(reset-class! bad))
(check "explicit recovery" #t (run '(g/type-descriptor? bad)))
(check "reset needs existing local" 'binding-conflict (code '(reset-class! absent)))
(run '(defgeneric (zero)))
(run '(defmethod (zero) (chez/values 1 2)))
(check "zero and multiple values" '(1 2) (call-with-values (lambda () (run '(zero))) list))
(run '(defgeneric (combine a b)))
(run '(defmethod (combine (a Number) (b Number)) (+ a b)))
(run '(defmethod (combine (a String) (b String)) (string-append a b)))
(check "numbers" 7 (run '(apply combine '(3 4))))
(check "strings" "ab" (run '(combine "a" "b")))
(run '(defgeneric (map-only x)))
(run '(defmethod (map-only (x g/Hashtable)) #t))
(check "instance is not Hashtable" 'missing-method (code '(map-only button)))
(run '(defgeneric (three a b c)))
(run '(defmethod (three (a Number) b (c Number)) 'two))
(run '(defmethod (three a (b Number) c) 'one))
(check "specializer count is not precedence" 'ambiguous-method (code '(three 1 2 3)))
(run '(defmethod (three (a Number) (b Number) (c Number)) 'three))
(check "three exact" 'three (run '(three 1 2 3)))
(run '(defgeneric (echo-object x)))
(run '(defmethod (echo-object x) x))
(check "original object" #t (run '(eq? button (echo-object button))))
(run '(require chez))
(run '(def marker (chez/make-message-condition "marker")))
(run '(defmethod (echo-object x) (chez/raise marker)))
(check "condition identity" #t (run '(chez/guard (c [else (eq? c marker)]) (echo-object button))))
(run '(defgeneric (recur x)))
;; Updating the registry in a body affects a recursive call, not the selected body.
(run '(defmethod (recur x)
        (g/remove-method! recur (list #f))
        (recur x)))
(check "recursive registry update" 'missing-method (code '(recur 1)))
(for-each
 (lambda (form) (check "local declaration rejected" 'invalid-declaration (code form)))
 '((fn () (defclass Local) 1)
   (fn () (defgeneric (local x)) 1)
   (fn () (defmethod (event! x) x))
   (if #f (reset-class! Button) 1)
   (fn () (reset-generic! (event! x)))
   (fn () (when #f (defmethod (event! x) x)))))
(check "core form names cannot be rebound" #t
  (guard (c [else #t]) (run '(let ([defmethod (fn (x) x)]) (defmethod 42))) #f))
(run '(defmacro declaration (name) `(defclass ,name)))
(run '(begin (declaration Generated)))
(check "macro caller namespace" 'user/Generated (run '(g/type-name Generated)))

;; Exercise actual file reload and live imports, not just repeated evaluate calls.
(define directory (cadr (command-line)))
(load-path (list directory))
(define (source forms)
  (let ([path (string-append directory "/generic-provider.scm")])
    (when (file-exists? path) (delete-file path))
    (call-with-output-file path
      (lambda (p) (for-each (lambda (f) (write f p) (newline p)) forms)))))
(define (provider signature result)
  (source `((ns generic-provider)
            (require otium.generic :refer (Number))
            (defclass Button)
            (defgeneric (action x y))
            (defmethod ,signature ',result))))
(provider '(action (x Button) y) 'old)
(run '(require generic-provider :as p :refer (action)))
(run '(def foreign (g/make p/Button)))
(run '(def foreign-saved action))
(check "same spelling distinct namespace" #f (run '(eq? Button p/Button)))
(run '(defmethod (p/action (x p/Button) (y Number)) 'extension))
(check "import extension" 'extension (run '(action foreign 1)))
(check "import declaration rejected" 'binding-conflict (code '(defgeneric (action x y))))
(check "import reset rejected" 'binding-conflict (code '(reset-generic! (action x y))))
(provider '(action x (y Number)) 'new)
(run '(require generic-provider :as p :reload))
(check "reload exact extension remains" 'extension (run '(action foreign 1)))
(run '(g/remove-method! action (list p/Button Number)))
(check "signature change leaves stale method" 'ambiguous-method (code '(foreign-saved foreign 1)))
(run '(g/remove-method! action (list p/Button #f)))
(check "remove stale signature" 'new (run '(action foreign 1)))
(run '(ns generic-provider))
(run '(reset-generic! (action x)))
(run '(ns user))
(check "import observes reset arity" 'wrong-arity (code '(action foreign 1)))
(check "saved generic retains registry" 'new (run '(foreign-saved foreign 1)))
(run '(require otium.generic :reload))
(check "default alias" #t (run '(eq? otium.generic/Number Number)))
(run '(ns otium.generic))
(check "builtin reset protected" 'binding-conflict (code '(reset-class! Number)))
(run '(ns user))
;; Exhaust every subset of the eight wildcard signatures on three arguments.
;; The independent oracle uses bitset inclusion, and registration order is reversed.
(define numeric-type (gm:dispatch-type 1))
(do ([subset 0 (+ subset 1)]) ((= subset 256))
  (let* ([masks (filter (lambda (m) (bitwise-bit-set? subset m)) (iota 8))]
         [best (filter (lambda (m)
                         (not (exists (lambda (n)
                                        (and (not (= m n)) (= (bitwise-and m n) m)))
                                masks))) masks)]
         [expected (cond [(null? best) 'missing-method]
                         [(pair? (cdr best)) 'ambiguous-method]
                         [else (car best)])])
    (for-each
      (lambda (order)
        (let ([generic (gm:fresh-generic 'test 'oracle 3)])
          (for-each (lambda (mask)
                      (gm:add-method! generic
                        (map (lambda (i) (and (bitwise-bit-set? mask i) numeric-type)) (iota 3))
                        (lambda args mask))) order)
          (check "all wildcard subsets and order independence" expected
            (guard (c [else (car (condition-irritants c))]) (generic 1 2 3)))))
      (list masks (reverse masks)))))

(printf "~a class namespace and dispatch checks passed\n" checks)
