(import (chezscheme) (otium runtime) (prefix (otium generic-core) gm:))
(define checks 0)
(define (check label expected actual)
  (unless (equal? expected actual) (error 'check label expected actual))
  (set! checks (+ checks 1)))
(define (run x) (evaluate x))
(define (code form)
  (guard (c [(and (irritants-condition? c) (pair? (condition-irritants c)))
             (car (condition-irritants c))]
            [else (raise c)])
    (run form) 'no-error))
(run '(require otium.generic :as g :refer (Number String)))
(run '(define-type Button))
(run '(define-type PointerDown))
(run '(define-type OtherWidget))
(run '(define button (g/make Button 'label "7" 'enabled? #f)))
(check "descriptor" #t (run '(eq? Button (g/dispatch-type button))))
(check "qualified diagnostic name" 'user/Button (run '(g/type-name Button)))
(check "false is present" #t (run '(g/field-has? button 'enabled?)))
(check "false value" #f (run '(g/field-ref button 'enabled?)))
(check "missing default" 42 (run '(g/field-ref button 'missing 42)))
(check "missing error" 'missing-field (code '(g/field-ref button 'missing)))
(check "assignment returns value" "8" (run '(g/field-set! button 'label "8")))
(check "fresh object fields" #f (run '(g/field-has? (g/make Button) 'label)))
(check "duplicate fields" 2 (run '(g/field-ref (g/make Button 'x 1 'x 2) 'x)))
(check "delete present" #t (run '(g/field-delete! button 'enabled?)))
(check "delete absent" #f (run '(g/field-delete! button 'enabled?)))
(check "keys detached" '(label)
  (run '(let ([keys (g/field-keys button)]) (set-car! keys 'nope) (g/field-keys button))))
(check "odd fields" 'invalid-field-operation (code '(g/make Button 'x)))
(check "invalid key" 'invalid-field-operation (code '(g/make Button 1 2)))
(check "builtin constructor" 'invalid-specializer (code '(g/make Number)))
(check "metadata separate" #t
  (run '(begin (g/field-set! button 'type OtherWidget) (eq? Button (g/dispatch-type button)))))
(check "distinct objects" #f (run '(eq? (g/make Button) (g/make Button))))
(for-each
 (lambda (pair)
   (check "builtin identity" #t
     (run `(eq? (g/dispatch-type ,(car pair)) ,(cadr pair)))))
 '((1 g/Number) (1.2 g/Number) (1+2i g/Number) (#f g/Boolean)
   (#\a g/Character) ("x" g/String) ('a g/Symbol) ('() g/Null)
   ('(a) g/Pair) ((vector 1) g/Vector) ((make-bytevector 2) g/Bytevector)
   ((make-eq-hashtable) g/Hashtable) (+ g/Procedure) (Button g/TypeDescriptor)
   ((void) g/Nil) ((keyword "test") g/Keyword)
   ((array) g/Vector) ((table) g/Hashtable)))
(run '(define-generic (event! widget event)))
(run '(define saved event!))
(run '(define down (g/make PointerDown)))
(check "missing method" 'missing-method (code '(event! button down)))
(run '(define-method (event! widget event) 'fallback))
(run '(define-method (event! (widget Button) event) 'button))
(check "partial beats full" 'button (run '(event! button down)))
(check "full fallback" 'fallback (run '(event! 1 2)))
(run '(define-method (event! widget (event PointerDown)) 'pointer))
(check "incomparable" 'ambiguous-method (code '(event! button down)))
(run '(define-method (event! (widget Button) (event PointerDown)) 'exact))
(check "exact beats partial" 'exact (run '(event! button down)))
(run '(define-method (event! (widget Button) (event PointerDown)) 'replacement))
(check "saved reference" 'replacement (run '(saved button down)))
(check "no duplicate signature" 4 (run '(length (g/generic-methods event!))))
(check "method list detached" 'replacement
  (run '(begin (for-each (lambda (s) (set-car! s #f)) (g/generic-methods event!))
               (event! button down))))
(check "remove exact" #t (run '(g/remove-method! event! (list Button PointerDown))))
(check "ambiguity exposed" 'ambiguous-method (code '(event! button down)))
(check "remove absent" #f (run '(g/remove-method! event! (list Button PointerDown))))
(check "invalid signature" 'invalid-signature (code '(g/remove-method! event! (list Button))))
(run '(g/remove-method! event! (list #f PointerDown)))
(check "fallback exposed" 'button (run '(event! button down)))
(check "wrong arity" 'wrong-arity (code '(event! button)))
(check "wrong method arity" 'wrong-arity (code '(define-method (event! a) a)))
(check "bad specializer" 'invalid-specializer (code '(define-method (event! (a +) b) a)))
(check "not generic" 'not-generic (code '(define-method (+ a b) a)))
(check "duplicate parameter" 'invalid-declaration (code '(define-method (event! a a) a)))
(check "failed body compilation" 'invalid-declaration
  (code '(define-method (event! (x Button) y) (define-type Local) 1)))
(collect)
(check "failed registration unchanged" 'button (run '(event! button down)))
(run '(define-type Button))
(run '(define-generic (event! x y)))
(check "reload keeps identities" #t (run '(and (eq? saved event!) (eq? Button (g/dispatch-type button)))))
(check "reload keeps methods" 'button (run '(saved button down)))
(check "arity change rejected" 'binding-conflict (code '(define-generic (event! x))))
(run '(define old-button-type Button))
(run '(reset-type! Button))
(check "reset descriptor fresh" #f (run '(eq? old-button-type Button)))
(check "old object stays old" #t (run '(eq? old-button-type (g/dispatch-type button))))
(check "old signature stays" 'button (run '(event! button down)))
(check "new descriptor fallback" 'fallback (run '(event! (g/make Button) down)))
(run '(reset-generic! (event! x)))
(check "reset generic fresh" #f (run '(eq? saved event!)))
(check "old generic intact" 'button (run '(saved button down)))
(check "reset clears methods" 'missing-method (code '(event! button)))
(run '(define-type Button))
(run '(define-generic (event! x)))
(run '(define bad 10))
(check "collision" 'binding-conflict (code '(define-type bad)))
(run '(reset-type! bad))
(check "explicit recovery" #t (run '(g/type-descriptor? bad)))
(check "reset needs existing local" 'binding-conflict (code '(reset-type! absent)))
(run '(define-generic (zero)))
(run '(define-method (zero) (values 1 2)))
(check "zero and multiple values" '(1 2) (call-with-values (lambda () (run '(zero))) list))
(run '(define-generic (combine a b)))
(run '(define-method (combine (a Number) (b Number)) (+ a b)))
(run '(define-method (combine (a String) (b String)) (string-append a b)))
(check "numbers" 7 (run '(apply combine '(3 4))))
(check "strings" "ab" (run '(combine "a" "b")))
(run '(define-generic (map-only x)))
(run '(define-method (map-only (x g/Hashtable)) #t))
(check "typed map is not Hashtable" 'missing-method (code '(map-only button)))
(run '(define-generic (three a b c)))
(run '(define-method (three (a Number) b (c Number)) 'two))
(run '(define-method (three a (b Number) c) 'one))
(check "specializer count is not precedence" 'ambiguous-method (code '(three 1 2 3)))
(run '(define-method (three (a Number) (b Number) (c Number)) 'three))
(check "three exact" 'three (run '(three 1 2 3)))
(run '(define-generic (identity x)))
(run '(define-method (identity x) x))
(check "original object" #t (run '(eq? button (identity button))))
(run '(define marker (chez/make-message-condition "marker")))
(run '(define-method (identity x) (chez/raise marker)))
(check "condition identity" #t (run '(chez/guard (c [else (eq? c marker)]) (identity button))))
(run '(define-generic (recur x)))
;; Updating the registry in a body affects a recursive call, not the selected body.
(run '(define-method (recur x)
        (g/remove-method! recur (list #f))
        (recur x)))
(check "recursive registry update" 'missing-method (code '(recur 1)))
(for-each
 (lambda (form) (check "local declaration rejected" 'invalid-declaration (code form)))
 '((lambda () (define-type Local) 1)
   (lambda () (define-generic (local x)) 1)
   (lambda () (define-method (event! x) x))
   (if #f (reset-type! Button) 1)
   (lambda () (reset-generic! (event! x)))
   (lambda () (when #f (define-method (event! x) x)))))
(check "lexical shadowing" 42
  (run '(let ([define-method (lambda (x) x)]) (define-method 42))))
(run '(defmacro declaration (name) `(define-type ,name)))
(run '(begin (declaration Generated)))
(check "macro caller namespace" 'user/Generated (run '(g/type-name Generated)))

;; Exercise actual file reload and live imports, not just repeated evaluate calls.
(define directory (cadr (command-line)))
(load-path (list directory))
(define (source forms)
  (let ([path (string-append directory "/generic-provider.scm")])
    (when (file-exists? path) (delete-file path))
    (call-with-output-file path
      (lambda (p) (for-each (lambda (f) (write f p) (newline p)) forms)))))
(define (provider signature result)
  (source `((ns generic-provider)
            (require otium.generic :refer (Number))
            (define-type Button)
            (define-generic (action x y))
            (define-method ,signature ',result))))
(provider '(action (x Button) y) 'old)
(run '(require generic-provider :as p :refer (action)))
(run '(define foreign (g/make p/Button)))
(run '(define foreign-saved action))
(check "same spelling distinct namespace" #f (run '(eq? Button p/Button)))
(run '(define-method (p/action (x p/Button) (y Number)) 'extension))
(check "import extension" 'extension (run '(action foreign 1)))
(check "import declaration rejected" 'binding-conflict (code '(define-generic (action x y))))
(check "import reset rejected" 'binding-conflict (code '(reset-generic! (action x y))))
(provider '(action x (y Number)) 'new)
(run '(require generic-provider :as p :reload))
(check "reload exact extension remains" 'extension (run '(action foreign 1)))
(run '(g/remove-method! action (list p/Button Number)))
(check "signature change leaves stale method" 'ambiguous-method (code '(foreign-saved foreign 1)))
(run '(g/remove-method! action (list p/Button #f)))
(check "remove stale signature" 'new (run '(action foreign 1)))
(run '(ns generic-provider))
(run '(reset-generic! (action x)))
(run '(ns user))
(check "import observes reset arity" 'wrong-arity (code '(action foreign 1)))
(check "saved generic retains registry" 'new (run '(foreign-saved foreign 1)))
(run '(require otium.generic :reload))
(check "default alias" #t (run '(eq? otium.generic/Number Number)))
(run '(ns otium.generic))
(check "builtin reset protected" 'binding-conflict (code '(reset-type! Number)))
(run '(ns user))
;; Exhaust every subset of the eight wildcard signatures on three arguments.
;; The independent oracle uses bitset inclusion, and registration order is reversed.
(define numeric-type (gm:dispatch-type 1))
(do ([subset 0 (+ subset 1)]) ((= subset 256))
  (let* ([masks (filter (lambda (m) (bitwise-bit-set? subset m)) (iota 8))]
         [best (filter (lambda (m)
                         (not (exists (lambda (n)
                                        (and (not (= m n)) (= (bitwise-and m n) m)))
                                masks))) masks)]
         [expected (cond [(null? best) 'missing-method]
                         [(pair? (cdr best)) 'ambiguous-method]
                         [else (car best)])])
    (for-each
      (lambda (order)
        (let ([generic (gm:fresh-generic 'test 'oracle 3)])
          (for-each (lambda (mask)
                      (gm:add-method! generic
                        (map (lambda (i) (and (bitwise-bit-set? mask i) numeric-type)) (iota 3))
                        (lambda args mask))) order)
          (check "all wildcard subsets and order independence" expected
            (guard (c [else (car (condition-irritants c))]) (generic 1 2 3)))))
      (list masks (reverse masks)))))

(printf "~a multimethod checks passed\n" checks)
