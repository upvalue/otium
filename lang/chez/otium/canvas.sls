(library (otium canvas)
  (export with-canvas canvas-backend canvas-window canvas-renderer
          clear! rect! line! text! present! capture! events! title! seconds)
  (import (chezscheme) (sdl3))

  (define-record-type canvas (fields window renderer backend rectangle event))
  (define (check result)
    (unless result (error 'sdl3 (SDL_GetError))))
  (define (pointer value)
    (when (zero? value) (error 'sdl3 (SDL_GetError)))
    value)
  (define (seconds)
    (let ([t (current-time 'time-monotonic)])
      (+ (time-second t) (/ (time-nanosecond t) 1e9))))

  (define (with-canvas renderer-name thunk)
    (let ([window 0] [renderer 0] [rectangle 0] [event 0])
      (dynamic-wind
        (lambda () (void))
        (lambda ()
          ;; SDL_main is not used when Chez owns the process entry point.
          ((foreign-procedure "SDL_SetMainReady" () void))
          (check (SDL_Init SDL_INIT_VIDEO))
          (set! window (pointer (SDL_CreateWindow "Otium / SDL3" 960 640 SDL_WINDOW_RESIZABLE)))
          (set! renderer (pointer (SDL_CreateRenderer window renderer-name)))
          (let ([backend (SDL_GetRendererName renderer)])
            (when (string=? backend "software")
              (error 'sdl3 "hardware renderer required; refusing software fallback"))
            (check (SDL_SetRenderLogicalPresentation renderer 960 640 SDL_LOGICAL_PRESENTATION_LETTERBOX))
            (unless (SDL_SetRenderVSync renderer 1)
              (fprintf (current-error-port) "VSync unavailable: ~a\n" (SDL_GetError)))
            (set! rectangle (foreign-alloc (ftype-sizeof SDL_FRect)))
            (set! event (foreign-alloc (ftype-sizeof SDL_Event)))
            (thunk (make-canvas window renderer backend
                     (make-ftype-pointer SDL_FRect rectangle)
                     (make-ftype-pointer SDL_Event event)))))
        (lambda ()
          (unless (zero? event) (foreign-free event))
          (unless (zero? rectangle) (foreign-free rectangle))
          (unless (zero? renderer) (SDL_DestroyRenderer renderer))
          (unless (zero? window) (SDL_DestroyWindow window))
          (SDL_Quit)))))

  (define (color! canvas r g b)
    (check (SDL_SetRenderDrawColor (canvas-renderer canvas) r g b 255)))
  (define (clear! canvas r g b)
    (color! canvas r g b)
    (check (SDL_RenderClear (canvas-renderer canvas))))
  (define (rect! canvas x y w h r g b)
    (let ([rect (canvas-rectangle canvas)])
      (ftype-set! SDL_FRect (x) rect (inexact x))
      (ftype-set! SDL_FRect (y) rect (inexact y))
      (ftype-set! SDL_FRect (w) rect (inexact w))
      (ftype-set! SDL_FRect (h) rect (inexact h))
      (color! canvas r g b)
      (check (SDL_RenderFillRect (canvas-renderer canvas) rect))))
  (define (line! canvas x1 y1 x2 y2 r g b)
    (color! canvas r g b)
    (check (SDL_RenderLine (canvas-renderer canvas)
             (inexact x1) (inexact y1) (inexact x2) (inexact y2))))
  (define (text! canvas x y text r g b)
    (color! canvas r g b)
    (check (SDL_RenderDebugText (canvas-renderer canvas) (inexact x) (inexact y) text)))
  (define (present! canvas) (check (SDL_RenderPresent (canvas-renderer canvas))))
  (define (title! canvas title) (check (SDL_SetWindowTitle (canvas-window canvas) title)))
  (define (capture! canvas path)
    (let ([surface (pointer (SDL_RenderReadPixels (canvas-renderer canvas)
                             (make-ftype-pointer SDL_Rect 0)))])
      (dynamic-wind (lambda () (void))
        (lambda () (check (SDL_SaveBMP surface path)))
        (lambda () (SDL_DestroySurface surface)))))
  (define (events! canvas)
    (let ([event (canvas-event canvas)])
      (let loop ([action #f])
        (if (not (SDL_PollEvent event)) action
            (let ([type (ftype-ref SDL_Event (type) event)])
              (cond
                [(or (= type SDL_EVENT_QUIT) (= type SDL_EVENT_WINDOW_CLOSE_REQUESTED))
                 (loop 'quit)]
                [(and (= type SDL_EVENT_KEY_DOWN) (not (eq? action 'quit)))
                 (let ([key (ftype-ref SDL_Event (key scancode) event)])
                   (loop (cond [(= key SDL_SCANCODE_ESCAPE) 'quit]
                               [(= key SDL_SCANCODE_R) 'reload]
                               [else action])))]
                [else (loop action)])))))))
