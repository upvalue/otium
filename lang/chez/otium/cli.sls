(library (otium cli)
  (export public-bindings)
  (import (except (chezscheme) compile error exit)
          (only (otium conditions) error exit try)
          (only (otium process) application-arguments))
  (define-syntax %let* (syntax-rules () ((_ bindings body ...) (let* bindings body ...))))
  (define (%arguments) (application-arguments))
  (define (%stderr text) (display text (current-error-port)))
  (define-syntax include-core
    (lambda (form)
      (syntax-case form ()
        ((k)
         (let loop ((directories (library-directories)))
           (if (null? directories)
               (syntax-error form "cannot locate shared/cli/core.scm")
               (let ((path (string-append (caar directories) "/../shared/cli/core.scm")))
                 (if (file-exists? path)
                     (datum->syntax #'k `(include ,path))
                     (loop (cdr directories))))))))))
  (include-core)
  (define public-bindings
    (list (cons 'compile compile) (cons 'parse parse) (cons 'run run)
          (cons 'ref ref) (cons 'present? present?)
          (cons 'outcome-kind outcome-kind) (cons 'outcome-values outcome-values)
          (cons 'outcome-command outcome-command) (cons 'outcome-diagnostic outcome-diagnostic)
          (cons 'format-help format-help) (cons 'format-error format-error))))
