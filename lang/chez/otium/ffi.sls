(library (otium ffi)
  (export make-native-bindings)
  (import (except (chezscheme) null?)
          (only (otium generic-core) set-pointer-predicate!)
          (prefix (otium conditions) ot:) (prefix (otium values) val:))

  (define (make-native-bindings core-ref)
    (define (%count op n) ((core-ref '%count) op n))
    (define-record-type pointer (fields address owner size owning?))
    ;; Native function addresses: decoded callback-pointer values and callbacks.
    (define-record-type code-pointer (parent pointer))
    (define-record-type callback (parent code-pointer) (fields code (mutable released?)))
    (define-record-type allocation (fields address size (mutable released?)))
    (define-record-type custom-allocation (parent allocation)
      (fields (mutable original) (mutable destroy)))
    (define-record-type (native-library make-library library?) (fields address name))
    (define-record-type layout (fields data))
    (define error-context (make-parameter '()))
    (define allocations '())
    (define libraries '())
    (define factories (make-hashtable equal-hash equal?))
    (define (%layout data) (make-layout data))
    (define (%layout-data x) (and (layout? x) (layout-data x)))
    (define (%null) (make-pointer 0 #f #f #f))
    (define (null? x) (and (pointer? x) (zero? (pointer-address x))))
    (define (%fail op reason message)
      (let ((c (val:table (val:keyword "type") 'ffi-error
                          (val:keyword "message") message
                          (val:keyword "operation") (string->symbol op)
                          (val:keyword "reason") (string->symbol reason))))
        (for-each (lambda (entry)
                    (let ((key (symbol->string (car entry))))
                      (val:put! c (val:keyword (substring key 1 (string-length key))) (cdr entry))))
                  (error-context))
        (ot:error c)))
    (define (%error-field c name)
      (and (val:table? c) (val:get c (val:keyword name) #f)))
    (define (checked-string x op)
      (unless (string? x) (%fail op "type" "expected string"))
      (when (exists (lambda (c) (char=? c #\nul)) (string->list x))
        (%fail op "encoding" "embedded NUL in string"))
      x)
    (define native-ready
      (delay
        (let ((path (getenv "OTIUM_FFI_LIBRARY")))
          (unless path (%fail "import" "load" "set OTIUM_FFI_LIBRARY to the shared FFI helper"))
          (load-shared-object path))))
    (define-syntax helper
      (syntax-rules ()
        ((_ name (arg ...) result)
         (let ((p (delay (begin (force native-ready) (foreign-procedure name (arg ...) result)))))
           (lambda args (apply (force p) args))))))
    (define native-size (helper "offi_size" (int) size_t))
    (define native-align (helper "offi_align" (int) size_t))
    (define native-open (helper "offi_open" (utf-8) void*))
    (define native-symbol (helper "offi_symbol" (void* utf-8) void*))
    (define %loader-error (helper "offi_loader_error" () utf-8))
    (define valid-utf8? (helper "offi_utf8" (void* size_t) int))
    (define thread-id
      (if (threaded?) (eval 'get-thread-id (environment '(chezscheme))) (lambda () 0)))
    ;; Call strings are copied out of the managed heap: a callback may collect
    ;; and move a bytevector during the call.
    (define memcpy (delay (foreign-procedure "memcpy" (void* u8* size_t) void*)))
    (define (utf8-temporary text)
      (let* ((b (string->utf8 text))
             (n (bytevector-length b))
             (address (foreign-alloc (+ n 1))))
        ((force memcpy) address b n)
        (foreign-set! 'unsigned-8 address n 0)
        address))
    (define (%open name)
      (let ((address (native-open (checked-string name "open-library"))))
        (and (not (zero? address))
             (or (find (lambda (l) (= address (native-library-address l))) libraries)
                 (let ((l (make-library address name)))
                   (set! libraries (cons l libraries)) l)))))
    (define (symbol-address lib name op)
      (unless (library? lib) (%fail op "type" "expected library"))
      (native-symbol (native-library-address lib) (checked-string name op)))
    (define (has-symbol? lib name) (not (zero? (symbol-address lib name "has-symbol?"))))
    (define (checked-pointer p op)
      (unless (pointer? p) (%fail op "type" "expected foreign pointer"))
      p)
    (define (live? p)
      (and (pointer? p)
           (not (and (pointer-owner p) (allocation-released? (pointer-owner p))))
           (or (not (custom-allocation? (pointer-owner p)))
               (live? (custom-allocation-original (pointer-owner p))))
           (not (and (callback? p) (callback-released? p)))))
    (define (live-pointer p op)
      (unless (live? p)
        (checked-pointer p op)
        (when (and (pointer-owner p) (allocation-released? (pointer-owner p)))
          (%fail op "released" "allocation released"))
        (%fail op "released" "callback released"))
      p)
    (define (pointer=? p q)
      (= (pointer-address (checked-pointer p "pointer=?"))
         (pointer-address (checked-pointer q "pointer=?"))))
    (define address-limit (expt 2 64))
    (define (checked-span p offset bytes align op)
      (let ((address (and (live? p) (pointer-address p)))
            (size (and (pointer? p) (pointer-size p))))
        (if (and address (fixnum? address) (fx> address 0)
                 (fixnum? offset) (fx>= offset 0) (fixnum? bytes) (fx>= bytes 0)
                 (fixnum? (+ address offset bytes))
                 (or (not size) (<= (+ offset bytes) size))
                 (fxzero? (fxremainder (fx+ address offset) align)))
            (fx+ address offset)
            (checked-span-slow p offset bytes align op))))
    ;; Raises the error for a span that failed the checks above.
    (define (checked-span-slow p offset bytes align op)
      (live-pointer p op)
      (unless (and (fixnum? offset) (fx>= offset 0)) (%count op offset))
      (unless (and (fixnum? bytes) (fx>= bytes 0)) (%count op bytes))
      (when (zero? (pointer-address p)) (%fail op "null" "null memory access"))
      (when (or (> (+ (pointer-address p) offset bytes) address-limit)
                (and (pointer-size p) (> (+ offset bytes) (pointer-size p))))
        (%fail op "bounds" "memory span out of bounds"))
      (unless (zero? (modulo (+ (pointer-address p) offset) align))
        (%fail op "alignment" "unaligned memory access"))
      (+ (pointer-address p) offset))
    (define (%alloc bytes align)
      (%count "alloc" bytes)
      (let* ((address (foreign-alloc (max bytes 1)))
             (owner (make-allocation address bytes #f)))
        (do ((i 0 (+ i 1))) ((= i bytes)) (foreign-set! 'unsigned-8 address i 0))
        (set! allocations (cons owner allocations))
        (make-pointer address owner bytes #t)))
    (define (own p destroy)
      (live-pointer p "own")
      (unless (procedure? destroy) (%fail "own" "type" "expected destructor procedure"))
      (make-pointer (pointer-address p)
        (make-custom-allocation (pointer-address p) 0 #f p destroy)
        (pointer-size p) #t))
    (define (free! p)
      (checked-pointer p "free!")
      (unless (and (zero? (pointer-address p)) (not (pointer-owning? p)))
        (unless (pointer-owning? p) (%fail "free!" "type" "only owning allocations can be freed"))
        (let ((owner (pointer-owner p)))
          (unless (allocation-released? owner)
            (allocation-released?-set! owner #t)
            (if (custom-allocation? owner)
                (let ((original (custom-allocation-original owner))
                      (destroy (custom-allocation-destroy owner)))
                  (custom-allocation-original-set! owner #f)
                  (custom-allocation-destroy-set! owner #f)
                  (destroy original))
                (begin (foreign-free (allocation-address owner))
                       (set! allocations (remq owner allocations)))))))
      #f)
    (define (allocation-count) (length allocations))
    (define (allocation-bytes) (apply + (map allocation-size allocations)))
    (define (view p offset bytes)
      (make-pointer (checked-span p offset bytes 1 "view") (pointer-owner p) bytes #f))
    (define foreign-types
      '#(void unsigned-8 integer-8 unsigned-8 integer-16 unsigned-16
         integer-32 unsigned-32 integer-64 unsigned-64 short unsigned-short
         int unsigned-int long unsigned-long size_t ptrdiff_t single-float
         double-float void* void* void*))
    ;; Type codes, matching native/ffi/native.h and lib/otium/ffi.ot.
    (define KIND_VOID 0)
    (define KIND_BOOL 1)
    ;; Integer kinds run from i8 to ptrdiff-t.
    (define KIND_I8 2)
    (define KIND_PTRDIFF 17)
    (define KIND_FLOAT 18)
    (define KIND_DOUBLE 19)
    (define KIND_POINTER 20)
    (define KIND_CALLBACK 21)
    (define KIND_UTF8 22)
    (define KIND_STRUCT 23)
    (define KIND_UNION 24)
    (define KIND_ARRAY 25)
    (define native-signed (helper "offi_signed" (int) int))
    ;; Sizes, alignments and integer ranges by scalar kind, read from the
    ;; helper once.
    (define kind-tables #f)
    (define (kinds)
      (or kind-tables
        (let ((sizes (make-vector KIND_STRUCT 0))
              (aligns (make-vector KIND_STRUCT 1))
              (lows (make-vector KIND_STRUCT 0))
              (highs (make-vector KIND_STRUCT 0)))
          (do ((k 1 (+ k 1))) ((= k KIND_STRUCT))
            (vector-set! sizes k (native-size k))
            (vector-set! aligns k (native-align k))
            (when (<= KIND_I8 k KIND_PTRDIFF)
              (let* ((bits (* 8 (native-size k)))
                     (signed? (not (zero? (native-signed k))))
                     (limit (expt 2 (if signed? (- bits 1) bits))))
                (vector-set! lows k (if signed? (- limit) 0))
                (vector-set! highs k limit))))
          (set! kind-tables (vector sizes aligns lows highs))
          kind-tables)))
    (define (kind-size k) (vector-ref (vector-ref (kinds) 0) k))
    (define (kind-align k) (vector-ref (vector-ref (kinds) 1) k))
    (define (kind-low k) (vector-ref (vector-ref (kinds) 2) k))
    (define (kind-high k) (vector-ref (vector-ref (kinds) 3) k))
    (define (%sizeof k) (if (and (fixnum? k) (fx< 0 k KIND_STRUCT)) (kind-size k) (native-size k)))
    (define (%alignof k) (if (and (fixnum? k) (fx< 0 k KIND_STRUCT)) (kind-align k) (native-align k)))
    (define (encode k value op)
      (cond
        ((= k KIND_BOOL)
         (unless (boolean? value) (%fail op "type" "expected boolean"))
         (if value 1 0))
        ((<= KIND_I8 k KIND_PTRDIFF)
         (unless (and (integer? value) (exact? value)) (%fail op "type" "expected exact integer"))
         (unless (and (>= value (kind-low k)) (< value (kind-high k)))
           (%fail op "range" "integer outside native range"))
         value)
        ((or (= k KIND_FLOAT) (= k KIND_DOUBLE))
         (unless (and (real? value) (or (inexact? value) (integer? value)))
           (%fail op "type" "expected integer or inexact real"))
         (let ((v (inexact value)))
           (when (or (and (exact? value) (infinite? v))
                     (and (= k KIND_FLOAT) (finite? v)
                       (let ((b (make-bytevector 4)))
                         (bytevector-ieee-single-native-set! b 0 v)
                         (infinite? (bytevector-ieee-single-native-ref b 0)))))
             (%fail op "range" "float overflow")) v))
        ((and (= k KIND_UTF8) (string? value)) (checked-string value op))
        (else
         (live-pointer value op)
         (unless (or (= k KIND_POINTER) (null? value) (and (= k KIND_CALLBACK) (code-pointer? value)))
           (%fail op "type" (if (= k KIND_CALLBACK) "expected null or callback pointer" "expected null pointer")))
         (if (= k KIND_UTF8) #f (pointer-address value)))))
    (define (decode k value)
      (cond ((= k KIND_VOID) #f)
            ((= k KIND_BOOL) (not (zero? value)))
            ((= k KIND_POINTER) (make-pointer value #f #f #f))
            ((= k KIND_CALLBACK) (if (zero? value) (%null) (make-code-pointer value #f #f #f)))
            ((= k KIND_UTF8)
             (if (zero? value) (%null)
                 (let loop ((n 0))
                   (if (zero? (foreign-ref 'unsigned-8 value n))
                       (read-utf8 (make-pointer value #f #f #f) (+ n 1))
                       (loop (+ n 1))))))
            (else value)))
    ;; Safe foreign-ref and foreign-set! check the address out of line, about
    ;; 20 ns each. checked-span has already checked it, so a fixnum address
    ;; uses the unchecked primitive with a constant type.
    (define-syntax kind-case
      (syntax-rules ()
        ((_ k (type) template fallback)
         (case k
           ((1 3) (template unsigned-8)) ((2) (template integer-8))
           ((4) (template integer-16)) ((5) (template unsigned-16))
           ((6) (template integer-32)) ((7) (template unsigned-32))
           ((8) (template integer-64)) ((9) (template unsigned-64))
           ((10) (template short)) ((11) (template unsigned-short))
           ((12) (template int)) ((13) (template unsigned-int))
           ((14) (template long)) ((15) (template unsigned-long))
           ((16) (template size_t)) ((17) (template ptrdiff_t))
           ((18) (template single-float)) ((19) (template double-float))
           ((20 21 22) (template void*))
           (else fallback)))))
    (define (%ref p k offset)
      (let ((address (checked-span p offset (kind-size k) (kind-align k) "ref")))
        (decode k
          (if (fixnum? address)
              (let-syntax ((template (syntax-rules () ((_ t) (($primitive 3 foreign-ref) 't address 0)))))
                (kind-case k (type) template (foreign-ref (vector-ref foreign-types k) address 0)))
              (foreign-ref (vector-ref foreign-types k) address 0)))))
    (define (%set! p k offset value)
      (let ((address (checked-span p offset (kind-size k) (kind-align k) "set!"))
            (v (encode k value "set!")))
        (if (and (fixnum? address) (or (fixnum? v) (flonum? v)))
            (let-syntax ((template (syntax-rules () ((_ t) (($primitive 3 foreign-set!) 't address 0 v)))))
              (kind-case k (type) template (foreign-set! (vector-ref foreign-types k) address 0 v)))
            (foreign-set! (vector-ref foreign-types k) address 0 v))) #f)
    (define (copy! dst src bytes)
      (let ((d (checked-span dst 0 bytes 1 "copy!")) (s (checked-span src 0 bytes 1 "copy!")))
        (if (> d s)
            (do ((i (- bytes 1) (- i 1))) ((< i 0))
              (foreign-set! 'unsigned-8 d i (foreign-ref 'unsigned-8 s i)))
            (do ((i 0 (+ i 1))) ((= i bytes))
              (foreign-set! 'unsigned-8 d i (foreign-ref 'unsigned-8 s i))))) #f)
    (define (read-utf8 p bytes)
      (let ((address (checked-span p 0 bytes 1 "read-utf8")))
        (let loop ((n 0))
          (when (= n bytes) (%fail "read-utf8" "bounds" "no NUL within bound"))
          (if (zero? (foreign-ref 'unsigned-8 address n))
              (begin
                (when (zero? (valid-utf8? address n)) (%fail "read-utf8" "encoding" "invalid UTF-8"))
                (let ((b (make-bytevector n)))
                  (do ((i 0 (+ i 1))) ((= i n))
                    (bytevector-u8-set! b i (foreign-ref 'unsigned-8 address i)))
                  (utf8->string b)))
              (loop (+ n 1))))))
    (define (alloc-utf8 text)
      (let* ((b (string->utf8 (checked-string text "alloc-utf8")))
             (p (%alloc (+ (bytevector-length b) 1) 1)))
        (do ((i 0 (+ i 1))) ((= i (bytevector-length b)))
          (foreign-set! 'unsigned-8 (pointer-address p) i (bytevector-u8-ref b i))) p))
    (define (aggregate-ftype d)
      (let ((k (car d)))
        (cond
          ((< k KIND_STRUCT) (vector-ref foreign-types k))
          ((= k KIND_ARRAY)
           (unless (> (cadr (cadddr d)) 0) (%fail "bind" "signature" "empty by-value array field"))
           `(array ,(cadr (cadddr d)) ,(aggregate-ftype (car (cadddr d)))))
          ((or (= k KIND_STRUCT) (= k KIND_UNION))
           `(,(if (= k KIND_STRUCT) 'struct 'union)
             ,@(map (lambda (f) (list (gensym "field") (aggregate-ftype (cadr f)))) (cadddr d))))
          (else (%fail "bind" "abi" "unsupported aggregate shape")))))
    (define (make-factory arguments result collect-safe?)
      (let* ((all (cons result arguments))
             (names (map (lambda (t) (and (pair? t) (gensym "aggregate"))) all))
             (arg-names (cdr names))
             (result-name (car names))
             (values (map (lambda (t) (gensym "argument")) arguments))
             (destination (gensym "destination")))
        (eval
          `(let ()
             ,@(filter (lambda (x) x)
                 (map (lambda (t name)
                        (and name `(define-ftype ,name ,(aggregate-ftype t)))) all names))
             ,@(filter (lambda (x) x)
                 (map (lambda (t name)
                        (and name `(unless (= (ftype-sizeof ,name) ,(cadr t))
                                     (error 'ffi "native aggregate layout mismatch")))) all names))
             (lambda (address)
               ;; With collect-safe?, the Otium thread is inactive, so a callback on
               ;; another thread can activate without waiting on it, then abort.
               ;; No argument may point into the managed heap.
               (let ((native
                       (foreign-procedure ,@(if collect-safe? '(__collect_safe) '()) address
                         ,(map (lambda (t name)
                                 (if name `(& ,name) (vector-ref foreign-types t))) arguments arg-names)
                         ,(if result-name `(& ,result-name) (vector-ref foreign-types result)))))
                 (lambda ,(if result-name (cons destination values) values)
                   (native
                     ,@(if result-name `((make-ftype-pointer ,result-name ,destination)) '())
                     ,@(map (lambda (name value)
                              (if name `(make-ftype-pointer ,name ,value) value)) arg-names values))))))
          (environment '(chezscheme)))))
    ;; Signatures of scalars and pointers take a fixed-arity call that checks
    ;; arguments inline and builds error context only when a check fails.
    (define (direct? arguments result)
      (and (for-all (lambda (t) (and (integer? t) (< t KIND_UTF8))) arguments)
           (and (integer? result) (< result KIND_UTF8))))
    (define (make-direct-factory arguments result collect-safe?)
      (let ((xs (map (lambda (t) (gensym "x")) arguments))
            (es (map (lambda (t) (gensym "encode")) arguments)))
        (eval
          `(lambda (address encoders enter finish arity-fail)
             ;; See make-factory on __collect_safe.
             (let ((native (foreign-procedure ,@(if collect-safe? '(__collect_safe) '()) address
                             ,(map (lambda (t) (vector-ref foreign-types t)) arguments)
                             ,(vector-ref foreign-types result)))
                   ,@(map (lambda (e i) `(,e (list-ref encoders ,i))) es (iota (length es))))
               (case-lambda
                 (,xs (let* ,(map (lambda (x e) `(,x (,e ,x))) xs es)
                        (enter)
                        (finish (native ,@xs))))
                 (rest (arity-fail)))))
          (environment '(chezscheme)))))
    (define (argument-encoder k slow)
      (cond
        ((= k KIND_BOOL) (lambda (v) (cond ((eq? v #t) 1) ((eq? v #f) 0) (else (slow v)))))
        ((<= KIND_I8 k KIND_PTRDIFF)
         (let ((low (max (kind-low k) (most-negative-fixnum)))
               (high (min (- (kind-high k) 1) (most-positive-fixnum))))
           (lambda (v) (if (and (fixnum? v) (fx<= low v high)) v (slow v)))))
        ((= k KIND_DOUBLE) (lambda (v) (if (flonum? v) v (slow v))))
        ((= k KIND_FLOAT)
         (lambda (v)
           (if (and (flonum? v) (or (not (flfinite? v)) (fl<= (flabs v) 3.4028234663852886e38)))
               v
               (slow v))))
        ((= k KIND_POINTER) (lambda (v) (if (live? v) (pointer-address v) (slow v))))
        (else slow)))
    (define (result-decoder k)
      (cond ((= k KIND_VOID) (lambda (raw) #f))
            ((= k KIND_BOOL) (lambda (raw) (not (eqv? raw 0))))
            ((or (= k KIND_POINTER) (= k KIND_CALLBACK)) (lambda (raw) (decode k raw)))
            (else (lambda (raw) raw))))
    (define (%bind lib name arguments result collect-safe?)
      (unless (boolean? collect-safe?) (%fail "bind" "type" "expected collection safety boolean"))
      (let* ((address (symbol-address lib name "bind"))
             (key (list arguments result collect-safe?))
             (direct (direct? arguments result)))
        (when (zero? address) (%fail "bind" "symbol" "native symbol missing"))
        (let ((factory
                (or (hashtable-ref factories key #f)
                    (let ((f (if direct
                                 (make-direct-factory arguments result collect-safe?)
                                 (make-factory arguments result collect-safe?))))
                      (hashtable-set! factories key f) f)))
              (context (list (cons ':library (native-library-name lib)) (cons ':symbol name))))
          (if direct
              (let ((decode-result (result-decoder result)))
                (factory address
                  (map (lambda (t index)
                         (argument-encoder t
                           (lambda (value)
                             (parameterize ((error-context
                                              (append (list (cons ':argument index)
                                                            (cons ':expected-type (list-ref (core-ref '%scalars) t)))
                                                      context)))
                               (encode t value "call")))))
                       arguments (iota (length arguments)))
                  (lambda () (set! call-depth (fx+ call-depth 1)))
                  (lambda (raw)
                    (set! call-depth (fx- call-depth 1))
                    (when (and pending (fx= call-depth 0))
                      (let ((replay pending))
                        (set! pending #f)
                        (parameterize ((error-context context)) (replay))))
                    (decode-result raw))
                  (lambda () (%fail "call" "arity" "wrong number of native arguments"))))
              (bind-general lib name arguments result (factory address))))))
    (define (bind-general lib name arguments result native)
      (lambda values
        (unless (= (length values) (length arguments)) (%fail "call" "arity" "wrong number of native arguments"))
        (parameterize ((error-context (list (cons ':library (native-library-name lib)) (cons ':symbol name))))
        ;; Temporaries are owning pointers for aggregate copies and raw
        ;; addresses for strings.
        (let ((temporaries '()) (returned #f) (published? #f) (entered? #f))
          (define (leave!)
            (set! entered? #f)
            (set! call-depth (- call-depth 1)))
          (dynamic-wind
            (lambda () (void))
            (lambda ()
              (let* ((encoded
                       (map (lambda (t value index)
                              (parameterize ((error-context (append (list (cons ':argument index) (cons ':expected-type (if (integer? t) (list-ref (core-ref '%scalars) t) #f))) (error-context))))
                              (cond
                                ((pair? t)
                                 (checked-span value 0 (cadr t) (caddr t) "call")
                                 (let ((copy (%alloc (cadr t) (caddr t))))
                                   (set! temporaries (cons copy temporaries))
                                   (copy! copy value (cadr t))
                                   (pointer-address copy)))
                                ((= t KIND_UTF8)
                                 (let ((text (encode t value "call")))
                                   (if text
                                       (let ((address (utf8-temporary text)))
                                         (set! temporaries (cons address temporaries))
                                         address)
                                       0)))
                                (else (encode t value "call"))))) arguments values (iota (length values))))
                     (call-arguments (if (pair? result)
                                    (begin
                                      (set! returned (%alloc (cadr result) (caddr result)))
                                      (cons (pointer-address returned) encoded))
                                    encoded)))
                (set! entered? #t)
                (set! call-depth (+ call-depth 1))
                (let ((raw (apply native call-arguments)))
                  (leave!)
                  (when (and pending (zero? call-depth))
                    (let ((replay pending))
                      (set! pending #f)
                      (replay)))
                  (if (pair? result)
                      (begin (set! published? #t) returned)
                      (decode result raw)))))
            (lambda ()
              (when entered? (leave!))
              (for-each (lambda (t) (if (pointer? t) (free! t) (foreign-free t))) temporaries)
              (when (and returned (not published?)) (free! returned))))))))

    ;; Callbacks run only on the Otium thread while one of its foreign calls is
    ;; active. Nothing may unwind through the native frames between: the first
    ;; contained error or exit is replayed when the outermost call returns.
    (define otium-thread (thread-id))
    (define call-depth 0)
    (define pending #f)
    (define callbacks '())
    (define callables (make-hashtable equal-hash equal?))
    (define (callable-type k) (if (= k KIND_VOID) 'void (vector-ref foreign-types k)))
    (define (make-callable-factory arguments result)
      (eval `(lambda (procedure)
               ;; __collect_safe activates a foreign thread so the check can run.
               (foreign-callable __collect_safe procedure
                 ,(map callable-type arguments) ,(callable-type result)))
            (environment '(chezscheme))))
    (define (callback-abort message)
      (let ((port (current-error-port)))
        (display "otium: " port) (display message port) (newline port)
        (flush-output-port port))
      ((foreign-procedure "abort" () void)))
    (define (callback-default k)
      (if (or (= k KIND_FLOAT) (= k KIND_DOUBLE)) 0.0 0))
    (define (enter-callback arguments result proc raw)
      (unless (eqv? (thread-id) otium-thread)
        (callback-abort "foreign callback invoked on a thread other than the Otium thread"))
      (when (zero? call-depth)
        (callback-abort "foreign callback invoked outside a foreign call from Otium"))
      (ot:call-contained
        (lambda ()
          (parameterize ((error-context '()))
            (let ((value (apply proc (map decode arguments raw))))
              (if (= result KIND_VOID) (void) (encode result value "callback")))))
        (lambda (replay)
          (unless pending
            (set! pending
              (or replay (lambda () (%fail "callback" "escape" "non-local exit from foreign callback")))))
          (callback-default result))))
    (define (%callback arguments result proc)
      (unless (procedure? proc) (%fail "callback" "type" "expected procedure"))
      (let* ((key (cons arguments result))
             (factory (or (hashtable-ref callables key #f)
                          (let ((f (make-callable-factory arguments result)))
                            (hashtable-set! callables key f) f)))
             (code (factory (lambda raw (enter-callback arguments result proc raw)))))
        (lock-object code)
        (let ((cb (make-callback (foreign-callable-entry-point code) #f #f #f code #f)))
          (set! callbacks (cons cb callbacks))
          cb)))
    (define (free-callback! cb)
      (unless (callback? cb) (%fail "free-callback!" "type" "expected callback"))
      (unless (callback-released? cb)
        (unlock-object (callback-code cb))
        (callback-released?-set! cb #t)
        (set! callbacks (remq cb callbacks)))
      #f)
    (define (callback-count) (length callbacks))

    (set-pointer-predicate! (lambda (p) (and (pointer? p) (pointer-owning? p))))
    (list
      (cons '%layout %layout)
      (cons '%layout-data %layout-data)
      (cons '%null %null)
      (cons 'null? null?)
      (cons 'pointer=? pointer=?)
      (cons '%sizeof %sizeof)
      (cons '%alignof %alignof)
      (cons '%alloc %alloc)
      (cons 'free! free!)
      (cons 'own own)
      (cons 'view view)
      (cons '%ref %ref)
      (cons '%set! %set!)
      (cons 'copy! copy!)
      (cons 'read-utf8 read-utf8)
      (cons 'alloc-utf8 alloc-utf8)
      (cons 'allocation-count allocation-count)
      (cons 'allocation-bytes allocation-bytes)
      (cons '%open %open)
      (cons '%loader-error %loader-error)
      (cons 'has-symbol? has-symbol?)
      (cons '%bind %bind)
      (cons '%callback %callback)
      (cons 'free-callback! free-callback!)
      (cons 'callback-count callback-count)
      (cons '%fail %fail)
      (cons '%error-field %error-field)
    )))
