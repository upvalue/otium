(library (otium ports)
  (export public-bindings flush-all!)
  (import (chezscheme) (prefix (otium values) v:)
          (prefix (otium conditions) c:) (prefix (otium bytevectors) b:))

  (define initial-host-output (current-output-port))
  (define registry '())
  (define (field table name default)
    (if (v:table? table) (v:get table (v:keyword name) default) default))
  (define (failure op p reason . detail)
    (c:error (v:table (v:keyword "type") (if (eq? reason 'decode) 'decode-error 'io-error)
                      (v:keyword "op") op (v:keyword "reason") (v:keyword (symbol->string reason))
                      (v:keyword "message") (format "~a: ~a" op reason)
                      (v:keyword "path") (if (v:port-value? p) (v:port-value-name p) p)
                      (v:keyword "detail") (if (null? detail) "" (car detail)))))
  (define (host-call op path thunk)
    (guard (e [(c:otium-condition? e) (raise e)]
              [(c:control-condition? e) (raise e)]
              [else
               (let* ([irritants (if (irritants-condition? e) (condition-irritants e) '())]
                      [host-reason (and (pair? irritants) (car (last-pair irritants)))]
                      [entry (and (string? host-reason)
                        (assoc (string-downcase host-reason)
                          '(("no such file or directory" . not-found) ("file exists" . exists)
                            ("permission denied" . permission) ("operation not permitted" . permission)
                            ("is a directory" . is-directory) ("not a directory" . not-directory)
                            ("no space left on device" . no-space) ("bad file descriptor" . closed))))]
                      [reason (cond [(i/o-file-does-not-exist-error? e) 'not-found]
                                    [(i/o-file-already-exists-error? e) 'exists]
                                    [(i/o-file-protection-error? e) 'permission]
                                    [entry (cdr entry)] [else 'other])]
                      [detail (if (message-condition? e)
                                  (guard (ignored [else (condition-message e)])
                                    (apply format (condition-message e) irritants)) "I/O failure")])
                 (c:error (v:table (v:keyword "type") 'file-error
                          (v:keyword "op") op (v:keyword "path") path
                          (v:keyword "reason") (v:keyword (symbol->string reason))
                          (v:keyword "message") (format "~a: ~a" op detail)
                          (v:keyword "detail") detail)))])
      (thunk)))
  (define (check p input? op)
    (unless (v:port-value? p) (c:error (format "~a: expected port" op)))
    (when (v:port-value-closed? p) (failure op p 'closed))
    (unless (eq? input? (v:port-value-input? p)) (failure op p 'other "wrong port direction")))
  (define (size-option opts)
    (unless (or (v:nil? opts) (v:table? opts)) (c:error "open-port: expected options table"))
    (let ([size (field opts "buffer-size" 4096)])
      (unless (and (fixnum? size) (> size 0)) (c:error "open-port: invalid buffer-size"))
      ;; Four bytes are needed to peek one complete Unicode scalar.
      (max size 4)))
  (define (new-port name input? kind host size callbacks extract)
    (let ([p (v:make-port-value name input? kind host (make-bytevector size)
                              0 0 0 #f #f callbacks extract)])
      (when (memq kind '(file custom)) (set! registry (cons p registry)))
      p))
  (define (reject-directory path op)
    (when (file-directory? path)
      (c:error (v:table (v:keyword "type") 'file-error
                       (v:keyword "message") (format "~a: is-directory: ~a" op path)
                       (v:keyword "op") op (v:keyword "path") path
                       (v:keyword "reason") (v:keyword "is-directory")
                       (v:keyword "detail") "Is a directory"))))
  (define (open-input path . opts)
    (path! path 'open-input-file)
    (reject-directory path 'open-input-file)
    (let ([size (size-option (if (null? opts) (void) (car opts)))])
      (when (> (length opts) 1) (c:error "open-input-file: too many arguments"))
      (host-call 'open-input-file path
        (lambda () (new-port path #t 'file
                     (open-file-input-port path (file-options) 'none) size #f #f)))))
  (define (open-output path . opts)
    (path! path 'open-output-file)
    (reject-directory path 'open-output-file)
    (let* ([options (if (null? opts) (void) (car opts))]
           [size (size-option options)] [mode (field options "if-exists" (v:keyword "truncate"))])
      (when (> (length opts) 1) (c:error "open-output-file: too many arguments"))
      (unless (memq mode (list (v:keyword "truncate") (v:keyword "append") (v:keyword "error")))
        (c:error "open-output-file: invalid :if-exists"))
      (host-call 'open-output-file path
        (lambda ()
          (let ([host (open-file-output-port path
                        (cond [(eq? mode (v:keyword "error")) (file-options)]
                              [(eq? mode (v:keyword "append")) (file-options no-fail no-truncate)]
                              [else (file-options no-fail)]) 'none)])
            (when (eq? mode (v:keyword "append")) (set-port-position! host (file-length host)))
            (new-port path #f 'file host size #f #f))))))
  (define (input-bytes bytes)
    (unless (bytevector? bytes) (c:error "open-input-bytevector: expected bytevector"))
    (new-port "bytevector" #t 'memory (open-bytevector-input-port (bytevector-copy bytes)) 4096 #f #f))
  (define (output-memory kind)
    (let-values ([(host extract) (open-bytevector-output-port)])
      (new-port (symbol->string kind) #f kind host 4096 #f extract)))
  (define standard-input (new-port "stdin" #t 'standard (standard-input-port) 4096 #f #f))
  (define standard-output (new-port "stdout" #f 'standard (standard-output-port) 4096 #f #f))
  (define standard-error (new-port "stderr" #f 'standard (standard-error-port) 4 #f #f))
  (define current-input (make-parameter standard-input))
  (define current-output (make-parameter standard-output))
  (define current-error (make-parameter standard-error))
  (define (optional-port rest default op)
    (when (> (length rest) 1) (c:error (format "~a: too many arguments" op)))
    (if (null? rest) (default) (car rest)))
  (define (callback p name)
    (field (v:port-value-callbacks p) name #f))
  (define (flush p)
    (check p #f 'flush-output-port)
    (let ([bytes (v:port-value-buffer p)])
      (let loop ()
        (let ([end (v:port-value-end p)])
          (when (> end 0)
            (let ([count (if (eq? (v:port-value-kind p) 'custom)
                             ((callback p "write") bytes 0 end)
                             (host-call 'write-bytevector (v:port-value-name p)
                               (lambda ()
                                 (if (and (eq? p standard-output) (not (eq? (current-output-port) initial-host-output)))
                                     (display (b:utf8->string bytes 0 end) (current-output-port))
                                     (put-bytevector (v:port-value-host p) bytes 0 end))
                                 end)))])
              (unless (and (fixnum? count) (< 0 count) (<= count end))
                (failure 'write-bytevector p 'other "invalid custom write count"))
              (bytevector-copy! bytes count bytes 0 (- end count))
              (v:port-value-end-set! p (- end count))
              (loop)))))
      (if (eq? (v:port-value-kind p) 'custom)
          (when (callback p "flush") ((callback p "flush")))
          (host-call 'flush-output-port (v:port-value-name p)
            (lambda () (flush-output-port (v:port-value-host p))))))
    (void))
  (define (ensure p count)
    (check p #t 'read)
    (when (eq? p standard-input) (flush standard-output))
    (let ([bytes (v:port-value-buffer p)])
      (let loop ()
        (let ([at (v:port-value-at p)] [end (v:port-value-end p)])
          (when (and (< (- end at) count) (not (v:port-value-eof? p)))
            (when (> at 0)
              (bytevector-copy! bytes at bytes 0 (- end at))
              (set! end (- end at))
              (v:port-value-end-set! p end)
              (v:port-value-at-set! p 0))
            (let ([got (if (eq? (v:port-value-kind p) 'custom)
                           ((callback p "read") bytes end (bytevector-length bytes))
                           (host-call 'read-bytevector (v:port-value-name p)
                             (lambda () (get-bytevector-some! (v:port-value-host p) bytes end
                                                             (- (bytevector-length bytes) end)))))])
              (cond [(eof-object? got) (v:port-value-eof?-set! p #t)]
                    [(and (fixnum? got) (< 0 got) (<= got (- (bytevector-length bytes) end)))
                     (v:port-value-end-set! p (+ end got))]
                    [else (failure 'read-bytevector p 'other "invalid custom read count")]))
            (loop))))))
  (define (advance p n)
    (v:port-value-at-set! p (+ (v:port-value-at p) n))
    (v:port-value-position-set! p (+ (v:port-value-position p) n)))
  (define (peek-byte p)
    (ensure p 1)
    (if (= (v:port-value-at p) (v:port-value-end p)) (eof-object)
        (bytevector-u8-ref (v:port-value-buffer p) (v:port-value-at p))))
  (define (read-byte p)
    (let ([b (peek-byte p)]) (unless (eof-object? b) (advance p 1)) b))
  (define (peek-character p)
    (let ([first (peek-byte p)])
      (if (eof-object? first) first
          (let ([width (cond [(< first 128) 1] [(<= 194 first 223) 2]
                             [(<= 224 first 239) 3] [(<= 240 first 244) 4] [else 0])])
            (define (bad)
              (c:error (v:table (v:keyword "type") 'decode-error
                               (v:keyword "message") "read-char: invalid UTF-8"
                               (v:keyword "op") 'read-char
                               (v:keyword "position") (v:port-value-position p))))
            (when (= width 0) (bad))
            (ensure p width)
            (let ([start (v:port-value-at p)] [bytes (v:port-value-buffer p)])
              (when (< (- (v:port-value-end p) start) width) (bad))
              (if (= width 1) (integer->char first)
                  (let ([second (bytevector-u8-ref bytes (+ start 1))]
                        [low (case first [(224) 160] [(240) 144] [else 128])]
                        [high (case first [(237) 159] [(244) 143] [else 191])])
                    (unless (<= low second high) (bad))
                    (let loop ([i 1] [scalar (bitwise-and first (case width [(2) 31] [(3) 15] [else 7]))])
                      (if (= i width) (integer->char scalar)
                          (let ([byte (bytevector-u8-ref bytes (+ start i))])
                            (unless (<= 128 byte 191) (bad))
                            (loop (+ i 1) (+ (* scalar 64) (bitwise-and byte 63)))))))))))))
  (define (read-character p)
    (let ([c (peek-character p)])
      (unless (eof-object? c)
        (advance p (let ([n (char->integer c)])
                     (cond [(< n 128) 1] [(< n 2048) 2] [(< n 65536) 3] [else 4]))))
      c))
  (define (write-bytes bytes p start end)
    (check p #f 'write-bytevector)
    (unless (and (bytevector? bytes) (fixnum? start) (fixnum? end)
                 (<= 0 start end (bytevector-length bytes))) (c:error "write-bytevector: invalid range"))
    (let ([buffer (v:port-value-buffer p)])
      (let loop ([at start])
        (when (< at end)
          (when (= (v:port-value-end p) (bytevector-length buffer)) (flush p))
          (let ([n (min (- end at) (- (bytevector-length buffer) (v:port-value-end p)))])
            (bytevector-copy! bytes at buffer (v:port-value-end p) n)
            (v:port-value-end-set! p (+ (v:port-value-end p) n))
            (loop (+ at n)))))
      (when (or (eq? p standard-output) (eq? p standard-error)) (flush p)))
    (void))
  (define (close p)
    (unless (v:port-value? p) (c:error "close-port: expected port"))
    (unless (v:port-value-closed? p)
      (unless (v:port-value-input? p) (flush p))
      (v:port-value-closed?-set! p #t)
      (set! registry (remq p registry))
      (if (eq? (v:port-value-kind p) 'custom)
          (when (callback p "close") ((callback p "close")))
          (unless (eq? (v:port-value-kind p) 'standard)
            (host-call 'close-port (v:port-value-name p)
              (lambda () (close-port (v:port-value-host p)))))))
    (void))
  (define (flush-all!)
    (for-each (lambda (p) (unless (or (v:port-value-input? p) (v:port-value-closed? p)) (flush p)))
              (cons standard-output (cons standard-error registry))))
  (define (extract p kind)
    (check p #f 'get-output-bytevector)
    (unless (eq? kind (v:port-value-kind p)) (c:error "get-output: wrong port kind"))
    (flush p)
    ;; Extraction is non-destructive: restore the bytes to the backing port.
    (let ([bytes ((v:port-value-extract p))])
      (put-bytevector (v:port-value-host p) bytes)
      bytes))
  (define (read-count n p)
    (unless (and (fixnum? n) (>= n 0)) (c:error "read-string: invalid count"))
    (check p #t 'read-string)
    (let ([out (open-output-string)])
      (let loop ([left n])
        (if (= left 0) (get-output-string out)
            (let ([c (read-character p)])
              (if (eof-object? c)
                  (if (= left n) c (get-output-string out))
                  (begin (write-char c out) (loop (- left 1)))))))))
  (define (read-into bytes p start end)
    (check p #t 'read-bytevector!)
    (unless (and (bytevector? bytes) (fixnum? start) (fixnum? end)
                 (<= 0 start end (bytevector-length bytes))) (c:error "read-bytevector!: invalid range"))
    (let loop ([at start])
      (if (= at end) (- at start)
          (begin
            (ensure p 1)
            (let ([n (min (- end at) (- (v:port-value-end p) (v:port-value-at p)))])
              (if (= n 0) (if (= at start) (eof-object) (- at start))
                  (begin (bytevector-copy! (v:port-value-buffer p) (v:port-value-at p) bytes at n)
                         (advance p n) (loop (+ at n)))))))))
  (define (scan chars p until? skip?)
    (unless (string? chars) (c:error "scan: expected character set string"))
    (check p #t 'scan)
    (let ([out (and (not skip?) (open-output-string))] [set (string->list chars)])
      (let loop ([count 0])
        (let ([c (peek-character p)])
          (if (or (eof-object? c) (eq? (not (not (memv c set))) until?))
              (if skip? count (get-output-string out))
              (begin (read-character p) (when out (write-char c out)) (loop (+ count 1))))))))
  (define (line p)
    (let ([first (peek-character p)])
      (if (eof-object? first) first
          (let ([text (scan "\n" p #t #f)])
            (let ([newline? (not (eof-object? (peek-character p)))] [n (string-length text)])
              (when newline? (read-character p))
              (if (and newline? (> n 0) (char=? (string-ref text (- n 1)) #\return))
                  (substring text 0 (- n 1)) text))))))
  (define (custom name callbacks input?)
    (unless (and (string? name) (v:table? callbacks)
                 (procedure? (field callbacks (if input? "read" "write") #f)))
      (c:error "make-port: expected name and callback table"))
    (for-each (lambda (name)
                (let ([f (field callbacks name #f)])
                  (unless (or (not f) (procedure? f)) (c:error "make-port: expected callback procedure"))))
              '("close" "flush"))
    (new-port name input? 'custom #f 4096 callbacks #f))
  (define (print-to p objects display? newline?)
    (check p #f 'display-to)
    (let ([out (open-output-string)])
      (let loop ([objects objects] [first? #t])
        (unless (null? objects)
          (unless first? (display " " out))
          (if display? (v:otium-display (car objects) out) (v:otium-write (car objects) out))
          (loop (cdr objects) #f)))
      (when newline? (newline out))
      (let ([bytes (b:string->utf8 (get-output-string out))])
        (write-bytes bytes p 0 (bytevector-length bytes)))))
  (define (path! path op)
    (unless (and (string? path) (not (memv #\nul (string->list path))))
      (c:error (format "~a: expected path without NUL" op))))
  (define (file-info path)
    (path! path 'file-info)
    (host-call 'file-info path
      (lambda ()
        (let ([modified (file-modification-time path)]
              [kind (cond [(file-regular? path) 'file] [(file-directory? path) 'directory] [else 'other])])
          (v:table (v:keyword "type") (v:keyword (symbol->string kind))
                   (v:keyword "size") (if (eq? kind 'file)
                     (call-with-port (open-file-input-port path (file-options) 'none) file-length) 0)
                   (v:keyword "modified") (+ (inexact (time-second modified))
                      (/ (time-nanosecond modified) 1000000000.0)))))))
  (define (filesystem op path thunk)
    (path! path op)
    (host-call op path thunk))
  (define public-bindings
    (list
      
      
      
      
      
      
      
      (cons 'display (lambda objects (print-to (current-output) objects #t #f)))
      (cons 'print (lambda objects (print-to (current-output) objects #t #f)))
      (cons 'write (lambda objects (print-to (current-output) objects #f #f)))
      (cons 'println (lambda objects (print-to (current-output) objects #t #t)))
      (cons 'newline (lambda rest (print-to (optional-port rest current-output 'newline) '() #t #t)))
      (cons 'display-to (lambda (p . objects) (print-to p objects #t #f)))
      (cons 'write-to (lambda (p . objects) (print-to p objects #f #f)))
      (cons 'port? v:port-value?)
      (cons 'input-port? (lambda (p) (and (v:port-value? p) (v:port-value-input? p))))
      (cons 'output-port? (lambda (p) (and (v:port-value? p) (not (v:port-value-input? p)))))
      (cons 'input-port-open? (lambda (p) (and (v:port-value? p) (v:port-value-input? p) (not (v:port-value-closed? p)))))
      (cons 'output-port-open? (lambda (p) (and (v:port-value? p) (not (v:port-value-input? p)) (not (v:port-value-closed? p)))))
      (cons 'current-input-port current-input) (cons 'current-output-port current-output) (cons 'current-error-port current-error)
      (cons 'open-input-file open-input) (cons 'open-binary-input-file open-input)
      (cons 'open-output-file open-output) (cons 'open-binary-output-file open-output)
      (cons 'open-input-string (lambda (s) (input-bytes (b:string->utf8 s))))
      (cons 'open-input-bytevector input-bytes)
      (cons 'open-output-string (lambda () (output-memory 'string)))
      (cons 'open-output-bytevector (lambda () (output-memory 'bytevector)))
      (cons 'get-output-string (lambda (p) (b:utf8->string (extract p 'string))))
      (cons 'get-output-bytevector (lambda (p) (extract p 'bytevector)))
      (cons 'close-port close)
      (cons 'close-input-port (lambda (p) (unless (and (v:port-value? p) (v:port-value-input? p)) (c:error "close-input-port: expected input port")) (close p)))
      (cons 'close-output-port (lambda (p) (unless (and (v:port-value? p) (not (v:port-value-input? p))) (c:error "close-output-port: expected output port")) (close p)))
      (cons 'read-u8 (lambda rest (read-byte (optional-port rest current-input 'read-u8))))
      (cons 'peek-u8 (lambda rest (peek-byte (optional-port rest current-input 'peek-u8))))
      (cons 'read-char (lambda rest (read-character (optional-port rest current-input 'read-char))))
      (cons 'peek-char (lambda rest (peek-character (optional-port rest current-input 'peek-char))))
      (cons '%read-characters (lambda (n . rest) (read-count n (optional-port rest current-input 'read-string))))
      (cons 'read-line (lambda rest (line (optional-port rest current-input 'read-line))))
      (cons 'read-all (lambda rest (scan "" (optional-port rest current-input 'read-all) #t #f)))
      (cons 'read-until (lambda (chars . rest) (scan chars (optional-port rest current-input 'read-until) #t #f)))
      (cons 'read-while (lambda (chars . rest) (scan chars (optional-port rest current-input 'read-while) #f #f)))
      (cons 'skip-while (lambda (chars . rest) (scan chars (optional-port rest current-input 'skip-while) #f #t)))
      (cons 'read-bytevector (lambda (n . rest)
        (unless (and (fixnum? n) (>= n 0)) (c:error "read-bytevector: invalid count"))
        (let* ([bytes (make-bytevector n)] [got (read-into bytes (optional-port rest current-input 'read-bytevector) 0 n)])
          (if (eof-object? got) got (b:bytevector-copy bytes 0 got)))))
      (cons 'read-bytevector! (case-lambda [(b) (read-into b (current-input) 0 (bytevector-length b))]
                              [(b p) (read-into b p 0 (bytevector-length b))]
                              [(b p start) (read-into b p start (bytevector-length b))]
                              [(b p start end) (read-into b p start end)]))
      (cons 'write-bytevector (case-lambda [(b) (write-bytes b (current-output) 0 (bytevector-length b))]
                              [(b p) (write-bytes b p 0 (bytevector-length b))]
                              [(b p start) (write-bytes b p start (bytevector-length b))]
                              [(b p start end) (write-bytes b p start end)]))
      (cons 'write-u8 (lambda (b . rest) (write-bytes (b:bytevector b) (optional-port rest current-output 'write-u8) 0 1)))
      (cons 'write-char (lambda (c . rest)
        (let ([b (b:string->utf8 (string c))]) (write-bytes b (optional-port rest current-output 'write-char) 0 (bytevector-length b)))))
      (cons 'write-string (case-lambda
        [(s) ((cdr (assq 'write-string public-bindings)) s (current-output))]
        [(s p) ((cdr (assq 'write-string public-bindings)) s p 0 (string-length s))]
        [(s p start) ((cdr (assq 'write-string public-bindings)) s p start (string-length s))]
        [(s p start end) (let ([b (b:string->utf8 s start end)]) (write-bytes b p 0 (bytevector-length b)))]))
      (cons 'flush-output-port (lambda rest (flush (optional-port rest current-output 'flush-output-port))))
      
      
      )))
