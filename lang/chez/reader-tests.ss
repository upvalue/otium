(import (chezscheme) (otium reader) (prefix (otium values) val:))

(define (check value) (unless value (error 'reader-tests "check failed")))
(for-each
  (lambda (text)
    (check (guard (c [(reader-incomplete? c) #t] [else #f]) (read-string text) #f)))
  '("(" "[" "{" "'" "`" "," ",@" "(a ." "\"text" "\"\\x41"))
(for-each
  (lambda (text)
    (check (guard (c [(reader-incomplete? c) #f] [else #t]) (read-string text) #f)))
  '("(]" "[)" "#;1" "1/2" "\"\\q\""))
(let ([port (open-string-input-port "1 ;between\n[2] :end")])
  (check (= (read-otium port "fixture") 1))
  (check (equal? (read-otium port "fixture") '(array 2)))
  (check (eq? (read-otium port "fixture") (val:keyword "end")))
  (check (eof-object? (read-otium port "fixture"))))
(check (guard (c [(irritants-condition? c)
                  (equal? (condition-irritants c) '("broken-source" 2))] [else #f])
         (read-otium (open-string-input-port "(]") "broken-source") #f))
(let ([a (val:array)])
  (val:push! a 'a 'b 'c)
  (val:pop! a)
  (let ([storage ((record-accessor (record-rtd a) 0) a)])
    (check (eq? (vector-ref storage 2) (void)))
    (check (eq? (vector-ref storage 3) (void)))))
;; Native implementation files retain Chez's reader and truth semantics.
(check (vector? (read (open-string-input-port "#(1 2)"))))
(check (equal? (read (open-string-input-port "[a b]")) '(a b)))
(check (if (void) #t #f))
(display "Reader incompleteness, positions, streaming, cleared capacity, native boundary passed\n")
