#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
interactive=yes
explicit_repl=no
skip=no
for argument do
  if [ "$skip" = yes ]; then skip=no; continue; fi
  case "$argument" in
    --) break ;;
    -L|--path|--project) skip=yes ;;
    --load) skip=yes; interactive=no ;;
    --load=*|--help|-h) interactive=no ;;
    --repl) explicit_repl=yes ;;
    --*) ;;
    *) interactive=no ;;
  esac
done
if [ "$explicit_repl" = yes ]; then interactive=yes; fi
if [ "$interactive" = yes ] && [ -t 0 ] && [ -t 1 ]; then
  platform=$(uname -m)-$(uname -s | tr '[:upper:]' '[:lower:]')
  case $(uname -s) in Darwin) extension=dylib ;; *) extension=so ;; esac
  OTIUM_LINE_LIBRARY="$root/../shared/build/$platform/libotium-line.$extension"
  for source in Makefile line-edit.c line-edit.h vendor/bestline/bestline.c vendor/bestline/bestline.h; do
    if [ ! -f "$OTIUM_LINE_LIBRARY" ] || [ "$root/../shared/$source" -nt "$OTIUM_LINE_LIBRARY" ]; then
      make -s -C "$root/../shared" "build/$platform/libotium-line.$extension"
      break
    fi
  done
  export OTIUM_LINE_LIBRARY
fi
exec "${CHEZ:-chez}" \
  --compile-imported-libraries --libdirs "$root" --script "$root/main.ss" "$@"
