#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/otium-chez.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
"${CHEZ:-chez}" --libdirs "$root" --script "$root/tests.ss" "$scratch"
"${CHEZ:-chez}" --libdirs "$root" --script "$root/macro-tests.ss" "$scratch"
"${CHEZ:-chez}" --libdirs "$root" --script "$root/condition-tests.ss"
"${CHEZ:-chez}" --libdirs "$root" --script "$root/generic-tests.ss" "$scratch"
"${CHEZ:-chez}" --libdirs "$root" --script "$root/environment-tests.ss"
"${CHEZ:-chez}" --libdirs "$root" --script "$root/reader-tests.ss"
"$root/run" --help > /dev/null
demo=$("$root/run" -L "$root/../examples" "$root/../examples/reload.scm")
expected='First callback: 1
Callback after reload, with preserved state: 2'
if [ "$demo" != "$expected" ]; then
  printf 'Unexpected demo output:\n%s\n' "$demo" >&2
  exit 1
fi
printf 'CLI help and reload demo passed\n'
