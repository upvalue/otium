(import (chezscheme) (otium runtime))

(define checks 0)
(define (check label expected actual)
  (unless (equal? expected actual)
    (error 'check label expected actual))
  (set! checks (+ checks 1)))
(define (fails? thunk)
  (guard (c [else #t]) (thunk) #f))
(define (run form) (evaluate form))
(define directory (cadr (command-line)))
(load-path (list directory))
(define (source name forms)
  (let ([path (string-append directory "/" name ".scm")])
    (when (file-exists? path) (delete-file path))
    (call-with-output-file path
      (lambda (port)
        (for-each (lambda (form) (write form port) (newline port)) forms)))))
(define (counter-source increment)
  (source "counter"
    `((ns counter)
      (defonce state (vector 0))
      (define (tick!)
        (vector-set! state 0 (+ (vector-ref state 0) ,increment))
        (vector-ref state 0))
      (define (amount) ,increment))))

(counter-source 1)
(run '(require counter :as c :refer (amount)))
(check "load restores caller namespace" 'user (namespace-name (current-namespace)))
(run '(define (caller) (c/amount)))
(run '(define (referred-caller) (amount)))
(run '(define saved c/amount))
(run '(define callback (live 'c/tick!)))
(run '(define original-state c/state))
(check "initial callback" 1 (run '(callback)))
(counter-source 10)
(run '(require counter :as c))
(check "require without reload uses loaded code" 1 (run '(caller)))
(run '(require counter :as c :refer (amount) :reload))
(check "existing qualified caller updates" 10 (run '(caller)))
(check "existing referred caller updates" 10 (run '(referred-caller)))
(check "saved procedure stays old" 1 (run '(saved)))
(check "existing callback updates and state survives" 11 (run '(callback)))
(check "state keeps its identity" #t (run '(eq? original-state c/state)))
(run '(set! c/state (vector 40)))
(check "assignment through import" 50 (run '(callback)))
(run '(define tick! 0))
(check "import cannot overwrite definition" #t
  (fails? (lambda () (run '(require counter :refer (tick!))))))
(check "definition cannot overwrite import" #t
  (fails? (lambda () (run '(define amount 5)))))

(run '(ns other))
(run '(define (amount) -1))
(check "defining namespace is retained" 10 ((namespace-ref 'user 'caller)))
(check "callback retains source namespace" 60 ((namespace-ref 'user 'callback)))
(run '(ns user))
(run '(define (local) 1))
(run '(define local-callback (live 'local)))
(run '(define (local) 2))
(check "local callback follows redefinition" 2 (run '(local-callback)))
(run '(defonce initialized #f))
(run '(defonce initialized (error "must not run")))
(check "defonce preserves false" #f (run 'initialized))
(check "failed defonce initializer" #t
  (fails? (lambda () (run '(defonce retry (error "failed"))))))
(run '(defonce retry 42))
(check "failed initializer can be retried" 42 (run 'retry))

(run '(define-syntax bump (syntax-rules () [(_ x) (+ x 1)])))
(run '(define (expanded x) (bump x)))
(run '(define-syntax bump (syntax-rules () [(_ x) (+ x 10)])))
(check "compiled macro use retains expansion" 2 (run '(expanded 1)))
(check "new macro use sees replacement" 11 (run '(bump 1)))
(check "lexical scope" 8 (run '(let ([amount (lambda () 8)]) (amount))))
(check "Chez numeric tower" 1/3 (run '(/ 1 3)))
(check "Chez multiple values" '(1 2)
  (call-with-values (lambda () (run '(values 1 2))) list))
(check "top-level begin preserves multiple values" '(3 4)
  (call-with-values (lambda () (run '(begin (values 1 2) (values 3 4)))) list))
(check "Chez vectors" #t (run '(vector? c/state)))
(check "Chez hash tables" 3
  (run '(let ([t (make-eq-hashtable)]) (hashtable-set! t 'x 3) (hashtable-ref t 'x #f))))
(check "tail recursion through imported binding" 100000
  (begin
    (source "tail" '((ns tail) (define (loop n acc)
                                (if (= n 0) acc (loop (- n 1) (+ acc 1))))))
    (run '(require tail))
    (run '(tail/loop 100000 0))))

(source "broken" '((ns broken) (define installed 1) (error "failure")))
(check "load reports failure" #t (fails? (lambda () (run '(require broken)))))
(check "failed load restores namespace" 'user (namespace-name (current-namespace)))
(check "successful forms before failure remain" 1 (namespace-ref 'broken 'installed))
(source "broken" '((ns broken) (define installed 2)))
(run '(require broken))
(check "failed load can be retried" 2 (run 'broken/installed))
(source "broken" '((ns broken) (define installed 3) (error "reload failure")))
(check "reload reports failure" #t
  (fails? (lambda () (run '(require broken :reload)))))
(check "failed reload leaves earlier updates visible" 3 (run 'broken/installed))
(check "failed reload restores namespace" 'user (namespace-name (current-namespace)))
(source "broken" '((ns broken) (define installed 4)))
(run '(require broken :reload))
(check "reload can recover" 4 (run 'broken/installed))
(source "cycle-a" '((ns cycle-a) (require cycle-b)))
(source "cycle-b" '((ns cycle-b) (require cycle-a)))
(check "circular loads fail" #t (fails? (lambda () (run '(require cycle-a)))))
(source "cycle-b" '((ns cycle-b) (define value 7)))
(run '(require cycle-a))
(check "circular load flags recover" 'user (namespace-name (current-namespace)))
(source "wrong" '((ns unexpected)))
(check "namespace declaration must match file" #t
  (fails? (lambda () (run '(require wrong)))))
(source "macros" '((ns macros) (define-syntax m (syntax-rules () [(_) 1]))))
(check "macro imports explicitly rejected" #t
  (fails? (lambda () (run '(require macros :refer (m))))))

;; Exercise repeated recompilation without allocating new namespace environments.
(do ([n 0 (+ n 1)]) [(= n 100)]
  (counter-source (+ n 1))
  (run '(require counter :as c :reload)))
(check "caller survives repeated reloads" 100 (run '(caller)))
(check "state survives repeated reloads" 60 (run '(vector-ref c/state 0)))

;; Unix process symbols expose libc through Chez directly.
(run '(load-shared-object #f))
(run '(define c-strlen (foreign-procedure "strlen" (string) size_t)))
(check "direct Chez FFI" 5 (run '(c-strlen "otium")))
(printf "~a checks passed\n" checks)
