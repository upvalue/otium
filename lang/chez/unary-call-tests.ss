(import (chezscheme) (otium runtime) (otium reader))

(define checks 0)
(define (check label expected actual)
  (unless (equal? expected actual) (error 'check label expected actual))
  (set! checks (+ checks 1)))
(define (run source) (evaluate (read-otium (open-input-string source))))
(define (fails? source)
  (guard (c [else #t]) (run source) #f))
(run "(require chez)")
(run "(require otium.generic :as g)")

(check "lexical predicate shadowing" 7
  (run "(let ((procedure? 42)) ((fn (x) x) 7))"))
(check "argument and callee run once, argument first" '(argument callee)
  (run "(begin
    (def seen '())
    (def (note x) (set! seen (cons x seen)))
    ((begin (note 'callee) (fn (x) x)) (begin (note 'argument) 9))
    (chez/reverse seen))"))
(check "argument can replace the callee" 62
  (run "(begin
    (def effect-target (fn (x) 61))
    (effect-target (begin (set! effect-target (array 62)) 0)))"))
(check "argument runs before a noncallable error" #t
  (run "(begin
    (def touched #f)
    (chez/guard (c (else touched)) (0 (begin (set! touched #t) 1))))"))
(check "wrong procedure arity" #t (fails? "((fn (x y) x) 1)"))
(check "array index validation" #t (fails? "((array 1) 'bad)"))
(check "false result" #f (run "((fn (x) x) #f)"))
(check "nil result" #t (run "(nil? ((fn (x) x) nil))"))
(check "multiple values" '(20 21)
  (call-with-values (lambda () (run "((fn (x) (chez/values x (+ x 1))) 20)")) list))
(check "unary tail recursion" 77
  (run "(begin
    (def (countdown n) (if (= n 0) 77 (countdown (- n 1))))
    (countdown 100000))"))
(check "array call" 22 (run "((array 11 22) 1)"))
(check "table call" 17 (run "((table :x 17) :x)"))
(check "keyword call" 19 (run "(:x (table :x 19))"))
(check "missing keyword" #t (run "(nil? (:absent (table)))"))

(run "(defclass Point (x :init 3))")
(run "(def point (g/make Point))")
(run "(def (read-x p) (p :x))")
(check "instance cache initial read" 3 (run "(read-x point)"))
(run "(defclass Point (y :init 8) (x :init 4))")
(check "instance cache follows layout migration" 3 (run "(read-x point)"))
(run "(set! (point :x) 99)")
(check "instance cache sees mutation" 99 (run "(read-x point)"))

(define directory (cadr (command-line)))
(load-path (list directory))
(define (source body)
  (call-with-output-file (string-append directory "/unary-target.scm")
    (lambda (port) (display "(ns unary-target)\n" port) (display body port)) 'replace))
(source "(def (target x) (+ x 1))")
(run "(require unary-target :as u :refer (target))")
(run "(def (qualified x) (u/target x))")
(run "(def (referred x) (target x))")
(run "(def saved u/target)")
(run "(def callback (live 'u/target))")
(define (callers)
  (map run '("(qualified 0)" "(referred 0)" "(saved 0)")))
(check "initial imported calls" '(1 1 1) (callers))
(source "(def (target x) (+ x 2))")
(run "(require unary-target :as u :refer (target) :reload)")
(check "imports reload, saved procedure stays old" '(2 2 1) (callers))
(check "live callback reloads" 2 (run "(callback 0)"))
(source "(def target (array 90))")
(run "(require unary-target :as u :refer (target) :reload)")
(check "imported procedure becomes a collection" '(90 90 1) (callers))
(source "(def (target x) (+ x 3))")
(run "(require unary-target :as u :refer (target) :reload)")
(check "imported collection becomes a procedure" '(3 3 1) (callers))
(check "top-level predicate shadowing" 7
  (run "(begin (def procedure? 42) ((fn (x) x) 7))"))

(printf "~a unary call checks passed\n" checks)
