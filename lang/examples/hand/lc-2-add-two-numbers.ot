;; leetcode-2-add-two-numbers.ot - https://leetcode.com/problems/add-two-numbers/description/

(def (add-two-numbers-impl a b accum)
  (if (or (eq? a '()) (eq? b '()))
      accum
      (add-two-numbers-impl (cdr a) (cdr b) (+ accum (car a) (car b)))))

(def (add-two-numbers a b)
  (add-two-numbers-impl a b 0))

(println (add-two-numbers '(2 4 3) '(5 6 4)))
