; otcl is a small Tcl interpreter in Otium, inspired by Picol:
; https://github.com/antirez/picol

(def- (ok value)
  {:code :ok :value value})

(def- (control code value)
  {:code code :value value})

(def- (failed message)
  (control :error message))

(def- (ok? result)
  (eq? (get result :code) :ok))

(def (result-code result)
  (get result :code))

(def (result-value result)
  (get result :value))

(def- (state source)
  {:source source :index 0})

(def- (state-source parser)
  (get parser :source))

(def- (state-index parser)
  (get parser :index))

(def- (state-length parser)
  (string-length (state-source parser)))

(def- (state-end? parser)
  (>= (state-index parser) (state-length parser)))

(def- (state-char parser)
  (if (state-end? parser)
      nil
      (get (state-source parser) (state-index parser))))

(def- (advance! parser)
  (put! parser :index (+ (state-index parser) 1))
  parser)

(def- (char-in? chars char)
  (and (char? char) (string-contains? chars (string char))))

(def- (horizontal-space? char)
  (char-in? " \t" char))

(def- (command-separator? char)
  (char-in? "\n\r;" char))

(def- (variable-char? char)
  (char-in? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_" char))

(def- (uppercase? char)
  (char-in? "ABCDEFGHIJKLMNOPQRSTUVWXYZ" char))

(def- (digit? char)
  (char-in? "0123456789" char))

(def- (expression-space? char)
  (char-in? " \t\n\r" char))

(def- (variable-table interp frame name)
  (if (uppercase? (get name 0))
      (get interp :globals)
      frame))

(def- (get-variable interp frame name)
  (let ((value (get (variable-table interp frame name) name)))
    (if (nil? value)
        (failed (str "No such variable '" name "'"))
        (ok value))))

(def- (set-variable! interp frame name value)
  (put! (variable-table interp frame name) name value)
  value)

(def- (escape-character char)
  (cond
    ((eq? char #\n) "\n")
    ((eq? char #\t) "\t")
    ((eq? char #\r) "\r")
    (else char)))

(def- (parse-braced parser)
  (let ((out (buffer))
        (depth 1)
        (closed #f))
    (advance! parser)
    (while (and (not (state-end? parser)) (not closed))
      (let ((char (state-char parser)))
        (cond
          ((eq? char #\\)
           (buffer-push! out char)
           (advance! parser)
           (unless (state-end? parser)
             (buffer-push! out (state-char parser))
             (advance! parser)))
          ((eq? char #\{) (set! depth (+ depth 1)) (buffer-push! out char) (advance! parser))
          ((eq? char #\})
           (set! depth (- depth 1))
           (advance! parser)
           (if (= depth 0)
               (set! closed #t)
               (buffer-push! out char)))
          (else (buffer-push! out char) (advance! parser)))))
    (if closed
        (ok (buffer->string out))
        (failed "Unterminated brace group"))))

(def- (parse-variable-name parser)
  (let ((start (state-index parser)))
    (while (and (not (state-end? parser)) (variable-char? (state-char parser))) (advance! parser))
    (substring (state-source parser) start (state-index parser))))

; eval-state is defined later. Otium vars are live, so parse-word can call it.
(def- (parse-word interp frame parser stop)
  (if (eq? (state-char parser) #\{)
      (parse-braced parser)
      (let ((out (buffer))
            (quoted #f)
            (done #f)
            (result (ok "")))
        (when (eq? (state-char parser) #\")
          (set! quoted #t)
          (advance! parser))
        (while (and (not done) (ok? result) (not (state-end? parser)))
          (let ((char (state-char parser)))
            (cond
              ((and quoted (eq? char #\")) (set! quoted #f) (advance! parser))
              ((and (not quoted)
                    (or (horizontal-space? char) (command-separator? char) (and (char? stop) (equal? char stop))))
               (set! done #t))
              ((eq? char #\$)
               (advance! parser)
               (let ((name (parse-variable-name parser)))
                 (if (= (string-length name) 0)
                     (buffer-push! out "$")
                     (let ((value (get-variable interp frame name)))
                       (if (ok? value)
                           (buffer-push! out (result-value value))
                           (set! result value))))))
              ((eq? char #\[)
               (advance! parser)
               (let ((value (eval-state interp frame parser #\])))
                 (if (ok? value)
                     (buffer-push! out (result-value value))
                     (set! result value))))
              ((eq? char #\\)
               (advance! parser)
               (if (state-end? parser)
                   (buffer-push! out "\\")
                   (begin
                     (buffer-push! out (escape-character (state-char parser)))
                     (advance! parser))))
              (else (buffer-push! out char) (advance! parser)))))
        (cond
          ((not (ok? result)) result)
          (quoted (failed "Unterminated quoted word"))
          (else (ok (buffer->string out)))))))

(def- (command-end? parser stop)
  (let ((char (state-char parser))) (or (nil? char) (command-separator? char) (and (char? stop) (equal? char stop)))))

(def- (skip-command-start! parser stop)
  (let ((again #t))
    (while again
      (set! again #f)
      (while (and (not (state-end? parser))
                  (or (horizontal-space? (state-char parser)) (command-separator? (state-char parser))))
        (advance! parser))
      (when (and (not (state-end? parser))
                 (eq? (state-char parser) #\#)
                 (not (and (char? stop) (equal? (state-char parser) stop))))
        (while (and (not (state-end? parser)) (not (eq? (state-char parser) #\newline))) (advance! parser))
        (set! again #t)))))

(def- (arity-error name)
  (failed (str "Wrong number of args for " name)))

(def- (expr-skip! parser)
  (while (and (not (state-end? parser)) (expression-space? (state-char parser))) (advance! parser)))

(def- (expr-error! parser)
  (put! parser :error #t)
  0)

(def- (expr-read-number parser)
  (expr-skip! parser)
  (let ((start (state-index parser))
        (exponent #f)
        (scanning #t))
    (while scanning
      (cond
        ((state-end? parser) (set! scanning #f))
        ((or (digit? (state-char parser)) (eq? (state-char parser) #\.)) (advance! parser))
        ((and (not exponent) (char-in? "eE" (state-char parser)))
         (set! exponent #t)
         (advance! parser)
         (when (and (not (state-end? parser)) (char-in? "+-" (state-char parser))) (advance! parser)))
        (else (set! scanning #f))))
    (let ((number (string->number (substring (state-source parser) start (state-index parser)))))
      (if (nil? number)
          (expr-error! parser)
          number))))

(def- (expr-match? parser text)
  (equal? (substring (state-source parser) (state-index parser) (+ (state-index parser) (string-length text))) text))

(def- (expr-operator parser)
  (cond
    ((expr-match? parser "||") ["||" 0 2])
    ((expr-match? parser "&&") ["&&" 1 2])
    ((expr-match? parser "<=") ["<=" 2 2])
    ((expr-match? parser ">=") [">=" 2 2])
    ((expr-match? parser "==") ["==" 2 2])
    ((expr-match? parser "!=") ["!=" 2 2])
    ((expr-match? parser "<") ["<" 2 1])
    ((expr-match? parser ">") [">" 2 1])
    ((expr-match? parser "+") ["+" 3 1])
    ((expr-match? parser "-") ["-" 3 1])
    ((expr-match? parser "*") ["*" 4 1])
    ((expr-match? parser "/") ["/" 4 1])
    (else nil)))

(def- (numeric-truth? number)
  (not (= number 0)))

(def- (boolean-number value)
  (if value
      1
      0))

(def- (apply-expression-operator operator left right)
  (cond
    ((equal? operator "+") (+ left right))
    ((equal? operator "-") (- left right))
    ((equal? operator "*") (* left right))
    ((equal? operator "/") (/ left right))
    ((equal? operator "<") (boolean-number (< left right)))
    ((equal? operator ">") (boolean-number (> left right)))
    ((equal? operator "<=") (boolean-number (<= left right)))
    ((equal? operator ">=") (boolean-number (>= left right)))
    ((equal? operator "==") (boolean-number (= left right)))
    ((equal? operator "!=") (boolean-number (not (= left right))))
    ((equal? operator "||") (boolean-number (or (numeric-truth? left) (numeric-truth? right))))
    ((equal? operator "&&") (boolean-number (and (numeric-truth? left) (numeric-truth? right))))
    (else 0)))

(def- (parse-expression-primary parser)
  (expr-skip! parser)
  (cond
    ((state-end? parser) (expr-error! parser))
    ((eq? (state-char parser) #\()
     (advance! parser)
     (let ((value (parse-expression parser 0)))
       (expr-skip! parser)
       (if (eq? (state-char parser) #\))
           (begin
             (advance! parser)
             value)
           (expr-error! parser))))
    ((eq? (state-char parser) #\-) (advance! parser) (- (parse-expression parser 5)))
    ((eq? (state-char parser) #\+) (advance! parser) (parse-expression parser 5))
    (else (expr-read-number parser))))

(def- (parse-expression parser minimum-precedence)
  (let ((left (parse-expression-primary parser))
        (done #f))
    (expr-skip! parser)
    (while (and (not done) (not (get parser :error)))
      (let ((operator (expr-operator parser)))
        (if (or (nil? operator) (< (get operator 1) minimum-precedence))
            (set! done #t)
            (begin
              (put! parser :index (+ (state-index parser) (get operator 2)))
              (let ((right (parse-expression parser (+ (get operator 1) 1))))
                (set! left (apply-expression-operator (get operator 0) left right)))
              (expr-skip! parser)))))
    left))

(def- (command-expr interp frame args)
  (if (= (length args) 0)
      (arity-error "expr")
      (let ((parser (state (string-join " " args))))
        (put! parser :error #f)
        (let ((value (parse-expression parser 0)))
          (expr-skip! parser)
          (if (or (get parser :error) (not (state-end? parser)))
              (failed "Error in expression")
              (ok (number->string value)))))))

(def- (command-set interp frame args)
  (cond
    ((= (length args) 2) (ok (set-variable! interp frame (get args 0) (get args 1))))
    ((= (length args) 1) (get-variable interp frame (get args 0)))
    (else (arity-error "set"))))

(def- (command-puts interp frame args)
  (cond
    ((= (length args) 1) (println (get args 0)) (ok ""))
    ((and (= (length args) 2) (equal? (get args 0) "-nonewline")) (display (get args 1)) (ok ""))
    (else (arity-error "puts"))))

(def- (expanded-expression interp frame source)
  (eval-state interp frame (state (str "expr " source)) nil))

(def- (command-if interp frame args)
  (let loop ((index 0))
    (if (>= index (length args))
        (arity-error "if")
        (let ((condition (expanded-expression interp frame (get args index)))
              (next (+ index 2)))
          (cond
            ((not (ok? condition)) condition)
            ((> next (length args)) (arity-error "if"))
            ((numeric-truth? (string->number (result-value condition)))
             (eval-state interp frame (state (get args (+ index 1))) nil))
            ((= next (length args)) (ok ""))
            ((equal? (get args next) "elseif") (loop (+ next 1)))
            ((and (equal? (get args next) "else") (= (+ next 2) (length args)))
             (eval-state interp frame (state (get args (+ next 1))) nil))
            (else (arity-error "if")))))))

(def- (command-while interp frame args)
  (if (not (= (length args) 2))
      (arity-error "while")
      (let loop ()
        (let ((condition (expanded-expression interp frame (get args 0))))
          (cond
            ((not (ok? condition)) condition)
            ((not (numeric-truth? (string->number (result-value condition)))) (ok ""))
            (else (let ((body (eval-state interp frame (state (get args 1)) nil)))
                    (match (result-code body)
                      ((or :ok :continue) (loop))
                      (:break (ok ""))
                      (_ body)))))))))

(def- (command-break interp frame args)
  (if (= (length args) 0)
      (control :break "")
      (arity-error "break")))

(def- (command-continue interp frame args)
  (if (= (length args) 0)
      (control :continue "")
      (arity-error "continue")))

(def- (command-return interp frame args)
  (if (or (= (length args) 0) (= (length args) 1))
      (control :return (if (= (length args) 0)
                           ""
                           (get args 0)))
      (arity-error "return")))

(def- (command-proc interp frame args)
  (if (not (= (length args) 3))
      (arity-error "proc")
      (let ((params (string-split (get args 1))))
        (put! (get interp :commands) (get args 0) {:kind :procedure :params params :body (get args 2)})
        (ok ""))))

(def- (call-procedure interp command name args)
  (let ((params (get command :params)))
    (if (not (= (length params) (length args)))
        (failed (str "Proc '" name "' called with wrong arg num"))
        (let ((frame (table))
              (bad-param nil))
          (dotimes (index (length params))
            (let ((param (get params index)))
              (if (uppercase? (get param 0))
                  (set! bad-param param)
                  (put! frame param (get args index)))))
          (if (string? bad-param)
              (failed (str "Procedure parameter '" bad-param "' can't be a global (upcase first character)"))
              (let ((result (eval-state interp frame (state (get command :body)) nil)))
                (if (eq? (result-code result) :return)
                    (ok (result-value result))
                    result)))))))

(def (register-command! interp name function)
  "Register an Otium function taking interpreter, frame, and argument array."
  (put! (get interp :commands) name function)
  interp)

(def- (dispatch interp frame words)
  (let ((name (get words 0))
        (args (drop 1 words))
        (command (get (get interp :commands) name)))
    (cond
      ((nil? command) (failed (str "No such command '" name "'")))
      ((procedure? command) (command interp frame args))
      ((and (table? command) (eq? (get command :kind) :procedure)) (call-procedure interp command name args))
      (else (failed (str "Invalid command '" name "'"))))))

(def- (eval-state interp frame parser stop)
  (let ((last (ok ""))
        (done #f))
    (while (not done)
      (skip-command-start! parser stop)
      (cond
        ((state-end? parser)
         (when (char? stop) (set! last (failed "Unterminated command substitution")))
         (set! done #t))
        ((and (char? stop) (equal? (state-char parser) stop)) (advance! parser) (set! done #t))
        (else (let ((words (array))
                    (command-done #f))
                (while (and (not command-done) (ok? last))
                  (while (and (not (state-end? parser)) (horizontal-space? (state-char parser))) (advance! parser))
                  (if (command-end? parser stop)
                      (set! command-done #t)
                      (let ((word (parse-word interp frame parser stop)))
                        (if (ok? word)
                            (push! words (result-value word))
                            (set! last word)))))
                (if (not (ok? last))
                    (set! done #t)
                    (when (> (length words) 0)
                      (set! last (dispatch interp frame words))
                      (unless (ok? last) (set! done #t))))))))
    last))

(def (make-interpreter)
  "Create an otcl interpreter with a fresh global frame."
  (let ((interp {:commands (table) :globals (table)}))
    (register-command! interp "expr" command-expr)
    (register-command! interp "set" command-set)
    (register-command! interp "puts" command-puts)
    (register-command! interp "if" command-if)
    (register-command! interp "while" command-while)
    (register-command! interp "break" command-break)
    (register-command! interp "continue" command-continue)
    (register-command! interp "proc" command-proc)
    (register-command! interp "return" command-return)
    interp))

(def (eval-result interp source)
  "Evaluate otcl source and return {:code keyword :value string}."
  (eval-state interp (get interp :globals) (state source) nil))

(def (eval-script interp source)
  "Evaluate otcl source, returning its string result or raising on errors."
  (let ((result (eval-result interp source)))
    (if (ok? result)
        (result-value result)
        (error (result-value result)))))
