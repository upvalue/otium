; otcl is a small Tcl interpreter in Otium, inspired by Picol:
; https://github.com/antirez/picol

(define- (ok value) {:code :ok :value value})
(define- (control code value) {:code code :value value})
(define- (failed message) (control :error message))
(define- (ok? result) (eq? (get result :code) :ok))

(define (result-code result) (get result :code))
(define (result-value result) (get result :value))

(define- (state source) {:source source :index 0})
(define- (state-source parser) (get parser :source))
(define- (state-index parser) (get parser :index))
(define- (state-length parser) (string-length (state-source parser)))
(define- (state-end? parser) (>= (state-index parser) (state-length parser)))
(define- (state-char parser)
  (if (state-end? parser) nil (get (state-source parser) (state-index parser))))
(define- (advance! parser)
  (put! parser :index (+ (state-index parser) 1))
  parser)

(define- (char-in? chars char)
  (and (string? char) (string-contains? chars char)))
(define- (horizontal-space? char) (char-in? " \t" char))
(define- (command-separator? char) (char-in? "\n\r;" char))
(define- (variable-char? char)
  (char-in? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_" char))
(define- (uppercase? char) (char-in? "ABCDEFGHIJKLMNOPQRSTUVWXYZ" char))
(define- (digit? char) (char-in? "0123456789" char))
(define- (expression-space? char) (char-in? " \t\n\r" char))

(define- (variable-table interp frame name)
  (if (uppercase? (get name 0)) (get interp :globals) frame))

(define- (get-variable interp frame name)
  (let ((value (get (variable-table interp frame name) name)))
    (if (nil? value)
        (failed (str "No such variable '" name "'"))
        (ok value))))

(define- (set-variable! interp frame name value)
  (put! (variable-table interp frame name) name value)
  value)

(define- (escape-character char)
  (cond ((equal? char "n") "\n")
        ((equal? char "t") "\t")
        ((equal? char "r") "\r")
        (else char)))

(define- (parse-braced parser)
  (let ((out (buffer)) (depth 1) (closed #f))
    (advance! parser)
    (while (and (not (state-end? parser)) (not closed))
      (let ((char (state-char parser)))
        (cond ((equal? char "\\")
               (buffer-push! out char)
               (advance! parser)
               (unless (state-end? parser)
                 (buffer-push! out (state-char parser))
                 (advance! parser)))
              ((equal? char "{")
               (set! depth (+ depth 1))
               (buffer-push! out char)
               (advance! parser))
              ((equal? char "}")
               (set! depth (- depth 1))
               (advance! parser)
               (if (= depth 0)
                   (set! closed #t)
                   (buffer-push! out char)))
              (else
               (buffer-push! out char)
               (advance! parser)))))
    (if closed
        (ok (buffer->string out))
        (failed "Unterminated brace group"))))

(define- (parse-variable-name parser)
  (let ((start (state-index parser)))
    (while (and (not (state-end? parser)) (variable-char? (state-char parser)))
      (advance! parser))
    (substring (state-source parser) start (state-index parser))))

; eval-state is defined later. Otium vars are live, so parse-word can call it.
(define- (parse-word interp frame parser stop)
  (if (equal? (state-char parser) "{")
      (parse-braced parser)
      (let ((out (buffer)) (quoted #f) (done #f) (result (ok "")))
        (when (equal? (state-char parser) "\"")
          (set! quoted #t)
          (advance! parser))
        (while (and (not done) (ok? result) (not (state-end? parser)))
          (let ((char (state-char parser)))
            (cond ((and quoted (equal? char "\""))
                   (set! quoted #f)
                   (advance! parser))
                  ((and (not quoted)
                        (or (horizontal-space? char)
                            (command-separator? char)
                            (and (string? stop) (equal? char stop))))
                   (set! done #t))
                  ((equal? char "$")
                   (advance! parser)
                   (let ((name (parse-variable-name parser)))
                     (if (= (string-length name) 0)
                         (buffer-push! out "$")
                         (let ((value (get-variable interp frame name)))
                           (if (ok? value)
                               (buffer-push! out (result-value value))
                               (set! result value))))))
                  ((equal? char "[")
                   (advance! parser)
                   (let ((value (eval-state interp frame parser "]")))
                     (if (ok? value)
                         (buffer-push! out (result-value value))
                         (set! result value))))
                  ((equal? char "\\")
                   (advance! parser)
                   (if (state-end? parser)
                       (buffer-push! out "\\")
                       (begin
                         (buffer-push! out (escape-character (state-char parser)))
                         (advance! parser))))
                  (else
                   (buffer-push! out char)
                   (advance! parser)))))
        (cond ((not (ok? result)) result)
              (quoted (failed "Unterminated quoted word"))
              (else (ok (buffer->string out)))))))

(define- (command-end? parser stop)
  (let ((char (state-char parser)))
    (or (nil? char)
        (command-separator? char)
        (and (string? stop) (equal? char stop)))))

(define- (skip-command-start! parser stop)
  (let ((again #t))
    (while again
      (set! again #f)
      (while (and (not (state-end? parser))
                  (or (horizontal-space? (state-char parser))
                      (command-separator? (state-char parser))))
        (advance! parser))
      (when (and (not (state-end? parser))
                 (equal? (state-char parser) "#")
                 (not (and (string? stop) (equal? (state-char parser) stop))))
        (while (and (not (state-end? parser))
                    (not (equal? (state-char parser) "\n")))
          (advance! parser))
        (set! again #t)))))

(define- (arity-error name) (failed (str "Wrong number of args for " name)))

(define- (expr-char parser) (state-char parser))
(define- (expr-skip! parser)
  (while (and (not (state-end? parser)) (expression-space? (expr-char parser)))
    (advance! parser)))

(define- (expr-error! parser)
  (put! parser :error #t)
  0)

(define- (expr-read-number parser)
  (expr-skip! parser)
  (let ((start (state-index parser)) (exponent #f) (scanning #t))
    (while scanning
      (cond ((state-end? parser) (set! scanning #f))
            ((or (digit? (expr-char parser)) (equal? (expr-char parser) "."))
             (advance! parser))
            ((and (not exponent) (char-in? "eE" (expr-char parser)))
             (set! exponent #t)
             (advance! parser)
             (when (and (not (state-end? parser))
                        (char-in? "+-" (expr-char parser)))
               (advance! parser)))
            (else (set! scanning #f))))
    (let ((number (string->number
                   (substring (state-source parser) start (state-index parser)))))
      (if (nil? number) (expr-error! parser) number))))

(define- (expr-match? parser text)
  (equal? (substring (state-source parser)
                     (state-index parser)
                     (+ (state-index parser) (string-length text)))
          text))

(define- (expr-operator parser)
  (cond ((expr-match? parser "||") ["||" 0 2])
        ((expr-match? parser "&&") ["&&" 1 2])
        ((expr-match? parser "<=") ["<=" 2 2])
        ((expr-match? parser ">=") [">=" 2 2])
        ((expr-match? parser "==") ["==" 2 2])
        ((expr-match? parser "!=") ["!=" 2 2])
        ((expr-match? parser "<") ["<" 2 1])
        ((expr-match? parser ">") [">" 2 1])
        ((expr-match? parser "+") ["+" 3 1])
        ((expr-match? parser "-") ["-" 3 1])
        ((expr-match? parser "*") ["*" 4 1])
        ((expr-match? parser "/") ["/" 4 1])
        (else nil)))

(define- (numeric-truth? number) (not (= number 0)))
(define- (boolean-number value) (if value 1 0))

(define- (apply-expression-operator operator left right)
  (cond ((equal? operator "+") (+ left right))
        ((equal? operator "-") (- left right))
        ((equal? operator "*") (* left right))
        ((equal? operator "/") (/ left right))
        ((equal? operator "<") (boolean-number (< left right)))
        ((equal? operator ">") (boolean-number (> left right)))
        ((equal? operator "<=") (boolean-number (<= left right)))
        ((equal? operator ">=") (boolean-number (>= left right)))
        ((equal? operator "==") (boolean-number (= left right)))
        ((equal? operator "!=") (boolean-number (not (= left right))))
        ((equal? operator "||")
         (boolean-number (or (numeric-truth? left) (numeric-truth? right))))
        ((equal? operator "&&")
         (boolean-number (and (numeric-truth? left) (numeric-truth? right))))
        (else 0)))

(define- (parse-expression-primary parser)
  (expr-skip! parser)
  (cond ((state-end? parser) (expr-error! parser))
        ((equal? (expr-char parser) "(")
         (advance! parser)
         (let ((value (parse-expression parser 0)))
           (expr-skip! parser)
           (if (equal? (expr-char parser) ")")
               (begin (advance! parser) value)
               (expr-error! parser))))
        ((equal? (expr-char parser) "-")
         (advance! parser)
         (- (parse-expression parser 5)))
        ((equal? (expr-char parser) "+")
         (advance! parser)
         (parse-expression parser 5))
        (else (expr-read-number parser))))

(define- (parse-expression parser minimum-precedence)
  (let ((left (parse-expression-primary parser)) (done #f))
    (expr-skip! parser)
    (while (and (not done) (not (get parser :error)))
      (let ((operator (expr-operator parser)))
        (if (or (nil? operator) (< (get operator 1) minimum-precedence))
            (set! done #t)
            (begin
              (put! parser :index (+ (state-index parser) (get operator 2)))
              (let ((right (parse-expression parser (+ (get operator 1) 1))))
                (set! left
                      (apply-expression-operator (get operator 0) left right)))
              (expr-skip! parser)))))
    left))

(define- (command-expr interp frame args)
  (if (= (length args) 0)
      (arity-error "expr")
      (let ((parser (state (string-join " " args))))
        (put! parser :error #f)
        (let ((value (parse-expression parser 0)))
          (expr-skip! parser)
          (if (or (get parser :error) (not (state-end? parser)))
              (failed "Error in expression")
              (ok (number->string value)))))))

(define- (command-set interp frame args)
  (cond ((= (length args) 2)
         (ok (set-variable! interp frame (get args 0) (get args 1))))
        ((= (length args) 1)
         (get-variable interp frame (get args 0)))
        (else (arity-error "set"))))

(define- (command-puts interp frame args)
  (cond ((= (length args) 1)
         (println (get args 0))
         (ok ""))
        ((and (= (length args) 2) (equal? (get args 0) "-nonewline"))
         (display (get args 1))
         (ok ""))
        (else (arity-error "puts"))))

(define- (expanded-expression interp frame source)
  (eval-state interp frame (state (str "expr " source)) nil))

(define- (command-if interp frame args)
  (let ((index 0) (done #f) (result (ok "")))
    (while (and (not done) (ok? result))
      (if (>= index (length args))
          (begin
            (set! result (arity-error "if"))
            (set! done #t))
          (let ((condition (expanded-expression interp frame (get args index))))
            (if (not (ok? condition))
                (begin (set! result condition) (set! done #t))
                (if (>= (+ index 1) (length args))
                    (begin
                      (set! result (arity-error "if"))
                      (set! done #t))
                    (if (numeric-truth? (string->number (result-value condition)))
                        (begin
                          (set! result
                                (eval-state interp frame (state (get args (+ index 1))) nil))
                          (set! done #t))
                        (begin
                          (set! index (+ index 2))
                          (if (>= index (length args))
                              (set! done #t)
                              (cond ((equal? (get args index) "else")
                                     (if (= (+ index 2) (length args))
                                         (set! result
                                               (eval-state interp frame
                                                           (state (get args (+ index 1))) nil))
                                         (set! result (arity-error "if")))
                                     (set! done #t))
                                    ((equal? (get args index) "elseif")
                                     (set! index (+ index 1)))
                                    (else
                                     (set! result (arity-error "if"))
                                     (set! done #t)))))))))))
    result))

(define- (command-while interp frame args)
  (if (not (= (length args) 2))
      (arity-error "while")
      (let ((running #t) (result (ok "")))
        (while running
          (let ((condition (expanded-expression interp frame (get args 0))))
            (cond ((not (ok? condition))
                   (set! result condition)
                   (set! running #f))
                  ((not (numeric-truth? (string->number (result-value condition))))
                   (set! running #f))
                  (else
                   (let ((body (eval-state interp frame (state (get args 1)) nil)))
                     (cond ((or (ok? body) (eq? (result-code body) :continue)) nil)
                           ((eq? (result-code body) :break)
                            (set! running #f))
                           (else
                            (set! result body)
                            (set! running #f))))))))
        result)))

(define- (command-break interp frame args)
  (if (= (length args) 0) (control :break "") (arity-error "break")))
(define- (command-continue interp frame args)
  (if (= (length args) 0) (control :continue "") (arity-error "continue")))
(define- (command-return interp frame args)
  (if (or (= (length args) 0) (= (length args) 1))
      (control :return (if (= (length args) 0) "" (get args 0)))
      (arity-error "return")))

(define- (command-proc interp frame args)
  (if (not (= (length args) 3))
      (arity-error "proc")
      (let ((params (string-split (get args 1))))
        (put! (get interp :commands) (get args 0)
              {:kind :procedure :params params :body (get args 2)})
        (ok ""))))

(define- (call-procedure interp command name args)
  (let ((params (get command :params)))
    (if (not (= (length params) (length args)))
        (failed (str "Proc '" name "' called with wrong arg num"))
        (let ((frame (table)) (bad-param nil))
          (dotimes (index (length params))
            (let ((param (get params index)))
              (if (uppercase? (get param 0))
                  (set! bad-param param)
                  (put! frame param (get args index)))))
          (if (string? bad-param)
              (failed (str "Procedure parameter '" bad-param
                           "' can't be a global (upcase first character)"))
              (let ((result (eval-state interp frame (state (get command :body)) nil)))
                (if (eq? (result-code result) :return)
                    (ok (result-value result))
                    result)))))))

(define (register-command! interp name function)
  "Register an Otium function taking interpreter, frame, and argument array."
  (put! (get interp :commands) name function)
  interp)

(define- (dispatch interp frame words)
  (let ((name (get words 0)) (args (drop 1 words)))
    (let ((command (get (get interp :commands) name)))
      (cond ((nil? command) (failed (str "No such command '" name "'")))
            ((procedure? command) (command interp frame args))
            ((and (table? command) (eq? (get command :kind) :procedure))
             (call-procedure interp command name args))
            (else (failed (str "Invalid command '" name "'")))))))

(define- (eval-state interp frame parser stop)
  (let ((last (ok "")) (done #f))
    (while (not done)
      (skip-command-start! parser stop)
      (cond ((state-end? parser)
             (when (string? stop) (set! last (failed "Unterminated command substitution")))
             (set! done #t))
            ((and (string? stop) (equal? (state-char parser) stop))
             (advance! parser)
             (set! done #t))
            (else
             (let ((words (array)) (command-done #f))
               (while (and (not command-done) (ok? last))
                 (while (and (not (state-end? parser))
                             (horizontal-space? (state-char parser)))
                   (advance! parser))
                 (if (command-end? parser stop)
                     (set! command-done #t)
                     (let ((word (parse-word interp frame parser stop)))
                       (if (ok? word)
                           (push! words (result-value word))
                           (set! last word)))))
               (if (not (ok? last))
                   (set! done #t)
                   (when (> (length words) 0)
                     (set! last (dispatch interp frame words))
                     (unless (ok? last) (set! done #t))))))))
    last))

(define (make-interpreter)
  "Create an otcl interpreter with a fresh global frame."
  (let ((interp {:commands (table) :globals (table)}))
    (register-command! interp "expr" command-expr)
    (register-command! interp "set" command-set)
    (register-command! interp "puts" command-puts)
    (register-command! interp "if" command-if)
    (register-command! interp "while" command-while)
    (register-command! interp "break" command-break)
    (register-command! interp "continue" command-continue)
    (register-command! interp "proc" command-proc)
    (register-command! interp "return" command-return)
    interp))

(define (eval-result interp source)
  "Evaluate otcl source and return {:code keyword :value string}."
  (eval-state interp (get interp :globals) (state source) nil))

(define (eval-script interp source)
  "Evaluate otcl source, returning its string result or raising on errors."
  (let ((result (eval-result interp source)))
    (if (ok? result)
        (result-value result)
        (error (result-value result)))))
