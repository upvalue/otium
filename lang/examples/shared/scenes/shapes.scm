(define revision "ORBIT / 01")
;; Save this function while either runtime is running. Phase lives in the host.
(define (render! elapsed dt)
  (set! scene-ticks (+ scene-ticks 1))
  (set! scene-phase (+ scene-phase dt))
  (clear! 13 19 32)
  (let grid ((x 0))
    (if (> x 960) #f (begin (line! x 0 x 640 24 33 48) (grid (+ x 40)))))
  (let grid ((y 0))
    (if (> y 640) #f (begin (line! 0 y 960 y 24 33 48) (grid (+ y 40)))))
  (let orbit ((i 0))
    (if (= i 24) #f
        (let ((angle (+ (* i (/ 6.283185 24)) (* scene-phase 0.6)))
              (radius (+ 120 (* 55 (sin (+ scene-phase (* i 0.4)))))))
          (let ((x (+ 480 (* radius (cos angle))))
                (y (+ 335 (* radius (sin angle)))))
            (line! 480 335 x y 38 78 95)
            (rect! (- x 9) (- y 9) 18 18 75 224 190)
            (orbit (+ i 1))))))
  (rect! 466 321 28 28 255 186 95)
  (text! 40 42 "OTIUM / LIVE CANVAS" 230 239 249)
  (text! 40 68 "SDL3 HARDWARE RENDERING / PORTABLE FFI" 121 147 175)
  (text! 40 564 revision 75 224 190)
  (text! 40 588 "EDIT examples/shared/scenes/shapes.scm | R RELOAD | ESC CLOSE" 151 169 192))
