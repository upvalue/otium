;; Run from the repository root. The same entry point runs on C and Chez:
;; ./otium --runtime=c -L tests examples/ui.ot -- --headless --capture /tmp/ui.png
(require (otium.cli :as cli))
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.input :as input))
(require (otium.ui.output :as output))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))

(def command
  (cli/compile
    '(command ui
              (summary "Run a Yoga/SDL_GPU widget scene.")
              (option config
                      (names "--config")
                      (default "build/ui-config.ot")
                      (help "Native library installation data written by the UI build."))
              (option scene (names "--scene") (default "ui.layout") (help "Module exporting a view function."))
              (option script
                      (names "--script")
                      (default "")
                      (help "Optional module exporting (step! tree frame context) for scripted input or reload."))
              (flag headless
                    (names "--headless")
                    (help "Render without showing a window, then exit; requires an SDL GPU backend."))
              (flag offscreen
                    (names "--offscreen")
                    (help "Use a separate render target; implied by headless, capture, or explicit scale."))
              (option frames
                      (names "--frames")
                      (type integer)
                      (range 1 10000)
                      (default 1)
                      (help "Frame count in headless mode."))
              (option width (names "--width") (type integer) (range 1 2147483647) (default 640))
              (option height (names "--height") (type integer) (range 1 2147483647) (default 480))
              (option scale
                      (names "--scale")
                      (type integer)
                      (range 0 4)
                      (default 0)
                      (help "Pixel scale; 0 uses the display density interactively, 1 in headless mode."))
              (option app-name (names "--app-name") (default "Otium UI"))
              (option app-id (names "--app-id") (default "org.otium.ui-demo"))
              (option app-version (names "--app-version") (default "0.1"))
              (option title (names "--title") (default "Otium UI"))
              (option icon
                      (names "--icon")
                      (default "native/ui/assets/otium.png")
                      (help "Application icon as PNG or BMP; empty disables the icon."))
              (flag background (names "--background") (help "Do not request foreground focus."))
              (option capture (names "--capture") (default "") (help "Final frame as .png or .bmp."))
              (option dump-state
                      (names "--dump-state")
                      (default "")
                      (help "Write JSON layout bounds and resource counts."))
              (option driver (names "--driver") (default "") (help "SDL_GPU backend, e.g. metal or vulkan."))
              (flag inject-error (names "--inject-error") (help "Exercise cleanup after a paint failure.")))))

(def (module-function module name)
  (eval (list 'require (string->symbol module)))
  (eval (string->symbol (str module "/" name))))

(def (ends-with? text suffix)
  (and (>= (string-length text) (string-length suffix))
       (equal? suffix (substring text (- (string-length text) (string-length suffix)) (string-length text)))))

(def (bounds-json node path)
  (let ((b (node :bounds)))
    (let ((items (list (str "{\"path\":\""
                            path
                            "\",\"x\":"
                            (b :x)
                            ",\"y\":"
                            (b :y)
                            ",\"width\":"
                            (b :width)
                            ",\"height\":"
                            (b :height)
                            ",\"focused\":"
                            (if (node :focused?)
                                "true"
                                "false")
                            ",\"pressed\":"
                            (if (node :pressed?)
                                "true"
                                "false")
                            ",\"disabled\":"
                            (if (ui/enabled? node)
                                "false"
                                "true")
                            "}"))))
      (dotimes (i (length (ui/children node)))
        (set! items (append items (bounds-json (get (ui/children node) i) (str path "." i)))))
      items)))

(def (tree-json tree)
  (let ((items '()))
    (dotimes (i (length (ui/children tree)))
      (set! items (append items (bounds-json (get (ui/children tree) i) (str i)))))
    (str "[" (string-join "," items) "]")))

(def (sync-view! tree view renderer)
  (ui/reconcile! tree (view))
  (let ((focused (ui/focused tree)))
    (sdl/check (native/text-input renderer
                                  (if focused
                                      (ui/accepts-text? (ui/instance focused))
                                      #f)))))

(def (main args)
  (let ((width (cli/ref args 'width))
        (height (cli/ref args 'height))
        (scale (cli/ref args 'scale))
        (frames (cli/ref args 'frames))
        (headless (cli/ref args 'headless))
        (capture (cli/ref args 'capture))
        (dump (cli/ref args 'dump-state))
        (nodes "[]")
        (primitives 0)
        (frame 0)
        (backend "")
        (context {})
        (step! (if (equal? (cli/ref args 'script) "")
                   (fn (tree frame context) nil)
                   (module-function (cli/ref args 'script) "step!"))))
    (unless (or (equal? capture "") (ends-with? capture ".png") (ends-with? capture ".bmp"))
      (error "Capture must end in .png or .bmp"))
    (unwind-protect
      (let ((window (ui/open {:title (cli/ref args 'title)
                              :width width
                              :height height
                              :scale scale
                              :config (cli/ref args 'config)
                              :headless headless
                              :driver (cli/ref args 'driver)
                              :offscreen (or headless (cli/ref args 'offscreen) (not (equal? capture "")))
                              :app-name (cli/ref args 'app-name)
                              :app-id (cli/ref args 'app-id)
                              :app-version (cli/ref args 'app-version)
                              :icon (cli/ref args 'icon)
                              :background (cli/ref args 'background)
                              :fail-fast? (or headless (cli/ref args 'inject-error))
                              :step! (fn (window)
                                       (step! (get window :tree) (get window :frame) context)
                                       (when (cli/ref args 'inject-error) (error "injected UI failure"))
                                       (when (and headless (= (get window :frame) (- frames 1)))
                                         (ui/capture! window capture)))
                              :after-frame! (fn (window)
                                              (when (and headless (>= (get window :frame) frames)) (ui/close! window)))
                              :before-close! (fn (window)
                                               (set! width (get window :width))
                                               (set! height (get window :height))
                                               (set! scale (get window :scale))
                                               (set! frame (get window :frame))
                                               (set! nodes (tree-json (get window :tree)))
                                               (set! primitives (native/gpu-count (get window :renderer)))
                                               (when (and (or (not headless) (< frame frames))
                                                          (> frame 0)
                                                          (not (equal? capture "")))
                                                 (sdl/check (native/gpu-frame (get window :renderer) capture))))})))
        (set! context
              {:window (get window :window)
               :renderer (get window :renderer)
               :on-cleanup (fn (cleanup) (push! (get window :cleanups) cleanup))})
        (set! backend (native/gpu-driver (get window :renderer)))
        (println "UI-BACKEND" backend)
        (println "UI-RENDER-MODE"
                 (if (native/gpu-offscreen? (get window :renderer))
                     "offscreen"
                     "direct"))
        (ui/set-view! window (fn () ((module-function (cli/ref args 'scene) "view"))))
        (unwind-protect
          (begin
            (ui/run)
            (println "UI-FRAMES" frame)
            (println "UI-PRIMITIVES" primitives))
          (ui/close! window)))
      (println "UI-CLEANUP" (native/live-nodes) (native/live-renderers) (ffi/allocation-count) (sdl/was-init 0)))
    (unless (= 0 (native/text-resources)) (error "UI text resources remain after cleanup"))
    (unless (= 0 (+ (native/live-nodes) (native/live-renderers) (ffi/allocation-count) (sdl/was-init 0)))
      (error "UI resources remain after cleanup"))
    (unless (equal? dump "")
      (output/write-text! dump
                          (str "{\"width\":"
                               width
                               ",\"height\":"
                               height
                               ",\"scale\":"
                               scale
                               ",\"backend\":\""
                               backend
                               "\",\"frames\":"
                               frame
                               ",\"primitives\":"
                               primitives
                               ",\"nodes\":"
                               nodes
                               ",\"remaining_resources\":[0,0,0,0]}\n")))
    0))

(cli/run command main)
