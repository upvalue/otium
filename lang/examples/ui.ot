;; Run from the repository root. The same entry point runs on C and Chez:
;; ./otium --runtime=c --no-project -L shared/lib -L examples -L shared/tests examples/ui.ot -- --headless --capture /tmp/ui.png
(require (otium.cli :as cli))
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.input :as input))
(require (otium.ui.output :as output))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))

(def command
  (cli/compile
    '(command ui
              (summary "Run a Yoga/SDL_GPU widget scene.")
              (option config
                      (names "--config")
                      (default "shared/build/ui-config.ot")
                      (help "Native library installation data written by make ui."))
              (option scene (names "--scene") (default "ui.layout") (help "Module exporting a view function."))
              (option script
                      (names "--script")
                      (default "")
                      (help "Optional module exporting (step! tree frame context) for scripted input or reload."))
              (flag headless
                    (names "--headless")
                    (help "Render without showing a window, then exit; requires an SDL GPU backend."))
              (option frames
                      (names "--frames")
                      (type integer)
                      (range 1 10000)
                      (default 1)
                      (help "Frame count in headless mode."))
              (option width (names "--width") (type integer) (range 1 4096) (default 640))
              (option height (names "--height") (type integer) (range 1 4096) (default 480))
              (option scale
                      (names "--scale")
                      (type integer)
                      (range 0 4)
                      (default 0)
                      (help "Pixel scale; 0 uses the display density interactively, 1 in headless mode."))
              (option app-name (names "--app-name") (default "Otium UI"))
              (option app-id (names "--app-id") (default "org.otium.ui-demo"))
              (option app-version (names "--app-version") (default "0.1"))
              (option title (names "--title") (default "Otium UI"))
              (option icon
                      (names "--icon")
                      (default "shared/ui/assets/otium.png")
                      (help "Application icon as PNG or BMP; empty disables the icon."))
              (flag background (names "--background") (help "Do not request foreground focus."))
              (option capture (names "--capture") (default "") (help "Final frame as .png or .bmp."))
              (option dump-state
                      (names "--dump-state")
                      (default "")
                      (help "Write JSON layout bounds and resource counts."))
              (option driver (names "--driver") (default "") (help "SDL_GPU backend, e.g. metal or vulkan."))
              (flag inject-error (names "--inject-error") (help "Exercise cleanup after a paint failure.")))))

(def (module-function module name)
  (eval (list 'require (string->symbol module)))
  (eval (string->symbol (str module "/" name))))

(def (ends-with? text suffix)
  (and (>= (string-length text) (string-length suffix))
       (equal? suffix (substring text (- (string-length text) (string-length suffix)) (string-length text)))))

(def (bounds-json node path)
  (let ((b (node :bounds)))
    (let ((items (list (str "{\"path\":\""
                            path
                            "\",\"x\":"
                            (b :x)
                            ",\"y\":"
                            (b :y)
                            ",\"width\":"
                            (b :width)
                            ",\"height\":"
                            (b :height)
                            ",\"focused\":"
                            (if (node :focused?)
                                "true"
                                "false")
                            ",\"pressed\":"
                            (if (node :pressed?)
                                "true"
                                "false")
                            ",\"disabled\":"
                            (if (ui/enabled? node)
                                "false"
                                "true")
                            "}"))))
      (dotimes (i (length (ui/children node)))
        (set! items (append items (bounds-json (get (ui/children node) i) (str path "." i)))))
      items)))

(def (tree-json tree)
  (let ((items '()))
    (dotimes (i (length (ui/children tree)))
      (set! items (append items (bounds-json (get (ui/children tree) i) (str i)))))
    (str "[" (string-join "," items) "]")))

(def (sync-view! tree view renderer)
  (ui/reconcile! tree (view))
  (let ((focused (ui/focused tree)))
    (sdl/check (native/text-input renderer
                                  (if focused
                                      (ui/accepts-text? (ui/instance focused))
                                      #f)))))

(def (main args)
  (let ((width (cli/ref args 'width))
        (height (cli/ref args 'height))
        (scale (cli/ref args 'scale))
        (frames (cli/ref args 'frames))
        (headless (cli/ref args 'headless))
        (capture (cli/ref args 'capture))
        (dump (cli/ref args 'dump-state)))
    (when (> (* (max width height) scale) 4096) (error "Physical dimensions must not exceed 4096"))
    (unless (or (equal? capture "") (ends-with? capture ".png") (ends-with? capture ".bmp"))
      (error "Capture must end in .png or .bmp"))
    (let ((settings (native/load-config! (cli/ref args 'config)))) (sdl/load! (native/config-ref settings 'sdl)))
    (let ((view (module-function (cli/ref args 'scene) "view"))
          (step! (if (equal? (cli/ref args 'script) "")
                     (fn (tree frame context) nil)
                     (module-function (cli/ref args 'script) "step!")))
          (tree (ui/root))
          (pointer (input/pointer))
          (window ffi/null)
          (renderer ffi/null)
          (nodes "[]")
          (backend "")
          (primitives 0)
          (frame 0)
          (running #t)
          (cleanups [])
          (context {}))
      (unwind-protect
        (begin
          (sdl/set-main-ready)
          (gpu/configure-app! {:name (cli/ref args 'app-name)
                               :version (cli/ref args 'app-version)
                               :id (cli/ref args 'app-id)
                               :background (or headless (cli/ref args 'background))})
          (sdl/check (sdl/init sdl/INIT_VIDEO))
          (set! window
                (sdl/pointer (sdl/create-window (cli/ref args 'title)
                                                width
                                                height
                                                (+ sdl/WINDOW_HIGH_PIXEL_DENSITY
                                                   (if headless
                                                       sdl/WINDOW_HIDDEN
                                                       0)))))
          (set! renderer
                (sdl/pointer (native/gpu-new window
                                             width
                                             height
                                             (if (and headless (= scale 0))
                                                 1
                                                 scale)
                                             (cli/ref args 'driver))))
          (set! context {:window window :renderer renderer :on-cleanup (fn (cleanup) (push! cleanups cleanup))})
          (set! scale (native/gpu-scale renderer))
          (gpu/present-window! window
                               {:icon (cli/ref args 'icon) :foreground (not (or headless (cli/ref args 'background)))})
          (set! backend (native/gpu-driver renderer))
          (println "UI-BACKEND" backend)
          (sync-view! tree view renderer)
          (while (and running (or (not headless) (< frame frames)))
            (let poll ((event (native/poll-event renderer)))
              (when event
                (let ((kind (get event :kind)))
                  (cond
                    ((eq? kind :quit) (set! running #f))
                    ((eq? kind :focus-lost) (input/cancel! pointer) (input/keyboard! tree event))
                    ((memq kind '(:key-down :key-up :text-input))
                     (input/keyboard! tree
                                      (put (put event :clipboard-read (fn () (native/clipboard-get renderer)))
                                           :clipboard-write (fn (text) (sdl/check (native/clipboard-set text))))))
                    ((memq kind '(:pointer-down :pointer-up :pointer-move :wheel)) (input/dispatch! pointer tree event))
                    (else (error "Unhandled UI event" kind))))
                (when running
                  (sync-view! tree view renderer)
                  (poll (native/poll-event renderer)))))
            (when running
              (step! tree frame context)
              (sync-view! tree view renderer)
              (gpu/layout! tree width height scale)
              (gpu/paint! tree renderer width height 0x101827ff)
              (when (cli/ref args 'inject-error) (error "injected UI failure"))
              (sdl/check (native/gpu-frame renderer
                                           (if (and headless (= frame (- frames 1)))
                                               capture
                                               "")))
              (set! frame (+ frame 1))
              (unless headless (sdl/delay 16))))
          (when (and (or (not headless) (< frame frames)) (> frame 0) (not (equal? capture "")))
            (sdl/check (native/gpu-frame renderer capture)))
          (set! nodes (tree-json tree))
          (set! primitives (native/gpu-count renderer))
          (println "UI-FRAMES" frame)
          (println "UI-PRIMITIVES" primitives))
        (begin
          (ui/dispose! tree)
          (unless (ffi/null? renderer) (native/gpu-free renderer))
          (unless (ffi/null? window) (sdl/destroy-window window))
          (sdl/quit)
          (for-each (fn (cleanup) (cleanup)) cleanups)
          (println "UI-CLEANUP" (native/live-nodes) (native/live-renderers) (ffi/allocation-count) (sdl/was-init 0))))
      (unless (= 0 (native/text-resources)) (error "UI text resources remain after cleanup"))
      (unless (= 0 (+ (native/live-nodes) (native/live-renderers) (ffi/allocation-count) (sdl/was-init 0)))
        (error "UI resources remain after cleanup"))
      (unless (equal? dump "")
        (output/write-text! dump
                            (str "{\"width\":"
                                 width
                                 ",\"height\":"
                                 height
                                 ",\"scale\":"
                                 scale
                                 ",\"backend\":\""
                                 backend
                                 "\",\"frames\":"
                                 frame
                                 ",\"primitives\":"
                                 primitives
                                 ",\"nodes\":"
                                 nodes
                                 ",\"remaining_resources\":[0,0,0,0]}\n")))
      0)))

(cli/run command main)
