(require 'raylib)

(define columns 60)
(define map-rows 30)
(define status-rows 2)
(define cell-size 18)
(define world-width (* columns cell-size))
(define world-height (* (+ map-rows status-rows) cell-size))

(define floor-bg (raylib/rgb 16 19 24))
(define floor-fg (raylib/rgb 74 79 82))
(define wall-bg (raylib/rgb 37 31 28))
(define wall-fg (raylib/rgb 178 146 92))
(define water-bg (raylib/rgb 10 34 48))
(define water-fg (raylib/rgb 40 116 140))
(define player-bg (raylib/rgb 86 66 24))
(define player-fg (raylib/rgb 255 224 128))
(define treasure-fg (raylib/rgb 255 180 48))
(define stairs-fg (raylib/rgb 210 210 200))
(define unseen (raylib/rgb 3 4 6))

(define player-x 8)
(define player-y 8)
(define next-x player-x)
(define next-y player-y)
(define tile-x 0)
(define tile-y 0)
(define tile-wall #f)
(define tile-water #f)
(define tile-visible #f)
(define tile-glyph 46)
(define tile-bg floor-bg)
(define tile-fg floor-fg)
(define destination-width 0.0)
(define destination-height 0.0)
(define destination-x 0.0)
(define destination-y 0.0)
(define render-scale 1.0)

(define (blocked? x y)
  (or (<= x 0)
      (>= x (- columns 1))
      (<= y 0)
      (>= y (- map-rows 1))
      (and (= x 25) (>= y 5) (<= y 24) (not (= y 15)))
      (and (= y 20) (>= x 38) (<= x 52) (not (= x 45)))))

(raylib/set-config-flags! (+ raylib/flag-window-resizable raylib/flag-vsync))
(raylib/init-window 960 576 "Otium roguelike")
(raylib/set-target-fps! 60)

(define font (raylib/default-font))
(define target (raylib/load-render-texture world-width world-height))

(unwind-protect
  (while (not (raylib/window-should-close?))
    (if (raylib/key-pressed? raylib/key-f11) (raylib/toggle-fullscreen!) nil)

    (set! next-x player-x)
    (set! next-y player-y)
    (if (or (raylib/key-pressed? raylib/key-left)
            (raylib/key-pressed? raylib/key-h))
        (set! next-x (- next-x 1))
        nil)
    (if (or (raylib/key-pressed? raylib/key-right)
            (raylib/key-pressed? raylib/key-l))
        (set! next-x (+ next-x 1))
        nil)
    (if (or (raylib/key-pressed? raylib/key-up)
            (raylib/key-pressed? raylib/key-k))
        (set! next-y (- next-y 1))
        nil)
    (if (or (raylib/key-pressed? raylib/key-down)
            (raylib/key-pressed? raylib/key-j))
        (set! next-y (+ next-y 1))
        nil)
    (if (not (blocked? next-x next-y))
        (begin (set! player-x next-x) (set! player-y next-y))
        nil)

    (raylib/begin-texture-mode target)
    (raylib/clear-background unseen)
    (set! tile-y 0)
    (while (< tile-y map-rows)
      (set! tile-x 0)
      (while (< tile-x columns)
        (set! tile-visible
              (<= (+ (abs (- tile-x player-x)) (abs (- tile-y player-y))) 13))
        (if tile-visible
            (begin
              (set! tile-wall
                    (or (= tile-x 0)
                        (= tile-x (- columns 1))
                        (= tile-y 0)
                        (= tile-y (- map-rows 1))
                        (and (= tile-x 25)
                             (>= tile-y 5)
                             (<= tile-y 24)
                             (not (= tile-y 15)))
                        (and (= tile-y 20)
                             (>= tile-x 38)
                             (<= tile-x 52)
                             (not (= tile-x 45)))))
              (set! tile-water
                    (and (>= tile-x 34) (<= tile-x 43)
                         (>= tile-y 7) (<= tile-y 12)))
              (set! tile-glyph (if tile-wall 35 (if tile-water 126 46)))
              (set! tile-bg (if tile-wall wall-bg (if tile-water water-bg floor-bg)))
              (set! tile-fg (if tile-wall wall-fg (if tile-water water-fg floor-fg)))
              (raylib/draw-rectangle (* tile-x cell-size) (* tile-y cell-size)
                                     cell-size cell-size tile-bg)
              (raylib/draw-codepoint font tile-glyph
                                     (+ (* tile-x cell-size) 3)
                                     (+ (* tile-y cell-size) 1)
                                     cell-size tile-fg)
              (if (and (= tile-x 50) (= tile-y 24))
                  (raylib/draw-codepoint font 62
                                         (+ (* tile-x cell-size) 3)
                                         (+ (* tile-y cell-size) 1)
                                         cell-size stairs-fg)
                  nil)
              (if (and (= tile-x 17) (= tile-y 11))
                  (raylib/draw-codepoint font 42
                                         (+ (* tile-x cell-size) 3)
                                         (+ (* tile-y cell-size) 1)
                                         cell-size treasure-fg)
                  nil))
            nil)
        (set! tile-x (+ tile-x 1)))
      (set! tile-y (+ tile-y 1)))

    (raylib/draw-rectangle (* player-x cell-size) (* player-y cell-size)
                           cell-size cell-size player-bg)
    (raylib/draw-codepoint font 64
                           (+ (* player-x cell-size) 3)
                           (+ (* player-y cell-size) 1)
                           cell-size player-fg)
    (raylib/draw-font font "Move with arrows or hjkl. F11 toggles fullscreen."
                      8 (+ (* map-rows cell-size) 7) 16 1 floor-fg)
    (raylib/end-texture-mode)

    (set! render-scale
          (min (/ (raylib/screen-width) (* world-width 1.0))
               (/ (raylib/screen-height) (* world-height 1.0))))
    (set! destination-width (* world-width render-scale))
    (set! destination-height (* world-height render-scale))
    (set! destination-x (/ (- (raylib/screen-width) destination-width) 2.0))
    (set! destination-y (/ (- (raylib/screen-height) destination-height) 2.0))

    (raylib/begin-drawing)
    (raylib/clear-background raylib/black)
    (raylib/draw-render-texture-pro target destination-x destination-y
                                    destination-width destination-height raylib/white)
    (raylib/end-drawing))
  (begin
    (raylib/unload-render-texture! target)
    (raylib/unload-font! font)
    (raylib/close-window)))
