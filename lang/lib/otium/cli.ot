(require otium.process)

(def- (%property spec key fallback)
  (let ((entry (assoc key (cddr spec))))
    (if entry
        (cadr entry)
        fallback)))

(def- (%properties spec key)
  (let ((entry (assoc key (cddr spec))))
    (if entry
        (cdr entry)
        '())))

(def- (%fields spec)
  (filter (fn (x) (member (car x) '(argument option flag counter))) (cddr spec)))

(def- (%positionals fields)
  (filter (fn (field) (eq? (car field) 'argument)) fields))

(def- (%commands spec)
  (filter (fn (x) (eq? (car x) 'command)) (cddr spec)))

(def- (%index text target start)
  (cond
    ((= start (string-length text)) #f)
    ((equal? (substring text start (+ start 1)) target) start)
    (else (%index text target (+ start 1)))))

(def- (%spec-error message)
  (error (string-append "cli/compile: " message)))

(def- (%check-spec spec inherited)
  (unless (and (list? spec) (>= (length spec) 2) (eq? (car spec) 'command) (symbol? (cadr spec)))
    (%spec-error "expected (command name ...)"))
  (let ((ids (map cadr inherited))
        (names (append '("-h" "--help" "--version") (apply append (map (fn (f) (%properties f 'names)) inherited))))
        (optional? #f)
        (variadic? #f)
        (children '()))
    (for-each (fn (entry)
                (unless (and (list? entry) (pair? entry)) (%spec-error "invalid declaration"))
                (let ((kind (car entry)))
                  (cond
                    ((member kind '(argument option flag counter))
                     (unless (and (>= (length entry) 2) (symbol? (cadr entry))) (%spec-error "expected argument name"))
                     (when (or (eq? (cadr entry) 'command-path) (member (cadr entry) ids))
                       (%spec-error "duplicate argument name"))
                     (set! ids (cons (cadr entry) ids))
                     (let ((seen '()))
                       (for-each (fn (attribute)
                                   (unless (and (list? attribute)
                                                (>= (length attribute) 2)
                                                (member (car attribute)
                                                        '(names type
                                                                default
                                                                range
                                                                metavar
                                                                help
                                                                repeat
                                                                required
                                                                global
                                                                negative
                                                                choices
                                                                conflicts
                                                                requires)))
                                     (%spec-error "invalid argument attribute"))
                                   (when (member (car attribute) seen) (%spec-error "duplicate attribute"))
                                   (set! seen (cons (car attribute) seen))
                                   (when (and (not (member (car attribute) '(names range choices conflicts requires)))
                                              (not (= (length attribute) 2)))
                                     (%spec-error "attribute takes one value")))
                                 (cddr entry)))
                     (let ((type (%property entry 'type 'string))
                           (repeat (%property entry 'repeat #f)))
                       (unless (or (procedure? type) (member type '(string integer number path)))
                         (%spec-error "unknown type"))
                       (unless (member repeat '(#f append last)) (%spec-error "invalid repeat policy")))
                     (if (eq? kind 'argument)
                         (begin
                           (when variadic? (%spec-error "variadic argument must be last"))
                           (when (and optional? (%property entry 'required (not (assoc 'default (cddr entry)))))
                             (%spec-error "required argument after optional argument"))
                           (set! optional? (not (%property entry 'required (not (assoc 'default (cddr entry))))))
                           (set! variadic? (eq? (%property entry 'repeat #f) 'append)))
                         (begin
                           (when (null? (%properties entry 'names)) (%spec-error "option needs names"))
                           (for-each (fn (name)
                                       (unless (and (string? name)
                                                    (> (string-length name) 1)
                                                    (string-starts-with? name "-")
                                                    (not (equal? name "--"))
                                                    (not (%index name "=" 0))
                                                    (or (string-starts-with? name "--") (= (string-length name) 2)))
                                         (%spec-error "invalid option spelling"))
                                       (when (member name names) (%spec-error "duplicate option spelling"))
                                       (set! names (cons name names)))
                                     (append (%properties entry 'names)
                                             (if (%property entry 'negative #f)
                                                 (list (%property entry 'negative #f))
                                                 '())))))
                     (let ((range (%properties entry 'range)))
                       (when (and (pair? range)
                                  (not (and (= (length range) 2)
                                            (number? (car range))
                                            (number? (cadr range))
                                            (<= (car range) (cadr range)))))
                         (%spec-error "invalid range"))))
                    ((eq? kind 'command)
                     (when (< (length entry) 2) (%spec-error "command needs a name"))
                     (when (member (cadr entry) children) (%spec-error "duplicate subcommand"))
                     (set! children (cons (cadr entry) children)))
                    ((member kind '(summary version examples))
                     (when (< (length entry) 2) (%spec-error "missing command attribute value")))
                    (else (%spec-error "unknown declaration")))))
              (cddr spec))
    (when (and (pair? children) (pair? (%positionals (%fields spec))))
      (%spec-error "put positional arguments on leaf commands"))
    (for-each (fn (child) (%check-spec child (append inherited (%fields spec)))) (%commands spec))))

(def (compile spec)
  (%check-spec spec '())
  spec)

(def (ref values name . fallback)
  (let ((entry (assoc name values)))
    (cond
      (entry (cadr entry))
      ((null? fallback) #f)
      (else (car fallback)))))

(def (present? values name)
  (if (assoc name values)
      #t
      #f))

(def (outcome-kind outcome)
  (car outcome))

(def (outcome-values outcome)
  (cadr outcome))

(def (outcome-command outcome)
  (caddr outcome))

(def (outcome-diagnostic outcome)
  (cadddr outcome))

(def- (%input-error? c)
  (and (pair? c) (eq? (car c) '%cli-input-error)))

(def- (%fail name token message)
  (error (list '%cli-input-error name token message)))

(def- (%decimal? text)
  (let ((start (if (or (string-starts-with? text "-") (string-starts-with? text "+"))
                   1
                   0)))
    (let loop ((i start))
      (and (> (string-length text) start)
           (or (= i (string-length text)) (and (%index "0123456789" (substring text i (+ i 1)) 0) (loop (+ i 1))))))))

(def- (%number-text? text)
  (let ((length (string-length text)))
    (let loop ((i (if (or (string-starts-with? text "-") (string-starts-with? text "+"))
                      1
                      0))
               (digits 0)
               (dot? #f))
      (cond
        ((= i length) (> digits 0))
        ((%index "0123456789" (substring text i (+ i 1)) 0) (loop (+ i 1) (+ digits 1) dot?))
        ((and (not dot?) (equal? (substring text i (+ i 1)) ".")) (loop (+ i 1) digits #t))
        ((and (> digits 0) (member (substring text i (+ i 1)) '("e" "E"))) (%decimal? (substring text (+ i 1) length)))
        (else #f)))))

(def- (%convert field text)
  (let ((type (%property field 'type 'string))
        (value (cond
                 ((procedure? type) (type text))
                 ((eq? type 'integer)
                  (if (%decimal? text)
                      (string->number text)
                      #f))
                 ((eq? type 'number)
                  (if (%number-text? text)
                      (string->number (if (%decimal? text)
                                          (string-append text ".0")
                                          text))
                      #f))
                 (else text)))
        (range (%properties field 'range))
        (choices (%properties field 'choices)))
    (when (and (member type '(integer number))
               (not (and (number? value)
                         (finite? value)
                         (if (eq? type 'integer)
                             (and (integer? value) (exact? value) (<= -4611686018427387904 value 4611686018427387903))
                             #t))))
      (%fail (cadr field) text "invalid numeric value"))
    (when (and (pair? range) (not (and (number? value) (<= (car range) value (cadr range)))))
      (%fail (cadr field) text "value outside allowed range"))
    (when (and (pair? choices) (not (member value choices))) (%fail (cadr field) text "value is not an allowed choice"))
    value))

(def- (%put values name value)
  (cons (list name value) (filter (fn (entry) (not (eq? name (car entry)))) values)))

(def- (%store values field value)
  (let ((name (cadr field))
        (old (assoc name values))
        (repeat (%property field 'repeat #f)))
    (cond
      ((eq? (car field) 'counter)
       (%put values
             name
             (+ (if old
                    (cadr old)
                    0)
                1)))
      ((eq? repeat 'append)
       (%put values
             name
             (append (if old
                         (cadr old)
                         '())
                     (list value))))
      ((and old (not (eq? repeat 'last))) (%fail name #f "argument supplied more than once"))
      (else (%put values name value)))))

(def- (%option name fields)
  (exists (fn (field)
            (and (or (member name (%properties field 'names)) (equal? name (%property field 'negative #f))) field))
          fields))

(def- (%finish fields values)
  (for-each (fn (field)
              (let ((name (cadr field)))
                (if (present? values name)
                    (begin
                      (for-each (fn (other) (when (present? values other) (%fail name #f "conflicting arguments")))
                                (%properties field 'conflicts))
                      (for-each (fn (other) (unless (present? values other) (%fail name #f "missing dependency")))
                                (%properties field 'requires)))
                    (when (%property field
                                     'required
                                     (and (eq? (car field) 'argument) (not (assoc 'default (cddr field)))))
                      (%fail name #f "required argument is missing")))))
            fields)
  (let loop ((fields fields)
             (out values))
    (if (null? fields)
        out
        (let ((field (car fields))
              (name (cadr field)))
          (loop (cdr fields)
                (if (present? out name)
                    out
                    (%put out
                          name
                          (%property field
                                     'default
                                     (cond
                                       ((eq? (car field) 'counter) 0)
                                       ((eq? (%property field 'repeat #f) 'append) '())
                                       (else #f))))))))))

(def (parse command argv)
  (let ((current command)
        (path (list (symbol->string (cadr command))))
        (globals '())
        (ancestors '()))
    (try
      (let loop ((tokens argv)
                 (values '())
                 (positionals (%positionals (%fields command)))
                 (literal? #f))
        (let ((fields (append globals (%fields current))))
          (cond
            ((null? tokens)
             (when (pair? (%commands current)) (%fail 'command #f "a subcommand is required"))
             (list 'ok (%put (%finish (append ancestors (%fields current)) values) 'command-path path) current #f))
            ((and (not literal?) (equal? (car tokens) "--")) (loop (cdr tokens) values positionals #t))
            ((and (not literal?) (member (car tokens) '("--help" "-h")))
             (list 'help (list (list 'command-path path) (list 'globals globals)) current #f))
            ((and (not literal?) (equal? (car tokens) "--version") (%property command 'version #f))
             (list 'version (%property command 'version #f) current #f))
            ((and (not literal?)
                  (string-starts-with? (car tokens) "-")
                  (not (equal? (car tokens) "-"))
                  (not (and (pair? positionals)
                            (member (%property (car positionals) 'type 'string) '(integer number))
                            (%number-text? (car tokens)))))
             (let ((token (car tokens))
                   (equal (%index token "=" 0))
                   (long? (string-starts-with? token "--"))
                   (name (if long?
                             (if equal
                                 (substring token 0 equal)
                                 token)
                             (substring token 0 2)))
                   (field (%option name fields)))
               (unless field (%fail name token "unknown option"))
               (if (eq? (car field) 'option)
                   (let ((attached (if long?
                                       (and equal (substring token (+ equal 1) (string-length token)))
                                       (and (> (string-length token) 2) (substring token 2 (string-length token)))))
                         (text (cond
                                 (attached attached)
                                 ((pair? (cdr tokens)) (cadr tokens))
                                 (else (%fail (cadr field) token "option needs a value"))))
                         (rest (if attached
                                   (cdr tokens)
                                   (cddr tokens))))
                     (loop rest (%store values field (%convert field text)) positionals literal?))
                   (begin
                     (when (and long? equal) (%fail (cadr field) token "flag takes no value"))
                     (loop (if (and (not long?) (> (string-length token) 2))
                               (cons (string-append "-" (substring token 2 (string-length token))) (cdr tokens))
                               (cdr tokens))
                           (%store values field (not (equal? name (%property field 'negative #f))))
                           positionals
                           literal?)))))
            ((and (not literal?) (pair? (%commands current)))
             (let ((child (assoc (string->symbol (car tokens)) (map (fn (c) (list (cadr c) c)) (%commands current)))))
               (unless child (%fail 'command (car tokens) "unknown subcommand"))
               (set! ancestors (append ancestors (%fields current)))
               (set! globals (append globals (filter (fn (f) (%property f 'global #f)) (%fields current))))
               (set! current (cadr child))
               (set! path (append path (list (car tokens))))
               (loop (cdr tokens) values (%positionals (%fields current)) literal?)))
            ((null? positionals) (%fail 'argument (car tokens) "unexpected argument"))
            (else (let ((field (car positionals)))
                    (loop (cdr tokens)
                          (%store values field (%convert field (car tokens)))
                          (if (eq? (%property field 'repeat #f) 'append)
                              positionals
                              (cdr positionals))
                          literal?))))))
      (catch (%input-error? c)
        (list 'error
              (list (list 'command-path path))
              current
              (list (list 'argument (cadr c)) (list 'token (caddr c)) (list 'message (cadddr c))))))))

(def- (%label field)
  (if (eq? (car field) 'argument)
      (symbol->string (cadr field))
      (string-append (string-join ", "
                                  (append (%properties field 'names)
                                          (if (%property field 'negative #f)
                                              (list (%property field 'negative #f))
                                              '())))
                     (if (eq? (car field) 'option)
                         (string-append " " (%property field 'metavar "VALUE"))
                         ""))))

(def- (%value-text value)
  (cond
    ((string? value) value)
    ((number? value) (number->string value))
    ((eq? value #f) "false")
    ((eq? value #t) "true")
    ((symbol? value) (symbol->string value))
    ((list? value) (string-join ", " (map %value-text value)))
    (else "value")))

(def- (%field-help field)
  (string-append "  "
                 (%label field)
                 "\n      "
                 (%property field 'help "")
                 (if (assoc 'default (cddr field))
                     (string-append " [default: " (%value-text (%property field 'default #f)) "]")
                     "")
                 (if (pair? (%properties field 'range))
                     (string-append " [range: " (string-join ".." (map %value-text (%properties field 'range))) "]")
                     "")
                 (if (pair? (%properties field 'choices))
                     (string-append " [choices: " (string-join ", " (map %value-text (%properties field 'choices))) "]")
                     "")
                 (if (eq? (%property field 'repeat #f) 'append)
                     " [repeatable]"
                     "")
                 "\n"))

(def (format-help command . context)
  (let ((values (if (null? context)
                    '()
                    (car context)))
        (path (ref values 'command-path (list (symbol->string (cadr command)))))
        (fields (append (ref values 'globals '()) (%fields command))))
    (string-append (%property command 'summary "")
                   "\n\nUsage: "
                   (string-join " " path)
                   " [OPTIONS]"
                   (if (pair? (%commands command))
                       " COMMAND"
                       "")
                   (apply string-append
                          (map (fn (f)
                                 (string-append " "
                                                (if (%property f 'required (not (assoc 'default (cddr f))))
                                                    ""
                                                    "[")
                                                (symbol->string (cadr f))
                                                (if (eq? (%property f 'repeat #f) 'append)
                                                    "..."
                                                    "")
                                                (if (%property f 'required (not (assoc 'default (cddr f))))
                                                    ""
                                                    "]")))
                               (%positionals fields)))
                   "\n\nArguments and options:\n"
                   (apply string-append (map %field-help fields))
                   "  -h, --help\n      Show help\n"
                   (if (%property command 'version #f)
                       "  --version\n      Show version\n"
                       "")
                   (if (null? (%commands command))
                       ""
                       (string-append "\nCommands:\n"
                                      (apply string-append
                                             (map (fn (c)
                                                    (string-append "  "
                                                                   (symbol->string (cadr c))
                                                                   "  "
                                                                   (%property c 'summary "")
                                                                   "\n"))
                                                  (%commands command)))))
                   (if (null? (%properties command 'examples))
                       ""
                       (string-append "\nExamples:\n"
                                      (apply string-append
                                             (map (fn (e) (string-append "  " (car e) "\n      " (cadr e) "\n"))
                                                  (%properties command 'examples))))))))

(def (format-error outcome)
  (let ((diagnostic (outcome-diagnostic outcome)))
    (string-append "error: "
                   (%value-text (ref diagnostic 'argument))
                   ": "
                   (ref diagnostic 'message)
                   (if (ref diagnostic 'token)
                       (string-append "; got \"" (ref diagnostic 'token) "\"")
                       "")
                   "\nTry '"
                   (string-join " " (ref (outcome-values outcome) 'command-path))
                   " --help' for more information.\n")))

(def (run command main . supplied)
  (let ((outcome (parse command
                        (if (null? supplied)
                            (otium.process/arguments)
                            (car supplied)))))
    (cond
      ((eq? (outcome-kind outcome) 'ok) (exit (main (outcome-values outcome))))
      ((eq? (outcome-kind outcome) 'help)
       (display (format-help (outcome-command outcome) (outcome-values outcome)))
       (exit 0))
      ((eq? (outcome-kind outcome) 'version) (display (outcome-values outcome)) (newline) (exit 0))
      (else (otium.process/write-error (format-error outcome)) (exit 2)))))
