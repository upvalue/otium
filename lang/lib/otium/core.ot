;; prelude.ot -- the derived core (spec 10.x), loaded through the real
;; expander, so defmacro and everything native is available.
;;
;; Runtime dependencies: cons car cdr list append length reverse for-each
;; get put! push! pop! keys values copy table array apply identity
;; arithmetic, comparisons, string natives (10.6), type predicates, not,
;; eq? equal?, error, condition-of-type?, gensym.
;; Additionally assumed for sort: (string<? a b) lexicographic order.

(def (is-a? value class)
  "(is-a? value Class)\nTest whether value belongs to Class or a descendant, including built-in types. Class must be a class descriptor."
  (class-subtype? (dispatch-type value) class))

;; --- internal helpers -------------------------------------------------------

(def- (to-list seq)
  "Coerce any sequence to a proper list."
  (cond
    ((nil? seq) '())
    ((array? seq) (array-to-list seq))
    ((list? seq) seq)
    (else (error "to-list: expected sequence"))))

(def- (finish-like source values)
  (if (array? source)
      (list-to-array values)
      values))

(def- (builder-like source)
  (if (array? source)
      (array)
      '()))

(def- (builder-add builder value)
  (if (array? builder)
      (begin
        (push! builder value)
        builder)
      (cons value builder)))

(def- (builder-finish builder)
  (if (array? builder)
      builder
      (reverse builder)))

(def- (slice seq start count)
  (if (array? seq)
      (let ((out (array))
            (i start)
            (end (if (nil? count)
                     (length seq)
                     (min (+ start count) (length seq)))))
        (while (< i end)
          (push! out (get seq i))
          (set! i (+ i 1)))
        out)
      (let ((s (to-list seq))
            (skip start))
        (while (and (pair? s) (> skip 0))
          (set! s (cdr s))
          (set! skip (- skip 1)))
        (if (nil? count)
            s
            (let ((acc '())
                  (left count))
              (while (and (pair? s) (> left 0))
                (set! acc (cons (car s) acc))
                (set! s (cdr s))
                (set! left (- left 1)))
              (reverse acc))))))

(def- (require-int who value)
  (if (int? value)
      value
      (error (str who ": expected integer"))))

;; --- macros (10.11) ---------------------------------------------------------

(defmacro when (test . body)
  "(when test body ...)\nEvaluate body when test is truthy; otherwise return nil."
  `(if ,test
       (begin ,@body)
       nil))

(defmacro unless (test . body)
  "(unless test body ...)\nEvaluate body when test is falsy; otherwise return nil."
  `(if ,test
       nil
       (begin ,@body)))

(def- (case-clauses value clauses)
  (if (null? clauses)
      '()
      (let ((clause (car clauses)))
        (unless (and (list? clause) (pair? clause)) (error "case: expected a clause" clause))
        (let ((alternatives (car clause)))
          (if (eq? alternatives 'else)
              (begin
                (unless (null? (cdr clauses)) (error "case: else must be last"))
                (list clause))
              (begin
                (unless (list? alternatives) (error "case: expected literal alternatives" alternatives))
                (cons (cons (cons 'or (map (fn (datum) `(equal? ,value ',datum)) alternatives)) (cdr clause))
                      (case-clauses value (cdr clauses)))))))))

(defmacro case (expression . clauses)
  "(case expression ((literal ...) body ...) ... (else body ...))\nEvaluate expression once and run the first equal? literal clause. Return nil if none matches."
  (let ((value (gensym "case"))) `(let ((,value ,expression)) (cond ,@(case-clauses value clauses)))))

(defmacro dotimes (spec . body)
  "(dotimes (index count) body ...)\nEvaluate count once, then run body with index from 0 below count. Return nil."
  (let ((sp (if (eq? (car spec) 'array)
                (cdr spec)
                spec)))
    (let ((i (car sp))
          (n (car (cdr sp)))
          (lim (gensym "lim")))
      `(let ((,lim ,n)
             (,i 0))
         (while (< ,i ,lim)
           ,@body
           (set! ,i (+ ,i 1)))
         nil))))

;; --- sequences (10.4) -------------------------------------------------------

(def (caar p)
  "(caar pair)\nEquivalent to (car (car pair))."
  (car (car p)))

(def (cadr p)
  "(cadr pair)\nEquivalent to (car (cdr pair))."
  (car (cdr p)))

(def (cddr p)
  "(cddr pair)\nEquivalent to (cdr (cdr pair))."
  (cdr (cdr p)))

(def (list-to-array value)
  "(list-to-array sequence)\nConvert a proper list to a new array; other input types raise an error."
  (unless (list? value) (error "list-to-array: expected proper list"))
  (let ((out (array)))
    (for-each (fn (x) (push! out x)) value)
    out))

(def (array-to-list value)
  "(array-to-list sequence)\nConvert an array to a new list; other input types raise an error."
  (unless (array? value) (error "array-to-list: expected array"))
  (let ((acc '())
        (i (- (length value) 1)))
    (while (>= i 0)
      (set! acc (cons (get value i) acc))
      (set! i (- i 1)))
    acc))

(def (first seq)
  "(first sequence)\nReturn the first element, or nil. On a string, return the first char."
  (cond
    ((nil? seq) nil)
    ((null? seq) nil)
    ((pair? seq) (car seq))
    ((array? seq)
     (if (> (length seq) 0)
         (get seq 0)
         nil))
    ((string? seq) (get seq 0))
    (else (error "first: not a sequence"))))

(def (rest seq)
  "All but the first element, preserving list, array, or string kind."
  (cond
    ((nil? seq) '())
    ((null? seq) '())
    ((pair? seq) (cdr seq))
    ((array? seq) (drop 1 seq))
    ((string? seq) (substring seq (min 1 (string-length seq))))
    (else (error "rest: not a sequence"))))

(def (nth seq i)
  "(nth sequence index)\nReturn the element at a zero-based integer index, or nil out of range. Accepts lists, arrays, strings, and nil."
  (require-int "nth" i)
  (cond
    ((nil? seq) nil)
    ((null? seq) nil)
    ((array? seq)
     (if (and (>= i 0) (< i (length seq)))
         (get seq i)
         nil))
    ((pair? seq)
     (if (< i 0)
         nil
         (let ((s seq)
               (k i))
           (while (and (pair? s) (> k 0))
             (set! s (cdr s))
             (set! k (- k 1)))
           (if (pair? s)
               (car s)
               nil))))
    ((string? seq) (get seq i))
    (else (error "nth: not a sequence"))))

(def (second seq)
  "(second sequence)\nReturn element at index 1, or nil."
  (nth seq 1))

(def (third seq)
  "(third sequence)\nReturn element at index 2, or nil."
  (nth seq 2))

(def (last seq)
  "(last sequence)\nReturn the last element, or nil."
  (cond
    ((nil? seq) nil)
    ((null? seq) nil)
    ((array? seq)
     (if (> (length seq) 0)
         (get seq (- (length seq) 1))
         nil))
    ((pair? seq)
     (let ((s seq))
       (while (pair? (cdr s)) (set! s (cdr s)))
       (car s)))
    ((string? seq) (get seq (- (string-length seq) 1)))
    (else (error "last: not a sequence"))))

(def (count coll)
  "(count collection)\nLike length, but nil counts as zero."
  (if (nil? coll)
      0
      (length coll)))

(def (empty? coll)
  "(empty? collection)\nTest whether a sequence, table, string, or buffer has no elements. nil is empty."
  (cond
    ((nil? coll) #t)
    ((null? coll) #t)
    ((pair? coll) #f)
    ((string? coll) (= (string-length coll) 0))
    ((buffer? coll) (= (length coll) 0))
    ((or (array? coll) (table? coll)) (= (length coll) 0))
    (else (error "empty?: unsupported type"))))

(def (map f seq)
  "Kind-preserving: list in, list out; array in, array out; nil -> ()."
  (let ((out (builder-like seq)))
    (for-each (fn (x) (set! out (builder-add out (f x)))) seq)
    (builder-finish out)))

(def (filter pred seq)
  "(filter predicate sequence)\nKeep elements for which predicate returns a truthy value; preserve list/array kind."
  (let ((out (builder-like seq)))
    (for-each (fn (x) (when (pred x) (set! out (builder-add out x)))) seq)
    (builder-finish out)))

(def (find pred seq)
  "Return the first matching element, or nil. Stop at the first match."
  (cond
    ((array? seq)
     (let loop ((i 0))
       (cond
         ((= i (length seq)) nil)
         ((pred (get seq i)) (get seq i))
         (else (loop (+ i 1))))))
    ((or (nil? seq) (null? seq)) nil)
    ((pair? seq)
     (if (pred (car seq))
         (car seq)
         (find pred (cdr seq))))
    (else (error "find: expected list or array" seq))))

(def (find-index pred seq)
  "Return the index of the first matching element in a list or array, or nil."
  (if (array? seq)
      (let loop ((i 0))
        (cond
          ((= i (length seq)) nil)
          ((pred (get seq i)) i)
          (else (loop (+ i 1)))))
      (let loop ((rest seq)
                 (i 0))
        (cond
          ((or (nil? rest) (null? rest)) nil)
          ((pred (car rest)) i)
          (else (loop (cdr rest) (+ i 1)))))))

(def (clamp value low high)
  "Clamp value to the inclusive interval from low to high."
  (max low (min high value)))

(def (insert-at seq index value)
  "Insert before index in a list or array, returning a copy of the same kind."
  (require-int "insert-at" index)
  (unless (<= 0 index (length seq)) (error "insert-at: index out of range" index))
  (concat (take index seq)
          (if (array? seq)
              [value]
              (list value))
          (drop index seq)))

(def (remove-at seq index)
  "Remove the element at index from a list or array, returning a copy of the same kind."
  (require-int "remove-at" index)
  (unless (<= 0 index (- (length seq) 1)) (error "remove-at: index out of range" index))
  (concat (take index seq) (drop (+ index 1) seq)))

(def (reduce f init seq)
  "(reduce procedure initial sequence)\nFold left, calling (procedure accumulator element) for each element. Empty sequences return initial."
  (let ((acc init))
    (for-each (fn (x) (set! acc (f acc x))) seq)
    acc))

(def (range . args)
  "(range end) / (range start end [step])\nReturn an array of integers toward the exclusive end. Defaults: start 0, step 1. Step must be nonzero and may be negative."
  (let ((n (length args))
        (a 0)
        (b 0)
        (step 1))
    (cond
      ((= n 1) (set! b (nth args 0)))
      ((= n 2)
       (begin
         (set! a (nth args 0))
         (set! b (nth args 1))))
      ((= n 3)
       (begin
         (set! a (nth args 0))
         (set! b (nth args 1))
         (set! step (nth args 2))))
      (else (error "range: expected 1 to 3 arguments")))
    (require-int "range" a)
    (require-int "range" b)
    (require-int "range" step)
    (when (= step 0) (error "range: step must be nonzero"))
    (let ((out (array))
          (i a))
      (if (> step 0)
          (while (< i b)
            (push! out i)
            (set! i (+ i step)))
          (while (> i b)
            (push! out i)
            (set! i (+ i step))))
      out)))

(def (concat . seqs)
  "Concatenation; kind follows the first argument (nil -> list)."
  (let ((out (builder-like (if (pair? seqs)
                               (car seqs)
                               nil))))
    (for-each (fn (s) (for-each (fn (x) (set! out (builder-add out x))) s)) seqs)
    (builder-finish out)))

(def (take n seq)
  "(take count sequence)\nReturn the first count elements. Count clamps to the available range; preserve list/array kind."
  (require-int "take" n)
  (slice seq 0 (max n 0)))

(def (drop n seq)
  "(drop count sequence)\nReturn the elements after the first count. Count clamps to the available range; preserve list/array kind."
  (require-int "drop" n)
  (slice seq (max n 0) nil))

(def (contains? coll x)
  "(contains? collection value)\nTest table key presence, equal? membership in a sequence, or substring presence in a string. nil returns #f."
  (cond
    ((nil? coll) #f)
    ((table? coll) (not (nil? (get coll x))))
    ((string? coll) (string-contains? coll x))
    ((or (null? coll) (pair? coll) (array? coll))
     (let ((found #f))
       (for-each (fn (e) (when (equal? e x) (set! found #t))) coll)
       found))
    (else (error "contains?: unsupported collection"))))

;; --- sorting ----------------------------------------------------------------

(def- (sort-class k)
  (cond
    ((number? k) :number)
    ((string? k) :string)
    ((symbol? k) :symbol)
    ((keyword? k) :keyword)
    ((char? k) :char)
    (else (error "sort: keys must be numbers, strings, symbols, keywords, or chars"))))

(def- (key-less? a b)
  (cond
    ((number? a) (< a b))
    ((char? a) (< (char->integer a) (char->integer b)))
    (else (string<? (name a) (name b))))) ; strings/symbols/keywords, lexicographic

;; stable merge of two lists of (key . elem) pairs
(def- (merge-runs a b)
  (cond
    ((null? a) b)
    ((null? b) a)
    ((key-less? (car (car b)) (car (car a))) (cons (car b) (merge-runs a (cdr b))))
    (else (cons (car a) (merge-runs (cdr a) b)))))

(def- (msort lst n)
  (if (< n 2)
      lst
      (let ((half (quotient n 2))) (merge-runs (msort (take half lst) half) (msort (drop half lst) (- n half))))))

(def (sort-by keyfn seq)
  "Stable sort by derived keys; keys must all be one orderable class."
  (let ((lst (map (fn (x) (cons (keyfn x) x)) (to-list seq))))
    (when (pair? lst)
      (let ((cls (sort-class (car (car lst)))))
        (for-each (fn (p) (unless (eq? (sort-class (car p)) cls) (error "sort: mixed key classes"))) lst)))
    (let ((res (map cdr (msort lst (length lst))))) (finish-like seq res))))

(def (sort seq)
  "(sort sequence)\nReturn an ascending sorted copy, preserving list/array kind. Keys must belong to a supported, consistent orderable class."
  (sort-by identity seq))

;; --- tables (10.5) ----------------------------------------------------------

(def (put coll . kvs)
  "(put collection key value ...)\nput! on a shallow copy; (put nil ...) builds a fresh table."
  (let ((c (if (nil? coll)
               (table)
               (copy coll))))
    (let ((s kvs))
      (while (pair? s)
        (when (null? (cdr s)) (error "put: odd number of key/value arguments"))
        (put! c (car s) (car (cdr s)))
        (set! s (cdr (cdr s)))))
    c))

(def (dissoc coll . ks)
  "(dissoc collection key ...)\nReturn a shallow copy without the specified keys."
  (let ((c (if (nil? coll)
               (table)
               (copy coll))))
    (for-each (fn (k) (put! c k nil)) ks)
    c))

(def (update coll k f . args)
  "(update collection key procedure argument ...)\nCopy the collection and replace the entry with (procedure (get collection key) argument ...)."
  (put coll k (apply f (get coll k) args)))

(def (merge . ts)
  "New table, left to right; nil arguments skipped."
  (let ((out (table)))
    (for-each (fn (t) (unless (nil? t) (for-each (fn (k) (put! out k (get t k))) (keys t)))) ts)
    out))

(def (get-in coll path . more)
  "get folded over a sequence of keys."
  (when (> (length more) 1) (error "get-in: expected 2 or 3 arguments"))
  (let ((default (if (pair? more)
                     (car more)
                     nil))
        (c coll))
    (for-each (fn (k) (set! c (get c k))) path)
    (if (nil? c)
        default
        c)))

;; --- conditions (10.9) ------------------------------------------------------

(def (condition-type c)
  "(condition-type condition)\nReturn a condition table's :type, or nil."
  (if (table? c)
      (get c :type)
      nil))

(def (condition-message c)
  "(condition-message condition)\nReturn a condition table's :message, or nil."
  (if (table? c)
      (get c :message)
      nil))

(def (error? c)
  "(error? value)\nTest whether value is a table with a :type entry."
  (if (and (table? c) (not (nil? (get c :type))))
      #t
      #f))

(def (type-pred t)
  "(type-pred type)\nBuild a predicate for conditions of type or its registered subtypes."
  (fn (c) (condition-of-type? c t)))

;; --- pattern matching (specs/match.md) -------------------------------------

;; A clause compiles to one `and` of tests, so a failing test falls through to
;; the next clause without a closure. Patterns are compiled against access
;; expressions like (car v) or (get v :k); a value used more than once is first
;; stored in a gensym temp with set!. Pattern names are bound only once the
;; clause has matched, so later clauses never see a failed clause's names.

(define-condition 'match-error 'error)

;; I/O conditions (specs/io.md). decode-error carries the byte :position.
(define-condition 'io-error 'error)

(define-condition 'file-error 'io-error)

(define-condition 'decode-error 'io-error)

(def (match-error value)
  "(match-error value)\nSignal a match-error condition holding value under :value. A use-value restart returns its argument as the result of the failed match."
  (restart-case (error {:type 'match-error :message "match: no clause matched" :value value})
    (use-value "Use a value as the result of the match." (x) x)))

(def- (pat-error message pattern)
  (error (str "match: " message) pattern))

(def- (pat-temp st)
  (let ((t (gensym "m")))
    (put! st :temps (cons t (get st :temps)))
    t))

(def- (pat-set t form)
  `(begin
     (set! ,t ,form)
     #t))

;; Run k on a symbol holding e's value, storing e in a temp first if needed.
(def- (pat-hold st e k)
  (if (symbol? e)
      (k e)
      (let ((t (pat-temp st))) (cons (pat-set t e) (k t)))))

(def- (pat-bind st name source)
  (when (assq name (get st :binds)) (pat-error "name bound twice in one pattern" name))
  (put! st :binds (cons (cons name source) (get st :binds))))

(def- (pat-literal? p)
  (or (nil? p) (null? p) (number? p) (string? p) (keyword? p) (boolean? p)))

(def- (pat-literal-test e p)
  (cond
    ((nil? p) `(nil? ,e))
    ((null? p) `(null? ,e))
    ((or (symbol? p) (keyword? p) (boolean? p)) `(eq? ,e (quote ,p)))
    (else `(equal? ,e (quote ,p)))))

;; (f e), with a literal one-parameter fn inlined as a let.
(def- (pat-call f e)
  (if (and (pair? f) (eq? (car f) 'fn) (pair? (cdr f)) (pair? (cadr f)) (symbol? (car (cadr f))) (null? (cdr (cadr f))))
      `(let ((,(car (cadr f)) ,e)) ,@(cddr f))
      `(,f ,e)))

;; Compile p against a fresh binding list, returning (tests . binds).
(def- (pat-isolated st p e)
  (let ((saved (get st :binds)))
    (put! st :binds '())
    (let ((tests (pat-compile st p e))
          (binds (get st :binds)))
      (put! st :binds saved)
      (cons tests binds))))

;; Give names one temp each, so alternatives can bind them from different places.
(def- (pat-share st names)
  (map (fn (n)
         (let ((t (pat-temp st)))
           (pat-bind st n t)
           (cons n t)))
       names))

(def- (pat-copy-out shared binds)
  (map (fn (s) (pat-set (cdr s) (cdr (assq (car s) binds)))) shared))

(def- (pat-or st alts v)
  (if (null? alts)
      (list #f)
      (let ((compiled (map (fn (a) (pat-isolated st a v)) alts))
            (names (map car (cdr (car compiled)))))
        (for-each (fn (c)
                    (unless (and (= (length (cdr c)) (length names)) (for-all (fn (n) (assq n (cdr c))) names))
                      (pat-error "or alternatives must bind the same names" (cons 'or alts))))
                  compiled)
        (let ((shared (pat-share st names)))
          (list `(or ,@(map (fn (c) `(and ,@(car c) ,@(pat-copy-out shared (cdr c)))) compiled)))))))

(def- (pat-opt st p e)
  (cond
    ((and (pair? (cdr p)) (pair? (cddr p)) (null? (cdr (cddr p))))
     (let ((name (cadr p))
           (g (pat-temp st)))
       (unless (symbol? name) (pat-error "opt with a default needs a name" p))
       (pat-bind st name g)
       (pat-hold st
                 e
                 (fn (t)
                   (list (pat-set g
                                  `(if (nil? ,t)
                                       ,(caddr p)
                                       ,t)))))))
    ((and (pair? (cdr p)) (null? (cddr p)))
     (pat-hold st
               e
               (fn (t)
                 (let ((c (pat-isolated st (cadr p) t)))
                   (let ((shared (pat-share st (map car (cdr c)))))
                     (list `(or (nil? ,t) (and ,@(car c) ,@(pat-copy-out shared (cdr c))))))))))
    (else (pat-error "invalid opt" p))))

;; A table value pattern against e, the looked-up value.
(def- (pat-table-value st p e)
  (cond
    ((and (pair? p) (eq? (car p) 'opt)) (pat-opt st p e))
    ((or (and (pat-literal? p) (not (nil? p))) (and (pair? p) (eq? (car p) 'quote))) (pat-compile st p e))
    (else (pat-hold st e (fn (t) (cons `(not (nil? ,t)) (pat-compile st p t)))))))

(def- (pat-table st args v)
  (let loop ((rest args)
             (tests (list `(table? ,v))))
    (cond
      ((null? rest) tests)
      ((null? (cdr rest)) (pat-error "table pattern needs key/pattern pairs" (cons 'table args)))
      (else (let ((k (car rest)))
              (unless (or (pat-literal? k) (and (pair? k) (eq? (car k) 'quote)))
                (pat-error "table pattern keys must be literals" k))
              (loop (cddr rest) (append tests (pat-table-value st (cadr rest) `(get ,v ,k)))))))))

(def- (pat-list st args v)
  (let loop ((rest args)
             (cur v))
    (cond
      ((null? rest) (list `(null? ,cur)))
      ((not (pair? rest)) (pat-compile st rest cur))
      ((eq? (car rest) '&)
       (unless (and (pair? (cdr rest)) (null? (cddr rest)))
         (pat-error "& needs exactly one pattern after it" (cons 'list args)))
       (pat-compile st (cadr rest) cur))
      (else (pat-hold st
                      cur
                      (fn (c)
                        (cons `(pair? ,c)
                              (append (pat-compile st (car rest) `(car ,c)) (loop (cdr rest) `(cdr ,c))))))))))

(def- (pat-quasi st tmpl e)
  (cond
    ((and (pair? tmpl) (eq? (car tmpl) 'unquote)) (pat-compile st (cadr tmpl) e))
    ((and (pair? tmpl) (or (eq? (car tmpl) 'unquote-splicing) (eq? (car tmpl) 'quasiquote)))
     (pat-error "unsupported inside a quasiquote pattern" tmpl))
    ((pair? tmpl)
     (pat-hold st
               e
               (fn (v)
                 (cons `(pair? ,v) (append (pat-quasi st (car tmpl) `(car ,v)) (pat-quasi st (cdr tmpl) `(cdr ,v)))))))
    (else (list (pat-literal-test e tmpl)))))

(def- (pat-array st args v)
  (let loop ((rest args)
             (i 0)
             (tests '()))
    (cond
      ((null? rest) (append (list `(array? ,v) `(= (length ,v) ,i)) tests))
      ((eq? (car rest) '&)
       (unless (and (pair? (cdr rest)) (eq? (cadr rest) '_) (null? (cddr rest)))
         (pat-error "array rest patterns only accept _" (cons 'array args)))
       (append (list `(array? ,v) `(>= (length ,v) ,i)) tests))
      (else (loop (cdr rest) (+ i 1) (append tests (pat-compile st (car rest) `(get ,v ,i))))))))

(def- (pat-class st type args v)
  (let loop ((rest args)
             (tests (list `(class-subtype? (dispatch-type ,v) ,type))))
    (cond
      ((null? rest) tests)
      ((not (and (keyword? (car rest)) (pair? (cdr rest))))
       (pat-error "class patterns take keyword/pattern pairs" (cons type args)))
      (else (loop (cddr rest) (append tests (pat-compile st (cadr rest) `(,v ,(car rest)))))))))

(def- (pat-all st ps v)
  (if (pair? ps)
      (append (pat-compile st (car ps) v) (pat-all st (cdr ps) v))
      '()))

;; Patterns that need their value more than once, given a symbol v holding it.
(def- (pat-compound st p v)
  (let ((head (car p))
        (args (cdr p)))
    (cond
      ((eq? head 'list) (pat-list st args v))
      ((eq? head 'quasiquote) (pat-quasi st (car args) v))
      ((eq? head 'array) (pat-array st args v))
      ((eq? head 'table) (pat-table st args v))
      ((eq? head '?) (cons (pat-call (car args) v) (pat-all st (cdr args) v)))
      ((eq? head 'and) (pat-all st args v))
      ((eq? head 'or) (pat-or st args v))
      ((eq? head 'opt) (pat-error "opt is only allowed as a table value" p))
      ((or (eq? head 'unquote) (eq? head 'unquote-splicing)) (pat-error "unquote outside a quasiquote pattern" p))
      ((symbol? head) (pat-class st head args v))
      (else (pat-error "unsupported pattern" p)))))

(def- (pat-compile st p e)
  (cond
    ((eq? p '_) '())
    ((symbol? p) (pat-bind st p e) '())
    ((pat-literal? p) (list (pat-literal-test e p)))
    ((not (pair? p)) (pat-error "unsupported pattern" p))
    ((eq? (car p) 'quote) (list (pat-literal-test e (cadr p))))
    ((eq? (car p) '==) (list `(equal? ,e ,(cadr p))))
    ((eq? (car p) '?)
     (unless (pair? (cdr p)) (pat-error "? needs a predicate" p))
     (if (null? (cddr p))
         (list (pat-call (cadr p) e))
         (pat-hold st e (fn (v) (pat-compound st p v)))))
    ((eq? (car p) 'app)
     (unless (and (pair? (cdr p)) (pair? (cddr p)) (null? (cdr (cddr p))))
       (pat-error "app needs a function and one pattern" p))
     (let ((t (pat-temp st))) (cons (pat-set t (pat-call (cadr p) e)) (pat-compile st (caddr p) t))))
    (else (pat-hold st e (fn (v) (pat-compound st p v))))))

(def- (match-clauses v clauses)
  (if (null? clauses)
      `(match-error ,v)
      (let ((clause (car clauses)))
        (unless (pair? clause) (pat-error "invalid clause" clause))
        (let ((guarded (and (pair? (cdr clause)) (eq? (cadr clause) :when)))
              (st {:temps '() :binds '()})
              (tests (pat-compile st (car clause) v))
              (names (map (fn (b) (list (car b) (cdr b))) (reverse (get st :binds))))
              (body `(let ,names
                       ,@(if guarded
                             (cdr (cddr clause))
                             (cdr clause))))
              (temps (map (fn (t) (list t nil)) (get st :temps))))
          (when (and guarded (not (pair? (cddr clause)))) (pat-error ":when needs a guard" clause))
          (let ((form (if (or (pair? tests) guarded)
                          `(if (and ,@tests
                                    ,@(if guarded
                                          (list `(let ,names ,(caddr clause)))
                                          '()))
                               ,body
                               ,(match-clauses v (cdr clauses)))
                          body)))
            (if (pair? temps)
                `(let ,temps ,form)
                form))))))

(defmacro match (expr . clauses)
  "(match value (pattern body ...) (pattern :when guard body ...) ...)\nEvaluate value once and run the body of the first clause whose pattern matches and whose guard is truthy, with the pattern's names bound. No match signals match-error. See specs/match.md for patterns."
  (let ((v (gensym "value"))) `(let ((,v ,expr)) ,(match-clauses v clauses))))

;; --- functional (10.8) ------------------------------------------------------

;; Scheme list helpers, matching the Chez runtime's names.
(def (cdar p)
  "(cdar pair)\nEquivalent to (cdr (car pair))."
  (cdr (car p)))

(def (caaar p)
  "(caaar pair)\nEquivalent to (car (car (car pair)))."
  (car (car (car p))))

(def (caadr p)
  "(caadr pair)\nEquivalent to (car (car (cdr pair)))."
  (car (car (cdr p))))

(def (cadar p)
  "(cadar pair)\nEquivalent to (car (cdr (car pair)))."
  (car (cdr (car p))))

(def (caddr p)
  "(caddr pair)\nEquivalent to (car (cdr (cdr pair)))."
  (car (cdr (cdr p))))

(def (cdaar p)
  "(cdaar pair)\nEquivalent to (cdr (car (car pair)))."
  (cdr (car (car p))))

(def (cdadr p)
  "(cdadr pair)\nEquivalent to (cdr (car (cdr pair)))."
  (cdr (car (cdr p))))

(def (cddar p)
  "(cddar pair)\nEquivalent to (cdr (cdr (car pair)))."
  (cdr (cdr (car p))))

(def (cdddr p)
  "(cdddr pair)\nEquivalent to (cdr (cdr (cdr pair)))."
  (cdr (cdr (cdr p))))

(def (cadddr p)
  "(cadddr pair)\nEquivalent to (car (cdr (cdr (cdr pair))))."
  (car (cdr (cdr (cdr p)))))

(def (list-tail lst k)
  "(list-tail list k)\nThe list after dropping its first k pairs."
  (let loop ((l lst)
             (n (require-int "list-tail" k)))
    (cond
      ((= n 0) l)
      ((pair? l) (loop (cdr l) (- n 1)))
      (else (error "list-tail: index out of range")))))

(def (list-ref lst k)
  "(list-ref list k)\nThe element at index k of a list."
  (let ((tail (list-tail lst k)))
    (if (pair? tail)
        (car tail)
        (error "list-ref: index out of range"))))

(def (memq x lst)
  "(memq value list)\nThe first tail of list whose car is eq? to value, or nil."
  (cond
    ((not (pair? lst)) nil)
    ((eq? x (car lst)) lst)
    (else (memq x (cdr lst)))))

(def (member x seq)
  "Return the first matching tail of a list or array, or nil."
  (if (array? seq)
      (let ((i (find-index (fn (value) (equal? x value)) seq)))
        (if i
            (drop i seq)
            nil))
      (cond
        ((not (pair? seq)) nil)
        ((equal? x (car seq)) seq)
        (else (member x (cdr seq))))))

(def (assq key alist)
  "(assq key alist)\nThe first pair in alist whose car is eq? to key, or nil."
  (cond
    ((not (pair? alist)) nil)
    ((eq? key (car (car alist))) (car alist))
    (else (assq key (cdr alist)))))

(def (assoc key alist)
  "(assoc key alist)\nThe first pair in alist whose car is equal? to key, or nil."
  (cond
    ((not (pair? alist)) nil)
    ((equal? key (car (car alist))) (car alist))
    (else (assoc key (cdr alist)))))

(def- (heads lists)
  (if (pair? lists)
      (cons (car (car lists)) (heads (cdr lists)))
      '()))

(def- (tails lists)
  (if (pair? lists)
      (cons (cdr (car lists)) (tails (cdr lists)))
      '()))

(def- (any-empty? lists)
  (and (pair? lists) (or (not (pair? (car lists))) (any-empty? (cdr lists)))))

(def (fold-left f init lst & more)
  "(fold-left procedure initial list ...)\nCombine from the left: (procedure accumulator element ...) for each position."
  (let loop ((acc init)
             (lists (cons lst more)))
    (if (any-empty? lists)
        acc
        (loop (apply f acc (heads lists)) (tails lists)))))

(def (fold-right f init lst & more)
  "(fold-right procedure initial list ...)\nCombine from the right: (procedure element ... accumulator) for each position."
  (let loop ((lists (cons lst more)))
    (if (any-empty? lists)
        init
        (apply f (append (heads lists) (list (loop (tails lists))))))))

(def- (sequence-ended? sequences i)
  (and (pair? sequences)
       (or (if (array? (car sequences))
               (>= i (length (car sequences)))
               (not (pair? (car sequences))))
           (sequence-ended? (cdr sequences) i))))

(def- (sequence-heads sequences i)
  (map (fn (seq)
         (if (array? seq)
             (get seq i)
             (car seq)))
       sequences))

(def- (sequence-tails sequences)
  (map (fn (seq)
         (if (array? seq)
             seq
             (cdr seq)))
       sequences))

(def (exists f seq & more)
  "Return the first truthy predicate result across lists or arrays, or nil. Stop at the shortest input."
  (let loop ((sequences (cons seq more))
             (i 0))
    (if (sequence-ended? sequences i)
        nil
        (or (apply f (sequence-heads sequences i)) (loop (sequence-tails sequences) (+ i 1))))))

(def (for-all f seq & more)
  "Return the last predicate result if all positions pass, else the first falsy result. Empty inputs pass."
  (let loop ((sequences (cons seq more))
             (i 0)
             (last #t))
    (if (sequence-ended? sequences i)
        last
        (let ((value (apply f (sequence-heads sequences i))))
          (if value
              (loop (sequence-tails sequences) (+ i 1) value)
              value)))))

(def positive?
  "Alias for pos?."
  pos?)

(def negative?
  "Alias for neg?."
  neg?)

(def (gcd & xs)
  "(gcd integer ...)\nGreatest common divisor; no arguments gives 0."
  (let loop ((acc 0)
             (rest xs))
    (if (pair? rest)
        (loop (let euclid ((a (abs acc))
                           (b (abs (car rest))))
                (if (= b 0)
                    a
                    (euclid b (remainder a b))))
              (cdr rest))
        acc)))

(def (lcm & xs)
  "(lcm integer ...)\nLeast common multiple; no arguments gives 1."
  (let loop ((acc 1)
             (rest xs))
    (if (pair? rest)
        (loop (if (or (= acc 0) (= (car rest) 0))
                  0
                  (quotient (abs (* acc (car rest))) (gcd acc (car rest))))
              (cdr rest))
        acc)))

(def (keyword->string k)
  "(keyword->string keyword)\nThe name of a keyword, without its colon."
  (if (keyword? k)
      (name k)
      (error "keyword->string: expected keyword")))

(def- (string-chain who ok? a b more)
  (if (not (and (string? a) (string? b))) (error (str who ": expected strings")))
  (and (ok? a b) (or (null? more) (string-chain who ok? b (car more) (cdr more)))))

(def (string=? a b & more)
  "(string=? string string ...)\nTest whether all strings are equal."
  (string-chain "string=?" equal? a b more))

(def (string>? a b & more)
  "(string>? string string ...)\nTest whether strings are in strictly decreasing order."
  (string-chain "string>?" (fn (x y) (string<? y x)) a b more))

(def (string<=? a b & more)
  "(string<=? string string ...)\nTest whether strings are in nondecreasing order."
  (string-chain "string<=?" (fn (x y) (not (string<? y x))) a b more))

(def (string>=? a b & more)
  "(string>=? string string ...)\nTest whether strings are in nonincreasing order."
  (string-chain "string>=?" (fn (x y) (not (string<? x y))) a b more))

(def- (char-chain who ok? a b more)
  (if (not (and (char? a) (char? b))) (error (str who ": expected chars")))
  (and (ok? (char->integer a) (char->integer b)) (or (null? more) (char-chain who ok? b (car more) (cdr more)))))

(def (char=? a b & more)
  "(char=? char char ...)\nTest whether all chars are the same."
  (char-chain "char=?" = a b more))

(def (char<? a b & more)
  "(char<? char char ...)\nTest whether chars are in strictly increasing code point order."
  (char-chain "char<?" < a b more))

(def (char>? a b & more)
  "(char>? char char ...)\nTest whether chars are in strictly decreasing code point order."
  (char-chain "char>?" > a b more))

(def (char<=? a b & more)
  "(char<=? char char ...)\nTest whether chars are in nondecreasing code point order."
  (char-chain "char<=?" <= a b more))

(def (char>=? a b & more)
  "(char>=? char char ...)\nTest whether chars are in nonincreasing code point order."
  (char-chain "char>=?" >= a b more))

(def (digit-value c)
  "(digit-value char)\nThe value 0 to 9 of an ASCII decimal digit, or nil for any other char."
  (unless (char? c) (error "digit-value: expected char"))
  (let ((n (- (char->integer c) 48)))
    (if (and (>= n 0) (<= n 9))
        n
        nil)))

;; lint: allow(expansion-failed) The prelude loader owns this declaration in otium.core.
(defgeneric (close resource outcome))

(def (resource-closable? resource)
  "Test whether close has an applicable method for resource on normal exit."
  (let ((kind (dispatch-type resource)))
    (not (not (find (fn (method)
                      (let ((signature (cadr method)))
                        (and (class-subtype? kind (car signature))
                             (class-subtype? (dispatch-type nil) (cadr signature)))))
                    (generic-methods close))))))

(defmacro with (bindings . body)
  "(with ((name expression [release]) ...) body ...)\nAcquire in order and release in reverse order on every exit. Default release is close."
  (unless (list? bindings) (error "with: expected binding list"))
  (if (null? bindings)
      `(begin ,@body)
      (let ((binding (car bindings)))
        (unless (and (list? binding) (or (= (length binding) 2) (= (length binding) 3)) (symbol? (car binding)))
          (error "with: expected (name expression [release])"))
        (let ((name (car binding))
              (release (gensym "release"))
              (outcome (gensym "outcome")))
          `(let ((,name ,(cadr binding))
                 (,release
                  ,(if (= (length binding) 3)
                       (caddr binding)
                       `(begin
                          (unless (resource-closable? ,name)
                            (error "with: resource has no applicable close method" ,name))
                          nil))))
             (call-with-cleanup (fn () (with ,(cdr bindings) ,@body))
                                (fn (,outcome)
                                  ,(if (= (length binding) 3)
                                       `(,release ,name)
                                       `(close ,name ,outcome)))))))))

(defonce %read-datum-string read-string)

(def- %read-datum-string %read-datum-string)

(def (read-string source . port)
  "(read-string source) or (read-string count [port])\nParse a datum from a string, or read up to count characters from a port."
  (if (string? source)
      (begin
        (unless (null? port) (error "read-string: string form takes one argument"))
        (%read-datum-string source))
      (apply %read-characters source port)))

(defmethod (close (port Port) outcome)
  (close-port port))

(def (with-output-to-string f)
  "Call f with a fresh current output port and return the captured string."
  (with ((port (open-output-string)))
        (with-params ((current-output-port port))
          (f)
          (get-output-string port))))

(def- (%port-space port)
  (skip-while " \t\r\n\x0b;\x0c;" port)
  (when (eq? (peek-char port) #\;)
    (read-until "\n\r" port)
    (%port-space port)))

(def- (%port-form-text port out)
  (let ((c (read-char port)))
    (unless (eof-object? c)
      (buffer-push! out c)
      (cond
        ((eq? c #\")
         (let loop ()
           (let ((next (read-char port)))
             (unless (eof-object? next)
               (buffer-push! out next)
               (cond
                 ((eq? next #\\)
                  (let ((escaped (read-char port)))
                    (unless (eof-object? escaped)
                      (buffer-push! out escaped)
                      (loop))))
                 ((not (eq? next #\")) (loop)))))))
        ((or (eq? c #\') (eq? c #\`) (eq? c #\,))
         (when (and (eq? c #\,) (eq? (peek-char port) #\@)) (buffer-push! out (read-char port)))
         (%port-space port)
         (%port-form-text port out))
        ((or (eq? c #\() (eq? c #\[) (eq? c #\{))
         (let ((closing (cond
                          ((eq? c #\() #\))
                          ((eq? c #\[) #\])
                          (else #\}))))
           (let loop ()
             (%port-space port)
             (let ((next (peek-char port)))
               (cond
                 ((eof-object? next) nil)
                 ((eq? next closing) (buffer-push! out (read-char port)))
                 ((or (eq? next #\)) (eq? next #\]) (eq? next #\})) (buffer-push! out (read-char port)))
                 (else (buffer-push! out " ") (%port-form-text port out) (loop)))))))
        ((and (eq? c #\#) (eq? (peek-char port) #\\))
         (buffer-push! out (read-char port))
         (let ((first (read-char port)))
           (unless (eof-object? first)
             (buffer-push! out first)
             (unless (string-contains? " \t\r\n\x0b;\x0c;()[]{};\"',`" (string first))
               (buffer-push! out (read-until " \t\r\n\x0b;\x0c;()[]{};\"',`" port))))))
        (else (let ((tail (read-until " \t\r\n\x0b;\x0c;()[]{};\"',`" port)))
                (buffer-push! out tail)
                (when (and (eq? c #\#) (equal? tail "u8") (eq? (peek-char port) #\()) (%port-form-text port out))))))))

(def (read . ports)
  "(read [port])\nRead one Otium datum, or the EOF object."
  (when (> (length ports) 1) (error "read: expected at most one port"))
  (let ((port (if (null? ports)
                  (current-input-port)
                  (car ports))))
    (%port-space port)
    (if (eof-object? (peek-char port))
        (eof-object)
        (let ((out (buffer)))
          (%port-form-text port out)
          (%read-datum-string (buffer->string out))))))

(def (read-file path)
  "Read a whole UTF-8 file. Invalid UTF-8 raises decode-error."
  (with ((port (open-input-file path))) (read-all port)))

(def (write-file path text)
  "Write UTF-8 text to path, replacing its contents. Close the port on failure."
  (with ((port (open-output-file path))) (write-string text port)))

(def- (%string-prefix? chars rest)
  (or (null? rest) (and (pair? chars) (eq? (car chars) (car rest)) (%string-prefix? (cdr chars) (cdr rest)))))

(def (string-index text part . starts)
  "Find part at or after the optional character offset, or nil. Empty part matches at start."
  (when (> (length starts) 1) (error "string-index: expected at most one start"))
  (let ((start (if (null? starts)
                   0
                   (car starts)))
        (n (string-length text))
        (needle (string->list part)))
    (require-int "string-index" start)
    (when (< start 0) (error "string-index: negative start" start))
    (when (<= start n)
      (let loop ((chars (drop start (string->list text)))
                 (i start))
        (cond
          ((%string-prefix? chars needle) i)
          ((null? chars) nil)
          (else (loop (cdr chars) (+ i 1))))))))

(def (string-repeat text count)
  "Repeat text count times; zero gives an empty string."
  (require-int "string-repeat" count)
  (when (< count 0) (error "string-repeat: negative count" count))
  (unless (string? text) (error "string-repeat: expected a string" text))
  (let ((out (buffer)))
    (dotimes (_ count)
      (buffer-push! out text))
    (buffer->string out)))

(def (file-directory? path)
  "Test whether path resolves to a directory. Missing paths return #f."
  (and (file-exists? path) (eq? (get (file-info path) :type) :directory)))

(def (file-regular? path)
  "Test whether path resolves to a regular file. Missing paths return #f."
  (and (file-exists? path) (eq? (get (file-info path) :type) :file)))

(def (path-absolute? path)
  "Test whether a POSIX path begins with /."
  (string-starts-with? path "/"))

(def- (path-end path)
  (let loop ((end (string-length path)))
    (if (and (> end 1) (eq? (string-ref path (- end 1)) #\/))
        (loop (- end 1))
        end)))

(def (path-parent path)
  "The lexical parent of a POSIX path; / stays / and a bare name has parent \"\"."
  (let loop ((i (- (path-end path) 1)))
    (cond
      ((< i 0) "")
      ((eq? (string-ref path i) #\/) (substring path 0 (max 1 i)))
      (else (loop (- i 1))))))

(def (path-last path)
  "The final component of a POSIX path, ignoring trailing slashes. / has no component."
  (let ((end (path-end path)))
    (let loop ((i (- end 1)))
      (if (or (< i 0) (eq? (string-ref path i) #\/))
          (substring path (+ i 1) end)
          (loop (- i 1))))))
