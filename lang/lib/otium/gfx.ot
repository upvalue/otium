(ns otium.gfx)
(require (otium.ui.native :as native))
(require (otium.sdl :as sdl))

(defclass Context
  renderer
  clip
  (focused? :init #f)
  (pressed? :init #f)
  (hovered? :init #f)
  (disabled? :init #f)
  (resizing? :init #f))

(def (rect g bounds color . radius)
  "Record a rounded rectangle, clipped to the current widget's bounds."
  (let ((clip (g :clip)))
    (sdl/check (native/gpu-rect (g :renderer)
                                (bounds :x)
                                (bounds :y)
                                (bounds :width)
                                (bounds :height)
                                (if (null? radius)
                                    0
                                    (car radius))
                                color
                                (clip :x)
                                (clip :y)
                                (clip :width)
                                (clip :height)))))

(def (font-index font)
  "Resolve :ui, :mono, or a font file path. File registrations last until UI teardown."
  (cond
    ((eq? font :ui) 0)
    ((eq? font :mono) 1)
    ((string? font)
     (when (string-contains? font "\x0;") (error "Font path contains NUL"))
     (let ((face (native/font-register font)))
       (when (< face 0) (error (native/text-error)))
       face))
    (else (error "Unknown UI font" font))))

(def (text g bounds string font size color wrap)
  "Record shaped text in logical pixels, wrapping at the bounds when enabled."
  (let ((clip (g :clip)))
    (sdl/check (native/gpu-text (g :renderer)
                                string
                                (font-index font)
                                size
                                (if wrap
                                    (bounds :width)
                                    -1)
                                (bounds :x)
                                (bounds :y)
                                color
                                (clip :x)
                                (clip :y)
                                (clip :width)
                                (clip :height)))))

;; Paint caches: record a widget's drawing once and replay it, moved, on later
;; frames. Each cache has a renderer-wide id; the renderer frees recordings
;; that go unused for a while.

(defonce cache-ids 0)

(def (cache)
  "Return a new paint cache. Keep one per widget, e.g. in a state slot."
  (set! cache-ids (+ cache-ids 1))
  {:id cache-ids :key nil})

(def- (draw-cache g c bounds)
  (let ((clip (g :clip))
        (drawn (native/gpu-cache-draw (g :renderer)
                                      (c :id)
                                      (bounds :x)
                                      (bounds :y)
                                      (clip :x)
                                      (clip :y)
                                      (clip :width)
                                      (clip :height))))
    (when (< drawn 0) (error (sdl/get-error)))
    (= drawn 1)))

(def (cached g c bounds key paint)
  "Draw (paint context) through cache c. paint runs again only when key, the
bounds' size or the pixel scale changes; otherwise the recording is replayed at
the bounds' position. paint must draw within bounds and may only depend on key
and the bounds' size."
  (let ((full (list key (bounds :width) (bounds :height) (native/gpu-scale (g :renderer)))))
    (unless (and (equal? full (c :key)) (draw-cache g c bounds))
      (let ((start (native/gpu-mark (g :renderer))))
        (put! c :key nil)
        (paint (make Context
                     :renderer (g :renderer)
                     :clip bounds
                     :focused? (g :focused?)
                     :pressed? (g :pressed?)
                     :hovered? (g :hovered?)
                     :disabled? (g :disabled?)
                     :resizing? (g :resizing?)))
        (sdl/check (native/gpu-cache-store (g :renderer) (c :id) start (bounds :x) (bounds :y)))
        (put! c :key full)
        (unless (draw-cache g c bounds) (error "Paint cache was not stored"))))))

(def (image g bounds path color)
  "Draw an SVG alpha mask at the bounds' size, tinted with color."
  (when (string-contains? path "\x0;") (error "SVG path contains NUL"))
  (let ((clip (g :clip)))
    (sdl/check (native/gpu-image (g :renderer)
                                 path
                                 (bounds :x)
                                 (bounds :y)
                                 (bounds :width)
                                 (bounds :height)
                                 color
                                 (clip :x)
                                 (clip :y)
                                 (clip :width)
                                 (clip :height)))))
