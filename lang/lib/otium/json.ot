(ns otium.json)

(defonce null (gensym "json-null"))

(def- (digit? c)
  (and c (<= 48 (char->integer c) 57)))

(def- (finite-number? x)
  (and (number? x) (= (- x x) 0)))

(def- (whitespace? c)
  (or (eq? c #\space) (eq? c #\tab) (eq? c #\newline) (eq? c #\return)))

(def- (hex-digit c)
  (let ((code (char->integer c)))
    (cond
      ((<= 48 code 57) (- code 48))
      ((<= 65 code 70) (- code 55))
      ((<= 97 code 102) (- code 87))
      (else nil))))

(def- (escape-char c)
  (cond
    ((eq? c #\") #\")
    ((eq? c #\\) #\\)
    ((eq? c #\/) #\/)
    ((eq? c #\b) (integer->char 8))
    ((eq? c #\f) (integer->char 12))
    ((eq? c #\n) #\newline)
    ((eq? c #\r) #\return)
    ((eq? c #\t) #\tab)
    (else nil)))

(def (parse text)
  "Parse JSON text. Objects have string keys; arrays are arrays; null is json/null."
  (unless (string? text) (error "json: expected a string"))
  (let ((n (string-length text))
        (i 0))
    (def (peek)
      (if (< i n)
          (string-ref text i)
          nil))
    (def (advance!)
      (set! i (+ i 1)))
    (def (fail message)
      (error (str "json: " message " at character " i)))
    (def (skip!)
      (while (whitespace? (peek)) (advance!)))
    (def (expect! c)
      (unless (eq? (peek) c) (fail (str "expected " c)))
      (advance!))
    (def (word! word value)
      (let ((end (+ i (string-length word))))
        (unless (and (<= end n) (equal? (substring text i end) word)) (fail "invalid literal"))
        (set! i end)
        value))
    (def (hex!)
      (let ((value 0))
        (dotimes (_ 4)
          (when (>= i n) (fail "incomplete Unicode escape"))
          (let ((digit (hex-digit (peek))))
            (unless digit (fail "invalid Unicode escape"))
            (set! value (+ (* value 16) digit))
            (advance!)))
        value))
    (def (unicode!)
      (let ((code (hex!)))
        (cond
          ((<= 55296 code 56319)
           (expect! #\\)
           (expect! #\u)
           (let ((low (hex!)))
             (unless (<= 56320 low 57343) (fail "invalid low surrogate"))
             (integer->char (+ 65536 (* (- code 55296) 1024) (- low 56320)))))
          ((<= 56320 code 57343) (fail "unpaired low surrogate"))
          (else (integer->char code)))))
    (def (string!)
      (expect! #\")
      (let ((start i)
            (out nil))
        (let loop ()
          (let ((c (peek)))
            (cond
              ((nil? c) (fail "unterminated string"))
              ((eq? c #\")
               (let ((tail (substring text start i)))
                 (advance!)
                 (if out
                     (begin
                       (buffer-push! out tail)
                       (buffer->string out))
                     tail)))
              ((eq? c #\\)
               (unless out (set! out (buffer)))
               (buffer-push! out (substring text start i))
               (advance!)
               (let ((escape (peek)))
                 (unless escape (fail "incomplete escape"))
                 (advance!)
                 (buffer-push! out
                               (if (eq? escape #\u)
                                   (unicode!)
                                   (or (escape-char escape) (fail "invalid escape")))))
               (set! start i)
               (loop))
              ((< (char->integer c) 32) (fail "unescaped control character"))
              (else (advance!) (loop)))))))
    (def (digits!)
      (unless (digit? (peek)) (fail "expected digit"))
      (while (digit? (peek)) (advance!)))
    (def (number!)
      (let ((start i))
        (when (eq? (peek) #\-) (advance!))
        (if (eq? (peek) #\0)
            (advance!)
            (digits!))
        (when (eq? (peek) #\.)
          (advance!)
          (digits!))
        (when (or (eq? (peek) #\e) (eq? (peek) #\E))
          (advance!)
          (when (or (eq? (peek) #\+) (eq? (peek) #\-)) (advance!))
          (digits!))
        (let ((value (string->number (substring text start i))))
          (unless (finite-number? value) (fail "number out of range"))
          value)))
    (def (value! depth)
      (when (> depth 256) (fail "nesting limit exceeded"))
      (skip!)
      (let ((c (peek)))
        (cond
          ((eq? c #\{)
           (advance!)
           (skip!)
           (let ((object {}))
             (unless (eq? (peek) #\})
               (let loop ()
                 (skip!)
                 (let ((key (string!)))
                   (skip!)
                   (expect! #\:)
                   (put! object key (value! (+ depth 1))))
                 (skip!)
                 (when (eq? (peek) #\,)
                   (advance!)
                   (loop))))
             (expect! #\})
             object))
          ((eq? c #\[)
           (advance!)
           (skip!)
           (let ((items []))
             (unless (eq? (peek) #\])
               (let loop ()
                 (push! items (value! (+ depth 1)))
                 (skip!)
                 (when (eq? (peek) #\,)
                   (advance!)
                   (loop))))
             (expect! #\])
             items))
          ((eq? c #\") (string!))
          ((eq? c #\t) (word! "true" #t))
          ((eq? c #\f) (word! "false" #f))
          ((eq? c #\n) (word! "null" null))
          ((or (eq? c #\-) (digit? c)) (number!))
          (else (fail "expected value")))))
    (let ((value (value! 0)))
      (skip!)
      (unless (= i n) (fail "trailing data"))
      value)))

(def (encode value)
  "Encode a JSON value as compact text. Table keys must be strings; nil also encodes as null."
  (let ((out (buffer)))
    (def (emit text)
      (buffer-push! out text))
    (def (string! text)
      (emit "\"")
      (let ((start 0)
            (n (string-length text)))
        (dotimes (i n)
          (let ((c (string-ref text i))
                (code (char->integer c)))
            (when (or (< code 32) (eq? c #\") (eq? c #\\))
              (emit (substring text start i))
              (cond
                ((eq? c #\") (emit "\\\""))
                ((eq? c #\\) (emit "\\\\"))
                (else (emit "\\u00")
                      (emit (string-ref "0123456789abcdef" (quotient code 16)))
                      (emit (string-ref "0123456789abcdef" (modulo code 16)))))
              (set! start (+ i 1)))))
        (emit (substring text start n)))
      (emit "\""))
    (def (value! value depth)
      (when (> depth 256) (error "json: nesting limit exceeded (or cyclic value)"))
      (cond
        ((or (eq? value null) (nil? value)) (emit "null"))
        ((eq? value #t) (emit "true"))
        ((eq? value #f) (emit "false"))
        ((string? value) (string! value))
        ((number? value)
         (unless (finite-number? value) (error "json: expected a finite number"))
         (emit (number->string value)))
        ((array? value)
         (emit "[")
         (dotimes (i (length value))
           (when (> i 0) (emit ","))
           (value! (get value i) (+ depth 1)))
         (emit "]"))
        ((table? value)
         (emit "{")
         (let ((first? #t))
           (for-each (fn (key)
                       (unless (string? key) (error "json: object keys must be strings"))
                       (unless first? (emit ","))
                       (set! first? #f)
                       (string! key)
                       (emit ":")
                       (value! (get value key) (+ depth 1)))
                     (keys value)))
         (emit "}"))
        (else (error "json: unsupported value" value))))
    (value! value 0)
    (buffer->string out)))
