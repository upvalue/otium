(ns otium.test)

(def checks 0)

(def (fail! label expected actual)
  (display "FAIL")
  (when label
    (display " ")
    (display label))
  (newline)
  (display "  expected: ")
  (write expected)
  (newline)
  (display "  actual:   ")
  (write actual)
  (newline)
  (exit 1))

(def (check & arguments)
  "(check expected actual) or (check label expected actual): exit 1 unless the values are equal?."
  (let ((label (if (= (length arguments) 3)
                   (car arguments)
                   nil))
        (pair (if (= (length arguments) 3)
                  (cdr arguments)
                  arguments)))
    (unless (= (length pair) 2) (error "check: expected 2 or 3 arguments" arguments))
    (if (equal? (car pair) (cadr pair))
        (set! checks (+ checks 1))
        (fail! label (car pair) (cadr pair)))))

(def (%fails? thunk)
  (try
    (begin
      (thunk)
      #f)
    (catch ((fn (c) #t) c) #t)))

(defmacro fails? (subject)
  "(fails? thunk) or (fails? 'form): whether calling the thunk, or evaluating the form in the caller's namespace, raises a condition."
  (let ((value (gensym)))
    `(otium.test/%fails? (let ((,value ,subject))
                           (if (procedure? ,value)
                               ,value
                               (fn () (eval ,value)))))))

(def (report name)
  "Print NAME: N checks passed."
  (println (string-append name ": " (number->string checks) " checks passed")))
