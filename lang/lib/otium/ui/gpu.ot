(ns otium.ui.gpu)
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.ffi :as ffi))
(require (otium.gfx :as gfx))
(require (otium.sdl :as sdl))

(def (resize! tree renderer width height scale)
  "Update renderer dimensions and relayout retained widgets; direct rendering requires scale 0."
  (sdl/check (native/gpu-resize renderer width height scale))
  (let ((scale (native/gpu-scale renderer)))
    (layout! tree width height scale)
    scale))

(def- (allocate-node)
  (let ((p (native/node-new)))
    (when (ffi/null? p) (error "Cannot allocate Yoga node"))
    p))

(def- (eased-size! node axis target pass)
  ;; With :animate-size, an explicit size eases toward its new value. The
  ;; first size and window resizes apply at once.
  (if (or (< target 0) (not (get (node :options) :animate-size #f)))
      (begin
        (when (node :sizes) (put! (node :sizes) axis nil))
        target)
      (let ((sizes (or (node :sizes) {}))
            (e (get sizes axis)))
        (set! (node :sizes) sizes)
        (cond
          ((or (nil? e) (pass :instant)) (put! sizes axis {:value target :target target :stepped nil}))
          ((not (= (e :target) target)) (put! e :target target))
          (else nil))
        (let ((e (get sizes axis))
              (resizing (pass :resizing)))
          (unless (or (= (e :value) (e :target))
                      (and (not (empty? resizing)) (eq? node (get resizing (- (length resizing) 1)))))
            (push! resizing node))
          (e :value)))))

(def (resizing? tree)
  (let ((resizing (tree :resizing))) (and resizing (not (empty? resizing)))))

(def (step-sizes! tree now)
  "Advance :animate-size widgets to time now, in seconds. Run layout! afterwards."
  (for-each (fn (node)
              (when (and (ui/active? node) (node :sizes))
                (for-each (fn (e)
                            (unless (= (e :value) (e :target))
                              (put! e :value (ui/decay (e :value) (e :target) (ui/elapsed (e :stepped) now) 0.06))
                              (put! e
                                    :stepped (if (= (e :value) (e :target))
                                                 nil
                                                 now))))
                          (values (node :sizes)))))
            (tree :resizing)))

(def- (sync-node! node pass)
  (unless (node :layout)
    (let ((p (allocate-node)))
      (set! (node :layout) p)
      (set! (node :release-layout) (fn () (native/node-free p)))))
  (let ((p (node :layout))
        (w (ui/instance node)))
    (native/node-clear p)
    ;; Remove the old leaf callback before adding children.
    (native/node-intrinsic p 0 0 #f)
    (let ((s (ui/layout-style w)))
      (unless (native/node-style p
                                 (eased-size! node :width (get s :width -1) pass)
                                 (eased-size! node :height (get s :height -1) pass)
                                 (get s :grow 0)
                                 (get s :padding 0)
                                 (get s :gap 0)
                                 (if (get s :row #f)
                                     1
                                     0))
        (error "Invalid widget layout style"))
      (unless (native/node-padding p
                                   (or (get s :padding-x) (get s :padding 0))
                                   (or (get s :padding-y) (get s :padding 0)))
        (error "Invalid widget padding"))
      (native/node-align p
                         (let ((align (get s :align-items :stretch)))
                           (cond
                             ((eq? align :stretch) 0)
                             ((eq? align :start) 1)
                             ((eq? align :center) 2)
                             ((eq? align :end) 3)
                             (else (error "Unknown :align-items" align)))))
      (native/node-center p (get s :center #f))
      (native/node-scroll p (get s :scroll #f)))
    (if (empty? (ui/children node))
        (native/node-intrinsic p 0 0 #t)
        (for-each (fn (child)
                    (sync-node! child pass)
                    (native/node-shrink (child :layout)
                                        (and (not (eq? (dispatch-type w) ui/Scroll))
                                             (not (eq? (dispatch-type (ui/instance child)) ui/Icon))))
                    (native/node-append p (child :layout)))
                  (ui/children node)))))

(def- (measure-mode value)
  (cond
    ((= value native/MEASURE_UNDEFINED) :undefined)
    ((= value native/MEASURE_EXACTLY) :exactly)
    ((= value native/MEASURE_AT_MOST) :at-most)
    (else (error "Unknown native measurement mode" value))))

(def- (answer-queries! node scale)
  (let ((p (node :layout))
        (changed #f))
    (let loop ((i (native/node-pending p)))
      (when (= i native/MEASURE_OVERFLOW) (error "Too many Yoga measurement queries"))
      (unless (or (= i native/MEASURE_DONE) (>= i 0)) (error "Invalid native measurement query index" i))
      (when (>= i 0)
        (let ((wm (native/node-query p i native/QUERY_WIDTH_MODE))
              (hm (native/node-query p i native/QUERY_HEIGHT_MODE))
              (limits {:scale scale :width-mode (measure-mode wm) :height-mode (measure-mode hm)}))
          (unless (= wm native/MEASURE_UNDEFINED) (put! limits :width (native/node-query p i native/QUERY_WIDTH)))
          (unless (= hm native/MEASURE_UNDEFINED) (put! limits :height (native/node-query p i native/QUERY_HEIGHT)))
          (let ((size (or (ui/measure (ui/instance node) limits) (ui/size 0 0))))
            (unless (native/node-answer p i (size :width) (size :height)) (error "Invalid widget measurement"))))
        (set! changed #t)
        (loop (native/node-pending p))))
    (for-each (fn (child) (when (answer-queries! child scale) (set! changed #t))) (ui/children node))
    changed))

(def- (retry! node)
  (native/node-retry (node :layout))
  (for-each retry! (ui/children node)))

(def- (snap value scale)
  (/ (round (* value scale)) scale))

;; Records each Scroll node that is still animating after layout.
(def- (save-bounds! node x y scale animations)
  (let ((p (node :layout))
        (left (+ x (native/node-bounds p native/BOUNDS_X)))
        (top (+ y (native/node-bounds p native/BOUNDS_Y))))
    (set! (node :bounds)
          (ui/bounds left top (native/node-bounds p native/BOUNDS_WIDTH) (native/node-bounds p native/BOUNDS_HEIGHT)))
    (let ((w (ui/instance node))
          (x? #f)
          (offset 0))
      (when (eq? (dispatch-type w) ui/Scroll)
        (set! x? (eq? (w :axis) :x))
        (let ((start (if x?
                         native/BOUNDS_X
                         native/BOUNDS_Y))
              (span (if x?
                        native/BOUNDS_WIDTH
                        native/BOUNDS_HEIGHT))
              (viewport (native/node-bounds p span))
              (extent 0))
          (for-each (fn (child)
                      (set! extent
                            (max extent
                                 (+ (native/node-bounds (child :layout) start)
                                    (native/node-bounds (child :layout) span)))))
                    (ui/children node))
          (set! (w :limit) (max 0 (- (+ extent (w :padding)) viewport)))
          (if (and (w :stick-to-bottom) (w :following?))
              (ui/scroll-to! w (w :limit))
              (begin
                (set! (w :offset) (min (w :offset) (w :limit)))
                (set! (w :target) (min (w :target) (w :limit)))))
          (reveal! w (ui/children node) start span viewport)
          (set! (w :applied) (snap (w :offset) scale))
          (when (ui/scroll-animating? w) (push! animations node))
          (set! offset (w :applied))))
      (for-each (fn (child)
                  (if x?
                      (save-bounds! child (- left offset) top scale animations)
                      (save-bounds! child left (- top offset) scale animations)))
                (ui/children node)))))

(def- (reveal! w children start span viewport)
  ;; Scroll just far enough to show the :reveal child, once per change of its
  ;; key, position or the viewport, so wheel scrolling is not undone. The first
  ;; reveal, viewport changes and resizing children jump; others animate.
  (let ((target (and (w :reveal) (find (fn (child) (equal? (child :key) (w :reveal))) children))))
    (when target
      (let ((s (native/node-bounds (target :layout) start))
            (e (+ s (native/node-bounds (target :layout) span)))
            (seen (list (w :reveal) s e viewport))
            (previous (w :revealed))
            ;; A resizing child is already easing, so follow its edge exactly.
            (move! (if (and previous (= (nth previous 3) viewport) (not (resizing-node? target)))
                       ui/scroll-toward!
                       ui/scroll-to!)))
        (unless (equal? seen previous)
          (set! (w :revealed) seen)
          ;; Show the far edge, then the near one, so a child wider than the
          ;; viewport shows its start.
          (let ((goal (w :target)))
            (when (> e (- (+ goal viewport) (w :padding))) (set! goal (+ (- e viewport) (w :padding))))
            (when (< s (+ goal (w :padding))) (set! goal (- s (w :padding))))
            (unless (= goal (w :target)) (move! w goal))))))))

(def- (resizing-node? node)
  (and (node :sizes) (find (fn (e) (not (= (e :value) (e :target)))) (values (node :sizes)))))

(def- (shift! node dx dy)
  (let ((b (node :bounds)))
    (set! (b :x) (+ (b :x) dx))
    (set! (b :y) (+ (b :y) dy)))
  (for-each (fn (child) (shift! child dx dy)) (ui/children node)))

(def (animating? tree)
  (let ((animations (tree :animations))) (and animations (not (empty? animations)))))

(def (animate! tree now scale)
  "Advance scroll animations to time now, in seconds, and move their content
without relayout. Returns true while any animation continues."
  (let ((active []))
    (for-each (fn (node)
                (when (ui/active? node)
                  (let ((w (ui/instance node))
                        (before (w :applied)))
                    (ui/scroll-step! w now)
                    (set! (w :applied) (snap (w :offset) scale))
                    (let ((d (- before (w :applied))))
                      (unless (= d 0)
                        (for-each (fn (child)
                                    (if (eq? (w :axis) :x)
                                        (shift! child d 0)
                                        (shift! child 0 d)))
                                  (ui/children node))))
                    (when (ui/scroll-animating? w) (push! active node)))))
              (tree :animations))
    (set! (tree :animations) active)
    (not (empty? active))))

(def (layout! tree width height . pixel-scale)
  "Measure leaves using Yoga constraints, replaying until every query is answered."
  (unless (and (> width 0) (> height 0)) (error "Layout dimensions must be positive"))
  (let ((root (allocate-node))
        (scale (if (null? pixel-scale)
                   1
                   (car pixel-scale)))
        (pass {:resizing [] :instant (not (equal? (tree :size) (list width height)))}))
    (set! (tree :size) (list width height))
    (unwind-protect
      (begin
        (unless (native/node-style root width height 0 0 0 0) (error "Invalid root size"))
        (for-each (fn (node)
                    (sync-node! node pass)
                    (native/node-append root (node :layout)))
                  (ui/children tree))
        (set! (tree :resizing) (pass :resizing))
        (let loop ((pass 0))
          (when (> pass 256) (error "Yoga measurement did not converge"))
          (native/node-layout root width height)
          (let ((changed #f))
            (for-each (fn (node) (when (answer-queries! node scale) (set! changed #t))) (ui/children tree))
            (when changed
              (for-each retry! (ui/children tree))
              (loop (+ pass 1)))))
        (let ((animations []))
          (for-each (fn (node) (save-bounds! node 0 0 scale animations)) (ui/children tree))
          (set! (tree :animations) animations)))
      (native/node-free root)))
  tree)

(def- (inset bounds x y)
  (ui/bounds (+ (bounds :x) x)
             (+ (bounds :y) y)
             (max 0 (- (bounds :width) (* 2 x)))
             (max 0 (- (bounds :height) (* 2 y)))))

(def- (intersect a b)
  (let ((x (max (a :x) (b :x)))
        (y (max (a :y) (b :y))))
    (ui/bounds x
               y
               (max 0 (- (min (+ (a :x) (a :width)) (+ (b :x) (b :width))) x))
               (max 0 (- (min (+ (a :y) (a :height)) (+ (b :y) (b :height))) y)))))

(def- (paint-node! node renderer clip generation resizing?)
  (unless (node :bounds) (error "Run layout before painting"))
  (let ((visible (intersect clip (node :bounds)))
        (resizing? (or resizing? (resizing-node? node))))
    (when (and (> (visible :width) 0) (> (visible :height) 0))
      (if (get (node :options) :cache #f)
          (begin
            (unless (node :paint-cache) (set! (node :paint-cache) (gfx/cache)))
            (gfx/cached (make gfx/Context :renderer renderer :clip clip)
                        (node :paint-cache)
                        (node :bounds)
                        generation
                        (fn (g) (paint-subtree! node renderer (g :clip) generation resizing?))))
          (paint-subtree! node renderer visible generation resizing?)))))

(def- (paint-subtree! node renderer clip generation resizing?)
  (ui/paint (ui/instance node)
            (make gfx/Context
                  :renderer renderer
                  :clip clip
                  :focused? (node :focused?)
                  :pressed? (node :pressed?)
                  :hovered? (node :hovered?)
                  :disabled? (not (ui/enabled? node))
                  :resizing? (and resizing? #t))
            (node :bounds))
  (for-each (fn (child) (paint-node! child renderer clip generation resizing?)) (ui/children node)))

(def (invalidate-paint! tree)
  "Make widgets with the :cache option paint again on the next frame. Call it
after reconciling: a layout alone does not change what cached subtrees draw,
and a subtree whose size changed records again anyway."
  (set! (tree :generation) (+ 1 (tree :generation))))

(def (paint! tree renderer width height background)
  "Record the tree's drawing. Subtrees with the :cache option replay their last
recording until invalidate-paint! starts a new generation or their size changes."
  (native/gpu-clear renderer background)
  (let ((clip (ui/bounds 0 0 width height))
        (generation (tree :generation)))
    (for-each (fn (node) (paint-node! node renderer clip generation #f)) (ui/children tree))))

(def- (paint-box w g bounds)
  (let ((border (w :border))
        (radius (w :radius)))
    (cond
      ((and border (w :background))
       (gfx/rect g bounds border radius)
       (gfx/rect g (inset bounds 1 1) (w :background) (max 0 (- radius 1))))
      (border
        ;; Without a fill, draw the four edges; corners stay square.
        (let ((x (bounds :x))
              (y (bounds :y))
              (width (bounds :width))
              (height (bounds :height)))
          (gfx/rect g (ui/bounds x y width 1) border)
          (gfx/rect g (ui/bounds x (- (+ y height) 1) width 1) border)
          (gfx/rect g (ui/bounds x y 1 height) border)
          (gfx/rect g (ui/bounds (- (+ x width) 1) y 1 height) border)))
      ((w :background) (gfx/rect g bounds (w :background) radius))
      (else nil))))

(defmethod (ui/paint (w ui/Column) g bounds)
  (paint-box w g bounds))

(defmethod (ui/paint (w ui/Row) g bounds)
  (paint-box w g bounds))

(defmethod (ui/layout-style (w ui/Label))
  {:width (w :width) :height (w :height) :grow (w :grow)})

(defmethod (ui/measure (w ui/Label) limits)
  (let ((text (native/text-get (w :text)
                               (gfx/font-index (w :font))
                               (w :size)
                               (if (w :wrap)
                                   (get limits :width -1)
                                   -1)
                               (get limits :scale 1))))
    (when (ffi/null? text) (error "Text measurement failed" (native/text-error)))
    (ui/size (/ (native/text-size text native/TEXT_WIDTH) (get limits :scale 1))
             (/ (native/text-size text native/TEXT_HEIGHT) (get limits :scale 1)))))

(defmethod (ui/paint (w ui/Label) g bounds)
  (let ((preferred (ui/measure w {:width (bounds :width) :scale (native/gpu-scale (g :renderer))}))
        (offset (cond
                  ((eq? (w :align) :center) (/ (- (bounds :width) (preferred :width)) 2))
                  ((eq? (w :align) :right) (- (bounds :width) (preferred :width)))
                  (else 0))))
    (gfx/text g
              (ui/bounds (+ (bounds :x) offset) (bounds :y) (bounds :width) (bounds :height))
              (w :text)
              (w :font)
              (w :size)
              (if (g :disabled?)
                  (ui/color :muted)
                  (ui/color (w :color)))
              (w :wrap))))

(defmethod (ui/paint (w ui/Button) g bounds)
  (unless (eq? (w :style) :bare)
    (let ((color (cond
                   ((g :disabled?) (ui/color :disabled))
                   ((g :pressed?)
                    (if (eq? (w :style) :accent)
                        (ui/color :accent-pressed)
                        (ui/color :selection)))
                   ((eq? (w :style) :accent) (ui/color :accent))
                   (else (ui/color :surface)))))
      (gfx/rect g
                bounds
                (if (g :focused?)
                    (ui/color :focus)
                    color)
                (w :radius))
      (when (g :focused?) (gfx/rect g (inset bounds 2 2) color (max 0 (- (w :radius) 2)))))))

(defmethod (ui/paint (w ui/Scroll) g bounds)
  (when (w :background) (gfx/rect g bounds (w :background) 0))
  (when (> (w :limit) 0)
    (if (eq? (w :axis) :x)
        (let ((width (max 16 (/ (* (bounds :width) (bounds :width)) (+ (bounds :width) (w :limit))))))
          (gfx/rect g
                    (ui/bounds (+ (bounds :x) (* (/ (w :offset) (w :limit)) (- (bounds :width) width)))
                               (- (+ (bounds :y) (bounds :height)) 5)
                               width
                               3)
                    (ui/color :muted)
                    1))
        (let ((height (max 16 (/ (* (bounds :height) (bounds :height)) (+ (bounds :height) (w :limit))))))
          (gfx/rect g
                    (ui/bounds (- (+ (bounds :x) (bounds :width)) 5)
                               (+ (bounds :y) (* (/ (w :offset) (w :limit)) (- (bounds :height) height)))
                               3
                               height)
                    (ui/color :muted)
                    1)))))

(def (caret-positions text font size scale)
  "Return codepoint caret coordinates from one shaped, unwrapped line."
  (let ((count (+ (string-length text) 1))
        (positions [])
        (buffer (ffi/alloc 'float count)))
    (unwind-protect
      (let ((run (native/text-get text (gfx/font-index font) size -1 scale)))
        (when (ffi/null? run) (error "Text field measurement failed" (native/text-error)))
        (unless (native/text-carets run buffer count) (error "Text caret measurement failed" (native/text-error)))
        (dotimes (i count)
          (push! positions (/ (ffi/ref buffer 'float i) scale)))
        positions)
      (ffi/free! buffer))))

(defmethod (ui/measure (w ui/TextField) limits)
  (ui/size 160 (+ (w :size) 26)))

(defmethod (ui/paint (w ui/TextField) g bounds)
  (let ((positions (caret-positions (w :value) (w :font) (w :size) (native/gpu-scale (g :renderer))))
        (available (max 0 (- (bounds :width) 20)))
        (block? (eq? (w :caret-style) :block))
        (caret-width 1))
    (when block?
      (set! caret-width
            (if (< (w :cursor) (string-length (w :value)))
                (max 1 (abs (- (get positions (+ (w :cursor) 1)) (get positions (w :cursor)))))
                (max 1 (get (caret-positions " " (w :font) (w :size) (native/gpu-scale (g :renderer))) 1)))))
    (set! (w :positions) positions)
    (let ((caret (get positions (w :cursor)))
          (end (get positions (- (length positions) 1))))
      (set! (w :offset) (clamp (w :offset) 0 (max 0 (- end available))))
      (when (< caret (w :offset)) (set! (w :offset) caret))
      (when (= (w :cursor) 0) (set! (w :offset) 0))
      (when (> caret (+ (w :offset) (- available (+ caret-width 1))))
        (set! (w :offset) (max 0 (- caret (- available (+ caret-width 1)))))))
    (gfx/rect g
              bounds
              (if (g :focused?)
                  (ui/color :focus)
                  (ui/color :selection))
              8)
    (gfx/rect g (inset bounds 2 2) (ui/color :input) 6)
    (let ((inner (inset bounds 10 8))
          (context (gfx/with-clip g (intersect (g :clip) inner)))
          (origin (- (inner :x) (w :offset))))
      (when (and (g :focused?) (not (= (w :cursor) (w :anchor))))
        (let ((a (get positions (w :cursor)))
              (b (get positions (w :anchor))))
          (gfx/rect context
                    (ui/bounds (+ origin (min a b)) (inner :y) (abs (- b a)) (inner :height))
                    (ui/color :selection)
                    0)))
      (gfx/text context
                (ui/bounds origin (inner :y) available (inner :height))
                (if (equal? (w :value) "")
                    (w :placeholder)
                    (w :value))
                (w :font)
                (w :size)
                (if (or (g :disabled?) (equal? (w :value) ""))
                    (ui/color :muted)
                    (ui/color :text))
                #f)
      (when (g :focused?)
        (let ((caret-bounds (ui/bounds (+ origin (get positions (w :cursor))) (inner :y) caret-width (inner :height))))
          (gfx/rect context caret-bounds (ui/color :accent) 0)
          (when (and block? (< (w :cursor) (string-length (w :value))))
            (gfx/text (gfx/with-clip context (intersect (context :clip) caret-bounds))
                      (ui/bounds origin (inner :y) available (inner :height))
                      (w :value)
                      (w :font)
                      (w :size)
                      (ui/color :input)
                      #f)))))))

;; Recheck paths after module reload; ordinary frames do no file IO here.
(def- icon-paths {})

(def (icon-path w)
  (unless (keyword? (w :name)) (error "Icon name must be a keyword" (w :name)))
  (unless native/icons-directory (error "Load UI config before using icons"))
  (let ((name (keyword->string (w :name)))
        (path (str native/icons-directory
                   "/"
                   (if (w :fill)
                       "fill"
                       "regular")
                   "/"
                   name
                   ".svg")))
    (unless (get icon-paths path)
      (when (or (equal? name "")
                (string-contains? name "/")
                (string-contains? name "\\")
                (string-contains? name ".")
                (string-contains? name "\x0;"))
        (error (str "Unknown icon: " name)))
      (try
        (unless (file-exists? path) (error (str "Unknown icon: " name)))
        (catch (error? _) (error (str "Unknown icon: " name))))
      (put! icon-paths path #t))
    path))

(defmethod (ui/build (w ui/Icon))
  (icon-path w)
  nil)

(defmethod (ui/layout-style (w ui/Icon))
  (unless (and (number? (w :size)) (>= (w :size) 1) (<= (w :size) 256))
    (error "Icon size must be between 1 and 256" (w :size)))
  {:width (w :size) :height (w :size)})

(defmethod (ui/measure (w ui/Icon) limits)
  (ui/size (w :size) (w :size)))

(defmethod (ui/paint (w ui/Icon) g bounds)
  (gfx/image g bounds (icon-path w) (ui/color (w :color))))
