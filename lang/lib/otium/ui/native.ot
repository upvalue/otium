(ns otium.ui.native)
(require (otium.ffi :as ffi))

;; Scalar selectors used by the native layout and text bridge.
(def BOUNDS_X 0)

(def BOUNDS_Y 1)

(def BOUNDS_WIDTH 2)

(def BOUNDS_HEIGHT 3)

(def QUERY_WIDTH 0)

(def QUERY_HEIGHT 1)

(def QUERY_WIDTH_MODE 2)

(def QUERY_HEIGHT_MODE 3)

(def MEASURE_UNDEFINED 0)

(def MEASURE_EXACTLY 1)

(def MEASURE_AT_MOST 2)

(def MEASURE_DONE -1)

(def MEASURE_OVERFLOW -2)

(def TEXT_WIDTH 0)

(def TEXT_HEIGHT 1)

(ffi/defbindings library
                 load!
                 (node-new "otui_node_new" () pointer)
                 (node-free "otui_node_free" (pointer) void)
                 (node-clear "otui_node_clear" (pointer) void)
                 (node-append "otui_node_append" (pointer pointer) void)
                 (node-center "otui_node_center" (pointer bool) void)
                 (node-scroll "otui_node_scroll" (pointer bool) void)
                 (node-shrink "otui_node_shrink" (pointer bool) void)
                 (node-style "otui_node_style" (pointer float float float float float int) bool)
                 (node-intrinsic "otui_node_intrinsic" (pointer float float bool) bool)
                 (node-pending "otui_node_pending" (pointer) int)
                 (node-query "otui_node_query" (pointer int int) float)
                 (node-answer "otui_node_answer" (pointer int float float) bool)
                 (node-retry "otui_node_retry" (pointer) void)
                 (text-resources "otui_text_resources" () int)
                 (text-error "otui_text_error" () utf8)
                 (text-get "otui_text_get" (utf8 int float float float) pointer)
                 (text-size "otui_text_size" (pointer int) float)
                 (text-carets "otui_text_carets" (pointer pointer int) bool)
                 (gpu-text "otui_gpu_text" (pointer utf8 int float float float float u32 float float float float) bool)
                 (node-layout "otui_node_layout" (pointer float float) void)
                 (node-bounds "otui_node_bounds" (pointer int) float)
                 (live-nodes "otui_live_nodes" () int)
                 ((private poll-event-kind) "otui_poll_event" (pointer) utf8)
                 ((private event-width) "otui_event_width" (pointer) int)
                 ((private event-height) "otui_event_height" (pointer) int)
                 ((private event-x) "otui_event_x" (pointer) float)
                 ((private event-y) "otui_event_y" (pointer) float)
                 ((private event-key) "otui_event_key" (pointer) utf8)
                 ((private event-code) "otui_event_code" (pointer) int)
                 ((private event-text) "otui_event_text" (pointer) utf8)
                 ((private event-dy) "otui_event_dy" (pointer) float)
                 (text-input "otui_text_input" (pointer bool) bool)
                 (clipboard-get "otui_clipboard_get" (pointer) utf8)
                 (clipboard-set "otui_clipboard_set" (utf8) bool)
                 ((private event-repeat) "otui_event_repeat" (pointer) int)
                 (gpu-resize "otui_gpu_resize" (pointer int int float) bool)
                 (gpu-scale "otui_gpu_scale" (pointer) float)
                 ((private gpu-create) "otui_gpu_new" (pointer int int float utf8 bool) pointer)
                 (gpu-offscreen? "otui_gpu_offscreen" (pointer) bool)
                 (gpu-free "otui_gpu_free" (pointer) void)
                 (gpu-clear "otui_gpu_clear" (pointer u32) void)
                 (gpu-rect "otui_gpu_rect" (pointer float float float float float u32 float float float float) bool)
                 (gpu-frame "otui_gpu_frame" (pointer utf8) bool)
                 (gpu-driver "otui_gpu_driver" (pointer) utf8)
                 (gpu-count "otui_gpu_count" (pointer) int)
                 (live-renderers "otui_live_renderers" () int))

(def (gpu-new window width height scale driver . offscreen)
  "Create a direct renderer, or pass #t as the last argument for offscreen rendering and capture."
  (gpu-create window
              width
              height
              scale
              driver
              (if (null? offscreen)
                  #f
                  (car offscreen))))

(def (config-ref settings key)
  (let loop ((entries settings))
    (cond
      ((null? entries) (error "Missing UI installation setting" key))
      ((eq? (car (car entries)) key) (car (cdr (car entries))))
      (else (loop (cdr entries))))))

(def (load-config! path)
  "Load installation paths as data, then open the native UI library."
  (let ((settings (read-string (read-file path))))
    (load! (config-ref settings 'library))
    settings))

(def (poll-event renderer)
  "Return a copied event table, or nil when the queue is empty."
  (let ((name (poll-event-kind renderer)))
    (unless (equal? name "")
      (let ((kind (keyword name)))
        (cond
          ((memq kind '(:quit :focus-lost)) {:kind kind})
          ((memq kind '(:key-down :key-up))
           {:kind kind
            :key (event-key renderer)
            :code (event-code renderer)
            :repeat (not (= 0 (event-repeat renderer)))})
          ((eq? kind :resize) {:kind kind :width (event-width renderer) :height (event-height renderer)})
          ((eq? kind :text-input) {:kind kind :text (event-text renderer)})
          ((memq kind '(:pointer-down :pointer-up :pointer-move))
           {:kind kind :x (event-x renderer) :y (event-y renderer)})
          ((eq? kind :wheel) {:kind kind :x (event-x renderer) :y (event-y renderer) :dy (event-dy renderer)})
          (else (error "Unknown native UI event" kind)))))))
