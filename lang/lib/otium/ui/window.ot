(ns otium.ui.window)
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.input :as input))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))
(require (otium.dev :as dev))

(defonce running? #f)

(def (open options)
  (let ((first? (null? (ui/windows)))
        (width (get options :width 640))
        (height (get options :height 480))
        (headless (get options :headless #f))
        (scale (get options :scale 0))
        (window ffi/null)
        (renderer ffi/null)
        (success? #f))
    (when first?
      (let ((settings (native/load-config! (get options :config "build/ui-config.ot"))))
        (sdl/load! (native/config-ref settings 'sdl)))
      (sdl/set-main-ready)
      (gpu/configure-app! {:name (get options :app-name "Otium")
                           :version (get options :app-version "")
                           :id (get options :app-id "org.otium.application")
                           :background (or headless (get options :background #f))})
      (sdl/check (sdl/init sdl/INIT_VIDEO)))
    (unwind-protect
      (begin
        (set! window
              (sdl/pointer (sdl/create-window (get options :title "Otium")
                                              width
                                              height
                                              (+ sdl/WINDOW_HIGH_PIXEL_DENSITY
                                                 sdl/WINDOW_RESIZABLE
                                                 (if headless
                                                     sdl/WINDOW_HIDDEN
                                                     0)))))
        (set! renderer
              (sdl/pointer (native/gpu-new window
                                           width
                                           height
                                           (if (and headless (= scale 0))
                                               1
                                               scale)
                                           (get options :driver "")
                                           (or headless (get options :offscreen #f) (> scale 0)))))
        (gpu/present-window! window
                             {:icon (get options :icon "")
                              :foreground (not (or headless (get options :background #f)))})
        (let ((handle {:window window
                       :renderer renderer
                       :tree (ui/root)
                       :pointer (input/pointer)
                       :view #f
                       :width width
                       :height height
                       :scale (native/gpu-scale renderer)
                       :requested-scale scale
                       :options options
                       :frame 0
                       :capture ""
                       :closed? #f
                       :cleanups []
                       :last-error #f}))
          (set! ui/open-windows (append ui/open-windows (list handle)))
          (set! success? #t)
          handle))
      (unless success?
        (unless (ffi/null? renderer) (native/gpu-free renderer))
        (unless (ffi/null? window) (sdl/destroy-window window))
        (when first? (sdl/quit))))))

(def (close! window)
  (try
    (unless (get window :closed?)
      (set! (window :closed?) #t)
      (set! ui/open-windows (filter (fn (other) (not (eq? other window))) (ui/windows)))
      (unwind-protect
        (when (get (get window :options) :before-close!) ((get (get window :options) :before-close!) window))
        (unwind-protect
          (ui/dispose! (get window :tree))
          (native/gpu-free (get window :renderer))
          (sdl/destroy-window (get window :window))
          (when (null? (ui/windows)) (sdl/quit)))
        (for-each (fn (cleanup) (cleanup)) (get window :cleanups))))
    (catch ((fn (_) #t) c) (error {:type 'ui-teardown :message (str c) :cause c}))))

(def- (sync! window)
  (when (get window :view)
    (ui/reconcile! (get window :tree) ((get window :view)))
    (let ((focused (ui/focused (get window :tree))))
      (sdl/check (native/text-input (get window :renderer)
                                    (if focused
                                        (ui/accepts-text? (ui/instance focused))
                                        #f))))))

(def- (event! window event)
  (let ((kind (get event :kind))
        (tree (get window :tree))
        (renderer (get window :renderer)))
    (cond
      ((eq? kind :quit) (close! window))
      ((eq? kind :resize)
       (set! (window :width) (get event :width))
       (set! (window :height) (get event :height))
       (set! (window :scale)
             (gpu/resize! tree
                          renderer
                          (get event :width)
                          (get event :height)
                          (if (and (get (get window :options) :headless) (= (get window :requested-scale) 0))
                              1
                              (get window :requested-scale)))))
      ((eq? kind :focus-lost) (input/cancel! (get window :pointer)) (input/keyboard! tree event))
      ((memq kind '(:key-down :key-up :text-input))
       (input/keyboard! tree
                        (put (put event :clipboard-read (fn () (native/clipboard-get renderer)))
                             :clipboard-write (fn (text) (sdl/check (native/clipboard-set text))))))
      ((memq kind '(:pointer-down :pointer-up :pointer-move :wheel))
       (input/dispatch! (get window :pointer) tree event)))))

(def (frame! window)
  (let ((tree (get window :tree))
        (renderer (get window :renderer))
        (options (get window :options)))
    (unless (get window :initialized?)
      (sync! window)
      (set! (window :initialized?) #t))
    (let poll ((event (native/poll-event renderer)))
      (when event
        (event! window event)
        (unless (get window :closed?)
          (sync! window)
          (poll (native/poll-event renderer)))))
    (unless (get window :closed?)
      (when (get options :step!) ((get options :step!) window))
      (sync! window)
      (gpu/layout! tree (get window :width) (get window :height) (get window :scale))
      (gpu/paint! tree renderer (get window :width) (get window :height) (get options :background-color 0x101827ff))
      (sdl/check (native/gpu-frame renderer (get window :capture)))
      (set! (window :capture) "")
      (set! (window :frame) (+ 1 (get window :frame)))
      (set! (window :last-error) #f)
      (when (get options :after-frame!) ((get options :after-frame!) window)))))

(def (run)
  (unless running?
    (set! running? #t)
    (unwind-protect
      (while (pair? (ui/windows))
        (dev/service!)
        (for-each (fn (window)
                    (unless (get window :closed?)
                      (dev/begin!)
                      (unwind-protect
                        (try
                          (frame! window)
                          (catch ((fn (_) #t) c)
                            (when (or (get (get window :options) :fail-fast?) (eq? (condition-type c) 'ui-teardown))
                              (error c))
                            (let ((key (list dev/revision c)))
                              (unless (equal? key (get window :last-error))
                                (set! (window :last-error) key)
                                (dev/frame-error! c)))))
                        (dev/end!))))
                  (ui/windows))
        (sdl/delay 16))
      (set! running? #f)
      (for-each close! (ui/windows)))))
