(ns manse.application)
(require otium.ffi :as ffi)

(defonce foundation
  (ffi/open-library '("/System/Library/Frameworks/Foundation.framework/Foundation")))

(defonce objc (ffi/open-library '("/usr/lib/libobjc.A.dylib")))
(def- get-class (ffi/bind objc "objc_getClass" '(utf8) 'pointer #t))
(def- selector (ffi/bind objc "sel_registerName" '(utf8) 'pointer #t))
(def- send (ffi/bind objc "objc_msgSend" '(pointer pointer) 'pointer #t))
(def- send-string (ffi/bind objc "objc_msgSend" '(pointer pointer utf8) 'pointer #t))
(def- set-name (ffi/bind objc "objc_msgSend" '(pointer pointer pointer) 'void #t))

(def (set-name! name)
  "Name the macOS process before Cocoa creates the application menu."
  (let ((info (send (get-class "NSProcessInfo") (selector "processInfo")))
        (title (send-string (get-class "NSString") (selector "stringWithUTF8String:") name)))
    (set-name info (selector "setProcessName:") title)))
