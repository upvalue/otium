(ns manse.ghostty)

;; Prototype bindings to libghostty-vt: terminal state, the render state and
;; its row/cell iterators, and the write_pty effect. Constants and signatures
;; follow the headers at the commit in docs/native-dependencies.md.

(require otium.ffi :as ffi)
(require otium.process :as process)
(require otium.json :as json)

;; GhosttyResult
(def SUCCESS 0)

;; GhosttyTerminalOption
(def- OPT-WRITE-PTY 1)

;; GhosttyBuildInfo and GhosttyOptimizeMode
(def- BUILD-INFO-OPTIMIZE 4)
(def- BUILD-INFO-VERSION-STRING 5)
(def- optimize-modes [:debug :release-safe :release-small :release-fast])

;; GhosttyRenderStateData
(def- STATE-COLS 1)
(def- STATE-ROWS 2)
(def- STATE-ROW-ITERATOR 4)
(def- STATE-CURSOR-VISIBLE 11)
(def- STATE-CURSOR-VIEWPORT-HAS-VALUE 14)
(def- STATE-CURSOR-VIEWPORT-X 15)
(def- STATE-CURSOR-VIEWPORT-Y 16)

;; GhosttyRenderStateRowData
(def- ROW-CELLS 3)

;; GhosttyRenderStateRowCellsData
(def- CELL-STYLE 2)
(def- CELL-GRAPHEMES-LEN 3)
(def- CELL-GRAPHEMES-BUF 4)
(def- CELL-BG-COLOR 5)
(def- CELL-FG-COLOR 6)

;; Layouts. check-layouts! compares them with the library's own description.
(defonce layouts {})

(def (layout c-name fields)
  (let ((t (ffi/define-struct! (symbol c-name) fields)))
    (put! layouts c-name {:layout t :fields fields})
    t))

(def Rgb (layout "GhosttyColorRgb" '((r u8) (g u8) (b u8))))

;; tag is an enum; value is a union of a palette index and an Rgb.
(def StyleColor (layout "GhosttyStyleColor" '((tag i32) (value u64))))

(def Style
  (layout "GhosttyStyle"
          (list '(size u64)
                (list 'fg-color StyleColor)
                (list 'bg-color StyleColor)
                (list 'underline-color StyleColor)
                '(bold bool)
                '(italic bool)
                '(faint bool)
                '(blink bool)
                '(inverse bool)
                '(invisible bool)
                '(strikethrough bool)
                '(overline bool)
                '(underline i32))))

(def Colors
  (layout "GhosttyRenderStateColors"
          (list '(size u64)
                (list 'background Rgb)
                (list 'foreground Rgb)
                (list 'cursor Rgb)
                '(cursor-has-value bool)
                (list 'palette (list 'array Rgb 256)))))

(def GString (layout "GhosttyString" '((ptr pointer) (len size-t))))

(ffi/defbindings library %load!
  ((private %type-json) "ghostty_type_json" () utf8 #f)
  ((private %build-info) "ghostty_build_info" (int pointer) int #f)
  ((private %terminal-new) "ghostty_terminal_new" (pointer pointer u16 u16) int #t)
  ((private %terminal-free) "ghostty_terminal_free" (pointer) void #t)
  ((private %terminal-set) "ghostty_terminal_set" (pointer int pointer) int #t)
  ((private %terminal-resize) "ghostty_terminal_resize" (pointer u16 u16 u32 u32) int #t)
  ((private %vt-write) "ghostty_terminal_vt_write" (pointer pointer size-t) void #t)
  ((private %key-encoder-new) "ghostty_key_encoder_new" (pointer pointer) int #t)
  ((private %key-encoder-free) "ghostty_key_encoder_free" (pointer) void #t)
  ((private %key-options) "ghostty_key_encoder_setopt_from_terminal" (pointer pointer) void #t)
  ((private %key-option) "ghostty_key_encoder_setopt" (pointer int pointer) void #t)
  ((private %key-encode) "ghostty_key_encoder_encode" (pointer pointer pointer size-t pointer) int #t)
  ((private %key-event-new) "ghostty_key_event_new" (pointer pointer) int #t)
  ((private %key-event-free) "ghostty_key_event_free" (pointer) void #t)
  ((private %key-action) "ghostty_key_event_set_action" (pointer int) void #t)
  ((private %key-code) "ghostty_key_event_set_key" (pointer int) void #t)
  ((private %key-mods) "ghostty_key_event_set_mods" (pointer u16) void #t)
  ((private %key-text) "ghostty_key_event_set_utf8" (pointer pointer size-t) void #t)
  ((private %key-unshifted) "ghostty_key_event_set_unshifted_codepoint" (pointer u32) void #t)
  ((private %state-new) "ghostty_render_state_new" (pointer pointer) int #t)
  ((private %state-free) "ghostty_render_state_free" (pointer) void #t)
  ((private %state-update) "ghostty_render_state_update" (pointer pointer) int #t)
  ((private %state-get) "ghostty_render_state_get" (pointer int pointer) int #f)
  ((private %colors-get) "ghostty_render_state_colors_get" (pointer pointer) int #f)
  ((private %rows-new) "ghostty_render_state_row_iterator_new" (pointer pointer) int #t)
  ((private %rows-free) "ghostty_render_state_row_iterator_free" (pointer) void #t)
  ((private %rows-next) "ghostty_render_state_row_iterator_next" (pointer) bool #f)
  ((private %row-get) "ghostty_render_state_row_get" (pointer int pointer) int #f)
  ((private %cells-new) "ghostty_render_state_row_cells_new" (pointer pointer) int #t)
  ((private %cells-free) "ghostty_render_state_row_cells_free" (pointer) void #t)
  ((private %cells-next) "ghostty_render_state_row_cells_next" (pointer) bool #f)
  ((private %cell-get) "ghostty_render_state_row_cells_get" (pointer int pointer) int #f))

(def (library-candidates)
  "MANSE_GHOSTTY_LIBRARY when set, with no fallback; otherwise loader names and Nix profiles."
  (let ((override (process/getenv "MANSE_GHOSTTY_LIBRARY")))
    (if override
        (list override)
        (let ((home (process/getenv "HOME")))
          (filter (fn (x) x)
                  (list "libghostty-vt.dylib"
                        "libghostty-vt.so"
                        (and home (str home "/.nix-profile/lib/libghostty-vt.dylib"))
                        "/run/current-system/sw/lib/libghostty-vt.dylib"))))))

(def- (check! op result)
  (unless (= result SUCCESS) (error (str "ghostty: " op " failed") result))
  result)

;; One scratch slot for scalar and handle out-parameters, reused by every call.
(defonce scratch nil)

(def (load!)
  (unless library
    (%load! (library-candidates))
    (set! scratch (ffi/alloc 'u64 1)))
  (when (eq? (get (build-info) :optimize) :debug)
    (process/write-error "manse: libghostty-vt is a debug build and will be slow\n"))
  library)

(def- (read-gstring p)
  "Copy a GhosttyString's bytes. They are not NUL-terminated, so copy to a terminated buffer first."
  (let ((len (ffi/field-ref p GString '(len))))
    (let ((copy (ffi/alloc 'u8 (+ len 1))))
      (ffi/copy! copy (ffi/field-ref p GString '(ptr)) len)
      (ffi/set! copy 'u8 len 0)
      (let ((s (ffi/read-utf8 copy (+ len 1))))
        (ffi/free! copy)
        s))))

(def (build-info)
  (let ((s (ffi/alloc GString 1)))
    (check! "build_info" (%build-info BUILD-INFO-OPTIMIZE scratch))
    (let ((optimize (get optimize-modes (ffi/ref scratch 'i32 0))))
      (check! "build_info" (%build-info BUILD-INFO-VERSION-STRING s))
      (let ((version (read-gstring s)))
        (ffi/free! s)
        {:optimize optimize :version version}))))

(def- (snake name)
  (string-replace (str name) "-" "_"))

(def (check-layouts!)
  "Compare every declared layout's size, alignment and field offsets with ghostty_type_json."
  (let ((described (json/parse (%type-json))))
    (for-each
      (fn (c-name)
        (let ((d (get described c-name))
              (t (get (get layouts c-name) :layout))
              (fields (get (get layouts c-name) :fields)))
          (unless d (error "ghostty: library does not describe" c-name))
          (unless (and (= (ffi/sizeof t) (d "size")) (= (ffi/alignof t) (d "align")))
            (error "ghostty: size or alignment differs" c-name))
          (unless (= (length fields) (length (d "fields")))
            (error "ghostty: field count differs" c-name))
          (for-each
            (fn (f)
              (let ((jf (get (d "fields") (snake (car f)))))
                (unless (and jf
                             (= (ffi/offset-of t (list (car f))) (jf "offset"))
                             (= (ffi/sizeof (cadr f)) (jf "size")))
                  (error "ghostty: field differs" c-name (car f)))))
            fields)))
      (keys layouts))
    (length (keys layouts))))

;; Terminals

(def- (new-handle op constructor . args)
  (check! op (apply constructor (append args (list scratch))))
  (ffi/ref scratch 'pointer 0))

(def (new cols rows)
  "Create a terminal with its own render state and iterators."
  (load!)
  (let ((term {:cols cols :rows rows :replies []}))
    (check! "terminal_new" (%terminal-new ffi/null scratch cols rows))
    (put! term :handle (ffi/ref scratch 'pointer 0))
    (put! term :state (new-handle "render_state_new" %state-new ffi/null))
    (put! term :row-iter (new-handle "row_iterator_new" %rows-new ffi/null))
    (put! term :cells (new-handle "row_cells_new" %cells-new ffi/null))
    (put! term :rgb (ffi/alloc Rgb 1))
    (put! term :codepoints (ffi/alloc 'u32 16))
    (put! term :style (ffi/alloc Style 1))
    (ffi/field-set! (term :style) Style '(size) (ffi/sizeof Style))
    ;; Forward through the namespace so a reload changes the behaviour of live terminals.
    (put! term :write-pty
          (ffi/callback '(pointer pointer pointer size-t) 'void
                        (fn (handle userdata data len) (on-write-pty term data len))))
    (check! "terminal_set" (%terminal-set (term :handle) OPT-WRITE-PTY (term :write-pty)))
    term))

(def (free! term)
  (free-keyboard! term)
  (%cells-free (term :cells))
  (%rows-free (term :row-iter))
  (%state-free (term :state))
  (%terminal-free (term :handle))
  (ffi/free-callback! (term :write-pty))
  (for-each (fn (k) (ffi/free! (term k))) '(:rgb :codepoints :style)))

(def- (free-keyboard! term)
  (when (term :key-encoder) (%key-encoder-free (term :key-encoder)))
  (when (term :key-event) (%key-event-free (term :key-event)))
  (when (term :key-buffer) (ffi/free! (term :key-buffer)))
  (when (term :key-text) (ffi/free! (term :key-text)))
  (for-each (fn (key) (put! term key nil)) '(:key-encoder :key-event :key-buffer :key-capacity :key-text)))

(def- (keyboard! term)
  ;; Allocate lazily so terminals opened before a reload acquire an encoder too.
  (unless (term :key-encoder)
    (let ((success? #f))
      (unwind-protect
        (begin
          (put! term :key-encoder (new-handle "key_encoder_new" %key-encoder-new ffi/null))
          (put! term :key-event (new-handle "key_event_new" %key-event-new ffi/null))
          (put! term :key-buffer (ffi/alloc 'u8 128))
          (put! term :key-text (ffi/alloc 'u8 1))
          (put! term :key-capacity 128)
          (set! success? #t))
        (unless success? (free-keyboard! term))))))

(def (encode-key term key mods action ascii unshifted)
  "Encode a key with optional ASCII text (0 for none) using this terminal's current modes."
  (keyboard! term)
  (let ((encoder (term :key-encoder))
        (event (term :key-event)))
    (%key-options encoder (term :handle))
    ;; Text composition stays on SDL's text-input path. Here Option is a modifier.
    (ffi/set! scratch 'i32 0 1)
    (%key-option encoder 6 scratch)
    (%key-code event key)
    (%key-mods event mods)
    (%key-action event action)
    (ffi/set! (term :key-text) 'u8 0 ascii)
    (%key-text event (term :key-text) (if (= ascii 0) 0 1))
    (%key-unshifted event unshifted)
    (let ((result (%key-encode encoder event (term :key-buffer) (term :key-capacity) scratch)))
      (when (= result -3)
        (let ((capacity (ffi/ref scratch 'size-t 0))
              (buffer (ffi/alloc 'u8 capacity)))
          (ffi/free! (term :key-buffer))
          (put! term :key-buffer buffer)
          (put! term :key-capacity capacity)
          (set! result (%key-encode encoder event buffer capacity scratch))))
      (check! "key_encoder_encode" result)
      (array-to-list (map (fn (i) (ffi/ref (term :key-buffer) 'u8 i))
                          (range (ffi/ref scratch 'size-t 0)))))))

(def (on-write-pty term data len)
  "Collect the terminal's replies as byte values, or pass them to :on-reply."
  (let ((handler (get term :on-reply)))
    (if handler
        (handler data len)
        (dotimes (i len) (push! (term :replies) (ffi/ref data 'u8 i))))))

(def (write-bytes! term data len)
  (%vt-write (term :handle) data len))

(def (write! term text)
  (let ((p (ffi/alloc-utf8 text)))
    (let loop ((n 0))
      (if (= 0 (ffi/ref p 'u8 n))
          (write-bytes! term p n)
          (loop (+ n 1))))
    (ffi/free! p)))

(def (resize! term cols rows cell-width cell-height)
  (check! "terminal_resize" (%terminal-resize (term :handle) cols rows cell-width cell-height))
  (put! term :cols cols)
  (put! term :rows rows))

(def (update! term)
  (check! "render_state_update" (%state-update (term :state) (term :handle))))

(def- (state-ref term key type)
  (check! "render_state_get" (%state-get (term :state) key scratch))
  (ffi/ref scratch type 0))

(def (size term)
  (list (state-ref term STATE-COLS 'u16) (state-ref term STATE-ROWS 'u16)))

(def (cursor term)
  "The cursor's viewport position, or nil when it is hidden or outside the viewport."
  (when (and (state-ref term STATE-CURSOR-VISIBLE 'bool)
             (state-ref term STATE-CURSOR-VIEWPORT-HAS-VALUE 'bool))
    (list (state-ref term STATE-CURSOR-VIEWPORT-X 'u16) (state-ref term STATE-CURSOR-VIEWPORT-Y 'u16))))

(def (colors term)
  (let ((c (ffi/alloc Colors 1)))
    (ffi/field-set! c Colors '(size) (ffi/sizeof Colors))
    (check! "colors_get" (%colors-get (term :state) c))
    (let ((rgb (fn (path) (map (fn (k) (ffi/field-ref c Colors (append path (list k)))) '(r g b)))))
      (let ((result {:foreground (rgb '(foreground)) :background (rgb '(background))}))
        (ffi/free! c)
        result))))

;; Cells. Each cell is read on demand while the iterators are positioned on it.

(def- (cell-rgb term key)
  (if (= SUCCESS (%cell-get (term :cells) key (term :rgb)))
      (list (ffi/field-ref (term :rgb) Rgb '(r)) (ffi/field-ref (term :rgb) Rgb '(g)) (ffi/field-ref (term :rgb) Rgb '(b)))
      nil))

(def (cell-codepoints term)
  (check! "row_cells_get" (%cell-get (term :cells) CELL-GRAPHEMES-LEN scratch))
  (let ((n (ffi/ref scratch 'u32 0)))
    (when (> n 16)
      (ffi/free! (term :codepoints))
      (put! term :codepoints (ffi/alloc 'u32 n)))
    (if (= n 0)
        '()
        (begin
          (check! "row_cells_get" (%cell-get (term :cells) CELL-GRAPHEMES-BUF (term :codepoints)))
          (let loop ((i (- n 1)) (acc '()))
            (if (< i 0)
                acc
                (loop (- i 1) (cons (ffi/ref (term :codepoints) 'u32 i) acc))))))))

(def (cell term)
  "The current cell as a table: :codepoints, :fg and :bg (nil for the default), and style flags."
  (check! "row_cells_get" (%cell-get (term :cells) CELL-STYLE (term :style)))
  (let ((s (term :style)))
    {:codepoints (cell-codepoints term)
     :fg (cell-rgb term CELL-FG-COLOR)
     :bg (cell-rgb term CELL-BG-COLOR)
     :bold (ffi/field-ref s Style '(bold))
     :italic (ffi/field-ref s Style '(italic))
     :inverse (ffi/field-ref s Style '(inverse))}))

;; The iterator getters take a pointer to an existing handle and reposition it.
(def- (point! term key getter source handle)
  (ffi/set! scratch 'pointer 0 handle)
  (check! "iterator" (getter source key scratch)))

(def (each-cell term f)
  "Call (f x y) for every cell in the viewport, with the iterators positioned for cell readers."
  (point! term STATE-ROW-ITERATOR %state-get (term :state) (term :row-iter))
  (let rows ((y 0))
    (when (%rows-next (term :row-iter))
      (point! term ROW-CELLS %row-get (term :row-iter) (term :cells))
      (let cols ((x 0))
        (when (%cells-next (term :cells))
          (f x y)
          (cols (+ x 1))))
      (rows (+ y 1)))))

(def (grid term)
  "The viewport as an array of rows of cell tables. For tests; allocates per cell."
  (let ((rows []))
    (each-cell term
               (fn (x y)
                 (when (= x 0) (push! rows []))
                 (push! (get rows y) (cell term))))
    rows))

(def (codepoints->string cps)
  (list->string (map integer->char cps)))

(def (text term)
  "The viewport as a list of row strings, with a space for each empty cell."
  (map (fn (row)
         (apply str (map (fn (c)
                           (if (null? (c :codepoints))
                               " "
                               (codepoints->string (c :codepoints))))
                         row)))
       (grid term)))
