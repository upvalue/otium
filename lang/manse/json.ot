(ns manse.json)

;; Prototype JSON reader. Objects become tables with string keys, arrays become
;; arrays, null becomes nil. Uses one-character strings; \u escapes are not
;; supported yet.

(def- digits "0123456789+-.eE")

(def- escapes {"\"" "\"" "\\" "\\" "/" "/" "b" "\x8;" "f" "\xC;" "n" "\n" "r" "\r" "t" "\t"})

(def (parse text)
  (let ((n (string-length text))
        (i 0))
    (def (peek) (if (< i n) (substring text i (+ i 1)) nil))
    (def (next!) (let ((c (peek))) (set! i (+ i 1)) c))
    (def (fail message) (error (str "json: " message " at " i)))
    (def (skip!)
      (while (member (peek) '(" " "\n" "\r" "\t")) (set! i (+ i 1))))
    (def (expect! c)
      (unless (equal? (next!) c) (fail (str "expected " c))))
    (def (word! w value)
      (if (equal? (substring text i (+ i (string-length w))) w)
          (begin (set! i (+ i (string-length w))) value)
          (fail "unexpected token")))
    (def (string!)
      (expect! "\"")
      (let ((b (buffer)))
        (let loop ()
          (let ((c (next!)))
            (cond
              ((nil? c) (fail "unterminated string"))
              ((equal? c "\"") (buffer->string b))
              ((equal? c "\\")
               (let ((e (get escapes (next!))))
                 (unless e (fail "unsupported escape"))
                 (buffer-push! b e)
                 (loop)))
              (else (buffer-push! b c) (loop)))))))
    (def (number!)
      (let ((start i))
        (while (and (peek) (string-contains? digits (peek))) (set! i (+ i 1)))
        (or (string->number (substring text start i)) (fail "bad number"))))
    (def (value!)
      (skip!)
      (let ((c (peek)))
        (cond
          ((equal? c "{")
           (next!)
           (let ((t {}))
             (skip!)
             (if (equal? (peek) "}")
                 (next!)
                 (let loop ()
                   (skip!)
                   (let ((k (string!)))
                     (skip!)
                     (expect! ":")
                     (put! t k (value!))
                     (skip!)
                     (if (equal? (next!) ",") (loop) (begin (set! i (- i 1)) (expect! "}"))))))
             t))
          ((equal? c "[")
           (next!)
           (let ((a []))
             (skip!)
             (if (equal? (peek) "]")
                 (next!)
                 (let loop ()
                   (push! a (value!))
                   (skip!)
                   (if (equal? (next!) ",") (loop) (begin (set! i (- i 1)) (expect! "]")))))
             a))
          ((equal? c "\"") (string!))
          ((equal? c "t") (word! "true" #t))
          ((equal? c "f") (word! "false" #f))
          ((equal? c "n") (word! "null" nil))
          ((and c (string-contains? digits c)) (number!))
          (else (fail "unexpected character")))))
    (let ((v (value!)))
      (skip!)
      (when (< i n) (fail "trailing data"))
      v)))
