(ns manse.pty)

;; Prototype pseudo-terminals: open a PTY, start a child on it, read and
;; write the controlling side, resize, and reap. Spawning and resizing go
;; through manse/native/pty.c. macOS constants only.

(require otium.ffi :as ffi)
(require otium.process :as process)

(def- O_RDWR 2)
(def- O_NOCTTY 131072)
(def- POLLIN 1)
(def- WNOHANG 1)

(def PollFd (ffi/define-struct! 'pollfd '((fd int) (events i16) (revents i16))))

(ffi/defbindings libc %load!
  ((private %openpt) "posix_openpt" (int) int)
  ((private %grantpt) "grantpt" (int) int)
  ((private %unlockpt) "unlockpt" (int) int)
  ((private %ptsname) "ptsname" (int) utf8)
  ((private %open) "open" (utf8 int) int)
  ((private %close) "close" (int) int)
  ((private %read) "read" (int pointer size-t) long)
  ((private %write) "write" (int pointer size-t) long)
  ((private %poll) "poll" (pointer uint int) int)
  ((private %waitpid) "waitpid" (int pointer int) int)
  ((private %kill) "kill" (int int) int)
  ((private %environ) "_NSGetEnviron" () pointer))

(ffi/defbindings native %load-native!
  ((private %spawn) "manse_pty_spawn" (utf8 pointer pointer utf8) int)
  ((private %resize) "manse_pty_resize" (int int int int int) int))

(def (native-candidates)
  "MANSE_NATIVE_LIBRARY when set; otherwise the Meson build, from lang/ or lang/manse/."
  (let ((override (process/getenv "MANSE_NATIVE_LIBRARY")))
    (if override
        (list override)
        '("../build/manse/native/libmanse-native.dylib" "build/manse/native/libmanse-native.dylib"))))

(def (load!)
  (unless libc (%load! '("/usr/lib/libSystem.B.dylib")))
  (unless native (%load-native! (native-candidates))))

(def- (check! op result)
  (when (< result 0) (error (str "pty: " op " failed") result))
  result)

(def (resize! pty cols rows)
  "Set the terminal size the child sees; the kernel sends it SIGWINCH."
  (check! "resize" (%resize (pty :fd) cols rows 0 0)))

(def- (with-strings strings f)
  "Call (f argv) with a NULL-terminated array of C strings, freed afterwards."
  (let ((argv (ffi/alloc 'pointer (+ (length strings) 1)))
        (owned (map ffi/alloc-utf8 strings)))
    (let loop ((i 0) (rest owned))
      (unless (null? rest)
        (ffi/set! argv 'pointer i (car rest))
        (loop (+ i 1) (cdr rest))))
    (ffi/set! argv 'pointer (length owned) ffi/null)
    (unwind-protect
      (f argv)
      (for-each ffi/free! owned)
      (ffi/free! argv))))

(def (spawn path args cols rows)
  "Start path (absolute) with args, argv[0] included, on a new PTY of the given size."
  (load!)
  (let ((fd (check! "posix_openpt" (%openpt (+ O_RDWR O_NOCTTY)))))
    (check! "grantpt" (%grantpt fd))
    (check! "unlockpt" (%unlockpt fd))
    (let ((pty {:fd fd :tty (%ptsname fd)}))
      ;; macOS rejects ioctls on the controlling side until the terminal side
      ;; has been opened, so hold it open until the child has its own copy.
      (let ((slave (check! "open" (%open (pty :tty) (+ O_RDWR O_NOCTTY)))))
        (unwind-protect
          (begin
            (resize! pty cols rows)
            (with-strings args
                          (fn (argv)
                            (put! pty :pid
                                  (check! "spawn" (%spawn path argv (ffi/ref (%environ) 'pointer 0) (pty :tty)))))))
          (%close slave)))
      (put! pty :buffer (ffi/alloc 'u8 65536))
      (put! pty :pollfd (ffi/alloc PollFd 1))
      pty)))

(def (readable? pty timeout-ms)
  (let ((p (pty :pollfd)))
    (ffi/field-set! p PollFd '(fd) (pty :fd))
    (ffi/field-set! p PollFd '(events) POLLIN)
    (ffi/field-set! p PollFd '(revents) 0)
    (> (check! "poll" (%poll p 1 timeout-ms)) 0)))

(def (read! pty)
  "Read what is available into the PTY's buffer and return the byte count; 0 at end of file."
  (let ((n (%read (pty :fd) (pty :buffer) 65536)))
    ;; EIO when the child side has closed is end of file, as on Linux.
    (if (< n 0) 0 n)))

(def (write! pty text)
  (let ((p (ffi/alloc-utf8 text)))
    (let loop ((n 0))
      (if (= 0 (ffi/ref p 'u8 n))
          (check! "write" (%write (pty :fd) p n))
          (loop (+ n 1))))
    (ffi/free! p)))

(def (write-pointer! pty data len)
  "Write len bytes from native memory, such as a libghostty reply."
  (let loop ((done 0))
    (when (< done len)
      (let ((n (check! "write" (%write (pty :fd) (ffi/view data done (- len done)) (- len done)))))
        (loop (+ done n))))))

(def (write-bytes! pty bytes)
  "Write a list of byte values."
  (let ((p (ffi/alloc 'u8 (max 1 (length bytes)))))
    (let loop ((i 0) (rest bytes))
      (unless (null? rest)
        (ffi/set! p 'u8 i (car rest))
        (loop (+ i 1) (cdr rest))))
    (check! "write" (%write (pty :fd) p (length bytes)))
    (ffi/free! p)))

(def (status pty)
  "nil while the child runs, then {:exit code} or {:signal number}."
  (let ((s (ffi/alloc 'i32 1)))
    (let ((r (%waitpid (pty :pid) s WNOHANG)))
      (let ((raw (ffi/ref s 'i32 0)))
        (ffi/free! s)
        (cond
          ((<= r 0) nil)
          ((= 0 (modulo raw 128)) {:exit (modulo (quotient raw 256) 256)})
          (else {:signal (modulo raw 128)}))))))

(def (close! pty)
  (%close (pty :fd))
  (ffi/free! (pty :buffer))
  (ffi/free! (pty :pollfd)))
