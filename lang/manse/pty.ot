(ns manse.pty)

;; Prototype pseudo-terminals: open a PTY, start a child on it, read and
;; write the controlling side, resize, and reap. Spawning and resizing go
;; through manse/native/pty.c. macOS constants only.

(require otium.ffi :as ffi)
(require otium.process :as process)

(def- O_RDWR 2)

(def- O_NOCTTY 131072)

(def- POLLIN 1)

(def- WNOHANG 1)

(def PollFd (ffi/define-struct! 'pollfd '((fd int) (events i16) (revents i16))))

(ffi/defbindings libc
                 %load!
                 ((private %openpt) "posix_openpt" (int) int #t)
                 ((private %grantpt) "grantpt" (int) int #t)
                 ((private %unlockpt) "unlockpt" (int) int #t)
                 ((private %ptsname) "ptsname" (int) utf8 #t)
                 ((private %open) "open" (utf8 int) int #t)
                 ((private %close) "close" (int) int #t)
                 ((private %poll) "poll" (pointer uint int) int #t)
                 ((private %kill) "kill" (int int) int #t)
                 ((private %environ) "_NSGetEnviron" () pointer #f))

(ffi/defbindings native
                 %load-native!
                 ((private %waitpid) "manse_pty_waitpid" (int pointer int) int #t)
                 ((private %read) "manse_pty_read" (int pointer size-t) long #t)
                 ((private %write) "manse_pty_write" (int pointer size-t) long #t)
                 ((private %spawn) "manse_pty_spawn" (utf8 pointer pointer utf8) int #t)
                 ((private %resize) "manse_pty_resize" (int int int int int) int #t))

(def (native-candidates)
  "MANSE_NATIVE_LIBRARY when set; otherwise the Meson build, from lang/ or lang/manse/."
  (let ((override (process/getenv "MANSE_NATIVE_LIBRARY")))
    (if override
        (list override)
        '("../build/manse/native/libmanse-native.dylib" "build/manse/native/libmanse-native.dylib"))))

(def (load!)
  (unless libc (%load! '("/usr/lib/libSystem.B.dylib")))
  (unless native (%load-native! (native-candidates))))

(def- (check! op result)
  (when (< result 0) (error (str "pty: " op " failed") result))
  result)

(def (resize! pty cols rows)
  "Set the terminal size the child sees; the kernel sends it SIGWINCH."
  (check! "resize" (%resize (pty :fd) cols rows 0 0)))

(def- (with-strings strings f)
  "Call (f argv) with a NULL-terminated array of C strings, freed afterwards."
  (let ((argv (ffi/alloc 'pointer (+ (length strings) 1)))
        (owned []))
    (defer
      (begin
        (for-each (fn (text) (push! owned (ffi/alloc-utf8 text))) strings)
        (dotimes (i (length owned))
          (ffi/set! argv 'pointer i (get owned i)))
        (ffi/set! argv 'pointer (length owned) ffi/null)
        (f argv))
      (for-each ffi/free! owned)
      (ffi/free! argv))))

(def (spawn path args cols rows)
  "Start path (absolute) with args, argv[0] included, on a new PTY of the given size."
  (load!)
  (let ((pty {:fd (check! "posix_openpt" (%openpt (+ O_RDWR O_NOCTTY)))})
        (success? #f))
    (unwind-protect
      (begin
        (check! "grantpt" (%grantpt (pty :fd)))
        (check! "unlockpt" (%unlockpt (pty :fd)))
        (put! pty :tty (%ptsname (pty :fd)))
        ;; Allocate before spawning so allocation failure cannot orphan a child.
        (put! pty :buffer (ffi/alloc 'u8 65536))
        (put! pty :pollfd (ffi/alloc PollFd 1))
        (let ((slave (check! "open" (%open (pty :tty) (+ O_RDWR O_NOCTTY)))))
          (defer
            (begin
              (resize! pty cols rows)
              (with-strings args
                            (fn (argv)
                              (put! pty
                                    :pid (check! "spawn"
                                                 (%spawn path argv (ffi/ref (%environ) 'pointer 0) (pty :tty)))))))
            (%close slave)))
        (set! success? #t)
        pty)
      (unless success?
        (%close (pty :fd))
        (when (pty :buffer) (ffi/free! (pty :buffer)))
        (when (pty :pollfd) (ffi/free! (pty :pollfd)))))))

(def (readable? pty timeout-ms)
  (let ((p (pty :pollfd)))
    (ffi/field-set! p PollFd '(fd) (pty :fd))
    (ffi/field-set! p PollFd '(events) POLLIN)
    (ffi/field-set! p PollFd '(revents) 0)
    (> (check! "poll" (%poll p 1 timeout-ms)) 0)))

(def (read! pty)
  "Read available bytes; 0 at EOF, nil when a readiness notification raced with a read."
  (let ((n (%read (pty :fd) (pty :buffer) 65536)))
    (cond
      ((= n -35) nil)
      ((= n -5) 0)
      (else (check! "read" n)))))

(def (write-pointer! pty data len)
  "Write all len bytes from native memory, such as a libghostty reply."
  (let loop ((done 0))
    (when (< done len)
      (let ((n (check! "write" (%write (pty :fd) (ffi/view data done (- len done)) (- len done)))))
        (when (= n 0) (error "pty: write made no progress"))
        (loop (+ done n))))))

(def (write! pty text)
  (write-bytes! pty (string->utf8 text)))

(def (write-bytes! pty bytes)
  "Write a bytevector, including embedded NULs."
  (let ((size (bytevector-length bytes))
        (p (ffi/alloc 'u8 (max 1 size))))
    (defer
      (begin
        (ffi/write-bytes! p bytes)
        (write-pointer! pty p size))
      (ffi/free! p))))

(defonce pending-pids [])

(def- (wait-status pid)
  (let ((s (ffi/alloc 'i32 1)))
    (defer
      (let ((r (%waitpid pid s WNOHANG)))
        (cond
          ((= r 0) nil)
          ((= r -10) :unavailable)
          ((< r 0) (check! "waitpid" r))
          (else (let ((raw (ffi/ref s 'i32 0)))
                  (if (= 0 (bitwise-and raw 127))
                      {:exit (bitwise-and (bitwise-arithmetic-shift raw -8) 255)}
                      {:signal (bitwise-and raw 127)})))))
      (ffi/free! s))))

(def (reap!)
  "Poll children of closed PTYs without blocking the UI."
  (set! pending-pids (filter (fn (pid) (not (wait-status pid))) pending-pids)))

(def (status pty)
  "nil while the child runs, then {:exit code} or {:signal number}."
  (or (pty :status)
      (let ((result (wait-status (pty :pid))))
        (when result (put! pty :reaped? #t))
        (unless (eq? result :unavailable)
          (when result (put! pty :status result))
          result))))

(def (close! pty)
  (unless (pty :closed?)
    (put! pty :closed? #t)
    (%close (pty :fd))
    (ffi/free! (pty :buffer))
    (ffi/free! (pty :pollfd))
    (unless (pty :reaped?) (push! pending-pids (pty :pid)))
    (reap!)))
