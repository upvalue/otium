(ns manse.settings)
(require otium.process :as process)
(require chez)
(require manse.fonts :as fonts)

(defonce options
  {:font-path #f :font-size 14 :padding 6 :width 900 :height 800 :terminals 2 :poll-ms 16 :background-poll-ms 100})

(def (configure! changes)
  "Update settings. Font path, size, and padding take effect on the next frame; other settings apply at startup."
  (unless (table? changes) (error "Manse settings must be a table"))
  (set! changes (copy changes))
  (when (contains? changes :font-path) (put! changes :font-path (fonts/resolve (changes :font-path))))
  (for-each (fn (key)
              (let ((value (changes key)))
                (unless (memq key
                              '(:font-path :font-size
                                           :padding
                                           :width
                                           :height
                                           :terminals
                                           :poll-ms
                                           :background-poll-ms
                                           :shell))
                  (error "Unknown Manse setting" key))
                (cond
                  ((eq? key :font-path)
                   (unless (or (eq? value #f)
                               (and (string? value)
                                    (> (string-length value) 0)
                                    (not (string-contains? value "\x0;"))
                                    (chez/file-exists? value)))
                     (error "Font path must name an existing font file, or be #f" value)))
                  ((eq? key :shell)
                   (unless (and (string? value) (> (string-length value) 0)) (error "Invalid shell" value)))
                  (else (unless (and (integer? value)
                                     (>= value
                                         (if (eq? key :padding)
                                             0
                                             1))
                                     (<= value
                                         (cond
                                           ((eq? key :font-size) 256)
                                           ((eq? key :terminals) 16)
                                           ((memq key '(:poll-ms :background-poll-ms)) 100)
                                           (else 16384))))
                          (error "Invalid Manse setting" key value))))))
            (keys changes))
  (for-each (fn (key) (put! options key (changes key))) (keys changes))
  options)

(def (path)
  (let ((home (process/getenv "HOME"))) (when home (str home "/.manse/config.ot"))))

(def (load! . paths)
  "Evaluate an optional config file. Use configure! to change settings. Missing files are ignored."
  (let ((file (if (null? paths)
                  (path)
                  (car paths))))
    (when (and file (chez/file-exists? file)) (eval (read-string (str "(begin\n" (read-file file) "\n)"))))))
