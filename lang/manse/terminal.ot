(ns manse.terminal)
(require otium.ui :as ui)
(require otium.gfx :as gfx)
(require otium.ui.gpu :as gpu)
(require otium.ui.native :as native)
(require otium.process :as process)
(require manse.apps :as apps)
(require manse.ghostty :as g)
(require manse.pty :as pty)
(require manse.session :as sessions)
(require manse.settings :as settings)
(require manse.keyboard :as keyboard)

(defclass TerminalApp
  :is apps/App
  session)

(def (open! id shell)
  (make TerminalApp :session (sessions/open! id shell (list shell))))

(defmethod (apps/info (app TerminalApp))
  (let ((session (app :session)))
    {:kind :terminal
     :status (cond ((session :closed?) :closed)
                   ((session :exit) :exited)
                   (else :running))
     :pid ((session :pty) :pid)
     :tty ((session :pty) :tty)
     :cols (get session :cols 80)
     :rows (get session :rows 24)
     :exit (if (session :exit) (copy (session :exit)) #f)
     :eof? (get session :eof? #f)}))

(defmethod (apps/step! (app TerminalApp))
  (sessions/pump! (app :session)))

(defmethod (apps/close! (app TerminalApp))
  (sessions/close! (app :session)))

(defmethod (apps/view (app TerminalApp))
  (ui/new Terminal {:session (app :session) :tab-navigation #f}))

(def (font-size)
  (settings/options :font-size))

(def (font)
  (or (settings/options :font-path) :mono))

(def (padding)
  (settings/options :padding))

;; Metrics

(def (cell-metrics scale)
  "Logical cell width and height for the mono font, from ten shaped Ms."
  (let ((positions (gpu/caret-positions "MMMMMMMMMM" (font) (font-size) scale))
        (run (native/text-get "M" (gfx/font-index (font)) (font-size) -1 scale)))
    (list (/ (get positions 10) 10) (/ (native/text-size run native/TEXT_HEIGHT) scale))))

(def (rgba rgb alpha)
  (+ (* (car rgb) 16777216) (* (cadr rgb) 65536) (* (caddr rgb) 256) alpha))

(def (key! session event)
  (let ((bytes (keyboard/encode (session :term) event)))
    (when bytes
      (unless (null? bytes) (pty/write-bytes! (session :pty) bytes))
      :handled)))

;; The widget

(defclass Terminal
  :is ui/Widget
  session)

(defmethod (ui/layout-style (w Terminal))
  {:grow 1})

(defmethod (ui/default-focusable? (w Terminal))
  #t)

(defmethod (ui/accepts-text? (w Terminal))
  #t)

(defmethod (ui/repeat-key? (w Terminal) event)
  #t)

(defmethod (ui/handle-event (w Terminal) event)
  (let ((kind (get event :kind))
        (session (w :session)))
    (cond
      ((eq? kind :pointer-down) :handled)
      ((or (session :closed?) (session :exit)) :handled)
      ((eq? kind :text-input) (pty/write! (session :pty) (get event :text)) :handled)
      ((eq? kind :key-down) (key! session event))
      (else nil))))

(defmethod (ui/paint (w Terminal) context bounds)
  (let ((session (w :session))
        (color (if (context :focused?)
                   0x73b7ffff
                   0x8490a0ff)))
    (gfx/rect context bounds 0x17202cff)
    (gfx/text context
              (make ui/Bounds
                    :x (+ (bounds :x) (padding))
                    :y (bounds :y)
                    :width (- (bounds :width) (* 2 (padding)))
                    :height 24)
              (str "Terminal "
                   (session :id)
                   (if (session :exit)
                       " · exited"
                       "")
                   (if (context :focused?)
                       " · focused"
                       ""))
              (font) (font-size)
              color
              #f)
    (paint-terminal session
                    context
                    (make ui/Bounds
                          :x (bounds :x)
                          :y (+ (bounds :y) 24)
                          :width (bounds :width)
                          :height (max 0 (- (bounds :height) 24))))))

(def (fit! session bounds)
  "Resize the terminal and PTY to the cells that fit in bounds."
  (let ((cols (max 1 (floor (/ (- (bounds :width) (* 2 (padding))) (session :cell-w)))))
        (rows (max 1 (floor (/ (- (bounds :height) (* 2 (padding))) (session :cell-h))))))
    (unless (and (= cols (get session :cols 0)) (= rows (get session :rows 0)))
      (put! session :cols cols)
      (put! session :rows rows)
      (g/resize! (session :term) cols rows (round (session :cell-w)) (round (session :cell-h)))
      (unless (session :exit) (pty/resize! (session :pty) cols rows))
      (g/update! (session :term)))))

(def (text-run! session g x y text color)
  (gfx/text g (make ui/Bounds :x x :y y :width 100000 :height (session :cell-h)) text (font) (font-size) color #f))

(def (paint-terminal session g bounds)
  (let ((start (current-jiffy))
        (term (session :term)))
    (let ((metrics-key (list (font) (font-size) (native/gpu-scale (g :renderer)))))
      (unless (equal? metrics-key (session :metrics-key))
        (put! session :cell-w nil)
        (put! session :metrics-key metrics-key)))
    (unless (session :cell-w)
      (let ((m (cell-metrics (native/gpu-scale (g :renderer)))))
        (put! session :cell-w (car m))
        (put! session :cell-h (cadr m))))
    (fit! session bounds)
    (let ((cw (session :cell-w))
          (ch (session :cell-h))
          (x0 (+ (bounds :x) (padding)))
          (y0 (+ (bounds :y) (padding)))
          (colors (g/colors term))
          (run (buffer))
          (run-col 0)
          (run-color nil)
          (run-y 0))
      (gfx/rect g bounds (rgba (colors :background) 255))
      (def (flush!)
        (when run-color (text-run! session g (+ x0 (* run-col cw)) run-y (buffer->string run) run-color))
        (set! run (buffer))
        (set! run-color nil))
      (g/each-cell term
                   (fn (x y)
                     (when (= x 0) (flush!))
                     (let ((c (g/cell term))
                           (py (+ y0 (* y ch))))
                       (let ((fg (or (c :fg) (colors :foreground)))
                             (bg (c :bg)))
                         (when (c :inverse)
                           (let ((t fg))
                             (set! fg (or bg (colors :background)))
                             (set! bg t)))
                         (when bg
                           (let ((left (round (+ x0 (* x cw)))))
                             (gfx/rect g
                                       (make ui/Bounds
                                             :x left
                                             :y py
                                             :width (- (round (+ x0 (* (+ x 1) cw))) left)
                                             :height ch)
                                       (rgba bg 255))))
                         (let ((color (rgba fg 255)))
                           (unless (eq? color run-color)
                             (flush!)
                             (set! run-col x)
                             (set! run-y py)
                             (set! run-color color))
                           (buffer-push! run
                                         (if (null? (c :codepoints))
                                             " "
                                             (g/codepoints->string (c :codepoints)))))))))
      (flush!)
      (let ((cur (g/cursor term)))
        (when (and cur (g :focused?) (not (session :exit)))
          (gfx/rect g
                    (make ui/Bounds :x (+ x0 (* (car cur) cw)) :y (+ y0 (* (cadr cur) ch)) :width cw :height ch)
                    (rgba (colors :foreground) 128)))))
    (record-time! session (- (current-jiffy) start))))

(def (record-time! session elapsed)
  (put! session :paint-ns (+ elapsed (get session :paint-ns 0)))
  (put! session :frames (+ 1 (get session :frames 0)))
  (when (= 0 (modulo (session :frames) 120))
    (process/write-error (str "manse "
                              (session :id)
                              ": "
                              (session :cols)
                              "x"
                              (session :rows)
                              " paint "
                              (/ (round (/ (session :paint-ns) 1200000.0)) 100.0)
                              " ms/frame\n"))
    (put! session :paint-ns 0)))

