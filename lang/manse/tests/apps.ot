(require manse.apps :as apps)
(require otium.ui :as ui)
(require otium.test :refer (check report fails?))

(defclass Counter
  :is apps/App
  (count :init 0)
  (closed? :init #f))

(defmethod (apps/info (app Counter))
  {:kind :counter :count (app :count)})

(defmethod (apps/view (app Counter))
  (ui/label {} (str (app :count))))

(defmethod (apps/step! (app Counter))
  (set! (app :count) (+ 1 (app :count)))
  #t)

(defmethod (apps/close! (app Counter))
  (set! (app :closed?) #t))

(def registry (apps/registry))
(def first (make Counter))
(def second (make Counter))
(def id (apps/add! registry "Counter" first))
(check "lookup returns the live object" first (apps/find registry id))
(check "unknown ID" nil (apps/find registry 100))
(check "duplicate object rejected" #t (fails? (fn () (apps/add! registry "Again" first))))
(check "non-app rejected" #t (fails? (fn () (apps/add! registry "Invalid" {}))))
(check "invalid name rejected" #t (fails? (fn () (apps/add! registry "" second))))
(check "names may repeat" 2 (apps/add! registry "Counter" second))
(def metadata (get (apps/query registry) 0))
(put! metadata :name "Changed snapshot")
(check "query does not expose registry entries" "Counter" ((get (apps/query registry) 0) :name))
(apps/step! first)
(check "query sees current app state" 1 ((get (apps/query registry) 0) :count))
(check "predicate query" '(1)
       (array-to-list (map :id (apps/query registry (fn (info) (> (info :count) 0))))))
(def tree (ui/root))
(ui/reconcile! tree (apps/view first))
(check "nonterminal app renders its own view" "1" ((ui/instance (get (ui/children tree) 0)) :text))
(require manse.apps :reload)
(check "registry survives code reload" first (apps/find registry id))
(check "app methods survive protocol reload" :counter ((get (apps/query registry) 0) :kind))
(apps/remove! registry id)
(check "removal closes app" #t (first :closed?))
(check "removed app no longer found" nil (apps/find registry id))
(check "removal is idempotent" nil (apps/remove! registry id))
(check "IDs are not reused" 3 (apps/add! registry "Third" (make Counter)))
(ui/dispose! tree)
(report "manse apps")
