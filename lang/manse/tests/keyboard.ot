(require manse.ghostty :as g)
(require manse.keyboard :as keyboard)
(require otium.test :refer (check report))

(def term (g/new 80 24))
(def other (g/new 80 24))
(def (encode key)
  (keyboard/encode term {:key key}))

(unwind-protect
  (begin
    (check "encoder allocated on first key" nil (term :key-encoder))
    (check "left" '(27 91 68) (encode "Left"))
    (check "control left" '(27 91 49 59 53 68) (encode "Ctrl+Left"))
    (check "option up" '(27 91 49 59 51 65) (encode "Alt+Up"))
    (check "modifiers do not leak" '(27 91 65) (encode "Up"))
    (check "repeat" '(27 91 68) (keyboard/encode term {:key "Left" :repeat #t}))
    (check "control A" '(1) (encode "Ctrl+A"))
    (check "control C" '(3) (encode "Ctrl+C"))
    (check "control space keeps NUL" '(0) (encode "Ctrl+Space"))
    (check "backspace" '(127) (encode "Backspace"))
    (check "return" '(13) (encode "Return"))
    (check "tab" '(9) (encode "Tab"))
    (check "shift tab" '(27 91 90) (encode "Shift+Tab"))
    (check "F1" '(27 79 80) (encode "F1"))
    (check "F12" '(27 91 50 52 126) (encode "F12"))
    (check "word backward" '(27 98) (encode "Alt+Left"))
    (check "word forward" '(27 102) (encode "Alt+Right"))
    (check "delete word backward" '(27 127) (encode "Alt+Backspace"))
    (check "letters wait for text input" nil (encode "A"))
    (check "shifted letters wait for text input" nil (encode "Shift+A"))
    (check "option composition waits for text input" nil (encode "Alt+E"))
    (g/write! term "\x1b;[?1h")
    (check "application cursor mode" '(27 79 68) (encode "Left"))
    (check "other terminal retains normal cursor mode" '(27 91 68) (keyboard/encode other {:key "Left"}))
    (check "word shortcut in application mode" '(27 98) (encode "Alt+Left"))
    (eval '(require manse.ghostty :reload))
    (eval '(require manse.keyboard :reload))
    (check "encoder survives reload" '(27 79 68) (encode "Left"))
    (g/write! term "\x1b;[?1l")
    (check "cursor mode reset" '(27 91 68) (encode "Left")))
  (g/free! term)
  (g/free! other))
(check "encoder freed" nil (term :key-encoder))
(report "manse keyboard")
