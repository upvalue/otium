(require manse.pty)
(ns manse.pty)
(require otium.test :refer (check report))
(set! %read (fn _args -35))
(check "EAGAIN keeps the stream open" nil (read! {}))
(set! %read (fn _args -5))
(check "EIO closes the stream" 0 (read! {}))
(set! %read (fn _args 0))
(check "zero is EOF" 0 (read! {}))
(set! %read (fn _args -9))
(check "other read errors propagate"
       #t
       (try
         (read! {})
         #f
         (catch (error? _) #t)))
(report "pty read")
