(require manse.workspace :as workspace)
(require manse.session :as sessions)
(require manse.ghostty :as g)
(require otium.ui :as ui)
(require otium.ui.input :as input)
(require otium.test :refer (check report))

;; Report input bytes without shell editing or terminal echo hiding their origin.
(def args '("sh" "-c" "stty raw -echo; exec /usr/bin/python3 -u -c 'import os; print(\"READY\", flush=True)\nwhile True:\n b=os.read(0,1)\n if b==b\"!\": break\n print(b.hex(), flush=True)'"))
(def first (sessions/open! 1 "/bin/sh" args))
(def second (sessions/open! 2 "/bin/sh" args))
(def tree (ui/root))
(def nodes nil)

(def (has? session text)
  (exists (fn (row) (string-contains? row text)) (apply list (g/text (session :term)))))

(def (wait-for predicate)
  (let ((deadline (+ (current-jiffy) 5000000000)))
    (let loop ()
      (sessions/pump! first)
      (sessions/pump! second)
      (cond ((predicate) #t)
            ((> (current-jiffy) deadline)
             (println (g/text (first :term)))
             (println (g/text (second :term)))
             #f)
            (else (loop))))))

(def (key! name)
  (input/keyboard! tree {:kind :key-down :key name}))

(put! workspace/workspace :sessions [first second])
(ui/reconcile! tree (workspace/view tree))
(set! nodes (ui/children (get (ui/children tree) 0)))
(require manse.workspace :reload)

(unwind-protect
  (begin
    (ui/reconcile! tree (workspace/view tree))
    (check "both children ready" #t (wait-for (fn () (and (has? first "READY") (has? second "READY")))))
    (set! nodes (ui/children (get (ui/children tree) 0)))
    (check "first terminal focused" (get nodes 0) (ui/focused tree))
    (key! "Tab")
    (check "Tab reaches first PTY" #t (wait-for (fn () (has? first "09"))))
    (check "Tab retains focus" (get nodes 0) (ui/focused tree))
    (check "Tab does not reach second PTY" #f (has? second "09"))
    (key! "Ctrl+Tab")
    (check "Ctrl+Tab focuses second" (get nodes 1) (ui/focused tree))
    (input/keyboard! tree {:kind :text-input :text "z"})
    (check "text reaches second PTY" #t (wait-for (fn () (has? second "7a"))))
    (check "text does not reach first PTY" #f (has? first "7a"))
    (key! "Ctrl+Shift+Tab")
    (check "reverse focus switching" (get nodes 0) (ui/focused tree))
    (set! ((get (ui/children tree) 0) :bounds) (make ui/Bounds :x 0 :y 0 :width 800 :height 600))
    (set! ((get nodes 0) :bounds) (make ui/Bounds :x 0 :y 0 :width 800 :height 300))
    (set! ((get nodes 1) :bounds) (make ui/Bounds :x 0 :y 300 :width 800 :height 300))
    (input/dispatch! (input/pointer) tree {:kind :pointer-down :x 20 :y 320})
    (check "click focuses second" (get nodes 1) (ui/focused tree))
    (key! "Ctrl+Tab")
    (check "focus wraps to first" (get nodes 0) (ui/focused tree))
    (put! first :cell-w 8)
    (put! first :cell-h 16)
    (workspace/fit! first (make ui/Bounds :x 0 :y 0 :width 652 :height 332))
    (check "first grid resized" 20 (length (g/text (first :term))))
    (check "second grid unchanged" 24 (length (g/text (second :term))))
    (ui/reconcile! tree (workspace/view tree))
    (check "reload keeps first session" first (get (workspace/workspace :sessions) 0))
    (check "reload keeps focus" (get nodes 0) (ui/focused tree))
    (key! "Ctrl+A")
    (check "control key reaches first PTY" #t (wait-for (fn () (has? first "01"))))
    (key! "Alt+Left")
    (check "word backward reaches first PTY" #t (wait-for (fn () (has? first "62"))))
    (key! "Alt+Right")
    (check "word forward reaches first PTY" #t (wait-for (fn () (has? first "66"))))
    (key! "Alt+Backspace")
    (check "delete word reaches first PTY" #t (wait-for (fn () (has? first "7f"))))
    (input/keyboard! tree {:kind :text-input :text "!"})
    (check "first child exits" #t (wait-for (fn () (first :exit))))
    (check "second child remains running" nil (second :exit))
    (key! "Ctrl+Tab")
    (key! "Tab")
    (check "second remains interactive" #t (wait-for (fn () (has? second "09")))))
  (ui/dispose! tree)
  (sessions/close! first)
  (sessions/close! second))
(report "manse workspace")
