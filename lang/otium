#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The formatter and linter run on Chez, whatever the selected runtime.
case "${1-}" in
    attach|mcp)
        exec "$root/tools/python" "$root/shared/dev/client.py" "$@" ;;
    fmt|lint)
        tool=$1
        shift
        exec "$root/chez/run" --no-project --path "$root/shared/lib" "$root/shared/tools/$tool.ot" -- "$@" ;;
esac
runtime=chez
remaining=$#
application=no
# Rotate the original arguments once, removing only runtime selectors. Values
# of launcher options and everything after -- pass through unchanged.
while [ "$remaining" -gt 0 ]; do
    argument=$1
    shift
    remaining=$((remaining - 1))
    if [ "$application" = yes ]; then
        set -- "$@" "$argument"
        continue
    fi
    case "$argument" in
        --) application=yes; set -- "$@" "$argument" ;;
        --runtime=*) runtime=${argument#--runtime=} ;;
        --runtime)
            if [ "$remaining" -eq 0 ]; then
                printf '%s\n' 'otium: --runtime requires c or chez' >&2
                exit 2
            fi
            runtime=$1; shift; remaining=$((remaining - 1)) ;;
        --path|-L|--project|--load)
            set -- "$@" "$argument"
            if [ "$remaining" -gt 0 ]; then
                value=$1; shift; remaining=$((remaining - 1))
                set -- "$@" "$value"
            fi ;;
        *) set -- "$@" "$argument" ;;
    esac
    case "$runtime" in
        c|chez) ;;
        *) printf 'otium: unknown runtime: %s (expected c or chez)\n' "$runtime" >&2; exit 2 ;;
    esac
done
case "$runtime" in
    c) exec "$root/c/otium" "$@" ;;
    chez) exec "$root/chez/run" "$@" ;;
esac
