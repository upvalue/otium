;; The active workspace's terminals as columns in a horizontal scroll.
(ns scratch.strip)

(require (otium.ui :as ui))
(require (scratch.theme :as theme))
(require (scratch.model :as m))
(require (scratch.widgets :as w))
(require (scratch.sidebar :as sidebar))

(def padding 8)

(def gap 8)

(def width-names
  {0.3333 "1/3" 0.5 "1/2" 0.6667 "2/3" 1.0 "full"})

(def (column-width fraction viewport)
  "Width of a column taking fraction of the strip, so that fractions summing to 1 fill it exactly."
  (max 160 (- (* fraction (+ (- viewport (* 2 padding)) gap)) gap)))

(def (column ws terminal viewport)
  (let ((focused? (= (terminal :id) (ws :focused)))
        (label (m/label-of (terminal :id))))
    (w/item {:key (terminal :id)
             :column? #t
             :align-items :stretch
             :width (column-width (m/width-of terminal) viewport)
             :padding-x 1
             :padding-y 1
             :radius 6
             :background theme/background
             :border (if focused?
                         theme/accent
                         theme/border-variant)
             :on-press (fn () (m/focus-terminal! (terminal :id)))}
            (ui/row {:height 30 :padding-x 10 :gap 8 :align-items :center}
                    (w/dot (get sidebar/kind-colors (terminal :kind) theme/muted) 6)
                    (w/text (if focused?
                                theme/text
                                theme/muted)
                            theme/ui-size
                            (terminal :title))
                    (w/spacer)
                    (if label
                        (w/hint-badge label (m/typed))
                        (w/text theme/faint 11 (get width-names (m/width-of terminal) ""))))
            (ui/column {:height 1 :background theme/border-variant})
            (w/pane (terminal :kind) focused?))))

(def (empty-state)
  (ui/column {:grow 1 :align-items :center :padding 40}
             (w/text theme/faint theme/ui-size "No terminals. Cmd+T opens one.")))

(def (view viewport)
  (let ((ws (m/active)))
    (if (or (not ws) (empty? (ws :terminals)))
        (empty-state)
        (ui/scroll {:key (ws :id)
                    :axis :x
                    :grow 1
                    :padding padding
                    :gap gap
                    :reveal (ws :focused)}
                   (map (fn (terminal) (column ws terminal viewport)) (ws :terminals))))))
