;; ./otium --runtime=chez -L . scratch/tests/model.ot
(require scratch.model :as m)
(require otium.test :refer (check report))

(def (titles)
  (array-to-list (map (fn (t) (t :title)) ((m/active) :terminals))))

(m/clear!)
(m/workspace-new! "otium" '("lang" :shell) '("tests" :tests))
(m/workspace-new! "site" '("server" :server))
(check "new workspace becomes active" "site" ((m/active) :name))
(check "first terminal focused" "server" ((m/focused) :title))
(m/workspace-move! -1)
(check "workspace move" "otium" ((m/active) :name))
(m/workspace-move! -5)
(check "workspace move clamps" "otium" ((m/active) :name))

(m/terminal-new! "new")
(check "new terminal opens right of focus" '("lang" "new" "tests") (titles))
(check "new terminal focused" "new" ((m/focused) :title))
(m/focus-move! 1)
(check "focus right" "tests" ((m/focused) :title))
(m/focus-move! 3)
(check "focus clamps" "tests" ((m/focused) :title))
(m/column-move! -1)
(check "column move" '("lang" "tests" "new") (titles))
(check "column move keeps focus" "tests" ((m/focused) :title))
(m/width-cycle!)
(check "width cycles" 0.6667 (m/width-of (m/focused)))
(m/width-cycle!)
(m/width-cycle!)
(check "width wraps" 0.3333 (m/width-of (m/focused)))
(m/terminal-close!)
(check "close removes focused" '("lang" "new") (titles))
(check "close focuses neighbour" "new" ((m/focused) :title))

(check "single letter hints" '("A" "S") (array-to-list (m/hint-labels 2)))
(check "two letter hints when letters run out" "AA" (get (m/hint-labels 20) 0))
(check "hint labels unique" 20 (length (m/hint-labels 20)))

(m/hints-start!)
(check "hinting" #t (m/hinting?))
(let ((server (get ((get (m/workspaces) 1) :terminals) 0)))
  (m/hint-type! (m/label-of (server :id)))
  (check "jump ends hinting" #f (m/hinting?))
  (check "jump switches workspace" "site" ((m/active) :name))
  (check "jump focuses terminal" (server :id) ((m/focused) :id)))
(m/hints-start!)
(m/hint-type! "Z")
(check "no match cancels" #f (m/hinting?))

(m/clear!)
(dotimes (i 20) (m/workspace-new! (str "w" i) '("t" :shell)))
(m/hints-start!)
(m/hint-type! "A")
(check "prefix narrows without jumping" #t (m/hinting?))
(check "matching labels stay visible" "AA" (m/label-of ((get ((get (m/workspaces) 0) :terminals) 0) :id)))
(check "non-matching labels hide" nil (m/label-of ((get ((get (m/workspaces) 17) :terminals) 0) :id)))
(m/hint-type! "S")
(check "second letter jumps" "w1" ((m/active) :name))
(m/clear!)

(report "scratch model")
