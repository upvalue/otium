;; Small widgets for the mock: a clickable box with hover, a dot, hint badges
;; and a placeholder terminal pane.
(ns scratch.widgets)

(require (otium.ui :as ui))
(require (otium.gfx :as gfx))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.native :as native))
(require (scratch.theme :as theme))

(def (inset bounds d)
  (make ui/Bounds
        :x (+ (bounds :x) d)
        :y (+ (bounds :y) d)
        :width (max 0 (- (bounds :width) (* 2 d)))
        :height (max 0 (- (bounds :height) (* 2 d)))))

;; A row or column that responds to presses and paints a hover colour.
(defclass Item
  :is ui/Widget
  (on-press :init nil)
  (column? :init #f)
  (width :init -1)
  (height :init -1)
  (grow :init 0)
  (padding-x :init 0)
  (padding-y :init 0)
  (gap :init 0)
  (align-items :init :center)
  (background :init nil)
  (hover :init nil)
  (border :init nil)
  (radius :init 0))

(def (item opts . children)
  (apply ui/new Item opts children))

(defmethod (ui/layout-style (w Item))
  {:width (w :width)
   :height (w :height)
   :grow (w :grow)
   :padding-x (w :padding-x)
   :padding-y (w :padding-y)
   :gap (w :gap)
   :align-items (w :align-items)
   :row (not (w :column?))})

(defmethod (ui/handle-event (w Item) event)
  (let ((kind (get event :kind)))
    (cond
      ((eq? kind :press)
       (when (w :on-press) ((w :on-press)))
       :handled)
      ((memq kind '(:pointer-down :pointer-up)) (when (w :on-press) :handled))
      (else nil))))

(defmethod (ui/paint (w Item) g bounds)
  (let ((fill (if (and (g :hovered?) (w :hover))
                  (w :hover)
                  (w :background))))
    (cond
      ((w :border)
       (gfx/rect g bounds (w :border) (w :radius))
       (gfx/rect g (inset bounds 1) (or fill theme/background) (max 0 (- (w :radius) 1))))
      (fill (gfx/rect g bounds fill (w :radius)))
      (else nil))))

(defclass Dot
  :is ui/Widget
  (color :init 0xffffffff)
  (size :init 8))

(def (dot color . size)
  (ui/new Dot
          {:color color
           :size (if (null? size)
                     8
                     (car size))}))

(defmethod (ui/layout-style (w Dot))
  {:width (w :size) :height (w :size)})

(defmethod (ui/paint (w Dot) g bounds)
  (gfx/rect g bounds (w :color) (/ (w :size) 2)))

(def (spacer)
  (ui/row {:grow 1}))

(def (text color size string)
  (ui/label {:color color :size size :wrap #f} string))

(def (hint-badge label typed)
  "A Vimium-style label; the typed prefix is dimmed."
  (ui/row {:background theme/hint :radius 3 :padding-x 5 :padding-y 1}
          (unless (equal? typed "")
            (ui/label {:font :mono :size 11 :color theme/hint-typed :wrap #f} typed))
          (ui/label {:font :mono :size 11 :color theme/hint-text :wrap #f}
                    (substring label (string-length typed)))))

;; Placeholder terminal output, so the layout can be judged without PTYs.

(def (prompt command)
  (list (list theme/cyan "~/code/otium/lang ")
        (list theme/purple "main* ")
        (list theme/green "> ")
        (list theme/text command)))

(def samples
  {:shell (list (prompt "git status --short")
                (list (list theme/yellow " M ") (list theme/text "lib/otium/ui.ot"))
                (list (list theme/yellow " M ") (list theme/text "lib/otium/ui/gpu.ot"))
                (list (list theme/green "?? ") (list theme/text "scratch/"))
                (prompt "git log --oneline -3")
                (list (list theme/yellow "c247e0c ") (list theme/text "Set the Manse application icon"))
                (list (list theme/yellow "9030b46 ") (list theme/text "Add core JSON parsing and encoding"))
                (list (list theme/yellow "e20e7b2 ") (list theme/text "Run two independent terminals"))
                (prompt ""))
   :tests (list (prompt "just test ui")
                (list (list theme/muted "1/8 ui calculator c    ") (list theme/green "OK"))
                (list (list theme/muted "2/8 ui editing c       ") (list theme/green "OK"))
                (list (list theme/muted "3/8 ui c               ") (list theme/green "OK"))
                (list (list theme/muted "4/8 ui policy chez     ") (list theme/green "OK"))
                (list (list theme/muted "5/8 ui layout chez     ") (list theme/red "FAIL"))
                (list)
                (list (list theme/text "Ok:   ") (list theme/green "7"))
                (list (list theme/text "Fail: ") (list theme/red "1"))
                (prompt ""))
   :server (list (prompt "python3 -m http.server 8000")
                 (list (list theme/text "Serving HTTP on :: port 8000 ..."))
                 (list (list theme/muted "::1 - - \"GET / HTTP/1.1\" ") (list theme/green "200 -"))
                 (list (list theme/muted "::1 - - \"GET /app.js HTTP/1.1\" ") (list theme/green "200 -"))
                 (list (list theme/muted "::1 - - \"GET /favicon.ico HTTP/1.1\" ") (list theme/red "404 -")))
   :notes (list (prompt "hx notes/manse.md")
                (list (list theme/accent "# Manse"))
                (list)
                (list (list theme/text "- sidebar of workspaces"))
                (list (list theme/text "- horizontal strip of terminals"))
                (list (list theme/text "- jump hints"))
                (list (list theme/faint "~")))})

(def (filler kind i)
  (let ((stamp (str "12:" (+ 10 (modulo (quotient i 60) 50)) ":" (+ 10 (modulo i 50)) " ")))
    (list (list theme/faint stamp)
          (list (get {:server theme/cyan :tests theme/green :notes theme/purple} kind theme/yellow)
                (str (get {:server "GET " :tests "ok  " :notes "-   "} kind "log ")))
          (list theme/text (str "/scratch/item/" (* 7 i) "?page=" i))
          (list theme/muted (str " " (+ 3 (modulo (* 13 i) 97)) "ms")))))

(defonce metrics {})

(def (cell-size scale)
  "Logical cell width and line height of the mono font at this scale."
  (let ((key (list theme/mono-size scale)))
    (or (get metrics key)
        (let ((positions (gpu/caret-positions "MMMMMMMMMM" :mono theme/mono-size scale))
              (run (native/text-get "M" (gfx/font-index :mono) theme/mono-size -1 scale)))
          (put! metrics key (list (/ (get positions 10) 10) (* 1.2 (/ (native/text-size run native/TEXT_HEIGHT) scale))))
          (get metrics key)))))

(defclass Pane
  :is ui/Widget
  (kind :init :shell)
  (focused? :init #f)
  (cache :init (gfx/cache) :state #t))

(def (pane kind focused?)
  (ui/new Pane {:kind kind :focused? focused?}))

(defmethod (ui/layout-style (w Pane))
  {:grow 1})

(defmethod (ui/paint (w Pane) g bounds)
  (gfx/cached g (w :cache) bounds (list (w :kind) (w :focused?)) (fn (g) (paint-pane w g bounds))))

(def (paint-pane w g bounds)
  (let ((cell (cell-size (native/gpu-scale (g :renderer))))
        (cw (car cell))
        (ch (cadr cell))
        (x0 (+ (bounds :x) 10))
        (y (+ (bounds :y) 8))
        (cursor nil))
    (for-each (fn (line)
                (let ((x x0))
                  (for-each (fn (segment)
                              (gfx/text g
                                        (make ui/Bounds :x x :y y :width 100000 :height ch)
                                        (cadr segment)
                                        :mono
                                        theme/mono-size
                                        (car segment)
                                        #f)
                              (set! x (+ x (* cw (string-length (cadr segment))))))
                            line)
                  (set! cursor (list x y))
                  (set! y (+ y ch))))
              (get samples (w :kind) (get samples :shell)))
    ;; Fill the rest like a busy terminal: distinct lines, a few colour runs each.
    (let ((i 0))
      (while (< (+ y ch) (+ (bounds :y) (bounds :height)))
        (let ((x x0))
          (for-each (fn (segment)
                      (gfx/text g
                                (make ui/Bounds :x x :y y :width 100000 :height ch)
                                (cadr segment)
                                :mono
                                theme/mono-size
                                (car segment)
                                #f)
                      (set! x (+ x (* cw (string-length (cadr segment))))))
                    (filler (w :kind) i)))
        (set! y (+ y ch))
        (set! i (+ i 1))))
    (when (and cursor (memq (w :kind) '(:shell :tests)))
      (gfx/rect g
                (make ui/Bounds :x (car cursor) :y (cadr cursor) :width cw :height ch)
                (if (w :focused?)
                    theme/text
                    theme/faint)))))
