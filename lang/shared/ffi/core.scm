(define- (%empty? x) (eq? x '()))
(define null (%null))
(define- (%second x) (car (cdr x)))
(define- (%third x) (car (cdr (cdr x))))
(define- (%fourth x) (car (cdr (cdr (cdr x)))))
(define- (%die op reason message) (%fail op reason message))
(define- (%count op n)
  (if (not (and (integer? n) (exact? n)))
      (%die op "type" "expected exact integer")
      (if (< n 0) (%die op "range" "expected nonnegative integer") n)))
(define- (%mul op a b)
  (if (and (> b 0) (> a (quotient 4611686018427387903 b)))
      (%die op "range" "size overflow") (* a b)))
(define- (%add op a b)
  (if (> a (- 4611686018427387903 b)) (%die op "range" "size overflow") (+ a b)))
(define- (%round n a) (%add "layout" n (modulo (- a (modulo n a)) a)))
(define- (%lookup key entries)
  (if (%empty? entries) #f
      (if (eq? key (car (car entries))) (car entries) (%lookup key (cdr entries)))))
(define- %scalars '(void bool i8 u8 i16 u16 i32 u32 i64 u64 short ushort int uint long ulong size-t ptrdiff-t float double pointer callback-pointer utf8))
(define- (%scalar-id name names index)
  (if (%empty? names) #f
      (if (eq? name (car names)) index (%scalar-id name (cdr names) (+ index 1)))))
(define- (%describe t op)
  (cond
    ((symbol? t)
     (let ((k (%scalar-id t %scalars 0)))
       (if k (list k (if (= k 0) 0 (%sizeof k)) (if (= k 0) 1 (%alignof k)) '())
           (%die op (if (equal? op "bind") "signature" "type") "unknown scalar type"))))
    ((%layout-data t) (%layout-data t))
    ((and (list? t) (= (length t) 3) (eq? (car t) 'array))
     (let ((element (%memory (%second t) op)) (count (%count op (%third t))))
       (list 25 (%mul op (%second element) count) (%third element) (list element count))))
    (else (%die op (if (equal? op "bind") "signature" "type") "invalid foreign type"))))
(define- (%memory t op)
  (let ((d (%describe t op)))
    (if (or (= (car d) 0) (= (car d) 22)) (%die op "type" "not a memory type") d)))
(define (sizeof t) (%second (%memory t "sizeof")))
(define (alignof t) (%third (%memory t "alignof")))
(define (alloc t count)
  (let ((d (%memory t "alloc")))
    (%alloc (%mul "alloc" (%second d) (%count "alloc" count)) (%third d))))
(define- (%scalar-memory t op)
  (let ((d (%memory t op)))
    (if (>= (car d) 23) (%die op "type" "use fields or views for aggregate memory") d)))
(define (ref p t index)
  (let ((d (%scalar-memory t "ref")))
    (%ref p (car d) (%mul "ref" (%second d) (%count "ref" index)))))
(define (set! p t index value)
  (let ((d (%scalar-memory t "set!")))
    (%set! p (car d) (%mul "set!" (%second d) (%count "set!" index)) value)))
(define- (%fields entries kind fields size alignment)
  (if (%empty? entries)
      (list kind (%round size alignment) alignment (reverse fields))
      (let ((f (car entries)))
        (if (not (and (list? f) (= (length f) 2) (symbol? (car f))))
            (%die "layout" "type" "expected (field-name type)")
            (if (%lookup (car f) fields) (%die "layout" "type" "duplicate field")
                (let ((d (%memory (%second f) "layout")))
                  (let ((offset (if (= kind 24) 0 (%round size (%third d)))))
                    (%fields (cdr entries) kind (cons (list (car f) d offset) fields)
                      (max size (%add "layout" offset (%second d)))
                      (max alignment (%third d))))))))))
(define- (%aggregate name fields kind)
  (if (not (and (symbol? name) (list? fields) (pair? fields)))
      (%die "layout" "type" "expected name and nonempty field list")
      (%layout (%fields fields kind '() 0 1))))
(define (define-struct! name fields) (%aggregate name fields 23))
(define (define-union! name fields) (%aggregate name fields 24))
(define- (%path d path offset)
  (if (%empty? path) (list d offset)
      (if (= (car d) 25)
          (let ((index (%count "field" (car path)))
                (element (car (%fourth d))) (count (%second (%fourth d))))
            (if (>= index count) (%die "field" "bounds" "array field index out of bounds")
                (%path element (cdr path) (%add "field" offset (%mul "field" index (%second element))))))
          (if (or (= (car d) 23) (= (car d) 24))
              (let ((f (%lookup (car path) (%fourth d))))
                (if f (%path (%second f) (cdr path) (%add "field" offset (%third f)))
                    (%die "field" "type" "unknown field")))
              (%die "field" "type" "field path descends into scalar")))))
(define- (%resolve t path)
  (if (list? path) (%path (%memory t "field") path 0)
      (%die "field" "type" "expected field path list")))
(define (offset-of t path) (%second (%resolve t path)))
(define (field-view p t path)
  (let ((f (%resolve t path))) (view p (%second f) (%second (car f)))))
(define (field-ref p t path)
  (let ((f (%resolve t path)))
    (if (>= (car (car f)) 23) (%die "field-ref" "type" "field is aggregate")
        (%ref p (car (car f)) (%second f)))))
(define (field-set! p t path value)
  (let ((f (%resolve t path)))
    (if (>= (car (car f)) 23) (%die "field-set!" "type" "field is aggregate")
        (%set! p (car (car f)) (%second f) value))))
(define- (%call-type t result?)
  (let ((d (%describe t "bind")))
    (if (or (= (car d) 25) (and (not result?) (= (car d) 0)))
        (%die "bind" "signature" "invalid call type")
        (if (< (car d) 23) (car d) d))))
(define (bind library name arguments result)
  (if (list? arguments)
      (%bind library name (map (lambda (t) (%call-type t #f)) arguments) (%call-type result #t))
      (%die "bind" "signature" "expected argument type list")))
(define- (%try-open names diagnostics)
  (if (%empty? names) (%die "open-library" "load" diagnostics)
      (let ((lib (%open (car names))))
        (if lib lib (%try-open (cdr names)
          (string-append diagnostics (car names) ": " (%loader-error) "\n"))))))
(define (open-library names)
  (if (and (list? names) (pair? names)) (%try-open names "could not load library:\n")
      (%die "open-library" "type" "expected nonempty list of library names")))
(define (error? c) (eq? (%error-field c "type") 'ffi-error))
(define- (%error-access c field)
  (if (error? c) (%error-field c field)
      (%die "error-accessor" "type" "expected FFI condition")))
(define (error-reason c) (%error-access c "reason"))
(define (error-operation c) (%error-access c "operation"))
(define (error-library c) (%error-access c "library"))
(define (error-symbol c) (%error-access c "symbol"))
(define (error-argument c) (%error-access c "argument"))
(define (error-expected-type c) (%error-access c "expected-type"))
