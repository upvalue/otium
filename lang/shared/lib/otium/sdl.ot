(ns otium.sdl)
(require (otium.ffi :as ffi))

;; Opaque window handles and scalar signatures need no aggregate ABI manifest.
(def INIT_VIDEO 0x20)

(def WINDOW_RESIZABLE 0x20)

(def WINDOW_HIDDEN 0x8)

(def WINDOW_HIGH_PIXEL_DENSITY 0x2000)

(ffi/defbindings library
                 load!
                 (set-hint "SDL_SetHint" (utf8 utf8) bool)
                 (set-app-metadata "SDL_SetAppMetadata" (utf8 utf8 utf8) bool)
                 (load-surface "SDL_LoadSurface" (utf8) pointer)
                 (set-window-icon "SDL_SetWindowIcon" (pointer pointer) bool)
                 (destroy-surface "SDL_DestroySurface" (pointer) void)
                 (raise-window "SDL_RaiseWindow" (pointer) bool)
                 (init "SDL_Init" (u32) bool)
                 (quit "SDL_Quit" () void)
                 (was-init "SDL_WasInit" (u32) u32)
                 (set-main-ready "SDL_SetMainReady" () void)
                 (create-window "SDL_CreateWindow" (utf8 int int u64) pointer)
                 (set-window-size "SDL_SetWindowSize" (pointer int int) bool)
                 (get-window-size "SDL_GetWindowSize" (pointer pointer pointer) bool)
                 (get-window-size-in-pixels "SDL_GetWindowSizeInPixels" (pointer pointer pointer) bool)
                 (get-window-pixel-density "SDL_GetWindowPixelDensity" (pointer) float)
                 (destroy-window "SDL_DestroyWindow" (pointer) void)
                 (delay "SDL_Delay" (u32) void)
                 (pump-events "SDL_PumpEvents" () void)
                 (get-error "SDL_GetError" () utf8))

(def (check value)
  (unless value (error (get-error)))
  value)

(def (pointer value)
  (when (ffi/null? value) (error (get-error)))
  value)
