(ns otium.sdl)
(require (otium.ffi :as ffi))
;; Opaque window handles and scalar signatures need no aggregate ABI manifest.
(defonce library nil)
(def init nil)
(def quit nil)
(def was-init nil)
(def set-main-ready nil)
(def create-window nil)
(def destroy-window nil)
(def pump-events nil)
(def delay nil)
(def get-error nil)
(def (load! path)
  (set! library (ffi/open-library (list path)))
  (set! init (ffi/bind library "SDL_Init" '(u32) 'bool))
  (set! quit (ffi/bind library "SDL_Quit" '() 'void))
  (set! was-init (ffi/bind library "SDL_WasInit" '(u32) 'u32))
  (set! set-main-ready (ffi/bind library "SDL_SetMainReady" '() 'void))
  (set! create-window (ffi/bind library "SDL_CreateWindow" '(utf8 int int u64) 'pointer))
  (set! destroy-window (ffi/bind library "SDL_DestroyWindow" '(pointer) 'void))
  (set! delay (ffi/bind library "SDL_Delay" '(u32) 'void))
  (set! pump-events (ffi/bind library "SDL_PumpEvents" '() 'void))
  (set! get-error (ffi/bind library "SDL_GetError" '() 'utf8)))
(def (check value) (unless value (error (get-error))) value)
(def (pointer value) (when (ffi/null? value) (error (get-error))) value)
