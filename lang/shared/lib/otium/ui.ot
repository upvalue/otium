(ns otium.ui)

;; Shared widget lifecycle. Optional layout and drawing live in otium.ui.gpu.
(defabstract Widget)
(defclass Description properties key children)
(defclass Mounted instance key children (active? :init #t)
  (layout :init nil) (bounds :init nil) (release-layout :init nil))
(defclass Root (children :init []))
(defclass Label :is Widget text)
(defclass Column :is Widget
  (width :init -1) (height :init -1) (grow :init 0)
  (padding :init 0) (gap :init 0) (background :init nil) (radius :init 0))
(defclass Row :is Widget
  (width :init -1) (height :init -1) (grow :init 0)
  (padding :init 0) (gap :init 0) (background :init nil) (radius :init 0))
(defclass Button :is Widget (on-press :init nil))

(defclass Size width height)
(defclass Bounds x y width height)
(def (size width height) (make Size :width width :height height))
(def (width bounds) (bounds :width))
(def (height bounds) (bounds :height))
(defgeneric (layout-style widget))
(defmethod (layout-style (w Widget)) {})
(defmethod (layout-style (w Column))
  {:width (w :width) :height (w :height) :grow (w :grow)
   :padding (w :padding) :gap (w :gap) :row #f})
(defmethod (layout-style (w Row))
  {:width (w :width) :height (w :height) :grow (w :grow)
   :padding (w :padding) :gap (w :gap) :row #t})

(defgeneric (build widget))
(defgeneric (measure widget limits))
(defgeneric (paint widget g bounds))
(defgeneric (handle-event widget event))
(defparam building-children '())
(defmethod (build (w Widget)) (building-children))
(defmethod (measure (w Widget) limits) nil)
(defmethod (paint (w Widget) g bounds) nil)
(defmethod (handle-event (w Widget) event) nil)
(defmethod (handle-event (w Button) event)
  (cond ((eq? (get event :kind) :press)
         (when (w :on-press) ((w :on-press)) :handled))
        ((or (eq? (get event :kind) :pointer-down)
             (eq? (get event :kind) :pointer-up)) :handled)
        (else nil)))

(def (new class opts . children)
  "Construct a widget description without initializing mounted state."
  (unless (class-subtype? class Widget) (error "ui/new: expected widget class"))
  (unless (table? opts) (error "ui/new: expected options table"))
  (let ((args '()))
    (for-each (fn (k)
                (unless (eq? k :key)
                  (set! args (cons k (cons (get opts k) args)))))
              (keys opts))
    (make Description :properties (apply class-properties class args)
          :key (get opts :key) :children children)))

(def (label opts text) (new Label (put opts :text text)))
(def (row opts . children) (apply new Row opts children))
(def (column opts . children) (apply new Column opts children))
(def (button opts . children) (apply new Button opts children))
(def (root) (make Root))
(def (instance node) (node :instance))
(def (children node) (node :children))
(def (active? node) (node :active?))

(def- (description? value)
  (and (instance? value) (eq? (dispatch-type value) Description)))

(def- (flatten input)
  (let ((out []))
    (def (visit value)
      (cond ((or (nil? value) (null? value)) nil)
            ((description? value) (push! out value))
            ((string? value) (push! out (label {} value)))
            ((or (array? value) (list? value)) (for-each visit value))
            (else (error "ui: child must be a description, string, sequence or nil"))))
    (visit input)
    out))

(def- (retire! node)
  (for-each retire! (node :children))
  (when (node :release-layout) ((node :release-layout)))
  (set! (node :release-layout) nil)
  (set! (node :layout) nil)
  (set! (node :bounds) nil)
  (set! (node :children) [])
  (set! (node :active?) #f))

(def- (reconcile-children old input)
  (let ((descriptions (flatten input)) (keyed {}) (seen {}) (kept {}) (out []))
    ;; Validate keys before changing any sibling instances.
    (for-each
      (fn (d)
        (let ((key (d :key)))
          (unless (nil? key)
            (unless (or (keyword? key) (symbol? key) (string? key) (int? key))
              (error "ui: key must be a keyword, symbol, string or integer"))
            (when (get seen key #f) (error "ui: duplicate sibling key" key))
            (put! seen key #t))))
      descriptions)
    (for-each (fn (n) (unless (nil? (n :key)) (put! keyed (n :key) n))) old)
    (dotimes (i (length descriptions))
      (let ((d (get descriptions i)))
        (let ((candidate (if (nil? (d :key))
                             (if (< i (length old)) (get old i) nil)
                             (get keyed (d :key)))))
          (let ((matched? (and (not (nil? candidate))
                               (equal? (candidate :key) (d :key))
                               (eq? (dispatch-type (candidate :instance))
                                    (dispatch-type (d :properties))))))
            (let ((node (if matched? candidate
                            (make Mounted :instance (class-mount (d :properties))
                                  :key (d :key) :children []))))
              (when matched?
                (class-update-properties! (node :instance) (d :properties)))
              (let ((built (with-params ((building-children (d :children)))
                             (build (node :instance)))))
                (set! (node :children) (reconcile-children (node :children) built)))
              (put! kept node #t)
              (push! out node))))))
    (for-each (fn (n) (unless (get kept n #f) (retire! n))) old)
    out))

(def (reconcile! tree descriptions)
  "Update a headless root from fresh descriptions and return it."
  (set! (tree :children) (reconcile-children (tree :children) descriptions))
  tree)

(def (dispose! tree) (reconcile! tree nil))

(def (send! node event)
  "Deliver a synthetic event to an active mounted widget."
  (unless (node :active?) (error "ui/send!: widget was removed"))
  (handle-event (node :instance) event))

(def (inspect node)
  {:instance (node :instance) :key (node :key)
   :active? (node :active?) :bounds (node :bounds) :children (node :children)})
