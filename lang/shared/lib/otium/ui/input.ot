(ns otium.ui.input)
(require (otium.ui :as ui))

(defclass Pointer (captured :init nil))
(def (pointer) (make Pointer))
(def- (contains? bounds x y)
  (and bounds (>= x (bounds :x)) (>= y (bounds :y))
       (< x (+ (bounds :x) (bounds :width)))
       (< y (+ (bounds :y) (bounds :height)))))
(def- (hit-children children x y)
  ;; Last painted sibling wins. Each ancestor bounds the visible hit region.
  (let loop ((i (- (length children) 1)))
    (if (< i 0) '()
        (let ((node (get children i)))
          (if (and (ui/active? node) (contains? (node :bounds) x y))
              (append (hit-children (ui/children node) x y) (list node))
              (loop (- i 1)))))))
(def (hit-path tree x y) (hit-children (ui/children tree) x y))
(def- (bubble! path event)
  (cond ((null? path) nil)
        ((eq? (ui/send! (car path) event) :handled) (car path))
        (else (bubble! (cdr path) event))))
(def- (includes? path node)
  (and (not (null? path))
       (or (eq? (car path) node) (includes? (cdr path) node))))
(def (cancel! pointer)
  (let ((node (pointer :captured)))
    (set! (pointer :captured) nil)
    (when node (set! (node :pressed?) #f))
    (when (and node (ui/active? node))
      (ui/send! node {:kind :pointer-cancel}))))
(def (dispatch! pointer tree event)
  "Route logical-coordinate pointer events through the current laid-out tree."
  (let ((kind (get event :kind)))
    (cond
      ((eq? kind :pointer-cancel) (cancel! pointer))
      ((eq? kind :pointer-down)
       (cancel! pointer)
       (ui/cancel-key! tree)
       (set! (pointer :captured)
         (bubble! (hit-path tree (get event :x) (get event :y)) event))
       (let ((node (pointer :captured)))
         (when node
           (set! (node :pressed?) #t)
           (when (ui/focusable? node) (ui/focus! tree node)))))
      ((eq? kind :pointer-up)
       (let ((node (pointer :captured)))
        (let ((armed? (and node (node :pressed?))))
         (set! (pointer :captured) nil)
         (when node (set! (node :pressed?) #f))
         (when (and node (ui/active? node))
           (ui/send! node event)
           (when (and armed? (ui/enabled? node)
                      (includes? (hit-path tree (get event :x) (get event :y)) node))
             (ui/send! node {:kind :press :x (get event :x) :y (get event :y)}))))))
      (else nil))))

(def (focus-next! tree backwards?)
  (let ((nodes []) (current (ui/focused tree)) (index -1))
    (def (visit node)
      (when (ui/focusable? node)
        (when (eq? node current) (set! index (length nodes)))
        (push! nodes node))
      (for-each visit (ui/children node)))
    (for-each visit (ui/children tree))
    (if (= (length nodes) 0) (ui/focus! tree nil)
        (ui/focus! tree (get nodes
          (modulo (if (< index 0) (if backwards? (- (length nodes) 1) 0)
                      (+ index (if backwards? -1 1))) (length nodes)))))))
(def- (node-path node)
  (if (ui/mounted? node) (cons node (node-path (node :parent))) '()))
(def- (action! path event)
  (if (null? path) nil
      (let ((node (car path)))
        (let ((action (get (get (node :options) :keymap {}) (get event :key)))
              (handler (get (node :options) :on-action)))
          (if (and (ui/enabled? node) action handler
                   (eq? (handler action) :handled)) :handled
              (action! (cdr path) event))))))
(def (keyboard! tree event)
  "Route normalized key strings; actions run on keydown, button activation on keyup."
  (let ((node (ui/focused tree)) (focus (tree :focus))
        (kind (get event :kind)) (key (get event :key)))
    (cond
      ((eq? kind :focus-lost) (ui/focus! tree nil) (ui/cancel-key! tree))
      ((eq? kind :key-up)
       (when (equal? (get event :code key) (focus :key))
         (let ((armed (focus :armed)))
           (ui/cancel-key! tree)
           (when (and armed (eq? armed node) (ui/focusable? armed))
             (ui/send! armed {:kind :press})))))
      ((and (eq? kind :key-down) (not (get event :repeat #f)))
       (cond
         ((or (equal? key "Tab") (equal? key "Shift+Tab"))
          (focus-next! tree (equal? key "Shift+Tab")))
         ((and node (or (equal? key "Return") (equal? key "Space"))
               (class-subtype? (dispatch-type (ui/instance node)) ui/Button))
          (unless (focus :armed)
            (set! (focus :armed) node) (set! (focus :key) (get event :code key))
            (set! (node :pressed?) #t)))
         (else
           (let ((path (if node (node-path node) (array-to-list (ui/children tree)))))
             (unless (eq? (action! path event) :handled) (bubble! path event))))))
      (else nil))))
