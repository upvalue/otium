(define test-nil #f)
(define (test-table type message)
  (let ((c (make-eq-hashtable)))
    (hashtable-set! c ':type type)
    (hashtable-set! c ':message message)
    c))
(define (test-data c) (hashtable-ref c ':data #f))
(define test-length vector-length)
(define test-ref vector-ref)
(define (test-print n) (display "condition checks: ") (display n) (newline))
