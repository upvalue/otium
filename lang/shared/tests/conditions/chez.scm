(def test-nil #f)
(def (test-table type message)
  (let ((c (make-eq-hashtable)))
    (hashtable-set! c (string->symbol ":type") type)
    (hashtable-set! c (string->symbol ":message") message)
    c))
(def (test-data c) (hashtable-ref c (string->symbol ":data") #f))
(def test-length vector-length)
(def test-ref vector-ref)
(def (test-print n) (display "condition checks: ") (display n) (newline))
