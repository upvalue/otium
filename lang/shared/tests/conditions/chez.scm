(require chez)
(def test-nil #f)
(def (test-table type message)
  (let ((c (chez/make-eq-hashtable)))
    (chez/hashtable-set! c (string->symbol ":type") type)
    (chez/hashtable-set! c (string->symbol ":message") message)
    c))
(def (test-data c) (chez/hashtable-ref c (string->symbol ":data") #f))
(def test-length chez/vector-length)
(def test-ref chez/vector-ref)
(def (test-print n) (display "condition checks: ") (display n) (newline))
