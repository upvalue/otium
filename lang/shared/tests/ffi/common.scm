(define (check-union layout function-name field scalar before delta after)
  (let ((f (ffi/bind lib function-name (list layout scalar) layout))
        (input (ffi/alloc layout 1)))
    (ffi/field-set! input layout field before)
    (let ((output (f input delta)))
      (check after (ffi/field-ref output layout field))
      (check before (ffi/field-ref input layout field))
      (ffi/free! input)
      (test-collect)
      (check after (ffi/field-ref output layout field))
      (ffi/free! output))))
