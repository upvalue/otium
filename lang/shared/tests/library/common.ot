(def checks 0)

(def (check expected actual)
  (unless (equal? expected actual) (error "library mismatch" expected actual))
  (set! checks (+ checks 1)))

(def (fails? thunk)
  (try
    (thunk)
    #f
    (catch ((fn (c) #t) c) #t)))

(check "ab" (substring "ab" -5 9))
(check "" (substring "ab" 9))
(check "" (substring "ab" 1 0))
(check "é🙂" (substring "aé🙂z" 1 3))
(check #t (nil? (string->number "nope")))
(check 42 (string->number " 42\n"))
(check "a1:k" (str "a" 1 :k))

(def b (buffer "é"))

(check "é" (buffer->string b))
(check "é" (buffer->string b))
(buffer-push! b "🙂" 7)
(check 3 (length b))
(check "é🙂7" (buffer->string b))
(check '("a" "b" "c") (array-to-list (string-split "  a\tb\nc ")))
(check '("a" "" "b" "") (array-to-list (string-split "a,,b," ",")))
(check #t (fails? (fn () (string-split "a" ""))))
(check "1:2:3" (string-join ":" [1 2 3]))
(check "" (string-join ":" nil))
(check "é" (string-trim " \té\n"))
(check "aXaX" (string-replace "abab" "b" "X"))
(check #t (string-contains? "a🙂b" "🙂"))
(check #t (string-starts-with? "abc" "ab"))
(check #t (string-ends-with? "abc" "bc"))
(check 7 ({:a 7} :a))
(check 8 ({:a 7} :missing 8))
(check 7 (:a {:a 7}))
(check 8 (:a nil 8))
(check 8 (:a 42 8))
(check 4 ([3 4] 1))
(check 9 ([3 4] 9 9))
(check #t (fails? (fn () ([3] "0"))))
(check 7 (apply {:a 7} [:a]))
(check '(2 3) (array-to-list (map inc [1 2])))
(check '(1 2) (array-to-list (map :a [{:a 1} {:a 2}])))
(check #t (fails? (fn () (map + '(1) '(2)))))
(check '(2 4) (array-to-list (filter even? [1 2 3 4])))
(check 10 (reduce + 0 [1 2 3 4]))
(check '(0 1 2) (array-to-list (range 3)))
(check '(2 3) (array-to-list (drop 1 [1 2 3])))
(check '(1 2) (array-to-list (take 2 [1 2 3])))
(check '(1 2 3) (array-to-list (sort [3 1 2])))
(check #f (exists (fn (a b) #f) '(1) '(2 3)))
(check 3 (fold-left + 0 '(1) '(2 3)))
(check 3 (fold-right + 0 '(1) '(2 3)))
(check #t (nil? (for-all (fn (a b) nil) '(1) '(2 3))))
(check '(a . 1) (assoc 'a '((a . 1) (b . 2))))

(def t {:a 1})

(check 2 (get (put t :b 2) :b))
(check 1 (length t))
(check 3 (get (update t :a + 2) :a))
(check 0 (length (dissoc t :a)))

(def times 0)

(def visits [])

(dotimes (i (begin
              (set! times (+ times 1))
              3))
  (push! visits i))
(check 1 times)
(check '(0 1 2) (array-to-list visits))
(check #t (nil? (condition-message 7)))
(check #t (nil? (signal "declined")))
(check #t (nil? (find-restart 'absent)))
(check #t (array? (compute-restarts)))
(try
  (error "oops" 1 2)
  (catch (error? c)
    (check #t (table? c))
    (check 'error (get c :type))
    (check '(1 2) (array-to-list (get c :data)))))
(check #t (int? (current-jiffy)))
(check 1000000000 (jiffies-per-second))
(let ((before (current-jiffy))
      (after (current-jiffy)))
  (check #t (<= before after)))
(check #t (> (current-second) 0))
(require otium.extra :as extra)
(check 12 (extra/-> 5 (+ 1) (* 2)))
(check 6 ((extra/partial + 1 2) 3))
(check 3 ((extra/comp inc inc) 1))
(check 2 (get (extra/frequencies [:a :a :b]) :a))
(check '(1 3) (array-to-list (get (extra/group-by odd? [1 2 3]) #t)))
(println "library checks:" checks)
