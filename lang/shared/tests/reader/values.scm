(define checks 0)
(define (check expected actual)
  (if (equal? expected actual) (set! checks (+ checks 1))
      (error "reader check failed" expected actual)))
(define (fails? thunk) (try (begin (thunk) #f) (catch (error? c) #t)))
(check #t (array? [1 2]))
(check #t (table? {:a 1}))
(check #t (keyword? :a))
(check #f (symbol? :a))
(check #t (eq? :a (read-string ":a")))
(check #t (nil? nil))
(check #f (eq? nil #f))
(check #f (eq? nil '()))
(check :nil (type nil))
(check :keyword (type :a))
(check 2 (if nil 1 2))
(check #t (not nil))
(check 1 (if '() 1 2))
(check 1 (if 0 1 2))
(check 1 (if [] 1 2))
(check 1 (if {} 1 2))
(define count 0)
(check nil (and (begin (set! count (+ count 1)) nil) (set! count 99)))
(check 1 count)
(check 4 (or nil (begin (set! count (+ count 1)) 4) (set! count 99)))
(check 2 count)
(check nil (or #f nil))
(check #f (and #f nil))
(check 5 (cond (nil 99) ((begin (set! count (+ count 1)) 5) 5)))
(check 3 count)
(when nil (set! count 99))
(unless nil (set! count (+ count 1)))
(check 4 count)
(check '() (filter (lambda (x) nil) '(1 2 3)))
(define a [])
(define alias a)
(define (grow n) (if (= n 100) nil (begin (push! a n) (grow (+ n 1)))))
(grow 0)
(check #t (eq? a alias))
(check 100 (length a))
(check 99 (pop! a))
(check 99 (length a))
(check nil (get a 99))
(check nil (get a -1))
(check nil (get a 1.0))
(check 42 (get a 999 42))
(check #t (eq? a (put! a 0 :changed)))
(check :changed (get alias 0))
(check 97 (length (drop 2 a)))
(check #t (fails? (lambda () (put! a 999 1))))
(check #t (fails? (lambda () (table :odd))))
(define t {:first 1 :second 2})
(put! t :first nil)
(check nil (get t :first))
(put! t :first 3)
(check :second (get (keys t) 0))
(check :first (get (keys t) 1))
(check 2 (get (values t) 0))
(define identity-key [])
(put! t identity-key 4)
(check 4 (get t identity-key))
(check nil (get t []))
(put! t 1 :int 1.0 :float)
(check :int (get t 1))
(check :float (get t 1.0))
(define pair-key (list :x 2))
(put! t pair-key 9)
(check 9 (get t (list :x 2)))
(check #t (fails? (lambda () (set-car! pair-key :y))))
(check #t (fails? (lambda () (set-cdr! (cdr pair-key) '()))))
(check "λ" (get "aλb" 1))
(check 3 (length "aλb"))
(defmacro reader-values (x y) (list 'quote (list x y)))
(check '(:a nil) (reader-values :a nil))
(defmacro literal-array (x) x)
(check 3 (get (literal-array [3]) 0))
(check '(array :a nil) '[ :a nil ])
(check '(table :a 1 :b 2) '{:a 1 :b 2})
(check 0 (length (filter (lambda (x) nil) [1 2])))
(check 2 (get (filter (lambda (x) (= x 2)) [1 2 3]) 0))
(check 6 (apply + [1 2 3]))
(check 10 (apply + 4 [1 2 3]))
(check :first (get (keys (copy t)) 1))
(check #t (fails? (lambda () (drop 1.5 a))))
(check 7 (try (error 'test)
           (catch ((lambda (c) nil) c) 99)
           (catch ((lambda (c) #t) c) 7)))
(define handled 0)
(handler-bind (((lambda (c) nil) (lambda (c) (set! handled 99))))
  (signal 'test))
(check 0 handled)
(println "reader values passed")
