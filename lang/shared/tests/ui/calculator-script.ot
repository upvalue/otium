(ns ui.calculator-script)
(require (otium.ui :as ui))
(require (otium.ui.input :as input))
(require (ui.calculator :as calculator))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))
(def (window-id)
  (let ((count (ffi/alloc 'int 1)) (result 0)
        (windows ffi/null)
        (get-windows (ffi/bind sdl/library "SDL_GetWindows" '(pointer) 'pointer))
        (get-title (ffi/bind sdl/library "SDL_GetWindowTitle" '(pointer) 'utf8))
        (get-id (ffi/bind sdl/library "SDL_GetWindowID" '(pointer) 'u32))
        (free (ffi/bind sdl/library "SDL_free" '(pointer) 'void)))
    (unwind-protect
      (begin
        (set! windows (get-windows count))
        (dotimes (i (ffi/ref count 'int 0))
          (let ((window (ffi/ref windows 'pointer i)))
            (when (equal? (get-title window) "Otium UI") (set! result (get-id window)))))
        (when (= result 0) (error "Calculator test window missing"))
        result)
      (begin (free windows) (ffi/free! count)))))
(def (push-key! code down?)
  ;; SDL3 keyboard event: type at 0, window ID at 16, keycode at 28.
  (let ((event (ffi/alloc 'u64 16))
        (scancode (ffi/bind sdl/library "SDL_GetScancodeFromKey" '(u32 pointer) 'int))
        (push (ffi/bind sdl/library "SDL_PushEvent" '(pointer) 'bool)))
    (unwind-protect
      (begin
        (dotimes (i 16) (ffi/set! event 'u64 i 0))
        (ffi/set! event 'u32 0 (if down? 768 769))
        (ffi/set! event 'u32 4 (window-id))
        (ffi/set! event 'u32 6 (scancode code ffi/null))
        (ffi/set! event 'u32 7 code)
        (when (and (= code 32) (not down?)) (ffi/set! event 'u16 16 1))
        (ffi/set! event 'u8 36 (if down? 1 0))
        (sdl/check (push event)))
      (ffi/free! event))))
(def (step! tree frame)
  (when (= frame 0)
    (calculator/reset!)
    (for-each (fn (code) (push-key! code #t) (push-key! code #f)) '(49 50 43 51 61)))
  (when (= frame 1)
    (unless (= (get calculator/model :value) 15) (error "Native calculator keys failed" calculator/model))
    (push-key! 9 #t)
    (push-key! 9 #f)
    (push-key! 32 #t))
  (when (= frame 2)
    (unless ((ui/focused tree) :pressed?) (error "Focused button was not pressed"))
    (push-key! 32 #f))
  (when (= frame 3)
    (when ((ui/focused tree) :pressed?) (error "Modified keyup did not release button"))
    (unless (= (get calculator/model :value) 7) (error "Button keyup failed"))
    (input/keyboard! tree {:kind :key-down :key "Space"})
    (println "UI-CALCULATOR native keys and widgets passed")))
