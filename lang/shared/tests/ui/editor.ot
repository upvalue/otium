(ns ui.editor)
(require (otium.ui :as ui))
(require (otium.ui.input :as input))

(defonce value "café λ / a long editable line that must keep its cursor visible")

(def pointer (input/pointer))

(def (view)
  (ui/column {:padding 20 :gap 12}
             (ui/label {} "Text field")
             (ui/text-field {:width 220 :autofocus #t :value value :on-change (fn (text) (set! value text))})))

(def (step! tree frame context)
  (let ((node (ui/focused tree)))
    (let ((field (ui/instance node)))
      (when (= frame 1)
        (unless (> (field :offset) 0) (error "Long input did not follow caret"))
        (input/keyboard! tree {:kind :key-down :key "Home"}))
      (when (= frame 2)
        (unless (= (field :offset) 0) (error "Home did not reveal beginning"))
        (let ((x (+ ((node :bounds) :x) 10))
              (y (+ ((node :bounds) :y) 15)))
          (input/dispatch! pointer tree {:kind :pointer-down :x x :y y})
          (input/dispatch! pointer tree {:kind :pointer-drag :x (+ x (get (field :positions) 4)) :y y})
          (input/dispatch! pointer tree {:kind :pointer-up :x (+ x (get (field :positions) 4)) :y y})))
      (when (= frame 3)
        (unless (equal? (ui/selection field) "café") (error "Pointer selection lost Unicode boundary"))
        (println "UI-EDITOR horizontal scrolling and pointer selection passed")))))
