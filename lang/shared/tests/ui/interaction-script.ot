(ns ui.interaction-script)
(require (otium.ui :as ui))
(require (otium.ffi :as ffi))
(require (otium.gfx :as gfx))
(require (ui.interaction :as scene))
(def saved-node nil)
(def saved-layout nil)
(def (tile-node tree) (first (ui/children (first (ui/children tree)))))
(def (step! tree frame context)
  (when (= frame 1)
    (set! saved-node (tile-node tree))
    (set! saved-layout (saved-node :layout))
    (ui/send! saved-node {:kind :press}))
  (when (= frame 2)
    (unless (and (eq? saved-node (tile-node tree))
                 (ffi/pointer=? saved-layout ((tile-node tree) :layout))
                 ((ui/instance (tile-node tree)) :selected))
      (error "Scripted input lost widget or native layout state"))
    (eval '(require ui.interaction-reload :reload))
    (println "UI-RELOAD retained")))
