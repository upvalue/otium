(require (otium.ui :as ui))
(require (otium.ui.input :as input))

(def checks 0)

(def (check label expected actual)
  (unless (equal? expected actual) (error label expected actual))
  (set! checks (+ checks 1)))

(defclass CustomControl
  :is ui/Widget
  (text? :init #t)
  (activate? :init #t)
  (events :init [] :state #t))

(defmethod (ui/default-focusable? (w CustomControl))
  #t)

(defmethod (ui/accepts-text? (w CustomControl))
  (w :text?))

(defmethod (ui/repeat-key? (w CustomControl) event)
  (if (member (get event :key) '("Right" "K"))
      #t
      #f))

(defmethod (ui/activation-key? (w CustomControl) event)
  (and (w :activate?) (equal? (get event :key) "F2")))

(defmethod (ui/handle-event (w CustomControl) event)
  (push! (w :events) (get event :kind))
  :handled)

(def tree (ui/root))

(def actions 0)

(def (view opts)
  (ui/new CustomControl
          (merge {:key :control
                  :autofocus #t
                  :keymap {"Right" :advance}
                  :on-action (fn (action)
                               (set! actions (+ actions 1))
                               :handled)}
                 opts)))

(ui/reconcile! tree (view {}))

(def node (first (ui/children tree)))

(def widget (ui/instance node))

(check "custom default focus" node (ui/focused tree))
(input/keyboard! tree {:kind :text-input :text "λ"})
(check "custom text input" :text-input (get (widget :events) 0))
(input/keyboard! tree {:kind :key-down :key "Right" :repeat #t})
(check "custom repeat routes named action" 1 actions)
(input/keyboard! tree {:kind :key-down :key "K" :repeat #t})
(check "custom repeat reaches event method" :key-down (get (widget :events) 1))
(input/keyboard! tree {:kind :key-down :key "X" :repeat #t})
(check "custom policy rejects other repeats" 2 (length (widget :events)))
(input/keyboard! tree {:kind :key-down :key "F2" :code 59})
(check "custom activation arms pressed state" #t (node :pressed?))
(input/keyboard! tree {:kind :key-down :key "F2" :code 59 :repeat #t})
(check "activation repeat does not dispatch" 2 (length (widget :events)))
(input/keyboard! tree {:kind :key-up :key "Shift+F2" :code 59})
(check "custom activation dispatches press" :press (get (widget :events) 2))
(input/keyboard! tree {:kind :key-up :key "F2" :code 59})
(check "custom activation only once" 3 (length (widget :events)))
(input/keyboard! tree {:kind :key-down :key "F2" :code 59})
(ui/reconcile! tree (view {:activate? #f :text? #f}))
(check "policy change cancels armed key" #f (node :pressed?))
(input/keyboard! tree {:kind :key-up :key "F2" :code 59})
(input/keyboard! tree {:kind :text-input :text "ignored"})
(check "updated policies suppress activation and text" 3 (length (widget :events)))
(check "policy change preserves focus" node (ui/focused tree))
(ui/reconcile! tree (view {:focusable #f}))
(check "explicit focus option overrides default" nil (ui/focused tree))
(ui/reconcile! tree (view {}))
(ui/focus! tree node)

(defmethod (ui/activation-key? (w CustomControl) event)
  #f)

(input/keyboard! tree {:kind :key-down :key "F2"})
(check "reloaded policy changes routing" :key-down (get (widget :events) 3))
(check "reloaded policy preserves instance" widget (ui/instance node))
(ui/reconcile! tree (view {:disabled #t}))
(check "disabled custom widget clears focus" nil (ui/focused tree))
(input/keyboard! tree {:kind :text-input :text "ignored"})
(check "disabled custom input ignored" 4 (length (widget :events)))
(ui/dispose! tree)
(check "ordinary labels reject default focus" #f (ui/default-focusable? (make ui/Label :text "label")))
(check "buttons reject text input" #f (ui/accepts-text? (make ui/Button)))
(println "UI input policy checks:" checks)
