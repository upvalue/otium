(ns ui.policy-scene)
(require (otium.ui :as ui))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))
(require (ui.events :as events))
(def editing #t)
(defclass CustomEntry :is ui/Widget editing (value :init "Waiting" :state #t))
(defmethod (ui/default-focusable? (w CustomEntry)) #t)
(defmethod (ui/accepts-text? (w CustomEntry)) (w :editing))
(defmethod (ui/build (w CustomEntry)) (ui/label {} (w :value)))
(defmethod (ui/handle-event (w CustomEntry) event)
  (when (eq? (get event :kind) :text-input) (set! (w :value) (get event :text)) :handled))
(def (view) (ui/new CustomEntry {:key :custom :autofocus #t :editing editing}))
(def (step! tree frame context)
  (let ((active? (ffi/bind sdl/library "SDL_TextInputActive" '(pointer) 'bool)))
    (when (= frame 0)
      (unless (active? (get context :window)) (error "Custom widget did not start native text input"))
      (events/text! context "custom λ"))
    (when (= frame 1)
      (unless (equal? ((ui/instance (ui/focused tree)) :value) "custom λ")
        (error "Custom widget did not receive native text"))
      (set! editing #f))
    (when (= frame 2)
      (when (active? (get context :window)) (error "Changed custom policy did not stop native text input"))
      (events/text! context "ignored"))
    (when (= frame 3)
      (unless (equal? ((ui/instance (ui/focused tree)) :value) "custom λ")
        (error "Custom widget received text after opting out"))
      (println "UI-POLICY custom native text policy passed"))))
