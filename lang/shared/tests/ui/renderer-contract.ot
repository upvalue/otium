(ns ui.renderer-contract)
(require (otium.ui.native :as native))
(require (otium.sdl :as sdl))
(require (ui.events :as events))

(def (step! tree frame context)
  (let ((renderer (get context :renderer)))
    (native/gpu-clear renderer 0x67d9c0ff)
    (if (native/gpu-offscreen? renderer)
        (begin
          (sdl/check (native/gpu-resize renderer 5000 32 1))
          (when (native/gpu-resize renderer 2147483647 32 4)
            (error "Unrepresentable texture dimensions accepted"))
          (when (native/gpu-resize renderer 0 32 1)
            (error "Zero dimensions accepted"))
          (sdl/check (native/gpu-frame renderer "shared/build/ui-test-artifacts/large-target.bmp"))
          (sdl/check (native/gpu-resize renderer 640 480 1)))
        (begin
          (sdl/check (native/gpu-frame renderer "shared/build/ui-test-artifacts/direct-capture.bmp"))
          (events/visible! context #f)
          (sdl/check (native/gpu-frame renderer ""))
          (events/visible! context #t)
          (sdl/check (native/gpu-frame renderer ""))))
    (println "UI-RENDERER target contract passed")
    (events/quit!)))
