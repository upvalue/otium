(ns ui.terminal-script)
(require (otium.ui :as ui))
(require (otium.ui.input :as input))
(require (ui.terminal :as terminal))
(require (ui.events :as events))
(def previous-offset 0)
(def (step! tree frame context)
  (let ((field (ui/instance (ui/focused tree)))
        (scroll (ui/instance (get (ui/children (first (ui/children tree))) 1))))
    (when (= frame 0)
      (events/text! context "echo café λ")
      (events/key! context "Return" #t) (events/key! context "Return" #f)
      (events/text! context "draft"))
    (when (= frame 1)
      (unless (equal? (field :value) "draft") (error "Text after submit reused stale value"))
      (unless (equal? (get (get terminal/model :history) 0) "echo café λ")
        (error "Native Unicode text input failed"))
      (events/key! context "Up" #t)
      (events/key! context "Down" #t)
      (dotimes (i 30) (terminal/emit! (str "output line " i))))
    (when (= frame 2)
      (unless (equal? (field :value) "draft") (error "Native history did not restore draft"))
      (unless (and (> (scroll :limit) 0) (= (scroll :offset) (scroll :limit)))
        (error "Scrollback did not follow output"))
      (events/wheel! context 60.0 150.0 2.0))
    (when (= frame 3)
      (unless (< (scroll :offset) (scroll :limit)) (error "Native wheel did not scroll"))
      (set! previous-offset (scroll :offset))
      (terminal/emit! "Output while scrolled up")
      (input/keyboard! tree {:kind :key-down :key "Home"})
      (dotimes (i 3) (input/keyboard! tree {:kind :key-down :key "Shift+Right"})))
    (when (= frame 4)
      (unless (= previous-offset (scroll :offset)) (error "New output moved scrollback while browsing"))
      (unless (equal? (ui/selection field) "dra") (error "Selection did not survive rebuilding"))
      (println "UI-TERMINAL native text, history, wheel and selection passed"))))
