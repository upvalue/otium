---
// ✨ Render the curated Markdown files with Astro's native Markdown support.
import Layout from '../layouts/Documentation.astro';
import Playground from '../components/Playground.astro';
import { navigation, repository } from '../../navigation.mjs';

export function getStaticPaths() {
  const docs = import.meta.glob('../../../docs/*.md', { eager: true });
  const generated = import.meta.glob('../../.generated/reference.md', { eager: true });
  return navigation.map(([slug]) => {
    const document = slug === 'reference'
      ? generated['../../.generated/reference.md']
      : docs[`../../../docs/${slug}.md`];
    if (!document) throw new Error(`Missing Markdown for ${slug}`);
    return { params: { page: slug === 'index' ? undefined : slug }, props: { slug, document } };
  });
}

const { slug, document } = Astro.props;
const { Content } = document;
const headings = document.getHeadings();
const title = headings.find((heading) => heading.depth === 1)?.text ?? slug;
const source = slug === 'reference' ? './reference.md' : `${repository}docs/${slug}.md`;
---
<Layout {title} {slug} {headings} {source}>
  <Content />
  {slug === 'playground' && <Playground />}
</Layout>
