;; Writes a marker, then spins until interrupted. SIGINT must pass handlers
;; and catch clauses but run cleanup, which prints 9.
;; Run with --load tests/conditions/support.ot.
(def (spin)
  (spin))

(def (doubled text times)
  (if (= times 0)
      text
      (doubled (string-append text text) (- times 1))))

(handler-bind (((fn (c) #t) (fn (c) (test-print 999))))
  (try
    (unwind-protect
      (begin
        (display (doubled "x" 15))
        (spin))
      (test-print 9))
    (catch c (test-print 998))))
