(require otium.test :refer (check fails? report))

(check :bytevector (type #u8(0 255)))
(check #t (bytevector? #u8()))
(check #f (bytevector? [1]))
(check "#u8(1 3)" (str #u8(1 (+ 1 2))))
(check '(bytevector 1) (read-string "#u8(1)"))

(def (fresh)
  #u8(1 2 3))

(def b (fresh))

(check #f (eq? b (fresh)))
(check #f (equal? b (fresh)))
(check #t (equal? b b))
(check #f (equal? (list b) (list (fresh))))
(check 3 (length b))
(check 3 (count b))
(check 2 (get b 1))
(check nil (get b -1))
(check :missing (get b 3 :missing))
(check nil (get b 1.5))
(check nil (bytevector-u8-set! b 0 9))
(check 9 (bytevector-u8-ref b 0))
(check #t (eq? b (put! b 1 8 2 7)))
(check "#u8(9 8 7)" (str b))
(check "#u8(1 2 3)" (str (fresh)))

(def t (table b :found))

(put! b 0 6)
(check :found (get t b))
(check nil (get t #u8(6 8 7)))
(check "#u8(0 0 0)" (str (make-bytevector 3)))
(check "#u8(255 255)" (str (make-bytevector 2 255)))
(check "#u8()" (str (bytevector-append)))
(check "#u8(1 2 3)" (str (bytevector-append #u8(1) #u8() #u8(2 3))))
(check "#u8(8 7)" (str (bytevector-copy b 1)))
(check "#u8()" (str (bytevector-copy b 2 2)))
(check #f (eq? b (bytevector-copy b)))

(def overlap #u8(0 1 2 3 4))

(check nil (bytevector-copy! overlap 1 overlap 0 4))
(check "#u8(0 0 1 2 3)" (str overlap))
(bytevector-copy! overlap 0 overlap 1 5)
(check "#u8(0 1 2 3 3)" (str overlap))
(check "aé🙂\0" (utf8->string (string->utf8 "aé🙂\0")))
(check "#u8(195 169)" (str (string->utf8 "aé🙂" 1 2)))
(check "é" (utf8->string #u8(0 195 169 0) 1 3))
(check "" (utf8->string #u8()))
(check "#u8()" (str (string->utf8 "")))
(for-each (fn (bytes)
            (check 'decode-error
                   (try
                     (utf8->string bytes)
                     (catch (error? e) (get e :type)))))
          (list #u8(128)
                #u8(192 128)
                #u8(194)
                #u8(224 128 128)
                #u8(237 160 128)
                #u8(240 128 128 128)
                #u8(244 144 128 128)
                #u8(245 128 128 128)
                #u8(255)
                #u8(226 40 161)))
(check 2
       (try
         (utf8->string #u8(0 65 255) 1)
         (catch (error? e) (get e :position))))
(for-each (fn (f) (check #t (fails? f)))
          (list (fn () (bytevector -1))
                (fn () (bytevector 256))
                (fn () (bytevector 1.0))
                (fn () (make-bytevector -1))
                (fn () (make-bytevector 1 -1))
                (fn () (bytevector-u8-ref b 3))
                (fn () (bytevector-u8-set! b 0 256))
                (fn () (put! b -1 0))
                (fn () (bytevector-copy b 2 1))
                (fn () (bytevector-copy b 0 3 4))
                (fn () (bytevector-copy! b 2 b))
                (fn () (bytevector-append b "x"))
                (fn () (string->utf8 "x" 2))
                (fn () (utf8->string b 0 4))))

(defgeneric (byte-kind value))

(defmethod (byte-kind (value Bytevector))
  :bytes)

(check :bytes (byte-kind b))
(report "library bytevectors")
