(require otium.test :refer (check fails? report))

(def p (open-input-string "é🙂\nlast"))

(check :port (type p))
(check #t (port? p))
(check #t (input-port? p))
(check #f (output-port? p))
(check #t (input-port-open? p))
(check #\é (peek-char p))
(check 195 (peek-u8 p))
(check 195 (read-u8 p))
(check 169 (read-u8 p))
(check "🙂" (read-line p))
(check "last" (read-all p))
(check "" (read-all p))
(check #t (eof-object? (read-char p)))
(check "" (read-string 0 p))
(check "#u8()" (str (read-bytevector 0 p)))
(check 0 (read-bytevector! #u8() p))
(close-input-port p)
(close-input-port p)
(check #f (input-port-open? p))
(check :closed (try
                 (peek-u8 p)
                 (catch (error? e) (get e :reason))))
(check #t (fails? (fn () (close-output-port p))))
(check #f (port? nil))
(check #f (input-port-open? nil))

(def out (open-output-string))

(write-string "hello" out)
(check "hello" (get-output-string out))
(check "hello" (get-output-string out))
(write-char #\é out)
(write-string "abc" out 1 2)
(check "helloéb" (get-output-string out))
(close out nil)
(check '(a b) (read-string "(a b)"))
(check "é" (read-string 1 (open-input-string "é🙂")))
(check "a" (read-string 8 (open-input-string "a")))
(check "" (read-string 0 (open-input-string "a")))
(check #t (eof-object? (read-string 2 (open-input-string ""))))
(check #t (fails? (fn () (read-string -1))))
(check #t (fails? (fn () (read-string "x" p))))

(def bytes (open-output-bytevector))

(write-u8 255 bytes)
(write-bytevector #u8(0 1 2 3) bytes 1 3)
(check "#u8(255 1 2)" (str (get-output-bytevector bytes)))
(check "#u8(255 1 2)" (str (get-output-bytevector bytes)))
(check #t (fails? (fn () (write-u8 256 bytes))))
(check #t (fails? (fn () (write-bytevector #u8(0) bytes 1 0))))
(check #t (fails? (fn () (read-u8 bytes))))
(close-port bytes)

(def inp (open-input-bytevector #u8(0 1 2 255)))

(def target (make-bytevector 6 9))

(check 4 (read-bytevector! target inp 1 6))
(check "#u8(9 0 1 2 255 9)" (str target))
(check #t (eof-object? (read-bytevector! target inp)))
(check "#u8(0 1)" (str (read-bytevector 8 (open-input-bytevector #u8(0 1)))))

(def scan (open-input-string "  123,é🙂!"))

(check 2 (skip-while " " scan))
(check "123" (read-while "0123456789" scan))
(check #\, (peek-char scan))
(read-char scan)
(check "é" (read-until "🙂" scan))
(check "🙂" (read-while "🙂" scan))
(check "" (read-until "!" scan))
(check "!" (read-all scan))
(check "" (read-until "!" scan))
(check 0 (skip-while "x" scan))

(def lines (open-input-string "a\r\nb\n\nlast"))

(check "a" (read-line lines))
(check "b" (read-line lines))
(check "" (read-line lines))
(check "last" (read-line lines))
(check #t (eof-object? (read-line lines)))

(def datums (open-input-string "; leading\n(a #\\) \"x\") #u8(1 (+ 1 2)) :tail"))

(check '(a #\) "x") (read datums))
(check '(bytevector 1 (+ 1 2)) (read datums))
(check :tail (read datums))
(check #t (eof-object? (read datums)))
(for-each (fn (bad)
            (let ((p (open-input-bytevector bad)))
              (check 'decode-error
                     (try
                       (read-char p)
                       (catch (error? e) (get e :type))))
              (check 0
                     (try
                       (read-char p)
                       (catch (error? e) (get e :position))))))
          (list #u8(128) #u8(192 128) #u8(194) #u8(237 160 128) #u8(244 144 128 128)))

(report "library ports")
