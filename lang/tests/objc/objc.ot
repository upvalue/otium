;; ./otium tests/objc/objc.ot (macOS)
(require (otium.objc :as objc))
(require (otium.ffi :as ffi))
(require otium.test :refer (check report fails?))

(when (objc/available?)
  (let ((text (objc/nsstring "Manse ✓")))
    (check "string round trip" "Manse ✓" (objc/nsstring-text text))
    (check "integer result" 7 (objc/send-as 'ulong text "length"))
    (check "string argument and bool result" #t (objc/send-as 'bool text "hasPrefix:" (objc/nsstring "Man")))
    (check "integer argument" "M" (objc/nsstring-text (objc/send text "substringToIndex:" 1))))
  (let ((number (objc/send (objc/class "NSNumber") "numberWithDouble:" 2.5)))
    (check "float argument and result" 2.5 (objc/send-as 'double number "doubleValue")))
  (check "selectors are interned" #t (ffi/pointer=? (objc/selector "length") (objc/selector "length")))
  (check "unknown class" #t (fails? (fn () (objc/class "NoSuchClassAnywhere"))))
  (check "other values are rejected" #t (fails? (fn () (objc/send (objc/nsstring "x") "isEqual:" {}))))
  (let ((info (objc/send (objc/class "NSProcessInfo") "processInfo")))
    (objc/send-as 'void info "setProcessName:" (objc/nsstring "otium objc test"))
    (check "void result" "otium objc test" (objc/nsstring-text (objc/send info "processName")))))

(report "objc")
