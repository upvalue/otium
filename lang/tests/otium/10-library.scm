; Core library (spec section 10): kind preservation, copy vs mutate,
; string ops, higher-order helpers.

; map/filter/reduce kind preservation
(println "map-list:" (map inc '(1 2 3)))
(println "map-array:" (map inc [1 2 3]))
(println "map-nil:" (map inc nil))
(println "filter-list:" (filter odd? '(1 2 3 4 5)))
(println "filter-array:" (filter odd? [1 2 3 4 5]))
(println "filter-nil:" (filter odd? nil))
(println "reduce-sum:" (reduce + 0 [1 2 3 4]))
(println "reduce-list:" (reduce + 100 '(1 2)))
(println "reduce-nil:" (reduce + 5 nil))
(let ((a [1 2 3]) (seen []))
  (for-each (fn (x) (push! seen x) (pop! a)) a)
  (println "for-each-snapshot:" seen))
(println "reverse-list:" (reverse '(1 2 3)))
(println "reverse-array:" (reverse [1 2 3]))

; take/drop clamp
(println "take-basic:" (take 2 [1 2 3]))
(println "take-clamp:" (take 10 '(1 2)))
(println "take-zero:" (take 0 '(1 2)))
(println "drop-basic:" (drop 1 '(1 2 3)))
(println "drop-clamp:" (drop 10 [1 2]))
(println "drop-zero:" (drop 0 [1 2]))

; sort: one class per sort, stable, kind-preserving
(println "sort-ints:" (sort [3 1 2]))
(println "sort-list:" (sort '(3 1 2)))
(println "sort-mixed-num:" (sort [2.5 1 3]))
(println "sort-strings:" (sort ["b" "a" "c"]))
(println "sort-keywords:" (sort [:b :a :c]))
(println "sort-by-key:" (sort-by first [[2 :x] [1 :y]]))
(println "sort-stable:" (sort-by first [[1 :b] [0 :a] [1 :a]]))

; group-by / frequencies: insertion order of first-seen keys
(let ((g (group-by odd? [1 2 3 4])))
  (println "group-keys:" (keys g))
  (println "group-values:" (values g)))
(let ((f (frequencies '(:a :b :a :c :a))))
  (println "freq-keys:" (keys f))
  (println "freq-values:" (values f)))

; assoc/dissoc/update copy; put!/update! mutate
(let ((t {:a 1}))
  (let ((t2 (assoc t :b 2)))
    (println "assoc-copy:" (count t) (count t2) (get t2 :b))))
(println "assoc-nil:" (get (assoc nil :a 1) :a))
(let ((t {:a 1 :b 2}))
  (let ((t2 (dissoc t :a)))
    (println "dissoc-copy:" (count t) (count t2) (get t2 :a))))
(let ((t {:a 1}))
  (let ((t2 (update t :a inc)))
    (println "update-copy:" (get t :a) (get t2 :a))))
(let ((t {:a 1}))
  (put! t :b 2)
  (println "put-mutates:" (count t) (get t :b)))
(let ((t {:a 1}))
  (update! t :a + 10)
  (println "update-mutates:" (get t :a)))
(let ((a [1 2 3]))
  (put! a 0 9)
  (println "array-put:" a))
(let ((a [1 2]))
  (push! a 3 4)
  (println "push:" a)
  (println "pop:" (pop! a))
  (println "after-pop:" a))
(let ((a [1 2]))
  (let ((b (copy a)))
    (put! b 0 9)
    (println "copy-independent:" a b)))
(println "copy-nil:" (copy nil))

; strings
(println "substring-mid:" (substring "hello" 1 3))
(println "substring-clamp-end:" (substring "hi" 0 99))
(println "substring-clamp-start:" (str "<" (substring "hi" 5) ">"))
(println "substring-inverted:" (str "<" (substring "hello" 3 1) ">"))
(println "split-sep:" (string-split "a,b,c" ","))
(println "split-ws:" (string-split "  a b   c "))
(println "join:" (string-join "-" [1 2 3]))
(println "join-list:" (string-join ":" '(1 2 3)))
(println "join-empty:"
  (str "<" (string-join ":" '()) ">")
  (str "<" (string-join ":" nil) ">"))
(println "join-improper:"
  (try (string-join ":" '(1 . 2))
    (catch (error? e) (condition-message e))))
(println "join-not-sequence:"
  (try (string-join ":" 1)
    (catch (error? e) (condition-message e))))
(println "str-concat:" (str 1 "x" :k 'sym 2.5))
(println "str-empty:" (str "<" (str) ">"))
(println "string-len:" (string-length "héllo"))
(println "upcase:" (string-upcase "abC"))
(println "trim:" (str "<" (string-trim "  hi  ") ">"))
(println "replace:" (string-replace "banana" "an" "AN"))
(println "starts:" (string-starts-with? "hello" "he"))
(println "contains-str:" (contains? "hello" "ell"))
(println "contains-seq:" (contains? '(1 2 3) 2) (contains? [1 2] 9))
(println "contains-nil:" (contains? nil 1))
(println "to-number:" (string->number "42") (string->number " 3.5 ") (string->number "nope"))
(println "first-string:" (first "abc"))

; apply / partial / comp / range
(println "apply:" (apply + 1 2 '(3 4)))
(println "apply-array:" (apply max [3 9 2]))
(println "apply-empty:" (apply list '()) (apply list nil))
(println "apply-improper:"
  (try (apply list '(1 . 2))
    (catch (error? e) (condition-message e))))
(println "apply-not-sequence:"
  (try (apply list 1)
    (catch (error? e) (condition-message e))))
(println "partial:" ((partial + 1 2) 3))
(println "comp:" ((comp inc inc) 1))
(println "comp-order:" ((comp str inc) 4))
(println "comp-empty:" ((comp) 5))
(println "range-n:" (range 5))
(println "range-a-b:" (range 2 5))
(println "range-step:" (range 5 0 -2))
(println "range-empty:" (range 3 3))

; concat: kind follows the first argument
(println "concat-list-first:" (concat '(1) [2 3]))
(println "concat-array-first:" (concat [1] '(2 3)))

; misc sequence accessors
(println "second-third:" (second [1 2 3]) (third '(1 2 3)))
(println "nth-miss:" (nth [1 2] 5))
(println "last:" (last '(1 2 3)))
(println "count-string:" (count "abc"))
(println "count-table:" (count {:a 1 :b 2}))
