;; Run with -L tests/reader/data on either runtime.
(require otium.test :refer (check fails? report))
(require reader-datums :as datums)
(require otium.reader :as reader)
(require otium.syntax :as syntax)

(for-each (fn (fixture) (check (car fixture) #t (pair? (reader/tokens (car fixture))))) datums/positive)
(for-each (fn (text) (unless (member text '("" "; only" "1 2")) (check text #t (fails? (fn () (reader/tokens text))))))
          datums/negative)
(check '() (reader/tokens ""))
(check '((:comment "; only" 0 0 0)) (reader/tokens "; only"))
(check '((:atom "1" 0 0 0) (:atom "2" 0 2 0)) (reader/tokens "1 2"))
(check #t (fails? (fn () (reader/tokens 1))))
(check #t (fails? (fn () (reader/tokens))))
(check #t (fails? (fn () (reader/tokens "1" "2"))))

(check '((:comment "; λ" 0 0 0)
         (:prefix "'" 2 0 2)
         (:open "(" 2 1 0)
         (:atom "α" 2 2 0)
         (:atom "." 2 4 0)
         (:atom "β" 2 6 0)
         (:close ")" 2 7 0)
         (:open "#u8(" 2 9 0)
         (:atom "1" 2 13 0)
         (:close ")" 2 14 0)
         (:string "\"a\r\nb\"" 3 0 1)
         (:atom "z" 4 3 0))
       (reader/tokens "; λ\r\n\r'(α . β) #u8(1)\n\"a\r\nb\" z"))

(check '((:prefix "`" 0 0 0)
         (:open "[" 0 1 0)
         (:prefix "," 0 2 0)
         (:atom "a" 0 3 0)
         (:prefix ",@" 0 5 0)
         (:atom "b" 0 7 0)
         (:open "{" 0 9 0)
         (:atom ":k" 0 10 0)
         (:atom "#\\;" 0 13 0)
         (:close "}" 0 16 0)
         (:close "]" 0 17 0))
       (reader/tokens "`[,a ,@b {:k #\\;}]"))
(check :bytevector ((get (syntax/parse "#u8(1 2)") 0) :kind))
(check 2 ((get (syntax/parse "\r\n\r(x)") 0) :line))
(report "reader tokens")

;; Printed by both runtimes for the differential test, including every field.
(for-each (fn (fixture) (println (reader/tokens (car fixture)))) datums/positive)
(for-each (fn (text) (println (reader/tokens text)))
          '("' ; after prefix\n x" "\t[\n;inside\r\n\n] ;last" "\"a\nb\"\n\nλ" "#\\\n x" "(a . ; tail\n b)"))
