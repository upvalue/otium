#!/bin/sh
# Run one test command for meson test.
#   --scratch      append a fresh temporary directory as the last argument
#   --expect FILE  require stdout to match FILE exactly
set -eu
expect=
scratch=no
while [ $# -gt 0 ]; do
    case $1 in
        --scratch) scratch=yes; shift ;;
        --expect) expect=$2; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
directory=$(mktemp -d "${TMPDIR:-/tmp}/otium-test.XXXXXX")
trap 'rm -rf "$directory"' EXIT HUP INT TERM
if [ "$scratch" = yes ]; then set -- "$@" "$directory/scratch"; mkdir "$directory/scratch"; fi
if [ -z "$expect" ]; then
    "$@"
    exit
fi
status=0
"$@" > "$directory/stdout" || status=$?
if ! diff -u "$expect" "$directory/stdout"; then exit 1; fi
exit $status
