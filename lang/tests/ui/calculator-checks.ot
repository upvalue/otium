(require (ui.calculator :as calculator))

(def checks 0)

(def (expect actions result)
  (calculator/reset!)
  (for-each calculator/act! actions)
  (unless (= result (get calculator/model :value)) (error "Calculator result" actions calculator/model result))
  (set! checks (+ checks 1)))

(expect '(1 2 "+" 3 "=") 15)
(expect '(8 "-" 9 "=") -1)
(expect '(6 "*" 7 "=") 42)
(expect '(7 "/" 2 "=") 3.5)
(expect '(1 "." 2 5 "+" 2 "=") 3.25)
(expect '(2 "+" 3 "*" 4 "=") 20)
(expect '(2 "+" "*" 4 "=") 8)
(expect '(1 "+" 2 "=" 9) 9)
(expect '(1 "+" 2 "=" "=") 3)
(expect '(1 "+" 2 "C" 4) 4)
(expect '(9 "/" 0 "=" "." 5) 0.5)
(unless (not (get calculator/model :error)) (error "Decimal must recover from error"))
(calculator/reset!)
(for-each calculator/act! '(9 "/" 0 "="))
(unless (get calculator/model :error) (error "Division by zero must show an error"))
(calculator/act! 3)
(unless (and (= (get calculator/model :value) 3) (not (get calculator/model :error)))
  (error "Digit must recover from error"))
(println "Calculator checks:" (+ checks 2))
