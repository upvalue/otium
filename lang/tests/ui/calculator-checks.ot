(require (ui.calculator :as calculator))
(require otium.test :refer (check report))

(def (expect actions result)
  (calculator/reset!)
  (for-each calculator/act! actions)
  (check actions result (get calculator/model :value)))

(expect '(1 2 "+" 3 "=") 15)
(expect '(8 "-" 9 "=") -1)
(expect '(6 "*" 7 "=") 42)
(expect '(7 "/" 2 "=") 3.5)
(expect '(1 "." 2 5 "+" 2 "=") 3.25)
(expect '(2 "+" 3 "*" 4 "=") 20)
(expect '(2 "+" "*" 4 "=") 8)
(expect '(1 "+" 2 "=" 9) 9)
(expect '(1 "+" 2 "=" "=") 3)
(expect '(1 "+" 2 "C" 4) 4)
(expect '(9 "/" 0 "=" "." 5) 0.5)
(check "decimal recovers from an error" #t (not (get calculator/model :error)))
(calculator/reset!)
(for-each calculator/act! '(9 "/" 0 "="))
(check "division by zero shows an error" #t (not (not (get calculator/model :error))))
(calculator/act! 3)
(check "digit recovers from an error" '(3 #t) (list (get calculator/model :value) (not (get calculator/model :error))))
(report "ui calculator")
