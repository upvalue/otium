(ns ui.event-contract)
(require (otium.ui.native :as native))
(require (otium.sdl :as sdl))
(require (ui.events :as events))

(def (step! tree frame context)
  (let ((renderer (get context :renderer)))
    (sdl/check (native/text-input renderer #t))
    (events/key! context "Left" #t)
    (events/text! context "café λ")
    (events/wheel! context 40.0 50.0 2.0)
    (let ((key (native/poll-event renderer)))
      (unless (and (eq? (get key :kind) :key-down)
                   (equal? (get key :key) "Left")
                   (not (get key :repeat))
                   (int? (get key :code)))
        (error "Invalid key event snapshot" key))
      (let ((text (native/poll-event renderer)))
        (let ((wheel (native/poll-event renderer)))
          (unless (and (eq? (get wheel :kind) :wheel)
                       (= (get wheel :x) 40)
                       (= (get wheel :y) 50)
                       (= (get wheel :dy) 2)
                       (nil? (get wheel :key)))
            (error "Invalid wheel snapshot" wheel)))
        (unless (and (eq? (get text :kind) :text-input)
                     (equal? (get text :text) "café λ")
                     (equal? (get key :key) "Left")
                     (nil? (get key :dy)))
          (error "Later polling changed retained event payload")))
      (unless (nil? (native/poll-event renderer)) (error "Empty queue must return nil")))
    (println "UI-EVENT copied named events passed")))
