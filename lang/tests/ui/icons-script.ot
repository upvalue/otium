(ns ui.icons-script)
(require (otium.ui :as ui))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.native :as native))
(require (otium.sdl :as sdl))

(def saved nil)

(def (icon-node tree)
  (first (ui/children (first (ui/children (first (ui/children tree)))))))

(def (step! tree frame context)
  (let ((renderer (get context :renderer)))
    (when (= frame 1)
      (unless (= (native/gpu-image-count renderer) 2) (error "Icons did not rasterise"))
      (set! saved (icon-node tree))
      (let ((path (gpu/icon-path (ui/instance saved)))
            (scale (native/gpu-scale renderer)))
        (sdl/check (native/gpu-image renderer path 4 4 16 16 0xff000080 0 0 240 90))
        (unless (= (native/gpu-image-count renderer) 2) (error "Tint rerasterised icon"))
        (sdl/check (native/gpu-image renderer path 4 4 24 24 0xffffffff 0 0 240 90))
        (unless (= (native/gpu-image-count renderer) 3) (error "Size not in SVG cache key"))
        (sdl/check (native/gpu-resize renderer 240 90 (+ scale 1)))
        (sdl/check (native/gpu-image renderer path 4 4 16 16 0xffffffff 0 0 240 90))
        (unless (= (native/gpu-image-count renderer) 4) (error "Scale not in SVG cache key"))
        (sdl/check (native/gpu-resize renderer 240 90 scale))
        (let ((count (native/gpu-count renderer)))
          (when (native/gpu-image renderer "/no-such-icon.svg" 0 0 16 16 0xffffffff 0 0 240 90)
            (error "Missing SVG was accepted"))
          (unless (= count (native/gpu-count renderer)) (error "Failed SVG left a rectangle"))))
      (eval '(require otium.ui :reload))
      (eval '(require otium.ui.native :reload))
      (eval '(require otium.ui.gpu :reload)))
    (when (= frame 2)
      (unless (eq? saved (icon-node tree)) (error "Icon reload lost mounted identity"))
      (unless (= (native/gpu-image-count renderer) 4) (error "Ordinary frame rerasterised icons"))
      (println "UI-ICONS cache and reload passed"))))
