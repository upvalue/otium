(require (otium.ui :as ui))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.native :as native))
(require (otium.ffi :as ffi))
(require (ui.layout :as demo))
(require (ui.terminal :as terminal))
(native/load-config! "build/ui-config.ot")

(require otium.test :refer (check fails? report))

(def (near label expected actual)
  (check label expected (if (< (abs (- expected actual)) 0.01) expected actual)))

(def (child parent i)
  (get (ui/children parent) i))

(defclass Box
  :is ui/Widget
  (grow :init 0)
  (w :init 40)
  (h :init 20))

(defmethod (ui/measure (w Box) limits)
  (check "constrained width mode" #t (not (nil? (get limits :width-mode))))
  (ui/size (w :w) (w :h)))

(defmethod (ui/layout-style (w Box))
  {:grow (w :grow)})

(def modes {})

(defclass Wrapping
  :is ui/Widget)

(defmethod (ui/measure (w Wrapping) limits)
  (for-each (fn (axis)
              (let ((mode (get limits
                               (if (eq? axis :width)
                                   :width-mode
                                   :height-mode))))
                (check "constraint value present iff defined"
                       (not (eq? mode :undefined))
                       (not (nil? (get limits axis))))))
            [:width :height])
  (put! modes (get limits :width-mode) #t)
  (let ((width (get limits :width 200)))
    (ui/size (min width 200)
             (if (< width 150)
                 60
                 20))))

(def tree (ui/root))

(def (view)
  (ui/column {:key :outer :grow 1 :padding 10 :gap 5}
             (ui/row {:height 60 :gap 10} (ui/new Box {:key :a}) (ui/new Box {:key :b :grow 1}))
             (ui/new Box {:key :c})))

(def outer nil)

(def row nil)

(def a nil)

(def b nil)

(def c nil)

(def saved nil)

(unwind-protect
  (begin
    (let ((empty (native/text-get "" 1 18 -1 1)))
      (check "empty text cache hit" #t (ffi/pointer=? empty (native/text-get "" 1 18 -1 1))))
    (ui/reconcile! tree (view))
    (gpu/layout! tree 300 200)
    (set! outer (child tree 0))
    (set! row (child outer 0))
    (set! a (child row 0))
    (set! b (child row 1))
    (set! c (child outer 1))
    (set! saved (b :layout))
    (near "root fills height" 200 ((outer :bounds) :height))
    (near "padding x" 10 ((a :bounds) :x))
    (near "padding y" 10 ((a :bounds) :y))
    (near "intrinsic width" 40 ((a :bounds) :width))
    (near "stretch height" 60 ((a :bounds) :height))
    (near "gap" 60 ((b :bounds) :x))
    (near "flex grow" 230 ((b :bounds) :width))
    (near "column gap" 75 ((c :bounds) :y))
    (check "persistent node count" 5 (native/live-nodes))
    (eval '(require otium.ui.native :reload))
    (gpu/layout! tree 400 240)
    (near "resize" 330 ((b :bounds) :width))
    (check "native node reused" #t (ffi/pointer=? saved (b :layout)))
    (check "repeated layout does not leak" 5 (native/live-nodes))
    (ui/reconcile! tree (ui/column {:key :outer :grow 1} (ui/new Box {:key :c})))
    (check "removed descendants released" 2 (native/live-nodes))
    (check "removed node handle cleared" nil (b :layout))
    (gpu/layout! tree 300 200)
    (check "remaining child identity" #t (eq? c (child outer 0)))
    (eval '(defmethod (ui/measure (w Box) limits)
             (ui/size 60 30)))
    (gpu/layout! tree 300 200)
    (near "redefined measure used" 30 ((c :bounds) :height))
    (check "negative root rejected" #t (fails? (fn () (gpu/layout! tree -1 200))))
    (ui/reconcile! tree (ui/column {:padding -1}))
    (check "invalid style rejected" #t (fails? (fn () (gpu/layout! tree 300 200))))
    (ui/reconcile! tree (ui/column {:width 100} (ui/new Wrapping {})))
    (gpu/layout! tree 300 200)
    (near "exact width changes custom height" 60 (((child (child tree 0) 0) :bounds) :height))
    (check "custom measure sees exact width" #t (get modes :exactly))
    (ui/reconcile! tree (ui/row {} (ui/new Wrapping {})))
    (gpu/layout! tree 300 200)
    (check "custom measure sees at-most width" #t (get modes :at-most))
    (near "wide custom height" 20 (((child (child tree 0) 0) :bounds) :height))
    (ui/reconcile! tree (ui/label {:key :text} "office café naïve λ -- words wrap into lines"))
    (gpu/layout! tree 120 500)
    (let ((label (child tree 0)))
      (let ((narrow ((label :bounds) :height)))
        (gpu/layout! tree 400 500)
        (check "wide text needs fewer lines" #t (< ((label :bounds) :height) narrow))
        (ui/reconcile! tree (ui/label {:key :text :size 28} "New"))
        (gpu/layout! tree 120 500)
        (check "text updates reuse mounted node" #t (eq? label (child tree 0)))
        (check "text and size invalidate measurement" #t (< ((label :bounds) :height) narrow))))
    (ui/reconcile! tree (ui/label {:width 100 :height 10} "clipped text"))
    (gpu/layout! tree 300 200)
    (near "explicit text height" 10 (((child tree 0) :bounds) :height))
    (let ((one (ui/measure (make ui/Label :text "hello") {}))
          (two (ui/measure (make ui/Label :text "hello\nhello") {})))
      (check "explicit newline height" #t (> (two :height) (one :height)))
      (check "empty text width" 0.0 ((ui/measure (make ui/Label :text "") {}) :width))
      (check "zero width text measurement terminates"
             #t
             (> ((ui/measure (make ui/Label :text "hello") {:width 0}) :height) 0)))
    (let ((wide (ui/measure (make ui/Label :text "WWW" :font :mono) {}))
          (thin (ui/measure (make ui/Label :text "iii" :font :mono) {})))
      (near "bundled mono has equal advances" (wide :width) (thin :width)))
    (let ((wide (ui/measure (make ui/Label :text "WWW") {}))
          (thin (ui/measure (make ui/Label :text "iii") {})))
      (check "proportional font uses real glyph advances" #t (> (wide :width) (thin :width))))
    (let ((precomposed (ui/measure (make ui/Label :text "café") {}))
          (combining (ui/measure (make ui/Label :text "café") {})))
      (near "combining marks are shaped" (precomposed :width) (combining :width)))
    (check "unknown font rejected" #t (fails? (fn () (ui/measure (make ui/Label :text "bad" :font :missing) {}))))
    (check "invalid font size rejected" #t (fails? (fn () (ui/measure (make ui/Label :text "bad" :size -1) {}))))
    (for-each (fn (density)
                (ui/reconcile! tree (demo/view))
                (gpu/layout! tree 640 480 density)
                (let ((header (child (child tree 0) 0)))
                  (let ((text-column (child header 1)))
                    (for-each (fn (label)
                                (let ((bounds (label :bounds)))
                                  (let ((needed (ui/measure (ui/instance label)
                                                            {:width (bounds :width) :scale density})))
                                    (check "header preserves full text height"
                                           #t
                                           (>= (bounds :height) (needed :height))))))
                              (ui/children text-column)))))
              [1 2])
    (ui/reconcile! tree
                   (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 200} (ui/label {} "Scrollable"))))
    (gpu/layout! tree 300 200)
    (let ((scroll (ui/instance (child tree 0))))
      (near "scroll content does not shrink" 200 (((child (child tree 0) 0) :bounds) :height))
      (near "scroll overflow" 120 (scroll :limit))
      (near "stick to bottom" 120 (scroll :offset))
      (near "scroll translates content" -120 (((child (child tree 0) 0) :bounds) :y))
      (ui/send! (child tree 0) {:kind :wheel :dy 1})
      (gpu/layout! tree 300 200)
      (near "wheel moves offset" 84 (scroll :offset))
      (ui/reconcile! tree (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 240})))
      (gpu/layout! tree 300 200)
      (near "new content preserves scrolled position" 84 (scroll :offset))
      (ui/scroll-to! scroll 10000)
      (gpu/layout! tree 300 200)
      (near "scroll clamps at bottom" 160 (scroll :offset))
      (ui/reconcile! tree (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 20})))
      (gpu/layout! tree 300 200)
      (near "content shrink clamps offset" 0 (scroll :offset)))
    (dotimes (i 40)
      (terminal/emit! (str "scroll line " i)))
    (ui/reconcile! tree (terminal/view))
    (gpu/layout! tree 640 480)
    (near "scrollback leaves input at full height" 44 (((ui/focused tree) :bounds) :height))
    (check "scrollback leaves heading visible" #t (> (((child (child tree 0) 0) :bounds) :height) 30))
    (ui/reconcile! tree (ui/text-field {:height -1}))
    (gpu/layout! tree 300 200)
    (near "automatic text field height" 44 (((child tree 0) :bounds) :height))
    (ui/reconcile! tree (ui/new Box {}))
    (eval '(defmethod (ui/measure (w Box) limits)
             (error "injected measure failure")))
    (check "measure failure escapes" #t (fails? (fn () (gpu/layout! tree 300 200))))
    (check "temporary root freed on failure" 1 (native/live-nodes))
    (eval '(defmethod (ui/measure (w Box) limits)
             (ui/size 60 30)))
    (gpu/layout! tree 300 200)
    (near "layout retries after measure failure" 30 (((child tree 0) :bounds) :height))
    (for-each (fn (density)
                (let ((positions (gpu/caret-positions "office éλ" :ui 24 density)))
                  (check "caret array uses codepoints" 10 (length positions))
                  (check "first caret retains shaped bearing" #t (>= (get positions 0) 0))
                  (check "ligature interior remains editable"
                         #t
                         (< (get positions 1) (get positions 2) (get positions 3) (get positions 4))))
                (near "empty field caret at origin" 0 (get (gpu/caret-positions "" :ui 24 density) 0)))
              [1 2]))
  (ui/dispose! tree))
(check "all fonts and shaped runs released" 0 (native/text-resources))
(check "all nodes released" 0 (native/live-nodes))
(check "no renderers needed" 0 (native/live-renderers))
(check "foreign memory released" 0 (ffi/allocation-count))
(report "ui layout")
