(ns ui.paint)
(require (otium.ui :as ui))
(require (otium.gfx :as gfx))

;; Pixel probes cover ordered blending and clipping through the widget wrapper.
(defclass Probe
  :is ui/Widget)

(defmethod (ui/measure (w Probe) limits)
  (ui/size 100 100))

(defmethod (ui/paint (w Probe) g b)
  (gfx/rect g b 0xff0000ff)
  (gfx/rect g (ui/bounds 60 40 160 60) 0x0000ff80)
  (gfx/rect g (ui/bounds 20 20 32 32) 0x00ff00ff 12))

(def (view)
  (ui/column {:grow 1 :padding 20 :background 0x101827ff} (ui/new Probe {})))
