(ns ui.terminal-cursor)
(require (otium.ui :as ui))
(require (otium.ui.input :as input))
(require (ui.events :as events))

(def (step! tree frame context)
  (let ((node (ui/focused tree)))
    (let ((field (ui/instance node)))
      (unless (eq? (field :caret-style) :block) (error "Terminal needs a block cursor"))
      (when (= frame 0) (events/text! context "a  "))
      (when (= frame 2)
        (let ((positions (field :positions)))
          (unless (and (= (field :cursor) 3)
                       (> (get positions 2) (get positions 1))
                       (> (get positions 3) (get positions 2)))
            (error "Trailing spaces did not advance cursor" positions)))
        (input/keyboard! tree {:kind :key-down :key "Left"})
        (unless (= (field :cursor) 2) (error "Cannot move through trailing spaces"))
        (input/keyboard! tree {:kind :key-down :key "Right"})
        (events/text! context "                                                            "))
      (when (= frame 4)
        (let ((positions (field :positions))
              (available (- ((node :bounds) :width) 20)))
          (let ((end (get positions (field :cursor)))
                (cell (- (get positions 3) (get positions 2))))
            (unless (and (> (field :offset) 0) (<= (+ (- end (field :offset)) cell) available))
              (error "Full block cursor must remain visible after spaces"))))
        (println "UI-TERMINAL block cursor and spaces passed")))))
