;; compiler.ot -- the native compiler's driver.
;;
;; compile-top takes one expanded top-level form and returns a unit for the
;; bridge (c/src/native.c): convert to tree IR, lower each function to
;; virtual code, allocate registers, emit the stream. In a native process
;; run-top installs the unit and calls it. See
;; scratch/native-compiler-design.md, section 10.

(ns otium.compiler
  (:require (otium.compiler.convert :as convert)
            (otium.compiler.inline :as inline)
            (otium.compiler.ir :as ir)
            (otium.compiler.known :as known)
            (otium.compiler.options :as options)
            (otium.compiler.rescope :as rescope)
            (otium.compiler.options :as options)
            (otium.compiler.types :as types)
            (otium.compiler.lower :as lower)
            (otium.compiler.alloc :as alloc)
            (otium.compiler.emit :as emit)
            (otium.process :as process)))

;; OTIUM_OPT_VERIFY=1 checks the tree IR after convert, and recomputes
;; scopes and checks it again, and checks it after each pass, for testing.
(def- verify? (equal? (process/getenv "OTIUM_OPT_VERIFY") "1"))

;; OTIUM_OPT_TIMES=1 adds up the time each pass takes, for pass-times.
(def- times? (equal? (process/getenv "OTIUM_OPT_TIMES") "1"))

(def- times {})

(def (timed pass thunk)
  (if times?
      (let ((start (current-jiffy)))
        (let ((result (thunk)))
          (put! times pass (+ (get times pass 0) (- (current-jiffy) start)))
          result))
      (thunk)))

;; Seconds spent in each pass so far, by name, when OTIUM_OPT_TIMES=1.
(def (pass-times)
  (let ((out {}))
    (for ((pass :in (keys times)))
      (put! out pass (/ (get times pass) (inexact (jiffies-per-second)))))
    out))

(def- inline? (options/enabled? "inline"))

;; The tree IR of a form, after the passes switched on.
(def (convert form)
  (let ((info (timed :convert (fn () (convert/convert-top form)))))
    (when verify?
      (ir/verify info)
      (rescope/rescope info)
      (ir/verify info))
    (when inline?
      (timed :inline (fn () (inline/inline info)))
      (rescope/rescope info)
      (when verify? (ir/verify info)))
    info))

;; The passes between convert and lower. Each relies on what rescope works
;; out about variables, and leaves it stale.
(def (optimize info)
  (when (options/enabled? "types")
    (rescope/rescope info)
    (types/optimize info)
    (rescope/rescope info)
    (when verify? (ir/verify info))))

;; The name of the inline candidate a converted top-level form defines, or
;; nil: (def (name ...) ...) of a core function known.ot lists.
(def (inline-definition info)
  (let ((body (info :body)))
    (when (and (eq? (get body 0) :gdef) (eq? (get (get body 3) 0) :fn) (%native-core-cell? (get body 2))
               (%core-locked?))
      (let ((name (string->symbol (cdr (%native-cell-name (get body 2))))))
        (when (known/inline-candidate? name) name)))))

;; Compile form, and for an inline candidate keep its body's text in
;; %inline-bodies: now, for this process's compiler, and in the code, so a
;; process that loads it has it too.
(def (compile-top form)
  (let ((info (convert form)))
    (let ((name (inline-definition info)))
      (when name
        (let ((text (ir/tree->text (get (get (info :body) 3) 2))))
          (put! otium.core/%inline-bodies name text)
          (set! info (convert (list 'begin form (list 'put! 'otium.core/%inline-bodies (list 'quote name)
                                                      (list 'quote text))))))))
    (compile-info info)))

(def (compile-info info)
  (timed :types (fn () (optimize info)))
  (let ((lowered (timed :lower (fn () (lower/lower-top info)))))
    (let ((u (get lowered 0)) (contexts (get lowered 1)))
      (timed :allocate (fn () (for ((fc :in contexts)) (alloc/allocate fc))))
      (timed :emit (fn () (emit/emit-unit u contexts))))))

;; The closure that runs a compiled top-level form.
(def (install-top form) (%native-install (compile-top form)))

;; Virtual code of a form's functions, after allocation, for debugging.
(def (dump-top form)
  (let ((info (convert form)))
    (let ((lowered (lower/lower-top info)))
      (for ((fc :in (get lowered 1)))
        (alloc/allocate fc)
        (println "function " ((fc :info) :index) " " ((fc :info) :name))
        (let ((code (fc :code)))
          (dotimes (i (length code))
            (let ((ins (get code i)))
              (print "  " i " ")
              (write ins)
              (let ((live (get (fc :live) i)))
                (when live (print "  live ") (write live)))
              (newline))))
        (print "  locations ")
        (write (fc :location))
        (newline)
        (print "  ranges ")
        (write (fc :ranges))
        (newline)))))
