;; alloc.ot -- register allocation for the native compiler.
;;
;; Linear scan over one function's virtual code (lower.ot). Liveness is
;; computed per block, a block ending at every branch, label and call, and a
;; call inside a try or restart-case also leading to its landing labels.
;; Each register's interval spans every point where it is live, so a value
;; stays in one place for its whole life: one of ten registers, or a spill
;; slot when they run out. Calls don't split intervals: emit saves the
;; registers live across a call into fixed save slots and reloads them after.
;;
;; Results go back into the function context: :location holds each
;; register's place by its number, [:reg r] or [:slot i] (nil for one never
;; live), :spills counts spill slots, and :live maps the
;; index of each call and landing to the registers live across or into it.

(ns otium.compiler.alloc
  (:require (otium.compiler.lower :refer (fc-closure fc-code fc-cold fc-next fc-optional-regs fc-params fc-ranges
                                          fc-rest-reg fc-u h-arity h-proof-failed h-raise h-unbound
                                          h-uninitialized set-fc-cold! set-fc-live! set-fc-location!
                                          set-fc-ranges! set-fc-spills! unit-labels vreg?))))

;; sljit registers R0-R10, except R6, which emit keeps as a scratch register.
;; R7 and up are pushed by the prologue of a function that uses them.
(def- pool [0 1 2 3 4 5 7 8 9 10])

;; Helpers that never return.
(def- noreturn-helpers {h-arity #t h-unbound #t h-uninitialized #t h-raise #t h-proof-failed #t})

;; --- Bit sets, 60 bits to a fixnum ---------------------------------------------

(def- bits 60)

(def (set-add! s n)
  (let ((w (quotient n bits)))
    (put! s w (bitwise-ior (get s w) (bitwise-arithmetic-shift 1 (remainder n bits))))))

(def (set-remove! s n)
  (let ((w (quotient n bits)))
    (put! s w (bitwise-and (get s w) (bitwise-not (bitwise-arithmetic-shift 1 (remainder n bits)))))))

(def (set-has? s n)
  (not (= 0 (bitwise-and (get s (quotient n bits)) (bitwise-arithmetic-shift 1 (remainder n bits))))))

;; dst := dst | src; true when dst changed.
(def (set-union! dst src)
  (let ((changed #f))
    (dotimes (i (length dst))
      (let ((old (get dst i)) (new (bitwise-ior (get dst i) (get src i))))
        (unless (= old new)
          (put! dst i new)
          (set! changed #t))))
    changed))

;; An array of n copies of x, for maps keyed by register or label number.
(def (filled n x) (let ((a [])) (dotimes (_ n) (push! a x)) a))

(def (set-new words) (filled words 0))

;; The bit number of each power of two in a word.
(def- bit-index (let ((t {})) (dotimes (b bits) (put! t (bitwise-arithmetic-shift 1 b) b)) t))

;; The members in increasing order. Each step takes the lowest set bit.
(def (set-members s)
  (let ((out []))
    (dotimes (w (length s))
      (let next ((word (get s w)))
        (unless (= word 0)
          (let ((low (bitwise-and word (- word))))
            (push! out (+ (* w bits) (get bit-index low)))
            (next (bitwise-xor word low))))))
    out))

;; --- Uses and definitions ---------------------------------------------------------

(def (operand-uses op out)
  (cond ((vreg? op) (push! out op))
        ((and (array? op) (eq? (get op 0) :mem) (vreg? (get op 1))) (push! out (get op 1)))))

;; The registers an instruction reads.
(def (uses ins)
  (let ((out []))
    (case (get ins 0)
      ((:mov)
       (operand-uses (get ins 2) out)
       (unless (vreg? (get ins 1)) (operand-uses (get ins 1) out)))
      ((:load8) (operand-uses (get ins 2) out))
      ((:store8) (operand-uses (get ins 1) out) (operand-uses (get ins 2) out))
      ((:op2)
       (operand-uses (get ins 4) out)
       (operand-uses (get ins 5) out)
       (unless (vreg? (get ins 3)) (operand-uses (get ins 3) out)))
      ((:op2u) (operand-uses (get ins 3) out) (operand-uses (get ins 4) out))
      ((:cmpj) (operand-uses (get ins 2) out) (operand-uses (get ins 3) out))
      ((:fmov) (operand-uses (get ins 2) out) (operand-uses (get ins 1) out))
      ((:fop2) (operand-uses (get ins 2) out) (operand-uses (get ins 3) out) (operand-uses (get ins 4) out))
      ((:fcmpj) (operand-uses (get ins 2) out) (operand-uses (get ins 3) out))
      ((:call)
       (when (eq? (get ins 1) :value) (operand-uses (get ins 2) out))
       (for ((a :in (get ins 3))) (operand-uses a out)))
      ((:ccall) (for ((a :in (get ins 2))) (operand-uses a out)))
      ((:ret) (operand-uses (get ins 1) out)))
    out))

;; The registers an instruction writes.
(def (defs ins fc)
  (case (get ins 0)
    ((:mov :load8 :addr :spbase :landing) (if (vreg? (get ins 1)) [(get ins 1)] []))
    ((:op2) (if (vreg? (get ins 3)) [(get ins 3)] []))
    ((:call) (if (and (get ins 4) (not (get ins 5))) [(get ins 4)] []))
    ((:ccall) (if (vreg? (get ins 3)) [(get ins 3)] []))
    ((:entry)
     (let ((out [(fc-closure fc)]))
       (for ((v :in (fc-params fc))) (push! out v))
       (for ((v :in (fc-optional-regs fc))) (push! out v))
       (when (fc-rest-reg fc) (push! out (fc-rest-reg fc)))
       out))
    (else [])))

(def (safepoint? ins)
  (or (and (eq? (get ins 0) :call) (not (get ins 5))) (eq? (get ins 0) :ccall)))

;; --- Blocks -----------------------------------------------------------------

;; Instructions after which a block ends.
(def- block-enders {:jump #t :cmpj #t :jcond #t :ret #t :call #t :ccall #t :poll #t :fcmpj #t})

(def (ends-block? ins) (get block-enders (get ins 0)))

;; Successor instruction indices of the last instruction of a block.
(def (successors ins i labels n)
  (let ((out []))
    (let ((target! (fn (l) (push! out (get labels l))))
          (next! (fn () (when (< (+ i 1) n) (push! out (+ i 1))))))
      (case (get ins 0)
        ((:jump) (target! (get ins 1)))
        ((:cmpj :fcmpj) (target! (get ins 4)) (next!))
        ((:jcond) (target! (get ins 2)) (next!))
        ((:poll) (target! (get ins 1)) (next!))
        ((:ret) nil)
        ((:call)
         (unless (get ins 5)
           (next!)
           (for-each target! (get ins 6))))
        ((:ccall)
         (unless (get noreturn-helpers (get ins 1)) (next!))
         (for-each target! (get ins 4)))
        (else (next!))))
    out))

;; Blocks of a function's code: where each starts and ends, the block each
;; instruction is in, and the blocks each can go to.
(defrecord Blocks (starts ends of succ))

(def (find-blocks code labels)
  (let ((n (length code)) (starts []) (of []))
    (dotimes (i n)
      (when (or (= i 0) (eq? (get (get code i) 0) :label) (ends-block? (get code (- i 1))))
        (push! starts i))
      (push! of (- (length starts) 1)))
    (let ((nb (length starts)))
      (let ((ends (map (fn (b) (if (< (+ b 1) nb) (- (get starts (+ b 1)) 1) (- n 1))) (range nb))))
        (make-blocks :starts starts :ends ends :of of
                     :succ (map (fn (e) (map (fn (i) (get of i)) (successors (get code e) e labels n))) ends))))))

;; --- Liveness -------------------------------------------------------------------

;; The registers live out of each block, given each instruction's uses and
;; definitions.
(def (live-out blocks uses-of defs-of words)
  (let ((starts (blocks-starts blocks)) (ends (blocks-ends blocks)) (succ (blocks-succ blocks))
        (gen []) (kill []) (live-in []) (live-out []))
    (let ((nb (length starts)))
      ;; Per-block uses before definitions, and definitions.
      (dotimes (b nb)
        (let ((g (set-new words)) (k (set-new words)))
          (for ((i :range (get starts b) (+ (get ends b) 1)))
            (for ((u :in (get uses-of i))) (unless (set-has? k u) (set-add! g u)))
            (for ((d :in (get defs-of i))) (set-add! k d)))
          (push! gen g)
          (push! kill k)
          (push! live-in (copy g))
          (push! live-out (set-new words))))
      ;; Backward dataflow over a worklist, last block first. A block whose
      ;; live-in changes puts its predecessors back on.
      (let ((preds (filled nb '())) (work []) (queued (filled nb #t)))
        (dotimes (b nb)
          (for ((s :in (get succ b))) (put! preds s (cons b (get preds s))))
          (push! work b))
        (while (> (length work) 0)
          (let ((b (pop! work)))
            (put! queued b #f)
            (let ((out (get live-out b)) (in (get live-in b)) (k (get kill b)) (g (get gen b))
                  (changed #f))
              (for ((s :in (get succ b))) (set-union! out (get live-in s)))
              ;; in = gen | (out - kill)
              (dotimes (w words)
                (let ((new (bitwise-ior (get g w) (bitwise-and (get out w) (bitwise-not (get k w))))))
                  (unless (= new (get in w))
                    (put! in w new)
                    (set! changed #t))))
              (when changed
                (for ((p :in (get preds b)))
                  (unless (get queued p)
                    (put! queued p #t)
                    (push! work p))))))))
      live-out)))

;; Live ranges, half open [from to), and the registers live across each
;; safepoint and into each landing, into fc.
(def (live-ranges! fc blocks live-out uses-of defs-of)
  (let ((code (fc-code fc)) (starts (blocks-starts blocks)) (ends (blocks-ends blocks))
        (ranges (filled (fc-next fc) nil)) (live {}))
    ;; Blocks go last to first, so a definition trims only ranges from
    ;; its own block and later ones.
    (for ((b :range (- (length starts) 1) -1 -1))
      (let ((from (get starts b)) (to (+ (get ends b) 1))
            (now (copy (get live-out b))))
        (for ((v :in (set-members now))) (add-range! ranges v from to))
        (for ((i :range (get ends b) (- from 1) -1))
          (let ((ins (get code i)))
            (for ((d :in (get defs-of i)))
              (set-remove! now d)
              (start-range! ranges d i))
            (when (or (safepoint? ins) (eq? (get ins 0) :landing))
              (put! live i (set-members now)))
            (for ((u :in (get uses-of i)))
              (set-add! now u)
              (add-range! ranges u from (+ i 1)))))))
    (set-fc-live! fc live)
    (set-fc-ranges! fc ranges)))

;; --- Allocation -----------------------------------------------------------------

(def (allocate fc)
  (let ((code (fc-code fc)))
    (for ((ins :in (fc-cold fc))) (push! code ins))
    (set-fc-cold! fc [])
    (let ((labels (filled (unit-labels (fc-u fc)) nil)) (words (+ 1 (quotient (fc-next fc) bits)))
          (uses-of (map uses code)) (defs-of (map (fn (ins) (defs ins fc)) code)))
      (dotimes (i (length code))
        (when (eq? (get (get code i) 0) :label) (put! labels (get (get code i) 1) i)))
      (let ((blocks (find-blocks code labels)))
        (live-ranges! fc blocks (live-out blocks uses-of defs-of words) uses-of defs-of)
        (assign fc (fc-ranges fc))))))

;; Ranges of a register, as a list of [from to] sorted by from. Blocks are
;; walked in order and each backwards, so ranges arrive mostly in order.
(def (add-range! ranges v from to)
  (put! ranges v (insert-range (or (get ranges v) '()) from to)))

(def (insert-range rs from to)
  (cond ((null? rs) (list [from to]))
        ((< to (get (car rs) 0)) (cons [from to] rs))
        ((> from (get (car rs) 1)) (cons (car rs) (insert-range (cdr rs) from to)))
        (else
         ;; Overlapping or touching: merge, then with any later ones it reaches.
         (let ((merged [(min from (get (car rs) 0)) (max to (get (car rs) 1))]))
           (let absorb ((rest (cdr rs)))
             (if (and (pair? rest) (<= (get (car rest) 0) (get merged 1)))
                 (begin
                   (put! merged 1 (max (get merged 1) (get (car rest) 1)))
                   (absorb (cdr rest)))
                 (cons merged rest)))))))

;; A definition at i starts the range that covers i; one with no later use
;; still occupies its own instruction.
(def (start-range! ranges v i)
  (let ((rs (get ranges v)))
    (if (nil? rs)
        (put! ranges v (list [i (+ i 1)]))
        (let find-it ((r rs))
          (cond ((null? r) (put! ranges v (insert-range rs i (+ i 1))))
                ((and (<= (get (car r) 0) i) (< i (get (car r) 1))) (put! (car r) 0 i))
                (else (find-it (cdr r))))))))

(def (overlap? a b)
  (cond ((or (null? a) (null? b)) #f)
        ((<= (get (car a) 1) (get (car b) 0)) (overlap? (cdr a) b))
        ((<= (get (car b) 1) (get (car a) 0)) (overlap? a (cdr b)))
        (else #t)))

;; Drop the holders whose last range ends by start. Registers are taken in
;; order of start, so none after this one can overlap them.
(def (prune holders start ends)
  (cond ((null? holders) holders)
        ((<= (get ends (car holders)) start) (prune (cdr holders) start ends))
        (else
         (let ((rest (prune (cdr holders) start ends)))
           (if (eq? rest (cdr holders)) holders (cons (car holders) rest))))))

;; True when ranges rs, starting at start, overlap none of holders'.
(def (fits? rs start holders ranges ends)
  (cond ((null? holders) #t)
        ((and (> (get ends (car holders)) start) (overlap? rs (get ranges (car holders)))) #f)
        (else (fits? rs start (cdr holders) ranges ends))))

;; Give each register, in order of where it starts, the first pool register
;; or spill slot none of whose live holders it overlaps. A later register can
;; still fit into a gap between a holder's ranges, so a holder stays until
;; its last range ends. Cold code is at the end of the function, so a value
;; live into a slow path stays a holder until then.
(def (assign fc ranges)
  (let ((order (sort-by (fn (v) (get (car (get ranges v)) 0)) (filter (fn (v) (get ranges v)) (range (length ranges)))))
        (location (filled (length ranges) nil)) (holders (filled (length pool) '()))
        (ends (map (fn (rs) (and rs (get (last rs) 1))) ranges))
        (slot-holders []))
    (for ((v :in order))
      (let ((rs (get ranges v)))
        (let ((start (get (car rs) 0)))
          (let try-reg ((i 0))
            (cond ((= i (length pool))
                   (let try-slot ((k 0))
                     (when (= k (length slot-holders)) (push! slot-holders '()))
                     (if (fits? rs start (get slot-holders k) ranges ends)
                         (begin
                           (put! location v [:slot k])
                           (put! slot-holders k (cons v (prune (get slot-holders k) start ends))))
                         (try-slot (+ k 1)))))
                  ((fits? rs start (get holders i) ranges ends)
                   (put! location v [:reg (get pool i)])
                   (put! holders i (cons v (prune (get holders i) start ends))))
                  (else (try-reg (+ i 1))))))))
    (set-fc-location! fc location)
    (set-fc-spills! fc (length slot-holders))
    fc))
