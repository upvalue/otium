(ns otium.compiler.column)

;; Columns are plain Otium arrays, grown with push!. A table of rows is a group
;; of columns indexed by the same row number. Variable-length fields (operands,
;; successors) live in one shared column, and a row keeps a start and a count
;; into it.

(def (filled n v)
  "A fresh array of n copies of v."
  (let ((a []))
    (dotimes (i n)
      (push! a v))
    a))

(def (push-all! column xs)
  "Append the list xs to column and return the index of its first element."
  (let ((start (length column)))
    (for-each (fn (x) (push! column x)) xs)
    start))

(def (slice->list column start count)
  "The count elements of column from start, as a fresh list."
  (let loop ((i (- (+ start count) 1))
             (out '()))
    (if (< i start)
        out
        (loop (- i 1) (cons (column i) out)))))

;; --- bitsets -------------------------------------------------------------------

;; A bitset is an array of fixnum words holding 60 bits each, so every word is
;; a non-negative fixnum and the bitwise operations stay in fixnum range.

(def word-bits 60)

(def- full-word (- (bitwise-arithmetic-shift 1 word-bits) 1))

(def (bitset n)
  "An empty bitset for indexes 0 to n - 1."
  (filled (quotient (+ n (- word-bits 1)) word-bits) 0))

(def- (bit i)
  (bitwise-arithmetic-shift 1 (remainder i word-bits)))

(def (bitset-has? s i)
  (not (= 0 (bitwise-and (s (quotient i word-bits)) (bit i)))))

(def (bitset-set! s i)
  (let ((w (quotient i word-bits))) (put! s w (bitwise-ior (s w) (bit i)))))

(def (bitset-clear! s i)
  (let ((w (quotient i word-bits))) (put! s w (bitwise-and (s w) (- full-word (bit i))))))

(def (bitset-union! into from)
  "Add from's members to into, which must be at least as long. True if into changed."
  (let ((changed #f))
    (dotimes (w (length from))
      (let ((old (into w))
            (new (bitwise-ior (into w) (from w))))
        (unless (= old new)
          (put! into w new)
          (set! changed #t))))
    changed))

(def (bitset-equal? a b)
  (and (= (length a) (length b)) (let loop ((w 0)) (or (= w (length a)) (and (= (a w) (b w)) (loop (+ w 1)))))))

(def (bitset-empty? s)
  (let loop ((w 0)) (or (= w (length s)) (and (= 0 (s w)) (loop (+ w 1))))))

(def (bitset-copy s)
  (copy s))

(def (bitset-for-each f s)
  "Call f on each member of s in increasing order."
  (dotimes (w (length s))
    (let ((word (s w)))
      (unless (= word 0)
        (dotimes (b word-bits)
          (unless (= 0 (bitwise-and word (bitwise-arithmetic-shift 1 b))) (f (+ (* w word-bits) b))))))))

(def (bitset->list s)
  (let ((out '()))
    (bitset-for-each (fn (i) (set! out (cons i out))) s)
    (reverse out)))
