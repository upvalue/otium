(ns otium.compiler.convert)
(require (otium.compiler.core :as core)
         (otium.compiler.ir :as ir)
         (otium.compiler.prims :as prims)
         (otium.compiler.types :as types))

;; Convert: Core to the block IR. The contract is in docs/optimizer.md,
;; "Convert"; the method is in native-compiler-internals.md, "3. Convert".
;;
;; Two analyses run over the Core tree first:
;;
;; 1. Contification. A fix group becomes blocks of the enclosing function
;;    when its members have only required parameters and every reference to
;;    a member is a call with the right argument count, in tail position of
;;    either the fix's body or a member's body. All calls from outside the
;;    group then return to wherever the fix returns, and calls become jumps.
;;    Inner groups are decided first, since a call in an inner contified
;;    member's tail is in tail position of the outer one.
;; 2. Boxes. With contified bodies counted as part of the enclosing
;;    function, a variable is boxed when it's assigned and used from another
;;    function (a fn, an escaping fix member or a defer cleanup), or when
;;    it's assigned inside a try body that doesn't bind it, since the handler
;;    can't know which assignments ran.
;;
;; The walk then converts each expression with a continuation:
;;   :return                      tail position: return or tail-call
;;   a join                       a table collecting edges; see below
;;   {:kind :test :then j :else j}
;;                                test position: branch to one of two joins
;;
;; A join collects the edges that reach it, each a block left open with the
;; variable values on that path, and finish! then makes the join block: with
;; one edge, conversion just goes on in that edge's block; with more, a new
;; block whose parameters are the result (when the join has one) and every
;; assigned variable whose value differs between edges. Branches go to fresh
;; blocks, so refinements can be emitted on each side.
;;
;; Variables. vals maps each unboxed variable's id to its value on the
;; current path; set! of an assigned variable (a tracked one) and
;; refinements replace the entry. binds holds the other kinds: boxes,
;; escaping fix members and contified members. The state is module-level,
;; so run isn't reentrant.
;;
;; Loops (while, contified groups) decide their header parameters up front:
;; every tracked variable assigned anywhere inside the loop form.
;;
;; Decisions where the spec is silent or that differ from it:
;; - closure operations have no operands: before Closures a nested function
;;   uses its parents' values directly, so there is nothing to pass.
;; - bound? isn't a primop, so optionals test it with a bound? operation and
;;   branch, not branch-prim.
;; - A test of a plain variable refines it to truthy or falsy on each side,
;;   as well as primop predicates with :refines.
;; - Escaping fix members are created in an order where a member's closure
;;   exists before members that refer to it, when the references allow;
;;   only members referred to before they exist get a box.
;; - A primcall of a builtin the primop table doesn't know, or with an
;;   argument count it rejects, is a :global call to the builtin's cell, so
;;   the runtime reports the error.
;; - set! and while give nil; a top-level def gives its value; defer gives
;;   its body's value, as compiler.c does.

;; --- state -----------------------------------------------------------------

(def- out nil) ; the IR being built

(def- cur-fn nil) ; function being filled

(def- cur nil) ; block being filled, or nil after a terminator

(def- vals {}) ; variable id -> value on this path

(def- tracked {}) ; variable id -> #t for assigned, unboxed variables

(def- binds {}) ; variable id -> {:kind :box|:member|:contified ...}

(def- var-names {}) ; variable id -> name, for naming block parameters

(def- checked {}) ; value id -> #t when known not to be the unbound marker

(def- selfs {}) ; function id -> its self value
(def- self-loops {}) ; function id -> [header block, required count] for self tail calls

(def- contified {}) ; first member's variable id -> #t for contified groups

(def- boxed {}) ; variable id -> #t

(def- (reset!)
  (set! out (ir/new))
  (set! cur-fn nil)
  (set! cur nil)
  (set! vals {})
  (set! tracked {})
  (set! binds {})
  (set! var-names {})
  (set! checked {})
  (set! selfs {})
  (set! self-loops {})
  (set! contified {})
  (set! boxed {}))

;; --- small helpers ---------------------------------------------------------

(def- (each2 f xs ys)
  (when (pair? xs)
    (f (car xs) (car ys))
    (each2 f (cdr xs) (cdr ys))))

(def- (every? f xs)
  (or (null? xs) (and (f (car xs)) (every? f (cdr xs)))))

(def- (fix-key n)
  ((car (car (n :bindings))) :id))

(def- (contified? n)
  (or (null? (n :bindings)) (get contified (fix-key n))))

(def- (member-ref? n ids)
  ;; Whether n is a reference to one of the variables in table ids.
  (and (eq? (n :op) :ref) (get ids ((n :var) :id))))

(def- (prim-entry name argc)
  ;; The primop entry for a call of name with argc arguments, or nil.
  (let ((entry (prims/lookup name))) (and entry (prims/arity-fits? entry argc) entry)))

;; --- analysis 1: contification ---------------------------------------------

(def- (contify-walk! n tail ids state)
  ;; Clears (state :ok) when n refers to a member of ids other than by a
  ;; call of the right arity in tail position. tail: n is in tail position
  ;; of the fix or one of its members.
  (let ((op (n :op))
        (no (fn (c) (contify-walk! c #f ids state)))
        (same (fn (c) (contify-walk! c tail ids state))))
    (cond
      ((eq? op :ref) (when (get ids ((n :var) :id)) (put! state :ok #f)))
      ((eq? op :call)
       (if (member-ref? (n :fn) ids)
           (unless (and tail (= (length (n :args)) (get ids (((n :fn) :var) :id)))) (put! state :ok #f))
           (no (n :fn)))
       (for-each no (n :args)))
      ((eq? op :if) (no (n :test)) (same (n :then)) (same (n :else)))
      ((eq? op :seq)
       (let loop ((es (n :exprs)))
         (when (pair? es)
           (if (pair? (cdr es))
               (no (car es))
               (same (car es)))
           (loop (cdr es)))))
      ((eq? op :let) (no (n :value)) (same (n :body)))
      ((eq? op :fix)
       (for-each (fn (b)
                   (if (contified? n)
                       (same ((cdr b) :body))
                       (no (cdr b))))
                 (n :bindings))
       (same (n :body)))
      ((eq? op :try)
       (no (n :body))
       (for-each (fn (c)
                   (when (first c) (no (first c)))
                   (same (third c)))
                 (n :catches)))
      (else (core/for-each-child n no)))))

(def- (contifiable? n)
  (let ((ids {})
        (state {:ok #t}))
    (for-each (fn (b)
                (let ((f (cdr b)))
                  (when (or (pair? (f :optionals)) (f :rest)) (put! state :ok #f))
                  (put! ids ((car b) :id) (length (f :params)))))
              (n :bindings))
    (when (state :ok)
      (for-each (fn (b) (contify-walk! ((cdr b) :body) #t ids state)) (n :bindings))
      (contify-walk! (n :body) #t ids state))
    (state :ok)))

(def- known-ops
  '(:const :unbound :ref :set :global :gset :prim :primcall :call :if :seq :fn :let :fix :while :try :defer :def))

(def- (decide-contification! n)
  ;; Inner groups first. This is the first walk, so it rejects what the
  ;; rest can't handle.
  (unless (memq (n :op) known-ops) (core/unsupported (str "Core node " (n :op))))
  (core/for-each-child n decide-contification!)
  (when (and (eq? (n :op) :fix) (pair? (n :bindings)) (contifiable? n)) (put! contified (fix-key n) #t)))

;; --- analysis 2: boxes ---------------------------------------------------

(def- fn-counter 0)

(def- (new-fn-id!)
  (set! fn-counter (+ fn-counter 1))
  fn-counter)

(def- (synthetic-fn body pos)
  ;; A fn with no parameters running body: how a defer cleanup is compiled.
  (core/make-fn '() '() nil body nil pos))

;; marks: {:homes id -> [function try-depth] :assigned ids :captured ids
;; :try ids}, where try-depth counts the try bodies around a point within
;; its function.
(def- (box-walk! n f depth marks)
  (let ((op (n :op))
        (homes (marks :homes))
        (bind! (fn (x g d) (put! homes (x :id) [g d])))
        (walk (fn (c) (box-walk! c f depth marks)))
        (walk-fn (fn (m g)
                   ;; m is a :fn whose body runs as function g
                   (for-each (fn (x) (put! homes (x :id) [g 0])) (core/bound-vars m))
                   (core/for-each-child m (fn (c) (box-walk! c g 0 marks))))))
    (cond
      ((eq? op :ref)
       (let ((home (get homes ((n :var) :id))))
         (when (and home (not (= (home 0) f))) (put! (marks :captured) ((n :var) :id) #t))))
      ((eq? op :set)
       (let ((id ((n :var) :id))
             (home (get homes id)))
         (put! (marks :assigned) id #t)
         (when home
           (cond
             ((not (= (home 0) f)) (put! (marks :captured) id #t))
             ((> depth (home 1)) (put! (marks :try) id #t))))
         (walk (n :value))))
      ((eq? op :fn) (walk-fn n (new-fn-id!)))
      ((eq? op :let) (bind! (n :var) f depth) (walk (n :value)) (walk (n :body)))
      ((eq? op :fix)
       (for-each (fn (b) (bind! (car b) f depth)) (n :bindings))
       (if (contified? n)
           (for-each (fn (b)
                       (for-each (fn (x) (bind! x f depth)) (core/bound-vars (cdr b)))
                       (walk ((cdr b) :body)))
                     (n :bindings))
           (for-each (fn (b) (walk-fn (cdr b) (new-fn-id!))) (n :bindings)))
       (walk (n :body)))
      ((eq? op :try)
       (box-walk! (n :body) f (+ depth 1) marks)
       (for-each (fn (c)
                   (when (first c) (walk (first c)))
                   (bind! (second c) f depth)
                   (walk (third c)))
                 (n :catches)))
      ((eq? op :defer) (walk (n :body)) (walk-fn (synthetic-fn (n :cleanup) (n :pos)) (new-fn-id!)))
      (else (core/for-each-child n walk)))))

(def- (decide-boxes! core)
  (let ((marks {:homes {} :assigned {} :captured {} :try {}}))
    (box-walk! core (new-fn-id!) 0 marks)
    (for-each (fn (id)
                (if (or (get (marks :captured) id) (get (marks :try) id))
                    (put! boxed id #t)
                    (put! tracked id #t)))
              (array-to-list (keys (marks :assigned))))))

(def- (assigned-inside n)
  ;; Ids of the variables set anywhere inside n.
  (let ((found {}))
    (let walk ((m n))
      (when (eq? (m :op) :set) (put! found ((m :var) :id) #t))
      (core/for-each-child m walk))
    found))

(def- (refs-inside n ids)
  ;; Ids from table ids that n refers to anywhere inside.
  (let ((found {}))
    (let walk ((m n))
      (when (member-ref? m ids) (put! found ((m :var) :id) #t))
      (core/for-each-child m walk))
    found))

;; --- emitting --------------------------------------------------------------

(def- (block!)
  ;; The current block; after a terminator, a fresh unreachable one.
  (unless cur (set! cur (ir/add-block! out cur-fn)))
  cur)

(def- (emit code args &optional (aux nil) (pos nil))
  (ir/emit! out (block!) code args aux pos))

(def- (const v pos)
  (let ((x (emit 'const '() v pos)))
    (put! checked x #t)
    x))

(def- (name! v x)
  (unless (ir/value-name out v) (ir/set-value-name! out v (x :name)))
  v)

(def- (const-of v)
  ;; [value] when v is a const operation, else nil.
  (let ((site (ir/value-def out v)))
    (and (eq? (site 0) :op) (eq? (ir/op-code out (site 1)) 'const) [(ir/op-aux out (site 1))])))

;; --- joins -----------------------------------------------------------------

(def- (new-join result?)
  {:kind :join :snapshot (copy vals) :edges [] :result result?})

(def- (edge! j v)
  ;; Leave the current block open as an edge into j carrying value v.
  (push! (j :edges) [(block!) (copy vals) v])
  (set! cur nil))

(def- (finish! j)
  ;; Continue after join j; returns its result value when it has one.
  (let ((edges (j :edges))
        (snapshot (j :snapshot))
        (n (length (j :edges))))
    (cond
      ((= n 0)
       (set! cur (ir/add-block! out cur-fn))
       (set! vals (copy snapshot))
       (and (j :result) (ir/add-param! out cur)))
      ((= n 1)
       (let ((e (edges 0)))
         (set! cur (e 0))
         (set! vals (e 1))
         (e 2)))
      (else (let ((b (ir/add-block! out cur-fn))
                  (result (and (j :result) (ir/add-param! out b)))
                  (merged (copy snapshot))
                  (carried []))
              (for-each (fn (id)
                          (let ((v (((edges 0) 1) id)))
                            (cond
                              ((every? (fn (e) (= ((e 1) id) v)) (array-to-list edges)) (put! merged id v))
                              ((get tracked id)
                               (let ((p (carried-param! b id)))
                                 (put! merged id p)
                                 (push! carried id)))
                              (else (put! merged id (snapshot id))))))
                        (array-to-list (keys snapshot)))
              (for-each (fn (e)
                          (ir/jump! out
                                    (e 0)
                                    b
                                    (append (if result
                                                (list (e 2))
                                                '())
                                            (map (fn (id) ((e 1) id)) (array-to-list carried)))))
                        (array-to-list edges))
              (set! cur b)
              (set! vals merged)
              result)))))

(def- (carried-param! b id)
  ;; A new parameter of b for variable id's value.
  (let ((p (ir/add-param! out b)))
    (when (get var-names id) (ir/set-value-name! out p (var-names id)))
    p))

(def- (test-k then else)
  {:kind :test :then then :else else})

(def- (test? k)
  (and (table? k) (eq? (k :kind) :test)))

(def- (swap k)
  (test-k (k :else) (k :then)))

(def- (refine! r bits)
  ;; r is [variable value] or nil: bind the variable to a refinement.
  (when r
    (let ((v (emit 'refine (list (r 1)) bits)))
      (when (get checked (r 1)) (put! checked v #t))
      (name! v (r 0))
      (put! vals ((r 0) :id) v))))

(def- (split! k terminate r bits)
  ;; End the current block with (terminate then else) and send each side to
  ;; k's joins, refining r (see refine!) with bits [if-true if-false].
  (let ((bt (ir/add-block! out cur-fn))
        (bf (ir/add-block! out cur-fn))
        (saved vals))
    (terminate (block!) bt bf)
    (set! vals (copy saved))
    (set! cur bt)
    (when bits (refine! r (bits 0)))
    (edge! (k :then) nil)
    (set! vals (copy saved))
    (set! cur bf)
    (when bits (refine! r (bits 1)))
    (edge! (k :else) nil)
    (set! vals saved)))

(def- (deliver v k)
  ;; Send value v to continuation k.
  (cond
    ((eq? k :return) (ir/return! out (block!) v) (set! cur nil))
    ((test? k) (branch-value! v k nil))
    (else (edge! k v))))

(def- (branch-value! v k r)
  (let ((c (const-of v)))
    (if c
        (edge! (if (or (nil? (c 0)) (eq? (c 0) #f))
                   (k :else)
                   (k :then))
               nil)
        (split! k (fn (b bt bf) (ir/branch! out b v bt bf)) r [types/t-truthy types/t-falsy]))))

;; --- variables -------------------------------------------------------------

(def- (bind! x v)
  (name! v x)
  (let ((id (x :id)))
    (put! var-names id (x :name))
    (cond
      ((get boxed id) (put! binds id {:kind :box :box (name! (emit 'box (list v)) x)}))
      (else (put! vals id v)))))

(def- (ancestor-or-self? g f)
  ;; Whether function g is f or encloses it.
  (let loop ((h f))
    (cond
      ((nil? h) #f)
      ((= h g) #t)
      (else (loop (ir/fn-parent out h))))))

(def- (read-var x pos)
  (let ((id (x :id))
        (v (get vals id)))
    (if v
        (if (and (x :unbound) (not (get checked v)))
            (let ((c (emit 'check-bound (list v) nil pos)))
              (put! checked c #t)
              (put! vals id c)
              c)
            v)
        (let ((b (get binds id)))
          (unless b (error (str "convert: unbound variable " (x :name))))
          (let ((kind (b :kind)))
            (cond
              ((eq? kind :box) (emit 'box-ref (list (b :box)) nil pos))
              ((eq? kind :member)
               (cond
                 ((and (b :fn) (ancestor-or-self? (b :fn) cur-fn)) (selfs (b :fn)))
                 ((b :closure) (b :closure))
                 ((b :box) (emit 'box-ref (list (b :box)) nil pos))
                 (else (error (str "convert: " (x :name) " used before its closure exists")))))
              (else (core/unsupported (str "reference to " (x :name) " outside a call")))))))))

(def- (write-var! x v pos)
  ;; Returns the set!'s value, nil.
  (let ((id (x :id)))
    (if (get boxed id)
        (emit 'box-set (list ((binds id) :box) v) nil pos)
        (begin
          (put! checked v #t)
          (put! vals id v)
          (const nil pos)))))

;; --- expressions -----------------------------------------------------------

(def- control-ops '(:if :seq :let :fix :try))

(def- (value n)
  ;; Convert n for its value; returns the value id.
  (if (memq (n :op) control-ops)
      (let ((j (new-join #t)))
        (conv n j)
        (finish! j))
      (expr n)))

(def- (effect n)
  (if (memq (n :op) control-ops)
      (let ((j (new-join #f)))
        (conv n j)
        (finish! j))
      (expr n)))

(def- (conv n k)
  ;; Convert n with continuation k.
  (let ((op (n :op)))
    (cond
      ((eq? op :if)
       (let ((tj (new-join #f))
             (ej (new-join #f)))
         (conv (n :test) (test-k tj ej))
         (finish! tj)
         (conv (n :then) k)
         (finish! ej)
         (conv (n :else) k)))
      ((eq? op :seq)
       (let loop ((es (n :exprs)))
         (if (pair? (cdr es))
             (begin
               (effect (car es))
               (loop (cdr es)))
             (conv (car es) k))))
      ((eq? op :let) (bind! (n :var) (value (n :value))) (conv (n :body) k))
      ((eq? op :fix)
       (if (contified? n)
           (conv-contified n k)
           (conv-escaping n k)))
      ((eq? op :try) (conv-try n k))
      ((eq? op :call) (conv-call n k))
      ((and (eq? op :primcall) (test? k)) (test-primcall n k))
      ((and (eq? op :ref) (test? k) (not (get boxed ((n :var) :id))))
       (let ((v (read-var (n :var) (n :pos)))) (branch-value! v k [(n :var) v])))
      (else (deliver (expr n) k)))))

(def- (expr n)
  ;; The value of a node that isn't a control form.
  (let ((op (n :op))
        (pos (n :pos)))
    (cond
      ((eq? op :const) (const (n :value) pos))
      ((eq? op :unbound) (emit 'unbound '() nil pos))
      ((eq? op :ref) (read-var (n :var) pos))
      ((eq? op :set) (write-var! (n :var) (value (n :value)) pos))
      ((eq? op :global) (emit 'global-ref '() (n :cell) pos))
      ((eq? op :gset) (emit 'global-set (list (value (n :value))) (n :cell) pos))
      ((eq? op :prim) (emit 'prim-ref '() (n :name) pos))
      ((eq? op :def)
       (let ((v (value (n :value))))
         (emit 'global-def (list v) (n :cell) pos)
         v))
      ((eq? op :primcall) (primcall (n :name) (map value (n :args)) pos))
      ((eq? op :call)
       (let ((j (new-join #t)))
         (conv-call n j)
         (finish! j)))
      ((eq? op :fn) (emit 'closure '() (convert-fn n nil) pos))
      ((eq? op :while) (conv-while n))
      ((eq? op :defer) (conv-defer n))
      (else (core/unsupported (str "Core node " op))))))

(def- (builtin-cell name)
  (%resolve-global 'otium.core name))

(def- (primcall name args pos)
  ;; A primop operation, or a call of the builtin's cell when the table
  ;; doesn't accept it.
  (if (prim-entry name (length args))
      (emit name args nil pos)
      (let ((ret (ir/add-block! out cur-fn))
            (result (ir/add-param! out ret)))
        (ir/call! out (block!) :global (builtin-cell name) args ret pos)
        (set! cur ret)
        result)))

(def- (test-primcall n k)
  (let ((name (n :name))
        (args (n :args))
        (pos (n :pos))
        (entry (prim-entry name (length args))))
    (cond
      ((and entry (eq? name 'not)) (conv (car args) (swap k)))
      ((nil? entry) (deliver (expr n) k))
      (else (let ((vs (map value args))
                  (r (and (pair? args)
                          (eq? ((car args) :op) :ref)
                          (not (get boxed (((car args) :var) :id)))
                          [((car args) :var) (car vs)]))
                  (bits (entry :refines)))
              (if (and (entry :branch) (= (length vs) (or (entry :vm-arity) -1)))
                  (split! k (fn (b bt bf) (ir/branch-prim! out b name vs bt bf)) r bits)
                  (let ((v (emit name vs nil pos)))
                    (if bits
                        (split! k (fn (b bt bf) (ir/branch! out b v bt bf)) r bits)
                        (branch-value! v k nil)))))))))

;; --- calls -----------------------------------------------------------------

(def- (simple? n)
  ;; True when evaluating n can't run unknown code or assign a global, so a
  ;; global callee may be read after it.
  (let ((op (n :op)))
    (cond
      ((memq op '(:const :ref :prim :global)) #t)
      ((eq? op :primcall)
       (let ((entry (prim-entry (n :name) (length (n :args)))))
         (and entry (not (prims/effect? entry :call)) (not (prims/effect? entry :switch)) (every? simple? (n :args)))))
      (else #f))))

(def- (tail-calls? n x count)
  ;; Whether Core n calls variable x with count arguments in tail position.
  (let ((op (n :op)))
    (cond
      ((eq? op :call) (and (eq? ((n :fn) :op) :ref) (eq? ((n :fn) :var) x) (= (length (n :args)) count)))
      ((eq? op :if) (or (tail-calls? (n :then) x count) (tail-calls? (n :else) x count)))
      ((eq? op :seq) (tail-calls? (last (n :exprs)) x count))
      ((memq op '(:let :fix)) (tail-calls? (n :body) x count))
      (else #f))))

(def- (self-loop-call? callee args)
  ;; A call of the running function to itself that can jump to its header.
  (and (eq? (callee :op) :ref)
       (let ((b (get binds ((callee :var) :id)))
             (loop (get self-loops cur-fn)))
         (and b loop (eq? (b :kind) :member) (eq? (b :fn) cur-fn) (= (length args) (loop 1))))))

(def- (conv-call n k)
  (let ((callee (n :fn))
        (args (n :args))
        (pos (n :pos)))
    (cond
      ((and (eq? (callee :op) :ref) (eq? (get (get binds ((callee :var) :id)) :kind) :contified))
       (let ((b (binds ((callee :var) :id)))
             (vs (map value args)))
         (ir/jump! out (block!) (b :block) (append vs (map (fn (id) (vals id)) (b :carried))))
         (set! cur nil)))
      ((and (eq? k :return) (self-loop-call? callee args))
       (let ((vs (map value args)))
         (ir/jump! out (block!) ((self-loops cur-fn) 0) vs)
         (set! cur nil)))
      ((eq? (callee :op) :prim) (conv (core/primcall (callee :name) args pos) k))
      (else (let ((global? (and (eq? (callee :op) :global) (<= (length args) 255) (every? simple? args)))
                  (fv (if global?
                          (callee :cell)
                          (value callee)))
                  (vs (map value args))
                  (kind (if global?
                            :global
                            :value)))
              (if (eq? k :return)
                  (begin
                    (ir/tail-call! out (block!) kind fv vs pos)
                    (set! cur nil))
                  (let ((ret (ir/add-block! out cur-fn))
                        (result (ir/add-param! out ret)))
                    (ir/call! out (block!) kind fv vs ret pos)
                    (set! cur ret)
                    (deliver result k))))))))

;; --- functions -------------------------------------------------------------

(def- (fn-name n)
  (and (n :name) (symbol->string (n :name))))

(def- (convert-fn n member)
  ;; A new IR function for :fn node n; returns its id. member is the binding
  ;; of the escaping fix member it is, or nil.
  (let ((saved-fn cur-fn)
        (saved-cur cur)
        (saved-vals vals)
        (f (ir/add-function! out (fn-name n) cur-fn (n :pos)))
        (entry (ir/add-block! out f))
        (required (map (fn (x) (name! (ir/add-param! out entry) x)) (n :params)))
        (optional (map (fn (o) (name! (ir/add-param! out entry) (car o))) (n :optionals)))
        (rest (and (n :rest) (name! (ir/add-param! out entry) (n :rest)))))
    (ir/set-signature! out
                       f
                       (append required
                               optional
                               (if rest
                                   (list rest)
                                   '()))
                       (length required)
                       (length optional)
                       (not (nil? rest)))
    (ir/set-entry! out f entry)
    (set! cur-fn f)
    (set! cur entry)
    ;; Unassigned values of the parent stay valid here; assigned ones are boxed.
    (set! vals (copy vals))
    (when member
      (put! member :fn f)
      (when (member :self-ref) (put! selfs f (emit 'self '()))))
    ;; A function that calls itself, with only required parameters, gets a
    ;; header block after its entry, so a tail call to itself is a jump.
    ;; Parameters are bound in the header, so boxes are fresh each time round.
    (let ((params (if (and member
                           (member :self-ref)
                           (null? optional)
                           (not rest)
                           (tail-calls? (n :body) (member :var) (length required)))
                      (let ((header (ir/add-block! out f)))
                        (let ((ps (map (fn (x) (name! (ir/add-param! out header) x)) (n :params))))
                          (ir/jump! out (block!) header required)
                          (set! cur header)
                          (put! self-loops f [header (length ps)])
                          ps))
                      required)))
      (each2 (fn (x v)
               (put! checked v #t)
               (bind! x v))
             (n :params)
             params))
    (when rest
      (put! checked rest #t)
      (bind! (n :rest) rest))
    (each2 (fn (o p)
             (let ((present (emit 'bound? (list p)))
                   (j (new-join #t))
                   (bt (ir/add-block! out f))
                   (bf (ir/add-block! out f)))
               (ir/branch! out (block!) present bt bf)
               (let ((saved vals))
                 (set! vals (copy saved))
                 (set! cur bt)
                 (edge! j p)
                 (set! vals (copy saved))
                 (set! cur bf)
                 (edge! j (value (cdr o))))
               (let ((v (finish! j)))
                 (put! checked v #t)
                 (bind! (car o) v))))
           (n :optionals)
           optional)
    (conv (n :body) :return)
    (set! cur-fn saved-fn)
    (set! cur saved-cur)
    (set! vals saved-vals)
    f))

;; --- fix -------------------------------------------------------------------

(def- (loop-carried n)
  ;; Tracked variables in scope that n assigns: a loop's header parameters.
  (let ((inside (assigned-inside n)))
    (filter (fn (id) (and (get tracked id) (get inside id))) (array-to-list (keys vals)))))

(def- (conv-contified n k)
  (let ((carried (loop-carried n))
        (entry-vals vals)
        (members (map (fn (b)
                        (let ((blk (ir/add-block! out cur-fn))
                              (params (map (fn (x) (name! (ir/add-param! out blk) x)) ((cdr b) :params)))
                              (carried-params (map (fn (id) (carried-param! blk id)) carried)))
                          (put! binds ((car b) :id) {:kind :contified :block blk :carried carried})
                          [b blk params carried-params]))
                      (n :bindings))))
    (conv (n :body) k)
    (for-each (fn (m)
                (let ((b (m 0))
                      (f (cdr b)))
                  (set! cur (m 1))
                  (set! vals (copy entry-vals))
                  (each2 (fn (id p) (put! vals id p)) carried (m 3))
                  (each2 (fn (x v)
                           (put! checked v #t)
                           (bind! x v))
                         (f :params)
                         (m 2))
                  (conv (f :body) k)))
              members)))

(def- (creation-order bindings deps)
  ;; Members in an order where each one's dependencies come first when
  ;; possible: repeatedly the first member whose dependencies all exist, or
  ;; the first remaining one when none does.
  (let ((done {})
        (order '())
        (left bindings))
    (while (pair? left)
      (let ((ready (filter (fn (b)
                             (every? (fn (id) (or (get done id) (= id ((car b) :id))))
                                     (array-to-list (keys (deps ((car b) :id))))))
                           left))
            (pick (if (pair? ready)
                      (car ready)
                      (car left))))
        (put! done ((car pick) :id) #t)
        (set! order (cons pick order))
        (set! left (filter (fn (b) (not (eq? b pick))) left))))
    (reverse order)))

(def- (conv-escaping n k)
  (let ((ids {})
        (deps {}))
    (for-each (fn (b) (put! ids ((car b) :id) #t)) (n :bindings))
    (for-each (fn (b) (put! deps ((car b) :id) (refs-inside (cdr b) ids))) (n :bindings))
    (let ((order (creation-order (n :bindings) deps))
          (made {})
          (needs-box {})
          (unbound nil))
      ;; A member needs a box when one created before it refers to it.
      (for-each (fn (b)
                  (let ((id ((car b) :id)))
                    (for-each (fn (other) (unless (or (= other id) (get made other)) (put! needs-box other #t)))
                              (array-to-list (keys (deps id))))
                    (put! made id #t)))
                order)
      (for-each (fn (b)
                  (let ((x (car b))
                        (id ((car b) :id))
                        (record {:kind :member :var x :fn nil :closure nil :box nil :self-ref (get (deps id) id)}))
                    (when (get needs-box id)
                      (unless unbound (set! unbound (emit 'unbound '())))
                      (put! record :box (name! (emit 'box (list unbound)) x)))
                    (put! binds id record)))
                (n :bindings))
      (for-each (fn (b)
                  (let ((x (car b))
                        (record (binds ((car b) :id)))
                        (f (convert-fn (cdr b) record))
                        (c (name! (emit 'closure '() f ((cdr b) :pos)) x)))
                    (put! checked c #t)
                    (put! record :closure c)
                    (when (record :box) (emit 'box-set (list (record :box) c)))))
                order)
      (conv (n :body) k))))

;; --- while, try, defer -----------------------------------------------------

(def- (conv-while n)
  (let ((carried (loop-carried n))
        (header (ir/add-block! out cur-fn))
        (params (map (fn (id) (carried-param! header id)) carried)))
    (ir/jump! out (block!) header (map (fn (id) (vals id)) carried))
    (set! cur header)
    (each2 (fn (id p) (put! vals id p)) carried params)
    (let ((tj (new-join #f))
          (ej (new-join #f)))
      (conv (n :test) (test-k tj ej))
      (finish! tj)
      (effect (n :body))
      (ir/jump! out (block!) header (map (fn (id) (vals id)) carried))
      (set! cur nil)
      (finish! ej)
      (const nil (n :pos)))))

(def- (conv-try n k)
  (let ((body (ir/add-block! out cur-fn))
        (handler (ir/add-block! out cur-fn))
        (condition (ir/add-param! out handler))
        (saved (copy vals)))
    (ir/try! out (block!) body handler)
    (set! cur body)
    (let ((v (value (n :body))))
      (emit 'pop-try '())
      (deliver v k))
    (set! cur handler)
    (set! vals saved)
    (put! checked condition #t)
    (let loop ((catches (n :catches)))
      (if (null? catches)
          (begin
            (emit 'raise (list condition))
            (ir/unreachable! out (block!))
            (set! cur nil))
          (let ((c (car catches))
                (pred (first c)))
            (if (nil? pred)
                (begin
                  (bind! (second c) condition)
                  (conv (third c) k))
                (let ((tj (new-join #f))
                      (ej (new-join #f)))
                  (test-catch pred condition (test-k tj ej))
                  (finish! tj)
                  (bind! (second c) condition)
                  (conv (third c) k)
                  (finish! ej)
                  (loop (cdr catches)))))))))

(def- (test-catch pred condition k)
  ;; Test (pred condition) with test continuation k.
  (let ((pos (pred :pos)))
    (cond
      ((and (eq? (pred :op) :prim) (prim-entry (pred :name) 1))
       (let ((entry (prims/lookup (pred :name))))
         (if (and (entry :branch) (= (or (entry :vm-arity) -1) 1))
             (split! k (fn (b bt bf) (ir/branch-prim! out b (pred :name) (list condition) bt bf)) nil nil)
             (branch-value! (emit (pred :name) (list condition) nil pos) k nil))))
      (else (let ((global? (eq? (pred :op) :global))
                  (fv (if global?
                          (pred :cell)
                          (value pred)))
                  (ret (ir/add-block! out cur-fn))
                  (result (ir/add-param! out ret)))
              (ir/call! out
                        (block!)
                        (if global?
                            :global
                            :value)
                        fv
                        (list condition)
                        ret
                        pos)
              (set! cur ret)
              (branch-value! result k nil))))))

(def- (conv-defer n)
  (let ((cleanup (convert-fn (synthetic-fn (n :cleanup) (n :pos)) nil))
        (c (emit 'closure '() cleanup (n :pos))))
    (emit 'push-cleanup (list c) nil (n :pos))
    (let ((v (value (n :body))))
      (emit 'run-cleanup '() nil (n :pos))
      v)))

;; --- entry -----------------------------------------------------------------

(def (run core)
  "The block IR for a unit's Core tree: one function per fn, and first the
unit's entry function, with no parameters, for the top-level form."
  (reset!)
  (decide-contification! core)
  (decide-boxes! core)
  (let ((f (ir/add-function! out nil nil (core :pos)))
        (entry (ir/add-block! out f)))
    (ir/set-signature! out f '() 0 0 #f)
    (ir/set-entry! out f entry)
    (set! cur-fn f)
    (set! cur entry)
    (conv core :return)
    (let ((result out))
      (reset!)
      result)))
