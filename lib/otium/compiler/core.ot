;; lint: allow-file(unbound-name) %resolve-global, %global-cell, %cell-info and %form-offset are C runtime builtins
(ns otium.compiler.core)

;; Core is the tree the front end works on. Resolve builds it from one
;; expanded top-level form; Inline rewrites it; Convert turns it into the
;; block IR. Nodes are tables with an :op key, and any node may have :pos, a
;; source offset. Every lexical variable is a table of its own, shared by its
;; binding and all its references:
;;
;;   {:name sym :id n :refs n :sets n :captured bool}
;;
;; :refs and :sets count references and assignments, and :captured is true
;; when a reference or assignment is inside a nested fn. annotate! recomputes
;; all three. A variable with :unbound #t starts out unbound (a letrec
;; variable that Fixing Letrec couldn't make a let or fix), so reading it
;; must check.
;;
;; Nodes:
;;   {:op :const :value v}
;;   {:op :unbound}                     the unbound marker, only as a :let value
;;   {:op :ref :var x}                  lexical reference
;;   {:op :set :var x :value e}         lexical assignment; value nil
;;   {:op :global :cell id :name sym}   global reference; sym is qualified
;;   {:op :gset :cell id :name sym :value e}
;;   {:op :prim :name sym :cell id}     a builtin used as a value
;;   {:op :primcall :name sym :args (e ...)}
;;                                      a call whose head is a builtin's own cell
;;   {:op :call :fn e :args (e ...)}
;;   {:op :if :test e :then e :else e}
;;   {:op :seq :exprs (e ...)}          two or more expressions
;;   {:op :fn :params (x ...) :optionals ((x . e) ...) :rest x :body e :name sym}
;;                                      :rest and :name may be missing;
;;                                      defaults see earlier parameters
;;   {:op :let :var x :value e :body e} one binding
;;   {:op :fix :bindings ((x . fn) ...) :body e}
;;                                      mutually recursive functions; each x
;;                                      is unassigned and each value a :fn
;;   {:op :while :test e :body e}       value nil
;;   {:op :try :body e :catches ((pred x e) ...)}
;;                                      a condition no pred accepts is raised
;;                                      again
;;   {:op :defer :body e :cleanup e}    defer and unwind-protect
;;   {:op :def :kind def|def- :cell id :name sym :doc s :value e}
;;                                      top level only; :doc may be missing

;; --- unsupported forms -----------------------------------------------------

(def (unsupported what)
  "Raise the condition that makes the driver compile a form with compiler.c."
  (error {:type :core-unsupported :message (str "optimizer: unsupported " what) :what what}))

(def (unsupported? c)
  (and (table? c) (eq? (condition-type c) :core-unsupported)))

;; --- variables -------------------------------------------------------------

(def- var-counter 0)

(def (make-var name)
  (set! var-counter (+ var-counter 1))
  {:name name :id var-counter :refs 0 :sets 0 :captured #f})

(def (copy-var x)
  "A fresh variable like x, for passes that copy code."
  (let ((y (make-var (x :name))))
    (put! y :sets (x :sets))
    (when (x :unbound) (put! y :unbound #t))
    y))

(def (assigned? x)
  (> (x :sets) 0))

;; --- nodes -----------------------------------------------------------------

(def (node op &optional (fields {}) (pos nil))
  (put! fields :op op)
  (when pos (put! fields :pos pos))
  fields)

(def (const value &optional (pos nil))
  (node :const {:value value} pos))

(def (ref x &optional (pos nil))
  (node :ref {:var x} pos))

(def (primcall name args &optional (pos nil))
  (node :primcall {:name name :args args} pos))

(def (call f args &optional (pos nil))
  (node :call {:fn f :args args} pos))

(def (make-if test then else &optional (pos nil))
  (node :if {:test test :then then :else else} pos))

(def (make-let x value body &optional (pos nil))
  (node :let {:var x :value value :body body} pos))

(def (make-fix bindings body &optional (pos nil))
  (node :fix {:bindings bindings :body body} pos))

(def (make-fn params optionals rest body &optional (name nil) (pos nil))
  (let ((n (node :fn {:params params :optionals optionals :body body} pos)))
    (when rest (put! n :rest rest))
    (when name (put! n :name name))
    n))

(def (make-seq exprs &optional (pos nil))
  "A sequence of exprs, flattened; an empty one is nil."
  (let ((flat (flatten-seq exprs)))
    (cond
      ((null? flat) (const nil pos))
      ((null? (cdr flat)) (car flat))
      (else (node :seq {:exprs flat} pos)))))

(def- (flatten-seq exprs)
  (if (pair? exprs)
      (let ((e (car exprs)))
        (if (eq? (e :op) :seq)
            (append (e :exprs) (flatten-seq (cdr exprs)))
            (cons e (flatten-seq (cdr exprs)))))
      '()))

(def (const? n)
  (eq? (n :op) :const))

(def (truthy-const? n)
  (and (const? n) (not (nil? (n :value))) (not (eq? (n :value) #f))))

(def (falsy-const? n)
  (and (const? n) (or (nil? (n :value)) (eq? (n :value) #f))))

(def (node-size n)
  "Number of nodes in n, for inlining budgets."
  (let ((total 1))
    (for-each-child n (fn (c) (set! total (+ total (node-size c)))))
    total))

;; --- traversal -------------------------------------------------------------

(def (for-each-child n f)
  "Call f on each child expression of n in evaluation order."
  (let ((op (n :op)))
    (cond
      ((member op '(:const :unbound :ref :global :prim)) nil)
      ((member op '(:set :gset :def)) (f (n :value)))
      ((eq? op :primcall) (for-each f (n :args)))
      ((eq? op :call) (f (n :fn)) (for-each f (n :args)))
      ((eq? op :if) (f (n :test)) (f (n :then)) (f (n :else)))
      ((eq? op :seq) (for-each f (n :exprs)))
      ((eq? op :fn) (for-each (fn (o) (f (cdr o))) (n :optionals)) (f (n :body)))
      ((eq? op :let) (f (n :value)) (f (n :body)))
      ((eq? op :fix) (for-each (fn (b) (f (cdr b))) (n :bindings)) (f (n :body)))
      ((eq? op :while) (f (n :test)) (f (n :body)))
      ((eq? op :try)
       (f (n :body))
       (for-each (fn (c)
                   (f (first c))
                   (f (third c)))
                 (n :catches)))
      ((eq? op :defer) (f (n :body)) (f (n :cleanup)))
      (else (error (str "core: unknown node " op))))))

(def (bound-vars n)
  "Variables n binds for its children."
  (let ((op (n :op)))
    (cond
      ((eq? op :fn)
       (append (n :params)
               (map car (n :optionals))
               (if (n :rest)
                   (list (n :rest))
                   '())))
      ((eq? op :let) (list (n :var)))
      ((eq? op :fix) (map car (n :bindings)))
      ((eq? op :try) (map second (n :catches)))
      (else '()))))

;; --- annotation ------------------------------------------------------------
;;
;; Each variable remembers the number of the fn it's bound in as :home, so a
;; use from another fn marks it captured.

(def- fn-counter 0)

(def (annotate! n)
  "Recompute :refs, :sets and :captured on the variables n binds. Returns n."
  (set! fn-counter (+ fn-counter 1))
  (annotate-walk n fn-counter)
  n)

(def- (annotate-bind! x home)
  (put! x :refs 0)
  (put! x :sets 0)
  (put! x :captured #f)
  (put! x :home home))

(def- (annotate-use! x home key)
  (put! x key (+ (or (x key) 0) 1))
  (unless (eq? (x :home) home) (put! x :captured #t)))

(def- (annotate-walk n home)
  (let ((op (n :op)))
    (cond
      ((eq? op :ref) (annotate-use! (n :var) home :refs))
      ((eq? op :set) (annotate-use! (n :var) home :sets) (annotate-walk (n :value) home))
      ((eq? op :fn)
       (set! fn-counter (+ fn-counter 1))
       (let ((inner fn-counter))
         (for-each (fn (x) (annotate-bind! x inner)) (bound-vars n))
         (for-each-child n (fn (c) (annotate-walk c inner)))))
      (else (for-each (fn (x) (annotate-bind! x home)) (bound-vars n))
            (for-each-child n (fn (c) (annotate-walk c home)))))))

;; --- Resolve ---------------------------------------------------------------
;;
;; env is an alist from symbols to variables. pos is the offset of the
;; nearest located form around, given to nodes whose own form has none.

(def- resolve-ns 'user)

(def- cell-infos {})

(def- (cell-info id)
  (or (get cell-infos id)
      (let ((info (%cell-info id)))
        (put! cell-infos id info)
        info)))

(def- (position form outer)
  (or (and (pair? form) (%form-offset form)) outer))

(def (resolve form space)
  "The Core tree for expanded top-level form, compiled in namespace space."
  (set! resolve-ns space)
  (set! cell-infos {})
  (annotate! (resolve-top form nil)))

(def- (resolve-top form outer)
  (let ((pos (position form outer))
        (head (and (pair? form) (car form))))
    (cond
      ((member head '(def def-)) (resolve-def form pos))
      ((eq? head 'begin) (make-seq (map (fn (f) (resolve-top f pos)) (cdr form)) pos))
      (else (parse form '() pos)))))

(def- (doc-string forms)
  ;; The docstring at the front of forms, when more forms follow it.
  (and (pair? forms) (string? (car forms)) (pair? (cdr forms)) (car forms)))

;; (def name value), (def name "doc" value), (def (name . params) ["doc"] body ...)
(def- (resolve-def form pos)
  (let ((target (second form))
        (name (if (pair? target)
                  (car target)
                  target))
        (rest (cdr (cdr form)))
        (doc (doc-string rest)))
    (unless (and (symbol? name) (pair? rest)) (unsupported "malformed definition"))
    (let ((cell (%global-cell resolve-ns name))
          (value (cond
                   ((pair? target) (parse-fn (cdr target) rest '() pos name))
                   ((null? (cdr rest)) (parse (car rest) '() pos))
                   ((and doc (null? (cdr (cdr rest)))) (parse (second rest) '() pos))
                   (else (unsupported "malformed definition"))))
          (n (node :def {:kind (car form) :cell cell :name ((cell-info cell) :name) :value (name-fn value name)} pos)))
      (when doc (put! n :doc doc))
      n)))

(def- (name-fn n sym)
  (when (and (eq? (n :op) :fn) (nil? (n :name))) (put! n :name sym))
  n)

(def- (lookup sym env)
  (let ((entry (assq sym env)))
    (if entry
        (cdr entry)
        nil)))

(def- (bind sym env)
  (cons (cons sym (make-var sym)) env))

;; Heads compiler.c treats as forms whatever they're bound to. Those not
;; handled in parse-special are unsupported.
(def- special-heads
  '(quote quasiquote
          unquote
          unquote-splicing
          syntax-quote
          if
          cond
          when
          unless
          begin
          fn
          let
          set!
          def
          def-
          defonce
          defparam
          defmacro
          ns
          require
          while
          and
          or
          try
          defer
          unwind-protect
          %call-with-cleanup
          restart-case
          handler-bind
          with-params
          defclass
          defabstract
          reset-class!
          defgeneric
          reset-generic!
          defmethod))

(def (parse form env pos)
  "Core for an expanded expression in lexical environment env."
  (cond
    ((symbol? form) (parse-symbol form env pos))
    ((pair? form) (parse-compound form env (position form pos)))
    ((null? form) (const '() pos))
    (else (const form pos))))

(def- (parse-symbol sym env pos)
  (let ((x (lookup sym env)))
    (if x
        (begin
          (put! x :refs (+ (x :refs) 1))
          (ref x pos))
        (global-node sym pos))))

(def- (global-node sym pos)
  (let ((cell (%resolve-global resolve-ns sym))
        (info (cell-info cell)))
    (if (info :builtin)
        (node :prim {:name (info :builtin) :cell cell} pos)
        (node :global {:cell cell :name (info :name)} pos))))

(def- (parse-all forms env pos)
  (map (fn (f) (parse f env pos)) forms))

(def- (parse-compound form env pos)
  (let ((head (car form)))
    (cond
      ((and (symbol? head) (memq head special-heads)) (parse-special form env pos))
      ((and (symbol? head) (not (lookup head env)))
       (let ((callee (global-node head pos))
             (args (parse-all (cdr form) env pos)))
         (if (eq? (callee :op) :prim)
             (primcall (callee :name) args pos)
             (call callee args pos))))
      (else (call (parse head env pos) (parse-all (cdr form) env pos) pos)))))

(def- (parse-special form env pos)
  (let ((head (car form)))
    (cond
      ((eq? head 'quote) (const (second form) pos))
      ((eq? head 'quasiquote) (parse-quasi (second form) 1 env pos))
      ((eq? head 'if)
       (make-if (parse (second form) env pos)
                (parse (third form) env pos)
                (if (= (length form) 4)
                    (parse (nth form 3) env pos)
                    (const nil pos))
                pos))
      ((eq? head 'begin) (make-seq (parse-all (cdr form) env pos) pos))
      ((eq? head 'fn) (parse-fn (second form) (cdr (cdr form)) env pos nil))
      ((eq? head 'let) (parse-let form env pos))
      ((eq? head 'and) (parse-and (cdr form) env pos))
      ((eq? head 'or) (parse-or (cdr form) env pos))
      ((eq? head 'cond) (parse-cond (cdr form) env pos))
      ((eq? head 'while)
       (node :while {:test (parse (second form) env pos) :body (make-seq (parse-all (cdr (cdr form)) env pos) pos)}
             pos))
      ((eq? head 'set!) (parse-set form env pos))
      ((eq? head 'try) (parse-try form env pos))
      ((member head '(defer unwind-protect))
       (node :defer {:body (parse (second form) env pos) :cleanup (make-seq (parse-all (cdr (cdr form)) env pos) pos)}
             pos))
      (else (unsupported head)))))

(def- (parse-set form env pos)
  (let ((target (second form))
        (x (lookup target env))
        (value (parse (third form) env pos)))
    (if x
        (begin
          (put! x :sets (+ (x :sets) 1))
          (node :set {:var x :value value} pos))
        (let ((g (global-node target pos))) (node :gset {:cell (g :cell) :name (g :name) :value value} pos)))))

;; Parameters are names, possibly dotted or a bare rest symbol, or names then
;; &optional and (name default) pairs. A string with more body after it is a
;; docstring.
(def- (parse-fn params body env pos name)
  (let ((required '())
        (optionals '())
        (rest nil)
        (scope env)
        (ps params)
        (in-optionals #f))
    (while (pair? ps)
      (let ((p (car ps)))
        (cond
          ((eq? p '&optional) (set! in-optionals #t))
          (in-optionals (unless (and (pair? p) (symbol? (car p))) (unsupported "malformed parameter list"))
                        (let ((default (parse (second p) scope pos)))
                          (set! scope (bind (first p) scope))
                          (set! optionals (cons (cons (cdr (car scope)) default) optionals))))
          ((symbol? p) (set! scope (bind p scope)) (set! required (cons (cdr (car scope)) required)))
          (else (unsupported "malformed parameter list"))))
      (set! ps (cdr ps)))
    (when (symbol? ps)
      (set! scope (bind ps scope))
      (set! rest (cdr (car scope))))
    (make-fn (reverse required)
             (reverse optionals)
             rest
             (parse-body (if (doc-string body)
                             (cdr body)
                             body)
                         scope
                         pos)
             name
             pos)))

;; A body is definitions followed by expressions; the expander has already
;; put the definitions first and added nil when the body ends with one.
(def- (parse-body forms env pos)
  (let ((defs (definitions forms)))
    (if (null? defs)
        (make-seq (parse-all forms env pos) pos)
        (let ((names (map definition-name defs))
              (scope env))
          (check-distinct names)
          (for-each (fn (sym) (set! scope (bind sym scope))) names)
          (let ((bindings (map (fn (d)
                                 (let ((dpos (position d pos)))
                                   (list (lookup (definition-name d) scope) (definition-value d scope dpos) dpos)))
                               defs))
                (body (make-seq (parse-all (list-tail forms (length defs)) scope pos) pos)))
            (fix-letrec bindings body pos))))))

(def- (definition-name d)
  (if (pair? (second d))
      (car (second d))
      (second d)))

(def- (definition-value d env pos)
  (let ((target (second d))
        (rest (cdr (cdr d))))
    (cond
      ((pair? target) (parse-fn (cdr target) rest env pos (car target)))
      ((and (pair? rest) (null? (cdr rest))) (name-fn (parse (car rest) env pos) target))
      ((and (doc-string rest) (null? (cdr (cdr rest)))) (name-fn (parse (second rest) env pos) target))
      (else (unsupported "malformed definition")))))

(def- (definitions forms)
  (if (and (pair? forms) (pair? (car forms)) (eq? (car (car forms)) 'def))
      (cons (car forms) (definitions (cdr forms)))
      '()))

(def- (check-distinct names)
  (when (pair? names)
    (when (memq (car names) (cdr names)) (unsupported "repeated body definition"))
    (check-distinct (cdr names))))

;; --- Fixing Letrec ---------------------------------------------------------
;;
;; Body definitions and named let have letrec* semantics: values are
;; evaluated in order with every variable in scope. After "Fixing Letrec" by
;; Waddell, Sarkar and Dybvig and its "Reloaded" sequel by Ghuloum and
;; Dybvig. A lambda binding is an unassigned variable bound to a fn.
;;
;; In order: lambdas wait. A non-lambda value that can only reach (directly,
;; or through the lambdas it refers to) variables already bound, or waiting
;; lambdas, becomes a let, after a fix of the lambdas it reaches. From the
;; first value that can reach anything else, the remaining non-lambda
;; variables are bound to the unbound marker around one fix of the lambdas
;; still waiting, then assigned in order. Values whose variable is never
;; used are only evaluated.

(def- (lambda-binding? b)
  (and (eq? ((second b) :op) :fn) (not (assigned? (first b)))))

(def- (group-refs n group)
  ;; Variables of group that n refers to or assigns, anywhere inside.
  (let ((found '()))
    (let walk ((m n))
      (when (and (member (m :op) '(:ref :set)) (memq (m :var) group) (not (memq (m :var) found)))
        (set! found (cons (m :var) found)))
      (for-each-child m walk))
    found))

(def- (fix-letrec bindings body pos)
  (let ((group (map first bindings))
        (direct {})
        (lambdas {}))
    (for-each (fn (b)
                (put! direct ((first b) :id) (group-refs (second b) group))
                (when (lambda-binding? b) (put! lambdas ((first b) :id) #t)))
              bindings)
    (let ((reach (fn (x)
                   (let ((seen '())
                         (todo (direct (x :id))))
                     (while (pair? todo)
                       (let ((y (car todo)))
                         (set! todo (cdr todo))
                         (unless (memq y seen)
                           (set! seen (cons y seen))
                           (when (get lambdas (y :id)) (set! todo (append (direct (y :id)) todo))))))
                     seen)))
          (done '())
          (pending '())
          (segments '())
          (rest bindings)
          (stuck #f))
      (while (and (pair? rest) (not stuck))
        (let ((b (car rest)))
          (if (lambda-binding? b)
              (begin
                (set! pending (append pending (list b)))
                (set! rest (cdr rest)))
              (let ((reached (reach (first b))))
                (if (every? (fn (y) (or (memq y done) (any? (fn (p) (eq? (first p) y)) pending))) reached)
                    (let ((now (filter (fn (p) (memq (first p) reached)) pending)))
                      (when (pair? now)
                        (set! segments (cons (cons :fix now) segments))
                        (set! done (append (map first now) done))
                        (set! pending (filter (fn (p) (not (memq (first p) reached))) pending)))
                      (set! segments (cons (list :let b) segments))
                      (set! done (cons (first b) done))
                      (set! rest (cdr rest)))
                    (set! stuck #t))))))
      (reduce (fn (inner s)
                (if (eq? (car s) :fix)
                    (make-fix (map (fn (b) (cons (first b) (second b))) (cdr s)) inner pos)
                    (let ((b (second s))) (make-let (first b) (second b) inner (third b)))))
              (complex-letrec (append pending rest) body pos)
              segments))))

(def- (complex-letrec bindings body pos)
  (let ((unused? (fn (b) (and (= ((first b) :refs) 0) (= ((first b) :sets) 0))))
        (fns (filter lambda-binding? bindings))
        (others (filter (fn (b) (not (lambda-binding? b))) bindings))
        (inits (map (fn (b)
                      (if (unused? b)
                          (second b)
                          (begin
                            (put! (first b) :sets (+ ((first b) :sets) 1))
                            (node :set {:var (first b) :value (second b)} (third b)))))
                    others))
        (inner (make-seq (append inits (list body)) pos))
        (fixed (if (null? fns)
                   inner
                   (make-fix (map (fn (b) (cons (first b) (second b))) fns) inner pos))))
    (reduce (fn (acc b)
              (if (unused? b)
                  acc
                  (begin
                    (put! (first b) :unbound #t)
                    (make-let (first b) (node :unbound {} pos) acc pos))))
            fixed
            (reverse others))))

(def- (every? f xs)
  (or (null? xs) (and (f (car xs)) (every? f (cdr xs)))))

(def- (any? f xs)
  (and (pair? xs) (or (f (car xs)) (any? f (cdr xs)))))

;; --- let, and, or, cond, try -----------------------------------------------

(def- (parse-let form env pos)
  (if (symbol? (second form))
      ;; Named let: initializers see the outer scope, the body sees the loop.
      (let ((inits (map (fn (b) (parse (second b) env pos)) (third form)))
            (scope (bind (second form) env))
            (loop (cdr (car scope)))
            (function (parse-fn (map first (third form)) (cdr (cdr (cdr form))) scope pos (second form))))
        (put! loop :refs (+ (loop :refs) 1))
        (fix-letrec (list (list loop function pos)) (call (ref loop pos) inits pos) pos))
      (parse-let-bindings (second form) (cdr (cdr form)) env pos)))

(def- (parse-let-bindings bindings body env pos)
  (if (pair? bindings)
      (let ((b (car bindings))
            (value (parse (second b) env pos))
            (scope (bind (first b) env)))
        (make-let (cdr (car scope)) (name-fn value (first b)) (parse-let-bindings (cdr bindings) body scope pos) pos))
      (parse-body body env pos)))

(def- (temp-var name)
  ;; A variable Resolve introduces and refers to twice.
  (let ((x (make-var name)))
    (put! x :refs 2)
    x))

;; (and a b) is (let ((t a)) (if t b t)) and (or a b) is (let ((t a)) (if t t
;; b)), as both return the deciding operand's own value.
(def- (parse-and forms env pos)
  (cond
    ((null? forms) (const #t pos))
    ((null? (cdr forms)) (parse (car forms) env pos))
    (else (let ((t (temp-var 'and)))
            (make-let t
                      (parse (car forms) env pos)
                      (make-if (ref t pos) (parse-and (cdr forms) env pos) (ref t pos) pos)
                      pos)))))

(def- (parse-or forms env pos)
  (cond
    ((null? forms) (const #f pos))
    ((null? (cdr forms)) (parse (car forms) env pos))
    (else (let ((t (temp-var 'or)))
            (make-let t
                      (parse (car forms) env pos)
                      (make-if (ref t pos) (ref t pos) (parse-or (cdr forms) env pos) pos)
                      pos)))))

;; Clauses are (test body ...), (test) for the test's own value, or (else
;; body ...). compiler.c gives => no meaning, so neither does this.
(def- (parse-cond clauses env pos)
  (if (null? clauses)
      (const nil pos)
      (let ((c (car clauses))
            (cpos (position c pos)))
        (cond
          ((eq? (car c) 'else) (make-seq (parse-all (cdr c) env cpos) cpos))
          ((null? (cdr c))
           (let ((t (temp-var 'test)))
             (make-let t
                       (parse (car c) env cpos)
                       (make-if (ref t cpos) (ref t cpos) (parse-cond (cdr clauses) env pos) cpos)
                       cpos)))
          (else (make-if (parse (car c) env cpos)
                         (make-seq (parse-all (cdr c) env cpos) cpos)
                         (parse-cond (cdr clauses) env pos)
                         cpos))))))

;; (try body ... (catch (pred var) handler ...) ...)
(def- (parse-try form env pos)
  (let ((parts (cdr form))
        (body '())
        (catches '()))
    (while (and (pair? parts) (not (and (pair? (car parts)) (eq? (car (car parts)) 'catch))))
      (set! body (cons (car parts) body))
      (set! parts (cdr parts)))
    (for-each (fn (c)
                (let ((guard (second c))
                      (cpos (position c pos))
                      (scope (bind (second guard) env)))
                  (set! catches
                        (cons (list (parse (first guard) env cpos)
                                    (cdr (car scope))
                                    (parse-body (cdr (cdr c)) scope cpos))
                              catches))))
              parts)
    (let ((protected (make-seq (parse-all (reverse body) env pos) pos)))
      (if (null? catches)
          protected
          (node :try {:body protected :catches (reverse catches)} pos)))))

;; --- quasiquote ------------------------------------------------------------
;;
;; Lowered to cons and append with constant parts kept as constants, as
;; compiler.c does. Only unquotes at depth 1 are evaluated.

(def- (core-call name args pos)
  ;; A call to otium.core/name: a primcall when it's a builtin.
  (let ((callee (global-node (symbol (str "otium.core/" name)) pos)))
    (if (eq? (callee :op) :prim)
        (primcall (callee :name) args pos)
        (call callee args pos))))

(def- (qq-marker? x)
  (memq x '(quasiquote unquote unquote-splicing)))

(def- (parse-quasi x depth env pos)
  (cond
    ((not (pair? x)) (const x pos))
    ((and (qq-marker? (car x)) (pair? (cdr x)) (null? (cdr (cdr x)))) (parse-quasi-marker x depth env pos))
    (else (let ((head (car x))
                (tail (parse-quasi (cdr x) depth env pos)))
            (if (and (= depth 1) (pair? head) (eq? (car head) 'unquote-splicing))
                (let ((spliced (parse (second head) env pos)))
                  (if (and (const? tail) (null? (tail :value)))
                      spliced
                      (core-call 'append (list spliced tail) pos)))
                (qq-cons (parse-quasi head depth env pos) tail pos))))))

(def- (parse-quasi-marker x depth env pos)
  (let ((marker (car x)))
    (cond
      ((and (eq? marker 'unquote) (= depth 1)) (parse (second x) env pos))
      ((and (eq? marker 'unquote-splicing) (= depth 1)) (unsupported "unquote-splicing outside a list"))
      (else (qq-cons (const marker pos)
                     (qq-cons (parse-quasi (second x)
                                           (if (eq? marker 'quasiquote)
                                               (+ depth 1)
                                               (- depth 1))
                                           env
                                           pos)
                              (const '() pos)
                              pos)
                     pos)))))

(def- (qq-cons head tail pos)
  (if (and (const? head) (const? tail))
      (const (cons (head :value) (tail :value)) pos)
      (core-call 'cons (list head tail) pos)))

;; --- printing --------------------------------------------------------------

(def (show n)
  "A datum for reading Core tree n. Variables print as name.k, numbered in
order of appearance; a call to a builtin prints as (name arg ...)."
  (let ((names {})
        (count 0)
        (var-name (fn (x)
                    (or (get names (x :id))
                        (begin
                          (set! count (+ count 1))
                          (put! names (x :id) (symbol (str (x :name) "." count)))
                          (names (x :id)))))))
    (let show-node ((n n))
      (let ((op (n :op))
            (all (fn (xs) (map show-node xs))))
        (cond
          ((eq? op :const)
           (let ((v (n :value)))
             (if (or (number? v) (string? v) (boolean? v))
                 v
                 (list 'quote v))))
          ((eq? op :unbound) '(unbound))
          ((eq? op :ref) (var-name (n :var)))
          ((eq? op :set) (list 'set! (var-name (n :var)) (show-node (n :value))))
          ((eq? op :global) (list 'global (n :name)))
          ((eq? op :gset) (list 'gset! (n :name) (show-node (n :value))))
          ((eq? op :prim) (list 'prim (n :name)))
          ((eq? op :primcall) (cons (n :name) (all (n :args))))
          ((eq? op :call) (cons 'call (cons (show-node (n :fn)) (all (n :args)))))
          ((eq? op :if) (list 'if (show-node (n :test)) (show-node (n :then)) (show-node (n :else))))
          ((eq? op :seq) (cons 'begin (all (n :exprs))))
          ((eq? op :fn)
           (let ((params (map var-name (n :params)))
                 (optionals (map (fn (o) (list (var-name (car o)) (show-node (cdr o)))) (n :optionals)))
                 (rest (and (n :rest) (var-name (n :rest)))))
             (list 'fn
                   (append params
                           (if (pair? optionals)
                               (cons '&optional optionals)
                               '())
                           (if rest
                               (list '& rest)
                               '()))
                   (show-node (n :body)))))
          ((eq? op :let) (list 'let (list (list (var-name (n :var)) (show-node (n :value)))) (show-node (n :body))))
          ((eq? op :fix)
           (list 'fix (map (fn (b) (list (var-name (car b)) (show-node (cdr b)))) (n :bindings)) (show-node (n :body))))
          ((eq? op :while) (list 'while (show-node (n :test)) (show-node (n :body))))
          ((eq? op :try)
           (cons 'try
                 (cons (show-node (n :body))
                       (map (fn (c)
                              (list 'catch (list (show-node (first c)) (var-name (second c))) (show-node (third c))))
                            (n :catches)))))
          ((eq? op :defer) (list 'defer (show-node (n :body)) (show-node (n :cleanup))))
          ((eq? op :def) (list (n :kind) (n :name) (show-node (n :value))))
          (else (list 'unknown op)))))))
