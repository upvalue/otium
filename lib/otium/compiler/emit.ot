(ns otium.compiler.emit)

;; Emit: allocated LIR (see select.ot and allocate.ot) to the VM unit that
;; %vm-install takes (docs/optimizer.md, "VM units"). Blocks go in layout
;; order; a jump to the next block is left out, and a two-way branch puts
;; the jump on whichever side doesn't fall through. Jump targets are fixed
;; up once every block's first word is known. Each instruction with a source
;; position adds a point at its first word.
;;
;; A child function's :captures come from the CLOSURE that makes it. When a
;; function is made at several sites, every site must capture from the same
;; registers and parent captures; otherwise the unit is unsupported (an
;; allocation that lines them up is future work).

(require otium.compiler.core :as core)
(require otium.compiler.vm-ops :as vm-ops)

(def- (unsupported what)
  (core/unsupported (str "vm emit: " what)))

(def (run lir)
  "The unit array for %vm-install."
  (let ((fns (lir :functions))
        (captures (let ((a []))
                    (dotimes (i (length (lir :functions)))
                      (push! a nil))
                    a)))
    (let ((descs (map (fn (lfn) (emit-function lfn captures)) (array-to-list fns))))
      (list-to-array (map (fn (d)
                            (put! d :captures (or (captures (d :index)) []))
                            (put! d :index nil)
                            d)
                          descs)))))

(def- (emit-function lfn captures)
  (let ((code [])
        (reg (lfn :reg))
        (blocks (lfn :blocks))
        (starts [])
        (fixups []) ; [word-index block-index]
        (points [])
        (bi 0))
    (def (r v)
      (let ((x (reg v)))
        (when (nil? x) (error (str "vm emit: vreg " v " has no register")))
        x))
    (def (here)
      (quotient (length code) 5))
    (def (op! name operands)
      (vm-ops/encode! code name operands))
    (def (jump-to! name operands b)
      "Emit name, whose last operand is a target, aimed at block b."
      (let ((w (op! name (append operands (list 0)))))
        (push! fixups [w (resolve b)])
        w))
    ;; A block other than the entry with no instructions that only jumps on,
    ;; with no moves, emits nothing: references to it go where it leads.
    (def (trivial? i)
      (let ((blk (blocks i)))
        (and (> i 0) (= 0 (length (blk :instrs))) (eq? ((blk :term) :op) :jump) (null? ((blk :term) :moves)))))
    (def (resolve b)
      (let loop ((b b)
                 (n 0))
        (if (and (trivial? b) (< n (length blocks)))
            (loop (((blocks b) :term) :target) (+ n 1))
            b)))
    (def (next? b)
      (let loop ((i (+ bi 1)))
        (cond
          ((>= i (length blocks)) #f)
          ((and (trivial? i) (not (= (resolve i) i))) (loop (+ i 1)))
          (else (= (resolve b) i)))))
    (def (moves! ms)
      (for-each (fn (m) (op! :move (list (car m) (cadr m)))) ms))
    (def (point! pos)
      (when (and pos (or (= 0 (length points)) (not (= ((points (- (length points) 1)) 1) pos))))
        (push! points [(here) pos])))
    (def (call! instr tail)
      (moves! (instr :moves))
      (let ((w (instr :window))
            (n (length (instr :args)))
            (kind (instr :kind)))
        (cond
          ((and (eq? kind :global) (<= n vm-ops/max-call-global-args))
           (op! (if tail
                    :tail-call-global
                    :call-global)
                (list n w (instr :callee))))
          (else (cond
                  ((eq? kind :global) (op! :global (list w (instr :callee))))
                  ((eq? kind :const) (op! :const (list w (instr :callee)))))
                (op! (if tail
                         :tail-call
                         :call)
                     (list w n))))
        (unless tail (moves! (instr :post-moves)))))
    (def (closure! instr)
      (let ((caps (list-to-array (map (fn (c)
                                        (if (eq? (car c) :reg)
                                            [(r (cadr c)) #t]
                                            [(cadr c) #f]))
                                      (instr :captures))))
            (child (instr :fn)))
        (let ((old (captures child)))
          (when (and old (not (equal? old caps)))
            (unsupported "a function made at several sites from different registers"))
          (put! captures child caps))
        (op! :closure (list (r (instr :dst)) child))))
    (def (instr! instr)
      (point! (instr :pos))
      (let ((o (instr :op))
            (us (instr :uses))
            (d (instr :dst)))
        (cond
          ((eq? o :imm) (op! :imm (list (r d) (instr :bits))))
          ((eq? o :const) (op! :const (list (r d) (instr :k))))
          ((eq? o :global) (op! :global (list (r d) (instr :cell))))
          ((eq? o :set-global) (op! :set-global (list (r (car us)) (instr :cell))))
          ((eq? o :define-global) (op! :define-global (list (r (car us)) (instr :cell))))
          ((eq? o :upvalue) (op! :upvalue (list (r d) (instr :index))))
          ((eq? o :box) (unless (= (r d) (r (car us))) (op! :move (list (r d) (r (car us))))) (op! :box (list (r d))))
          ((eq? o :unbox) (op! :unbox (list (r d) (r (car us)))))
          ((eq? o :set-box) (op! :set-box (list (r (car us)) (r (cadr us)))))
          ((eq? o :check) (op! :check (list (r (car us)))))
          ((eq? o :closure) (closure! instr))
          ((eq? o :prim) (op! (instr :vm) (cons (r d) (map r us))))
          ((eq? o :addi) (op! :addi (list (r d) (r (car us)) (instr :imm))))
          ((eq? o :bound)
           ;; JBOUND v +3; IMM d #f; JUMP +4; IMM d #t
           (let ((at (here)))
             (op! :jbound (list (r (car us)) (+ at 3)))
             (op! :imm (list (r d) (vm-ops/bits-of #f)))
             (op! :jump (list (+ at 4)))
             (op! :imm (list (r d) (vm-ops/bits-of #t)))))
          ((eq? o :end-try) (op! :end-try '()))
          ((eq? o :cleanup) (op! :cleanup (list (r (car us)) 0)))
          ((eq? o :run-cleanup) (op! :run-cleanup '()))
          ((eq? o :call) (call! instr #f))
          (else (error (str "vm emit: unknown instruction " o))))))
    (def (two-way! then else emit-test)
      "emit-test is (fn (flag target) ...): it emits a test that jumps to target when the test equals flag."
      (cond
        ((next? then) (emit-test 0 else))
        ((next? else) (emit-test 1 then))
        (else (emit-test 0 else) (jump-to! :jump '() then))))
    (def (term! t)
      (point! (t :pos))
      (let ((o (t :op))
            (us (t :uses)))
        (cond
          ((eq? o :jump) (moves! (t :moves)) (unless (next? (t :target)) (jump-to! :jump '() (t :target))))
          ((eq? o :branch)
           (two-way! (t :then)
                     (t :else)
                     (fn (flag target)
                       (jump-to! (if (= flag 0)
                                     :jfalse
                                     :jtrue)
                                 (list (r (car us)))
                                 target))))
          ((and (eq? o :br) (eq? (t :vm) :jbound))
           (cond
             ((next? (t :else)) (jump-to! :jbound (list (r (car us))) (t :then)))
             (else (let ((at (here)))
                     (op! :jbound (list (r (car us)) (+ at 2)))
                     (jump-to! :jump '() (t :else))
                     (unless (next? (t :then)) (jump-to! :jump '() (t :then)))))))
          ((eq? o :br)
           (let ((vm (t :vm)))
             (two-way! (t :then)
                       (t :else)
                       (fn (flag target)
                         (op! vm
                              (cons flag
                                    (append (map r us)
                                            (cond
                                              ((contains? t :imm) (list (t :imm)))
                                              ((contains? t :k) (list (t :k)))
                                              (else '())))))
                         (jump-to! :jump '() target)))))
          ((eq? o :call) (call! t #f) (unless (next? (t :ret)) (jump-to! :jump '() (t :ret))))
          ((eq? o :tail-call) (call! t #t))
          ((eq? o :return) (op! :return (list (r (car us)))))
          ((eq? o :return-imm) (op! :return-imm (list (t :bits))))
          ((eq? o :try)
           (let ((hp (car ((blocks (t :handler)) :params))))
             (jump-to! :try (list (r hp)) (t :handler))
             (unless (next? (t :body)) (jump-to! :jump '() (t :body)))))
          ((eq? o :raise) (op! :raise (list (r (car us)))))
          (else (op! :return-imm (list (vm-ops/bits-of nil)))))))
    (dotimes (i (length blocks))
      (set! bi i)
      (push! starts (here))
      (let ((blk (blocks i)))
        (unless (and (trivial? i) (not (= (resolve i) i)))
          (for-each instr! (array-to-list (blk :instrs)))
          (term! (blk :term)))))
    (for-each (fn (f) (vm-ops/patch-bc! code (f 0) (starts (f 1)))) (array-to-list fixups))
    {:index (lfn :index)
     :name (lfn :name)
     :arity (lfn :arity)
     :optional (lfn :optional)
     :rest (lfn :rest)
     :locals (lfn :locals)
     :code code
     :constants (lfn :constants)
     :statics (lfn :statics)
     :points points}))
