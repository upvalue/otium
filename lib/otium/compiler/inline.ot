(ns otium.compiler.inline)
(require (otium.compiler.core :as core))

;; Inlining and simplification in one walk over Core, after Waddell and
;; Dybvig's "Fast and Effective Procedure Inlining" (the cp0 pass in Chez
;; Scheme). It does constant folding, copy propagation, inlining of local
;; functions, dead binding removal and if simplification together, because
;; each enables the others. Globals are never inlined: a user function may
;; be redefined, and the other forms of its module aren't in this unit.
;;
;; Every expression is visited in a context saying how its value is used:
;;   :value   the value is needed
;;   :test    only its truthiness is needed
;;   :effect  the value is ignored
;;
;; The walk copies: every binding in the output gets a fresh variable, so
;; inlining the same function twice gives two independent copies. env maps
;; an input variable's id to a binding {:var output-variable :operand op}.
;;
;; A let's value isn't visited where it's bound but as an operand, the first
;; time something needs it. A reference can then use what the operand turned
;; into: a constant or another unassigned variable is copied in place, and a
;; function is inlined where it's called. When the body no longer refers to
;; the variable, the binding is dropped, keeping the value only for its
;; effects.
;;
;; Inlining has two limits: effort, the number of nodes visited while trying,
;; and size, how big the inlined result may be. Exceeding either abandons
;; that inlining attempt and leaves the call as it was.
;;
;; The result's :refs, :sets and :captured counts are recomputed at the end,
;; so they're exact.

(def size-limit 20)

(def effort-limit 200)

;; --- builtins --------------------------------------------------------------
;;
;; What Inline needs to know about a builtin comes from prim-facts, so moving
;; to the primop table (prims.ot) changes only that function. Effects, from
;; weakest to strongest:
;;   :pure   no effects and never raises
;;   :alloc  returns a fresh object and never raises; droppable, never folded
;;           because the result has identity
;;   :check  no effects, but raises on bad arguments; folded on constants
;;   :read   reads mutable data and may raise; never folded or dropped
;; A builtin not listed is an arbitrary call. :type is the result's type
;; when it's always the same.

(def- prim-table {})

(def- (declare! effect fold type names)
  (for-each (fn (n) (put! prim-table n {:effect effect :fold fold :type type})) names))

(declare! :pure #t
          :boolean '(not eq?
                         eqv?
                         equal?
                         null?
                         pair?
                         nil?
                         number?
                         int?
                         float?
                         string?
                         symbol?
                         keyword?
                         char?
                         boolean?
                         procedure?
                         array?
                         table?
                         list?))
(declare! :check #t
          :number '(+ -
                      *
                      /
                      abs
                      min
                      max
                      quotient
                      remainder
                      modulo
                      floor
                      ceiling
                      round
                      truncate
                      bitwise-and
                      bitwise-ior
                      bitwise-xor
                      bitwise-not
                      char->integer
                      string-length))
(declare! :check #t :boolean '(< > <= >= = zero? string=? char=? char<?))
(declare! :check #t :char '(integer->char))
(declare! :alloc #f :pair '(cons))
(declare! :alloc #f nil '(list array table))
(declare! :read #f nil '(car cdr length get))

(def- (prim-facts name)
  ;; {:effect :fold :type} for builtin name, or nil.
  (get prim-table name))

(def- (prim-effect name)
  (let ((f (prim-facts name)))
    (if f
        (f :effect)
        :call)))

(def- (droppable? name)
  ;; True when an unused call to name can be removed, keeping its arguments.
  (member (prim-effect name) '(:pure :alloc)))

(def- (result-type name args)
  (cond
    ((eq? name 'list)
     (if (null? args)
         :null
         :pair))
    (else (let ((f (prim-facts name))) (and f (f :type))))))

;; The value of builtin name applied to constants, as (value), or nil when
;; it can't be folded: not foldable, it raises, or the result has identity.
(def- (fold name values)
  (let ((f (prim-facts name)))
    (when (and f (f :fold) (every? constant-argument? values))
      (let ((result (try
                      (list (apply (eval (symbol (str "otium.core/" name))) values))
                      (catch _ nil))))
        (when (and result (foldable-result? (car result))) result)))))

(def- (constant-argument? v)
  (or (foldable-result? v) (string? v) (null? v)))

(def- (foldable-result? v)
  (cond
    ((float? v) (= v v))
    (else (or (int? v) (nil? v) (boolean? v) (char? v) (keyword? v) (symbol? v)))))

;; --- types -----------------------------------------------------------------
;;
;; A type is one of :pair :null :nil :false :true :boolean :int :float :number
;; :string :symbol :keyword :char :array :table :fn. :boolean covers :true and
;; :false; :number covers :int and :float.

(def- (type-of-value v)
  (cond
    ((nil? v) :nil)
    ((eq? v #f) :false)
    ((eq? v #t) :true)
    ((int? v) :int)
    ((float? v) :float)
    ((pair? v) :pair)
    ((null? v) :null)
    ((string? v) :string)
    ((symbol? v) :symbol)
    ((keyword? v) :keyword)
    ((char? v) :char)
    (else #f)))

(def- (type-truthy? type)
  ;; #t when every value of type is truthy, #f when every one is falsy, else nil.
  (cond
    ((not type) nil)
    ((member type '(:nil :false)) #f)
    ((eq? type :boolean) nil)
    (else #t)))

(def- predicate-types
  {'pair? '(:pair)
   'null? '(:null)
   'nil? '(:nil)
   'array? '(:array)
   'table? '(:table)
   'string? '(:string)
   'symbol? '(:symbol)
   'keyword? '(:keyword)
   'char? '(:char)
   'int? '(:int)
   'float? '(:float)
   'number? '(:int :float :number)
   'boolean? '(:true :false :boolean)
   'procedure? '(:fn)})

(def- (type-predicate? name)
  (not (nil? (get predicate-types name))))

(def- (predicate-type name)
  ;; The type a true answer from predicate name proves, or nil.
  (let ((types (get predicate-types name))) (and types (last types))))

(def- (type-answer name type)
  ;; #t or #f when predicate name's answer follows from type, else nil.
  (let ((types (get predicate-types name)))
    (cond
      ((or (nil? types) (not type)) nil)
      ((member type types) #t)
      ((and (eq? type :number) (or (member :int types) (member :float types))) nil)
      ((and (eq? type :boolean) (or (member :true types) (member :false types))) nil)
      (else #f))))

;; --- state -----------------------------------------------------------------

;; Facts known to hold where the walk currently is, from the tests of the ifs
;; around it: a list of (variable-id key . answer), where key is a type
;; predicate name or :truthy.
(def- facts '())

;; Budgets of the inlining attempts in progress, innermost first.
(def- budgets '())

(def- budget-count 0)

(def- (with-facts extra thunk)
  (with-facts-replaced (append extra facts) thunk))

(def- (with-facts-replaced replacement thunk)
  (let ((saved facts))
    (set! facts replacement)
    (defer
      (thunk)
      (set! facts saved))))

(def- (charge!)
  (for-each (fn (b)
              (put! b :effort (- (b :effort) 1))
              (when (<= (b :effort) 0) (error {:type :inline-abort :message "inline: out of effort" :id (b :id)})))
            budgets))

(def- (abort-of? c id)
  (and (table? c) (eq? (condition-type c) :inline-abort) (= (c :id) id)))

(def- (fact var key)
  ;; The recorded answer for key on var: #t, #f, or nil when unknown.
  (let ((found nil)
        (fs facts))
    (while (and (nil? found) (pair? fs))
      (let ((f (car fs))) (when (and (eq? (car f) (var :id)) (eq? (car (cdr f)) key)) (set! found (cdr (cdr f)))))
      (set! fs (cdr fs)))
    found))

;; --- environments and operands ---------------------------------------------

(def- (lookup env x)
  (let ((entry (assq (x :id) env)))
    (if entry
        (cdr entry)
        nil)))

(def- (extend env x binding)
  (cons (cons (x :id) binding) env))

(def- (make-operand exp env)
  {:exp exp :env env :facts facts :state :new})

(def- (operand-value op)
  ;; The operand's expression visited for its value, once. nil while it's
  ;; being visited, which happens for recursive references.
  (let ((state (op :state)))
    (cond
      ((eq? state :done) (op :value))
      ((eq? state :pending) nil)
      (else (put! op :state :pending)
            (let ((v (try
                       (with-facts-replaced (op :facts) (fn () (visit (op :exp) :value (op :env))))
                       (catch problem
                         (put! op :state :new)
                         (error problem)))))
              (put! op :value v)
              (put! op :state :done)
              v)))))

(def- (residual-ref y pos)
  (put! y :refs (+ (y :refs) 1))
  (core/ref y pos))

(def- (copy-const v pos)
  (core/const (v :value) pos))

;; --- types of nodes --------------------------------------------------------

(def- (var-type y)
  ;; What's known about the type of output variable y.
  (let ((op (y :operand)))
    (or (known-type-from-facts y)
        (and op (not (core/assigned? y)) (eq? (op :state) :done) (node-type (op :value)))
        nil)))

(def- (known-type-from-facts y)
  (let ((found nil)
        (fs facts))
    (while (and (nil? found) (pair? fs))
      (let ((f (car fs)))
        (when (and (eq? (car f) (y :id)) (eq? (cdr (cdr f)) #t) (type-predicate? (car (cdr f))))
          (set! found (predicate-type (car (cdr f))))))
      (set! fs (cdr fs)))
    found))

(def- (node-type n)
  ;; The type of n's value when it's known, else nil.
  (let ((op (n :op)))
    (cond
      ((eq? op :const) (type-of-value (n :value)))
      ((eq? op :fn) :fn)
      ((eq? op :prim) :fn)
      ((eq? op :primcall) (result-type (n :name) (n :args)))
      ((eq? op :ref)
       (if (core/assigned? (n :var))
           nil
           (var-type (n :var))))
      ((eq? op :seq) (node-type (last (n :exprs))))
      ((member op '(:let :fix)) (node-type (n :body)))
      ((eq? op :if)
       (let ((a (node-type (n :then)))
             (b (node-type (n :else))))
         (and a (eq? a b) a)))
      (else nil))))

(def- (truthiness n)
  ;; #t or #f when n's value is known to be truthy or falsy, else nil.
  (cond
    ((core/truthy-const? n) #t)
    ((core/falsy-const? n) #f)
    ((and (eq? (n :op) :ref) (not (core/assigned? (n :var))) (not (nil? (fact (n :var) :truthy))))
     (fact (n :var) :truthy))
    (else (type-truthy? (node-type n)))))

;; --- effects ---------------------------------------------------------------

(def- (effect-free? n)
  (member (n :op) '(:const :unbound :ref :prim :fn)))

(def- (effect-only n)
  ;; What remains of n when its value is ignored.
  (let ((op (n :op)))
    (cond
      ((effect-free? n) (core/const nil (n :pos)))
      ((and (eq? op :primcall) (droppable? (n :name))) (sequence (map effect-only (n :args)) (n :pos)))
      ((eq? op :seq) (sequence (map effect-only (n :exprs)) (n :pos)))
      ((eq? op :if)
       (let ((yes (effect-only (n :then)))
             (no (effect-only (n :else))))
         (if (and (core/const? yes) (core/const? no))
             (effect-only (n :test))
             (core/make-if (n :test) yes no (n :pos)))))
      (else n))))

(def- (sequence exprs &optional (pos nil))
  ;; A sequence of exprs without the effect-free ones before the last.
  (let ((flat (core/make-seq exprs pos)))
    (if (eq? (flat :op) :seq)
        (let ((kept '())
              (rest (flat :exprs)))
          (while (pair? (cdr rest))
            (unless (effect-free? (car rest)) (set! kept (cons (car rest) kept)))
            (set! rest (cdr rest)))
          (core/make-seq (reverse (cons (car rest) kept)) pos))
        flat)))

(def- (split-last n)
  ;; (prefix . last) for a sequence, (() . n) otherwise.
  (if (eq? (n :op) :seq)
      (let ((rev (reverse (n :exprs)))) (cons (reverse (cdr rev)) (car rev)))
      (cons '() n)))

;; --- visiting --------------------------------------------------------------

(def- (visit n ctx env)
  (charge!)
  (let ((out (visit-node n ctx env)))
    (when (and (n :pos) (nil? (out :pos))) (put! out :pos (n :pos)))
    out))

(def- (visit-node n ctx env)
  (let ((op (n :op))
        (pos (n :pos)))
    (cond
      ((eq? op :const)
       (if (eq? ctx :effect)
           (core/const nil pos)
           (copy-const n pos)))
      ((eq? op :unbound) (core/node :unbound {} pos))
      ((eq? op :ref) (visit-ref n ctx env))
      ((eq? op :set) (visit-set n env))
      ((eq? op :global) (core/node :global {:cell (n :cell) :name (n :name)} pos))
      ((eq? op :gset) (core/node :gset {:cell (n :cell) :name (n :name) :value (visit (n :value) :value env)} pos))
      ((eq? op :prim)
       (if (eq? ctx :effect)
           (core/const nil pos)
           (core/node :prim {:name (n :name) :cell (n :cell)} pos)))
      ((eq? op :primcall) (visit-primcall (n :name) (n :args) ctx env pos))
      ((eq? op :call) (visit-call n ctx env))
      ((eq? op :if) (visit-if n ctx env))
      ((eq? op :seq) (visit-seq (n :exprs) ctx env pos))
      ((eq? op :fn)
       (cond
         ((eq? ctx :effect) (core/const nil pos))
         ((eq? ctx :test) (core/const #t pos))
         (else (visit-fn n env))))
      ((eq? op :let) (visit-bindings (list (list (n :var) (n :value) env)) (n :body) env ctx pos))
      ((eq? op :fix) (visit-fix n ctx env))
      ((eq? op :while) (visit-while n env))
      ((eq? op :try) (visit-try n ctx env))
      ((eq? op :defer)
       (core/node :defer {:body (visit (n :body) (body-context ctx) env) :cleanup (visit (n :cleanup) :effect env)}
                  pos))
      ((eq? op :def)
       (let ((out (copy n)))
         (put! out :value (visit (n :value) :value env))
         out))
      (else (error (str "inline: unknown node " op))))))

(def- (body-context ctx)
  ;; A body whose value becomes the value of a form with a dynamic extent.
  ;; Its value still matters unless the form's doesn't.
  (if (eq? ctx :effect)
      :effect
      :value))

(def- (visit-ref n ctx env)
  (let ((x (n :var))
        (pos (n :pos))
        (b (lookup env x)))
    (cond
      ((eq? ctx :effect) (core/const nil pos))
      ((nil? b) (residual-ref x pos))
      ((core/assigned? x) (residual-ref (b :var) pos))
      (else (let ((y (b :var))
                  (op (b :operand))
                  (v (and op (operand-value op))))
              (cond
                ((and v (core/const? v)) (copy-const v pos))
                ((and v (eq? (v :op) :ref) (not (core/assigned? (v :var))) (not ((v :var) :unbound)))
                 (finish-ref (v :var) ctx pos))
                ((and v (eq? (v :op) :prim)) (core/node :prim {:name (v :name) :cell (v :cell)} pos))
                (else (finish-ref y ctx pos))))))))

(def- (finish-ref y ctx pos)
  (let ((known (and (eq? ctx :test) (truthiness (core/ref y)))))
    (if (and (eq? ctx :test) (not (nil? known)))
        (core/const known pos)
        (residual-ref y pos))))

(def- (visit-set n env)
  (let ((b (lookup env (n :var)))
        (y (if b
               (b :var)
               (n :var))))
    (core/node :set {:var y :value (visit (n :value) :value env)} (n :pos))))

(def- (visit-seq exprs ctx env pos)
  (let ((rev (reverse exprs))
        (init (map (fn (e) (visit e :effect env)) (reverse (cdr rev)))))
    (sequence (append init (list (visit (car rev) ctx env))) pos)))

(def- (visit-fn n env)
  (let ((inner env)
        (params (map (fn (x)
                       (let ((y (core/copy-var x)))
                         (set! inner (extend inner x {:var y}))
                         y))
                     (n :params)))
        (optionals (map (fn (o)
                          (let ((default (visit (cdr o) :value inner))
                                (y (core/copy-var (car o))))
                            (set! inner (extend inner (car o) {:var y}))
                            (cons y default)))
                        (n :optionals)))
        (rest (and (n :rest)
                   (let ((y (core/copy-var (n :rest))))
                     (set! inner (extend inner (n :rest) {:var y}))
                     y))))
    (core/make-fn params optionals rest (visit (n :body) :value inner) (n :name) (n :pos))))

(def- (visit-while n env)
  (let ((test (visit (n :test) :test env)))
    (if (core/falsy-const? test)
        (core/const nil (n :pos))
        (core/node :while {:test test :body (visit (n :body) :effect env)} (n :pos)))))

(def- (visit-try n ctx env)
  (let ((inner (body-context ctx)))
    (core/node :try {:body (visit (n :body) inner env)
                     :catches (map (fn (c)
                                     (let ((y (core/copy-var (second c))))
                                       (list (visit (first c) :value env)
                                             y
                                             (visit (third c) inner (extend env (second c) {:var y})))))
                                   (n :catches))}
               (n :pos))))

;; --- bindings --------------------------------------------------------------

(def- (visit-bindings bindings body body-env ctx pos)
  ;; bindings is a list of (variable expression expression-env), bound in
  ;; order; body is visited in body-env extended with all of them. Used for
  ;; let, and for inlining, where arguments and body have different envs.
  (if (null? bindings)
      (visit body ctx body-env)
      (let ((b (car bindings))
            (x (first b))
            (e (second b))
            (eenv (third b))
            (y (core/copy-var x)))
        (if (core/assigned? x)
            (let ((value (visit e :value eenv)))
              (core/make-let y value (visit-bindings (cdr bindings) body (extend body-env x {:var y}) ctx pos) pos))
            (let ((op (make-operand e eenv)))
              (put! y :operand op)
              (let ((inner (visit-bindings (cdr bindings) body (extend body-env x {:var y :operand op}) ctx pos)))
                (put! y :operand nil)
                (if (= (y :refs) 0)
                    (sequence (list (if (eq? (op :state) :done)
                                        (effect-only (op :value))
                                        (with-facts-replaced (op :facts) (fn () (visit e :effect eenv))))
                                    inner)
                              pos)
                    (core/make-let y (operand-value op) inner pos))))))))

(def- (group-recursive? bindings)
  ;; True when any binding's value refers to a variable of the group.
  (let ((vars (map car bindings))) (any? (fn (b) (refers-to-any? (cdr b) vars)) bindings)))

(def- (refers-to-any? n vars)
  (if (and (member (n :op) '(:ref :set)) (memq (n :var) vars))
      #t
      (let ((found #f))
        (core/for-each-child n (fn (c) (when (and (not found) (refers-to-any? c vars)) (set! found #t))))
        found)))

;; Bind the functions as operands, visit the body, then keep the functions
;; something still refers to, visiting each the first time it's needed.
(def- (visit-fix n ctx env)
  (let ((bindings (n :bindings))
        (ys (map (fn (b) (core/copy-var (car b))) bindings))
        (recursive (group-recursive? bindings))
        (ops (map (fn (b) (make-operand (cdr b) nil)) bindings))
        (inner env))
    (for-each-pair (fn (b y op)
                     (put! y :operand op)
                     (when recursive (put! y :recursive #t))
                     (set! inner (extend inner (car b) {:var y :operand op})))
                   bindings
                   ys
                   ops)
    (for-each (fn (op) (put! op :env inner)) ops)
    (let ((body (visit (n :body) ctx inner))
          (kept {})
          (changed #t))
      (while changed
        (set! changed #f)
        (for-each (fn (y)
                    (when (and (> (y :refs) 0) (not (get kept (y :id))))
                      (put! kept (y :id) (operand-value (y :operand)))
                      (set! changed #t)))
                  ys))
      (for-each (fn (y)
                  (put! y :operand nil)
                  (put! y :recursive nil))
                ys)
      (let ((residual (filter (fn (y) (get kept (y :id))) ys)))
        (if (null? residual)
            body
            (core/make-fix (map (fn (y) (cons y (kept (y :id)))) residual) body (n :pos)))))))

(def- (every? f xs)
  (or (null? xs) (and (f (car xs)) (every? f (cdr xs)))))

(def- (any? f xs)
  (and (pair? xs) (or (f (car xs)) (any? f (cdr xs)))))

(def- (for-each-pair f xs ys zs)
  (while (pair? xs)
    (f (car xs) (car ys) (car zs))
    (set! xs (cdr xs))
    (set! ys (cdr ys))
    (set! zs (cdr zs))))

(def- (map-pair f xs ys)
  (if (pair? xs)
      (let ((head (f (car xs) (car ys)))) (cons head (map-pair f (cdr xs) (cdr ys))))
      '()))

;; --- calls -----------------------------------------------------------------

(def- (simple-fn? f argc)
  (and (eq? (f :op) :fn) (null? (f :optionals)) (not (f :rest)) (= (length (f :params)) argc)))

(def- (inline-target y argc)
  ;; The operand holding the function output variable y is bound to, when it
  ;; can be inlined at a call with argc arguments.
  (let ((op (y :operand)))
    (and op
         (not (core/assigned? y))
         (not (y :recursive))
         (not (eq? (op :state) :pending))
         (simple-fn? (op :exp) argc)
         op)))

(def- (visit-call n ctx env)
  (let ((f (n :fn))
        (args (n :args))
        (argc (length args))
        (pos (n :pos)))
    (cond
      ;; ((fn (x ...) body) arg ...) is a let.
      ((simple-fn? f argc) (visit-bindings (pair-up (f :params) args env) (f :body) env ctx pos))
      ((eq? (f :op) :ref)
       (let ((b (lookup env (f :var)))
             (v (and b (not (core/assigned? (f :var))) (b :operand) (operand-value (b :operand))))
             (y (cond
                  ((nil? b) nil)
                  ((and v (eq? (v :op) :ref) (not (core/assigned? (v :var)))) (v :var))
                  (else (b :var))))
             (op (and y (inline-target y argc))))
         (cond
           ((and v (eq? (v :op) :prim)) (visit-primcall (v :name) args ctx env pos))
           (op (or (try-inline op args env ctx pos) (residual-call n ctx env)))
           (else (residual-call n ctx env)))))
      ((eq? (f :op) :prim) (visit-primcall (f :name) args ctx env pos))
      (else (residual-call n ctx env)))))

(def- (pair-up params args env)
  (map-pair (fn (x a) (list x a env)) params args))

(def- (residual-call n ctx env)
  (let ((f (visit (n :fn) :value env))
        (args (map (fn (a) (visit a :value env)) (n :args))))
    (if (eq? (f :op) :prim)
        (finish-primcall (f :name) args ctx (n :pos))
        (core/call f args (n :pos)))))

(def- (try-inline op args env ctx pos)
  ;; Visit the function's body with its parameters bound to the arguments.
  ;; nil when that takes too much effort or makes too much code.
  (let ((function (op :exp)))
    (when (<= (core/node-size (function :body)) (* size-limit 4))
      (set! budget-count (+ budget-count 1))
      (let ((budget {:id budget-count :effort effort-limit})
            (saved budgets)
            (mine? (fn (c) (abort-of? c (budget :id)))))
        (set! budgets (cons budget budgets))
        (let ((result (defer
                        (try
                          (visit-bindings (pair-up (function :params) args env) (function :body) (op :env) ctx pos)
                          (catch (mine? _) nil))
                        (set! budgets saved))))
          (when (and result
                     (<= (core/node-size result) (+ size-limit (reduce (fn (t a) (+ t (core/node-size a))) 0 args))))
            result))))))

;; --- builtins --------------------------------------------------------------

(def- (visit-primcall name args ctx env pos)
  (if (and (eq? ctx :effect) (droppable? name))
      (sequence (map (fn (a) (visit a :effect env)) args) pos)
      (finish-primcall name (map (fn (a) (visit a :value env)) args) ctx pos)))

(def- (finish-primcall name args ctx pos)
  ;; Simplify a call to builtin name on already visited args.
  (let ((argc (length args))
        (known (if (and (= argc 1) (type-predicate? name))
                   (predicate-answer name (car args))
                   nil))
        (folded (and (nil? known) (every? core/const? args) (fold name (map (fn (a) (a :value)) args)))))
    (cond
      ((not (nil? known)) (sequence (list (effect-only (car args)) (core/const known pos)) pos))
      (folded (core/const (car folded) pos))
      ((and (= argc 0) (eq? name 'list)) (core/const '() pos))
      ((and (eq? ctx :test) (droppable? name) (type-truthy? (result-type name args)))
       (sequence (append (map effect-only args) (list (core/const #t pos))) pos))
      (else (core/primcall name args pos)))))

(def- (predicate-answer name arg)
  (if (and (eq? (arg :op) :ref) (not (core/assigned? (arg :var))))
      (let ((recorded (fact (arg :var) name)))
        (if (nil? recorded)
            (type-answer name (node-type arg))
            recorded))
      (type-answer name (node-type arg))))

;; --- if --------------------------------------------------------------------

(def- (test-facts test answer)
  ;; Facts that hold when test's value has truthiness answer.
  (cond
    ((and (eq? (test :op) :ref) (not (core/assigned? (test :var))))
     (list (cons ((test :var) :id) (cons :truthy answer))))
    ((and (eq? (test :op) :primcall)
          (type-predicate? (test :name))
          (= (length (test :args)) 1)
          (eq? ((car (test :args)) :op) :ref)
          (not (core/assigned? ((car (test :args)) :var))))
     (let ((x ((car (test :args)) :var)))
       (if answer
           (list (cons (x :id) (cons (test :name) #t))
                 (cons (x :id) (cons :truthy (type-truthy? (predicate-type (test :name))))))
           (list (cons (x :id) (cons (test :name) #f))))))
    (else '())))

(def- (visit-if n ctx env)
  (let ((test (visit (n :test) :test env))
        (pos (n :pos))
        (parts (split-last test))
        (prefix (car parts))
        (last-test (cdr parts))
        (then-n (n :then))
        (else-n (n :else)))
    ;; (if (not e) a b) is (if e b a).
    (while (and (eq? (last-test :op) :primcall) (eq? (last-test :name) 'not) (= (length (last-test :args)) 1))
      (set! last-test (car (last-test :args)))
      (let ((t then-n))
        (set! then-n else-n)
        (set! else-n t)))
    (let ((known (truthiness last-test)))
      (if (not (nil? known))
          (sequence (append prefix
                            (list (effect-only last-test)
                                  (visit (if known
                                             then-n
                                             else-n)
                                         ctx
                                         env)))
                    pos)
          (let ((yes (with-facts (test-facts last-test #t) (fn () (visit then-n ctx env))))
                (no (with-facts (test-facts last-test #f) (fn () (visit else-n ctx env)))))
            (sequence (append prefix (list (simplify-if last-test yes no ctx pos))) pos))))))

(def- (simplify-if test yes no ctx pos)
  (cond
    ((and (eq? ctx :test) (core/truthy-const? yes) (core/falsy-const? no)) test)
    ((and (eq? ctx :test) (core/truthy-const? yes) (core/truthy-const? no))
     (sequence (list (effect-only test) (core/const #t pos)) pos))
    ((and (eq? ctx :effect) (core/const? yes) (core/const? no)) (effect-only test))
    ((and (core/const? yes) (core/const? no) (eq? (yes :value) (no :value)))
     (sequence (list (effect-only test) yes) pos))
    (else (core/make-if test yes no pos))))

;; --- dead bindings ---------------------------------------------------------
;;
;; The walk counts references as it makes them, including ones a later
;; simplification drops, so some dead bindings survive it. With exact counts,
;; remove a let whose variable is never read (keeping its value's effects and
;; turning assignments into their values) and fix functions nothing calls.

(def- (drop-dead n)
  (let ((op (n :op))
        (pos (n :pos))
        (dead? (fn (x) (= (x :refs) 0))))
    (cond
      ((and (eq? op :let) (dead? (n :var)))
       (set! changed #t)
       (sequence (list (effect-only (drop-dead (n :value))) (drop-dead (n :body))) pos))
      ((and (eq? op :set) (dead? (n :var))) (sequence (list (drop-dead (n :value)) (core/const nil pos)) pos))
      ((and (eq? op :fix) (any? (fn (b) (dead? (car b))) (n :bindings)))
       (set! changed #t)
       (let ((live (filter (fn (b) (not (dead? (car b)))) (n :bindings)))
             (body (drop-dead (n :body))))
         (if (null? live)
             body
             (core/make-fix (map (fn (b) (cons (car b) (drop-dead (cdr b)))) live) body pos))))
      (else (map-children n drop-dead)))))

(def- changed #f)

(def- (map-children n f)
  ;; n with f applied to each child expression.
  (let ((op (n :op))
        (out (copy n)))
    (cond
      ((member op '(:const :unbound :ref :global :prim)) nil)
      ((member op '(:set :gset :def)) (put! out :value (f (n :value))))
      ((eq? op :primcall) (put! out :args (map f (n :args))))
      ((eq? op :call) (put! out :fn (f (n :fn))) (put! out :args (map f (n :args))))
      ((eq? op :if) (put! out :test (f (n :test))) (put! out :then (f (n :then))) (put! out :else (f (n :else))))
      ((eq? op :seq) (put! out :exprs (map f (n :exprs))))
      ((eq? op :fn)
       (put! out :optionals (map (fn (o) (cons (car o) (f (cdr o)))) (n :optionals)))
       (put! out :body (f (n :body))))
      ((eq? op :let) (put! out :value (f (n :value))) (put! out :body (f (n :body))))
      ((eq? op :fix)
       (put! out :bindings (map (fn (b) (cons (car b) (f (cdr b)))) (n :bindings)))
       (put! out :body (f (n :body))))
      ((eq? op :while) (put! out :test (f (n :test))) (put! out :body (f (n :body))))
      ((eq? op :try)
       (put! out :body (f (n :body)))
       (put! out :catches (map (fn (c) (list (f (first c)) (second c) (f (third c)))) (n :catches))))
      ((eq? op :defer) (put! out :body (f (n :body))) (put! out :cleanup (f (n :cleanup))))
      (else (error (str "inline: unknown node " op))))
    (if (eq? op :seq)
        (sequence (out :exprs) (n :pos))
        out)))

;; --- entry -----------------------------------------------------------------

(def (run core)
  "Inline and simplify a unit's Core tree. Returns a new tree with exact
reference counts."
  (set! facts '())
  (set! budgets '())
  (let ((out (core/annotate! (visit core :value '()))))
    (set! changed #t)
    (while changed
      (set! changed #f)
      (set! out (core/annotate! (drop-dead out))))
    out))
