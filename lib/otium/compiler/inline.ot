;; inline.ot -- inlining, folding, copy propagation and dead code, on local code.
;;
;; One walk over a unit's tree, (simplify s node ctx), returns the node to use
;; instead. ctx is how the value is used: :value, :test (only its truth), or
;; :effect (thrown away). It follows Chez's cp0 at a smaller scale. See
;; scratch/optimizer-design.md, section 5.6.
;;
;; What it does:
;;
;;   - a call of a local bound by let or a body definition to a fn, never
;;     assigned, or of a fn written in place, becomes a let binding the
;;     parameters to the arguments around a copy of the body;
;;   - a let variable bound to a constant, or to another unassigned local, is
;;     replaced by it;
;;   - an unused binding is dropped when its initializer has no effects, and
;;     kept for its effects when it has;
;;   - a call of a :foldable builtin with constant arguments is run now, and
;;     left alone when it raises;
;;   - an if with a constant test keeps one branch; values thrown away are
;;     dropped when they have no effects.
;;
;; Function records are simplified in place; other nodes are rebuilt. The
;; pass leaves :captures and the variables' flags stale: run rescope after.
;;
;; Limits: an inline attempt that grows past its size limit raises an abort,
;; and the call stays. A unit has an effort limit, after which nothing more
;; is inlined. A function isn't inlined into itself, and functions that refer
;; to themselves or take optional or rest parameters aren't inlined.

(ns otium.compiler.inline
  (:require (otium.compiler.convert :as cv)
            (otium.compiler.ir :as ir)
            (otium.compiler.known :as known)
            (otium.compiler.options :as options)
            (otium.compiler.types :as types)))

;; --- State -------------------------------------------------------------------

;; The walk's state: env maps variable ids to bindings, refs counts the
;; references to each variable the result keeps, fn is the function being
;; simplified, effort the steps left for inlining, attempt the innermost
;; inline attempt or nil, inlining the functions being inlined, innermost
;; first, and facts the simple facts known about variables.
(defrecord State (env refs fn effort attempt inlining facts))

;; An inline attempt: the size of the copy so far, and the limit past which
;; it gives up.
(defrecord Attempt (size limit))

;; What the walk knows about a variable. kind is :const with value a
;; constant node, :copy with value an lref to put in its place, :fn with
;; value a [:fn] node to inline from and calls the number of calls of it,
;; :pending for a body definition not yet run, with lset its definition,
;; and :opaque. dropped marks a definition left out.
(defrecord Binding (kind value calls lset dropped))

(def- base-effort 2000)

(def (inline info)
  (let ((s (make-state :env {}
                       :refs {}
                       :fn info
                       :effort (options/scaled (+ base-effort (* 4 (node-size (cv/fn-body info)))))
                       :attempt nil
                       :inlining '()
                       :facts {})))
    (simplify-function s info)
    info))

(def (binding s var)
  (get (state-env s) (cv/var-id var)))

(def (bind! s var b)
  (put! (state-env s) (cv/var-id var) b))

(def (refs s var)
  (get (state-refs s) (cv/var-id var) 0))

(def (count-ref! s var)
  (put! (state-refs s) (cv/var-id var) (+ (refs s var) 1)))

;; The nodes directly inside node; for a fn, its defaults and body.
(def (children node)
  (let ((out []))
    (def (add! x)
      (when (array? x)
        (if (keyword? (get x 0))
            (push! out x)
            (for ((y :in x))
              (add! y)))))
    (if (eq? (get node 0) :fn)
        (let ((info (get node 2)))
          (for ((pair :in (cv/fn-optionals info)))
            (push! out (get pair 1)))
          (push! out (cv/fn-body info)))
        (for ((i :range 2 (length node)))
          (add! (get node i))))
    out))

;; Nodes in a tree, counting functions' bodies.
(def (node-size node)
  (if (memq (get node 0) '(:const :lref :gref :unbound))
      1
      (let ((n 1))
        (for ((c :in (children node)))
          (set! n (+ n (node-size c))))
        n)))

;; --- Facts about nodes -----------------------------------------------------------

(def (const? node)
  (eq? (get node 0) :const))

(def (truthy? value)
  (not (or (nil? value) (eq? value #f))))

(def (nothing off)
  [:const off nil])

;; An lref that can stand for its variable anywhere in the variable's scope:
;; no initialization check, never assigned, not a loop's name.
(def (copyable? node)
  (and (eq? (get node 0) :lref) (not (get node 3)) (let ((var (get node 2))) (not (or (cv/var-assigned var) (cv/var-loop var))))))

;; The table entry for a :prim or :known node.
(def (entry-of node)
  (known/entry (get node 2)))

(def (flag? e flag)
  (and e (memq flag (or (e :flags) '())) #t))

;; Whether evaluating node can do nothing but produce its value: no effects,
;; no raise.
(def (effect-free? node)
  (case (get node 0)
    ((:const :fn :unbound) #t)
    ((:lref) (not (get node 3)))
    ((:prim) (and (flag? (entry-of node) :flushable) (all? effect-free? (get node 3))))
    ((:known) (and (flag? (entry-of node) :flushable) (all? effect-free? (get node 4))))
    ((:if) (and (effect-free? (get node 2)) (effect-free? (get node 3)) (effect-free? (get node 4))))
    ((:seq) (all? effect-free? (get node 2)))
    ((:let) (and (all? effect-free? (get node 3)) (effect-free? (get node 4))))
    (else #f)))

(def (all? pred nodes)
  (let loop ((i 0)) (or (= i (length nodes)) (and (pred (get nodes i)) (loop (+ i 1))))))

;; What of node to evaluate when its value isn't needed, or nil for nothing.
(def (drop-value node)
  (cond
    ((effect-free? node) nil)
    ((and (eq? (get node 0) :prim) (flag? (entry-of node) :flushable)) (sequence (get node 1) (get node 3) nil))
    ((and (eq? (get node 0) :known) (flag? (entry-of node) :flushable)) (sequence (get node 1) (get node 4) nil))
    (else node)))

;; A node evaluating nodes for their effects, then last (nil for nothing).
(def (sequence off nodes last)
  (let ((out []))
    (for ((n :in nodes))
      (let ((d (drop-value n))) (when d (splice! out d))))
    (when last (splice! out last))
    (cond
      ((= (length out) 0)
       (if last
           last
           nil))
      ((= (length out) 1) (get out 0))
      (else [:seq off out]))))

(def (splice! out node)
  (if (eq? (get node 0) :seq)
      (for ((n :in (get node 2)))
        (push! out n))
      (push! out node)))

;; [effects constant] when node's value is a constant after some effects.
(def (constant-after node)
  (case (get node 0)
    ((:const) [[] node])
    ((:seq)
     (let ((nodes (get node 2)))
       (let ((last (get nodes (- (length nodes) 1))))
         (when (const? last) [(list-to-array (take (- (length nodes) 1) (array-to-list nodes))) last]))))
    (else nil)))

;; --- Folding -----------------------------------------------------------------

;; Constants a fold may take and give: no mutable objects, which a fold would
;; turn into one object shared by every evaluation.
(def (atom? x)
  (or (number? x) (boolean? x) (nil? x) (char? x) (keyword? x) (symbol? x) (string? x) (null? x)))

(def- procedures {})

(def (procedure-of name)
  (or (get procedures name)
      (let ((p (eval (string->symbol (str "otium.core/" name)))))
        (put! procedures name p)
        p)))

;; The constant node a call of the builtin name on args folds to, or nil.
(def (fold off name args)
  (let ((e (known/entry name)))
    (when (and (flag? e :foldable) (all? const? args))
      (let ((values (map (fn (a) (get a 2)) (array-to-list args))))
        ;; Strings and floats can be equal without being one object; which
        ;; ones are depends on how literals are stored.
        (when (and (all? atom? (list-to-array values))
                   (not (and (eq? name 'eq?) (find (fn (v) (or (string? v) (float? v))) values))))
          (let ((result (try
                          [(apply (procedure-of name) values)]
                          (catch _ nil))))
            (when (and result (atom? (get result 0)) (not (and (string? (get result 0)) (flag? e :allocates))))
              [:const off (get result 0)])))))))

;; --- Simple facts ----------------------------------------------------------------

;; What's known about variables without loop analysis (design 5.6): what a
;; variable is bound to, and in each branch of an if, what its test proves.
;; Only variables that are never assigned have facts, so a fact holds
;; wherever the variable is in scope, loops included. The types pass does
;; the rest, with loops.

(def (fact s var)
  (if (cv/var-assigned var)
      types/t-any
      (get (state-facts s) (cv/var-id var) types/t-any)))

;; Narrow var's fact to t.
(def (learn! s var t)
  (unless (or (cv/var-assigned var) (= t types/t-any))
    (put! (state-facts s) (cv/var-id var) (types/meet (fact s var) t))))

;; The type a value made in place has, as cons and array literals do.
(def (made-type node)
  (cond ((and (eq? (get node 0) :prim) (eq? (get node 2) 'cons)) types/t-pair)
        ((and (eq? (get node 0) :known) (eq? (get node 2) 'array)) types/t-array)
        (else types/t-any)))

;; The variable a test is about and the types it proves when true and when
;; false, or nil: a predicate that narrows, the variable itself, or not of
;; either.
(def (test-facts test)
  (case (get test 0)
    ((:lref)
     (and (not (get test 3))
          [(get test 2) (types/without types/t-any types/t-falsy) types/t-falsy]))
    ((:prim :known)
     (let ((name (get test 2)) (args (get test (if (eq? (get test 0) :prim) 3 4))))
       (cond
         ((and (eq? name 'not) (= (length args) 1))
          (let ((inner (test-facts (get args 0))))
            (and inner [(get inner 0) (get inner 2) (get inner 1)])))
         ((and (= (length args) 1) (eq? (get (get args 0) 0) :lref) (not (get (get args 0) 3))
               (types/narrows name))
          (let ((n (types/narrows name)))
            [(get (get args 0) 2) n (types/without types/t-any n)]))
         (else nil))))
    (else nil)))

;; Run thunk with what test proves when it's true (or false) added to the
;; facts, and take them back after.
(def (with-test-facts s test true? thunk)
  (let ((tf (test-facts test)))
    (if (or (nil? tf) (cv/var-assigned (get tf 0)))
        (thunk)
        (let ((var (get tf 0)) (facts (state-facts s)))
          (let ((id (cv/var-id var)) (old (get facts (cv/var-id var))))
            (put! facts id (types/meet (fact s var) (get tf (if true? 1 2))))
            (let ((out (thunk)))
              (put! facts id old)
              out))))))

;; A predicate that narrows, on a variable whose facts settle it: #t or #f.
(def (fold-by-fact s off name args)
  (when (and (= (length args) 1) (eq? (get (get args 0) 0) :lref) (not (get (get args 0) 3)))
    (let ((n (types/narrows name)))
      (when n
        (let ((r (types/predicate-result n (fact s (get (get args 0) 2)))))
          (cond ((= r types/t-true) [:const off #t])
                ((= r types/t-false) [:const off #f])
                (else nil)))))))

;; --- The walk ----------------------------------------------------------------

(def (step! s)
  (set-state-effort! s (- (state-effort s) 1))
  (let ((a (state-attempt s)))
    (when a
      (set-attempt-size! a (+ (attempt-size a) 1))
      (when (> (attempt-size a) (attempt-limit a)) (error abort-message a)))))

(def- abort-message "inline: over the size limit")

(def (abort? c)
  (and (error? c) (equal? (condition-message c) abort-message)))

(def (simplify s node ctx)
  (step! s)
  (let ((off (get node 1)))
    (case (get node 0)
      ((:const)
       (if (eq? ctx :effect)
           (nothing off)
           node))
      ((:lref) (simplify-ref s node ctx))
      ((:lset) (simplify-set s node))
      ((:gref :unbound :evaluator :class-object) node)
      ((:gset :gdef) [(get node 0) off (get node 2) (simplify s (get node 3) :value)])
      ((:if) (simplify-if s node ctx))
      ((:seq) (simplify-seq s off (get node 2) ctx))
      ((:let) (simplify-let s off (get node 2) (get node 3) (get node 4) ctx))
      ((:fn)
       (if (eq? ctx :effect)
           (nothing off)
           (begin
             (simplify-function s (get node 2))
             node)))
      ((:call) (simplify-call s node ctx))
      ((:prim)
       (let ((args (simplify-all s (get node 3))))
         (or (fold off (get node 2) args) (fold-by-fact s off (get node 2) args)
             (result [:prim off (get node 2) args] ctx))))
      ((:known)
       (let ((args (simplify-all s (get node 4))))
         (or (fold off (get node 2) args) (fold-by-fact s off (get node 2) args)
             (result [:known off (get node 2) (get node 3) args (get node 5)] ctx))))
      ((:gprim) [:gprim off (get node 2) (get node 3) (simplify-all s (get node 4))])
      ((:gcall :bcall)
       (or (inline-core s node ctx)
           (let ((new (copy node)))
             (put! new 3 (simplify-all s (get node 3)))
             new)))
      ((:loop) [:loop off (get node 2) (simplify-all s (get node 3)) (simplify s (get node 4) :value)])
      ((:recur) [:recur off (get node 2) (simplify-all s (get node 3))])
      ((:while) [:while off (simplify s (get node 2) :test) (simplify s (get node 3) :effect)])
      ((:try)
       [:try off
        (simplify s (get node 2) :value)
        (get node 3)
        (list-to-array (map (fn (clause)
                              [(and (get clause 0) (simplify s (get clause 0) :value))
                               (get clause 1)
                               (simplify s (get clause 2) :value)])
                            (array-to-list (get node 4))))])
      ((:cleanup)
       (let ((f (simplify s (get node 2) :value))) [:cleanup off f (get node 3) (simplify s (get node 4) :value)]))
      ((:handlers :params :restarts)
       (let ((clauses (list-to-array (map (fn (clause) (simplify-all s clause)) (array-to-list (get node 2))))))
         [(get node 0) off clauses (simplify s (get node 3) :value)]))
      ((:make-param) [:make-param off (simplify s (get node 2) :value) (simplify s (get node 3) :value)])
      (else (error "inline: unknown node" (get node 0))))))

(def (simplify-all s nodes)
  (list-to-array (map (fn (n) (simplify s n :value)) (array-to-list nodes))))

;; A call whose value is thrown away keeps only what has effects.
(def (result node ctx)
  (if (eq? ctx :effect)
      (or (drop-value node) (nothing (get node 1)))
      node))

(def (simplify-function s info)
  (let ((outer (state-fn s)))
    (set-state-fn! s info)
    (for ((pair :in (cv/fn-optionals info)))
      (put! pair 1 (simplify s (get pair 1) :value)))
    (cv/set-fn-body! info (simplify s (cv/fn-body info) :value))
    (set-state-fn! s outer)))

(def (simplify-ref s node ctx)
  (let ((var (get node 2)))
    (let ((b (and (not (cv/var-assigned var)) (binding s var))))
      (cond
        ((and b (eq? (binding-kind b) :const))
         (if (eq? ctx :effect)
             (nothing (get node 1))
             [:const (get node 1) (get (binding-value b) 2)]))
        ((and b (eq? (binding-kind b) :copy))
         (let ((target (binding-value b))) (simplify s [:lref (get node 1) (get target 2) #f] ctx)))
        ((and (eq? ctx :effect) (not (get node 3))) (nothing (get node 1)))
        (else (count-ref! s var) node)))))

;; An assignment, or the one that runs a body definition.
(def (simplify-set s node)
  (let ((var (get node 2))
        (value (simplify s (get node 3) :value)))
    (let ((b (binding s var))
          (new [:lset (get node 1) var value]))
      (if (and b (eq? (binding-kind b) :pending) (not (cv/var-assigned var)))
          (begin
            (set-binding-kind! b (kind-of value))
            (set-binding-value! b value)
            (set-binding-lset! b new))
          (count-ref! s var))
      new)))

;; How a variable bound to the simplified node can be replaced.
(def (kind-of node)
  (cond
    ((const? node) :const)
    ((copyable? node) :copy)
    ((eq? (get node 0) :fn) :fn)
    (else :opaque)))

(def (simplify-if s node ctx)
  (let ((off (get node 1))
        (test (simplify s (get node 2) :test)))
    (let ((known (constant-after test)))
      (if known
          (sequence off
                    (get known 0)
                    (simplify s
                              (get node
                                   (if (truthy? (get (get known 1) 2))
                                       3
                                       4))
                              ctx))
          (let ((then (with-test-facts s test #t (fn () (simplify s (get node 3) ctx))))
                (else (with-test-facts s test #f (fn () (simplify s (get node 4) ctx)))))
            (cond
              ((and (eq? ctx :effect) (effect-free? then) (effect-free? else)) (or (drop-value test) (nothing off)))
              ((and (eq? ctx :test) (const? then) (truthy? (get then 2)) (const? else) (not (truthy? (get else 2))))
               test)
              (else [:if off test then else])))))))

(def (simplify-seq s off nodes ctx)
  (let ((out [])
        (n (length nodes)))
    (dotimes (i n)
      (let ((last (= i (- n 1))))
        (let ((x (simplify s
                           (get nodes i)
                           (if last
                               ctx
                               :effect))))
          (if (eq? (get x 0) :seq)
              (for ((y :in (get x 2)))
                (push! out y))
              (push! out x)))))
    (let ((kept []))
      (dotimes (i (length out))
        (let ((x (get out i)))
          (unless (and (effect-free? x) (or (< i (- (length out) 1)) (eq? ctx :effect))) (push! kept x))))
      (cond
        ((= (length kept) 0) (nothing off))
        ((= (length kept) 1) (get kept 0))
        (else [:seq off kept])))))

;; --- let ---------------------------------------------------------------------

;; Initializers are simplified in order, except fns, which wait until the
;; body shows whether they are used other than by being inlined. Then from
;; the last binding back, since an initializer may use earlier variables:
;; a used binding is kept, an unused one is dropped or kept for its effects.
;; ready, when given, says which inits are simplified already.
(def (simplify-let s off vars inits body ctx &optional (ready nil))
  (let ((n (length vars))
        (values (list-to-array (map (fn (_) nil) (array-to-list vars))))
        (defs #f))
    (dotimes (i n)
      (let ((var (get vars i))
            (init (get inits i)))
        (cond
          ((and ready (get ready i))
           (put! values i init)
           (bind! s
                  var
                  (make-binding :kind (if (cv/var-assigned var) :opaque (kind-of init)) :value init)))
          ((eq? (get init 0) :unbound)
           (set! defs #t)
           (put! values i init)
           (bind! s
                  var
                  (make-binding :kind (if (cv/var-assigned var) :opaque :pending))))
          ((cv/var-assigned var) (put! values i (simplify s init :value)) (bind! s var (make-binding :kind :opaque)))
          ((eq? (get init 0) :fn) (bind! s var (make-binding :kind :fn :value init :calls (call-count body var))))
          ((copyable? init) (put! values i init) (bind! s var (make-binding :kind :copy :value init)))
          (else (let ((value (simplify s init :value)))
                  (put! values i value)
                  (learn! s var (made-type value))
                  (bind! s var (make-binding :kind (kind-of value) :value value)))))))
    (let ((body (simplify s body ctx))
          (segments '()))
      (when defs (set! body (drop-definitions s vars body)))
      (let loop ((i (- n 1)))
        (when (>= i 0)
          (let ((var (get vars i))
                (value (get values i)))
            (cond
              ((> (refs s var) 0)
               (when (or (nil? value) (eq? (binding-kind (binding s var)) :copy))
                 (set! value (simplify s (get inits i) :value)))
               (set! segments (cons [:bind var value] segments)))
              ((nil? value) nil)
              ((eq? (get value 0) :unbound)
               (unless (binding-dropped (binding s var)) (set! segments (cons [:bind var value] segments))))
              (else (let ((d (drop-value value))) (when d (set! segments (cons [:effect d] segments)))))))
          (loop (- i 1))))
      (build-let off segments body))))

;; Body definitions no one refers to, whose definitions have no effects: the
;; assignment that runs each is taken out of the body's sequence.
(def (drop-definitions s vars body)
  (let ((dropped []))
    (for ((var :in vars))
      (let ((b (binding s var)))
        (when (and (= (refs s var) 0) (binding-lset b) (effect-free? (get (binding-lset b) 3)))
          (cond
            ((eq? body (binding-lset b)) (set-binding-dropped! b #t) (set! body (nothing (get body 1))))
            ((and (eq? (get body 0) :seq) (memq (binding-lset b) (array-to-list (get body 2))))
             (set-binding-dropped! b #t)
             (push! dropped (binding-lset b)))))))
    (if (and (> (length dropped) 0) (eq? (get body 0) :seq))
        (let ((nodes (get body 2))
              (kept []))
          (dotimes (i (length nodes))
            (let ((x (get nodes i)))
              (cond
                ((not (memq x (array-to-list dropped))) (push! kept x))
                ((= i (- (length nodes) 1)) (push! kept (nothing (get x 1)))))))
          (cond
            ((= (length kept) 1) (get kept 0))
            (else [:seq (get body 1) kept])))
        body)))

;; Segments in order, [:bind var init] or [:effect node], around body.
;; Neighbouring bindings share a let.
(def (build-let off segments body)
  (let ((r body)
        (vars '())
        (inits '()))
    (def (close!)
      (unless (null? vars)
        (set! r [:let off (list-to-array vars) (list-to-array inits) r])
        (set! vars '())
        (set! inits '())))
    (for ((seg :in (reverse segments)))
      (if (eq? (get seg 0) :bind)
          (begin
            (set! vars (cons (get seg 1) vars))
            (set! inits (cons (get seg 2) inits)))
          (begin
            (close!)
            (set! r (sequence off [(get seg 1)] r)))))
    (close!)
    r))

;; --- Calls and inlining ----------------------------------------------------------

;; A fn bound to a variable that's called in more than one place is inlined
;; into each only when it's no bigger than this, so its body isn't copied
;; into every call.
(def- shared-fn-size 24)

;; How many calls of var node makes, inside functions too.
(def (call-count node var)
  (let ((n (if (and (eq? (get node 0) :call) (eq? (get (get node 2) 0) :lref) (eq? (get (get node 2) 2) var))
               1
               0)))
    (for ((c :in (children node))) (set! n (+ n (call-count c var))))
    n))

;; The [:fn] node a callee stands for, or nil.
(def (callee-fn s node)
  (case (get node 0)
    ((:fn) node)
    ((:lref)
     (let ((var (get node 2)))
       (let ((b (and (not (cv/var-assigned var)) (not (get node 3)) (binding s var))))
         (when b
           (case (binding-kind b)
             ((:fn) (when (or (<= (or (binding-calls b) 1) 1) (<= (node-size (binding-value b)) shared-fn-size)) (binding-value b)))
             ((:copy) (callee-fn s (binding-value b)))
             (else nil))))))
    (else nil)))

;; A call of a fn to inline. Its arguments are simplified first, outside the
;; attempt, apart from fns and copies, which the let binding the parameters
;; handles.
(def (simplify-call s node ctx)
  (let ((f (callee-fn s (get node 2)))
        (args (get node 3)))
    (if (and f (inlinable? s (get f 2) args))
        (let ((ready (list-to-array (map (fn (a) (not (or (eq? (get a 0) :fn) (copyable? a)))) (array-to-list args)))))
          (let ((prepared (map (fn (i)
                                 (if (get ready i)
                                     (simplify s (get args i) :value)
                                     (get args i)))
                               (range (length args)))))
            (or (try-inline s node (get f 2) prepared ready ctx)
                [:call (get node 1)
                 (simplify s (get node 2) :value)
                 (map (fn (i)
                        (if (get ready i)
                            (get prepared i)
                            (simplify s (get args i) :value)))
                      (range (length args)))
                 (get node 4)])))
        [:call (get node 1) (simplify s (get node 2) :value) (simplify-all s args) (get node 4)])))

(def (inlinable? s info args)
  (and (> (state-effort s) 0)
       (= (length (cv/fn-optionals info)) 0)
       (nil? (cv/fn-rest info))
       (= (length (cv/fn-params info)) (length args))
       (not (memq info (state-inlining s)))
       (not (and (cv/fn-self info) (mentions? (cv/fn-body info) (cv/fn-self info))))))

;; Whether node refers to var, inside functions too.
(def (mentions? node var)
  (if (and (memq (get node 0) '(:lref :lset)) (eq? (get node 2) var))
      #t
      (let ((cs (children node)))
        (let loop ((i 0)) (and (< i (length cs)) (or (mentions? (get cs i) var) (loop (+ i 1))))))))

;; --- Core functions ------------------------------------------------------------

;; Calls of core functions whose bodies the boot file keeps, in
;; %inline-bodies (known.ot's inline candidates), are inlined like calls of
;; local functions. Core is locked, so the body can't change. Design,
;; step 3.

(def- inline-core? (options/enabled? "inline-core"))

;; Parsed bodies by name, each [text function], parsed once.
(def- core-functions {})

;; The function record of the core function a :gcall calls, or nil.
(def (core-function node)
  (when (and inline-core? (eq? (get node 0) :gcall) (%native-core-cell? (get node 2)) (%core-locked?))
    (let ((name (string->symbol (cdr (%native-cell-name (get node 2))))))
      (let ((text (get otium.core/%inline-bodies name)) (parsed (get core-functions name)))
        (cond ((nil? text) nil)
              ((and parsed (eq? (get parsed 0) text)) (get parsed 1))
              (else
               (let ((info (ir/text->tree text (get node 1))))
                 (put! core-functions name [text info])
                 info)))))))

;; A call of a core function inlined, or nil, as simplify-call does for local
;; functions.
(def (inline-core s node ctx)
  (let ((info (core-function node)) (args (get node 3)))
    (when (and info (inlinable? s info args))
      (let ((ready (list-to-array (map (fn (a) (not (or (eq? (get a 0) :fn) (copyable? a)))) (array-to-list args)))))
        (let ((prepared (map (fn (i)
                               (if (get ready i)
                                   (simplify s (get args i) :value)
                                   (get args i)))
                             (range (length args)))))
          (or (try-inline s node info prepared ready ctx)
              (let ((new (copy node)))
                (put! new 3 (map (fn (i)
                                   (if (get ready i)
                                       (get prepared i)
                                       (simplify s (get args i) :value)))
                                 (range (length args))))
                new)))))))

;; (f a ...) as (let ((x a) ...) body), simplified, with a copy of f's body
;; in the calling function. nil when it grows past the size limit, or the
;; fuel (OTIUM_OPT_FUEL) has run out.
(def (try-inline s node info args ready ctx)
  (when (options/rewrite? (str "inline " (cv/fn-name info)) (get node 1))
    (try-inline-now s node info args ready ctx)))

(def (try-inline-now s node info args ready ctx)
  (let ((owner (state-fn s))
        (renames {})
        (params []))
    (for ((v :in (cv/fn-params info)))
      (let ((new (cv/new-var (cv/var-name v) owner #t)))
        (cv/set-var-captured! new (cv/var-captured v))
        (cv/set-var-assigned! new (cv/var-assigned v))
        (cv/set-var-early! new (cv/var-early v))
        (put! renames (cv/var-id v) new)
        (push! params new)))
    (let ((body (ir/copy-node (cv/fn-body info) owner renames))
          (outer (state-attempt s))
          (attempt (make-attempt :size 0 :limit (options/scaled (+ 80 (* 2 (node-size node)))))))
      (unless (get node 4) (untail! body))
      (set-state-attempt! s attempt)
      (set-state-inlining! s (cons info (state-inlining s)))
      (let ((done (try
                    (simplify-let s (get node 1) params args body ctx ready)
                    (catch (abort? _) nil))))
        (set-state-attempt! s outer)
        (set-state-fn! s owner)
        (set-state-inlining! s (cdr (state-inlining s)))
        (when (and done outer)
          (set-attempt-size! outer (+ (attempt-size outer) (attempt-size attempt)))
          (when (> (attempt-size outer) (attempt-limit outer)) (error abort-message outer)))
        done))))

;; Clear the tail flags of calls in tail position of node, which moves out of
;; tail position.
(def (untail! node)
  (case (get node 0)
    ((:if) (untail! (get node 3)) (untail! (get node 4)))
    ((:seq) (untail! (get (get node 2) (- (length (get node 2)) 1))))
    ((:let :loop) (untail! (get node 4)))
    ((:try)
     (for ((clause :in (get node 4)))
       (untail! (get clause 2))))
    ((:call) (put! node 4 #f))
    ((:gcall) (put! node 4 #f) (when (= (length node) 7) (put! node 6 #f)))
    ((:bcall) (put! node 4 #f) (put! node 6 #f))
    ((:known) (put! node 5 #f))
    (else nil)))
