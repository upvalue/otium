(ns otium.compiler.ir)

;; The block IR. The contract is in docs/optimizer.md, "Block IR"; this file
;; is the only code that knows how it's stored.
;;
;; Storage: one IR record of columns (Otium arrays), one row per function,
;; block, operation and value. Ids are row numbers, given out in creation
;; order from 0. Operands, terminator operands, successors and signature
;; parameters live in shared columns with a start and count per row. A
;; block's parameters, a block's operations and a function's blocks are
;; chained through next links, so blocks can be filled in any interleaving.
;; Accessors return fresh lists.
;;
;; Typical pass: read the old IR, write a new one. Keep a value map (array
;; indexed by old value id) and a block map per function:
;;
;;   (let ((out (ir/new))
;;         (vmap (column/filled (ir/value-count old) nil)))
;;     (for-each
;;      (fn (f)
;;        (let ((nf (ir/copy-function-shell! old out f))
;;              (bmap {})
;;              (order (ir/rpo old f)))
;;          ;; 1. blocks and their parameters first, so jumps can name them
;;          (for-each (fn (b)
;;                      (let ((nb (ir/add-block! out nf)))
;;                        (put! bmap b nb)
;;                        (for-each (fn (p) (put! vmap p (ir/add-param! out nb)))
;;                                  (ir/block-params old b))))
;;                    order)
;;          (ir/set-entry! out nf (bmap (ir/fn-entry old f)))
;;          (let ((sig (ir/fn-signature old f)))
;;            (ir/set-signature! out nf (map vmap (ir/fn-params old f))
;;                               (sig 0) (sig 1) (sig 2)))
;;          ;; 2. operations in reverse postorder: every operand is mapped by
;;          ;;    the time it's used, since definitions dominate uses
;;          (for-each (fn (b)
;;                      (for-each (fn (o)
;;                                  (put! vmap (ir/op-value old o)
;;                                        (ir/emit! out (bmap b) (ir/op-code old o)
;;                                                  (map vmap (ir/op-args old o))
;;                                                  (ir/op-aux old o) (ir/op-pos old o))))
;;                                (ir/block-ops old b)))
;;                    order)
;;          ;; 3. terminators last, since back edges pass values from later blocks
;;          (for-each (fn (b) (ir/copy-term! old b out (bmap b) vmap bmap)) order)))
;;      (ir/functions old))
;;     out)
;;
;; Iterating over rpo drops unreachable blocks. Copy functions in
;; (ir/functions old) order: a parent comes before its children, so
;; copy-function-shell! can map it, and the parent's values are in vmap before
;; a nested function uses them. The aux of closure, make-closure and
;; static-closure is an old function id: map it with
;; (ir/copied-function out f) once f is copied (copy-term! does this for
;; :known callees). A pass that rewrites an operation emits something else
;; at step 2 and records the replacement in vmap. tests/compiler/ir.ot runs
;; this pattern.
;;
;; Decisions where the spec is silent:
;; - The builder rejects misuse that can never become valid: unknown ids, a
;;   second terminator, emitting into a terminated block, an IR code with the
;;   wrong operand count or aux, a bad call kind, a signature whose parameter
;;   count disagrees with its counts, anything after `raise` but
;;   `unreachable`. Rules relating blocks to each other (successor functions,
;;   jump argument counts, ret and handler parameters, entry parameters,
;;   dominance, primops) belong to verify.ot, since a block's parameters may
;;   be added after edges to it.
;; - term-args of a jump are its arguments. A :value call's callee is a value
;;   and is a use at the terminator, but it is not in term-args.
;; - preds has one entry per edge, so a branch with both arms to the same
;;   block lists it twice. Order: by predecessor id, then successor index.
;; - uses has one entry per operand occurrence, ops in id order, then
;;   terminators in block id order.
;; - dominators and loop-depths cover reachable blocks only. dominated-children
;;   lists children in reverse postorder.
;; - loop-depths: a back edge is an edge to a block that dominates its source;
;;   a block's depth is the number of distinct loop headers whose natural loop
;;   contains it. Irreducible cycles don't count as loops.
;; - `raise` (args: the condition; no aux) is an IR code, added after the
;;   spec's table: it re-raises a caught condition, and its block must end
;;   in `unreachable` right after it.
;; - Extras beyond the spec: op-count, function-count, block-param-count,
;;   value-block, ir-code?, code-aux-kind, dominates?, copied-function,
;;   copy-term!, and for ir-text only, next-value-id and %emit!.

(require otium.compiler.column :as column)

(defrecord IR
  (fn-name fn-parent
           fn-pos
           fn-entry
           fn-param-start
           fn-param-count
           fn-required
           fn-optional
           fn-rest
           fn-first-block
           fn-last-block
           fn-params-column
           blk-fn
           blk-next
           blk-first-param
           blk-last-param
           blk-param-count
           blk-first-op
           blk-last-op
           blk-term
           blk-targ-start
           blk-targ-count
           blk-succ-start
           blk-succ-count
           blk-callee
           blk-call-kind
           blk-prim
           blk-pos
           targs
           succs
           op-code
           op-arg-start
           op-arg-count
           op-aux
           op-pos
           op-block
           op-value
           op-next
           args
           val-op
           val-block
           val-index
           val-fn
           val-fact
           val-name
           val-next
           edits
           preds-cache
           children-cache
           copy-source
           copy-map))

(def (new)
  "An empty IR."
  (record-new IR
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              []
              0
              nil
              nil
              nil
              {}))

(def- none -1)

(def- (misuse who what)
  (error (str "ir/" who ": " what)))

;; --- ids -------------------------------------------------------------------------

(def- (id-ok? x column)
  (and (int? x) (>= x 0) (< x (length column))))

(def- (check-fn ir who f)
  (unless (id-ok? f (ir :fn-name))
    (misuse who
            (str "unknown function "
                 (if (int? f)
                     (str "f" f)
                     f)))))

(def- (check-block ir who b)
  (unless (id-ok? b (ir :blk-fn))
    (misuse who
            (str "unknown block "
                 (if (int? b)
                     (str "b" b)
                     b)))))

(def- (check-op ir who o)
  (unless (id-ok? o (ir :op-code)) (misuse who (str "unknown operation " o))))

(def- (check-value ir who v)
  (unless (id-ok? v (ir :val-fn))
    (misuse who
            (str "unknown value "
                 (if (int? v)
                     (str "v" v)
                     v)))))

(def- (check-values ir who vs)
  (unless (list? vs) (misuse who (str "expected a list of values, got " vs)))
  (for-each (fn (v) (check-value ir who v)) vs))

(def (value-count ir)
  (length (ir :val-fn)))

(def (block-count ir)
  (length (ir :blk-fn)))

(def (op-count ir)
  (length (ir :op-code)))

(def (function-count ir)
  (length (ir :fn-name)))

;; --- building --------------------------------------------------------------------

(def (add-function! ir name parent pos)
  "A new function; parent is a function id or nil."
  (unless (nil? parent) (check-fn ir "add-function!" parent))
  (let ((f (function-count ir)))
    (push! (ir :fn-name) name)
    (push! (ir :fn-parent) parent)
    (push! (ir :fn-pos) pos)
    (push! (ir :fn-entry) nil)
    (push! (ir :fn-param-start) 0)
    (push! (ir :fn-param-count) 0)
    (push! (ir :fn-required) nil)
    (push! (ir :fn-optional) 0)
    (push! (ir :fn-rest) #f)
    (push! (ir :fn-first-block) none)
    (push! (ir :fn-last-block) none)
    f))

(def (set-signature! ir f params required optional rest?)
  "params: entry block parameters in order, required then optional then rest."
  (check-fn ir "set-signature!" f)
  (check-values ir "set-signature!" params)
  (unless (and (int? required) (>= required 0) (int? optional) (>= optional 0) (boolean? rest?))
    (misuse "set-signature!" "required and optional must be counts and rest? a boolean"))
  (unless (= (length params)
             (+ required
                optional
                (if rest?
                    1
                    0)))
    (misuse "set-signature!"
            (str "f"
                 f
                 " has "
                 (length params)
                 " parameters but the signature says "
                 (+ required
                    optional
                    (if rest?
                        1
                        0)))))
  (put! (ir :fn-param-start) f (column/push-all! (ir :fn-params-column) params))
  (put! (ir :fn-param-count) f (length params))
  (put! (ir :fn-required) f required)
  (put! (ir :fn-optional) f optional)
  (put! (ir :fn-rest) f rest?)
  nil)

(def (set-entry! ir f b)
  (check-fn ir "set-entry!" f)
  (check-block ir "set-entry!" b)
  (unless (= ((ir :blk-fn) b) f) (misuse "set-entry!" (str "b" b " belongs to f" ((ir :blk-fn) b) ", not f" f)))
  (put! (ir :fn-entry) f b)
  nil)

(def (add-block! ir f)
  (check-fn ir "add-block!" f)
  (let ((b (block-count ir)))
    (push! (ir :blk-fn) f)
    (push! (ir :blk-next) none)
    (push! (ir :blk-first-param) none)
    (push! (ir :blk-last-param) none)
    (push! (ir :blk-param-count) 0)
    (push! (ir :blk-first-op) none)
    (push! (ir :blk-last-op) none)
    (push! (ir :blk-term) nil)
    (push! (ir :blk-targ-start) 0)
    (push! (ir :blk-targ-count) 0)
    (push! (ir :blk-succ-start) 0)
    (push! (ir :blk-succ-count) 0)
    (push! (ir :blk-callee) nil)
    (push! (ir :blk-call-kind) nil)
    (push! (ir :blk-prim) nil)
    (push! (ir :blk-pos) nil)
    (let ((last ((ir :fn-last-block) f)))
      (if (= last none)
          (put! (ir :fn-first-block) f b)
          (put! (ir :blk-next) last b))
      (put! (ir :fn-last-block) f b))
    (edited! ir)
    b))

(def- (new-value! ir f op block index)
  (let ((v (value-count ir)))
    (push! (ir :val-op) op)
    (push! (ir :val-block) block)
    (push! (ir :val-index) index)
    (push! (ir :val-fn) f)
    (push! (ir :val-fact) nil)
    (push! (ir :val-name) nil)
    (push! (ir :val-next) none)
    v))

(def (add-param! ir b)
  "A new parameter at the end of b's parameters."
  (check-block ir "add-param!" b)
  (let ((v (new-value! ir ((ir :blk-fn) b) none b ((ir :blk-param-count) b)))
        (last ((ir :blk-last-param) b)))
    (if (= last none)
        (put! (ir :blk-first-param) b v)
        (put! (ir :val-next) last v))
    (put! (ir :blk-last-param) b v)
    (put! (ir :blk-param-count) b (+ 1 ((ir :blk-param-count) b)))
    v))

;; IR codes: operand count (or :any) and the kind of aux.
(def- ir-codes
  {'const [0 :any]
   'global-ref [0 :cell]
   'global-set [1 :cell]
   'global-def [1 :cell]
   'prim-ref [0 :symbol]
   'box [1 :none]
   'box-ref [1 :none]
   'box-set [2 :none]
   'unbound [0 :none]
   'check-bound [1 :none]
   'bound? [1 :none]
   'refine [1 :bits]
   'closure [:any :fn]
   'self [0 :none]
   'env-ref [0 :index]
   'make-closure [:any :fn]
   'static-closure [0 :fn]
   'pop-try [0 :none]
   'push-cleanup [1 :none]
   'run-cleanup [0 :none]
   'raise [1 :none]})

(def (ir-code? code)
  "Whether code is one of the IR's own operation codes rather than a primop."
  (contains? ir-codes code))

(def (code-aux-kind code)
  "For an IR code, the kind of its aux: :any :none :cell :symbol :bits :fn :index."
  (get (get ir-codes code) 1))

(def- (check-aux ir code aux)
  (let ((kind (code-aux-kind code)))
    (unless (cond
              ((eq? kind :any) #t)
              ((eq? kind :none) (nil? aux))
              ((eq? kind :symbol) (symbol? aux))
              ((eq? kind :fn) (id-ok? aux (ir :fn-name)))
              ((eq? kind :index) (and (int? aux) (>= aux 0)))
              (else (int? aux)))
      (misuse "emit!"
              (str code
                   (if (eq? kind :none)
                       " takes no aux"
                       (str " needs a " kind " aux"))
                   ", got "
                   aux)))))

(def- (ends-in-raise? ir b)
  (let ((last ((ir :blk-last-op) b))) (and (not (= last none)) (eq? ((ir :op-code) last) 'raise))))

(def- (check-open ir who b)
  (check-block ir who b)
  (when ((ir :blk-term) b) (misuse who (str "b" b " already ends in " ((ir :blk-term) b)))))

(def (emit! ir b code args &optional (aux nil) (pos nil))
  "Append an operation to b and return the value it defines."
  (%emit! ir b code args aux pos #t))

(def (%emit! ir b code args aux pos check-args?)
  "emit!, for ir-text only: without check-args?, args may name values later
emits will define."
  (check-open ir "emit!" b)
  (unless (symbol? code) (misuse "emit!" (str "operation code must be a symbol, got " code)))
  (if check-args?
      (check-values ir "emit!" args)
      (unless (and (list? args) (null? (filter (fn (v) (not (and (int? v) (>= v 0)))) args)))
        (misuse "emit!" (str "expected a list of value ids, got " args))))
  (when (ends-in-raise? ir b) (misuse "emit!" (str "b" b " has a raise, so it must end in unreachable")))
  (let ((info (get ir-codes code)))
    (when info
      (let ((n (info 0)))
        (unless (or (eq? n :any) (= n (length args)))
          (misuse "emit!" (str code " takes " n " operands, got " (length args)))))
      (check-aux ir code aux)))
  (let ((o (op-count ir))
        (v (new-value! ir ((ir :blk-fn) b) (op-count ir) b none)))
    (push! (ir :op-code) code)
    (push! (ir :op-arg-start) (column/push-all! (ir :args) args))
    (push! (ir :op-arg-count) (length args))
    (push! (ir :op-aux) aux)
    (push! (ir :op-pos) pos)
    (push! (ir :op-block) b)
    (push! (ir :op-value) v)
    (push! (ir :op-next) none)
    (let ((last ((ir :blk-last-op) b)))
      (if (= last none)
          (put! (ir :blk-first-op) b o)
          (put! (ir :op-next) last o))
      (put! (ir :blk-last-op) b o))
    v))

(def- (edited! ir)
  (record-set! ir :edits (+ 1 (ir :edits))))

(def- (terminate! ir who b kind targs succs callee call-kind prim pos)
  (check-open ir who b)
  (check-values ir who targs)
  (for-each (fn (s) (check-block ir who s)) succs)
  (when (and (ends-in-raise? ir b) (not (eq? kind :unreachable)))
    (misuse who (str "b" b " has a raise, so it must end in unreachable")))
  (put! (ir :blk-term) b kind)
  (put! (ir :blk-targ-start) b (column/push-all! (ir :targs) targs))
  (put! (ir :blk-targ-count) b (length targs))
  (put! (ir :blk-succ-start) b (column/push-all! (ir :succs) succs))
  (put! (ir :blk-succ-count) b (length succs))
  (put! (ir :blk-callee) b callee)
  (put! (ir :blk-call-kind) b call-kind)
  (put! (ir :blk-prim) b prim)
  (put! (ir :blk-pos) b pos)
  (edited! ir)
  nil)

(def (jump! ir b target args)
  (terminate! ir "jump!" b :jump args (list target) nil nil nil nil))

(def (branch! ir b test then else)
  (terminate! ir "branch!" b :branch (list test) (list then else) nil nil nil nil))

(def (branch-prim! ir b prim args then else)
  (unless (symbol? prim) (misuse "branch-prim!" (str "prim must be a symbol, got " prim)))
  (terminate! ir "branch-prim!" b :branch-prim args (list then else) nil nil prim nil))

(def- (check-callee ir who kind callee)
  (cond
    ((eq? kind :value) (check-value ir who callee))
    ((eq? kind :global) (unless (int? callee) (misuse who (str "a :global callee is a cell id, got " callee))))
    ((eq? kind :known) (check-fn ir who callee))
    (else (misuse who (str "call kind must be :value, :global or :known, got " kind)))))

(def (call! ir b kind callee args ret pos)
  "A non-tail call; the result is ret's first parameter."
  (check-callee ir "call!" kind callee)
  (terminate! ir "call!" b :call args (list ret) callee kind nil pos))

(def (tail-call! ir b kind callee args pos)
  (check-callee ir "tail-call!" kind callee)
  (terminate! ir "tail-call!" b :tail-call args '() callee kind nil pos))

(def (return! ir b v)
  (terminate! ir "return!" b :return (list v) '() nil nil nil nil))

(def (try! ir b body handler)
  (terminate! ir "try!" b :try '() (list body handler) nil nil nil nil))

(def (unreachable! ir b)
  (terminate! ir "unreachable!" b :unreachable '() '() nil nil nil nil))

;; --- reading ---------------------------------------------------------------------

(def (functions ir)
  (array-to-list (range (function-count ir))))

(def (fn-name ir f)
  (check-fn ir "fn-name" f)
  ((ir :fn-name) f))

(def (fn-parent ir f)
  (check-fn ir "fn-parent" f)
  ((ir :fn-parent) f))

(def (fn-pos ir f)
  (check-fn ir "fn-pos" f)
  ((ir :fn-pos) f))

(def (fn-entry ir f)
  "The entry block, or nil before set-entry!."
  (check-fn ir "fn-entry" f)
  ((ir :fn-entry) f))

(def (fn-params ir f)
  "The signature's parameters; empty before set-signature!."
  (check-fn ir "fn-params" f)
  (column/slice->list (ir :fn-params-column) ((ir :fn-param-start) f) ((ir :fn-param-count) f)))

(def (fn-signature ir f)
  "[required optional rest?], or nil before set-signature!."
  (check-fn ir "fn-signature" f)
  (and ((ir :fn-required) f) [((ir :fn-required) f) ((ir :fn-optional) f) ((ir :fn-rest) f)]))

(def- (chain->list first next)
  (let loop ((x first)
             (out '()))
    (if (= x none)
        (reverse out)
        (loop (next x) (cons x out)))))

(def (fn-blocks ir f)
  "f's blocks in creation order."
  (check-fn ir "fn-blocks" f)
  (chain->list ((ir :fn-first-block) f) (ir :blk-next)))

(def (block-fn ir b)
  (check-block ir "block-fn" b)
  ((ir :blk-fn) b))

(def (block-params ir b)
  (check-block ir "block-params" b)
  (chain->list ((ir :blk-first-param) b) (ir :val-next)))

(def (block-param-count ir b)
  (check-block ir "block-param-count" b)
  ((ir :blk-param-count) b))

(def (block-ops ir b)
  (check-block ir "block-ops" b)
  (chain->list ((ir :blk-first-op) b) (ir :op-next)))

(def (term-kind ir b)
  "The terminator kind, or nil if b has none yet."
  (check-block ir "term-kind" b)
  ((ir :blk-term) b))

(def (term-args ir b)
  "Operand values: jump arguments, the branch test, prim or call arguments, the returned value."
  (check-block ir "term-args" b)
  (column/slice->list (ir :targs) ((ir :blk-targ-start) b) ((ir :blk-targ-count) b)))

(def (term-callee ir b)
  (check-block ir "term-callee" b)
  ((ir :blk-callee) b))

(def (term-call-kind ir b)
  (check-block ir "term-call-kind" b)
  ((ir :blk-call-kind) b))

(def (term-prim ir b)
  (check-block ir "term-prim" b)
  ((ir :blk-prim) b))

(def (term-pos ir b)
  (check-block ir "term-pos" b)
  ((ir :blk-pos) b))

(def (succs ir b)
  (check-block ir "succs" b)
  (column/slice->list (ir :succs) ((ir :blk-succ-start) b) ((ir :blk-succ-count) b)))

(def (edge-args ir b i)
  "The values passed to successor i of b."
  (check-block ir "edge-args" b)
  (unless (and (int? i) (>= i 0) (< i ((ir :blk-succ-count) b)))
    (misuse "edge-args" (str "b" b " has no successor " i)))
  (if (eq? ((ir :blk-term) b) :jump)
      (term-args ir b)
      '()))

(def (op-code ir o)
  (check-op ir "op-code" o)
  ((ir :op-code) o))

(def (op-args ir o)
  (check-op ir "op-args" o)
  (column/slice->list (ir :args) ((ir :op-arg-start) o) ((ir :op-arg-count) o)))

(def (op-aux ir o)
  (check-op ir "op-aux" o)
  ((ir :op-aux) o))

(def (op-pos ir o)
  (check-op ir "op-pos" o)
  ((ir :op-pos) o))

(def (op-block ir o)
  (check-op ir "op-block" o)
  ((ir :op-block) o))

(def (op-value ir o)
  (check-op ir "op-value" o)
  ((ir :op-value) o))

(def (value-def ir v)
  "[:op o] or [:param b i]."
  (check-value ir "value-def" v)
  (let ((o ((ir :val-op) v)))
    (if (= o none)
        [:param ((ir :val-block) v) ((ir :val-index) v)]
        [:op o])))

(def (value-fn ir v)
  (check-value ir "value-fn" v)
  ((ir :val-fn) v))

(def (value-block ir v)
  "The block that defines v."
  (check-value ir "value-block" v)
  ((ir :val-block) v))

;; --- facts and names ------------------------------------------------------------

(def (value-fact ir v)
  (check-value ir "value-fact" v)
  ((ir :val-fact) v))

(def (set-value-fact! ir v fact)
  (check-value ir "set-value-fact!" v)
  (put! (ir :val-fact) v fact)
  nil)

(def (value-name ir v)
  (check-value ir "value-name" v)
  ((ir :val-name) v))

(def (set-value-name! ir v sym)
  (check-value ir "set-value-name!" v)
  (put! (ir :val-name) v sym)
  nil)

;; --- analyses --------------------------------------------------------------------

(def- (pred-lists ir)
  (let ((cache (ir :preds-cache)))
    (if (and cache (= (cache 0) (ir :edits)))
        (cache 1)
        (let ((lists (column/filled (block-count ir) '()))
              (start (ir :blk-succ-start))
              (count (ir :blk-succ-count))
              (all (ir :succs)))
          (let loop ((b (- (block-count ir) 1)))
            (when (>= b 0)
              (let inner ((i (- (count b) 1)))
                (when (>= i 0)
                  (let ((s (all (+ (start b) i)))) (put! lists s (cons b (lists s))))
                  (inner (- i 1))))
              (loop (- b 1))))
          (record-set! ir :preds-cache [(ir :edits) lists])
          lists))))

(def (preds ir b)
  "b's predecessors, one per edge."
  (check-block ir "preds" b)
  (map identity ((pred-lists ir) b)))

(def- (check-entry ir who f)
  (check-fn ir who f)
  (unless ((ir :fn-entry) f) (misuse who (str "f" f " has no entry block"))))

(def (rpo ir f)
  "f's blocks reachable from its entry, in reverse postorder."
  (check-entry ir "rpo" f)
  (let ((seen (column/bitset (block-count ir)))
        (blk-fn (ir :blk-fn))
        (start (ir :blk-succ-start))
        (count (ir :blk-succ-count))
        (all (ir :succs))
        (entry ((ir :fn-entry) f))
        (out '()))
    ;; Explicit stack of blocks and the index of the next successor to visit.
    (let ((stack [entry 0]))
      (column/bitset-set! seen entry)
      (while (> (length stack) 0)
        (let ((i (pop! stack))
              (b (pop! stack)))
          (if (< i (count b))
              (let ((s (all (+ (start b) i))))
                (push! stack b (+ i 1))
                (when (and (= (blk-fn s) f) (not (column/bitset-has? seen s)))
                  (column/bitset-set! seen s)
                  (push! stack s 0)))
              (set! out (cons b out))))))
    out))

(def (dominators ir f)
  "Table from each reachable block of f to its immediate dominator; the entry maps to itself."
  (let ((order (list-to-array (rpo ir f)))
        (number (column/filled (block-count ir) none))
        (lists (pred-lists ir)))
    (dotimes (i (length order))
      (put! number (order i) i))
    ;; idom by rpo number
    (let ((idom (column/filled (length order) none))
          (changed #t))
      (put! idom 0 0)
      (def (intersect a b)
        (let loop ((a a)
                   (b b))
          (cond
            ((= a b) a)
            ((> a b) (loop (idom a) b))
            (else (loop a (idom b))))))
      (while changed
        (set! changed #f)
        (let loop ((i 1))
          (when (< i (length order))
            (let ((new none))
              (for-each (fn (p)
                          (let ((pn (number p)))
                            (when (and (not (= pn none)) (not (= (idom pn) none)))
                              (set! new
                                    (if (= new none)
                                        pn
                                        (intersect pn new))))))
                        (lists (order i)))
              (unless (= new (idom i))
                (put! idom i new)
                (set! changed #t)))
            (loop (+ i 1)))))
      (let ((out {}))
        (dotimes (i (length order))
          (put! out (order i) (order (idom i))))
        out))))

(def- tree-cache-size 16)

(def- (dom-tree ir doms)
  "[children pre post] for a dominator table: children lists in reverse
postorder and pre/post numbers from a walk of the tree. The IR keeps the
last few, keyed by the doms table's identity."
  (let ((hit (let loop ((xs (or (ir :children-cache) '())))
               (cond
                 ((null? xs) nil)
                 ((eq? ((car xs) 0) doms) (car xs))
                 (else (loop (cdr xs)))))))
    (if hit
        (hit 1)
        (let ((children {})
              (pre (column/filled (block-count ir) none))
              (post (column/filled (block-count ir) none))
              (ks (keys doms)))
          ;; doms is built in reverse postorder, so walk it backwards and cons.
          (let loop ((i (- (length ks) 1)))
            (when (>= i 0)
              (let ((c (ks i))
                    (d (doms (ks i))))
                (unless (= c d) (put! children d (cons c (get children d '())))))
              (loop (- i 1))))
          (when (> (length ks) 0)
            (let ((stack [(ks 0) #f])
                  (n 0))
              (while (> (length stack) 0)
                (let ((done (pop! stack))
                      (b (pop! stack)))
                  (if done
                      (put! post b n)
                      (begin
                        (put! pre b n)
                        (push! stack b #t)
                        (for-each (fn (c) (push! stack c #f)) (get children b '()))))
                  (set! n (+ n 1))))))
          (let ((tree [children pre post]))
            (record-set! ir :children-cache (cons [doms tree] (take tree-cache-size (or (ir :children-cache) '()))))
            tree)))))

(def (dominated-children ir doms b)
  "Blocks whose immediate dominator in doms is b, in reverse postorder."
  (check-block ir "dominated-children" b)
  (map identity (get ((dom-tree ir doms) 0) b '())))

(def (dominates? ir doms a b)
  "Whether block a dominates block b in doms (a dominator table of ir); false
if either is unreachable."
  (check-block ir "dominates?" a)
  (check-block ir "dominates?" b)
  (let ((tree (dom-tree ir doms)))
    (let ((pre (tree 1))
          (post (tree 2)))
      (and (not (= (pre a) none)) (not (= (pre b) none)) (<= (pre a) (pre b)) (<= (post b) (post a))))))

(def (uses ir)
  "Array indexed by value: a list of [:op o] and [:term b], one per operand."
  (let ((out (column/filled (value-count ir) '())))
    (let loop ((b (- (block-count ir) 1)))
      (when (>= b 0)
        (let ((use [:term b]))
          (for-each (fn (v) (put! out v (cons use (out v)))) (reverse (term-args ir b)))
          (when (eq? ((ir :blk-call-kind) b) :value) (let ((v ((ir :blk-callee) b))) (put! out v (cons use (out v))))))
        (loop (- b 1))))
    (let loop ((o (- (op-count ir) 1)))
      (when (>= o 0)
        (for-each (fn (v) (put! out v (cons [:op o] (out v)))) (reverse (op-args ir o)))
        (loop (- o 1))))
    out))

(def (loop-depths ir f)
  "Table from each reachable block of f to the number of loops containing it."
  (let ((doms (dominators ir f))
        (lists (pred-lists ir))
        (depth {}))
    (for-each (fn (b) (put! depth b 0)) (keys doms))
    (for-each (fn (h)
                (let ((body {})
                      (work '()))
                  (for-each (fn (p) (when (and (contains? doms p) (dominates? ir doms h p)) (set! work (cons p work))))
                            (lists h))
                  (unless (null? work)
                    (put! body h #t)
                    (while (not (null? work))
                      (let ((b (car work)))
                        (set! work (cdr work))
                        (unless (get body b)
                          (put! body b #t)
                          (for-each (fn (p) (when (contains? doms p) (set! work (cons p work)))) (lists b)))))
                    (for-each (fn (b) (put! depth b (+ 1 (depth b)))) (keys body)))))
              (keys doms))
    depth))

;; --- copying ---------------------------------------------------------------------

(def (copy-function-shell! from to f)
  "Copy f's name, parent and position from one IR into another; returns the new id."
  (check-fn from "copy-function-shell!" f)
  (cond
    ((nil? (to :copy-source)) (record-set! to :copy-source from))
    ((not (eq? (to :copy-source) from))
     (misuse "copy-function-shell!" "the target already holds functions copied from another IR")))
  (when (contains? (to :copy-map) f) (misuse "copy-function-shell!" (str "f" f " was already copied")))
  (let ((parent ((from :fn-parent) f)))
    (when (and parent (not (contains? (to :copy-map) parent)))
      (misuse "copy-function-shell!" (str "copy f" f "'s parent f" parent " first")))
    (let ((nf (add-function! to ((from :fn-name) f) (and parent ((to :copy-map) parent)) ((from :fn-pos) f))))
      (put! (to :copy-map) f nf)
      nf)))

(def (copied-function to f)
  "The id in to of function f of the IR it was copied from."
  (let ((nf (get (to :copy-map) f)))
    (unless nf (misuse "copied-function" (str "f" f " hasn't been copied")))
    nf))

(def (copy-term! from b to nb value-of block-of)
  "Give nb a copy of b's terminator, mapping values and blocks with value-of and block-of; :known callees go through copied-function."
  (let ((kind (term-kind from b))
        (args (map value-of (term-args from b)))
        (succ (map block-of (succs from b))))
    (cond
      ((eq? kind :jump) (jump! to nb (car succ) args))
      ((eq? kind :branch) (branch! to nb (car args) (car succ) (cadr succ)))
      ((eq? kind :branch-prim) (branch-prim! to nb (term-prim from b) args (car succ) (cadr succ)))
      ((or (eq? kind :call) (eq? kind :tail-call))
       (let ((ck (term-call-kind from b))
             (callee (term-callee from b)))
         (let ((callee (cond
                         ((eq? ck :value) (value-of callee))
                         ((eq? ck :known) (copied-function to callee))
                         (else callee))))
           (if (eq? kind :call)
               (call! to nb ck callee args (car succ) (term-pos from b))
               (tail-call! to nb ck callee args (term-pos from b))))))
      ((eq? kind :return) (return! to nb (car args)))
      ((eq? kind :try) (try! to nb (car succ) (cadr succ)))
      ((eq? kind :unreachable) (unreachable! to nb))
      (else (misuse "copy-term!" (str "b" b " has no terminator"))))))

;; For ir-text: the id the next value will get.
(def (next-value-id ir)
  (value-count ir))
