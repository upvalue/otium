;; lower.ot -- tree IR to virtual code.
;;
;; Virtual code is a list of instructions per function, close to the bridge's
;; stream (c/src/native.c) but on virtual registers. A virtual register is a
;; non-negative integer; other operands are arrays:
;;
;;   [:imm word]     a machine word        [:fix n]        the fixnum n
;;   [:mem base off] memory at a register, :rt (the state) or :alloc (S1)
;;   [:cell j f]     field f of unit cell j [:cellidx j]   cell j's number
;;   [:const k]      unit literal k         [:state f]     a state field
;;   [:alloc]        the allocation pointer
;;
;; Instructions:
;;
;;   [:mov dst src]  [:load8 dst mem]  [:op2 op flags dst a b]  [:op2u op flags a b]
;;   [:cmpj cond a b label]  [:jcond cond label]  [:jump label]  [:label label]
;;   [:call kind callee args dst tail handlers offset tail-position?]
;;   [:ccall helper args dst handlers offset]  [:ret src]  [:entry]  [:poll label]
;;   [:landing dst]  [:addr dst label]  [:spbase dst]
;;
;; Calls are safepoints. allocate keeps every value in one place for its
;; whole life; emit saves the registers live across a safepoint into the
;; frame around it. handlers lists the labels a raise inside a try or
;; restart-case can land on, for liveness.
;;
;; Fast paths are inline. Slow paths go to a cold list after the function's
;; code: allocation past the heap's end, primitives on anything but
;; fixnums and pairs, the poll, errors.

(ns otium.compiler.lower
  (:require (otium.compiler.convert :as cv)
            (otium.compiler.options :as options)))

;; --- Representation ---------------------------------------------------------

;; Machine words of immediates, and object layouts, as in c/src/internal.h.
(def word-nil 2)
(def word-false 6)
(def word-true 10)
(def word-empty 14)
(def word-unbound 18)
(def word-eof 30)
(def kind-pair 1)
(def kind-box 2)
(def kind-closure 3)
(def kind-float 4)
(def kind-array 8)
(def kind-record 29)
(def offset-array-data 16)
(def offset-array-length 24)
(def offset-float 16)
(def header-bytes 16)
;; The smallest OTI_LARGE_MIN in c/src/heap.h, so native code is right for
;; either collector profile.
(def large-object-bytes 2048)
(def offset-kind 12)
(def offset-car 16)
(def offset-cdr 24)
(def offset-bytes-length 16)
(def offset-bytes-data 24)
(def kind-bytevector 22)
(def offset-record-type 16)
(def offset-record-values 24)
(def offset-box 16)
(def offset-code 16)
(def offset-captures 24)

;; Helpers in native.c, by number.
(def h-alloc 0)
(def h-prim1 1)
(def h-prim2 2)
(def h-arity 3)
(def h-unbound 4)
(def h-uninitialized 5)
(def h-define 6)
(def h-set-global 7)
(def h-poll 8)
(def h-rest 9)
(def h-try 10)
(def h-end-try 11)
(def h-raise 12)
(def h-cleanup 13)
(def h-run-cleanup 14)
(def h-handlers 15)
(def h-unhandlers 16)
(def h-bind-param 17)
(def h-unbind-params 18)
(def h-make-param 19)
(def h-restarts 20)
(def h-end-restarts 21)
(def h-restart-apply 22)
(def h-evaluator 23)
(def h-pop-cleanup 24)
(def h-builtin 25)
(def h-proof-failed 26)

;; State fields.
(def sf-heap-end 0)
(def sf-heap-start 1)
(def sf-limit 2)
(def sf-args 3)
(def sf-call-other 4)
(def sf-native-sp 5)
(def sf-callee 6)
(def sf-argc 7)

(def (builtin-id name) (quotient (%native-builtin name) 256))

(def- builtin-ids
  (let ((t {}))
    (for ((name :in '("+" "-" "*" "<" "<=" ">" ">=" "=" "car" "cdr")))
      (put! t (string->symbol name) (builtin-id name)))
    t))

;; The operand for a constant: an immediate when it is one, else nil.
(def (immediate value)
  (cond ((int? value) [:fix value])
        ((nil? value) [:imm word-nil])
        ((eq? value #t) [:imm word-true])
        ((eq? value #f) [:imm word-false])
        ((null? value) [:imm word-empty])
        ((char? value) [:imm (+ (* (char->integer value) 256) 22)])
        ((eof-object? value) [:imm word-eof])
        (else nil)))

;; --- Units ------------------------------------------------------------------

;; A unit is a table: :labels counts labels, :literals and :cells are the
;; unit's tables, :functions every function in index order, :statics the
;; [function literal] pairs of closures without captures, :pending
;; functions still to lower, :namespace the current namespace's name.
(def (make-unit)
  {:labels 0 :literals [] :cells [] :cell-map {} :functions [] :statics [] :pending []
   :namespace (current-ns)})

(def (unit-label! u)
  (let ((n (u :labels)))
    (put! u :labels (+ n 1))
    n))

(def (literal! u value)
  (let ((literals (u :literals)))
    (let find-it ((i 0))
      (cond ((= i (length literals))
             (push! literals value)
             i)
            ((eq? (get literals i) value) i)
            (else (find-it (+ i 1)))))))

;; A literal no other use shares, for a static closure.
(def (fresh-literal! u)
  (let ((literals (u :literals)))
    (push! literals nil)
    (- (length literals) 1)))

(def (cell! u cell)
  (let ((index (get (u :cell-map) cell)))
    (or index
        (let ((i (length (u :cells))))
          (push! (u :cells) cell)
          (put! (u :cell-map) cell i)
          i))))

;; Give a function its index and entry label, queueing it for lowering.
(def (function! u info)
  (or (info :index)
      (let ((i (length (u :functions))))
        (put! info :index i)
        (put! info :xep (unit-label! u))
        (push! (u :functions) info)
        (push! (u :pending) info)
        (when (= (length (info :captures)) 0)
          (let ((k (fresh-literal! u)))
            (put! info :static k)
            (push! (u :statics) [i k])))
        i)))

;; --- Function contexts --------------------------------------------------------

;; A function being lowered: :code and :cold instruction arrays, :next the
;; next register, :raw #t by number for registers holding raw words, :locs where each
;; variable lives by id, :handlers the landing labels in scope, :loops the
;; heads and registers of inline loops.
(defrecord Context
  (u info code cold next raw locs handlers loops closure params optional-regs rest-reg live ranges
   location spills save-base swap target stage slots)
  :prefix fc)

(def (make-context u info)
  (make-fc :u u :info info :code [] :cold [] :next 0 :raw [] :locs {} :handlers '() :loops {}))

(def (vreg! fc)
  (let ((n (fc-next fc)))
    (set-fc-next! fc (+ n 1))
    n))

(def (raw! fc)
  (let ((n (vreg! fc)))
    (let ((raw (fc-raw fc)))
      (while (<= (length raw) n) (push! raw #f))
      (put! raw n #t))
    n))

(def (emit! fc ins) (push! (fc-code fc) ins))

(def (cold! fc ins) (push! (fc-cold fc) ins))

(def (label! fc) (unit-label! (fc-u fc)))

(def (vreg? x) (int? x))

;; An operand in a register.
(def (in-vreg fc op)
  (if (vreg? op)
      op
      (let ((v (vreg! fc)))
        (emit! fc [:mov v op])
        v)))

;; A fresh register holding op, for a binding that may be assigned.
(def (fresh-copy fc op)
  (let ((v (vreg! fc)))
    (emit! fc [:mov v op])
    v))

(def (ccall! fc helper args dst offset)
  (emit! fc [:ccall helper args dst (fc-handlers fc) offset]))

(def (cold-ccall! fc helper args dst offset)
  (cold! fc [:ccall helper args dst (fc-handlers fc) offset]))

;; --- Variables ----------------------------------------------------------------

(def (boxed? var) (and (var :captured) (or (var :assigned) (var :early))))

(def (closure-reg fc) (fc-closure fc))

;; Where var is: [:reg v], [:box v], or [:cap index boxed?].
(def (var-loc fc var)
  (or (get (fc-locs fc) (var :id))
      (let ((captures ((fc-info fc) :captures)))
        (let find-it ((i 0))
          (cond ((= i (length captures))
                 (error "native compiler: variable not in scope" (var :name)))
                ((eq? (get captures i) var) [:cap i (boxed? var)])
                (else (find-it (+ i 1))))))))

(def (capture-mem fc i) [:mem (closure-reg fc) (+ offset-captures (* 8 i))])

;; A register reading var, checked for initialization when check is true.
(def (read-var fc var check offset)
  (let ((loc (var-loc fc var)))
    (case (get loc 0)
      ((:reg)
       (when check (check-bound fc (get loc 1) 0 offset))
       (get loc 1))
      ((:box)
       (let ((v (vreg! fc)))
         (emit! fc [:mov v [:mem (get loc 1) offset-box]])
         (check-bound fc v 0 offset)
         v))
      (else
       (let ((v (vreg! fc)))
         (emit! fc [:mov v (capture-mem fc (get loc 1))])
         (when (get loc 2)
           (emit! fc [:mov v [:mem v offset-box]])
           (check-bound fc v 1 offset))
         v)))))

(def (check-bound fc v captured offset)
  (let ((slow (label! fc)))
    (emit! fc [:cmpj :eq v [:imm word-unbound] slow])
    (cold! fc [:label slow])
    (cold-ccall! fc h-uninitialized [[:imm captured]] nil offset)))

(def (write-var fc var value)
  (let ((loc (var-loc fc var)))
    (case (get loc 0)
      ((:reg) (emit! fc [:mov (get loc 1) value]))
      ((:box) (emit! fc [:mov [:mem (get loc 1) offset-box] (in-vreg fc value)]))
      (else
       (let ((b (vreg! fc)) (v (in-vreg fc value)))
         (emit! fc [:mov b (capture-mem fc (get loc 1))])
         (emit! fc [:mov [:mem b offset-box] v]))))))

;; Bind var to a value just computed: in a box when it needs one.
(def (bind-var fc var value offset)
  (if (boxed? var)
      (put! (fc-locs fc) (var :id) [:box (make-box fc value offset)])
      (put! (fc-locs fc) (var :id) [:reg (fresh-copy fc value)])))

;; --- Allocation -----------------------------------------------------------------

;; Allocate an object of kind with fields traced words and bytes more, inline:
;; bump the allocation pointer, check it against the heap's end, write the
;; header. Past the end, C allocates (collecting if it must) and writes the
;; header itself. Large objects always go to C, which keeps them apart.
(def (allocate fc kind fields bytes offset)
  (if (>= (+ header-bytes (* 8 fields) bytes) large-object-bytes)
      (let ((p (vreg! fc)))
        (ccall! fc h-alloc [[:imm kind] [:imm fields] [:imm bytes]] p offset)
        p)
      (allocate-inline fc kind fields bytes offset)))

(def (allocate-inline fc kind fields bytes offset)
  (let ((size (+ header-bytes (* 8 fields) bytes))
        (p (vreg! fc)) (top (raw! fc))
        (slow (label! fc)) (join (label! fc)))
    (emit! fc [:op2 :add 0 top [:alloc] [:imm size]])
    (emit! fc [:cmpj :gt top [:state sf-heap-end] slow])
    (emit! fc [:mov p [:alloc]])
    (emit! fc [:mov [:alloc] top])
    (emit! fc [:mov [:mem p 0] [:imm size]])
    (emit! fc [:mov [:mem p 8] [:imm (+ fields (* kind 4294967296))]])
    (emit! fc [:label join])
    (cold! fc [:label slow])
    (cold-ccall! fc h-alloc [[:imm kind] [:imm fields] [:imm bytes]] p offset)
    (cold! fc [:jump join])
    p))

(def (make-box fc value offset)
  (let ((v (in-vreg-or-imm fc value)))
    (let ((b (allocate fc kind-box 1 0 offset)))
      (emit! fc [:mov [:mem b offset-box] v])
      b)))

;; Operands that are immediates can be stored directly; others go through a
;; register so an instruction has at most one register-based memory operand.
(def (in-vreg-or-imm fc op)
  (if (and (array? op) (memq (get op 0) '(:imm :fix))) op (in-vreg fc op)))

(def (make-pair fc a b offset)
  (let ((a (in-vreg-or-imm fc a)) (b (in-vreg-or-imm fc b)))
    (let ((p (allocate fc kind-pair 2 0 offset)))
      (emit! fc [:mov [:mem p offset-car] a])
      (emit! fc [:mov [:mem p offset-cdr] b])
      p)))

;; --- Expressions -------------------------------------------------------------

(def (node-offset node) (get node 1))

;; The value of node as an operand.
(def (value fc node)
  (let ((offset (node-offset node)))
    (case (get node 0)
      ((:const) (constant fc (get node 2)))
      ((:unbound) [:imm word-unbound])
      ((:lref) (read-var fc (get node 2) (get node 3) offset))
      ((:lset)
       (write-var fc (get node 2) (value fc (get node 3)))
       [:imm word-nil])
      ((:gref) (global-ref fc (get node 2) offset))
      ((:gdef)
       (let ((v (in-vreg fc (value fc (get node 3)))) (r (vreg! fc)))
         (ccall! fc h-define [[:cellidx (cell! (fc-u fc) (get node 2))] v] r offset)
         r))
      ((:gset)
       (let ((v (in-vreg fc (value fc (get node 3)))))
         (ccall! fc h-set-global [[:cellidx (cell! (fc-u fc) (get node 2))] v] (vreg! fc) offset)
         [:imm word-nil]))
      ((:seq)
       (let ((nodes (get node 2)))
         (for ((i :range (- (length nodes) 1))) (effect fc (get nodes i)))
         (value fc (get nodes (- (length nodes) 1)))))
      ((:let)
       (bind-let fc node)
       (value fc (get node 4)))
      ((:fn) (closure fc (get node 2) offset))
      ((:prim) (primitive fc (get node 2) (get node 3) offset))
      ((:gprim)
       (if (memq (get node 2) '(record-get record-set!))
           (record-field fc node offset)
           (guarded-primitive fc node offset)))
      ((:make-param)
       (let ((name (in-vreg-or-imm fc (value fc (get node 2))))
             (init (in-vreg fc (value fc (get node 3))))
             (r (vreg! fc)))
         (ccall! fc h-make-param [name init] r offset)
         r))
      ((:evaluator)
       (let ((r (vreg! fc)))
         (ccall! fc h-evaluator [(constant fc ((fc-u fc) :namespace))] r offset)
         r))
      ((:class-object) (constant fc (%native-object-class)))
      ((:call :gcall :bcall)
       (let ((r (vreg! fc)))
         (call fc node r #f)
         r))
      ((:known) (direct-builtin fc node offset))
      (else (via-target fc node)))))

;; Nodes with control flow deliver their value to a target: a register and a
;; label to jump to.
(def (via-target fc node)
  (let ((r (vreg! fc)) (done (label! fc)))
    (tail fc node [r done])
    (emit! fc [:label done])
    r))

(def (effect fc node) (value fc node))

(def (constant fc value)
  (or (immediate value)
      [:const (literal! (fc-u fc) value)]))

(def (global-ref fc cell offset)
  (let ((v (vreg! fc)) (t (raw! fc)) (slow (label! fc)) (j (cell! (fc-u fc) cell)))
    (emit! fc [:mov v [:cell j 0]])
    (emit! fc [:op2 :and 0 t v [:imm 255]])
    (emit! fc [:cmpj :eq t [:imm word-unbound] slow])
    (cold! fc [:label slow])
    (cold-ccall! fc h-unbound [v] nil offset)
    v))

(def (bind-let fc node)
  (let ((vars (get node 2)) (inits (get node 3)) (offset (node-offset node)))
    (for ((i :range (length vars)))
      (let ((var (get vars i)) (init (get inits i)))
        (if (self-capture? var init)
            ;; A function that captures the variable it's bound to, as for
            ;; a named let whose name is assigned: the box comes first.
            (let ((b (make-box fc [:imm word-unbound] offset)))
              (put! (fc-locs fc) (var :id) [:box b])
              (emit! fc [:mov [:mem b offset-box] (in-vreg fc (value fc init))]))
            (bind-var fc var (value fc init) offset))))))

(def (self-capture? var init)
  (and (boxed? var) (eq? (get init 0) :fn) (find (fn (v) (eq? v var)) ((get init 2) :captures)) #t))

;; Deliver node's value to target: nil returns it from the function, [r label]
;; puts it in r and jumps to label.
(def (tail fc node target)
  (let ((offset (node-offset node)))
    (case (get node 0)
      ((:if)
       (let ((otherwise (label! fc)))
         (test fc (get node 2) otherwise)
         (tail fc (get node 3) target)
         (emit! fc [:label otherwise])
         (tail fc (get node 4) target)))
      ((:seq)
       (let ((nodes (get node 2)))
         (for ((i :range (- (length nodes) 1))) (effect fc (get nodes i)))
         (tail fc (get nodes (- (length nodes) 1)) target)))
      ((:let)
       (bind-let fc node)
       (tail fc (get node 4) target))
      ((:call :gcall :bcall)
       (if (and (nil? target) (tail-call? node))
           (call fc node nil #t)
           (let ((r (vreg! fc)))
             (call fc node r #f)
             (deliver fc r target))))
      ((:loop) (inline-loop fc node target))
      ((:recur) (recur fc node))
      ((:while) (while-loop fc node) (deliver fc [:imm word-nil] target))
      ((:try) (deliver fc (try-form fc node) target))
      ((:cleanup) (deliver fc (cleanup-form fc node) target))
      ((:handlers) (deliver fc (handlers-form fc node) target))
      ((:params) (deliver fc (params-form fc node) target))
      ((:restarts) (deliver fc (restarts-form fc node) target))
      (else (deliver fc (value fc node) target)))))

(def (deliver fc op target)
  (if (nil? target)
      (emit! fc [:ret op])
      (begin
        (emit! fc [:mov (get target 0) op])
        (emit! fc [:jump (get target 1)]))))

;; --- Tests --------------------------------------------------------------------

;; Jump to otherwise when node's value is false or nil; fall through when not.
(def (test fc node otherwise)
  (case (get node 0)
    ((:prim) (test-primitive fc (get node 2) (get node 3) otherwise (node-offset node)))
    ((:const)
     (unless (and (not (nil? (get node 2))) (not (eq? (get node 2) #f)))
       (emit! fc [:jump otherwise])))
    ((:if)
     (let ((alt (label! fc)) (done (label! fc)))
       (test fc (get node 2) alt)
       (test fc (get node 3) otherwise)
       (emit! fc [:jump done])
       (emit! fc [:label alt])
       (test fc (get node 4) otherwise)
       (emit! fc [:label done])))
    ((:let)
     (bind-let fc node)
     (test fc (get node 4) otherwise))
    ((:seq)
     (let ((nodes (get node 2)))
       (for ((i :range (- (length nodes) 1))) (effect fc (get nodes i)))
       (test fc (get nodes (- (length nodes) 1)) otherwise)))
    ((:known)
     (if (inline-test? node)
         (inline-test fc node otherwise)
         (falsy-jump fc (value fc node) otherwise)))
    (else (falsy-jump fc (value fc node) otherwise))))

;; nil (2) and #f (6) differ only in bit 2.
(def (falsy-jump fc op otherwise)
  (let ((t (raw! fc)))
    (emit! fc [:op2 :or 0 t op [:imm 4]])
    (emit! fc [:cmpj :eq t [:imm word-false] otherwise])))

;; --- Primitives ----------------------------------------------------------------

(def (pair-check fc x slow)
  (let ((k (raw! fc)))
    (emit! fc [:op2u :and :zero x [:imm 7]])
    (emit! fc [:jcond :nonzero slow])
    (emit! fc [:load8 k [:mem x offset-kind]])
    (emit! fc [:cmpj :ne k [:imm kind-pair] slow])))

(def (both-fixnums fc a b slow)
  (cond ((fixnum-operand? b)
         (emit! fc [:op2u :and :zero a [:imm 1]])
         (emit! fc [:jcond :zero slow]))
        ((fixnum-operand? a)
         (emit! fc [:op2u :and :zero b [:imm 1]])
         (emit! fc [:jcond :zero slow]))
        (else
         (let ((t (raw! fc)))
           (emit! fc [:op2 :and 0 t a b])
           (emit! fc [:op2u :and :zero t [:imm 1]])
           (emit! fc [:jcond :zero slow])))))

(def (fixnum-operand? op) (and (array? op) (eq? (get op 0) :fix)))

;; A fixnum operand whose doubled value, the difference its tagged word
;; makes to a sum, is itself a fixnum: an immediate the compiler can work out.
;; Doubling a bigger one would wrap in Otium's 63-bit fixnums.
(def (doubles-to-fixnum? op)
  (and (fixnum-operand? op) (< -2305843009213693953 (get op 1) 2305843009213693952)))

;; Operands for a binary primitive: registers, or fixnum immediates.
(def (operand fc node)
  (let ((op (value fc node)))
    (if (fixnum-operand? op) op (in-vreg fc op))))

(def- comparisons
  {'< [:slt :sge] '<= [:sle :sgt] '> [:sgt :sle] '>= [:sge :slt] '= [:eq :ne]})

(def (slow-builtin fc name args r offset join)
  (let ((slow (label! fc)))
    (cold! fc [:label slow])
    (cold-ccall! fc (if (= (length args) 1) h-prim1 h-prim2)
                 (list-to-array (cons [:imm (get builtin-ids name)] (array-to-list args))) r offset)
    (cold! fc [:jump join])
    slow))

;; Emit into the cold section: what thunk emits as hot code goes there, and
;; its own slow paths after it.
(def (in-cold fc thunk)
  (let ((code (fc-code fc)) (cold (fc-cold fc)) (colder []))
    (set-fc-code! fc cold)
    (set-fc-cold! fc colder)
    (thunk)
    (set-fc-code! fc code)
    (set-fc-cold! fc cold)
    (for ((ins :in colder)) (push! cold ins))))

(def (float-check fc x otherwise)
  (let ((k (raw! fc)))
    (emit! fc [:op2u :and :zero x [:imm 7]])
    (emit! fc [:jcond :nonzero otherwise])
    (emit! fc [:load8 k [:mem x offset-kind]])
    (emit! fc [:cmpj :ne k [:imm kind-float] otherwise])))

;; The slow path of arithmetic on two registers: doubles inline when both are
;; floats, the builtin for anything else.
(def (slow-arithmetic fc name a b r offset join)
  (let ((builtin (slow-builtin fc name [a b] r offset join)))
    (if (and (vreg? a) (vreg? b))
        (let ((slow (label! fc)))
          (in-cold fc (fn ()
                        (emit! fc [:label slow])
                        (float-check fc a builtin)
                        (float-check fc b builtin)
                        (let ((p (allocate fc kind-float 0 8 offset)))
                          (emit! fc [:fmov [:freg 0] [:mem a offset-float]])
                          (emit! fc [:fop2 (get {'+ :add '- :sub '* :mul} name) [:freg 0] [:freg 0]
                                     [:mem b offset-float]])
                          (emit! fc [:fmov [:mem p offset-float] [:freg 0]])
                          (emit! fc [:mov r p])
                          (emit! fc [:jump join]))))
          slow)
        builtin)))

;; Comparisons of two floats jump straight to where the test goes.
(def- float-false {'< :funge '<= :fungt '> :fule '>= :fult '= :fune})

(def (slow-comparison fc name a b r offset join otherwise cont)
  (let ((builtin (slow-builtin fc name [a b] r offset join)))
    (if (and (vreg? a) (vreg? b))
        (let ((slow (label! fc)) (x (raw! fc)))
          (in-cold fc (fn ()
                        (emit! fc [:label slow])
                        (float-check fc a builtin)
                        (float-check fc b builtin)
                        (emit! fc [:fmov [:freg 0] [:mem a offset-float]])
                        (emit! fc [:mov x b])
                        (emit! fc [:fcmpj (get float-false name) [:freg 0] [:mem x offset-float] otherwise])
                        (emit! fc [:jump cont])))
          slow)
        builtin)))

(def (fixnum-arithmetic fc name a b r)
  (case name
    ((+)
     (cond ((doubles-to-fixnum? b) (emit! fc [:op2 :add 0 r a [:imm (* 2 (get b 1))]]))
           ((doubles-to-fixnum? a) (emit! fc [:op2 :add 0 r b [:imm (* 2 (get a 1))]]))
           (else
            (emit! fc [:op2 :add 0 r (in-vreg fc a) b])
            (emit! fc [:op2 :sub 0 r r [:imm 1]]))))
    ((-)
     (if (doubles-to-fixnum? b)
         (emit! fc [:op2 :sub 0 r a [:imm (* 2 (get b 1))]])
         (begin
           (emit! fc [:op2 :sub 0 r (in-vreg fc a) b])
           (emit! fc [:op2 :add 0 r r [:imm 1]]))))
    (else
     (let ((x (raw! fc)) (y (raw! fc)))
       (emit! fc [:op2 :sub 0 x a [:imm 1]])
       (emit! fc [:op2 :ashr 0 y b [:imm 1]])
       (emit! fc [:op2 :mul 0 x x y])
       (emit! fc [:op2 :add 0 r x [:imm 1]])))))

(def- checked-names
  {'%fx+ '+ '%fx- '- '%fx* '* '%fx< '< '%fx<= '<= '%fx> '> '%fx>= '>= '%fx= '=})

;; Where a failed check of an unchecked operation goes, in check mode.
(def (proof-trap fc offset)
  (let ((trap (label! fc)))
    (cold! fc [:label trap])
    (cold-ccall! fc h-proof-failed [] nil offset)
    trap))

(def (primitive fc name args offset)
  (case name
    ((car cdr)
     (let ((x (in-vreg fc (value fc (get args 0)))) (r (vreg! fc)) (join (label! fc)))
       (let ((slow (slow-builtin fc name [x] r offset join)))
         (pair-check fc x slow)
         (emit! fc [:mov r [:mem x (if (eq? name 'car) offset-car offset-cdr)]])
         (emit! fc [:label join])
         r)))
    ((cons)
     (let ((a (value fc (get args 0))))
       (let ((a (in-vreg-or-imm fc a)) (b (value fc (get args 1))))
         (make-pair fc a b offset))))
    ((+ - *)
     (let ((a (operand fc (get args 0))) (b (operand fc (get args 1))) (r (vreg! fc))
           (join (label! fc)))
       (let ((slow (slow-arithmetic fc name a b r offset join)))
         (both-fixnums fc a b slow)
         (fixnum-arithmetic fc name a b r)
         (emit! fc [:label join])
         r)))
    ;; Unchecked operations the types pass proved safe. Check mode keeps the
    ;; check, and a failure traps.
    ((%car %cdr)
     (let ((x (in-vreg fc (value fc (get args 0)))) (r (vreg! fc)))
       (when options/check-mode (pair-check fc x (proof-trap fc offset)))
       (emit! fc [:mov r [:mem x (if (eq? name '%car) offset-car offset-cdr)]])
       r))
    ((%fx+ %fx- %fx*)
     (let ((a (operand fc (get args 0))) (b (operand fc (get args 1))) (r (vreg! fc)))
       (when options/check-mode (both-fixnums fc a b (proof-trap fc offset)))
       (fixnum-arithmetic fc (get checked-names name) a b r)
       r))
    ((%fx< %fx<= %fx> %fx>= %fx=)
     (boolean fc (fn (otherwise) (test-primitive fc name args otherwise offset))))
    ((< <= > >= =)
     (boolean fc (fn (otherwise) (test-primitive fc name args otherwise offset))))
    ((eq? not null? pair?)
     (boolean fc (fn (otherwise) (test-primitive fc name args otherwise offset))))
    (else (error "native compiler: unknown primitive" name))))

;; get, put! and length on an array with a fixnum index in range, inline; the
;; call through the global otherwise. A global of locked core can't change,
;; so only another namespace's global needs checking that it still holds the
;; builtin.
(def (guarded-primitive fc node offset)
  (let ((name (get node 2)) (j (cell! (fc-u fc) (get node 3)))
        (args (map (fn (n) (in-vreg fc (value fc n))) (get node 4)))
        (r (vreg! fc)) (join (label! fc)) (slow (label! fc)))
    (let ((a (get args 0)) (g (raw! fc)) (k (raw! fc)))
      (unless (and (%native-core-cell? (get node 3)) (%core-locked?))
        (emit! fc [:mov g [:cell j 0]])
        (emit! fc [:cmpj :ne g [:imm (%native-builtin (symbol->string name))] slow]))
      (emit! fc [:op2u :and :zero a [:imm 7]])
      (emit! fc [:jcond :nonzero slow])
      (emit! fc [:load8 k [:mem a offset-kind]])
      (emit! fc [:cmpj :ne k [:imm kind-array] slow])
      (if (eq? name 'length)
          (let ((n (raw! fc)))
            (emit! fc [:mov n [:mem a offset-array-length]])
            (emit! fc [:op2 :shl 0 n n [:imm 1]])
            (emit! fc [:op2 :or 0 r n [:imm 1]]))
          (let ((i (get args 1)) (index (raw! fc)) (at (raw! fc)))
            (emit! fc [:op2u :and :zero i [:imm 1]])
            (emit! fc [:jcond :zero slow])
            (emit! fc [:op2 :ashr 0 index i [:imm 1]])
            (emit! fc [:cmpj :ge index [:mem a offset-array-length] slow])
            ;; An index i is tagged 2n+1, so item n is at data + 16 + 8n = data + 4i + 12.
            (emit! fc [:op2 :shl 0 at i [:imm 2]])
            (emit! fc [:op2 :add 0 at at [:mem a offset-array-data]])
            (if (eq? name 'get)
                (emit! fc [:mov r [:mem at 12]])
                (begin
                  (emit! fc [:mov [:mem at 12] (get args 2)])
                  (emit! fc [:mov r a]))))))
    (emit! fc [:label join])
    (if (direct-slow-path? node)
        (in-cold fc (fn ()
                      (emit! fc [:label slow])
                      (builtin-ccall! fc name args r offset)
                      (emit! fc [:jump join])))
        (begin
          (cold! fc [:label slow])
          (cold! fc [:call :cell j args r #f (fc-handlers fc) offset])
          (cold! fc [:jump join])))
    r))

;; A call of a reader or writer defrecord defined, as a load or store when
;; the argument is a record of its type. Anything else calls it, to fail.
(def (record-field fc node offset)
  (let ((entry (get otium.core/%record-accessors (get node 3)))
        (args (map (fn (n) (in-vreg fc (value fc n))) (get node 4)))
        (r (vreg! fc)) (join (label! fc)) (slow (label! fc)))
    (let ((a (get args 0)) (k (raw! fc)) (t (raw! fc))
          (at (+ offset-record-values (* 8 (get entry 1)))))
      (emit! fc [:op2u :and :zero a [:imm 7]])
      (emit! fc [:jcond :nonzero slow])
      (emit! fc [:load8 k [:mem a offset-kind]])
      (emit! fc [:cmpj :ne k [:imm kind-record] slow])
      (emit! fc [:mov t [:cell (cell! (fc-u fc) (get entry 0)) 0]])
      (emit! fc [:cmpj :ne t [:mem a offset-record-type] slow])
      (if (eq? (get node 2) 'record-get)
          (emit! fc [:mov r [:mem a at]])
          (begin
            (emit! fc [:mov [:mem a at] (get args 1)])
            (emit! fc [:mov r (get args 1)]))))
    (emit! fc [:label join])
    (cold! fc [:label slow])
    (cold! fc [:call :cell (cell! (fc-u fc) (get node 3)) args r #f (fc-handlers fc) offset])
    (cold! fc [:jump join])
    r))

;; A boolean from a test.
(def (boolean fc test-to)
  (let ((r (vreg! fc)) (done (label! fc)) (otherwise (label! fc)))
    (test-to otherwise)
    (emit! fc [:mov r [:imm word-true]])
    (emit! fc [:jump done])
    (emit! fc [:label otherwise])
    (emit! fc [:mov r [:imm word-false]])
    (emit! fc [:label done])
    r))

(def (test-primitive fc name args otherwise offset)
  (case name
    ((< <= > >= =)
     (let ((a (operand fc (get args 0))) (b (operand fc (get args 1)))
           (r (vreg! fc)) (join (label! fc)) (cont (label! fc)))
       (when (and (fixnum-operand? a) (fixnum-operand? b)) (set! a (in-vreg fc a)))
       (let ((slow (slow-comparison fc name a b r offset join otherwise cont)))
         (both-fixnums fc a b slow)
         (emit! fc [:cmpj (get (get comparisons name) 1) (tagged a) (tagged b) otherwise])
         (emit! fc [:jump cont])
         (emit! fc [:label join])
         (falsy-jump fc r otherwise)
         (emit! fc [:label cont]))))
    ((%fx< %fx<= %fx> %fx>= %fx=)
     (let ((a (operand fc (get args 0))) (b (operand fc (get args 1))))
       (when (and (fixnum-operand? a) (fixnum-operand? b)) (set! a (in-vreg fc a)))
       (when options/check-mode (both-fixnums fc a b (proof-trap fc offset)))
       (emit! fc [:cmpj (get (get comparisons (get checked-names name)) 1) (tagged a) (tagged b) otherwise])))
    ((eq?)
     (let ((a (in-vreg fc (value fc (get args 0)))) (b (value fc (get args 1))))
       (emit! fc [:cmpj :ne a b otherwise])))
    ((not)
     (let ((x (value fc (get args 0))) (t (raw! fc)))
       (emit! fc [:op2 :or 0 t x [:imm 4]])
       (emit! fc [:cmpj :ne t [:imm word-false] otherwise])))
    ((null?)
     (let ((x (in-vreg fc (value fc (get args 0)))))
       (emit! fc [:cmpj :ne x [:imm word-empty] otherwise])))
    ((pair?)
     (let ((x (in-vreg fc (value fc (get args 0)))))
       (pair-check fc x otherwise)))
    (else (falsy-jump fc (primitive fc name args offset) otherwise))))

;; Fixnum immediates compare as their tagged words.
(def (tagged op) op)

;; --- Closures ------------------------------------------------------------------

(def (closure fc info offset)
  (let ((u (fc-u fc)))
    (function! u info)
    (let ((captures (info :captures)))
      (if (= (length captures) 0)
          [:const (info :static)]
          (let ((values (map (fn (var) (capture-value fc var)) (array-to-list captures))))
            (let ((p (allocate fc kind-closure (length captures) 8 offset))
                  (code (raw! fc)))
              (emit! fc [:addr code (info :xep)])
              (emit! fc [:mov [:mem p offset-code] code])
              (let loop ((vs values) (i 0))
                (unless (null? vs)
                  (emit! fc [:mov [:mem p (+ offset-captures (* 8 i))] (car vs)])
                  (loop (cdr vs) (+ i 1))))
              p))))))

;; What a closure captures for var: the box of a boxed variable, else its value.
(def (capture-value fc var)
  (let ((loc (var-loc fc var)))
    (case (get loc 0)
      ((:reg :box) (get loc 1))
      (else
       (let ((v (vreg! fc)))
         (emit! fc [:mov v (capture-mem fc (get loc 1))])
         v)))))

;; --- Calls ------------------------------------------------------------------------

;; Arguments are evaluated left to right; a global callee is read after them.
(def (call fc node dst tail)
  (let ((offset (node-offset node)) (u (fc-u fc)))
    (case (get node 0)
      ((:call)
       (let ((f (in-vreg fc (value fc (get node 2)))))
         (let ((args (arguments fc (get node 3))))
           (emit! fc [:call :value f args dst tail (fc-handlers fc) offset]))))
      ((:gcall)
       (when (get node 5) (global-ref fc (get node 2) offset))
       (let ((args (arguments fc (get node 3))))
         (emit! fc [:call :cell (cell! u (get node 2)) args dst tail (fc-handlers fc) offset
                    (get node 6)])))
      (else
       (let ((args (arguments fc (get node 3))))
         (emit! fc [:call :imm (get node 2) args dst tail (fc-handlers fc) offset (get node 6)]))))))

;; A call to a builtin of locked core: the arguments go to native.args and
;; a helper runs the builtin, skipping the call_other stub and dispatch. The
;; call keeps its caller's frame, so errors point at the call.
(def (direct-builtin fc node offset)
  (let ((name (get node 2)) (n (length (get node 4))))
    (cond ((inline-test? node) (boolean fc (fn (otherwise) (inline-test fc node otherwise))))
          ((or (and (memq name '(bitwise-and bitwise-ior bitwise-xor bitwise-arithmetic-shift)) (= n 2))
               (and (eq? name 'bitwise-not) (= n 1)))
           (bitwise fc node offset))
          ((= n (or (get bytevector-arities name) -1)) (bytevector-access fc node offset))
          (else
           (let ((ops (map (fn (op) (in-vreg-or-imm fc op)) (arguments fc (get node 4)))) (r (vreg! fc)))
             (if (and (memq name '(set-car! set-cdr!)) (= (length ops) 2))
                 (pair-store fc name ops r offset)
                 (builtin-ccall! fc name ops r offset))
             r)))))

;; Type predicates of locked core, tested inline: the kind of object each
;; is true for, or a keyword for one that tests the word itself.
(def- inline-tests
  {'nil? :nil 'int? :int 'char? :char 'number? :number 'string? 5 'symbol? 6 'keyword? 7
   'array? kind-array 'table? 13 'bytevector? kind-bytevector 'float? kind-float 'record? kind-record})

(def (inline-test? node)
  (and (eq? (get node 0) :known) (get inline-tests (get node 2)) (= (length (get node 4)) 1)))

;; Jump to otherwise unless the predicate of a :known node holds.
(def (inline-test fc node otherwise)
  (let ((x (in-vreg fc (value fc (get (get node 4) 0)))) (test (get inline-tests (get node 2))))
    (case test
      ((:nil) (emit! fc [:cmpj :ne x [:imm word-nil] otherwise]))
      ((:int)
       (emit! fc [:op2u :and :zero x [:imm 1]])
       (emit! fc [:jcond :zero otherwise]))
      ((:char)
       (let ((t (raw! fc)))
         (emit! fc [:op2 :and 0 t x [:imm 255]])
         (emit! fc [:cmpj :ne t [:imm 22] otherwise])))
      ((:number)
       (let ((yes (label! fc)))
         (emit! fc [:op2u :and :zero x [:imm 1]])
         (emit! fc [:jcond :nonzero yes])
         (float-check fc x otherwise)
         (emit! fc [:label yes])))
      (else
       (let ((k (raw! fc)))
         (emit! fc [:op2u :and :zero x [:imm 7]])
         (emit! fc [:jcond :nonzero otherwise])
         (emit! fc [:load8 k [:mem x offset-kind]])
         (emit! fc [:cmpj :ne k [:imm test] otherwise]))))))

;; bytevector-length, -u8-ref and -u8-set! on a bytevector, inline, with the
;; builtin for anything it would fail on.
(def- bytevector-arities {'bytevector-length 1 'bytevector-u8-ref 2 'bytevector-u8-set! 3})

(def (bytevector-access fc node offset)
  (let ((name (get node 2))
        (ops (map (fn (op) (in-vreg fc op)) (arguments fc (get node 4))))
        (r (vreg! fc)) (join (label! fc)) (slow (label! fc)))
    (let ((x (get ops 0)) (k (raw! fc)))
      (emit! fc [:op2u :and :zero x [:imm 7]])
      (emit! fc [:jcond :nonzero slow])
      (emit! fc [:load8 k [:mem x offset-kind]])
      (emit! fc [:cmpj :ne k [:imm kind-bytevector] slow])
      (if (eq? name 'bytevector-length)
          (let ((n (raw! fc)))
            (emit! fc [:mov n [:mem x offset-bytes-length]])
            (emit! fc [:op2 :shl 0 n n [:imm 1]])
            (emit! fc [:op2 :or 0 r n [:imm 1]]))
          (let ((i (get ops 1)) (index (raw! fc)) (at (raw! fc)))
            (emit! fc [:op2u :and :zero i [:imm 1]])
            (emit! fc [:jcond :zero slow])
            (emit! fc [:op2 :ashr 0 index i [:imm 1]])
            ;; Unsigned, so a negative index fails too.
            (emit! fc [:cmpj :ge index [:mem x offset-bytes-length] slow])
            (emit! fc [:op2 :add 0 at x index])
            (if (eq? name 'bytevector-u8-ref)
                (let ((b (raw! fc)))
                  (emit! fc [:load8 b [:mem at offset-bytes-data]])
                  (emit! fc [:op2 :shl 0 b b [:imm 1]])
                  (emit! fc [:op2 :or 0 r b [:imm 1]]))
                (let ((v (get ops 2)) (b (raw! fc)))
                  (emit! fc [:op2u :and :zero v [:imm 1]])
                  (emit! fc [:jcond :zero slow])
                  (emit! fc [:op2 :ashr 0 b v [:imm 1]])
                  (emit! fc [:cmpj :ge b [:imm 256] slow])
                  (emit! fc [:store8 [:mem at offset-bytes-data] b])
                  (emit! fc [:mov r [:imm word-nil]]))))))
    (emit! fc [:label join])
    (in-cold fc (fn ()
                  (emit! fc [:label slow])
                  (builtin-ccall! fc name ops r offset)
                  (emit! fc [:jump join])))
    r))

;; bitwise-and, -ior, -xor, -not and -arithmetic-shift of fixnums, inline. A
;; fixnum n is the word 2n+1, so and and or of words are the words of the
;; results. A shift left that would overflow, a shift by 62 or more either
;; way, or anything not a fixnum calls the builtin.
(def (bitwise fc node offset)
  (let ((name (get node 2))
        (ops (map (fn (op) (in-vreg fc op)) (arguments fc (get node 4))))
        (r (vreg! fc)) (join (label! fc)) (slow (label! fc)))
    (let ((a (get ops 0)) (b (if (= (length ops) 2) (get ops 1) nil)))
      (if b
          (both-fixnums fc a b slow)
          (begin
            (emit! fc [:op2u :and :zero a [:imm 1]])
            (emit! fc [:jcond :zero slow])))
      (case name
        ((bitwise-and) (emit! fc [:op2 :and 0 r a b]))
        ((bitwise-ior) (emit! fc [:op2 :or 0 r a b]))
        ((bitwise-xor)
         (emit! fc [:op2 :xor 0 r a b])
         (emit! fc [:op2 :or 0 r r [:imm 1]]))
        ((bitwise-not) (emit! fc [:op2 :xor 0 r a [:imm -2]]))
        (else
         (let ((k (raw! fc)) (t (raw! fc)) (u (raw! fc)) (right (label! fc)))
           (emit! fc [:op2 :ashr 0 k b [:imm 1]])
           (emit! fc [:cmpj :slt k [:imm 0] right])
           ;; Left: shift 2n, and back again to see that nothing was lost.
           (emit! fc [:cmpj :sge k [:imm 62] slow])
           (emit! fc [:op2 :sub 0 t a [:imm 1]])
           (emit! fc [:op2 :shl 0 u t k])
           (emit! fc [:op2 :ashr 0 k u k])
           (emit! fc [:cmpj :ne k t slow])
           (emit! fc [:op2 :or 0 r u [:imm 1]])
           (emit! fc [:jump join])
           (emit! fc [:label right])
           (emit! fc [:cmpj :sle k [:imm -62] slow])
           (emit! fc [:op2 :sub 0 k [:imm 0] k])
           (emit! fc [:op2 :ashr 0 t a k])
           (emit! fc [:op2 :or 0 r t [:imm 1]])))))
    (emit! fc [:label join])
    (in-cold fc (fn ()
                  (emit! fc [:label slow])
                  (builtin-ccall! fc name ops r offset)
                  (emit! fc [:jump join])))
    r))

;; set-car! and set-cdr! of a pair, inline: one store, and the pair back.
(def (pair-store fc name ops r offset)
  (let ((x (in-vreg fc (get ops 0))) (v (get ops 1)) (slow (label! fc)) (join (label! fc)))
    (pair-check fc x slow)
    ;; A frozen pair, a table's key, has the top bit of its kind word set.
    (let ((k (raw! fc)))
      (emit! fc [:load8 k [:mem x (+ offset-kind 3)]])
      (emit! fc [:op2u :and :zero k [:imm 128]])
      (emit! fc [:jcond :nonzero slow]))
    (emit! fc [:mov [:mem x (if (eq? name 'set-car!) offset-car offset-cdr)] v])
    (emit! fc [:mov r x])
    (emit! fc [:label join])
    (in-cold fc (fn ()
                  (emit! fc [:label slow])
                  (builtin-ccall! fc name [x v] r offset)
                  (emit! fc [:jump join])))))

(def (builtin-ccall! fc name ops r offset)
  (let ((u (fc-u fc)))
    (when (> (length ops) (or (u :max-args) 0)) (put! u :max-args (length ops)))
    (store-args fc ops)
    (ccall! fc h-builtin [[:imm (builtin-id (symbol->string name))] [:imm (length ops)]] r offset)))

;; get, put! and length's slow path, when the global is locked core's, calls
;; the builtin directly.
(def (direct-slow-path? node)
  (and (%native-core-cell? (get node 3)) (%core-locked?) (options/enabled? "direct")))

;; Builtins the compiler calls itself, and core builtins convert marked, keep
;; their caller's frame, so errors point at the call.
(def (tail-call? node)
  (and (not (eq? (get node 0) :bcall)) (get node 4)))

(def (arguments fc nodes)
  (let ((ops []))
    (for ((n :in nodes)) (push! ops (value fc n)))
    ops))

;; --- Loops -----------------------------------------------------------------------

(def (inline-loop fc node target)
  (let ((loop (get node 2)) (inits (get node 3)) (head (label! fc)))
    (let ((vals (map (fn (init) (fresh-copy fc (value fc init))) (array-to-list inits))))
      (put! (fc-loops fc) (loop :index) [head vals])
      (emit! fc [:label head])
      (poll fc)
      (let bind ((vars (array-to-list (loop :vars))) (vs vals))
        (unless (null? vars)
          (let ((var (car vars)))
            (if (boxed? var)
                (put! (fc-locs fc) (var :id) [:box (make-box fc (car vs) (node-offset node))])
                (put! (fc-locs fc) (var :id) [:reg (car vs)])))
          (bind (cdr vars) (cdr vs))))
      (tail fc (get node 4) target))))

(def (recur fc node)
  (let ((entry (get (fc-loops fc) ((get node 2) :index))))
    (let ((temps (map (fn (a) (fresh-copy fc (value fc a))) (array-to-list (get node 3)))))
      (let move ((ts temps) (vs (get entry 1)))
        (unless (null? ts)
          (emit! fc [:mov (car vs) (car ts)])
          (move (cdr ts) (cdr vs))))
      (emit! fc [:jump (get entry 0)]))))

(def (while-loop fc node)
  (let ((body (label! fc)) (check (label! fc)) (exit (label! fc)))
    (emit! fc [:jump check])
    (emit! fc [:label body])
    (effect fc (get node 3))
    (emit! fc [:label check])
    (poll fc)
    (test fc (get node 2) exit)
    (emit! fc [:jump body])
    (emit! fc [:label exit])))

;; The poll at function entries and loop heads: one compare of the stack
;; pointer with the limit, which an interrupt request also trips.
(def (poll fc)
  (let ((slow (label! fc)) (back (label! fc)))
    (emit! fc [:poll slow])
    (emit! fc [:label back])
    (cold! fc [:label slow])
    (cold-ccall! fc h-poll [] nil nil)
    (cold! fc [:jump back])))

;; --- Control forms ---------------------------------------------------------------

(def (with-handler fc label thunk)
  (let ((saved (fc-handlers fc)))
    (set-fc-handlers! fc (cons label saved))
    (let ((result (thunk)))
      (set-fc-handlers! fc saved)
      result)))

(def (try-form fc node)
  (let ((offset (node-offset node)) (handler (label! fc)) (done (label! fc))
        (out (vreg! fc)) (pc (raw! fc)) (sp (raw! fc)))
    (emit! fc [:addr pc handler])
    (emit! fc [:spbase sp])
    (ccall! fc h-try [pc sp] (vreg! fc) offset)
    (let ((r (with-handler fc handler (fn () (value fc (get node 2))))))
      (ccall! fc h-end-try [] (vreg! fc) offset)
      (emit! fc [:mov out r])
      (emit! fc [:jump done]))
    (emit! fc [:label handler])
    (let ((condition (vreg! fc)))
      (emit! fc [:landing condition])
      (put! (fc-locs fc) ((get node 3) :id) [:reg condition])
      (for ((clause :in (get node 4)))
        (let ((next (label! fc)))
          (when (get clause 0)
            (let ((f (in-vreg fc (value fc (get clause 0)))) (r (vreg! fc)))
              (emit! fc [:call :value f [condition] r #f (fc-handlers fc) offset])
              (falsy-jump fc r next)))
          (bind-var fc (get clause 1) condition offset)
          (emit! fc [:mov out (value fc (get clause 2))])
          (emit! fc [:jump done])
          (emit! fc [:label next])))
      (ccall! fc h-raise [condition] nil offset))
    (emit! fc [:label done])
    out))

(def (cleanup-form fc node)
  (let ((offset (node-offset node)) (outcome (get node 3)))
    (let ((f (in-vreg fc (value fc (get node 2)))))
      (ccall! fc h-cleanup [f [:imm (if outcome word-true word-false)]] (vreg! fc) offset)
      (let ((r (fresh-copy fc (value fc (get node 4)))) (cleanup (vreg! fc)))
        ;; Leaving normally: take the cleanup back and call it here, an
        ;; ordinary call, with a nil outcome when it takes one.
        (ccall! fc h-pop-cleanup [] cleanup offset)
        (emit! fc [:call :value cleanup (if outcome [(in-vreg fc [:imm word-nil])] []) (vreg! fc) #f
                   (fc-handlers fc) offset])
        r))))

;; Store values into native.args for a helper that takes them there.
(def (store-args fc values)
  (let ((a (raw! fc)))
    (emit! fc [:mov a [:state sf-args]])
    (for ((i :range (length values)))
      (emit! fc [:mov [:mem a (* 8 i)] (get values i)]))))

(def (handlers-form fc node)
  (let ((offset (node-offset node)) (values []))
    (for ((pair :in (get node 2)))
      (push! values (in-vreg fc (value fc (get pair 0))))
      (push! values (in-vreg fc (value fc (get pair 1)))))
    (let ((n (length (get node 2))))
      (store-args fc values)
      (ccall! fc h-handlers [[:imm n]] (vreg! fc) offset)
      (let ((r (fresh-copy fc (value fc (get node 3)))))
        (ccall! fc h-unhandlers [[:imm n]] (vreg! fc) offset)
        r))))

(def (params-form fc node)
  (let ((offset (node-offset node)))
    (for ((pair :in (get node 2)))
      (let ((p (in-vreg fc (value fc (get pair 0)))))
        (let ((v (in-vreg fc (value fc (get pair 1)))))
          (ccall! fc h-bind-param [p v] (vreg! fc) offset))))
    (let ((r (fresh-copy fc (value fc (get node 3)))))
      (ccall! fc h-unbind-params [[:imm (length (get node 2))]] (vreg! fc) offset)
      r)))

(def (restarts-form fc node)
  (let ((offset (node-offset node)) (values []) (target (label! fc)) (done (label! fc))
        (out (vreg! fc)) (pc (raw! fc)) (sp (raw! fc)))
    (for ((clause :in (get node 2)))
      (for ((part :in clause)) (push! values (in-vreg fc (value fc part)))))
    (store-args fc values)
    (emit! fc [:addr pc target])
    (emit! fc [:spbase sp])
    (ccall! fc h-restarts [[:imm (length (get node 2))] pc sp] (vreg! fc) offset)
    (let ((r (with-handler fc target (fn () (value fc (get node 3))))))
      (emit! fc [:mov out r])
      (emit! fc [:jump done]))
    (emit! fc [:label target])
    (let ((transfer (vreg! fc)))
      (emit! fc [:landing transfer])
      (ccall! fc h-restart-apply [transfer] out offset))
    (emit! fc [:label done])
    (ccall! fc h-end-restarts [] (vreg! fc) offset)
    out))

;; --- Functions -----------------------------------------------------------------

;; Lower a function. Its entry defines the closure and parameters; emit
;; turns [:entry] into the arity check and the moves from where the caller
;; left them.
(def (lower-function u info)
  (let ((fc (make-context u info)))
    (set-fc-closure! fc (vreg! fc))
    (set-fc-params! fc (list-to-array (map (fn (v) (vreg! fc)) (array-to-list (info :params)))))
    (set-fc-optional-regs! fc
          (list-to-array (map (fn (o) (vreg! fc)) (array-to-list (info :optionals)))))
    (set-fc-rest-reg! fc (and (info :rest) (vreg! fc)))
    (emit! fc [:entry])
    (poll fc)
    (when (info :self) (put! (fc-locs fc) ((info :self) :id) [:reg (fc-closure fc)]))
    (let ((offset (info :offset)))
      (for ((i :range (length (info :params))))
        (bind-param fc (get (info :params) i) (get (fc-params fc) i) offset))
      (for ((i :range (length (info :optionals))))
        (let ((pair (get (info :optionals) i)) (v (get (fc-optional-regs fc) i)) (skip (label! fc)))
          (emit! fc [:cmpj :ne v [:imm word-unbound] skip])
          (emit! fc [:mov v (value fc (get pair 1))])
          (emit! fc [:label skip])
          (bind-param fc (get pair 0) v offset)))
      (when (info :rest) (bind-param fc (info :rest) (fc-rest-reg fc) offset)))
    (tail fc (info :body) nil)
    fc))

(def (bind-param fc var v offset)
  (if (boxed? var)
      (put! (fc-locs fc) (var :id) [:box (make-box fc v offset)])
      (put! (fc-locs fc) (var :id) [:reg v])))

;; Lower a converted top-level form and every function inside it. Returns
;; the unit and the function contexts in index order.
(def (lower-top info)
  (let ((u (make-unit)) (contexts []))
    (function! u info)
    (let loop ()
      (unless (= (length (u :pending)) 0)
        (let ((next (get (u :pending) 0)))
          (put! u :pending (list-to-array (cdr (array-to-list (u :pending)))))
          (push! contexts (lower-function u next))
          (loop))))
    [u contexts]))
