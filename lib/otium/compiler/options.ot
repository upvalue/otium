;; options.ot -- switching optimizer components on and off.
;;
;; OTIUM_OPT is all (the default), none, or a comma-separated list of
;; components to switch off, such as -direct,-inline. It's read when this
;; module loads.

(ns otium.compiler.options)

(def- setting
  (let ((value (otium.process/getenv "OTIUM_OPT")))
    (if (or (nil? value) (equal? value "") (equal? value "all"))
        ""
        value)))

(def- off
  (let ((t {}))
    (unless (equal? setting "none")
      (for ((part :in (string-split setting ",")))
        (when (and (> (string-length part) 1) (equal? (substring part 0 1) "-"))
          (put! t (substring part 1 (string-length part)) #t))))
    t))

;; Whether the component named name, a string, is switched on.
(def (enabled? name)
  (and (not (equal? setting "none")) (not (get off name))))

;; OTIUM_OPT_FUEL=n allows only the first n rewrites in the process; after
;; that every pass acts as if switched off. The nth rewrite is reported on
;; stderr, so tools/opt-bisect can name the one that breaks a test.
(def- fuel (let ((value (otium.process/getenv "OTIUM_OPT_FUEL"))) (and value (string->number value))))

(def- rewrites 0)

;; Whether the pass may make a rewrite: what names it, such as
;; "transform:list", at source offset off. Spends one unit of fuel.
(def (rewrite? what off)
  (cond
    ((nil? fuel) #t)
    ((>= rewrites fuel) #f)
    (else (set! rewrites (+ rewrites 1))
          (when (= rewrites fuel)
            (display-to (current-error-port) (str "optimizer: rewrite " rewrites ": " what " at offset " off "\n")))
          #t)))

;; OTIUM_OPT_CHECK=1 makes lower keep the check of every unchecked operation
;; the types pass made, and trap when one fails: a wrong proof then stops
;; where it was made instead of corrupting memory.
(def check-mode (equal? (otium.process/getenv "OTIUM_OPT_CHECK") "1"))

;; OTIUM_OPT_INLINE_BUDGET scales the inline pass's limits, as a percentage:
;; how big an inlined copy may grow and how much work inlining may do in a
;; unit. 100 is the default, 0 turns inlining off; smaller code against
;; speed, for small targets.
(def inline-budget
  (let ((value (otium.process/getenv "OTIUM_OPT_INLINE_BUDGET")))
    (let ((n (and value (string->number value))))
      (if (and (int? n) (>= n 0)) n 100))))

(def (scaled n) (quotient (* n inline-budget) 100))

;; Efficiency notes: when on, the passes record where they left
;; code slow and why, as [offset text] pairs. Off, they cost one test.
(def notes? #f)

(def notes [])

(def (set-notes! on?) (set! notes? on?))

(def (note! off text)
  (when notes? (push! notes [off text])))
