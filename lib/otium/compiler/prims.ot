;; lint: allow-file(unbound-name) nan?, infinite? and %vm-opcodes are C runtime builtins the Chez linter does not know
(ns otium.compiler.prims)

(require (otium.compiler.types :as types))

;; The primop table: what the optimizer knows about the C runtime's builtins.
;; Builtins can't be redefined, so a call to one means what its entry says.
;; (lookup sym) returns the entry for an otium.core builtin name, or nil.
;;
;; An entry is a table:
;;
;;   :name       the symbol
;;   :arity      [required variadic?]
;;   :max        nil, or the most arguments a variadic primop accepts
;;               (get takes 2 or 3); other counts raise
;;   :effects    a list of :alloc :read :write :raise :call :switch
;;   :fold       nil, or (fn (args) value) on constant arguments; it raises
;;               when folding isn't valid for them, and the caller then
;;               leaves the call alone
;;   :transfer   (fn (facts) fact): the result's fact from the arguments'
;;   :refines    for predicates: [bits-if-true bits-if-false] for the first
;;               argument
;;   :vm         nil, or the VM opcode for a call with exactly :vm-arity
;;               arguments (+ with two arguments is :add)
;;   :vm-arity   the argument count :vm applies to
;;   :branch     nil, or the VM branch opcode for this predicate in test
;;               position (< is :br-lt, pair? is :br-pair)
;;   :base       for a % variant, the primop it implements
;;
;; Effects. :alloc means the result is a new object whose identity can be
;; seen, such as a pair, array or table. Boxing a float and building an
;; immutable string don't count: those results can be shared without anyone
;; noticing, short of eq? on floats or strings. :read means the result
;; depends on mutable memory, :write that it changes memory, :raise that it
;; may raise, :call that it may run unknown code, :switch that it may let
;; another green thread run. Effects describe calls with a valid argument
;; count; the verifier checks counts with arity-fits?.
;;
;; Transfer functions are sound for the C runtime as it is: fixnum +, - and
;; * wrap on overflow there rather than raising, so where an exact result
;; bound would leave the fixnum range the result is the whole range. They
;; return types/none when the call can't return: wrong argument count,
;; arguments that can only raise, or an argument whose fact is still none.
;;
;; Folding never builds mutable data or depends on identity: arguments must
;; be atoms (numbers, characters, booleans, nil, (), strings, symbols,
;; keywords), except for type predicates and not, which may look at any
;; constant. eq? folds only on values whose identity is their value.
;;
;; Variants. Propagate rewrites a call to one of these when the facts allow.
;; Each has :base and its own :effects; its :vm is its base's opcode, and it
;; behaves exactly like its base on the arguments it's allowed.
;;
;;   %car %cdr            the argument is a pair; no :raise
;;   %fx+ %fx- %fx*       two fixnum arguments; the result may overflow, so
;;                        they keep :raise (see the note on wrapping above;
;;                        a future runtime or backend may check instead)
;;   %fx+/no-overflow %fx-/no-overflow %fx*/no-overflow
;;                        two fixnum arguments whose ranges prove the exact
;;                        result is a fixnum; no effects
;;   %fx< %fx<= %fx> %fx>= %fx=
;;                        two fixnum arguments; no effects
;;   %fl+ %fl- %fl* %fl/  two float arguments; %fl/ keeps :raise (the
;;                        runtime raises on division by zero, even for floats)
;;   %fl< %fl<= %fl> %fl>= %fl=
;;                        two float arguments; no effects
;;
;; Not here because they aren't C builtins (otium.core defines them in
;; Otium, so they never reach the optimizer as primcalls): append, reverse,
;; raise, inc, dec, zero?, even?, odd?, first, rest, nth.

(def- entries {})

(def (lookup name)
  "The primop entry for name, or nil."
  (get entries name))

(def (names)
  "Every name in the table."
  (keys entries))

(def (arity-fits? entry count)
  "Whether a call of entry with count arguments has a valid argument count."
  (let ((arity (entry :arity)))
    (if (arity 1)
        (and (>= count (arity 0)) (or (nil? (entry :max)) (<= count (entry :max))))
        (= count (arity 0)))))

(def (effect? entry effect)
  (not (not (memq effect (entry :effects)))))

;; --- helpers ---------------------------------------------------------------------

(def- (every? f xs)
  (or (null? xs) (and (f (car xs)) (every? f (cdr xs)))))

(def- (some? f xs)
  (and (pair? xs) (or (f (car xs)) (some? f (cdr xs)))))

(def- true-fact (types/const-fact #t))

(def- false-fact (types/const-fact #f))

(def- nil-fact (types/const-fact nil))

(def- (bool-fact b)
  (if b
      true-fact
      false-fact))

(def (atom? v)
  "Constants folding may take: immutable values with no parts."
  (or (int? v) (float? v) (char? v) (boolean? v) (nil? v) (null? v) (string? v) (symbol? v) (keyword? v)))

(def (identity-free? v)
  "Values that eq? compares by value."
  (or (int? v) (char? v) (boolean? v) (nil? v) (null? v) (symbol? v) (keyword? v)))

(def- (refuse)
  (error "not foldable"))

(def- (folder f &optional (ok? atom?))
  (fn (args)
    (unless (every? ok? args) (refuse))
    (apply f args)))

(def- (any-value? _)
  #t)

;; The table is filled by prim!. options is a table of the optional keys.
(def- (prim! name arity effects options)
  (let ((e {:name name :arity arity :effects effects}))
    (for ((k v :in options))
      (put! e k v))
    (let ((transfer (or (e :transfer) (fn (_) types/any))))
      (put! e
            :transfer (fn (facts)
                        (cond
                          ((not (arity-fits? e (length facts))) types/none)
                          ((some? types/none? facts) types/none)
                          (else (transfer facts))))))
    (put! entries name e)
    e))

(def- (returns f)
  (fn (_) f))

(def- (returns-bits bits)
  (returns (types/fact bits)))

(def- fixnum-any (types/fact types/t-fixnum))

(def- float-fact (types/fact types/t-float))

(def- natural (types/fixnum-fact 0 types/fixnum-max))

(def- (reverse-list xs)
  (let loop ((xs xs)
             (out '()))
    (if (null? xs)
        out
        (loop (cdr xs) (cons (car xs) out)))))

(def- (restrict facts bits)
  "Each fact met with bits, or nil when one becomes none: the call raises."
  (let ((g (types/fact bits)))
    (let loop ((fs facts)
               (out '()))
      (if (null? fs)
          (reverse-list out)
          (let ((m (types/meet (car fs) g)))
            (if (types/none? m)
                nil
                (loop (cdr fs) (cons m out))))))))

;; --- numeric transfers -----------------------------------------------------------

;; range-of is (fn (facts) [lo hi] or nil) on facts that all allow fixnums;
;; nil means the whole range. The result can be a fixnum only when every
;; argument can be (and floats isn't :only). It can be a float when some
;; argument can be (floats :some), or always (:always and :only).
(def- (numeric range-of &optional (floats :some))
  (fn (facts)
    (let ((nums (restrict facts types/t-number)))
      (if (nil? nums)
          types/none
          (let ((fx (and (not (eq? floats :only)) (every? (fn (f) (not (types/never? f types/t-fixnum))) nums)))
                (fl (or (not (eq? floats :some)) (some? (fn (f) (not (types/never? f types/t-float))) nums))))
            (let ((bits (bitwise-ior (if fx
                                         types/t-fixnum
                                         0)
                                     (if fl
                                         types/t-float
                                         0)))
                  (r (and fx (range-of nums))))
              (if r
                  (types/fact bits (r 0) (r 1))
                  (types/fact bits))))))))

(def- (full-range _)
  nil)

(def- (add-range facts)
  (let loop ((fs facts)
             (lo 0)
             (hi 0))
    (if (null? fs)
        [lo hi]
        (let ((l (types/checked+ lo (types/fact-lo (car fs))))
              (h (types/checked+ hi (types/fact-hi (car fs)))))
          (and l h (loop (cdr fs) l h))))))

(def- (sub-range facts)
  (let ((first (car facts)))
    (if (null? (cdr facts))
        (let ((l (types/checked-negate (types/fact-hi first)))
              (h (types/checked-negate (types/fact-lo first))))
          (and l h [l h]))
        (let loop ((fs (cdr facts))
                   (lo (types/fact-lo first))
                   (hi (types/fact-hi first)))
          (if (null? fs)
              [lo hi]
              (let ((l (types/checked- lo (types/fact-hi (car fs))))
                    (h (types/checked- hi (types/fact-lo (car fs)))))
                (and l h (loop (cdr fs) l h))))))))

(def- (mul-range facts)
  (let loop ((fs facts)
             (lo 1)
             (hi 1))
    (if (null? fs)
        [lo hi]
        (let ((c (types/fact-lo (car fs)))
              (d (types/fact-hi (car fs))))
          (let ((p1 (types/checked* lo c))
                (p2 (types/checked* lo d))
                (p3 (types/checked* hi c))
                (p4 (types/checked* hi d)))
            (and p1 p2 p3 p4 (loop (cdr fs) (min (min p1 p2) (min p3 p4)) (max (max p1 p2) (max p3 p4)))))))))

(def- (extremum-range pick)
  (fn (facts)
    (let loop ((fs (cdr facts))
               (lo (types/fact-lo (car facts)))
               (hi (types/fact-hi (car facts))))
      (if (null? fs)
          [lo hi]
          (loop (cdr fs) (pick lo (types/fact-lo (car fs))) (pick hi (types/fact-hi (car fs))))))))

(def- (abs-range facts)
  (let ((lo (types/fact-lo (car facts)))
        (hi (types/fact-hi (car facts))))
    (cond
      ;; abs of fixnum-min wraps to fixnum-min.
      ((= lo types/fixnum-min) nil)
      ((>= lo 0) [lo hi])
      ((<= hi 0) [(- 0 hi) (- 0 lo)])
      (else [0 (max (- 0 lo) hi)]))))

;; Arguments that must be fixnums; the result is a fixnum in range's range.
(def- (fixnum-op range-of)
  (fn (facts)
    (let ((fs (restrict facts types/t-fixnum)))
      (if (nil? fs)
          types/none
          (let ((r (range-of fs)))
            (if r
                (types/fixnum-fact (r 0) (r 1))
                fixnum-any))))))

(def- (magnitude-minus-one x)
  ;; |x| - 1 without overflow, at least 0.
  (max 0
       (if (< x 0)
           (- -1 x)
           (- x 1))))

(def- (divisor-bound f)
  (max (magnitude-minus-one (types/fact-lo f)) (magnitude-minus-one (types/fact-hi f))))

(def- (quotient-range facts)
  (let ((lo (types/fact-lo (car facts)))
        (hi (types/fact-hi (car facts))))
    (cond
      ;; fixnum-min divided by -1 wraps to fixnum-min.
      ((= lo types/fixnum-min) nil)
      ((and (>= lo 0) (>= (types/fact-lo (car (cdr facts))) 1)) [0 hi])
      (else (let ((m (max (- 0 lo) hi))) [(- 0 m) m])))))

(def- (remainder-range facts)
  (let ((a (car facts))
        (m (divisor-bound (car (cdr facts)))))
    (cond
      ((>= (types/fact-lo a) 0) [0 (min m (types/fact-hi a))])
      ((<= (types/fact-hi a) 0) [(max (- 0 m) (types/fact-lo a)) 0])
      (else [(- 0 m) m]))))

(def- (modulo-range facts)
  (let ((d (car (cdr facts)))
        (m (divisor-bound (car (cdr facts)))))
    (cond
      ((>= (types/fact-lo d) 1) [0 m])
      ((<= (types/fact-hi d) -1) [(- 0 m) 0])
      (else [(- 0 m) m]))))

(def- (and-range facts)
  (let ((nonneg (filter (fn (f) (>= (types/fact-lo f) 0)) facts)))
    (if (null? nonneg)
        nil
        [0 (reduce (fn (m f) (min m (types/fact-hi f))) types/fixnum-max nonneg)])))

(def- (not-range facts)
  [(- -1 (types/fact-hi (car facts))) (- -1 (types/fact-lo (car facts)))])

(def- (rounding facts)
  ;; floor, ceiling, round, truncate and exact: a fixnum stays itself, a float
  ;; becomes a fixnum or raises.
  (let ((nums (restrict facts types/t-number)))
    (cond
      ((nil? nums) types/none)
      ((types/only? (car nums) types/t-fixnum) (car nums))
      (else fixnum-any))))

(def- (float-result facts)
  (if (nil? (restrict facts types/t-number))
      types/none
      float-fact))

(def- (number-test sure maybe)
  ;; A predicate on numbers that raises on anything else.
  (fn (facts)
    (let ((nums (restrict facts types/t-number)))
      (cond
        ((nil? nums) types/none)
        ((types/only? (car nums) sure) true-fact)
        ((types/never? (car nums) (bitwise-ior sure maybe)) false-fact)
        (else types/boolean)))))

(def- (sign-test positive)
  (fn (facts)
    (let ((nums (restrict facts types/t-number)))
      (cond
        ((nil? nums) types/none)
        ((not (types/fixnum-only? (car nums))) types/boolean)
        (positive (cond
                    ((> (types/fact-lo (car nums)) 0) true-fact)
                    ((<= (types/fact-hi (car nums)) 0) false-fact)
                    (else types/boolean)))
        (else (cond
                ((< (types/fact-hi (car nums)) 0) true-fact)
                ((>= (types/fact-lo (car nums)) 0) false-fact)
                (else types/boolean)))))))

;; decide: (fn (lo1 hi1 lo2 hi2) #t, #f or nil) for two fixnum ranges.
(def- (comparison decide)
  (fn (facts)
    (let ((nums (restrict facts types/t-number)))
      (cond
        ((nil? nums) types/none)
        ((and (null? (cdr (cdr nums))) (types/fixnum-only? (car nums)) (types/fixnum-only? (car (cdr nums))))
         (let ((a (car nums))
               (b (car (cdr nums))))
           (let ((answer (decide (types/fact-lo a) (types/fact-hi a) (types/fact-lo b) (types/fact-hi b))))
             (if (nil? answer)
                 types/boolean
                 (bool-fact answer)))))
        (else types/boolean)))))

(def- (decide-lt l1 h1 l2 h2)
  (cond
    ((< h1 l2) #t)
    ((>= l1 h2) #f)
    (else nil)))

(def- (decide-le l1 h1 l2 h2)
  (cond
    ((<= h1 l2) #t)
    ((> l1 h2) #f)
    (else nil)))

(def- (decide-gt l1 h1 l2 h2)
  (decide-lt l2 h2 l1 h1))

(def- (decide-ge l1 h1 l2 h2)
  (decide-le l2 h2 l1 h1))

(def- (decide-eq l1 h1 l2 h2)
  (cond
    ((and (= l1 h1) (= l2 h2) (= l1 l2)) #t)
    ((or (< h1 l2) (< h2 l1)) #f)
    (else nil)))

;; --- other transfers -------------------------------------------------------------

(def- (type-test sure &optional (maybe 0))
  ;; True for every value with a type in sure, false for every value outside
  ;; sure and maybe.
  (fn (facts)
    (let ((f (car facts)))
      (cond
        ((types/only? f sure) true-fact)
        ((types/never? f (bitwise-ior sure maybe)) false-fact)
        (else types/boolean)))))

(def- (type-refines sure &optional (maybe 0))
  [(bitwise-ior sure maybe) (bitwise-and types/t-any (bitwise-not sure))])

(def- (disjoint? a b)
  (or (= (bitwise-and (types/fact-bits a) (types/fact-bits b)) 0)
      (and (types/fixnum-only? a)
           (types/fixnum-only? b)
           (or (< (types/fact-hi a) (types/fact-lo b)) (< (types/fact-hi b) (types/fact-lo a))))))

(def- (eq-transfer facts)
  (let ((a (car facts))
        (b (car (cdr facts))))
    (cond
      ((disjoint? a b) false-fact)
      ((and (types/const? a)
            (types/const? b)
            (identity-free? (types/fact-const a))
            (identity-free? (types/fact-const b)))
       (bool-fact (eq? (types/fact-const a) (types/fact-const b))))
      (else types/boolean))))

(def- (equal-transfer facts)
  (let ((a (car facts))
        (b (car (cdr facts))))
    (cond
      ((disjoint? a b) false-fact)
      ((and (types/const? a) (types/const? b) (atom? (types/fact-const a)) (atom? (types/fact-const b)))
       (bool-fact (equal? (types/fact-const a) (types/fact-const b))))
      (else types/boolean))))

(def- (not-transfer facts)
  (let ((t (types/truthiness (car facts))))
    (cond
      ((eq? t #t) false-fact)
      ((eq? t #f) true-fact)
      (else types/boolean))))

(def- (first-as bits &optional (same-object #t))
  ;; The result is the first argument, which must have one of these types,
  ;; or, when same-object is false, a new value of its type.
  (fn (facts)
    (let ((m (types/meet (car facts) (types/fact bits))))
      (if (or same-object (not (types/const? m)))
          m
          (types/fact (types/fact-bits m) (types/fact-lo m) (types/fact-hi m))))))

(def- (needs bits result)
  ;; Raises unless the first argument has one of these types.
  (fn (facts)
    (if (types/never? (car facts) bits)
        types/none
        result)))

(def- (needs-all bits result)
  (fn (facts)
    (if (nil? (restrict facts bits))
        types/none
        result)))

(def- t-gettable (bitwise-ior types/t-nil types/t-string types/t-table types/t-array types/t-other))

(def- (get-transfer facts)
  (let ((c (car facts))
        (fallback (if (null? (cdr (cdr facts)))
                      nil-fact
                      (car (cdr (cdr facts))))))
    (cond
      ((types/never? c t-gettable) types/none)
      ((types/only? c types/t-nil) fallback)
      ((types/only? c types/t-string) (types/join (types/fact types/t-char) fallback))
      (else types/any))))

(def- t-table-or-nil (bitwise-ior types/t-table types/t-nil))

(def- t-measurable
  (bitwise-ior types/t-nil types/t-empty types/t-pair types/t-string types/t-array types/t-table types/t-other))

(def- (length-transfer facts)
  (let ((c (car facts)))
    (cond
      ((types/never? c t-measurable) types/none)
      ((types/only? c (bitwise-ior types/t-nil types/t-empty)) (types/const-fact 0))
      (else natural))))

(def- (list-transfer facts)
  (if (null? facts)
      (types/const-fact '())
      (types/fact types/t-pair)))

;; --- arithmetic and comparison ---------------------------------------------------

(def- every-effect '(:alloc :read :write :raise :call :switch))

(prim! '+ [0 #t] '(:raise) {:fold (folder +) :transfer (numeric add-range) :vm :add :vm-arity 2})
(prim! '- [1 #t] '(:raise) {:fold (folder -) :transfer (numeric sub-range) :vm :sub :vm-arity 2})
(prim! '* [0 #t] '(:raise) {:fold (folder *) :transfer (numeric mul-range) :vm :mul :vm-arity 2})

;; One argument always gives a float: (/ 2) is 0.5 and (/ 1) is 1.0.
(prim! '/
       [1 #t]
       '(:raise)
       {:fold (folder /)
        :transfer (fn (facts)
                    ((numeric full-range
                              (if (null? (cdr facts))
                                  :only
                                  :always))
                     facts))})
(prim! 'quotient [2 #f] '(:raise) {:fold (folder quotient) :transfer (fixnum-op quotient-range)})
(prim! 'remainder [2 #f] '(:raise) {:fold (folder remainder) :transfer (fixnum-op remainder-range)})
(prim! 'modulo [2 #f] '(:raise) {:fold (folder modulo) :transfer (fixnum-op modulo-range)})
(prim! 'abs [1 #f] '(:raise) {:fold (folder abs) :transfer (numeric abs-range)})
(prim! 'min [1 #t] '(:raise) {:fold (folder min) :transfer (numeric (extremum-range min))})
(prim! 'max [1 #t] '(:raise) {:fold (folder max) :transfer (numeric (extremum-range max))})
(prim! 'expt [2 #f] '(:raise) {:fold (folder expt) :transfer (numeric full-range :always)})

(for-each (fn (entry) (prim! (car entry) [1 #f] '(:raise) {:fold (folder (cdr entry)) :transfer rounding}))
          (list (cons 'floor floor)
                (cons 'ceiling ceiling)
                (cons 'round round)
                (cons 'truncate truncate)
                (cons 'exact exact)))

(prim! 'inexact [1 #f] '(:raise) {:fold (folder inexact) :transfer float-result})

(for-each (fn (entry) (prim! (car entry) [1 #f] '(:raise) {:fold (folder (cdr entry)) :transfer float-result}))
          (list (cons 'sqrt sqrt)
                (cons 'exp exp)
                (cons 'log log)
                (cons 'sin sin)
                (cons 'cos cos)
                (cons 'tan tan)
                (cons 'asin asin)
                (cons 'acos acos)))
(prim! 'atan [1 #t] '(:raise) {:max 2 :fold (folder atan) :transfer float-result})

(prim! 'exact? [1 #f] '(:raise) {:fold (folder exact?) :transfer (number-test types/t-fixnum 0)})
(prim! 'inexact? [1 #f] '(:raise) {:fold (folder inexact?) :transfer (number-test types/t-float 0)})
(prim! 'finite? [1 #f] '(:raise) {:fold (folder finite?) :transfer (number-test types/t-fixnum types/t-float)})
(prim! 'nan? [1 #f] '(:raise) {:fold (folder (fn (x) (nan? x))) :transfer (number-test 0 types/t-float)})
(prim! 'infinite? [1 #f] '(:raise) {:fold (folder (fn (x) (infinite? x))) :transfer (number-test 0 types/t-float)})
(prim! 'pos? [1 #f] '(:raise) {:fold (folder pos?) :transfer (sign-test #t)})
(prim! 'neg? [1 #f] '(:raise) {:fold (folder neg?) :transfer (sign-test #f)})

(prim! 'bitwise-and [0 #t] '(:raise) {:fold (folder bitwise-and) :transfer (fixnum-op and-range)})
(prim! 'bitwise-ior [0 #t] '(:raise) {:fold (folder bitwise-ior) :transfer (fixnum-op full-range)})
(prim! 'bitwise-xor [0 #t] '(:raise) {:fold (folder bitwise-xor) :transfer (fixnum-op full-range)})
(prim! 'bitwise-not [1 #f] '(:raise) {:fold (folder bitwise-not) :transfer (fixnum-op not-range)})
(prim! 'bitwise-arithmetic-shift
       [2 #f]
       '(:raise)
       {:fold (folder bitwise-arithmetic-shift) :transfer (fixnum-op full-range)})
(prim! 'number->string
       [1 #f]
       '(:raise)
       {:fold (folder number->string) :transfer (needs-all types/t-number (types/fact types/t-string))})

(def- (comparison! name f decide vm branch)
  (prim! name
         [2 #t]
         '(:raise)
         {:fold (folder f)
          :transfer (comparison decide)
          :refines [types/t-number types/t-number]
          :vm vm
          :vm-arity 2
          :branch branch}))

(comparison! '< < decide-lt :lt :br-lt)
(comparison! '<= <= decide-le :le :br-le)
(comparison! '> > decide-gt :gt :br-gt)
(comparison! '>= >= decide-ge :ge :br-ge)
(comparison! '= = decide-eq :numeq :br-numeq)

;; --- predicates ------------------------------------------------------------------

(def- (predicate! name f sure &optional (maybe 0) (extra {}))
  (let ((options {:fold (folder f any-value?) :transfer (type-test sure maybe) :refines (type-refines sure maybe)}))
    (for ((k v :in extra))
      (put! options k v))
    (prim! name [1 #f] '() options)))

(predicate! 'pair? pair? types/t-pair 0 {:vm :pairp :vm-arity 1 :branch :br-pair})
(predicate! 'null? null? types/t-empty 0 {:vm :nullp :vm-arity 1 :branch :br-null})
(predicate! 'nil? nil? types/t-nil)
(predicate! 'number? number? types/t-number)
(predicate! 'integer? integer? types/t-fixnum types/t-float)
(predicate! 'int? int? types/t-fixnum)
(predicate! 'float? float? types/t-float)
(predicate! 'string? string? types/t-string)
(predicate! 'symbol? symbol? types/t-symbol)
(predicate! 'keyword? keyword? types/t-keyword)
(predicate! 'array? array? types/t-array)
(predicate! 'table? table? types/t-table)
(predicate! 'procedure? procedure? types/t-procedure)
(predicate! 'boolean? boolean? types/t-boolean)
(predicate! 'char? char? types/t-char)
(predicate! 'record? record? types/t-record)
(prim! 'list?
       [1 #f]
       '(:read)
       {:fold (folder list?)
        :transfer (type-test types/t-empty types/t-pair)
        :refines (type-refines types/t-empty types/t-pair)})
(prim! 'not
       [1 #f]
       '()
       {:fold (folder not any-value?)
        :transfer not-transfer
        :refines [types/t-falsy types/t-truthy]
        :vm :not
        :vm-arity 1})
(prim! 'eq? [2 #f] '() {:fold (folder eq? identity-free?) :transfer eq-transfer :vm :eq :vm-arity 2 :branch :br-eq})
(prim! 'equal? [2 #f] '(:read) {:fold (folder equal?) :transfer equal-transfer})

;; --- pairs, lists and collections ------------------------------------------------

(prim! 'cons [2 #f] '(:alloc) {:transfer (returns-bits types/t-pair) :vm :cons :vm-arity 2})
(prim! 'car [1 #f] '(:read :raise) {:transfer (needs types/t-pair types/any) :vm :car :vm-arity 1})
(prim! 'cdr [1 #f] '(:read :raise) {:transfer (needs types/t-pair types/any) :vm :cdr :vm-arity 1})
(prim! 'list
       [0 #t]
       '(:alloc)
       {:fold (fn (args)
                (if (null? args)
                    '()
                    (refuse)))
        :transfer list-transfer})
(prim! 'set-car! [2 #f] '(:read :write :raise) {:transfer (first-as types/t-pair)})
(prim! 'set-cdr! [2 #f] '(:read :write :raise) {:transfer (first-as types/t-pair)})
(prim! 'length [1 #f] '(:read :raise) {:fold (folder length) :transfer length-transfer})
(prim! 'get [2 #t] '(:read :raise) {:max 3 :fold (folder get) :transfer get-transfer})
(prim! 'put!
       [3 #t]
       '(:read :write :raise)
       {:transfer (first-as (bitwise-ior types/t-array types/t-table types/t-other))})
(prim! 'push! [1 #t] '(:read :write :raise) {:transfer (first-as types/t-array)})
(prim! 'pop! [1 #f] '(:read :write :raise) {:transfer (needs types/t-array types/any)})
(prim! 'array [0 #t] '(:alloc) {:transfer (returns-bits types/t-array)})
(prim! 'table [0 #t] '(:alloc :raise) {:transfer (returns-bits types/t-table)})
(prim! 'keys [1 #f] '(:alloc :read :raise) {:transfer (needs t-table-or-nil (types/fact types/t-array))})
(prim! 'values [1 #f] '(:alloc :read :raise) {:transfer (needs t-table-or-nil (types/fact types/t-array))})
(prim! 'copy
       [1 #f]
       '(:alloc :read :raise)
       {:transfer (first-as (bitwise-ior types/t-array types/t-table types/t-nil types/t-other) #f)})

;; --- strings, symbols and characters ---------------------------------------------

(prim! 'str [0 #t] '(:read :raise) {:fold (folder str) :transfer (returns-bits types/t-string)})
(prim! 'string-length [1 #f] '(:raise) {:fold (folder string-length) :transfer (needs types/t-string natural)})
(prim! 'string-ref
       [2 #f]
       '(:raise)
       {:fold (folder string-ref) :transfer (needs types/t-string (types/fact types/t-char))})
(prim! 'substring
       [2 #t]
       '(:raise)
       {:max 3 :fold (folder substring) :transfer (needs types/t-string (types/fact types/t-string))})
(prim! 'string-append
       [0 #t]
       '(:raise)
       {:fold (folder string-append) :transfer (needs-all types/t-string (types/fact types/t-string))})
(prim! 'symbol->string
       [1 #f]
       '(:raise)
       {:fold (folder symbol->string) :transfer (needs types/t-symbol (types/fact types/t-string))})
(prim! 'string->symbol
       [1 #f]
       '(:raise)
       {:fold (folder string->symbol) :transfer (needs types/t-string (types/fact types/t-symbol))})
(prim! 'keyword [1 #f] '(:raise) {:fold (folder keyword) :transfer (returns-bits types/t-keyword)})
(prim! 'char->integer
       [1 #f]
       '(:raise)
       {:fold (folder char->integer) :transfer (needs types/t-char (types/fixnum-fact 0 1114111))})
(prim! 'integer->char
       [1 #f]
       '(:raise)
       {:fold (folder integer->char) :transfer (needs types/t-fixnum (types/fact types/t-char))})
(prim! 'type [1 #f] '() {:fold (folder type) :transfer (returns-bits types/t-keyword)})

;; --- calls, errors and output ----------------------------------------------------

(prim! 'apply [1 #t] every-effect {})
(prim! 'error [0 #t] every-effect {:transfer (returns types/none)})
(prim! 'signal [1 #t] every-effect {})

;; --- variants --------------------------------------------------------------------

(def- (variant! name base effects &optional (options {}))
  (let ((b (lookup base)))
    (let ((o {:base base
              :arity (b :arity)
              :fold (b :fold)
              :transfer (b :transfer)
              :refines (b :refines)
              :vm (b :vm)
              :vm-arity (b :vm-arity)
              :branch (b :branch)}))
      (for ((k v :in options))
        (put! o k v))
      (prim! name (o :arity) effects o))))

(variant! '%car 'car '(:read))
(variant! '%cdr 'cdr '(:read))

(for-each (fn (entry)
            (variant! (car (cdr entry)) (car entry) '(:raise) {:arity [2 #f]})
            (variant! (car (cdr (cdr entry))) (car entry) '() {:arity [2 #f]}))
          '((+ %fx+ %fx+/no-overflow) (- %fx- %fx-/no-overflow) (* %fx* %fx*/no-overflow)))

(for-each (fn (entry) (variant! (cdr entry) (car entry) '() {:arity [2 #f] :refines [types/t-fixnum types/t-fixnum]}))
          '((< . %fx<) (<= . %fx<=) (> . %fx>) (>= . %fx>=) (= . %fx=)))

(for-each (fn (entry) (variant! (cdr entry) (car entry) '() {:arity [2 #f]})) '((+ . %fl+) (- . %fl-) (* . %fl*)))
(variant! '%fl/ '/ '(:raise) {:arity [2 #f]})
(for-each (fn (entry) (variant! (cdr entry) (car entry) '() {:arity [2 #f] :refines [types/t-float types/t-float]}))
          '((< . %fl<) (<= . %fl<=) (> . %fl>) (>= . %fl>=) (= . %fl=)))

(def (variant-allows? name args)
  "Whether the values args meet the variant name's precondition (on which it
behaves like its base), including the argument count. True for names that
aren't variants."
  (let ((need (get variant-preconditions name))) (or (nil? need) (and (p-arity-fits? name (length args)) (need args)))))

(def- (p-arity-fits? name n)
  (arity-fits? (lookup name) n))

(def- (both? f)
  (fn (args) (and (f (car args)) (f (car (cdr args))))))

(def- (no-overflow? op)
  (fn (args) (and (int? (car args)) (int? (car (cdr args))) (not (nil? (op (car args) (car (cdr args))))))))

(def- variant-preconditions
  {'%car (fn (args) (pair? (car args)))
   '%cdr (fn (args) (pair? (car args)))
   '%fx+ (both? int?)
   '%fx- (both? int?)
   '%fx* (both? int?)
   '%fx+/no-overflow (no-overflow? types/checked+)
   '%fx-/no-overflow (no-overflow? types/checked-)
   '%fx*/no-overflow (no-overflow? types/checked*)
   '%fx< (both? int?)
   '%fx<= (both? int?)
   '%fx> (both? int?)
   '%fx>= (both? int?)
   '%fx= (both? int?)
   '%fl+ (both? float?)
   '%fl- (both? float?)
   '%fl* (both? float?)
   '%fl/ (both? float?)
   '%fl< (both? float?)
   '%fl<= (both? float?)
   '%fl> (both? float?)
   '%fl>= (both? float?)
   '%fl= (both? float?)})

;; --- the old interface -----------------------------------------------------------
;;
;; What cp0.ot uses, kept until the front end's inline.ot moves to lookup.
;;
;; Effects, from weakest to strongest:
;;   :pure   no effects and never raises
;;   :alloc  returns a fresh object and never raises; droppable, never folded
;;           because the result has identity
;;   :check  no effects, but raises on bad arguments; folded on constants
;;   :read   reads mutable data and may raise; never folded or dropped
;;
;; :fold marks a :pure or :check builtin whose result can be computed at
;; compile time when every argument is a constant. :type is the result's type
;; when it's always the same (see type-truthy?).

(def- table-of {})

(def- (declare! effect fold type names)
  (for-each (fn (n) (put! table-of n {:effect effect :fold fold :type (or type #f)})) names))

(declare! :pure #t
          :boolean '(not eq?
                         equal?
                         null?
                         pair?
                         nil?
                         number?
                         int?
                         float?
                         string?
                         symbol?
                         keyword?
                         char?
                         boolean?
                         procedure?
                         array?
                         table?
                         list?
                         record?
                         instance?
                         eof-object?
                         bytevector?
                         port?))
(declare! :pure #t nil '(identity))
(declare! :check #t
          :number '(+ -
                      *
                      /
                      abs
                      min
                      max
                      quotient
                      remainder
                      modulo
                      inc
                      dec
                      floor
                      ceiling
                      round
                      truncate
                      exact
                      inexact
                      bitwise-and
                      bitwise-ior
                      bitwise-xor
                      bitwise-not
                      char->integer
                      string-length))
(declare! :check #t :boolean '(< > <= >= = zero? pos? neg? positive? negative? even? odd? string=? char=? char<?))
(declare! :check #t :char '(integer->char))
(declare! :check #t :keyword '(keyword))
(declare! :check #t :symbol '(string->symbol symbol))
(declare! :alloc #f :pair '(cons))
(declare! :alloc #f :array '(array))
(declare! :alloc #f :table '(table))
(declare! :alloc #f nil '(list))
(declare! :read #f
          nil
          '(car cdr
                caar
                cadr
                cdar
                cddr
                first
                second
                third
                rest
                length
                get
                nth
                last
                list-tail
                list-ref
                memq
                member
                assq
                assoc
                keys
                values
                contains?
                string-ref
                substring))
(declare! :read #f :string '(str))
(declare! :read #f :array '(copy))

(def (info name)
  "What's known about builtin name, or nil."
  (get table-of name))

(def (effect name)
  (let ((i (info name)))
    (if i
        (i :effect)
        :effect)))

(def (droppable? name)
  "True when an unused call to name can be removed, keeping its arguments."
  (member (effect name) '(:pure :alloc)))

(def (foldable? name)
  (let ((i (info name))) (and i (i :fold))))

(def (result-type name args)
  (cond
    ((eq? name 'list)
     (if (null? args)
         :null
         :pair))
    (else (let ((i (info name))) (and i (i :type))))))

;; A type is one of :pair :null :nil :false :true :boolean :int :float :number
;; :string :symbol :keyword :char :array :table :fn. :boolean covers :true and
;; :false; :number covers :int and :float.

(def (type-of-value v)
  (cond
    ((nil? v) :nil)
    ((eq? v #f) :false)
    ((eq? v #t) :true)
    ((int? v) :int)
    ((float? v) :float)
    ((pair? v) :pair)
    ((null? v) :null)
    ((string? v) :string)
    ((symbol? v) :symbol)
    ((keyword? v) :keyword)
    ((char? v) :char)
    (else #f)))

(def (type-truthy? type)
  "#t when every value of type is truthy, #f when every one is falsy, else nil."
  (cond
    ((not type) nil)
    ((member type '(:nil :false)) #f)
    ((eq? type :boolean) nil)
    (else #t)))

(def- predicate-types
  {'pair? '(:pair)
   'null? '(:null)
   'nil? '(:nil)
   'array? '(:array)
   'table? '(:table)
   'string? '(:string)
   'symbol? '(:symbol)
   'keyword? '(:keyword)
   'char? '(:char)
   'int? '(:int)
   'float? '(:float)
   'number? '(:int :float :number)
   'boolean? '(:true :false :boolean)
   'procedure? '(:fn)})

(def (type-predicate? name)
  (not (nil? (get predicate-types name))))

(def (predicate-type name)
  "The type a true answer from predicate name proves, or nil."
  (let ((types (get predicate-types name))) (and types (last types))))

(def (predicate-answer name type)
  "#t or #f when predicate name's answer follows from type, else nil."
  (let ((types (get predicate-types name)))
    (cond
      ((or (nil? types) (not type)) nil)
      ((member type types) #t)
      ((and (eq? type :number) (or (member :int types) (member :float types))) nil)
      ((and (eq? type :boolean) (or (member :true types) (member :false types))) nil)
      (else #f))))

;; Integers are folded only while they'd fit the smallest fixnum Otium is
;; likely to run with, so folding never makes a constant a runtime can't read.
(def int-limit 536870911)

(def (literal? v)
  "True when v can be written into source and read back as an equal value."
  (cond
    ((int? v) (<= (abs v) int-limit))
    ((float? v) (and (= v v) (< (abs v) 1e300)))
    (else (or (nil? v) (boolean? v) (char? v) (keyword? v) (symbol? v)))))

(def- folders {})

(def (fold name values)
  "The constant result of builtin name on values, as (value), or nil when it
can't be folded."
  (when (and (foldable? name) (every? literal-argument? values))
    (let ((f (or (get folders name)
                 (let ((g (eval name)))
                   (put! folders name g)
                   g)))
          (result (try
                    (list (apply f values))
                    (catch _ nil))))
      (when (and result (literal? (car result))) result))))

(def- (literal-argument? v)
  (or (literal? v) (string? v) (null? v)))
