(ns otium.compiler.propagate)

;; Propagate: constant, type and range propagation over the block IR, then a
;; rewrite into a fresh IR. The contract is docs/optimizer.md, "Propagate".
;;
;; (run ir) works in three steps over the whole input:
;;
;; 1. Analysis, per function, parents before children so a free variable's
;;    fact is final when a nested function reads it. Sparse conditional
;;    propagation (Wegman and Zadeck): every block starts unreachable and
;;    every value at types/none. A block becomes executable when an edge to it
;;    does; a changed value re-evaluates the operations and terminators that
;;    use it. Block parameters join the facts passed on executable incoming
;;    jumps; call results, handler conditions and entry parameters are any.
;;    Parameters of loop headers (targets of retreating edges in reverse
;;    postorder) widen after three changes, so ranges stop growing.
;;
;;    Branches refine. In a block whose only predecessor ends in a branch or
;;    branch-prim, the values tested there have narrower facts: the truthy or
;;    falsy part for branch, the :refines bits of a predicate's first
;;    argument, numbers for a comparison's arguments, and for a two-argument
;;    comparison of fixnums the range the outcome implies ((< i n) gives
;;    i <= hi(n) - 1). These hold in the region that block dominates
;;    (static dominators of the whole CFG), and fact-at applies them.
;;
;; 2. Decisions, per function, walking the dominator tree over executable
;;    blocks: what each operation becomes (copied, specialized, a constant,
;;    or replaced by an earlier value), what each terminator becomes, with a
;;    CSE table whose entries a subtree adds are removed when the walk leaves
;;    it. Values are replaced through canon, which maps an input value to the
;;    input value standing for it.
;;
;; 3. Liveness, then emission. Marking starts from the terminators of
;;    executable blocks and operations that can't be removed, follows
;;    operands, and makes a nested function live when a live closure
;;    operation creates it. Unmarked removable operations, block parameters
;;    only jumps feed, and functions nothing creates aren't copied.
;;
;; Decisions where the spec is silent:
;; - An operation whose fact is types/none can't return; the analysis then
;;   leaves its successors' code unreachable. A branch whose test can't be
;;   computed marks no edge and becomes unreachable. A branch-prim whose
;;   transfer says it always raises keeps both edges so the raise stays.
;; - Constants replace values (parameters too) only when the constant is an
;;   atom (prims/atom?); the constant is emitted where the value was
;;   defined, or at the top of the parameter's block. An operation that may
;;   raise stays, and a constant after it takes its uses.
;; - The unbound marker is a t-other value (it has no bit of its own), so
;;   check-bound is proven when its argument can't be t-other.
;; - :value calls of a closure or self value become :known when the callee
;;   accepts the argument count. The closure value stays live, so Closures
;;   can go back to a :value call on it.
;; - Folding: a primop with :fold whose arguments are all constants folds
;;   when the folder accepts them and the result is an atom.
;;
;; Fuel: (set-fuel! n) allows n more rewrites, counted across runs, after
;; which everything is copied as it is; nil (the default) allows any number.
;; Each specialization, constant, CSE hit, dropped check, :known call,
;; folded branch and dropped operation or parameter costs one. Binary search
;; on n finds the rewrite that breaks a program.

(require (otium.compiler.column :as column)
         (otium.compiler.ir :as ir)
         (otium.compiler.prims :as prims)
         (otium.compiler.types :as types))

;; --- fuel ------------------------------------------------------------------------

(def- fuel nil)

(def (set-fuel! n)
  "Allow n more rewrites, counted across runs; nil allows any number."
  (set! fuel n)
  nil)

(def (fuel-left)
  "The rewrites still allowed, or nil when there's no limit."
  fuel)

(def- (spend!)
  (cond
    ((nil? fuel) #t)
    ((> fuel 0) (set! fuel (- fuel 1)) #t)
    (else #f)))

;; --- state -----------------------------------------------------------------------

(def- widen-after 3)

(def- no -1)

(defrecord State
  (facts ; value -> fact
    refs ; value -> list of refinements [P B side doms f]
    exec ; block -> #t once executable
    oargs ; op -> argument list
    uses ; value -> list of [:op o] and [:term b]
    bkind ; block -> terminator kind
    bsuccs ; block -> array of successors
    btargs ; block -> terminator operands
    edges ; block -> bitmask of executable successor indexes
    queue ; values whose facts changed
    queued ; value -> #t while on queue
    blocks ; blocks to visit
    current ; function being analyzed
    preds ; block -> predecessor list, one per edge
    changes ; value -> times its fact grew
    header ; block -> #t for loop headers
    charged ; block -> #t once its branch may fold
    touch ; value -> values refined together with it
    stamp ; value -> last touch walk that visited it
    stamp-n
    vop ; value -> defining op, or no
    ir
    ;; decisions
    canon ; value -> replacement value, or nil for itself
    kind ; op value -> :copy :const :replaced
    code ; op value -> code to emit
    cval ; op value -> constant, for :const and after
    keep ; op value -> #t when it can't be removed
    after ; op value -> #t when a constant takes its uses
    pconst ; param -> #t when a constant takes its uses
    term ; block -> nil, :unreachable, or the successor index a branch becomes a jump to
    tprim ; block -> branch-prim's primop
    tknown ; block -> known callee function, or nil
    order ; function -> executable blocks in dominator preorder
    ;; liveness
    live ; value -> #t when emitted (ops) or kept (params)
    used ; value -> #t once something uses it
    fn-live ; function -> #t
    work
    fdoms ; function -> dominators
    bparams ; block -> parameter list
    bops ; block -> operation list
    ))

(def- (new-state x)
  (let ((nv (ir/value-count x))
        (nb (ir/block-count x))
        (no-ops (ir/op-count x)))
    (let ((s (record-new State
                         (column/filled nv types/none)
                         (column/filled nv '())
                         (column/filled nb #f)
                         (column/filled no-ops '())
                         (ir/uses x)
                         (column/filled nb nil)
                         (column/filled nb nil)
                         (column/filled nb nil)
                         (column/filled nb 0)
                         []
                         (column/filled nv #f)
                         []
                         nil
                         (column/filled nb nil)
                         (column/filled nv 0)
                         (column/filled nb #f)
                         (column/filled nb #f)
                         (column/filled nv '())
                         (column/filled nv 0)
                         0
                         (column/filled nv no)
                         x
                         (column/filled nv nil)
                         (column/filled nv nil)
                         (column/filled nv nil)
                         (column/filled nv nil)
                         (column/filled nv #f)
                         (column/filled nv #f)
                         (column/filled nv #f)
                         (column/filled nb nil)
                         (column/filled nb nil)
                         (column/filled nb nil)
                         (column/filled (ir/function-count x) '())
                         (column/filled nv #f)
                         (column/filled nv #f)
                         (column/filled (ir/function-count x) #f)
                         []
                         (column/filled (ir/function-count x) nil)
                         (column/filled nb '())
                         (column/filled nb '()))))
      (dotimes (o no-ops)
        (put! (s :oargs) o (ir/op-args x o))
        (put! (s :vop) (ir/op-value x o) o))
      (dotimes (b nb)
        (put! (s :bkind) b (ir/term-kind x b))
        (put! (s :bsuccs) b (list-to-array (ir/succs x b)))
        (put! (s :btargs) b (ir/term-args x b))
        (put! (s :preds) b (ir/preds x b))
        (put! (s :bparams) b (ir/block-params x b))
        (put! (s :bops) b (ir/block-ops x b)))
      s)))

;; --- facts -----------------------------------------------------------------------

(def- procedure-fact (types/fact types/t-procedure))

(def- other-fact (types/fact types/t-other))

(def- nil-fact (types/const-fact nil))

(def- truthy-fact (types/fact types/t-truthy))

(def- falsy-fact (types/fact types/t-falsy))

(def- number-fact (types/fact types/t-number))

(def- comparisons '(< <= > >= =))

(def- (base-of entry)
  (or (entry :base) (entry :name)))

(def- (comparison? entry)
  (not (not (memq (base-of entry) comparisons))))

;; For a comparison and a side (0 true, 1 false), the order it implies
;; between its two arguments: a list of (p q strict), meaning x_p < x_q when
;; strict is 1 and x_p <= x_q when it's 0.
(def- (relations base side)
  (let ((true? (= side 0)))
    (cond
      ((eq? base '<)
       (if true?
           '((0 1 1))
           '((1 0 0))))
      ((eq? base '<=)
       (if true?
           '((0 1 0))
           '((1 0 1))))
      ((eq? base '>)
       (if true?
           '((1 0 1))
           '((0 1 0))))
      ((eq? base '>=)
       (if true?
           '((1 0 0))
           '((0 1 1))))
      ((eq? base '=)
       (if true?
           '((0 1 0) (1 0 0))
           '()))
      (else '()))))

(def- (refinement-fact s r v depth)
  "What refinement r says about value v. The other operand's fact comes from
fact-at with depth levels of refinement, or its own fact at depth 0, which
keeps a chain of comparisons linear."
  (let ((p (r 0))
        (side (r 2)))
    (if (eq? ((s :bkind) p) :branch)
        (if (= side 0)
            truthy-fact
            falsy-fact)
        (let ((entry (prims/lookup (ir/term-prim (s :ir) p)))
              (args ((s :btargs) p))
              (out types/any))
          (when (and (entry :refines) (eq? v (car args))) (set! out (types/fact ((entry :refines) side))))
          (when (comparison? entry)
            (set! out (types/meet out number-fact))
            (when (= (length args) 2)
              (let ((fs (list-to-array (map (fn (a)
                                              (if (> depth 0)
                                                  (fact-at* s a p (- depth 1))
                                                  ((s :facts) a)))
                                            args))))
                (when (and (types/fixnum-only? (fs 0)) (types/fixnum-only? (fs 1)))
                  (for-each (fn (rel)
                              (let ((p (car rel))
                                    (q (cadr rel))
                                    (k (caddr rel)))
                                (when (eq? v (list-ref args p))
                                  (let ((hi (types/checked- (types/fact-hi (fs q)) k)))
                                    (set! out
                                          (types/meet out
                                                      (if hi
                                                          (types/fixnum-fact types/fixnum-min hi)
                                                          types/none)))))
                                (when (eq? v (list-ref args q))
                                  (let ((lo (types/checked+ (types/fact-lo (fs p)) k)))
                                    (set! out
                                          (types/meet out
                                                      (if lo
                                                          (types/fixnum-fact lo types/fixnum-max)
                                                          types/none)))))))
                            (relations (base-of entry) side))))))
          out))))

(def- (fact-at s v b)
  "The fact of value v at block b: its own, narrowed by the branches that
dominate b."
  (fact-at* s v b 1))

(def- (fact-at* s v b depth)
  (let ((f ((s :facts) v))
        (rs ((s :refs) v)))
    (if (null? rs)
        f
        (let ((x (s :ir)))
          (let loop ((rs rs)
                     (f f))
            (cond
              ((null? rs) f)
              ((and (= ((car rs) 4) (ir/block-fn x b)) (ir/dominates? x ((car rs) 3) ((car rs) 1) b))
               (loop (cdr rs) (types/meet f (refinement-fact s (car rs) v depth))))
              (else (loop (cdr rs) f))))))))

(def- (all? f xs)
  (or (null? xs) (and (f (car xs)) (all? f (cdr xs)))))

(def- (fold-prim entry facts)
  "(value) when entry folds on these constant facts to an atom, else nil."
  (when (and (entry :fold) (all? types/const? facts))
    (let ((result (try
                    (list ((entry :fold) (map types/fact-const facts)))
                    (catch _ nil))))
      (and result (prims/atom? (car result)) result))))

(def- (prim-fact entry facts)
  (let ((folded (fold-prim entry facts)))
    (if folded
        (types/const-fact (car folded))
        ((entry :transfer) facts))))

(def- (op-fact s o b)
  (let ((code (ir/op-code (s :ir) o))
        (facts (map (fn (a) (fact-at s a b)) ((s :oargs) o))))
    (cond
      ((eq? code 'const) (types/const-fact (ir/op-aux (s :ir) o)))
      ((not (all? (fn (f) (not (types/none? f))) facts)) types/none)
      ((ir/ir-code? code) (ir-code-fact code (ir/op-aux (s :ir) o) facts))
      (else (let ((entry (prims/lookup code)))
              (if entry
                  (prim-fact entry facts)
                  types/any))))))

(def- (ir-code-fact code aux facts)
  (cond
    ((memq code '(global-ref box-ref env-ref)) types/any)
    ((memq code '(global-set global-def box-set pop-try push-cleanup run-cleanup)) nil-fact)
    ((memq code '(prim-ref closure self make-closure static-closure)) procedure-fact)
    ((memq code '(box unbound)) other-fact)
    ((eq? code 'check-bound) (car facts))
    ((eq? code 'bound?)
     (if (types/never? (car facts) types/t-other)
         (types/const-fact #t)
         types/boolean))
    ((eq? code 'refine) (types/meet (car facts) (types/fact aux)))
    ((eq? code 'raise) types/none)
    (else types/any)))

;; --- analysis --------------------------------------------------------------------

(def- (enqueue! s v)
  (unless ((s :queued) v)
    (put! (s :queued) v #t)
    (push! (s :queue) v)))

(def- (update! s v new widen?)
  (let ((old ((s :facts) v)))
    (let ((j (types/join old new)))
      (let ((j (if (and widen? (>= ((s :changes) v) widen-after))
                   (types/widen old j)
                   j)))
        (unless (types/same-fact? old j)
          (put! (s :facts) v j)
          (put! (s :changes) v (+ 1 ((s :changes) v)))
          (enqueue! s v))))))

(def- (edge-exec? s p b)
  (let ((succ ((s :bsuccs) p))
        (mask ((s :edges) p)))
    (let loop ((j 0))
      (and (< j (length succ))
           (or (and (= (succ j) b) (not (= 0 (bitwise-and mask (bitwise-arithmetic-shift 1 j))))) (loop (+ j 1)))))))

(def- (eval-params! s b)
  (let ((x (s :ir)))
    (let ((params ((s :bparams) b)))
      (unless (null? params)
        (let ((entry? (= b (ir/fn-entry x (ir/block-fn x b))))
              (preds ((s :preds) b))
              (header? ((s :header) b)))
          (let loop ((ps params)
                     (i 0))
            (unless (null? ps)
              (let ((acc (if entry?
                             types/any
                             types/none)))
                (for-each (fn (p)
                            (when (edge-exec? s p b)
                              (set! acc
                                    (types/join acc
                                                (if (eq? ((s :bkind) p) :jump)
                                                    (fact-at s (list-ref ((s :btargs) p) i) p)
                                                    types/any)))))
                          preds)
                (update! s (car ps) acc header?))
              (loop (cdr ps) (+ i 1)))))))))

(def- (mark-edge! s b j)
  (let ((mask ((s :edges) b))
        (bit (bitwise-arithmetic-shift 1 j))
        (t (((s :bsuccs) b) j)))
    (when (= 0 (bitwise-and mask bit)) (put! (s :edges) b (bitwise-ior mask bit)))
    (if ((s :exec) t)
        (eval-params! s t)
        (begin
          (put! (s :exec) t #t)
          (push! (s :blocks) t)))))

(def- (may-fold? s b)
  "Whether b's branch may leave out an edge, spending fuel the first time."
  (or ((s :charged) b)
      (and (spend!)
           (begin
             (put! (s :charged) b #t)
             #t))))

(def- (choose! s b truth)
  ;; truth: #t or #f picks an edge, :none neither, nil both.
  (let ((succ ((s :bsuccs) b)))
    (cond
      ((nil? truth) (mark-edge! s b 0) (mark-edge! s b 1))
      ((eq? truth :none)
       (unless (may-fold? s b)
         (mark-edge! s b 0)
         (mark-edge! s b 1)))
      (else (let ((j (if truth
                         0
                         1)))
              (if (and (= 0 (ir/block-param-count (s :ir) (succ j))) (may-fold? s b))
                  (mark-edge! s b j)
                  (begin
                    (mark-edge! s b 0)
                    (mark-edge! s b 1))))))))

(def- (eval-term! s b)
  (let ((kind ((s :bkind) b)))
    (cond
      ((eq? kind :jump) (mark-edge! s b 0))
      ((eq? kind :branch)
       (let ((f (fact-at s (car ((s :btargs) b)) b)))
         (choose! s
                  b
                  (if (types/none? f)
                      :none (types/truthiness f)))))
      ((eq? kind :branch-prim)
       (let ((facts (map (fn (a) (fact-at s a b)) ((s :btargs) b)))
             (prim (ir/term-prim (s :ir) b)))
         (let ((entry (prims/lookup prim)))
           (cond
             ((not (all? (fn (f) (not (types/none? f))) facts)) (choose! s b :none))
             (else (let ((r (cond
                              (entry (prim-fact entry facts))
                              ((ir/ir-code? prim) (ir-code-fact prim nil facts))
                              (else types/any))))
                     (choose! s
                              b
                              (if (types/none? r)
                                  nil
                                  (types/truthiness r)))))))))
      ((eq? kind :call) (mark-edge! s b 0))
      ((eq? kind :try) (mark-edge! s b 0) (mark-edge! s b 1))
      (else nil))))

(def- (eval-op! s o)
  (let ((b (ir/op-block (s :ir) o))) (update! s (ir/op-value (s :ir) o) (op-fact s o b) #f)))

(def- (reeval-uses! s v)
  (let ((x (s :ir))
        (f (s :current)))
    (for-each (fn (u)
                (if (eq? (u 0) :op)
                    (let ((b (ir/op-block x (u 1))))
                      (when (and ((s :exec) b) (= (ir/block-fn x b) f)) (eval-op! s (u 1))))
                    (let ((b (u 1))) (when (and ((s :exec) b) (= (ir/block-fn x b) f)) (eval-term! s b)))))
              ((s :uses) v))))

(def- (value-changed! s v)
  (reeval-uses! s v)
  (unless (null? ((s :touch) v))
    ;; Values compared with v have refined facts that read v's, and values
    ;; compared with those read them one level deep (see
    ;; refinement-fact): re-evaluate their uses too, two hops out.
    (record-set! s :stamp-n (+ 1 (s :stamp-n)))
    (let ((n (s :stamp-n)))
      (put! (s :stamp) v n)
      (for-each (fn (w)
                  (unless (= ((s :stamp) w) n)
                    (put! (s :stamp) w n)
                    (reeval-uses! s w))
                  (for-each (fn (u)
                              (unless (= ((s :stamp) u) n)
                                (put! (s :stamp) u n)
                                (reeval-uses! s u)))
                            ((s :touch) w)))
                ((s :touch) v)))))

(def- (setup-function! s f)
  (let ((x (s :ir))
        (order (ir/rpo (s :ir) f))
        (index {}))
    (let loop ((bs order)
               (i 0))
      (unless (null? bs)
        (put! index (car bs) i)
        (loop (cdr bs) (+ i 1))))
    (let ((doms (ir/dominators x f)))
      (for-each (fn (b)
                  ;; Loop headers: targets of retreating edges.
                  (let ((succ ((s :bsuccs) b)))
                    (dotimes (j (length succ))
                      (let ((t (succ j)))
                        (when (and (contains? index t) (<= (index t) (index b))) (put! (s :header) t #t)))))
                  ;; Refinements.
                  (let ((preds ((s :preds) b)))
                    ;; The entry is also reached by the call itself.
                    (when (and (pair? preds) (null? (cdr preds)) (not (= b (ir/fn-entry x f))))
                      (let ((p (car preds))
                            (kind ((s :bkind) (car preds))))
                        (when (and (or (eq? kind :branch) (eq? kind :branch-prim))
                                   (not (= (((s :bsuccs) p) 0) (((s :bsuccs) p) 1))))
                          (let ((r [p
                                    b
                                    (if (= (((s :bsuccs) p) 0) b)
                                        0
                                        1)
                                    doms
                                    f])
                                (args ((s :btargs) p)))
                            (if (eq? kind :branch)
                                (put! (s :refs) (car args) (cons r ((s :refs) (car args))))
                                (let ((entry (prims/lookup (ir/term-prim x p))))
                                  (when (and entry (or (entry :refines) (comparison? entry)))
                                    (let loop ((as args)
                                               (seen '()))
                                      (unless (null? as)
                                        (unless (memq (car as) seen)
                                          (when (or (comparison? entry) (null? seen))
                                            (put! (s :refs) (car as) (cons r ((s :refs) (car as))))))
                                        (loop (cdr as) (cons (car as) seen))))
                                    (when (and (comparison? entry)
                                               (= (length args) 2)
                                               (not (eq? (car args) (cadr args))))
                                      ;; Each side's refinement reads the other's fact.
                                      (let ((a (car args))
                                            (c (cadr args)))
                                        (put! (s :touch) a (cons c ((s :touch) a)))
                                        (put! (s :touch) c (cons a ((s :touch) c))))))))))))))
                order)
      (put! (s :fdoms) f doms))))

(def- (analyze! s f)
  (let ((x (s :ir)))
    (record-set! s :current f)
    (setup-function! s f)
    (let ((entry (ir/fn-entry x f))
          (blocks (s :blocks))
          (queue (s :queue)))
      (put! (s :exec) entry #t)
      (push! blocks entry)
      (while (or (> (length blocks) 0) (> (length queue) 0))
        (if (> (length blocks) 0)
            (let ((b (pop! blocks)))
              (eval-params! s b)
              (for-each (fn (o) (eval-op! s o)) ((s :bops) b))
              (eval-term! s b))
            (let ((v (pop! queue)))
              (put! (s :queued) v #f)
              (value-changed! s v)))))))

;; --- decisions -------------------------------------------------------------------

(def- (canon-of s v)
  (or ((s :canon) v) v))

(def- pure-codes '(const prim-ref unbound self refine bound? closure box env-ref make-closure static-closure))

(def- cse-codes '(prim-ref unbound self refine bound? env-ref static-closure))

(def- blocking-effects '(:raise :write :call :switch))

(def- (removable-code? code)
  "Whether an unused operation with this code can be left out."
  (if (ir/ir-code? code)
      (not (not (memq code pure-codes)))
      (let ((entry (prims/lookup code))) (and entry (all? (fn (e) (not (memq e blocking-effects))) (entry :effects))))))

(def- (cse-code? code aux)
  (cond
    ((eq? code 'const) (prims/identity-free? aux))
    ((ir/ir-code? code) (not (not (memq code cse-codes))))
    (else (let ((entry (prims/lookup code))) (and entry (null? (entry :effects)))))))

(def- (corners op a b)
  (and (op (types/fact-lo a) (types/fact-lo b))
       (op (types/fact-lo a) (types/fact-hi b))
       (op (types/fact-hi a) (types/fact-lo b))
       (op (types/fact-hi a) (types/fact-hi b))))

(def- fixnum-variants
  ;; code -> [variant no-overflow-variant test]
  {'+ ['%fx+
       '%fx+/no-overflow
       (fn (a b)
         (and (types/checked+ (types/fact-lo a) (types/fact-lo b))
              (types/checked+ (types/fact-hi a) (types/fact-hi b))))]
   '- ['%fx-
       '%fx-/no-overflow
       (fn (a b)
         (and (types/checked- (types/fact-lo a) (types/fact-hi b))
              (types/checked- (types/fact-hi a) (types/fact-lo b))))]
   '* ['%fx* '%fx*/no-overflow (fn (a b) (corners types/checked* a b))]
   '< ['%fx< nil nil]
   '<= ['%fx<= nil nil]
   '> ['%fx> nil nil]
   '>= ['%fx>= nil nil]
   '= ['%fx= nil nil]})

(def- float-variants {'+ '%fl+ '- '%fl- '* '%fl* '/ '%fl/ '< '%fl< '<= '%fl<= '> '%fl> '>= '%fl>= '= '%fl=})

(def- (specialize code facts)
  "The variant of primop code these argument facts allow, or code."
  (let ((n (length facts)))
    (cond
      ((and (= n 1) (memq code '(car cdr)) (types/only? (car facts) types/t-pair))
       (if (eq? code 'car)
           '%car
           '%cdr))
      ((= n 2)
       (let ((a (car facts))
             (b (cadr facts)))
         (cond
           ((and (types/fixnum-only? a) (types/fixnum-only? b) (contains? fixnum-variants code))
            (let ((v (fixnum-variants code)))
              (if (and (v 2) ((v 2) a b))
                  (v 1)
                  (v 0))))
           ((and (types/only? a types/t-float) (types/only? b types/t-float) (contains? float-variants code))
            (float-variants code))
           (else code))))
      (else code))))

(def- (representable? f)
  (and (types/const? f) (prims/atom? (types/fact-const f))))

(def- (decide-op! s o b cse log)
  (let ((v (ir/op-value (s :ir) o))
        (code (ir/op-code (s :ir) o))
        (aux (ir/op-aux (s :ir) o))
        (args ((s :oargs) o)))
    (let ((f ((s :facts) v))
          (facts (map (fn (a) (fact-at s a b)) args))
          (prim? (not (ir/ir-code? code))))
      (let ((entry (and prim? (prims/lookup code))))
        (let ((new-code (if entry
                            (specialize code facts)
                            code)))
          (def (replace! w)
            (put! (s :canon) v (canon-of s w))
            (put! (s :kind) v :replaced))
          (def (emit-as! c a)
            (put! (s :kind) v :copy)
            (put! (s :code) v c)
            (put! (s :cval) v a)
            (put! (s :keep) v (not (removable-code? c))))
          (def (try-cse! c a)
            ;; c and a are what v will be emitted as.
            (if (cse-code? c a)
                (let ((key (cons c (cons a (map (fn (w) (canon-of s w)) args)))))
                  (let ((hit (get cse key)))
                    (cond
                      ((and hit (spend!)) (replace! hit) #t)
                      (hit #f)
                      (else (put! cse key v) (push! log key) #f))))
                #f))
          (cond
            ;; A constant in place of a computation. One that may raise
            ;; stays, and a constant after it takes its uses.
            ((and (not (eq? code 'const)) (representable? f) (spend!))
             (let ((c (types/fact-const f)))
               (if (or (removable-code? new-code) (and entry (fold-prim entry facts) (not (side-effects? entry))))
                   (begin
                     (emit-as! 'const c)
                     (put! (s :kind) v :const)
                     (try-cse! 'const c))
                   (begin
                     (emit-as! new-code aux)
                     (put! (s :after) v #t)))))
            ;; Proven checks.
            ((and (eq? code 'check-bound) (types/never? (car facts) types/t-other) (spend!)) (replace! (car args)))
            ((and (eq? code 'refine) (types/only? (car facts) aux) (spend!)) (replace! (car args)))
            ;; Specialization.
            ((and (not (eq? new-code code)) (spend!)) (emit-as! new-code aux) (try-cse! new-code aux))
            (else (emit-as! code aux) (try-cse! code aux))))))))

(def- (side-effects? entry)
  (not (all? (fn (e) (not (memq e '(:write :call :switch)))) (entry :effects))))

(def- (decide-params! s b)
  (for-each (fn (p) (when (and (representable? ((s :facts) p)) (spend!)) (put! (s :pconst) p #t)))
            (ir/block-params (s :ir) b)))

(def- (known-callee s b)
  "The function a :value call in b certainly calls, or nil."
  (let ((x (s :ir)))
    (let ((callee (canon-of s (ir/term-callee x b))))
      (let ((o ((s :vop) callee)))
        (when (and (not (= o no)) (not ((s :pconst) callee)) (not ((s :after) callee)))
          (let ((code (ir/op-code x o)))
            (let ((g (cond
                       ((or (eq? code 'closure) (eq? code 'make-closure)) (ir/op-aux x o))
                       ((eq? code 'self) (ir/value-fn x callee))
                       (else nil))))
              (when g
                (let ((sig (ir/fn-signature x g))
                      (n (length ((s :btargs) b))))
                  (and sig (>= n (sig 0)) (or (sig 2) (<= n (+ (sig 0) (sig 1)))) g))))))))))

(def- (decide-term! s b)
  (let ((x (s :ir))
        (kind ((s :bkind) b))
        (mask ((s :edges) b)))
    (cond
      ((or (eq? kind :branch) (eq? kind :branch-prim))
       (cond
         ((= mask 0) (put! (s :term) b :unreachable))
         ((= mask 1) (put! (s :term) b 0))
         ((= mask 2) (put! (s :term) b 1))
         ((eq? kind :branch-prim)
          (let ((prim (ir/term-prim x b)))
            (let ((new (specialize prim (map (fn (a) (fact-at s a b)) ((s :btargs) b)))))
              (put! (s :tprim)
                    b
                    (if (and (not (eq? new prim)) (spend!))
                        new
                        prim)))))))
      ((and (or (eq? kind :call) (eq? kind :tail-call)) (eq? (ir/term-call-kind x b) :value))
       (let ((g (known-callee s b))) (when (and g (spend!)) (put! (s :tknown) b g))))
      (else nil))))

(def- (decide-function! s f)
  (let ((x (s :ir))
        (doms ((s :fdoms) f))
        (cse {})
        (log [])
        (order []))
    (let ((stack [(ir/fn-entry x f)])
          (marks []))
      (while (> (length stack) 0)
        (let ((item (pop! stack)))
          (if (>= item 0)
              (begin
                (push! order item)
                (push! marks (length log))
                (push! stack (- -1 item))
                (decide-params! s item)
                (for-each (fn (o) (decide-op! s o item cse log)) (ir/block-ops x item))
                (decide-term! s item)
                (for-each (fn (c) (when ((s :exec) c) (push! stack c))) (reverse (ir/dominated-children x doms item))))
              (let ((m (pop! marks))) (while (> (length log) m) (put! cse (pop! log) nil)))))))
    (put! (s :order) f (array-to-list order))))

;; --- liveness --------------------------------------------------------------------

(def- (fixed-params? s b)
  "Whether b's parameters must stay: an entry, or a block some executable
edge other than a jump reaches."
  (let ((x (s :ir)))
    (or (= b (ir/fn-entry x (ir/block-fn x b)))
        (not (all? (fn (p) (or (not (edge-exec? s p b)) (eq? ((s :bkind) p) :jump))) ((s :preds) b))))))

(def- (use! s v)
  (unless ((s :used) v)
    (put! (s :used) v #t)
    (push! (s :work) v)))

(def- (keep-param! s p)
  (unless ((s :live) p)
    (put! (s :live) p #t)
    (let ((x (s :ir))
          (b (ir/value-block (s :ir) p)))
      (let ((i (index-of (ir/block-params x b) p)))
        (for-each (fn (q)
                    (when (and (edge-exec? s q b) (eq? ((s :bkind) q) :jump))
                      (use! s (canon-of s (list-ref ((s :btargs) q) i)))))
                  ((s :preds) b))))))

(def- (index-of xs x)
  (let loop ((xs xs)
             (i 0))
    (if (eq? (car xs) x)
        i
        (loop (cdr xs) (+ i 1)))))

(def- (live-op! s v)
  (unless ((s :live) v)
    (put! (s :live) v #t)
    (let ((o ((s :vop) v)))
      (unless (eq? ((s :kind) v) :const)
        (for-each (fn (a) (use! s (canon-of s a))) ((s :oargs) o))
        (when (memq ((s :code) v) '(closure make-closure)) (live-fn! s (ir/op-aux (s :ir) o)))))))

(def- (term-uses s b)
  (let ((x (s :ir))
        (kind ((s :bkind) b))
        (t ((s :term) b)))
    (cond
      ((eq? kind :jump) '()) ; through kept parameters
      ((or (eq? kind :branch) (eq? kind :branch-prim))
       (if (nil? t)
           ((s :btargs) b)
           '()))
      ((and (or (eq? kind :call) (eq? kind :tail-call)) (eq? (ir/term-call-kind x b) :value))
       (cons (ir/term-callee x b) ((s :btargs) b)))
      (else ((s :btargs) b)))))

(def- (live-fn! s f)
  (unless ((s :fn-live) f)
    (put! (s :fn-live) f #t)
    (let ((x (s :ir)))
      (for-each (fn (b)
                  (when (fixed-params? s b) (for-each (fn (p) (keep-param! s p)) (ir/block-params x b)))
                  (for-each (fn (o) (let ((v (ir/op-value x o))) (when ((s :keep) v) (live-op! s v))))
                            (ir/block-ops x b))
                  (for-each (fn (a) (use! s (canon-of s a))) (term-uses s b)))
                ((s :order) f)))))

(def- (drain-work! s)
  (let ((work (s :work)))
    (while (> (length work) 0)
      (let ((v (pop! work)))
        (cond
          ((not (= ((s :vop) v) no)) (unless (eq? ((s :kind) v) :replaced) (live-op! s v)))
          ((not ((s :pconst) v)) (keep-param! s v))
          (else nil))))))

(def- (mark! s)
  (for-each (fn (f) (when (nil? (ir/fn-parent (s :ir) f)) (live-fn! s f))) (ir/functions (s :ir)))
  (drain-work! s)
  ;; With limited fuel, each removal costs one; what fuel can't pay for stays.
  (unless (nil? fuel)
    (let ((x (s :ir)))
      (for-each (fn (f)
                  (when ((s :fn-live) f)
                    (for-each (fn (b)
                                (for-each (fn (p)
                                            (unless (or ((s :live) p) ((s :pconst) p) (spend!)) (keep-param! s p)))
                                          (ir/block-params x b))
                                (for-each (fn (o)
                                            (let ((v (ir/op-value x o)))
                                              (unless (or ((s :live) v) (eq? ((s :kind) v) :replaced) (spend!))
                                                (live-op! s v))))
                                          (ir/block-ops x b))
                                (drain-work! s))
                              ((s :order) f))))
                (ir/functions x)))))

;; --- emission --------------------------------------------------------------------

(def- (emit! s out)
  (let ((x (s :ir))
        (vmap (column/filled (ir/value-count (s :ir)) nil))
        (bmap (column/filled (ir/block-count (s :ir)) nil))
        (live-fns (filter (fn (f) ((s :fn-live) f)) (ir/functions (s :ir)))))
    (def (value-of v)
      (vmap (canon-of s v)))
    (def (new-value! v nv fact)
      (put! vmap v nv)
      (ir/set-value-fact! out nv fact)
      (when (ir/value-name x v) (ir/set-value-name! out nv (ir/value-name x v))))
    (def (kept-params b)
      (filter (fn (p) ((s :live) p)) (ir/block-params x b)))
    (for-each (fn (f) (ir/copy-function-shell! x out f)) live-fns)
    (for-each (fn (f)
                (let ((nf (ir/copied-function out f)))
                  (for-each (fn (b)
                              (when ((s :exec) b)
                                (let ((nb (ir/add-block! out nf)))
                                  (put! bmap b nb)
                                  (for-each (fn (p) (new-value! p (ir/add-param! out nb) ((s :facts) p)))
                                            (kept-params b)))))
                            (ir/fn-blocks x f))
                  (ir/set-entry! out nf (bmap (ir/fn-entry x f)))
                  (let ((sig (ir/fn-signature x f)))
                    (ir/set-signature! out nf (map vmap (ir/fn-params x f)) (sig 0) (sig 1) (sig 2)))
                  ;; Operations, in dominator preorder so operands are mapped.
                  (for-each (fn (b)
                              (let ((nb (bmap b)))
                                (for-each (fn (p)
                                            (when (and ((s :pconst) p) ((s :used) p))
                                              (let ((c (types/fact-const ((s :facts) p))))
                                                (new-value! p (ir/emit! out nb 'const '() c) (types/const-fact c)))))
                                          (ir/block-params x b))
                                (for-each (fn (o)
                                            (let ((v (ir/op-value x o)))
                                              (when ((s :live) v)
                                                (if (eq? ((s :kind) v) :const)
                                                    (new-value! v
                                                                (ir/emit! out
                                                                          nb
                                                                          'const
                                                                          '()
                                                                          ((s :cval) v)
                                                                          (ir/op-pos x o))
                                                                ((s :facts) v))
                                                    (let ((code ((s :code) v))
                                                          (aux ((s :cval) v)))
                                                      (let ((nv (ir/emit! out
                                                                          nb
                                                                          code
                                                                          (map value-of ((s :oargs) o))
                                                                          (if (and (ir/ir-code? code)
                                                                                   (eq? (ir/code-aux-kind code) :fn))
                                                                              (ir/copied-function out aux)
                                                                              aux)
                                                                          (ir/op-pos x o))))
                                                        (new-value! v nv ((s :facts) v))
                                                        (when (and ((s :after) v) ((s :used) v))
                                                          (let ((c (types/fact-const ((s :facts) v))))
                                                            (new-value! v
                                                                        (ir/emit! out nb 'const '() c)
                                                                        ((s :facts) v))))))))))
                                          (ir/block-ops x b))))
                            ((s :order) f))
                  ;; Terminators.
                  (for-each (fn (b) (emit-term! s out b (bmap b) value-of bmap)) ((s :order) f))))
              live-fns)
    out))

(def- (emit-term! s out b nb value-of bmap)
  (let ((x (s :ir))
        (kind ((s :bkind) b))
        (t ((s :term) b))
        (succ ((s :bsuccs) b))
        (args ((s :btargs) b)))
    (cond
      ((eq? kind :jump)
       (let ((target (succ 0)))
         (let ((params (ir/block-params x target)))
           (ir/jump! out
                     nb
                     (bmap target)
                     (let loop ((ps params)
                                (as args)
                                (out '()))
                       (cond
                         ((null? ps) (reverse out))
                         (((s :live) (car ps)) (loop (cdr ps) (cdr as) (cons (value-of (car as)) out)))
                         (else (loop (cdr ps) (cdr as) out))))))))
      ((eq? t :unreachable) (ir/unreachable! out nb))
      ((int? t) (ir/jump! out nb (bmap (succ t)) '()))
      ((eq? kind :branch) (ir/branch! out nb (value-of (car args)) (bmap (succ 0)) (bmap (succ 1))))
      ((eq? kind :branch-prim)
       (ir/branch-prim! out nb ((s :tprim) b) (map value-of args) (bmap (succ 0)) (bmap (succ 1))))
      ((or (eq? kind :call) (eq? kind :tail-call))
       (let ((ck (ir/term-call-kind x b))
             (callee (ir/term-callee x b))
             (known ((s :tknown) b))
             (new-args (map value-of args)))
         (let ((ck (if known
                       :known ck))
               (callee (cond
                         (known (ir/copied-function out known))
                         ((eq? ck :value) (value-of callee))
                         ((eq? ck :known) (ir/copied-function out callee))
                         (else callee))))
           (if (eq? kind :call)
               (ir/call! out nb ck callee new-args (bmap (succ 0)) (ir/term-pos x b))
               (ir/tail-call! out nb ck callee new-args (ir/term-pos x b))))))
      ((eq? kind :return) (ir/return! out nb (value-of (car args))))
      ((eq? kind :try) (ir/try! out nb (bmap (succ 0)) (bmap (succ 1))))
      (else (ir/unreachable! out nb)))))

;; --- entry point -----------------------------------------------------------------

(def (run x)
  "A new IR for x with facts propagated and the rewrites they allow made."
  (let ((s (new-state x)))
    (for-each (fn (f) (analyze! s f)) (ir/functions x))
    (for-each (fn (f) (decide-function! s f)) (ir/functions x))
    (mark! s)
    (emit! s (ir/new))))

(def (analyze x)
  "For tests and dumps: the fact of each value of x after the analysis, as an
array indexed by value, and the executable blocks, as an array of booleans."
  (let ((s (new-state x)))
    (for-each (fn (f) (analyze! s f)) (ir/functions x))
    [(s :facts) (s :exec)]))
