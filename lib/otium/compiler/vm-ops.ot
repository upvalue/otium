(ns otium.compiler.vm-ops)

;; The register VM's instruction forms, for the VM backend (docs/optimizer.md,
;; "VM backend"; the instructions are in docs/vm-design.md). One row per
;; form: the opcode keyword, as (%vm-opcodes) names it, and its operands in
;; the order Emit passes them. Each operand is a field and a kind:
;;
;;   fields  :x (0..255), :a :b :c (16 bits each), :bc (32 bits, b = low
;;           16 bits and c = high 16 bits)
;;   kinds   :dst     a register the instruction writes (never 0)
;;           :reg     a register it reads
;;           :update  a register it reads and writes (BOX)
;;           :window  the base of a call window
;;           :count   an argument count
;;           :flag    0 or 1 (a fused branch jumps when its test equals it)
;;           :imm16   a signed 16-bit integer (ADDI, BR_*I)
;;           :bits    a 32-bit immediate, as %immediate-bits gives it
;;           :const   a constant index
;;           :cell    a global cell id
;;           :capture a capture index of the running closure
;;           :fn      a unit function index
;;           :target  a word index
;;
;; A row with :branch #t is a fused branch: Emit follows it with a JUMP word
;; holding its target.

(def imm16-min -32768)

(def imm16-max 32767)

(def (imm16? n)
  (and (int? n) (>= n imm16-min) (<= n imm16-max)))

(def- rows {})

(def- (row! name operands &optional (branch #f))
  (put! rows name {:name name :operands operands :branch branch}))

(def (row name)
  "The row for an opcode keyword."
  (or (get rows name) (error (str "vm-ops: no instruction " name))))

(def (branch? name)
  (row name)
  (get (row name) :branch))

(row! :move '((:a :dst) (:b :reg)))
(row! :imm '((:a :dst) (:bc :bits)))
(row! :const '((:a :dst) (:bc :const)))
(row! :global '((:a :dst) (:bc :cell)))
(row! :set-global '((:a :reg) (:bc :cell)))
(row! :define-global '((:a :reg) (:bc :cell)))
(row! :upvalue '((:a :dst) (:b :capture)))
(row! :box '((:a :update)))
(row! :unbox '((:a :dst) (:b :reg)))
(row! :set-box '((:a :reg) (:b :reg)))
(row! :check '((:a :reg)))
(row! :closure '((:a :dst) (:bc :fn)))
(row! :jump '((:bc :target)))
(row! :jfalse '((:a :reg) (:bc :target)))
(row! :jtrue '((:a :reg) (:bc :target)))
(row! :jbound '((:a :reg) (:bc :target)))
(row! :call '((:a :window) (:b :count)))
(row! :tail-call '((:a :window) (:b :count)))
(row! :call-global '((:x :count) (:a :window) (:bc :cell)))
(row! :tail-call-global '((:x :count) (:a :window) (:bc :cell)))
(row! :return '((:a :reg)))
(row! :return-imm '((:bc :bits)))
(row! :try '((:a :dst) (:bc :target)))
(row! :end-try '())
(row! :raise '((:a :reg)))
(row! :cleanup '((:a :reg) (:x :flag)))
(row! :run-cleanup '())
(for-each (fn (name) (row! name '((:a :dst) (:b :reg) (:c :reg)))) '(:add :sub :mul :lt :le :gt :ge :numeq :eq :cons))
(row! :addi '((:a :dst) (:b :reg) (:c :imm16)))
(for-each (fn (name) (row! name '((:a :dst) (:b :reg)))) '(:car :cdr :not :nullp :pairp))
(for-each (fn (name) (row! name '((:x :flag) (:a :reg) (:b :reg)) #t)) '(:br-lt :br-le :br-gt :br-ge :br-numeq :br-eq))
(for-each (fn (name) (row! name '((:x :flag) (:a :reg) (:c :imm16)) #t)) '(:br-lti :br-lei :br-gti :br-gei :br-numeqi))
(for-each (fn (name) (row! name '((:x :flag) (:a :reg)) #t)) '(:br-null :br-pair))
(row! :br-eqk '((:x :flag) (:a :reg) (:bc :const)) #t)

(def immediate-branch
  "Register-register compare-and-branch forms with a form taking a signed 16-bit immediate second operand."
  {:br-lt :br-lti :br-le :br-lei :br-gt :br-gti :br-ge :br-gei :br-numeq :br-numeqi})

(def binary-ops '(:add :sub :mul :lt :le :gt :ge :numeq :eq :cons))

(def unary-ops '(:car :cdr :not :nullp :pairp))

(def unbound-bits
  "%immediate-bits of the unbound marker."
  18)

(def max-call-global-args 255)

(def (bits-of v)
  "IMM bits for v, or nil when it isn't an immediate."
  (%immediate-bits v))

;; Opcode numbers are read from the runtime on first use, so loading this
;; file doesn't call a C-only builtin.
(defonce opcode-table [nil])

(def (opcode name)
  (when (nil? (opcode-table 0)) (put! opcode-table 0 (%vm-opcodes)))
  (or (get (opcode-table 0) name) (error (str "vm-ops: the runtime has no opcode " name))))

(def- (field-range kind)
  (cond
    ((eq? kind :flag) [0 1])
    ((eq? kind :imm16) [imm16-min imm16-max])
    ((eq? kind :count) [0 65535])
    ((memq kind '(:bits :const :cell :fn :target)) [-2147483648 4294967295])
    ((eq? kind :dst) [1 65535])
    ((eq? kind :update) [1 65535])
    (else [0 65535])))

(def (encode! code name operands)
  "Append the five fixnums of instruction name with operands (a list, in the
row's order) to the array code. Returns the word's index."
  (let ((r (row name))
        (fields [0 0 0 0]) ; x a b c
        (index (quotient (length code) 5)))
    (unless (= (length operands) (length (r :operands)))
      (error (str "vm-ops: " name " takes " (length (r :operands)) " operands, got " operands)))
    (let loop ((specs (r :operands))
               (vs operands))
      (unless (null? specs)
        (let ((spec (car specs))
              (v (car vs)))
          (let ((field (car spec))
                (bounds (field-range (cadr spec))))
            (unless (and (int? v) (>= v (bounds 0)) (<= v (bounds 1)))
              (error (str "vm-ops: " name " operand " (cadr spec) " out of range: " v)))
            (cond
              ((eq? field :x) (put! fields 0 v))
              ((eq? field :a) (put! fields 1 v))
              ((eq? field :b) (put! fields 2 v))
              ((eq? field :c) (put! fields 3 v))
              (else (let ((u (if (< v 0)
                                 (+ v 4294967296)
                                 v)))
                      (put! fields 2 (remainder u 65536))
                      (put! fields 3 (quotient u 65536)))))))
        (loop (cdr specs) (cdr vs))))
    (push! code (opcode name))
    (dotimes (i 4)
      (push! code (fields i)))
    index))

(def (patch-bc! code index v)
  "Set the bc field of word index in code to v (a jump target)."
  (put! code (+ (* 5 index) 3) (remainder v 65536))
  (put! code (+ (* 5 index) 4) (quotient v 65536)))
