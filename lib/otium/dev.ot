;; lint: allow-file(unbound-name) c/src/dev.ot defines %poll and %evaluate when --dev starts the server
(require (otium.process :as process) (otium.thread :as thread))

(defonce pending '())

(defonce paused? #f)

(defonce action #f)

(defonce started 0)

(defonce watchdog 2000)

(defonce revision 0)

(defonce events '())

(defonce event-count 0)

(def event-limit 100)

(defonce launched (%clock))

(defonce reloaded {})

(def (default-path)
  "Choose a per-process socket in a private, per-user directory."
  ;; /tmp keeps paths short enough for macOS Unix sockets and is shared with clients.
  (let ((directory (str "/tmp/otium-" (%uid))))
    (unless (%private-directory! directory) (error "cannot use development socket directory" directory))
    (str directory "/" (%pid) ".sock")))

(def (listen! path timeout)
  "Launcher entry point: select a socket, open it, and set the watchdog."
  (let ((path (if (equal? path "")
                  (default-path)
                  path)))
    (unless (%open path) (error "cannot listen on socket" path))
    (set! watchdog timeout)))

(def (%repr value)
  (with-output-to-string (fn () (write value))))

(def (%namespaces)
  (map (fn (name) {:name name}) (%namespace-names)))

(def (%bindings space)
  (map (fn (binding)
         (let ((entry {:name (car binding) :kind (cadr binding) :public (caddr binding) :doc (car (cdddr binding))})
               (mask (cadr (cdddr binding))))
           (if mask
               (put entry :arity-mask mask)
               entry)))
       (%namespace-bindings space)))

(def (record-load! space path)
  "Record a loader notification; this table survives namespace reloads."
  (put! reloaded space {:file (%realpath path) :loaded (%now)}))

(def (enabled?)
  (%enabled?))

(def- (publish-event! event)
  (when (enabled?)
    (set! event-count (+ event-count 1))
    (put! event :seq event-count)
    (set! events (cons event (take (- event-limit 1) events)))
    (%send 0 (%repr event))))

(def (event! event)
  (if %threaded
      (thread/atomically (publish-event! event))
      (publish-event! event)))

(def- (reply! client value)
  (if (= client -1)
      (begin
        (display (get value :output ""))
        (if (get value :ok)
            (println (get value :value))
            (println "error:" (get value :condition))))
      (%send client (%repr (put value :event event-count)))))

(def- (clip text limit)
  (if (and (> limit 0) (> (string-length text) limit))
      (substring text 0 limit)
      text))

(def- (limit-response response limit)
  (let ((long? (fn (text) (and (> limit 0) (> (string-length text) limit))))
        (values (get response :values '())))
    (if (or (exists long? values) (long? (get response :value "")) (long? (get response :output "")))
        (put response
             :value (clip (get response :value "") limit)
             :output (clip (get response :output "") limit)
             :values (map (fn (v) (clip v limit)) values)
             :truncated #t)
        response)))

(def- (status)
  {:pid (%pid)
   :cwd (%cwd)
   :script (process/script-name)
   :arguments (process/arguments)
   :uptime-ms (- (%clock) launched)
   :state (if (paused-state?)
              :paused
              :running)
   :event event-count})

(def- (condition-data c)
  (if (table? c)
      {:type (get c :type 'error)
       :message (get c :message "error")
       :irritants (get c :irritants (get c :data '()))
       :source (get c :source #f)}
      {:type 'error :message (%repr c) :irritants '()}))

(def- (decode-data form)
  (cond
    ((and (pair? form) (eq? (car form) 'table)) (apply table (map decode-data (cdr form))))
    ((and (pair? form) (eq? (car form) 'array)) (apply array (map decode-data (cdr form))))
    ((pair? form) (cons (decode-data (car form)) (decode-data (cdr form))))
    (else form)))

(def- (receive!)
  (%poll 0)
  (let loop ((text (%next)))
    (when text
      (let ((client (%client)))
        (try
          (let ((request (decode-data (read-string text))))
            (unless (and (table? request) (get request :op) (not (eq? (get request :id '%missing) '%missing)))
              (error "expected a request table with :id and :op"))
            (set! pending (append pending (list (list client request)))))
          (catch c (reply! client {:id #f :ok #f :condition (condition-data c) :output ""}))))
      (loop (%next)))))

(def (begin!)
  (set-started! (%clock))
  (%deadline (if (= watchdog 0)
                 0
                 (+ (request-started) watchdog))))

(def (end!)
  (%deadline 0))

(def- (source-forms code)
  ;; Feed one byte at a time so the reader cannot read ahead past a form's line.
  (let ((bytes (string->utf8 code))
        (offset 0)
        (line 1)
        (forms []))
    (with ((port (make-input-port "source"
                                  {:read (fn (out start _end)
                                           (if (= offset (bytevector-length bytes))
                                               (eof-object)
                                               (let ((byte (get bytes offset)))
                                                 (put! out start byte)
                                                 (set! offset (+ offset 1))
                                                 (when (= byte 10) (set! line (+ line 1)))
                                                 1)))})))
          (let loop ()
            (skip-while " \t\r\n\x0b;\x0c;" port)
            (cond
              ((eof-object? (peek-char port)) forms)
              ((eq? (peek-char port) #\;) (read-line port) (loop))
              (else (let ((start line)
                          (form (read port)))
                      (push! forms {:form form :line start}))
                    (loop)))))))

(def- (file-namespace code)
  (let ((found #f))
    (for-each (fn (entry)
                (let ((form (entry :form)))
                  (when (and (not found) (pair? form) (eq? (car form) 'ns) (pair? (cdr form)) (symbol? (cadr form)))
                    (set! found (cadr form)))))
              (source-forms code))
    found))

(def- (note-reload! path code)
  (let ((space (file-namespace code))) (when space (record-load! space path))))

(def- (handle! client request)
  (let ((id (get request :id #f))
        (op (get request :op)))
    (try
      (cond
        ((or (eq? op :eval) (eq? op :load))
         (let ((old-start (request-started))
               (deadline (%deadline -1))
               (code (if (eq? op :load)
                         (read-file (get request :path))
                         (get request :code)))
               (space (get request :ns "user"))
               (limit (get request :max-chars 10000)))
           (begin!)
           (unwind-protect
             (let ((result (%evaluate code space (get request :path "<dev>"))))
               (set! revision (+ revision 1))
               (when (eq? op :load) (note-reload! (get request :path) code))
               (reply! client
                       (limit-response (if (get result :ok)
                                           {:id id
                                            :ok #t
                                            :value (get result :value)
                                            :values (get result :values)
                                            :output (get result :output)}
                                           {:id id
                                            :ok #f
                                            :condition (condition-data (get result :condition))
                                            :output (get result :output)})
                                       limit)))
             (set-started! old-start)
             (%deadline deadline))))
        ((eq? op :status) (reply! client {:id id :ok #t :value (status) :output ""}))
        ((eq? op :events)
         (let ((since (get request :since 0)))
           (reply! client {:id id :ok #t :value (reverse (filter (fn (e) (> (get e :seq) since)) events)) :output ""})))
        ((eq? op :interrupt)
         (if %threaded
             (interrupt-request! client request)
             (reply! client {:id id :ok #t :value "nil" :output ""})))
        ((or (eq? op :continue) (eq? op :abort))
         (if %threaded
             (resume-request! client request)
             (begin
               (unless paused? (error "program is not paused"))
               (set! action op)
               (reply! client {:id id :ok #t :value "nil" :output ""}))))
        (else (error "unknown dev operation" op)))
      (catch c (reply! client {:id id :ok #f :condition (condition-data c) :output ""})))))

(def- (serve-one!)
  (let ((entry (car pending)))
    (set! pending (cdr pending))
    (if (and %threaded (member (get (cadr entry) :op) '(:eval :load)))
        (start-evaluation! (car entry) (cadr entry))
        (handle! (car entry) (cadr entry)))))

(def- (legacy-service!)
  (when (and (enabled?) (not paused?))
    (receive!)
    (let loop ()
      (unless (null? pending)
        (serve-one!)
        (loop)))))

(def- (legacy-break! force? space)
  (receive!)
  (let ((previous-paused paused?)
        (previous-action action)
        (interrupt? (exists (fn (entry) (eq? (get (cadr entry) :op) :interrupt)) pending))
        (expired? (and (> (%deadline -1) 0) (>= (%clock) (%deadline -1)))))
    (if (or force? interrupt? expired?)
        (begin
          (set! paused? #t)
          (set! action #f)
          (end!)
          (event! {:event :paused
                   :reason (if (or force? interrupt?)
                               :interrupt
                               :watchdog)
                   :elapsed-ms (- (%clock) started)
                   :ns space})
          (let loop ()
            (unless action
              (if (null? pending)
                  (begin
                    (%poll 50)
                    (receive!))
                  (serve-one!))
              (loop)))
          (set! paused? previous-paused)
          (event! {:event :resumed})
          (begin!)
          (let ((abort? (eq? action :abort)))
            (set! action previous-action)
            abort?))
        #f)))

(def- (legacy-run)
  (let loop ()
    (%poll 50)
    (service!)
    (loop)))

(def (frame-error! c)
  (event! {:event :frame-error :condition (condition-data c)})
  (println c))

(def (stdio! code)
  (handle! -1 {:id 0 :op :eval :code code :ns "user"}))

(def- (namespace-entries)
  (map (fn (entry)
         (let ((again (get reloaded (get entry :name) #f)))
           (if (and again (> (get again :loaded) (get entry :loaded 0)))
               (put entry :file (get again :file) :loaded (get again :loaded))
               entry)))
       (%namespaces)))

(def- (by-name entries)
  (sort-by (fn (entry) (symbol->string (get entry :name))) entries))

(def (namespaces)
  "Return the loaded namespaces, sorted by name, each a table with :name and, when it was read from a file, :file."
  (by-name (map (fn (entry)
                  (if (get entry :file #f)
                      {:name (get entry :name) :file (get entry :file)}
                      {:name (get entry :name)}))
                (namespace-entries))))

(def- (binding-info entry)
  (let ((parameters (get entry :parameters #f))
        (mask (get entry :arity-mask #f))
        (result (dissoc entry :parameters :arity-mask)))
    (cond
      (parameters (let ((parameters (if (and (pair? parameters) (eq? (car parameters) 'array))
                                        (cdr parameters)
                                        parameters)))
                    (let loop ((rest parameters)
                               (required 0))
                      (if (and (pair? rest) (symbol? (car rest)) (not (eq? (car rest) '&)))
                          (loop (cdr rest) (+ required 1))
                          (put result :arity required :variadic (not (null? rest)))))))
      ((and mask (not (= mask 0)))
       (let loop ((bits mask)
                  (required 0))
         (if (= (bitwise-and bits 1) 0)
             (loop (bitwise-arithmetic-shift bits -1) (+ required 1))
             (put result :arity required :variadic (< mask 0)))))
      (else result))))

(def (bindings space)
  "Return the bindings defined in a namespace, sorted by name. Each is a table with :name, :kind (:function, :macro or :value), :public and :doc, plus :arity and :variadic for Otium functions."
  (by-name (map binding-info
                (%bindings (if (string? space)
                               (string->symbol space)
                               space)))))

(def (apropos text)
  "Return qualified names of bindings, in any loaded namespace, whose name contains text."
  (let ((found '()))
    (for-each (fn (entry)
                (for-each (fn (binding)
                            (when (string-contains? (symbol->string (get binding :name)) text)
                              (set! found
                                    (cons (string->symbol (str (get entry :name) "/" (get binding :name))) found))))
                          (%bindings (get entry :name))))
              (%namespaces))
    (sort-by symbol->string found)))

(def- (split-name name)
  (let ((text (symbol->string name))
        (slash (string-index text "/")))
    (unless slash (error "source: expected a qualified name such as app.view/render" name))
    (list (symbol (substring text 0 slash)) (substring text (+ slash 1)))))

(def- (defines? form name)
  (and (pair? form)
       (member (car form)
               '(def def-
                  defonce
                  defmacro
                  defclass
                  defrecord
                  defparam
                  defgeneric
                  defabstract
                  defmethod))
       (pair? (cdr form))
       (let ((target (cadr form)))
         (equal? name
                 (str (if (pair? target)
                          (car target)
                          target))))))

(def (source name)
  "Return {:file :line} for the first top-level definition of a qualified name, or nil. Lines count from 1."
  (let ((parts (split-name name))
        (entry (find (fn (e) (eq? (get e :name) (car parts))) (namespace-entries)))
        (file (and entry (get entry :file nil))))
    (if file
        (let ((found nil))
          (for-each (fn (node)
                      (when (and (not found) (defines? (node :form) (cadr parts)))
                        (set! found {:file file :line (node :line)})))
                    (source-forms (read-file file)))
          found)
        nil)))

(def (stale-files)
  "Return the files of loaded namespaces that have changed since they were loaded."
  (let ((stale '()))
    (for-each (fn (entry)
                (let ((file (get entry :file #f)))
                  (when file
                    (let ((mtime (%mtime file)))
                      (when (and mtime (> mtime (get entry :loaded 0)) (not (member file stale)))
                        (set! stale (cons file stale)))))))
              (namespace-entries))
    (sort stale)))

;; Native server: one transport thread, with an execution thread per eval.
(defonce %server nil)

(defonce %foreground nil)

(defonce %contexts {})

(defonce %evaluations '())

(def- (context-for target)
  (or (get %contexts target)
      (let ((state {:thread target :waiters (%make-waitq) :started (%clock)}))
        (put! %contexts target state)
        state)))

(def- (current-context)
  (context-for (thread/self)))

(def- (request-started)
  (if %threaded
      (get (current-context) :started 0)
      started))

(def- (set-started! value)
  (if %threaded
      (put! (current-context) :started value)
      (set! started value)))

(def- (paused-state?)
  (if %threaded
      (let ((found #f))
        (for ((_target state :in %contexts))
          (when (get state :paused) (set! found #t)))
        found)
      paused?))

(def (%deadline value)
  (cond
    (%threaded (%thread-watchdog value
                                 (fn ()
                                   (when (pause-thread! (current-context) :watchdog nil)
                                     (error "evaluation aborted")))))
    ((= value -1) %deadline-at)
    (else (set! %deadline-at value))))

(def- (select-context client request paused-only?)
  (let ((wanted (get request :eval))
        (found nil))
    (for ((state :in %evaluations))
      (when (and (not found)
                 (or (not wanted) (and (= client (get state :client)) (equal? wanted (get state :id))))
                 (or (not paused-only?) (get state :paused)))
        (set! found state)))
    (or found
        (and (not wanted)
             %foreground
             (let ((state (context-for %foreground))) (and (or (not paused-only?) (get state :paused)) state))))))

;; The frame lock. A native UI loop draws holding it and passes it on between
;; frames, so evaluations land between frames as service! once made them,
;; yet can still park. Only evaluations started while a frame loop runs take
;; it, and a request with :concurrent #t doesn't. It is reentrant, so a UI
;; loop can run inside an evaluation, and a paused thread lends it out.
(defonce %frame nil)

(def- (frame)
  (or %frame
      (begin
        (set! %frame {:owner nil :depth 0 :loops 0 :waiters (%make-waitq)})
        %frame)))

(def- (frame-acquire! depth)
  (let ((f (frame))
        (me (thread/self)))
    (thread/atomically (let loop ()
                         (cond
                           ((nil? (f :owner)) (put! f :owner me :depth depth))
                           ((eq? (f :owner) me) (put! f :depth (+ (f :depth) depth)))
                           (else (%park (f :waiters) nil) (loop)))))))

(def- (frame-release!)
  "Release one level of this thread's hold on the frame lock."
  (let ((f (frame)))
    (thread/atomically (when (eq? (f :owner) (thread/self))
                         (put! f :depth (- (f :depth) 1))
                         (when (= (f :depth) 0)
                           (put! f :owner nil)
                           (%wake-one (f :waiters)))))))

(def- (frame-lend!)
  "Release this thread's whole hold on the frame lock, returning its depth."
  (let ((f (frame)))
    (thread/atomically (if (eq? (f :owner) (thread/self))
                           (let ((depth (f :depth)))
                             (put! f :owner nil :depth 0)
                             (%wake-one (f :waiters))
                             depth)
                           0))))

(def- (frame-reclaim! depth)
  (when (> depth 0) (frame-acquire! depth)))

(def (frame-loop! running?)
  "A UI loop calls this with #t as it starts and #f as it stops."
  (when %threaded
    (let ((f (frame)))
      (thread/atomically (put! f
                               :loops (+ (f :loops)
                                         (if running?
                                             1
                                             -1)))))))

(def (enter-frame!)
  "A UI loop calls this before drawing; dev evaluations wait until leave-frame!."
  (when %threaded (frame-acquire! 1)))

(def (leave-frame!)
  "A UI loop calls this after drawing, however drawing exits."
  (when %threaded (frame-release!)))

(def (between-frames!)
  "A UI loop calls this between frames: waiting dev evaluations run here."
  (if %threaded
      (let ((held (frame-lend!)))
        ;; Run whatever release woke; it holds the lock until it finishes.
        (thread/yield)
        (frame-reclaim! held))
      (legacy-service!)))

(def- (pause-thread! state reason acknowledged)
  (put! state :paused #t :action #f)
  (end!)
  (event! {:event :paused
           :reason reason
           :eval (get state :id)
           :elapsed-ms (- (%clock) (get state :started 0))
           :ns (str (current-ns))})
  (when acknowledged (acknowledged))
  (defer
    (let ((held (frame-lend!)))
      ;; Requests still run while paused.
      (thread/atomically (let loop ()
                           (unless (get state :action)
                             (%park (get state :waiters) nil)
                             (loop))))
      (frame-reclaim! held)
      (eq? (get state :action) :abort))
    (put! state :paused #f)
    (event! {:event :resumed :eval (get state :id)})
    (begin!)))

(def- (interrupt-request! client request)
  (let ((state (select-context client request #f))
        (ack (fn () (reply! client {:id (get request :id) :ok #t :value "nil" :output ""}))))
    (unless state (error "no matching evaluation"))
    (if (get state :paused)
        (ack)
        (thread/interrupt! (get state :thread)
                           (fn () (when (pause-thread! state :interrupt ack) (error "evaluation aborted")))))))

(def- (resume-request! client request)
  (let ((state (select-context client request #t)))
    (unless state (error "program is not paused"))
    ;; Reply first: it may print, which must not happen inside the atomic section.
    (reply! client {:id (get request :id) :ok #t :value "nil" :output ""})
    (thread/atomically (put! state :action (get request :op)) (%wake-one (get state :waiters)))))

(def- (finish-evaluation!)
  (end!)
  (thread/atomically (let ((self (thread/self)))
                       (set! %evaluations (filter (fn (state) (not (eq? (get state :thread) self))) %evaluations))
                       (put! %contexts self nil))))

(def- (framed-handle! client request)
  (if (and (> ((frame) :loops) 0) (not (get request :concurrent)))
      (begin
        (frame-acquire! 1)
        (defer
          (handle! client request)
          (frame-release!)))
      (handle! client request)))

(def- (start-evaluation! client request)
  (thread/atomically (let ((worker (thread/spawn-named :dev-eval (fn ()
                                                                   (defer
                                                                     (framed-handle! client request)
                                                                     (finish-evaluation!)))))
                           (state (context-for worker)))
                       (put! state :id (get request :id) :client client)
                       (set! %evaluations (cons state %evaluations)))))

(def (service!)
  (unless %threaded (legacy-service!)))

(def (break! force? space)
  (if %threaded
      (and force? (pause-thread! (current-context) :interrupt nil))
      (legacy-break! force? space)))

(def- (server-loop)
  (let loop ()
    (when %active
      (receive!)
      (let requests ()
        (unless (null? pending)
          (serve-one!)
          (requests)))
      (%wait-fds (%transport-fds) (%thread-deadline 0.05))
      (loop))))

(def (%start-thread!)
  (set! %foreground (thread/self))
  (context-for %foreground)
  (set! %server (thread/daemon! (thread/spawn-named :dev-server server-loop))))

(def (run)
  (if %threaded
      (thread/join %server)
      (legacy-run)))
