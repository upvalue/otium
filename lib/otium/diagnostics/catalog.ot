;; Generated from lib/catalog/diagnostics.json by tools/generate-diagnostics.py.
(ns otium.diagnostics.catalog)

(def entries
  "Diagnostic code strings mapped to tables of :title, :message, :explanation,
  :example and :fixed. Error codes have a :type; lint codes have a :name, :group and :level."
  {"E0001" {:title "unclosed form"
            :type :read-error
            :message "unclosed form"
            :explanation "The file ended inside a list, array, table or dotted pair. The location points at the opening delimiter that was never closed. Count delimiters from there, or run `otium fmt` on the file: its indentation usually shows where a closing delimiter went missing."
            :example "(def (area w h)\n  (* w h)"
            :fixed "(def (area w h)\n  (* w h))"}
   "E0002" {:title "unterminated string"
            :type :read-error
            :message "unterminated string"
            :explanation "A string literal has no closing double quote before the end of the file. Strings may span lines, so the missing quote can be far above the end of the file. Write `\\\"` for a double quote inside a string."
            :example "(println \"hello)"
            :fixed "(println \"hello\")"}
   "E0003" {:title "unexpected closing delimiter"
            :type :read-error
            :message "unexpected closing delimiter"
            :explanation "A `)`, `]` or `}` appeared with nothing open to close, or closes a different kind of bracket than the one that is open. Often an earlier form has one closing delimiter too many."
            :example "(def x 1))"
            :fixed "(def x 1)"}
   "E0004" {:title "invalid number"
            :type :read-error
            :message "invalid number"
            :explanation "A token starts like a number but is not one. Otium reads decimal integers, decimal floats with an optional exponent and `0x` hexadecimal integers. A token such as `12abc` is an error, not a symbol. Rational literals such as `1/2` are not supported; write `(/ 1 2)`."
            :example "(def ratio 1/2)"
            :fixed "(def ratio 0.5)"}
   "E0005" {:title "reserved # token"
            :type :read-error
            :message "reserved # token"
            :explanation "Supported # syntax includes booleans, character literals such as `#\\a`, and bytevectors such as `#u8(1 2)`. Other # syntax from Scheme or Clojure, such as `#(...)` vectors, `#{...}` sets and `#_` datum comments, is reserved. Use `[...]` for arrays."
            :example "(def v #(1 2 3))"
            :fixed "(def v [1 2 3])"}
   "E0006" {:title "invalid string escape"
            :type :read-error
            :message "invalid string escape"
            :explanation "Strings accept `\\n`, `\\r`, `\\t`, `\\0`, `\\e`, `\\\"`, `\\\\` and `\\xHEX;` escapes, where HEX names a Unicode scalar value and the semicolon ends it. Any other character after a backslash is an error."
            :example "(println \"tab:\\q\")"
            :fixed "(println \"tab:\\t\")"}
   "E0007" {:title "malformed dotted list"
            :type :read-error
            :message "malformed dotted list"
            :explanation "A `.` inside a list must have at least one value before it and exactly one value after it, followed by the closing delimiter."
            :example "'(1 . 2 3)"
            :fixed "'(1 2 . 3)"}
   "E0008" {:title "empty keyword"
            :type :read-error
            :message "empty keyword"
            :explanation "A keyword needs a name after its colon. A bare `:` is not valid."
            :example "{: 1}"
            :fixed "{:a 1}"}
   "E0009" {:title "quote without a value"
            :type :read-error
            :message "quote without a value"
            :explanation "A `'`, backquote, `,` or `,@` must be followed by the form it applies to."
            :example "(list 1 ')"
            :fixed "(list 1 '())"}
   "E0010" {:title "expected value"
            :type :read-error
            :message "expected value"
            :explanation "The reader expected a value here and found none."
            :example ""
            :fixed ""}
   "E0011" {:title "invalid character literal"
            :type :read-error
            :message "invalid character literal"
            :explanation "A character literal needs a character, a supported name such as space or newline, or a hexadecimal Unicode scalar. Surrogates and values above U+10FFFF are invalid."
            :example "#\\unknown"
            :fixed "#\\space"}
   "E0101" {:title "malformed special form"
            :type :syntax-error
            :message "{detail}"
            :explanation "A special form has the wrong number or arrangement of parts, or its argument list is not a proper list. Check the form against its documentation with `(describe 'name)`."
            :example "(if)"
            :fixed "(if ready? (start) (wait))"}
   "E0102" {:title "invalid binding list"
            :type :syntax-error
            :message "{detail}"
            :explanation "`let` takes a list of `(name value)` pairs: `(let ((x 1) (y 2)) body ...)`. Square brackets build arrays in Otium, so Clojure's `(let [x 1] ...)` is not a binding list. Plain `let` is sequential, so a later binding may use an earlier one."
            :example "(let [x 1 y 2] (+ x y))"
            :fixed "(let ((x 1) (y 2)) (+ x y))"}
   "E0103" {:title "invalid parameter list"
            :type :syntax-error
            :message "{detail}"
            :explanation "Parameters are named once. Required parameters precede &optional (name default) pairs. Defaults see preceding parameters. Rest parameters use (a . rest), (a & rest), or a single symbol; optional and rest parameters cannot be combined."
            :example "(fn [x y] (+ x y))"
            :fixed "(fn (x y) (+ x y))"}
   "E0104" {:title "cannot rebind a core form name"
            :type :syntax-error
            :message "{detail}"
            :explanation "Names of core forms such as `if`, `let`, `fn`, `def` and `quote` cannot be used as variable or parameter names. Choose another name."
            :example "(fn (if) if)"
            :fixed "(fn (condition) condition)"}
   "E0105" {:title "definition not allowed here"
            :type :syntax-error
            :message "{detail}"
            :explanation "`def` is allowed at top level and at the start of a body, such as a function or `let` body. `def-`, `defmacro`, `ns` and `require` are allowed only at top level."
            :example "(+ 1 (def x 2))"
            :fixed "(def x 2)\n(+ 1 x)"}
   "E0106" {:title "unquote outside quasiquote"
            :type :syntax-error
            :message "{detail}"
            :explanation "`,` and `,@` are only meaningful inside a backquoted template."
            :example "(list ,x)"
            :fixed "`(list ,x)"}
   "E0107" {:title "invalid cond clause"
            :type :syntax-error
            :message "{detail}"
            :explanation "Each `cond` clause is a list whose first element is the test: `(test body ...)`. An `else` clause needs a body."
            :example "(cond (x) else)"
            :fixed "(cond (x 1) (else 2))"}
   "E0108" {:title "invalid try form"
            :type :syntax-error
            :message "{detail}"
            :explanation "`try` takes body expressions followed by `(catch (predicate name) body ...)` or `(catch name body ...)` clauses. Catch clauses must come after every body expression."
            :example "(try (catch (error? e) nil) (work))"
            :fixed "(try (work) (catch (error? e) nil))"}
   "E0109" {:title "invalid assignment target"
            :type :syntax-error
            :message "{detail}"
            :explanation "`set!` assigns a variable, `(set! name value)`, or a callable place, `(set! (object key) value)`. A symbol macro can only be assigned when it has a writer."
            :example "(set! 3 4)"
            :fixed "(set! counter 4)"}
   "E0110" {:title "invalid ns clause"
            :type :syntax-error
            :message "{detail}"
            :explanation "`ns` accepts `(:require spec ...)` clauses after the namespace name. Requires can also be written as separate `(require ...)` forms."
            :example "(ns app.main (:use app.tools))"
            :fixed "(ns app.main (:require (app.tools :as tools)))"}
   "E0111" {:title "macro expansion limit exceeded"
            :type :syntax-error
            :message "macro expansion limit exceeded"
            :explanation "Expanding one top-level form ran too many macro calls. A macro probably expands into a call to itself without making progress."
            :example "(defmacro forever (x) `(forever ,x))\n(forever 1)"
            :fixed ""}
   "E0113" {:title "cannot bind a qualified name"
            :type :syntax-error
            :message "{detail}"
            :explanation "Local bindings and parameters take bare names; `ns/name` always refers to a namespace definition. Inside a ``#` `` template, symbols are qualified unless they end in `#`, so a name the expansion binds is written `name#`, which stands for a fresh symbol."
            :example "(defmacro twice (x) #`(let ((v ,x)) (+ v v)))"
            :fixed "(defmacro twice (x) #`(let ((v# ,x)) (+ v# v#)))"}
   "E0201" {:title "unbound name"
            :type :name-error
            :message "unbound name `{name}`"
            :explanation "No definition, parameter, local binding or import with this name is visible here. Check the spelling, `require` the namespace that defines it, or define it. Many Scheme and Clojure names differ in Otium: use `def` rather than `define` or `defn`, and `fn` rather than `lambda`. Check `(describe 'name)` and the prelude before assuming a familiar function exists."
            :example "(define (twice x) (* 2 x))"
            :fixed "(def (twice x) (* 2 x))"}
   "E0202" {:title "namespace not found"
            :type :namespace-error
            :message "namespace `{namespace}` not found"
            :explanation "`require` looks for `a/b.ot` for namespace `a.b` under each load path. Add the directory with `-L`, `OTIUM_PATH` or a `(paths ...)` entry in `project.ot`, or fix the namespace name."
            :example "(require app.missing :as missing)"
            :fixed ""}
   "E0203" {:title "name not defined by namespace"
            :type :namespace-error
            :message "namespace `{namespace}` does not define `{name}`"
            :explanation "A `:refer` list or a qualified name names something the namespace does not define."
            :example "(require otium.extra :refer (thread-first))"
            :fixed "(require otium.extra :refer (->))"}
   "E0204" {:title "private name"
            :type :namespace-error
            :message "`{name}` is private to `{namespace}`"
            :explanation "Names defined with `def-` are private to their namespace and cannot be imported with `:refer` by another namespace. Qualified references such as `space/name` can reach them, so macro expansions can use private helpers. Use a public definition, or refer to the name qualified."
            :example ""
            :fixed ""}
   "E0205" {:title "circular namespace load"
            :type :namespace-error
            :message "circular load of namespace `{namespace}`"
            :explanation "Namespace A requires B while B, directly or indirectly, requires A before A has finished loading. Move the shared definitions into a third namespace."
            :example ""
            :fixed ""}
   "E0206" {:title "namespace does not match file"
            :type :namespace-error
            :message "file declares namespace `{declared}` but was loaded as `{namespace}`"
            :explanation "The `ns` form of a file loaded by `require` must name the namespace it was found under: `app/tools.ot` must start with `(ns app.tools)`."
            :example ""
            :fixed ""}
   "E0207" {:title "definition conflicts with import"
            :type :namespace-error
            :message "{detail}"
            :explanation "A definition and an import in the same namespace may not share a name. Rename the definition, or drop the name from `:refer` and use an alias instead."
            :example "(require otium.extra :refer (comp))\n(def (comp f g) ...)"
            :fixed "(require otium.extra :as extra)\n(def (comp f g) ...)"}
   "E0208" {:title "alias names a namespace"
            :type :namespace-error
            :message "alias `{alias}` is the name of an existing namespace"
            :explanation "An alias spelled like another namespace's name would change what `that.namespace/name` means in this namespace, including in code that macros from that namespace produce. Pick an alias that is not a namespace name."
            :example "(require app.tools :as app.store)"
            :fixed "(require app.tools :as tools)"}
   "E0301" {:title "wrong number of arguments"
            :type :arity-error
            :message "wrong number of arguments to `{name}`"
            :explanation "A function was called with more or fewer arguments than its parameter list accepts. Optional parameters accept a bounded number of extra positional arguments; rest parameters accept any number. Check the signature with (describe 'name)."
            :example "(def (f x) (+ x 1))\n(f 1 2)"
            :fixed "(f 1)"}
   "E0302" {:title "value is not callable"
            :type :type-error
            :message "{value} is not callable"
            :explanation "The head of a call evaluated to something that cannot be applied. Functions, tables, arrays, keywords and class instances are callable; numbers, strings, `nil` and lists are not. A common cause is extra parentheses around a value, such as `((get t :f))` when `(get t :f)` returns a number."
            :example "(def n 3)\n(n)"
            :fixed "n"}
   "E0401" {:title "wrong type of argument"
            :type :type-error
            :message "{detail}"
            :explanation "A built-in operation received a value of a type it does not accept. Remember that only `nil` and `#f` are false, that `nil` is not the empty list, and that `get` returns `nil` for a missing key."
            :example "(car nil)"
            :fixed "(if (pair? xs) (car xs) nil)"}
   "E0502" {:title "waiting for a thread while loading a module"
            :type :thread-error
            :message "cannot wait for another thread while loading a module"
            :explanation "A module's top-level forms run to completion before any other thread runs, so other threads never see a half-loaded module. Waiting there for something only another thread can do, such as a join, a lock or a message, could never finish. Start a thread from the module instead, or wait after the require returns. Sleeping is allowed: the whole process waits."
            :example "(ns app.boot (:require (otium.thread :as thread)))\n(thread/join (thread/spawn (fn () 1)))"
            :fixed "(ns app.boot (:require (otium.thread :as thread)))\n(defonce worker (thread/spawn (fn () 1)))"}
   "E0503" {:title "deadlock"
            :type :thread-error
            :message "deadlock: no thread can run and none is sleeping"
            :explanation "The main thread is waiting, every other thread is waiting too, and nothing is timed to wake any of them, so nothing ever will. Look for threads waiting on each other, a message nobody sends, or a lock nobody releases."
            :example "(require otium.thread :as thread)\n(let ((main (thread/self)))\n  (thread/join (thread/spawn (fn () (thread/join main)))))"
            :fixed "(require otium.thread :as thread)\n(thread/join (thread/spawn (fn () 1)))"}
   "E0504" {:title "thread failed"
            :type :thread-failed
            :message "the joined thread failed"
            :explanation "thread/join waits for a thread and returns its result. When the thread ended with an uncaught error, the join raises this condition instead, with the original under `:reason`. The thread's own report went to stderr when it failed."
            :example "(require otium.thread :as thread)\n(thread/join (thread/spawn (fn () (car 1))))"
            :fixed "(require otium.thread :as thread)\n(try (thread/join (thread/spawn (fn () (car 1))))\n  (catch (thread/failed? e) (get e :reason)))"}
   "E0505" {:title "timed out"
            :type :timeout
            :message "timed out"
            :explanation "An operation given a timeout, such as thread/join or actor/call, waited that long without finishing. A `use-value` restart returns a value in its place."
            :example "(require otium.thread :as thread)\n(thread/join (thread/spawn (fn () (thread/sleep 10))) 0.1)"
            :fixed "(require otium.thread :as thread)\n(thread/join (thread/spawn (fn () (thread/sleep 10))) 20)"}
   "E0506" {:title "waiting inside a call from C"
            :type :thread-error
            :message "cannot wait for another thread inside a call from C"
            :explanation "Some Otium code runs as a call from the runtime's C code: handler-bind handlers, interrupt thunks, macro expanders, slot initializers, callbacks from foreign code. C frames can't be set aside while another thread runs, so such code runs to the end without other threads running, and it can't wait for one: no join, lock, receive or condvar wait. Sleeping is allowed; the whole process waits. Do the waiting in ordinary code, for example after the handler has returned or in a restart."
            :example "(require otium.thread :as thread)\n(let ((t (thread/spawn (fn () (thread/sleep 1)))))\n  (handler-bind ((error? (fn (c) (thread/join t))))\n    (error \"failed\")))"
            :fixed "(require otium.thread :as thread)\n(let ((t (thread/spawn (fn () (thread/sleep 1)))))\n  (try (error \"failed\")\n    (catch e (thread/join t))))"}
   "L0001" {:title "if in the else branch of an if"
            :name "if-chain"
            :group :style
            :level :warn
            :message "`if` in the else branch of an `if`; use `cond`"
            :explanation "Nested ifs in the else position read as a ladder. `cond` lists each test and result at the same depth."
            :example "(if a 1 (if b 2 3))"
            :fixed "(cond (a 1) (b 2) (else 3))"}
   "L0002" {:title "nested function has no captures"
            :name "liftable-function"
            :group :style
            :level :warn
            :message "`{name}` does not capture enclosing bindings; consider a top-level `def-`"
            :explanation "A named helper that does not depend on enclosing local bindings can be a private top-level definition. This reduces nesting and makes its independence explicit. Keep it local with a suppression when that makes the code easier to read. This rule checks explicit named function definitions after macro expansion; it skips ambiguous source locations and reassigned helpers. It does not suggest lifting groups of mutually dependent helpers."
            :example "(def (calculate)\n  (def (plus a b) (+ a b))\n  (plus 2 2))"
            :fixed "(def- (plus a b) (+ a b))\n\n(def (calculate)\n  (plus 2 2))"}
   "L0101" {:title "Scheme or Clojure definition form"
            :name "foreign-definition"
            :group :foreign
            :level :warn
            :message "`{form}` is not an Otium form; use `{replacement}`"
            :explanation "Otium defines with `def`, makes functions with `fn` and has a sequential plain `let`. `define`, `defn`, `lambda`, `let*` and `letrec` from Scheme and Clojure are not defined."
            :example "(define (twice x) (* 2 x))"
            :fixed "(def (twice x) (* 2 x))"}
   "L0102" {:title "square brackets used as a binding list"
            :name "bracket-bindings"
            :group :foreign
            :level :deny
            :message "square brackets build an array; `{form}` takes {expected}"
            :explanation "In Otium `[a b]` builds an array. Binding and parameter lists are parenthesized: `(let ((x 1)) ...)`, `(fn (x) ...)`, `(def (f x) ...)`."
            :example "(let [x 1] x)"
            :fixed "(let ((x 1)) x)"}
   "L0201" {:title "name is not defined"
            :name "unbound-name"
            :group :correctness
            :level :deny
            :message "unbound name `{name}`"
            :explanation "After macro expansion, this name is not a local binding, a definition in this file, an import or a prelude name. At runtime it raises E0201."
            :example "(def (f x) (frobnicate x))"
            :fixed ""}
   "L0202" {:title "local binding is never used"
            :name "unused-binding"
            :group :suspicious
            :level :warn
            :message "`{name}` is bound but never used"
            :explanation "A `let` binding, parameter or `match` variable is never referenced. Remove it, or start its name with `_` to show it is intentionally unused."
            :example "(def (f x y) x)"
            :fixed "(def (f x _y) x)"}
   "L0203" {:title "a named for loop's name is called outside tail position"
            :name "non-tail-loop-call"
            :group :suspicious
            :level :warn
            :message "`({name})` is not in tail position, so the rest of the loop runs as a nested call"
            :explanation "A named `for` goes round when its body calls the loop's name. That call must be the last thing the pass does. Anywhere else, such as inside an argument, in the middle of a `begin` or inside a nested `fn`, the rest of the loop runs as a nested call and its result comes back to this pass, which then carries on."
            :example "(for next ((x :in xs) (total :sum x))\n  => total\n  (+ 1 (next)))"
            :fixed "(for next ((x :in xs) (total :sum (+ x 1)))\n  => total\n  (next))"}
   "L0301" {:title "local name inside a #` template"
            :name "missed-unquote"
            :group :correctness
            :level :warn
            :message "`{name}` is a local binding, but this #` template refers to a definition named `{name}`"
            :explanation "A ``#` `` template qualifies its symbols with the namespace it is written in, so a local variable written without `,` becomes a reference to a top-level definition of the same name, which usually does not exist. Unquote the name to insert its value."
            :example "(defmacro add-one (x)\n  (let ((n x))\n    #`(+ n 1)))"
            :fixed "(defmacro add-one (x)\n  (let ((n x))\n    #`(+ ,n 1)))"}
   "L0302" {:title "template binds a literal name around inserted code"
            :name "captured-binding"
            :group :suspicious
            :level :warn
            :message "`{name}` is bound by this template around code it inserts, which can capture the caller's `{name}`"
            :explanation "A plain ` template that binds a literal name and splices caller code inside that binding captures any use of that name in the caller's code. Use a ``#` `` template with `name#`, which stands for a fresh symbol, or a `gensym`."
            :example "(defmacro twice (x)\n  `(let ((v ,x)) (+ v v)))"
            :fixed "(defmacro twice (x)\n  #`(let ((v# ,x)) (+ v# v#)))"}
   "L0303" {:title "template refers to a definition by its bare name"
            :name "template-namespace-ref"
            :group :suspicious
            :level :warn
            :message "`{name}` in this template resolves where the expansion is used, not in this file"
            :explanation "A plain ` template leaves its symbols bare, so an expansion used in another namespace looks the name up there, where it is usually unbound or means something else. A ``#` `` template qualifies the name with this namespace, including for private definitions."
            :example "(def- (helper x) (* x 2))\n(defmacro doubled (x) `(helper ,x))"
            :fixed "(def- (helper x) (* x 2))\n(defmacro doubled (x) #`(helper ,x))"}
   "L0304" {:title "template qualifies a name with its own namespace"
            :name "self-qualified-template"
            :group :style
            :level :warn
            :message "`{name}` names this file's namespace; write `{member}` in a #` template"
            :explanation "Writing `space/name` in a template so expansions reach this namespace from elsewhere is what ``#` `` does for every symbol. A ``#` `` template with the bare name is shorter, follows a rename of the namespace, and can reach private definitions."
            :example "(ns app.tools)\n(defmacro run (x) `(app.tools/start ,x))"
            :fixed "(ns app.tools)\n(defmacro run (x) #`(start ,x))"}
   "L0305" {:title "macro changes state while expanding"
            :name "expansion-side-effect"
            :group :suspicious
            :level :warn
            :message "this macro changes `{name}` each time it expands"
            :explanation "Expansion runs again whenever code is reloaded or evaluated, and how often a form is expanded is not part of the language. State a macro changes while expanding repeats or goes stale on reload. Generate code that performs the change when it runs, or keep the state in a `defonce` and suppress the finding with the reason."
            :example "(def count 0)\n(defmacro counted (x)\n  (set! count (+ count 1))\n  x)"
            :fixed "(def count 0)\n(defmacro counted (x)\n  #`(begin (set! count (+ count 1)) ,x))"}
   "L0900" {:title "lint could not expand a form"
            :name "expansion-failed"
            :group :correctness
            :level :warn
            :message "could not expand this form: {detail}"
            :explanation "Name checks run on macro-expanded code. The linter loads required namespaces and evaluates the file's own `defmacro` forms, but runs nothing else. A form that fails to expand, for example because a macro depends on a value computed in the same file, is skipped by the checks that need expansion."
            :example ""
            :fixed ""}
   "L0901" {:title "suppression comment suppressed nothing"
            :name "unused-suppression"
            :group :suspicious
            :level :warn
            :message "`{rule}` is allowed here but never reported"
            :explanation "A `lint: allow` directive names a rule that reported nothing in the code it covers. Remove the directive, or the rule name, so stale suppressions do not hide future problems."
            :example ";; lint: allow(if-chain) kept for symmetry\n(cond (a 1) (else 2))"
            :fixed "(cond (a 1) (else 2))"}
   "L0902" {:title "suppression comment without a reason"
            :name "unexplained-suppression"
            :group :suspicious
            :level :deny
            :message "suppression needs a reason after the rule list"
            :explanation "Every `lint: allow(rule ...)` and `lint: allow-file(rule ...)` directive must say why, after the closing parenthesis, so readers can judge whether it still applies."
            :example ";; lint: allow(if-chain)"
            :fixed ";; lint: allow(if-chain) mirrors the table in specs/io.md"}
   "L0903" {:title "suppression names an unknown rule"
            :name "unknown-rule"
            :group :correctness
            :level :deny
            :message "no lint rule named `{rule}`"
            :explanation "A `lint:` directive, or the `lint` entry of `project.ot`, names a rule that does not exist. Run `otium lint --rules` for the list."
            :example ";; lint: allow(if-chains) typo"
            :fixed ";; lint: allow(if-chain) mirrors the spec table"}
   "L0401" {:title "rest parameters allocate argument lists"
            :name "rest-arguments"
            :group :performance
            :level :warn
            :message "rest parameters build a list of extra arguments; use &optional for defaults"
            :explanation "Runtime rest parameters collect extra arguments into a list. In frequently called functions this creates avoidable allocation. Use &optional (name default) for a bounded set of positional arguments. Keep genuinely variadic APIs with a documented lint suppression. This rule checks fn, def and def- in dotted, & and single-symbol forms; macro parameter lists are exempt."
            :example "(def (paint node . colors) (draw node (if (null? colors) :white (car colors))))"
            :fixed "(def (paint node &optional (color :white)) (draw node color))"}})
