(def null (%null))

(def- (%fail-at op reason message argument expected)
  (handler-bind ((error? (fn (condition)
                           (put! condition :argument argument)
                           (put! condition :expected-type expected))))
    (%fail op reason message)))

(def- (%count op n &optional (argument #f))
  (unless (and (integer? n) (exact? n)) (%fail-at op "type" "expected exact integer" argument 'size-t))
  (when (< n 0) (%fail-at op "range" "expected nonnegative integer" argument 'size-t))
  n)

;; The largest integer bounds every size.
(def- SIZE_LIMIT 4611686018427387903)

(def- (%mul op a b &optional (argument #f))
  (if (and (> b 0) (> a (quotient SIZE_LIMIT b)))
      (%fail-at op "range" "size overflow" argument 'size-t)
      (* a b)))

(def- (%add op a b)
  (if (> a (- SIZE_LIMIT b))
      (%fail op "range" "size overflow")
      (+ a b)))

(def- (%round n a)
  (%add "layout" n (modulo (- a (modulo n a)) a)))

(def- (%signature-error op)
  (if (or (equal? op "bind") (equal? op "callback"))
      "signature"
      "type"))

(def- %scalars
  '(void bool
         i8
         u8
         i16
         u16
         i32
         u32
         i64
         u64
         short
         ushort
         int
         uint
         long
         ulong
         size-t
         ptrdiff-t
         float
         double
         pointer
         callback-pointer
         utf8))

(def- (%scalar-id name)
  (find-index (fn (s) (eq? s name)) %scalars))

;; Type codes shared with the runtime: scalars by position in %scalars, then
;; layout kinds. They match native/ffi/native.h.
(def- KIND_VOID (%scalar-id 'void))

(def- KIND_UTF8 (%scalar-id 'utf8))

(def- KIND_STRUCT (length %scalars))

(def- KIND_UNION (+ KIND_STRUCT 1))

(def- KIND_ARRAY (+ KIND_STRUCT 2))

;; Scalar descriptions by name, built on first use so that requiring this
;; module doesn't load the native helper.
(def- %scalar-descriptions nil)

(def- (%scalar-description t)
  (unless %scalar-descriptions
    (let ((descriptions {}))
      (for-each (fn (name)
                  (let ((k (%scalar-id name)))
                    (put! descriptions
                          name
                          (list k
                                (if (= k KIND_VOID)
                                    0
                                    (%sizeof k))
                                (if (= k KIND_VOID)
                                    1
                                    (%alignof k))
                                '()))))
                %scalars)
      (set! %scalar-descriptions descriptions)))
  (get %scalar-descriptions t))

(def- (%describe t op &optional (argument #f))
  (cond
    ((symbol? t) (or (%scalar-description t) (%fail-at op (%signature-error op) "unknown scalar type" argument #f)))
    ((%layout-data t) (%layout-data t))
    ((and (list? t) (= (length t) 3) (eq? (car t) 'array))
     (let ((element (%memory (cadr t) op argument))
           (count (%count op (caddr t) argument)))
       (list KIND_ARRAY (%mul op (cadr element) count) (caddr element) (list element count))))
    (else (%fail-at op (%signature-error op) "invalid foreign type" argument #f))))

(def- (%memory t op &optional (argument #f))
  (let ((d (%describe t op argument)))
    (if (or (= (car d) KIND_VOID) (= (car d) KIND_UTF8))
        (%fail-at op "type" "not a memory type" argument #f)
        d)))

(def (sizeof t)
  (cadr (%memory t "sizeof" 0)))

(def (alignof t)
  (caddr (%memory t "alignof" 0)))

(def (alloc t count)
  (let ((d (%memory t "alloc" 0))) (%alloc (%mul "alloc" (cadr d) (%count "alloc" count 1) 1) (caddr d))))

(def- (%scalar-memory t op)
  (let ((d (%memory t op 1)))
    (if (>= (car d) KIND_STRUCT)
        (%fail-at op "type" "use fields or views for aggregate memory" 1 #f)
        d)))

(def (ref p t index)
  (let ((d (%scalar-memory t "ref"))) (%ref p (car d) (%mul "ref" (cadr d) (%count "ref" index 2) 2))))

(def (set! p t index value)
  (let ((d (%scalar-memory t "set!"))) (%set! p (car d) (%mul "set!" (cadr d) (%count "set!" index 2) 2) value)))

(def- (%fields entries kind fields size alignment)
  (if (null? entries)
      (list kind (%round size alignment) alignment (reverse fields))
      (let ((f (car entries)))
        (unless (and (list? f) (= (length f) 2) (symbol? (car f))) (%fail "layout" "type" "expected (field-name type)"))
        (when (assq (car f) fields) (%fail "layout" "type" "duplicate field"))
        (let ((d (%memory (cadr f) "layout"))
              (offset (if (= kind KIND_UNION)
                          0
                          (%round size (caddr d)))))
          (%fields (cdr entries)
                   kind
                   (cons (list (car f) d offset) fields)
                   (max size (%add "layout" offset (cadr d)))
                   (max alignment (caddr d)))))))

(def- (%aggregate name fields kind)
  (if (not (and (symbol? name) (list? fields) (pair? fields)))
      (%fail "layout" "type" "expected name and nonempty field list")
      (%layout (%fields fields kind '() 0 1))))

(def (define-struct! name fields)
  (%aggregate name fields KIND_STRUCT))

(def (define-union! name fields)
  (%aggregate name fields KIND_UNION))

(def- (%path d path offset argument)
  (cond
    ((null? path) (list d offset))
    ((= (car d) KIND_ARRAY)
     (let ((index (%count "field" (car path) argument))
           (element (car (cadddr d)))
           (count (cadr (cadddr d))))
       (if (>= index count)
           (%fail-at "field" "bounds" "array field index out of bounds" argument #f)
           (%path element (cdr path) (%add "field" offset (%mul "field" index (cadr element))) argument))))
    ((or (= (car d) KIND_STRUCT) (= (car d) KIND_UNION))
     (let ((f (assq (car path) (cadddr d))))
       (if f
           (%path (cadr f) (cdr path) (%add "field" offset (caddr f)) argument)
           (%fail-at "field" "type" "unknown field" argument #f))))
    (else (%fail-at "field" "type" "field path descends into scalar" argument #f))))

(def- (%resolve t path &optional (type-argument 1) (path-argument 2))
  (if (list? path)
      (%path (%memory t "field" type-argument) path 0 path-argument)
      (%fail-at "field" "type" "expected field path list" path-argument #f)))

(defmacro %as-operation (operation . body)
  #`(handler-bind ((error? (fn (condition#) (put! condition# :operation ,operation)))) ,@body))

(def (offset-of t path)
  (%as-operation 'offset-of (cadr (%resolve t path 0 1))))

(def (field-view p t path)
  (%as-operation 'field-view (let ((f (%resolve t path))) (view p (cadr f) (cadr (car f))))))

(def (field-ref p t path)
  (%as-operation 'field-ref
                 (let ((f (%resolve t path)))
                   (if (>= (car (car f)) KIND_STRUCT)
                       (%fail-at "field-ref" "type" "field is aggregate" 2 #f)
                       (%ref p (car (car f)) (cadr f))))))

(def (field-set! p t path value)
  (%as-operation 'field-set!
                 (let ((f (%resolve t path)))
                   (if (>= (car (car f)) KIND_STRUCT)
                       (%fail-at "field-set!" "type" "field is aggregate" 2 #f)
                       (%set! p (car (car f)) (cadr f) value)))))

(def- (%call-type t result?)
  (let ((d (%describe t "bind")))
    (cond
      ((or (= (car d) KIND_ARRAY) (and (not result?) (= (car d) KIND_VOID)))
       (%fail "bind" "signature" "invalid call type"))
      ((< (car d) KIND_STRUCT) (car d))
      (else d))))

(def (bind library name arguments result collect-safe?)
  (unless (or (eq? collect-safe? #t) (eq? collect-safe? #f))
    (%fail-at "bind" "type" "expected collection safety boolean" 4 'bool))
  (if (list? arguments)
      (%bind library name (map (fn (t) (%call-type t #f)) arguments) (%call-type result #t) collect-safe?)
      (%fail-at "bind" "signature" "expected argument type list" 2 #f)))

(def- (%callback-type t result?)
  (let ((k (car (%describe t "callback"))))
    (if (or (>= k KIND_UTF8) (and (not result?) (= k KIND_VOID)))
        (%fail "callback" "signature" "callback types are scalars, pointer, or callback-pointer")
        k)))

(def (callback arguments result proc)
  (if (list? arguments)
      (%callback (map (fn (t) (%callback-type t #f)) arguments) (%callback-type result #t) proc)
      (%fail-at "callback" "signature" "expected argument type list" 0 #f)))

(def- (%try-open names diagnostics)
  (if (null? names)
      (%fail "open-library" "load" diagnostics)
      (let ((lib (%open (car names))))
        (if lib
            lib
            (%try-open (cdr names) (string-append diagnostics (car names) ": " (%loader-error) "\n"))))))

(def (open-library names)
  (if (and (list? names) (pair? names))
      (%try-open names "could not load library:\n")
      (%fail-at "open-library" "type" "expected nonempty list of library names" 0 #f)))

;; lint: allow(shadowed-core-name) the FFI API names it ffi/error?; in this file it means FFI errors
(def (error? c)
  (eq? (%error-field c "type") 'ffi-error))

(def- (%error-access c field)
  (if (error? c)
      (%error-field c field)
      (%fail-at "error-accessor" "type" "expected FFI condition" 0 #f)))

(def (error-reason c)
  (%error-access c "reason"))

(def (error-operation c)
  (%error-access c "operation"))

(def (error-library c)
  (%error-access c "library"))

(def (error-symbol c)
  (%error-access c "symbol"))

(def (error-argument c)
  (%error-access c "argument"))

(def (error-expected-type c)
  (%error-access c "expected-type"))

(def- (%binding-name declaration)
  (if (pair? (car declaration))
      (cadr (car declaration))
      (car declaration)))

(defmacro defbindings (library loader . declarations)
  "Declare (name symbol arguments result collect-safe?) bindings; use (private name) for private vars. loader opens a path or candidate list."
  (def (binding d)
    (unless (= (length d) 5)
      (%fail "bind" "signature" "expected name, symbol, arguments, result, and collection safety boolean"))
    #`(bind ,library ,(cadr d) ',(caddr d) ',(cadddr d) ,(list-ref d 4)))
  #`(begin
      (defonce ,library nil)
      ,@(map (fn (d)
               `(,(if (pair? (car d))
                      'def-
                      'def)
                 ,(%binding-name d)
                 (if ,library
                     ,(binding d)
                     nil)))
             declarations)
      (def (,loader source#)
        (set! ,library
              (open-library (if (string? source#)
                                (list source#)
                                source#)))
        ,@(map (fn (d) `(set! ,(%binding-name d) ,(binding d))) declarations))))

(defmethod (close (pointer CPointer) outcome)
  (free! pointer))
