(ns otium.sdl)
(require (otium.ffi :as ffi))

;; Opaque window handles and scalar signatures need no aggregate ABI manifest.
(def INIT_VIDEO 0x20)

(def WINDOW_RESIZABLE 0x20)

(def WINDOW_HIDDEN 0x8)

(def WINDOW_OCCLUDED 0x4)

(def WINDOW_MINIMIZED 0x40)

(def WINDOW_INPUT_FOCUS 0x200)

(def WINDOW_HIGH_PIXEL_DENSITY 0x2000)

(ffi/defbindings library
                 load!
                 (set-hint "SDL_SetHint" (utf8 utf8) bool #t)
                 (set-app-metadata "SDL_SetAppMetadata" (utf8 utf8 utf8) bool #t)
                 (load-surface "SDL_LoadSurface" (utf8) pointer #t)
                 (set-window-icon "SDL_SetWindowIcon" (pointer pointer) bool #t)
                 (destroy-surface "SDL_DestroySurface" (pointer) void #t)
                 (scale-surface "SDL_ScaleSurface" (pointer int int int) pointer #t)
                 (raise-window "SDL_RaiseWindow" (pointer) bool #t)
                 (init "SDL_Init" (u32) bool #t)
                 (quit "SDL_Quit" () void #t)
                 (was-init "SDL_WasInit" (u32) u32 #t)
                 (set-main-ready "SDL_SetMainReady" () void #t)
                 (create-window "SDL_CreateWindow" (utf8 int int u64) pointer #t)
                 (set-window-size "SDL_SetWindowSize" (pointer int int) bool #t)
                 (get-window-flags "SDL_GetWindowFlags" (pointer) u64 #t)
                 (wait-event-timeout "SDL_WaitEventTimeout" (pointer int) bool #t)
                 (get-window-size "SDL_GetWindowSize" (pointer pointer pointer) bool #t)
                 (get-window-size-in-pixels "SDL_GetWindowSizeInPixels" (pointer pointer pointer) bool #t)
                 (get-window-pixel-density "SDL_GetWindowPixelDensity" (pointer) float #t)
                 (destroy-window "SDL_DestroyWindow" (pointer) void #t)
                 (delay "SDL_Delay" (u32) void #t)
                 (pump-events "SDL_PumpEvents" () void #t)
                 (get-error "SDL_GetError" () utf8 #t))

(def (check value)
  (unless value (error (get-error)))
  value)

(def (pointer value)
  (when (ffi/null? value) (error (get-error)))
  value)

(def (flag-set? flags flag)
  "Whether a single-bit SDL flag is present."
  (not (= 0 (bitwise-and flags flag))))
