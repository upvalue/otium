(ns otium.test)

(def checks 0)

(def (fail! label expected actual)
  (display "FAIL")
  (when label
    (display " ")
    (display label))
  (newline)
  (display "  expected: ")
  (write expected)
  (newline)
  (display "  actual:   ")
  (write actual)
  (newline)
  (exit 1))

(def- missing-actual (gensym "missing-actual"))

(def (check expected actual &optional (labeled-actual missing-actual))
  "(check expected actual) or (check label expected actual): exit 1 unless the values are equal?."
  (let ((label nil))
    (unless (eq? labeled-actual missing-actual)
      (set! label expected)
      (set! expected actual)
      (set! actual labeled-actual))
    (if (equal? expected actual)
        (set! checks (+ checks 1))
        (fail! label expected actual))))

(def- (%fails? thunk)
  (try
    (begin
      (thunk)
      #f)
    (catch _ #t)))

(defmacro fails? (subject)
  "(fails? thunk) or (fails? 'form): whether calling the thunk, or evaluating the form in the caller's namespace, raises a condition."
  #`(%fails? (let ((value# ,subject))
               (if (procedure? value#)
                   value#
                   (fn () (,'eval value#))))))

(def (report name)
  "Print NAME: N checks passed."
  (println (string-append name ": " (number->string checks) " checks passed")))
