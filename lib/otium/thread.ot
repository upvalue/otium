;; lint: allow-file(unbound-name) the %swap family are C runtime primitives; lint runs on Chez
"Green threads in one OS thread, switched cooperatively.

Threads take turns at yield!, join!, receive! and at the end of their body.
Each thread has its own params, error handlers and cleanups; switching runs
no cleanups. A thread can't switch inside a native callback, such as a
handler called by signal. C runtime only for now."

(ns otium.thread)

;; Runnable threads, first in first out: run-front is taken from, and
;; run-back collects new arrivals in reverse.
(defonce run-front '())

(defonce run-back '())

(def- (new-thread name)
  {:name name :done #f :waiters '() :mailbox '() :mailbox-back '() :receiving #f})

(defonce current (new-thread :main))

;; The thread that ran before the most recent switch.
(defonce previous nil)

(def- (enqueue! thread)
  (set! run-back (cons thread run-back)))

(def- (runnable?)
  (not (and (null? run-front) (null? run-back))))

(def- (next-runnable)
  (when (null? run-front)
    (set! run-front (reverse run-back))
    (set! run-back '()))
  (if (null? run-front)
      nil
      (car run-front)))

;; A switch hands the new thread the continuation of the thread that left,
;; to be saved for when that one runs again.
(def- (settle! k)
  (when k (put! previous :k k)))

(def- (check-switch! next)
  (unless (%can-swap? (get next :k)) (error "otium.thread: cannot switch threads here, as inside a native callback")))

;; Run next, which is at the front of the queue. Checked first, so that a
;; failed switch leaves the scheduler as it was.
(def- (switch-to! next)
  (check-switch! next)
  (set! run-front (cdr run-front))
  (let ((k (get next :k)))
    (set! previous current)
    (set! current next)
    (put! next :k nil)
    (settle! (%swap k))))

;; Run the next thread. prepare! runs once the switch is known to work, and
;; arranges for this thread to run again.
(def- (wait! prepare!)
  (let ((next (next-runnable)))
    (unless next (error "otium.thread: deadlock, no thread can run"))
    (check-switch! next)
    (prepare!)
    (switch-to! next)))

(def- (finish! thread)
  (put! thread :done #t)
  (for-each enqueue! (get thread :waiters))
  (put! thread :waiters '())
  (let ((next (next-runnable)))
    (unless next (error "otium.thread: thread finished with no thread to run"))
    (set! run-front (cdr run-front))
    (let ((k (get next :k)))
      (set! previous thread)
      (set! current next)
      (put! next :k nil)
      (%switch k nil))))

(def (spawn thunk &optional (name nil))
  "(spawn thunk [name])\nStart a thread that calls thunk and becomes runnable. Returns the thread. The thread starts with the caller's params."
  (let ((thread (new-thread name)))
    (put! thread
          :k (%new-stack (fn (k)
                           (settle! k)
                           (try
                             (put! thread :result (thunk))
                             (catch ((fn (_) #t) problem) (put! thread :error problem)))
                           (finish! thread))))
    (enqueue! thread)
    thread))

(def (current-thread)
  "(current-thread)\nThe running thread."
  current)

(def (thread-name thread)
  "(thread-name thread)\nThe name given to spawn, or :main for the first thread."
  (get thread :name))

(def (thread-done? thread)
  "(thread-done? thread)\nTest whether thread's body has returned or raised."
  (get thread :done))

(def (yield!)
  "(yield!)\nLet the other runnable threads run before continuing."
  (when (runnable?) (wait! (fn () (enqueue! current)))))

(def (join! thread)
  "(join! thread)\nWait for thread to finish and return its result, or raise the condition that ended it."
  (unless (get thread :done) (wait! (fn () (put! thread :waiters (cons current (get thread :waiters))))))
  (let ((problem (get thread :error)))
    (if problem
        (error problem)
        (get thread :result))))

(def (send! thread message)
  "(send! thread message)\nAdd message to thread's mailbox, waking the thread if it is waiting in receive!."
  (put! thread :mailbox-back (cons message (get thread :mailbox-back)))
  (when (get thread :receiving)
    (put! thread :receiving #f)
    (enqueue! thread))
  nil)

(def (receive!)
  "(receive!)\nTake the oldest message from the running thread's mailbox, waiting until one arrives."
  (let ((me current))
    (when (and (null? (get me :mailbox)) (null? (get me :mailbox-back))) (wait! (fn () (put! me :receiving #t))))
    (when (null? (get me :mailbox))
      (put! me :mailbox (reverse (get me :mailbox-back)))
      (put! me :mailbox-back '()))
    (let ((message (car (get me :mailbox))))
      (put! me :mailbox (cdr (get me :mailbox)))
      message)))

(def (run-all!)
  "(run-all!)\nRun other threads until none is runnable."
  (let loop ()
    (when (runnable?)
      (yield!)
      (loop))))
