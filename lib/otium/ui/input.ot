(ns otium.ui.input)
(require (otium.ui :as ui))

(defclass PointerState
  (captured :init nil)
  (hovered :init '())
  (x :init nil)
  (y :init nil))

(def (pointer)
  (make PointerState))

(def- (contains? bounds x y)
  (and bounds
       (>= x (bounds :x))
       (>= y (bounds :y))
       (< x (+ (bounds :x) (bounds :width)))
       (< y (+ (bounds :y) (bounds :height)))))

(def- (hit-children children x y)
  ;; Last painted sibling wins. Each ancestor bounds the visible hit region.
  (let loop ((i (- (length children) 1)))
    (if (< i 0)
        '()
        (let ((node (get children i)))
          (if (and (ui/active? node) (contains? (node :bounds) x y))
              (append (hit-children (ui/children node) x y) (list node))
              (loop (- i 1)))))))

(def (hit-path tree x y)
  (hit-children (ui/children tree) x y))

(def- (bubble! path event)
  (cond
    ((null? path) nil)
    ((eq? (ui/send! (car path) event) :handled) (car path))
    (else (bubble! (cdr path) event))))

(def- (same-nodes? a b)
  (cond
    ((null? a) (null? b))
    ((null? b) #f)
    (else (and (eq? (car a) (car b)) (same-nodes? (cdr a) (cdr b))))))

(def (refresh-hover! pointer tree)
  "Mark the nodes under the last pointer position as hovered, deepest first.
Returns true when the hovered nodes changed."
  (let ((path (if (nil? (pointer :x))
                  '()
                  (hit-path tree (pointer :x) (pointer :y))))
        (changed? (not (same-nodes? path (pointer :hovered)))))
    (for-each (fn (node) (set! (node :hovered?) #f)) (pointer :hovered))
    (for-each (fn (node) (set! (node :hovered?) #t)) path)
    (set! (pointer :hovered) path)
    changed?))

(def (cancel! pointer)
  (let ((node (pointer :captured)))
    (set! (pointer :captured) nil)
    (when node (set! (node :pressed?) #f))
    (when (and node (ui/active? node)) (ui/send! node {:kind :pointer-cancel}))))

(def (dispatch! pointer tree event)
  "Route logical-coordinate pointer events through the current laid-out tree."
  (let ((kind (get event :kind)))
    (case kind
      ((:pointer-cancel) (cancel! pointer))
      ((:wheel) (bubble! (hit-path tree (get event :x) (get event :y)) event))
      ((:pointer-leave) (set! (pointer :x) nil) (set! (pointer :y) nil) (refresh-hover! pointer tree))
      ((:pointer-move :pointer-drag)
       (set! (pointer :x) (get event :x))
       (set! (pointer :y) (get event :y))
       (refresh-hover! pointer tree)
       (let ((node (pointer :captured)))
         (when (and node (ui/enabled? node) (node :pressed?)) (ui/send! node (put event :kind :pointer-drag)))))
      ((:pointer-down)
       (cancel! pointer)
       (ui/cancel-key! tree)
       (set! (pointer :captured) (bubble! (hit-path tree (get event :x) (get event :y)) event))
       (let ((node (pointer :captured)))
         (when node
           (set! (node :pressed?) #t)
           (when (ui/focusable? node) (ui/focus! tree node)))))
      ((:pointer-up)
       (let ((node (pointer :captured))
             (armed? (and node (node :pressed?))))
         (set! (pointer :captured) nil)
         (when node (set! (node :pressed?) #f))
         (when (and node (ui/active? node))
           (ui/send! node event)
           (when (and armed? (ui/enabled? node) (memq node (hit-path tree (get event :x) (get event :y))))
             (ui/send! node {:kind :press :x (get event :x) :y (get event :y)})))))
      (else nil))))

;; A :modal node takes the keyboard while it is mounted. The last one in
;; paint order wins. Focus outside it is ignored, not cleared, so it comes
;; back when the modal goes.
(def (modal tree)
  "The mounted :modal node that takes keys, or nil."
  (let ((found nil))
    (def (visit node)
      (when (get (node :options) :modal #f) (set! found node))
      (for-each visit (ui/children node)))
    (for-each visit (ui/children tree))
    found))

(def- (within? node ancestor)
  (and (ui/mounted? node) (or (eq? node ancestor) (within? (node :parent) ancestor))))

(def- (key-focus tree modal)
  (let ((node (ui/focused tree)))
    (if (and node modal (not (within? node modal)))
        nil
        node)))

(def (focus-next! tree backwards?)
  (let ((nodes [])
        (top (modal tree))
        (current (key-focus tree top))
        (index -1))
    (def (visit node)
      (when (ui/focusable? node)
        (when (eq? node current) (set! index (length nodes)))
        (push! nodes node))
      (for-each visit (ui/children node)))
    (if top
        (visit top)
        (for-each visit (ui/children tree)))
    (if (= (length nodes) 0)
        (ui/focus! tree nil)
        (ui/focus! tree
                   (get nodes
                        (modulo (if (< index 0)
                                    (if backwards?
                                        (- (length nodes) 1)
                                        0)
                                    (+ index
                                       (if backwards?
                                           -1
                                           1)))
                                (length nodes)))))))

(def- (node-path node stop)
  (if (ui/mounted? node)
      (cons node
            (if (eq? node stop)
                '()
                (node-path (node :parent) stop)))
      '()))

(def- (action! path event)
  (if (null? path)
      nil
      (let ((node (car path))
            (action (get (get (node :options) :keymap {}) (get event :key)))
            (handler (get (node :options) :on-action)))
        (if (and (ui/enabled? node) action handler (eq? (handler action) :handled))
            :handled (action! (cdr path) event)))))

(def (keyboard! tree event)
  "Route normalized key strings; actions run on keydown, button activation on keyup."
  (let ((top (modal tree))
        (node (key-focus tree top))
        (focus (tree :focus))
        (kind (get event :kind))
        (key (get event :key)))
    (cond
      ((eq? kind :focus-lost) (ui/focus! tree nil) (ui/cancel-key! tree) (set! (focus :drop-text?) #f))
      ;; SDL sends the text for a key after its keydown. A key that ran an
      ;; action is a shortcut, so its text is dropped.
      ((eq? kind :text-input)
       (if (focus :drop-text?)
           (set! (focus :drop-text?) #f)
           (when (and node (ui/accepts-text? (ui/instance node))) (ui/send! node event))))
      ((eq? kind :key-up)
       (when (equal? (get event :code key) (focus :key))
         (let ((armed (focus :armed)))
           (ui/cancel-key! tree)
           (when (and armed (eq? armed node) (ui/focusable? armed)) (ui/send! armed {:kind :press})))))
      ((and (eq? kind :key-down) (or (not (get event :repeat #f)) (and node (ui/repeat-key? (ui/instance node) event))))
       (set! (focus :drop-text?) #f)
       (cond
         ((and (or (equal? key "Tab") (equal? key "Shift+Tab"))
               (or (not node) (get (node :options) :tab-navigation #t)))
          (unless (get event :repeat #f) (focus-next! tree (equal? key "Shift+Tab"))))
         ((and node (ui/activation-key? (ui/instance node) event))
          (unless (or (get event :repeat #f) (focus :armed))
            (set! (focus :armed) node)
            (set! (focus :key) (get event :code key))
            (set! (focus :event) event)
            (set! (node :pressed?) #t)))
         (else (let ((path (cond
                             (node (node-path node top))
                             (top (list top))
                             (else (array-to-list (ui/children tree))))))
                 (if (eq? (action! path event) :handled)
                     (begin
                       (set! (focus :drop-text?) #t)
                       :handled)
                     (bubble! path event))))))
      (else nil))))
