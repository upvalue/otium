;; Font faces

(def HINTING
  "SDL_ttf hinting modes by name."
  {:normal 0 :light 1 :mono 2 :none 3 :light-subpixel 4})

(def (font-face path index bold? italic? hinting fallbacks)
  "Register face index of a font file, synthesizing bold or italic and with a
hinting mode from HINTING or nil for the default. Missing glyphs come from the
earlier face IDs in fallbacks. Returns a face ID."
  (let ((ids (ffi/alloc 'i32 (max 1 (length fallbacks)))))
    (defer
      (begin
        (for-each (fn (i) (ffi/set! ids 'i32 i (list-ref fallbacks i))) (range (length fallbacks)))
        (let ((face (%font-face path
                                index
                                (bitwise-ior (if bold? 1 0) (if italic? 2 0))
                                (if hinting (HINTING hinting) -1)
                                ids
                                (length fallbacks))))
          (when (< face 0) (error (text-error)))
          face))
      (ffi/free! ids))))

(def (font-builtin face)
  "The font file behind built-in face 0 (:ui) or 1 (:mono)."
  (%font-builtin face))

(def (font-describe path index)
  "Family and style names of face index of a font file, and how many faces it has, or nil."
  (let ((family (ffi/alloc 'u8 256))
        (style (ffi/alloc 'u8 256)))
    (defer
      (let ((count (%font-describe path index family 256 style 256)))
        (when (>= count 0) {:family (ffi/read-utf8 family 256) :style (ffi/read-utf8 style 256) :faces count}))
      (ffi/free! family)
      (ffi/free! style))))

(def (font-metrics face size scale)
  "Physical-pixel :advance of M, :height, :ascent and :descent of a face."
  (let ((out (ffi/alloc 'float 4)))
    (defer
      (begin
        (unless (%font-metrics face size scale out) (error (text-error)))
        {:advance (ffi/ref out 'float 0)
         :height (ffi/ref out 'float 1)
         :ascent (ffi/ref out 'float 2)
         :descent (ffi/ref out 'float 3)})
      (ffi/free! out))))

;; Yoga's own setters, on the YGNodeRef that leads a layout node.
(def- YG_RELATIVE 1)

(def- YG_ABSOLUTE 2)

(def (node-overlay p overlay?)
  "Take the node out of its parent's flow and cover the parent, or put it back."
  (let ((yoga (ffi/ref p 'pointer 0)))
    (yg-position-type yoga (if overlay? YG_ABSOLUTE YG_RELATIVE))
    ;; Left, top, right and bottom. Zero offsets leave a relative node in place.
    (dotimes (edge 4)
      (yg-position yoga edge 0.0))))

(def (gpu-new window width height scale driver &optional (offscreen #f))
  "Create a direct renderer, or pass #t as the last argument for offscreen rendering and capture."
  (gpu-create window width height scale driver offscreen))

(def (config-ref settings key)
  (let loop ((entries settings))
    (cond
      ((null? entries) (error "Missing UI installation setting" key))
      ((eq? (car (car entries)) key) (car (cdr (car entries))))
      (else (loop (cdr entries))))))

(def (default-config-path)
  "ui-config.ot in OTIUM_BUILD, which ./otium sets."
  (let ((build (process/getenv "OTIUM_BUILD")))
    (unless build (error "OTIUM_BUILD is not set; run the program through ./otium"))
    (str build "/ui-config.ot")))

(def (load-config! &optional (path (default-config-path)))
  "Load installation paths as data, then open the native UI library. path defaults to default-config-path."
  (let ((settings (read-string (read-file path))))
    (load! (config-ref settings 'library))
    (set! icons-directory (config-ref settings 'icons))
    settings))

(def (poll-event renderer)
  "Return a copied event table, or nil when the queue is empty."
  (let ((name (poll-event-kind renderer)))
    (unless (equal? name "")
      (let ((kind (keyword name)))
        (case kind
          ((:quit :focus-lost :expose :pointer-leave) {:kind kind})
          ((:key-down :key-up)
           {:kind kind
            :key (event-key renderer)
            :code (event-code renderer)
            :repeat (not (= 0 (event-repeat renderer)))})
          ((:resize) {:kind kind :width (event-width renderer) :height (event-height renderer)})
          ((:text-input) {:kind kind :text (event-text renderer)})
          ((:pointer-down :pointer-up :pointer-move) {:kind kind :x (event-x renderer) :y (event-y renderer)})
          ((:wheel)
           {:kind kind :x (event-x renderer) :y (event-y renderer) :dx (event-dx renderer) :dy (event-dy renderer)})
          (else (error "Unknown native UI event" kind)))))))
