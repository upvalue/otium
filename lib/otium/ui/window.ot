(ns otium.ui.window)
(require otium.time :as time)
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.input :as input))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))
(require (otium.objc :as objc))
(require (otium.dev :as dev))

(defonce running? #f)

(def (configure-app! options)
  "Set process-wide application metadata before initializing SDL video."
  ;; Cocoa builds its menu during SDL video initialization.
  (sdl/set-hint "SDL_MAC_BACKGROUND_APP"
                (if (get options :background #f)
                    "1"
                    "0"))
  (sdl/check (sdl/set-app-metadata (get options :name "Otium")
                                   (get options :version "")
                                   (get options :id "org.otium.application")))
  ;; Run from an interpreter, macOS would otherwise name the app after it.
  (when (objc/available?)
    (objc/send-as 'void
                  (objc/send (objc/class "NSProcessInfo") "processInfo")
                  "setProcessName:"
                  (objc/nsstring (get options :name "Otium")))))

(def (present-window! window options)
  "Install a PNG/BMP icon and optionally request foreground focus."
  (let ((icon (get options :icon "")))
    (unless (equal? icon "")
      (let ((surface (sdl/pointer (sdl/load-surface icon))))
        (unwind-protect
          (sdl/check (sdl/set-window-icon window surface))
          (sdl/destroy-surface surface)))))
  (when (get options :foreground #t) (sdl/check (sdl/raise-window window)))
  #t)

(def (open options)
  (let ((first? (null? (ui/windows)))
        (width (get options :width 640))
        (height (get options :height 480))
        (headless (get options :headless #f))
        (scale (get options :scale 0))
        (window ffi/null)
        (renderer ffi/null)
        (success? #f))
    (when first?
      (let ((settings (native/load-config! (get options :config "build/ui-config.ot"))))
        (sdl/load! (native/config-ref settings 'sdl)))
      (sdl/set-main-ready)
      (configure-app! {:name (get options :app-name "Otium")
                       :version (get options :app-version "")
                       :id (get options :app-id "org.otium.application")
                       :background (or headless (get options :background #f))})
      (sdl/check (sdl/init sdl/INIT_VIDEO)))
    (unwind-protect
      (begin
        (set! window
              (sdl/pointer (sdl/create-window (get options :title "Otium")
                                              width
                                              height
                                              (+ sdl/WINDOW_HIGH_PIXEL_DENSITY
                                                 sdl/WINDOW_RESIZABLE
                                                 (if headless
                                                     sdl/WINDOW_HIDDEN
                                                     0)))))
        (set! renderer
              (sdl/pointer (native/gpu-new window
                                           width
                                           height
                                           (if (and headless (= scale 0))
                                               1
                                               scale)
                                           (get options :driver "")
                                           (or headless (get options :offscreen #f) (> scale 0)))))
        (present-window! window
                         {:icon (get options :icon "") :foreground (not (or headless (get options :background #f)))})
        (let ((handle {:window window
                       :renderer renderer
                       :tree (ui/root)
                       :pointer (input/pointer)
                       :view #f
                       :width width
                       :height height
                       :scale (native/gpu-scale renderer)
                       :requested-scale scale
                       :options options
                       :dirty? #t
                       :frame 0
                       :capture ""
                       :closed? #f
                       :cleanups []
                       :last-error #f}))
          (set! ui/open-windows (append ui/open-windows (list handle)))
          (set! success? #t)
          handle))
      (unless success?
        (unless (ffi/null? renderer) (native/gpu-free renderer))
        (unless (ffi/null? window) (sdl/destroy-window window))
        (when first? (sdl/quit))))))

(def (close! window)
  (try
    (unless (get window :closed?)
      (set! (window :closed?) #t)
      (set! ui/open-windows (filter (fn (other) (not (eq? other window))) (ui/windows)))
      (unwind-protect
        (when (get (get window :options) :before-close!) ((get (get window :options) :before-close!) window))
        (unwind-protect
          (ui/dispose! (get window :tree))
          (native/gpu-free (get window :renderer))
          (sdl/destroy-window (get window :window))
          (when (null? (ui/windows)) (sdl/quit)))
        (for-each (fn (cleanup) (cleanup)) (get window :cleanups))))
    (catch c (error {:type 'ui-teardown :message (str c) :cause c}))))

(def- (sync! window)
  (when (get window :view)
    (ui/reconcile! (get window :tree) ((get window :view)))
    (let ((focused (ui/focused (get window :tree))))
      (sdl/check (native/text-input (get window :renderer)
                                    (if focused
                                        (ui/accepts-text? (ui/instance focused))
                                        #f))))))

(def- (event! window event)
  (ui/invalidate! window)
  (let ((kind (get event :kind))
        (tree (get window :tree))
        (renderer (get window :renderer)))
    (case kind
      ((:quit)
       (let ((allow? (get (get window :options) :on-close-request)))
         (when (or (not allow?) (allow? window)) (close! window))))
      ((:resize)
       (set! (window :width) (get event :width))
       (set! (window :height) (get event :height))
       (set! (window :scale)
             (gpu/resize! tree
                          renderer
                          (get event :width)
                          (get event :height)
                          (if (and (get (get window :options) :headless) (= (get window :requested-scale) 0))
                              1
                              (get window :requested-scale)))))
      ((:focus-lost) (input/cancel! (get window :pointer)) (input/keyboard! tree event))
      ((:key-down :key-up :text-input)
       (input/keyboard! tree
                        (put (put event :clipboard-read (fn () (native/clipboard-get renderer)))
                             :clipboard-write (fn (text) (sdl/check (native/clipboard-set text))))))
      ((:pointer-down :pointer-up :pointer-move :pointer-leave :wheel)
       (input/dispatch! (get window :pointer) tree event)))))

(def (visible? window)
  (or (get (window :options) :headless)
      (let ((flags (sdl/get-window-flags (window :window))))
        (not (or (sdl/flag-set? flags sdl/WINDOW_HIDDEN)
                 (sdl/flag-set? flags sdl/WINDOW_MINIMIZED)
                 (sdl/flag-set? flags sdl/WINDOW_OCCLUDED))))))

(def (frame! window)
  (let ((tree (get window :tree))
        (renderer (get window :renderer))
        (options (get window :options)))
    (unless (get window :initialized?)
      (sync! window)
      (set! (window :initialized?) #t))
    (let poll ((event (native/poll-event renderer)))
      (when event
        (event! window event)
        (unless (get window :closed?)
          (sync! window)
          (poll (native/poll-event renderer)))))
    (unless (get window :closed?)
      (when (get options :step!) ((get options :step!) window))
      (let ((visible (visible? window)))
        (when (and visible (not (get window :was-visible?))) (ui/invalidate! window))
        (put! window :was-visible? visible)
        (let ((full? (or (and (not (equal? (window :capture) ""))
                              (or (not (window :last-error))
                                  (window :dirty?)
                                  (not (equal? (window :revision) dev/revision))))
                         (not (get options :render-on-demand?))
                         (and visible (or (window :dirty?) (not (equal? (window :revision) dev/revision)))))))
          ;; Animation frames skip the view. Size animations need Yoga; scroll
          ;; animations only move bounds.
          (when (or full? (and visible (or (gpu/resizing? tree) (gpu/animating? tree))))
            (let ((now (time/seconds))
                  (relayout? (or full? (gpu/resizing? tree))))
              (when full?
                (sync! window)
                (gpu/invalidate-paint! tree))
              (when (gpu/resizing? tree) (gpu/step-sizes! tree now))
              (when relayout? (gpu/layout! tree (get window :width) (get window :height) (get window :scale)))
              (when (gpu/animating? tree) (gpu/animate! tree now (get window :scale))))
            (when (and (input/refresh-hover! (get window :pointer) tree) (not full?)) (gpu/invalidate-paint! tree))
            (gpu/paint! tree
                        renderer
                        (get window :width)
                        (get window :height)
                        (get options :background-color 0x101827ff))
            (sdl/check (native/gpu-frame renderer (get window :capture)))
            (put! window :dirty? #f)
            (put! window :revision dev/revision)
            (set! (window :capture) "")
            (set! (window :frame) (+ 1 (get window :frame)))
            (set! (window :last-error) #f))))
      (when (get options :after-frame!) ((get options :after-frame!) window)))))

(def (wait-ms)
  "Poll interval for the loop; zero while a visible window animates, so frames
follow the swapchain's vsync rather than the poll interval."
  (reduce (fn (ms window)
            (min ms
                 (cond
                   ((and (visible? window) (or (gpu/animating? (window :tree)) (gpu/resizing? (window :tree)))) 0)
                   ((and (visible? window)
                         (sdl/flag-set? (sdl/get-window-flags (window :window)) sdl/WINDOW_INPUT_FOCUS))
                    (get (window :options) :poll-ms 16))
                   (else (get (window :options) :background-poll-ms 16)))))
          100
          (ui/windows)))

(def (run)
  (unless running?
    (set! running? #t)
    (unwind-protect
      (while (pair? (ui/windows))
        (dev/service!)
        (for-each (fn (window)
                    (unless (get window :closed?)
                      (dev/begin!)
                      (unwind-protect
                        (try
                          (frame! window)
                          (catch c
                            (when (or (get (get window :options) :fail-fast?) (eq? (condition-type c) 'ui-teardown))
                              (error c))
                            (put! window :dirty? #f)
                            (put! window :revision dev/revision)
                            (let ((key (list dev/revision (condition-type c) (condition-message c))))
                              (unless (equal? key (get window :last-error))
                                (set! (window :last-error) key)
                                (dev/frame-error! c)))))
                        (dev/end!))))
                  (ui/windows))
        (when (pair? (ui/windows)) (sdl/wait-event-timeout ffi/null (wait-ms))))
      (set! running? #f)
      (for-each close! (ui/windows)))))
