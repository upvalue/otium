;; Callback signatures for ffi/callback: (arguments result). String
;; views arrive as their data pointer and length.
(def callbacks
  {:buffer-map-callback '((u32 pointer size-t pointer pointer) void)
   :compilation-info-callback '((u32 pointer pointer pointer) void)
   :create-compute-pipeline-async-callback '((u32 pointer pointer size-t pointer pointer) void)
   :create-render-pipeline-async-callback '((u32 pointer pointer size-t pointer pointer) void)
   :device-lost-callback '((pointer u32 pointer size-t pointer pointer) void)
   :log-callback '((u32 pointer size-t pointer) void)
   :pop-error-scope-callback '((u32 u32 pointer size-t pointer pointer) void)
   :queue-work-done-callback '((u32 pointer size-t pointer pointer) void)
   :request-adapter-callback '((u32 pointer pointer size-t pointer pointer) void)
   :request-device-callback '((u32 pointer pointer size-t pointer pointer) void)
   :uncaptured-error-callback '((pointer u32 pointer size-t pointer pointer) void)})

