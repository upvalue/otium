(def- (bind-all!)
  (set! create-instance (ffi/bind library "wgpuCreateInstance" (list 'pointer) 'pointer #t))
  (set! get-instance-features (ffi/bind library "wgpuGetInstanceFeatures" (list 'pointer) 'void #f))
  (set! get-instance-limits (ffi/bind library "wgpuGetInstanceLimits" (list 'pointer) 'u32 #f))
  (set! has-instance-feature (ffi/bind library "wgpuHasInstanceFeature" (list 'u32) 'u32 #f))
  (set! get-proc-address (ffi/bind library "wgpuGetProcAddress" (list string-view) 'callback-pointer #f))
  (set! adapter-get-features (ffi/bind library "wgpuAdapterGetFeatures" (list 'pointer 'pointer) 'void #f))
  (set! adapter-get-info (ffi/bind library "wgpuAdapterGetInfo" (list 'pointer 'pointer) 'u32 #f))
  (set! adapter-get-limits (ffi/bind library "wgpuAdapterGetLimits" (list 'pointer 'pointer) 'u32 #f))
  (set! adapter-has-feature (ffi/bind library "wgpuAdapterHasFeature" (list 'pointer 'u32) 'u32 #f))
  (set! adapter-request-device
        (ffi/bind library "wgpuAdapterRequestDevice" (list 'pointer 'pointer request-device-callback-info) future #t))
  (set! adapter-add-ref (ffi/bind library "wgpuAdapterAddRef" (list 'pointer) 'void #f))
  (set! adapter-release (ffi/bind library "wgpuAdapterRelease" (list 'pointer) 'void #f))
  (set! adapter-info-free-members (ffi/bind library "wgpuAdapterInfoFreeMembers" (list adapter-info) 'void #t))
  (set! bind-group-set-label (ffi/bind library "wgpuBindGroupSetLabel" (list 'pointer string-view) 'void #f))
  (set! bind-group-add-ref (ffi/bind library "wgpuBindGroupAddRef" (list 'pointer) 'void #f))
  (set! bind-group-release (ffi/bind library "wgpuBindGroupRelease" (list 'pointer) 'void #f))
  (set! bind-group-layout-set-label
        (ffi/bind library "wgpuBindGroupLayoutSetLabel" (list 'pointer string-view) 'void #f))
  (set! bind-group-layout-add-ref (ffi/bind library "wgpuBindGroupLayoutAddRef" (list 'pointer) 'void #f))
  (set! bind-group-layout-release (ffi/bind library "wgpuBindGroupLayoutRelease" (list 'pointer) 'void #f))
  (set! buffer-destroy (ffi/bind library "wgpuBufferDestroy" (list 'pointer) 'void #t))
  (set! buffer-get-const-mapped-range
        (ffi/bind library "wgpuBufferGetConstMappedRange" (list 'pointer 'size-t 'size-t) 'pointer #f))
  (set! buffer-get-mapped-range
        (ffi/bind library "wgpuBufferGetMappedRange" (list 'pointer 'size-t 'size-t) 'pointer #f))
  (set! buffer-get-map-state (ffi/bind library "wgpuBufferGetMapState" (list 'pointer) 'u32 #f))
  (set! buffer-get-size (ffi/bind library "wgpuBufferGetSize" (list 'pointer) 'u64 #f))
  (set! buffer-get-usage (ffi/bind library "wgpuBufferGetUsage" (list 'pointer) 'u64 #f))
  (set! buffer-map-async
        (ffi/bind library "wgpuBufferMapAsync" (list 'pointer 'u64 'size-t 'size-t buffer-map-callback-info) future #t))
  (set! buffer-read-mapped-range
        (ffi/bind library "wgpuBufferReadMappedRange" (list 'pointer 'size-t 'pointer 'size-t) 'u32 #t))
  (set! buffer-set-label (ffi/bind library "wgpuBufferSetLabel" (list 'pointer string-view) 'void #f))
  (set! buffer-unmap (ffi/bind library "wgpuBufferUnmap" (list 'pointer) 'void #t))
  (set! buffer-write-mapped-range
        (ffi/bind library "wgpuBufferWriteMappedRange" (list 'pointer 'size-t 'pointer 'size-t) 'u32 #t))
  (set! buffer-add-ref (ffi/bind library "wgpuBufferAddRef" (list 'pointer) 'void #f))
  (set! buffer-release (ffi/bind library "wgpuBufferRelease" (list 'pointer) 'void #f))
  (set! command-buffer-set-label (ffi/bind library "wgpuCommandBufferSetLabel" (list 'pointer string-view) 'void #f))
  (set! command-buffer-add-ref (ffi/bind library "wgpuCommandBufferAddRef" (list 'pointer) 'void #f))
  (set! command-buffer-release (ffi/bind library "wgpuCommandBufferRelease" (list 'pointer) 'void #f))
  (set! command-encoder-begin-compute-pass
        (ffi/bind library "wgpuCommandEncoderBeginComputePass" (list 'pointer 'pointer) 'pointer #t))
  (set! command-encoder-begin-render-pass
        (ffi/bind library "wgpuCommandEncoderBeginRenderPass" (list 'pointer 'pointer) 'pointer #t))
  (set! command-encoder-clear-buffer
        (ffi/bind library "wgpuCommandEncoderClearBuffer" (list 'pointer 'pointer 'u64 'u64) 'void #t))
  (set! command-encoder-copy-buffer-to-buffer
        (ffi/bind library
                  "wgpuCommandEncoderCopyBufferToBuffer"
                  (list 'pointer 'pointer 'u64 'pointer 'u64 'u64)
                  'void
                  #t))
  (set! command-encoder-copy-buffer-to-texture
        (ffi/bind library "wgpuCommandEncoderCopyBufferToTexture" (list 'pointer 'pointer 'pointer 'pointer) 'void #t))
  (set! command-encoder-copy-texture-to-buffer
        (ffi/bind library "wgpuCommandEncoderCopyTextureToBuffer" (list 'pointer 'pointer 'pointer 'pointer) 'void #t))
  (set! command-encoder-copy-texture-to-texture
        (ffi/bind library "wgpuCommandEncoderCopyTextureToTexture" (list 'pointer 'pointer 'pointer 'pointer) 'void #t))
