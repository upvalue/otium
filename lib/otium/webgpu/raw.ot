;; How otium.webgpu converts Otium values for each struct field that is
;; not a plain number: (:string), (:bool), (:enum table), (:flags table),
;; (:struct name), (:pointer name) for one struct behind a pointer, or
;; (:array element count-field), element being a struct name or scalar type.
(def fields
  {:chained-struct {:next (list :pointer :chained-struct) :s-type (list :enum s-type)}
   :buffer-map-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :compilation-info-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :create-compute-pipeline-async-callback-info {:next-in-chain (list :pointer :chained-struct)
                                                 :mode (list :enum callback-mode)}
   :create-render-pipeline-async-callback-info {:next-in-chain (list :pointer :chained-struct)
                                                :mode (list :enum callback-mode)}
   :device-lost-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :pop-error-scope-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :queue-work-done-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :request-adapter-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :request-device-callback-info {:next-in-chain (list :pointer :chained-struct) :mode (list :enum callback-mode)}
   :uncaptured-error-callback-info {:next-in-chain (list :pointer :chained-struct)}
   :adapter-info {:next-in-chain (list :pointer :chained-struct)
                  :vendor (list :string)
                  :architecture (list :string)
                  :device (list :string)
                  :description (list :string)
                  :backend-type (list :enum backend-type)
                  :adapter-type (list :enum adapter-type)}
   :blend-component {:operation (list :enum blend-operation)
                     :src-factor (list :enum blend-factor)
                     :dst-factor (list :enum blend-factor)}
   :buffer-binding-layout {:next-in-chain (list :pointer :chained-struct)
                           :type (list :enum buffer-binding-type)
                           :has-dynamic-offset (list :bool)}
   :buffer-descriptor {:next-in-chain (list :pointer :chained-struct)
                       :label (list :string)
                       :usage (list :flags buffer-usage)
                       :mapped-at-creation (list :bool)}
   :command-buffer-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :command-encoder-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :compatibility-mode-limits {:chain (list :struct :chained-struct)}
   :compilation-message {:next-in-chain (list :pointer :chained-struct)
                         :message (list :string)
                         :type (list :enum compilation-message-type)}
   :constant-entry {:next-in-chain (list :pointer :chained-struct) :key (list :string)}
   :external-texture-binding-entry {:chain (list :struct :chained-struct)}
   :external-texture-binding-layout {:chain (list :struct :chained-struct)}
   :instance-limits {:next-in-chain (list :pointer :chained-struct)}
   :multisample-state {:next-in-chain (list :pointer :chained-struct) :alpha-to-coverage-enabled (list :bool)}
   :pass-timestamp-writes {:next-in-chain (list :pointer :chained-struct)}
   :pipeline-layout-descriptor {:next-in-chain (list :pointer :chained-struct)
                                :label (list :string)
                                :bind-group-layouts (list :array 'pointer :bind-group-layout-count)}
   :primitive-state {:next-in-chain (list :pointer :chained-struct)
                     :topology (list :enum primitive-topology)
                     :strip-index-format (list :enum index-format)
                     :front-face (list :enum front-face)
                     :cull-mode (list :enum cull-mode)
                     :unclipped-depth (list :bool)}
   :query-set-descriptor {:next-in-chain (list :pointer :chained-struct)
                          :label (list :string)
                          :type (list :enum query-type)}
   :queue-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :render-bundle-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :render-bundle-encoder-descriptor {:next-in-chain (list :pointer :chained-struct)
                                      :label (list :string)
                                      :color-formats (list :array 'u32 :color-format-count)
                                      :depth-stencil-format (list :enum texture-format)
                                      :depth-read-only (list :bool)
                                      :stencil-read-only (list :bool)}
   :render-pass-depth-stencil-attachment {:next-in-chain (list :pointer :chained-struct)
                                          :depth-load-op (list :enum load-op)
                                          :depth-store-op (list :enum store-op)
                                          :depth-read-only (list :bool)
                                          :stencil-load-op (list :enum load-op)
                                          :stencil-store-op (list :enum store-op)
                                          :stencil-read-only (list :bool)}
   :render-pass-max-draw-count {:chain (list :struct :chained-struct)}
   :request-adapter-webxr-options {:chain (list :struct :chained-struct) :xr-compatible (list :bool)}
   :sampler-binding-layout {:next-in-chain (list :pointer :chained-struct) :type (list :enum sampler-binding-type)}
   :sampler-descriptor {:next-in-chain (list :pointer :chained-struct)
                        :label (list :string)
                        :address-mode-u (list :enum address-mode)
                        :address-mode-v (list :enum address-mode)
                        :address-mode-w (list :enum address-mode)
                        :mag-filter (list :enum filter-mode)
                        :min-filter (list :enum filter-mode)
                        :mipmap-filter (list :enum mipmap-filter-mode)
                        :compare (list :enum compare-function)}
   :shader-source-spirv {:chain (list :struct :chained-struct)}
   :shader-source-wgsl {:chain (list :struct :chained-struct) :code (list :string)}
   :stencil-face-state {:compare (list :enum compare-function)
                        :fail-op (list :enum stencil-operation)
                        :depth-fail-op (list :enum stencil-operation)
                        :pass-op (list :enum stencil-operation)}
   :storage-texture-binding-layout {:next-in-chain (list :pointer :chained-struct)
                                    :access (list :enum storage-texture-access)
                                    :format (list :enum texture-format)
                                    :view-dimension (list :enum texture-view-dimension)}
   :supported-features {:features (list :array 'u32 :feature-count)}
   :supported-instance-features {:features (list :array 'u32 :feature-count)}
   :supported-wgsl-language-features {:features (list :array 'u32 :feature-count)}
   :surface-capabilities {:next-in-chain (list :pointer :chained-struct)
                          :usages (list :flags texture-usage)
                          :formats (list :array 'u32 :format-count)
                          :present-modes (list :array 'u32 :present-mode-count)
                          :alpha-modes (list :array 'u32 :alpha-mode-count)}
   :surface-color-management {:chain (list :struct :chained-struct)
                              :color-space (list :enum predefined-color-space)
                              :tone-mapping-mode (list :enum tone-mapping-mode)}
   :surface-configuration {:next-in-chain (list :pointer :chained-struct)
                           :format (list :enum texture-format)
                           :usage (list :flags texture-usage)
                           :view-formats (list :array 'u32 :view-format-count)
                           :alpha-mode (list :enum composite-alpha-mode)
                           :present-mode (list :enum present-mode)}
   :surface-source-android-native-window {:chain (list :struct :chained-struct)}
   :surface-source-metal-layer {:chain (list :struct :chained-struct)}
   :surface-source-wayland-surface {:chain (list :struct :chained-struct)}
   :surface-source-windows-hwnd {:chain (list :struct :chained-struct)}
   :surface-source-xcb-window {:chain (list :struct :chained-struct)}
   :surface-source-xlib-window {:chain (list :struct :chained-struct)}
   :surface-texture {:next-in-chain (list :pointer :chained-struct)
                     :status (list :enum surface-get-current-texture-status)}
   :texture-binding-layout {:next-in-chain (list :pointer :chained-struct)
                            :sample-type (list :enum texture-sample-type)
                            :view-dimension (list :enum texture-view-dimension)
                            :multisampled (list :bool)}
   :texture-binding-view-dimension {:chain (list :struct :chained-struct)
                                    :texture-binding-view-dimension (list :enum texture-view-dimension)}
   :texture-component-swizzle {:r (list :enum component-swizzle)
                               :g (list :enum component-swizzle)
                               :b (list :enum component-swizzle)
                               :a (list :enum component-swizzle)}
   :vertex-attribute {:next-in-chain (list :pointer :chained-struct) :format (list :enum vertex-format)}
   :bind-group-entry {:next-in-chain (list :pointer :chained-struct)}
   :bind-group-layout-entry {:next-in-chain (list :pointer :chained-struct)
                             :visibility (list :flags shader-stage)
                             :buffer (list :struct :buffer-binding-layout)
                             :sampler (list :struct :sampler-binding-layout)
                             :texture (list :struct :texture-binding-layout)
                             :storage-texture (list :struct :storage-texture-binding-layout)}
   :blend-state {:color (list :struct :blend-component) :alpha (list :struct :blend-component)}
   :compilation-info {:next-in-chain (list :pointer :chained-struct)
                      :messages (list :array :compilation-message :message-count)}
   :compute-pass-descriptor {:next-in-chain (list :pointer :chained-struct)
                             :label (list :string)
                             :timestamp-writes (list :pointer :pass-timestamp-writes)}
   :compute-state {:next-in-chain (list :pointer :chained-struct)
                   :entry-point (list :string)
                   :constants (list :array :constant-entry :constant-count)}
   :depth-stencil-state {:next-in-chain (list :pointer :chained-struct)
                         :format (list :enum texture-format)
                         :depth-write-enabled (list :enum optional-bool)
                         :depth-compare (list :enum compare-function)
                         :stencil-front (list :struct :stencil-face-state)
                         :stencil-back (list :struct :stencil-face-state)}
   :future-wait-info {:future (list :struct :future) :completed (list :bool)}
   :instance-descriptor {:next-in-chain (list :pointer :chained-struct)
                         :required-features (list :array 'u32 :required-feature-count)
                         :required-limits (list :pointer :instance-limits)}
   :limits {:next-in-chain (list :pointer :chained-struct)}
   :render-pass-color-attachment {:next-in-chain (list :pointer :chained-struct)
                                  :load-op (list :enum load-op)
                                  :store-op (list :enum store-op)
                                  :clear-value (list :struct :color)}
   :request-adapter-options {:next-in-chain (list :pointer :chained-struct)
                             :feature-level (list :enum feature-level)
                             :power-preference (list :enum power-preference)
                             :force-fallback-adapter (list :bool)
                             :backend-type (list :enum backend-type)}
   :shader-module-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :surface-descriptor {:next-in-chain (list :pointer :chained-struct) :label (list :string)}
   :texel-copy-buffer-info {:layout (list :struct :texel-copy-buffer-layout)}
   :texel-copy-texture-info {:origin (list :struct :origin-3d) :aspect (list :enum texture-aspect)}
   :texture-component-swizzle-descriptor {:chain (list :struct :chained-struct)
                                          :swizzle (list :struct :texture-component-swizzle)}
   :texture-descriptor {:next-in-chain (list :pointer :chained-struct)
                        :label (list :string)
                        :usage (list :flags texture-usage)
                        :dimension (list :enum texture-dimension)
                        :size (list :struct :extent-3d)
                        :format (list :enum texture-format)
                        :view-formats (list :array 'u32 :view-format-count)}
   :vertex-buffer-layout {:next-in-chain (list :pointer :chained-struct)
                          :step-mode (list :enum vertex-step-mode)
                          :attributes (list :array :vertex-attribute :attribute-count)}
   :bind-group-descriptor {:next-in-chain (list :pointer :chained-struct)
                           :label (list :string)
                           :entries (list :array :bind-group-entry :entry-count)}
   :bind-group-layout-descriptor {:next-in-chain (list :pointer :chained-struct)
                                  :label (list :string)
                                  :entries (list :array :bind-group-layout-entry :entry-count)}
   :color-target-state {:next-in-chain (list :pointer :chained-struct)
                        :format (list :enum texture-format)
                        :blend (list :pointer :blend-state)
                        :write-mask (list :flags color-write-mask)}
   :compute-pipeline-descriptor {:next-in-chain (list :pointer :chained-struct)
                                 :label (list :string)
                                 :compute (list :struct :compute-state)}
   :device-descriptor {:next-in-chain (list :pointer :chained-struct)
                       :label (list :string)
                       :required-features (list :array 'u32 :required-feature-count)
                       :required-limits (list :pointer :limits)
                       :default-queue (list :struct :queue-descriptor)
                       :device-lost-callback-info (list :struct :device-lost-callback-info)
                       :uncaptured-error-callback-info (list :struct :uncaptured-error-callback-info)}
   :render-pass-descriptor {:next-in-chain (list :pointer :chained-struct)
                            :label (list :string)
                            :color-attachments (list :array :render-pass-color-attachment :color-attachment-count)
                            :depth-stencil-attachment (list :pointer :render-pass-depth-stencil-attachment)
                            :timestamp-writes (list :pointer :pass-timestamp-writes)}
   :texture-view-descriptor {:next-in-chain (list :pointer :chained-struct)
                             :label (list :string)
                             :format (list :enum texture-format)
                             :dimension (list :enum texture-view-dimension)
                             :aspect (list :enum texture-aspect)
                             :usage (list :flags texture-usage)}
   :vertex-state {:next-in-chain (list :pointer :chained-struct)
                  :entry-point (list :string)
                  :constants (list :array :constant-entry :constant-count)
                  :buffers (list :array :vertex-buffer-layout :buffer-count)}
   :fragment-state {:next-in-chain (list :pointer :chained-struct)
                    :entry-point (list :string)
                    :constants (list :array :constant-entry :constant-count)
                    :targets (list :array :color-target-state :target-count)}
   :render-pipeline-descriptor {:next-in-chain (list :pointer :chained-struct)
                                :label (list :string)
                                :vertex (list :struct :vertex-state)
                                :primitive (list :struct :primitive-state)
                                :depth-stencil (list :pointer :depth-stencil-state)
                                :multisample (list :struct :multisample-state)
                                :fragment (list :pointer :fragment-state)}
   :native-display-handle {:type (list :enum native-display-handle-type)
                           :data (list :struct :native-display-handle-data)}
   :instance-extras {:chain (list :struct :chained-struct)
                     :backends (list :flags instance-backend)
                     :flags (list :flags instance-flag)
                     :dx12-shader-compiler (list :enum dx12-compiler)
                     :gles3-minor-version (list :enum gles3-minor-version)
                     :gl-fence-behaviour (list :enum gl-fence-behaviour)
                     :dxc-path (list :string)
                     :dxc-max-shader-model (list :enum dxc-max-shader-model)
                     :dx12-presentation-system (list :enum dx12-swapchain-kind)
                     :display-handle (list :struct :native-display-handle)}
   :device-extras {:chain (list :struct :chained-struct) :trace-path (list :string)}
   :native-limits {:chain (list :struct :chained-struct)}
   :shader-define {:name (list :string) :value (list :string)}
   :shader-source-glsl {:chain (list :struct :chained-struct)
                        :stage (list :flags shader-stage)
                        :code (list :string)
                        :defines (list :array :shader-define :define-count)}
   :shader-module-descriptor-spir-v {:label (list :string)}
   :hub-report {:adapters (list :struct :registry-report)
                :devices (list :struct :registry-report)
                :queues (list :struct :registry-report)
                :pipeline-layouts (list :struct :registry-report)
                :shader-modules (list :struct :registry-report)
                :bind-group-layouts (list :struct :registry-report)
                :bind-groups (list :struct :registry-report)
                :command-buffers (list :struct :registry-report)
                :render-bundles (list :struct :registry-report)
                :render-pipelines (list :struct :registry-report)
                :compute-pipelines (list :struct :registry-report)
                :pipeline-caches (list :struct :registry-report)
                :query-sets (list :struct :registry-report)
                :buffers (list :struct :registry-report)
                :textures (list :struct :registry-report)
                :texture-views (list :struct :registry-report)
                :samplers (list :struct :registry-report)}
   :global-report {:surfaces (list :struct :registry-report) :hub (list :struct :hub-report)}
   :instance-enumerate-adapter-options {:next-in-chain (list :pointer :chained-struct)
                                        :backends (list :flags instance-backend)}
   :bind-group-entry-extras {:chain (list :struct :chained-struct)
                             :samplers (list :array 'pointer :buffer-count)
                             :texture-views (list :array 'pointer :sampler-count)}
   :bind-group-layout-entry-extras {:chain (list :struct :chained-struct)}
   :query-set-descriptor-extras {:chain (list :struct :chained-struct)}
   :surface-configuration-extras {:chain (list :struct :chained-struct)}
   :surface-source-swap-chain-panel {:chain (list :struct :chained-struct)}
   :primitive-state-extras {:chain (list :struct :chained-struct)
                            :polygon-mode (list :enum polygon-mode)
                            :conservative (list :bool)}
   :image-subresource-range {:aspect (list :enum texture-aspect)}
   :sampler-descriptor-extras {:chain (list :struct :chained-struct)
                               :sampler-border-color (list :enum sampler-border-color)}})

;; The nonzero bytes of each WGPU_*_INIT, as (offset byte) pairs. A
;; zeroed struct with these bytes set has the C defaults.
(def defaults
  {:string-view '((8 255) (9 255) (10 255) (11 255) (12 255) (13 255) (14 255) (15 255))
   :adapter-info '((16 255)
                   (17 255)
                   (18 255)
                   (19 255)
                   (20 255)
                   (21 255)
                   (22 255)
                   (23 255)
                   (32 255)
                   (33 255)
                   (34 255)
                   (35 255)
                   (36 255)
                   (37 255)
                   (38 255)
                   (39 255)
                   (48 255)
                   (49 255)
                   (50 255)
                   (51 255)
                   (52 255)
                   (53 255)
                   (54 255)
                   (55 255)
                   (64 255)
                   (65 255)
                   (66 255)
                   (67 255)
                   (68 255)
                   (69 255)
                   (70 255)
                   (71 255))
   :buffer-binding-layout '((8 1))
   :buffer-descriptor '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
   :command-buffer-descriptor '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
   :command-encoder-descriptor '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
   :compatibility-mode-limits '((8 15)
                                (16 255)
                                (17 255)
                                (18 255)
                                (19 255)
                                (20 255)
                                (21 255)
                                (22 255)
                                (23 255)
                                (24 255)
                                (25 255)
                                (26 255)
                                (27 255)
                                (28 255)
                                (29 255)
                                (30 255)
                                (31 255))
   :compilation-message '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
   :constant-entry '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
   :external-texture-binding-entry '((8 14))
   :external-texture-binding-layout '((8 13))
   :multisample-state '((8 1) (12 255) (13 255) (14 255) (15 255))
   :pass-timestamp-writes '((16 255) (17 255) (18 255) (19 255) (20 255) (21 255) (22 255) (23 255))
