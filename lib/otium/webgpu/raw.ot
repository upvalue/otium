        (ffi/bind library "wgpuDeviceCreateShaderModuleTrusted" (list 'pointer 'pointer 'u64) 'pointer #t)))

(def (load! names)
  "Open the wgpu-native library, a path or list of candidates, and bind every function."
  (set! library
        (ffi/open-library (if (string? names)
                              (list names)
                              names)))
  (bind-all!))

;; Reloading this module keeps the library and binds again.
(when library (bind-all!))
