;; Struct layouts by name.
(def layouts
  {:string-view string-view
   :chained-struct chained-struct
   :buffer-map-callback-info buffer-map-callback-info
   :compilation-info-callback-info compilation-info-callback-info
   :create-compute-pipeline-async-callback-info create-compute-pipeline-async-callback-info
   :create-render-pipeline-async-callback-info create-render-pipeline-async-callback-info
   :device-lost-callback-info device-lost-callback-info
   :pop-error-scope-callback-info pop-error-scope-callback-info
   :queue-work-done-callback-info queue-work-done-callback-info
   :request-adapter-callback-info request-adapter-callback-info
   :request-device-callback-info request-device-callback-info
