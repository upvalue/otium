(ns manse.apps)

(defabstract App)

(defgeneric (info app))

(defgeneric (step! app))

(defgeneric (close! app))

(defgeneric (view app))

(defgeneric (finished? app))

(defmethod (step! (app App))
  #f)

(defmethod (close! (app App))
  nil)

(defmethod (finished? (app App))
  #f)

(def (registry)
  {:next-id 1 :entries []})

(def (add! registry name app)
  "Register an app with a stable ID. The registry owns its lifetime."
  (unless (is-a? app App) (error "Expected a Manse app" app))
  (unless (and (string? name) (> (string-length name) 0)) (error "App name must be a nonempty string" name))
  (when (exists (fn (entry) (eq? (entry :app) app)) (registry :entries)) (error "App is already registered"))
  (let ((entry {:id (registry :next-id) :name name :app app}))
    (put! registry :next-id (+ 1 (registry :next-id)))
    (push! (registry :entries) entry)
    (entry :id)))

(def (find registry id)
  "Return the live app with this ID, or nil."
  (let loop ((entries (array-to-list (registry :entries))))
    (cond
      ((null? entries) nil)
      ((equal? ((car entries) :id) id) ((car entries) :app))
      (else (loop (cdr entries))))))

;; lint: allow(rest-arguments) combines any number of predicates
(def (query registry . predicates)
  "Return metadata tables in registration order, optionally filtered by a predicate."
  (let ((items (map (fn (entry) (put (info (entry :app)) :id (entry :id) :name (entry :name))) (registry :entries))))
    (if (null? predicates)
        items
        (filter (car predicates) items))))

(def (remove! registry id)
  "Close an app before unregistering it. Missing IDs are harmless."
  (let ((app (find registry id)))
    (when app
      (close! app)
      (put! registry :entries (filter (fn (entry) (not (equal? (entry :id) id))) (registry :entries))))
    app))
