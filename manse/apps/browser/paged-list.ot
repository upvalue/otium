(ns manse.apps.browser.paged-list)
(require otium.ui :as ui)
(require manse.theme :as theme)

(defclass PagedList
  :is ui/Widget
  rows
  choose
  (selected :init 0 :state #t))

(defmethod (ui/default-focusable? (w PagedList))
  #t)

(defmethod (ui/repeat-key? (w PagedList) event)
  (not (not (member (get event :key) '("Up" "Down")))))

(defmethod (ui/layout-style (w PagedList))
  {:grow 1 :height 0})

(defmethod (ui/handle-event (w PagedList) event)
  (when (eq? (get event :kind) :key-down)
    (let ((key (get event :key))
          (last (- (length (w :rows)) 1)))
      (cond
        ((member key '("Up" "Down" "Home" "End"))
         (set! (w :selected)
               (max 0
                    (min last
                         (cond
                           ((equal? key "Home") 0)
                           ((equal? key "End") last)
                           (else (+ (w :selected)
                                    (if (equal? key "Up")
                                        -1
                                        1)))))))
         :handled)
        ((and (equal? key "Return") (>= last 0)) ((w :choose) (get (w :rows) (min (w :selected) last))) :handled)))))

(defmethod (ui/build (w PagedList))
  (let ((rows (w :rows))
        (selected (min (w :selected) (- (length rows) 1))))
    (apply ui/scroll
           {:axis :y :grow 1 :height 0 :gap 1 :reveal selected}
           (for ((i :range (length rows))
                 (out :collect (let ((entry (get rows i))
                                     (index i)
                                     (selected? (= i selected)))
                                 (ui/row {:key index
                                          :padding-x 10
                                          :padding-y 6
                                          :gap 12
                                          :radius 4
                                          :align-items :center
                                          :background (when selected? theme/selected)
                                          :on-press (fn ()
                                                      (set! (w :selected) index)
                                                      ((w :choose) entry))}
                                         (ui/label {:size 13
                                                    :wrap #f
                                                    :width 0
                                                    :grow 1
                                                    :color (if selected?
                                                               theme/text
                                                               theme/muted)}
                                                   (entry :text))
                                         (when (entry :detail)
                                           (ui/label {:size 12 :wrap #f :color theme/faint} (entry :detail)))))))
             => out))))

(def (view key rows choose)
  "A keyboard-navigable list of rows, each {:text :detail}; choose gets the row picked.
No model objects in properties: bounded presentation rows and callback only."
  (ui/new PagedList {:key key :rows rows :choose choose}))
