(ns manse.apps.development.repl)
(require manse.program :as program)
(require otium.dev :as dev)
(require manse.apps.development.inspect :as inspect)

(def (evaluate! state code)
  (let ((value (dev/evaluate-form (string->symbol (state :namespace)) (read-string (str "(begin\n" code "\n)")) #t)))
    (put! state :result [value] :namespace (str (current-ns)))
    (inspect/summary value)))

(def (interrupt? problem)
  (and (table? problem) (eq? (condition-type problem) 'interrupt)))

(def (failure problem)
  ;; Do not recursively print an arbitrary condition or its irritants.
  (cond
    ((interrupt? problem) "Interrupted.")
    ((and (table? problem) (string? (get problem :message)))
     (str "Evaluation failed: " (inspect/text-preview (get problem :message))))
    (else (str "Evaluation failed: " (inspect/summary problem)))))

(def (run state)
  (println "Manse live runtime. Ctrl+C interrupts; Ctrl+D closes this REPL.")
  (println ":ns NAME changes namespace; inspect the last result with the browser button.")
  (let ((pending "")
        (done? #f))
    (while (not done?)
      (try
        (begin
          (display (if (equal? pending "")
                       (str (state :namespace) "> ")
                       "… "))
          (flush-output-port)
          (let ((line (read-line)))
            (cond
              ((eof-object? line) (set! done? #t))
              ((and (equal? pending "") (string-starts-with? line ":ns ")) (put! state :namespace (substring line 4)))
              (else (set! pending (str pending line "\n"))
                    (when (dev/%scan-source pending)
                      (put! state :busy? #t)
                      (defer
                        (println (evaluate! state pending))
                        (put! state :busy? #f))
                      (set! pending ""))))))
        (catch problem
          (set! pending "")
          (put! state :busy? #f)
          (unless (interrupt? problem) (put! state :result [problem]))
          (println (failure problem)))))))

(def (start state)
  (program/start (fn (_) (run state)) "Manse REPL"))
