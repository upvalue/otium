(ns manse.apps.echo)
(require manse.program :as program)

;; Repeats each line typed into it. Ctrl+D ends it.

(def (run _program)
  (println "Echo. Each line you type comes back. Ctrl+D ends.")
  (prompt))

;; Each line calls prompt again by name, so a reloaded definition takes over.
(def (prompt)
  (display "> ")
  (flush-output-port)
  (let ((line (read-line)))
    (unless (eof-object? line)
      (println line)
      (prompt))))

(def (start)
  (program/start (fn (p) (run p)) "echo"))
