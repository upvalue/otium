(ns manse.apps.repl)
(require manse.apps :as apps)
(require manse.apps.terminal :as terminal)
(require manse.ghostty :as ghostty)
(require manse.program :as program)
(require otium.dev :as dev)
(require manse.apps.browser.inspect :as inspect)

;; A REPL on Manse's own runtime, in a terminal column.

(defonce latest {:result #f})

(def (last-result)
  "The most recent result from any REPL as [value], or #f. Wrapped so nil survives."
  (latest :result))

(def (forget!)
  "Drop the last result, so the REPL no longer keeps it alive."
  (put! latest :result #f))

(def (remember! state value)
  (put! state :result [value])
  (put! latest :result [value]))

(def (evaluate! state code)
  (let ((value (dev/evaluate-form (string->symbol (state :namespace)) (read-string (str "(begin\n" code "\n)")) #t)))
    (remember! state value)
    (put! state :namespace (str (current-ns)))
    (inspect/summary value)))

(def (interrupt? problem)
  (and (table? problem) (eq? (condition-type problem) 'interrupt)))

(def (failure problem)
  ;; Do not recursively print an arbitrary condition or its irritants.
  (cond
    ((interrupt? problem) "Interrupted.")
    ((and (table? problem) (string? (get problem :message)))
     (str "Evaluation failed: " (inspect/text-preview (get problem :message))))
    (else (str "Evaluation failed: " (inspect/summary problem)))))

(def (run state)
  (println "Manse live runtime. Ctrl+C interrupts; Ctrl+D closes this REPL.")
  (println ":ns NAME changes namespace. Cmd+P, \"Inspect the last REPL result\", browses a result.")
  (let ((pending "")
        (done? #f))
    (while (not done?)
      (try
        (begin
          (display (if (equal? pending "")
                       (str (state :namespace) "> ")
                       "… "))
          (flush-output-port)
          (let ((line (read-line)))
            (cond
              ((eof-object? line) (set! done? #t))
              ((and (equal? pending "") (string-starts-with? line ":ns ")) (put! state :namespace (substring line 4)))
              (else (set! pending (str pending line "\n"))
                    (when (dev/%scan-source pending)
                      (put! state :busy? #t)
                      (defer
                        (println (evaluate! state pending))
                        (put! state :busy? #f))
                      (set! pending ""))))))
        (catch problem
          (set! pending "")
          (put! state :busy? #f)
          (unless (interrupt? problem) (remember! state problem))
          (println (failure problem)))))))

(def (start state)
  "The REPL as a program for manse.session, keeping its namespace and last result in state."
  (program/start (fn (_) (run state)) "Manse REPL"))

(def (open! id)
  "A terminal app running a new REPL."
  (let ((app (terminal/open! id (start {:namespace "user" :result #f :busy? #f}))))
    (try
      (begin
        (ghostty/limit-scrollback! ((app :session) :term) 4194304 2000)
        app)
      (catch problem
        (apps/close! app)
        (error problem)))))
