(ns manse.backend)

;; The program at the other end of a terminal. manse.session/PtyBackend is the
;; only one: a child process or, through manse.program, Otium code on a green
;; thread, both on the far end of a PTY.

(defabstract Backend)

(defgeneric (write! backend bytes))

(defgeneric (resize! backend cols rows))

(defgeneric (pump! backend term deadline))

(defgeneric (status backend))

(defgeneric (info backend))

(defgeneric (close! backend))

(defmethod (info (backend Backend))
  {})
