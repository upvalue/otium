(ns manse.session)
(require otium.time :as time)
(require manse.ghostty :as g)
(require manse.pty :as pty)

(def (open! id path args)
  (let ((term (g/new 80 24))
        (success? #f))
    (unwind-protect
      (let ((session {:id id :term term :pty (pty/spawn path args 80 24)}))
        (put! term
              :on-reply (fn (data len)
                          (unless (or (session :closed?) (session :exit))
                            (pty/write-pointer! (session :pty) data len))))
        (set! success? #t)
        session)
      (unless success? (g/free! term)))))

(def parse-budget
  "Seconds pump! may spend parsing before the frame paints."
  0.008)

(def (pump! session)
  "Parse the output the PTY's reader thread has gathered, up to parse-budget, including output left after child exit."
  (unless (session :closed?)
    (let ((p (session :pty))
          (term (session :term))
          (deadline (+ (time/seconds) parse-budget))
          (changed? #f))
      (let loop ()
        (unless (session :eof?)
          (let ((n (pty/output p)))
            (cond
              ((not n) (put! session :eof? #t) (set! changed? #t))
              ((> n 0)
               (g/write-bytes! term (pty/output-data p) n)
               (pty/consume! p)
               (set! changed? #t)
               ;; Over budget, paint now and come straight back for the rest.
               (if (< (time/seconds) deadline)
                   (loop)
                   (pty/wake! p)))))))
      (when changed? (g/update! term))
      (unless (session :exit)
        (let ((status (pty/status p)))
          (when status
            (put! session :exit status)
            (set! changed? #t))))
      changed?)))

(def (close! session)
  (unless (session :closed?)
    (put! session :closed? #t)
    (unwind-protect
      (pty/close! (session :pty))
      (g/free! (session :term)))))
