(ns manse.session)
(require otium.time :as time)
(require otium.ffi :as ffi)
(require manse.backend :as backend)
(require manse.ghostty :as g)
(require manse.pty :as pty)

(defclass PtyBackend
  :is backend/Backend
  pty)

(def (backend p)
  "A backend for p, a manse.pty PTY, whatever runs on its far end."
  (make PtyBackend :pty p))

(def (pty-backend path args)
  "A child started from path (absolute) with args, argv[0] included."
  (backend (pty/spawn path args 80 24)))

(def- (has-byte? bytes byte)
  (let loop ((i 0)) (and (< i (bytevector-length bytes)) (or (= (bytevector-u8-ref bytes i) byte) (loop (+ i 1))))))

(defmethod (backend/write! (b PtyBackend) bytes)
  (let ((p (b :pty)))
    (pty/write-bytes! p bytes)
    ;; A program on a thread has no process for the kernel's Ctrl+C signal.
    (when (and (p :on-interrupt) (has-byte? bytes 3) (pty/signals? p)) ((p :on-interrupt)))))

(defmethod (backend/resize! (b PtyBackend) cols rows)
  (pty/resize! (b :pty) cols rows))

(defmethod (backend/pump! (b PtyBackend) term deadline)
  (let ((p (b :pty)))
    (let loop ((changed? #f))
      (let ((n (pty/output p)))
        (cond
          ((not n) :eof)
          ((= n 0) changed?)
          (else (g/write-bytes! term (pty/output-data p) n)
                (pty/consume! p)
                ;; Over budget, paint now and come straight back for the rest.
                (if (< (time/seconds) deadline)
                    (loop #t)
                    (begin
                      (pty/wake! p)
                      #t))))))))

(defmethod (backend/status (b PtyBackend))
  (pty/status (b :pty)))

(defmethod (backend/info (b PtyBackend))
  {:pid ((b :pty) :pid) :tty ((b :pty) :tty)})

(defmethod (backend/close! (b PtyBackend))
  (pty/close! (b :pty)))

(def (open! id backend)
  "A terminal for backend, which the session owns from here."
  (let ((term (try
                (g/new 80 24)
                (catch c
                  (backend/close! backend)
                  (error c))))
        (session {:id id :backend backend}))
    (put! session :term term)
    (put! term
          :on-reply (fn (data len)
                      (unless (or (session :closed?) (session :exit))
                        (backend/write! backend (ffi/read-bytes data len)))))
    session))

(def parse-budget
  "Seconds pump! may spend parsing before the frame paints."
  0.008)

(def (pump! session)
  "Pass the program's output to the terminal, up to parse-budget, including output left after it exits."
  (unless (session :closed?)
    (let ((term (session :term))
          (changed? #f))
      (unless (session :eof?)
        (let ((result (backend/pump! (session :backend) term (+ (time/seconds) parse-budget))))
          (when (eq? result :eof) (put! session :eof? #t))
          (when result (set! changed? #t))))
      (when changed? (g/update! term))
      (unless (session :exit)
        (let ((status (backend/status (session :backend))))
          (when status
            (put! session :exit status)
            (set! changed? #t))))
      changed?)))

(def (send! session bytes)
  "Pass bytes, typed or encoded from keys, to the program."
  (backend/write! (session :backend) bytes))

(def (resize! session cols rows)
  (backend/resize! (session :backend) cols rows))

(def (close! session)
  (unless (session :closed?)
    (put! session :closed? #t)
    (unwind-protect
      (backend/close! (session :backend))
      (g/free! (session :term)))))
