(ns manse.sidebar)
(require otium.ui :as ui)
(require manse.strip :as strip)
(require manse.apps :as apps)
(require manse.theme :as theme)

(def width 220)

(def (row label key selected? action &optional (row-width 196))
  (ui/button {:key key
              :width row-width
              :padding 8
              :style (if selected?
                         :accent
                         :bare)
              :radius 4
              :on-press action}
             (ui/label {:size 13
                        :wrap #f
                        :color (if selected?
                                   theme/background
                                   theme/text)}
                       (let ((chunk (text-chunk label 0 (max 4 (quotient (- row-width 16) 8)))))
                         (str (car chunk)
                              (if (< (cadr chunk) (caddr chunk))
                                  "…"
                                  ""))))))

(def (view state registry dispatch)
  (ui/column {:key :sidebar
              :width width
              :padding 8
              :gap 4
              :background theme/panel
              :keymap {"Up" :sidebar-up
                       "Down" :sidebar-down
                       "Escape" :sidebar-dismiss
                       "Meta+B" :sidebar-dismiss
                       "Meta+P" :palette}
              :on-action dispatch}
             (row "+ Workspace" :new-workspace #f (fn () (dispatch :workspace-new)))
             (ui/scroll {:axis :y :grow 1 :width (- width 16) :reveal (state :sidebar-key)}
                        (map (fn (item)
                               (let ((id (item :id))
                                     (selected? (equal? id (state :active))))
                                 (ui/column {:key (str "group-" id) :gap 2}
                                            (ui/row {:gap 2}
                                                    (row (if (item :expanded?)
                                                             "−"
                                                             "+")
                                                         (str "expand-" id)
                                                         #f
                                                         (fn () (dispatch (list :workspace-expand id)))
                                                         28)
                                                    (row (item :name)
                                                         (str "workspace-" id)
                                                         selected?
                                                         (fn () (dispatch (list :workspace-select id)))
                                                         162))
                                            (when (item :expanded?)
                                              (ui/column {:padding-x 6}
                                                         (map (fn (app-id)
                                                                (let ((entry (find (fn (e) (equal? (e :id) app-id))
                                                                                   (registry :entries))))
                                                                  (when entry
                                                                    (row (apps/label entry)
                                                                         (str "app-" app-id)
                                                                         (and selected?
                                                                              (equal? app-id
                                                                                      (strip/focused (item :strip))))
                                                                         (fn () (dispatch (list :app-select id app-id)))
                                                                         184))))
                                                              (strip/ids (item :strip))))))))
                             (state :items)))))
