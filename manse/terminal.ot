(ns manse.terminal)
(require otium.time :as time)
(require otium.ui :as ui)
(require otium.gfx :as gfx)
(require otium.ui.native :as native)
(require otium.process :as process)
(require manse.apps :as apps)
(require manse.backend :as backend)
(require manse.ghostty :as g)
(require manse.session :as sessions)
(require manse.settings :as settings)
(require manse.fonts :as fonts)
(require manse.keyboard :as keyboard)

(defclass TerminalApp
  :is apps/App
  session)

(def (open! id backend)
  "A terminal for backend, a manse.backend/Backend."
  (make TerminalApp :session (sessions/open! id backend)))

(def (open-shell! id shell)
  (open! id (sessions/pty-backend shell (list shell))))

(defmethod (apps/info (app TerminalApp))
  (let ((session (app :session))
        (info {:kind :terminal
               :status (cond
                         ((session :closed?) :closed)
                         ((session :exit) :exited)
                         (else :running))
               :cols (get session :cols 80)
               :rows (get session :rows 24)
               :exit (if (session :exit)
                         (copy (session :exit))
                         #f)
               :eof? (get session :eof? #f)}))
    (for ((k v :in (backend/info (session :backend))))
      (put! info k v))
    info))

(defmethod (apps/step! (app TerminalApp))
  (let ((session (app :session)))
    (when (sessions/pump! session)
      ;; Paint caches key on this, so idle terminals replay.
      (put! session :version (+ 1 (get session :version 0)))
      #t)))

(defmethod (apps/finished? (app TerminalApp))
  (let ((exit ((app :session) :exit))) (and exit (equal? (get exit :exit) 0))))

(defmethod (apps/close! (app TerminalApp))
  (sessions/close! (app :session)))

(defmethod (apps/view (app TerminalApp))
  (ui/new Terminal {:session (app :session) :tab-navigation #f}))

(def (font-size)
  (settings/options :font-size))

(def (font-key)
  "The settings the terminal font depends on. Paint caches key on it."
  (map settings/options
       '(:font-family :font-path :font-index :font-styles :hinting :fallback-fonts :font-size :line-height)))

(defonce face-cache {:key nil :faces nil})

(def (faces renderer)
  "Face IDs for :regular, :bold, :italic and :bold-italic text, registered
again when the font settings or the renderer change. A font that can't be
found is reported once and the built-in one used."
  (let ((key (list (font-key) renderer)))
    (unless (equal? key (face-cache :key))
      (put! face-cache
            :key key
            :faces (try
                     (fonts/terminal-faces (settings/options :font-family)
                                           (settings/options :font-path)
                                           (settings/options :font-index)
                                           (settings/options :font-styles)
                                           (settings/options :hinting)
                                           (settings/options :fallback-fonts))
                     (catch (error? e)
                       (process/write-error (str "manse: " (condition-message e) "; using the built-in font\n"))
                       (fonts/terminal-faces #f #f 0 {} (settings/options :hinting) #f)))))
    (face-cache :faces)))

(def (face-for faces flags)
  (let ((bold? (> (bitwise-and flags g/BOLD) 0))
        (italic? (> (bitwise-and flags g/ITALIC) 0)))
    (faces (cond
             ((and bold? italic?) :bold-italic)
             (bold? :bold)
             (italic? :italic)
             (else :regular)))))

(def (padding)
  (settings/options :padding))

;; Metrics

(def (cell-metrics renderer scale)
  "Cell width and height in device pixels, as integers: the regular face's
advance, and its line height times :line-height."
  (let ((m (native/font-metrics ((faces renderer) :regular) (font-size) scale)))
    (list (exact (max 1 (round (m :advance))))
          (exact (max 1 (round (* (m :height) (settings/options :line-height))))))))

(def (rgba rgb alpha)
  (bitwise-ior (bitwise-arithmetic-shift (car rgb) 24)
               (bitwise-arithmetic-shift (cadr rgb) 16)
               (bitwise-arithmetic-shift (caddr rgb) 8)
               alpha))

(def (changed! session)
  ;; Paint caches key on this.
  (put! session :version (+ 1 (get session :version 0))))

(def (follow! session)
  "Return a viewport scrolled into history to the live output."
  (let ((term (session :term)))
    (when (g/scrolled? term)
      (g/scroll-to-bottom! term)
      (g/update! term)
      (changed! session))))

(def (key! session event)
  (let ((bytes (keyboard/encode (session :term) event)))
    (when bytes
      (unless (= (bytevector-length bytes) 0)
        (follow! session)
        (sessions/send! session bytes))
      :handled)))

;; Logical pixels per unit of wheel motion, as ui/Scroll uses.
(def wheel-step 36)

(def (wheel! session event)
  "Scroll by vertical wheel motion. Mostly horizontal motion is left to the strip."
  (let ((dx (get event :dx 0))
        (dy (get event :dy 0))
        (term (session :term)))
    (when (and (> (abs dy) (abs dx)) (session :cell-h))
      ;; Trackpads send fractions of a row, so the remainder carries over.
      (let ((rows (+ (get session :wheel-rows 0) (/ (* (- wheel-step) dy) (session :cell-h))))
            (steps (exact (truncate rows)))
            (live? (not (session :exit))))
        (put! session :wheel-rows (- rows steps))
        (cond
          ((= steps 0))
          ((and live? (g/mouse-tracking? term))
           (dotimes (_ (abs steps))
             (wheel-report! session event (< steps 0))))
          ;; Programs on the alternate screen have no scrollback; like Ghostty,
          ;; send them arrow keys.
          ((and live? (g/alternate-screen? term))
           (dotimes (_ (abs steps))
             (key! session
                   {:key (if (< steps 0)
                             "Up"
                             "Down")})))
          (else (g/scroll! term steps) (g/update! term) (changed! session))))
      :handled)))

(def (wheel-report! session event up?)
  (let ((cw (session :cell-w))
        (ch (session :cell-h))
        (col (clamp (floor (/ (- (get event :local-x 0) (padding)) cw)) 0 (- (session :cols) 1)))
        (row (clamp (floor (/ (- (get event :local-y 0) (padding)) ch)) 0 (- (session :rows) 1)))
        (bytes (g/encode-wheel (session :term) (exact col) (exact row) up? (round cw) (round ch))))
    (unless (= (bytevector-length bytes) 0) (sessions/send! session bytes))))

;; The widget

(defclass Terminal
  :is ui/Widget
  session
  (cache :init (gfx/cache) :state #t)
  (settled :init nil :state #t))

(defmethod (ui/layout-style (w Terminal))
  {:grow 1})

(defmethod (ui/default-focusable? (w Terminal))
  #t)

(defmethod (ui/accepts-text? (w Terminal))
  #t)

(defmethod (ui/repeat-key? (w Terminal) event)
  #t)

(defmethod (ui/handle-event (w Terminal) event)
  (let ((kind (get event :kind))
        (session (w :session)))
    (cond
      ((eq? kind :pointer-down) :handled)
      ((session :closed?) :handled)
      ;; An exited terminal's history can still be read.
      ((eq? kind :wheel) (wheel! session event))
      ((session :exit) :handled)
      ((eq? kind :text-input) (follow! session) (sessions/send! session (string->utf8 (get event :text))) :handled)
      ((eq? kind :key-down) (key! session event))
      (else nil))))

;; Output bumps the session version. Focus, size and resizing are compared by
;; the UI itself; paint's own side effects, fitting the PTY and noting the
;; settled size, depend only on those.
(defmethod (ui/paint-key (w Terminal))
  (let ((session (w :session)))
    (list (get session :version 0) (session :exit) (session :closed?) (font-key) (padding))))

;; The outer cache replays idle terminals; row caches reuse unchanged text
;; after output or focus changes. While an enclosing column
;; eases to a new width, the last grid is replayed at its old size; the grid
;; and PTY resize once, when the width settles, so the shell redraws once.
(defmethod (ui/paint (w Terminal) g bounds)
  (paint-cached w g bounds))

(def (paint-cached w g bounds)
  (let ((session (w :session))
        (settled (w :settled))
        (resizing? (and (g :resizing?) settled)))
    (unless resizing? (set! (w :settled) (list (bounds :width) (bounds :height))))
    (let ((area (if resizing?
                    (ui/bounds (bounds :x) (bounds :y) (car settled) (cadr settled))
                    bounds)))
      (when resizing? (gfx/rect g bounds (rgba ((g/colors (session :term)) :background) 255)))
      (gfx/cached g
                  (w :cache)
                  area
                  (list (get session :version 0)
                        (g :focused?)
                        (session :exit)
                        (font-key)
                        (padding)
                        paint-terminal
                        paint-row
                        g/each-row-cell)
                  (fn (g) (paint-terminal session g area (not resizing?)))))))

(def (fit! session bounds)
  "Resize the terminal and PTY to the cells that fit in bounds."
  (let ((cols (max 1 (floor (/ (- (bounds :width) (* 2 (padding))) (session :cell-w)))))
        (rows (max 1 (floor (/ (- (bounds :height) (* 2 (padding))) (session :cell-h))))))
    (unless (and (= cols (get session :cols 0)) (= rows (get session :rows 0)))
      (g/resize! (session :term) cols rows (round (session :cell-w)) (round (session :cell-h)))
      (unless (session :exit) (sessions/resize! session cols rows))
      (g/update! (session :term))
      (put! session :cols cols :rows rows))))

;; Flags that change how a run of cells is drawn, so they end it.
(def- run-flags (bitwise-ior g/BOLD g/ITALIC g/STRIKETHROUGH g/UNDERLINE))

(def (cells! session g x y text color flags)
  "Draw a run of cells, separated by 0x1F, in the face for flags."
  (gfx/cells g
             x
             y
             text
             (face-for (session :faces) flags)
             (font-size)
             (session :cell-w-px)
             (session :cell-h-px)
             color
             (bitwise-ior (if (> (bitwise-and flags g/UNDERLINE) 0) 1 0)
                          (if (> (bitwise-and flags g/STRIKETHROUGH) 0) 2 0))))

(def (faint fg bg)
  "fg halfway to bg, for faint text."
  (bitwise-ior (bitwise-arithmetic-shift (quotient (+ (bitwise-and (bitwise-arithmetic-shift fg -24) 255)
                                                      (bitwise-and (bitwise-arithmetic-shift bg -24) 255))
                                                   2)
                                         24)
               (bitwise-arithmetic-shift (quotient (+ (bitwise-and (bitwise-arithmetic-shift fg -16) 255)
                                                      (bitwise-and (bitwise-arithmetic-shift bg -16) 255))
                                                   2)
                                         16)
               (bitwise-arithmetic-shift (quotient (+ (bitwise-and (bitwise-arithmetic-shift fg -8) 255)
                                                      (bitwise-and (bitwise-arithmetic-shift bg -8) 255))
                                                   2)
                                         8)
               255))

(def (paint-terminal session g bounds fit?)
  (let ((start (time/seconds))
        (term (session :term)))
    (put! session :faces (faces (g :renderer)))
    (let ((metrics-key (list (font-key) (native/gpu-scale (g :renderer)))))
      (unless (equal? metrics-key (session :metrics-key))
        (put! session :cell-w nil)
        (put! session :metrics-key metrics-key)))
    ;; Cells are whole device pixels; layout works in their logical size.
    (unless (session :cell-w)
      (let ((scale (native/gpu-scale (g :renderer)))
            (m (cell-metrics (g :renderer) (native/gpu-scale (g :renderer)))))
        (put! session
              :cell-w-px (car m)
              :cell-h-px (cadr m)
              :cell-w (/ (car m) scale)
              :cell-h (/ (cadr m) scale))))
    (when fit? (fit! session bounds))
    (let ((cw (session :cell-w))
          (ch (session :cell-h))
          (x0 (+ (bounds :x) (padding)))
          (y0 (+ (bounds :y) (padding)))
          (colors (g/colors term))
          (row-key (list (session :metrics-key)
                         cw
                         ch
                         (session :cols)
                         (session :rows)
                         (colors :foreground)
                         (colors :background)
                         (padding)
                         (g :renderer)
                         paint-row
                         g/each-row-cell))
          (full? (= (g/dirty term) 2)))
      (unless (equal? row-key (session :row-key)) (put! session :row-caches [] :row-key row-key))
      (gfx/rect g bounds (rgba (colors :background) 255))
      (g/each-row term
                  (fn (y dirty?)
                    (let ((caches (session :row-caches)))
                      (when (= y (length caches)) (push! caches (gfx/cache)))
                      (let ((cache (get caches y))
                            (area (ui/bounds x0 (+ y0 (* y ch)) (* (session :cols) cw) ch)))
                        (when (or full? dirty?) (put! cache :key nil))
                        ;; Keep glyph overhang and rectangle antialiasing at row edges.
                        (gfx/cached g cache bounds row-key (fn (g) (paint-row session g area colors)))
                        (when dirty? (g/clear-row-dirty! term))))))
      (g/clear-dirty! term)
      (let ((cur (g/cursor term)))
        (when (and cur (g :focused?) (not (session :exit)))
          (gfx/rect g
                    (ui/bounds (+ x0 (* (car cur) cw)) (+ y0 (* (cadr cur) ch)) cw ch)
                    (rgba (colors :foreground) 128)))))
    (record-time! session (- (time/seconds) start))))

(def (paint-row session g area colors)
  ;; Backgrounds first, then text, from one native walk of the row.
  (let ((cw (session :cell-w))
        (ch (session :cell-h))
        (x0 (area :x))
        (py (area :y)))
    (unless (g/each-row-run (session :term)
                            (rgba (colors :foreground) 255)
                            (rgba (colors :background) 255)
                            (fn (start end bg)
                              (let ((left (round (+ x0 (* start cw)))))
                                (gfx/fill g left py (- (round (+ x0 (* end cw))) left) ch bg)))
                            (fn (x text fg flags) (cells! session g (+ x0 (* x cw)) py text fg flags)))
      (paint-row-cells session g area colors))))

;; Without manse-native's row walker, walk the cells from Otium.
(def (paint-row-cells session g area colors)
  (let ((cw (session :cell-w))
        (ch (session :cell-h))
        (x0 (area :x))
        (py (area :y))
        (default-fg (rgba (colors :foreground) 255))
        (default-bg (rgba (colors :background) 255))
        (run (buffer))
        (run-col 0)
        (run-color nil)
        (run-style 0))
    (def (flush!)
      (when run-color (cells! session g (+ x0 (* run-col cw)) py (buffer->string run) run-color run-style))
      (set! run (buffer)))
    (g/each-row-cell (session :term)
                     (fn (x text cell-fg cell-bg flags)
                       (let ((inverse? (> (bitwise-and flags g/INVERSE) 0))
                             (style (bitwise-and flags run-flags)))
                         (let ((fg (if inverse?
                                       (or cell-bg default-bg)
                                       (or cell-fg default-fg)))
                               (bg (if inverse?
                                       (or cell-fg default-fg)
                                       cell-bg)))
                           (when (> (bitwise-and flags g/FAINT) 0) (set! fg (faint fg (or bg default-bg))))
                           (when bg
                             (let ((left (round (+ x0 (* x cw)))))
                               (gfx/fill g left py (- (round (+ x0 (* (+ x 1) cw))) left) ch bg)))
                           (if (and run-color (= fg run-color) (= style run-style))
                               (buffer-push! run "\x1f;")
                               (begin
                                 (flush!)
                                 (set! run-col x)
                                 (set! run-color fg)
                                 (set! run-style style)))
                           (buffer-push! run
                                         (if (> (bitwise-and flags g/INVISIBLE) 0)
                                             " "
                                             text))))))
    (flush!)))

(def (record-time! session elapsed)
  (put! session :paint-seconds (+ elapsed (get session :paint-seconds 0)))
  (put! session :frames (+ 1 (get session :frames 0)))
  (when (= 0 (modulo (session :frames) 120))
    (process/write-error (str "manse "
                              (session :id)
                              ": "
                              (session :cols)
                              "x"
                              (session :rows)
                              " paint "
                              (/ (round (* (/ (session :paint-seconds) 120) 100000)) 100.0)
                              " ms/frame\n"))
    (put! session :paint-seconds 0)))
