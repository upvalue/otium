;; Native integration: real Ghostty terminal + SDL browser, isolated window.
(require manse.workspace)
(require manse.apps.browser.paged-list :as paged)
(require otium.ui :as ui)
(require otium.test :refer (check))

(def inspected #f)

(def list-widget
  (make paged/PagedList :rows [{:text "one"} {:text "two"}] :choose (fn (row) (set! inspected (row :text)))))

(ui/handle-event list-widget {:kind :key-down :key "Down"})
(ui/handle-event list-widget {:kind :key-down :key "Return"})
(check "keyboard selection" "two" inspected)
(ns manse.workspace)
(require manse.apps.browser.model :as model)
(require otium.time :as time)
(require otium.process :as process)
(require otium.test :refer (check report))

(def large-value (for ((i :range 100000) (out :collect-array i)) => out))

(def old-state #f)

(def measured [])

(set! icon-path (fn () (str (current-directory) "/manse/assets/manse-mark.png")))

(def (scripted! window)
  (let ((tick (get window :tick 0)))
    (put! window :tick (+ tick 1))
    (when (= tick 2) (new-browser!))
    (when (= tick 4)
      (let ((app (find-app 1)))
        (set! old-state (app :state))
        (browser/open-value! app large-value "100,000-item array")))
    (when (and (> tick 5) (< tick 25))
      (let ((app (find-app 1))
            (start (time/seconds)))
        (model/refresh! (app :state))
        (model/step! (app :state))
        (push! measured (* 1000 (- (time/seconds) start)))))
    (when (= tick 25) (put! ((find-app 1) :state) :cursor 99936 :pending? #t))
    (when (= tick 40)
      (check "last array page" 64 (length ((((find-app 1) :state) :page) :rows)))
      (ui/capture! window (str (process/getenv "OTIUM_BUILD") "/inspector-native-smoke.png")))
    (when (= tick 45) (close-app! 1))
    (when (= tick 50)
      (check "closed app releases references" #f (old-state :selected))
      (check "closed app releases page" 0 (length ((old-state :page) :rows)))
      (new-browser!))
    (when (= tick 55)
      (check "reopen gets fresh state" #f (((find-app 2) :state) :selected))
      (action! :palette)
      (put! (workspace :palette) :query "repl runtime"))
    (when (= tick 60)
      (check "the palette filters by every word" '("New REPL on Manse's runtime") (map :name (palette-matches)))
      (action! :palette-run))
    (when (= tick 65)
      (check "running a command closes the palette" nil (workspace :popup))
      (check "and runs it" "REPL" ((last (array-to-list ((workspace :apps) :entries))) :name))
      (println "bounded page max ms: " (apply max (array-to-list measured)))
      (report "browser UI")
      (put! workspace :quit? #t))))

(main)
