(require otium.test :refer (check report))
(require manse.apps.development.repl :as repl)
(require manse.tty :as tty)
(require manse.backend :as backend)
(require otium.thread :as thread)

(def state {:namespace "user" :result #f :busy? #f})

(def terminal (repl/start state))

(thread/sleep 0.01)
(tty/drain! terminal)
(backend/write! terminal (string->utf8 "(+ 20 22)\r"))
(thread/sleep 0.02)
(check "in-process evaluation" 42 (get (state :result) 0))
(tty/drain! terminal)
(backend/write! terminal (string->utf8 "(def dev-test-value [1 2 3])\r"))
(thread/sleep 0.02)
(backend/write! terminal (string->utf8 "dev-test-value\r"))
(thread/sleep 0.02)
(check "definition visible in live runtime" [1 2 3] (get (state :result) 0))
(tty/drain! terminal)
(backend/write! terminal (string->utf8 "(let loop () (loop))\r"))
(thread/sleep 0.02)
(check "long eval yields to observer" #t (state :busy?))
(backend/write! terminal #u8(3))
(thread/sleep 0.02)
(check "interrupt restores prompt" #f (state :busy?))
(tty/drain! terminal)
(backend/write! terminal (string->utf8 "(+ 1 2)\r"))
(thread/sleep 0.02)
(check "prompt usable after interruption" 3 (get (state :result) 0))
(backend/close! terminal)
(thread/sleep 0.01)
(check "close kills owned thread" :killed (thread/status (terminal :thread)))
(check "close clears queue" 0 (terminal :output-bytes))

(def flood (tty/start (fn (t) (tty/write! t (string-repeat "é\n" 100000))) "flood"))

(let loop ((tries 0))
  (when (and (< tries 100) (< (flood :output-bytes) (- tty/output-limit 2048)))
    (thread/sleep 0.01)
    (loop (+ tries 1))))
(thread/sleep 0.01)
(check "output backpressure bounds queue" #t (<= (flood :output-bytes) tty/output-limit))
(check "writer parks under backpressure" :waiting (thread/status (flood :thread)))

(def before (flood :output-bytes))

(tty/drain! flood 4096)
(check "bounded drain" #t (<= (- before (flood :output-bytes)) 8192))
(backend/close! flood)
(thread/sleep 0.01)
(check "close finishes parked writer" #t (not (not (memq (thread/status (flood :thread)) '(:killed :done)))))
(check "close releases chunks" 0 (length (flood :output)))

(def editing (tty/start (fn (t) (tty/read t)) "editing"))

(backend/write! editing (string->utf8 (string-repeat "\x01;" 16384)))
(backend/write! editing #u8(1 1 1))
(check "control input obeys line cap" 16384 (length (editing :line)))
(backend/write! editing #u8(21))
(check "erase capped control line" 0 (length (editing :line)))
(backend/close! editing)

(def concurrent
  (tty/start (fn (t)
               (dotimes (_ 1000)
                 (tty/write! t "producer\n")))
             "accounting"))

(dotimes (_ 100)
  (backend/write! concurrent (string->utf8 "echo"))
  (thread/sleep 0.001)
  (thread/atomically (check "queue accounting includes echo"
                            (apply + (map (fn (chunk) (caddr (text-chunk chunk 0 4))) (concurrent :output)))
                            (concurrent :output-bytes)))
  (tty/drain! concurrent 4096))
(backend/close! concurrent)
(backend/write! concurrent (string->utf8 "late input"))
(check "closed input ignored" 0 (length (concurrent :line)))
(check "closed queue accounting" 0 (concurrent :output-bytes))
(report "development REPL")
