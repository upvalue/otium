(require manse.ghostty)
(ns manse.ghostty)
(require otium.test :refer (check report))
(set! scratch (ffi/alloc 'u32 1))

(def term {:codepoints (ffi/alloc 'u32 16)})

(def cell-count 20)

(set! %cell-get
      (fn (_cells key out)
        (if (= key CELL-GRAPHEMES-LEN)
            (ffi/set! out 'u32 0 cell-count)
            (dotimes (i cell-count)
              (ffi/set! out 'u32 i 65)))
        SUCCESS))
(cell-codepoints term)
(check "capacity grows" 20 (term :codepoint-capacity))

(def saved (term :codepoints))

(set! cell-count 18)
(cell-codepoints term)
(check "capacity reused" #t (eq? saved (term :codepoints)))
(ffi/free! (term :codepoints))
(ffi/free! scratch)
(report "grapheme capacity")
