;; A child on a PTY: size, controlling terminal, output through libghostty, and Ctrl-C.
(require manse.pty :as pty)
(require manse.ghostty :as g)
(require otium.ffi :as ffi)
(require otium.test :refer (check report))

(ffi/defbindings libc %load-libc! (%usleep "usleep" (u32) int #f))

(%load-libc! "/usr/lib/libSystem.B.dylib")

(def term (g/new 80 24))

(def p
  (pty/spawn "/bin/sh"
             '("sh" "-c" "stty size; tty; ps -o tty= -o stat= -p $$; echo READY; sleep 100; echo after")
             77
             33))

(def (pump-until done? limit-ms)
  "Pass PTY output to the terminal until (done?) or the time limit passes."
  (let ((deadline (+ (current-jiffy) (* limit-ms 1000000))))
    (let loop ()
      (cond
        ((done?) #t)
        ((> (current-jiffy) deadline) #f)
        (else (let ((n (pty/output p)))
                (if (and n (> n 0))
                    (begin
                      (g/write-bytes! term (pty/output-data p) n)
                      (pty/consume! p))
                    (%usleep 10000)))
              (loop))))))

(def (screen)
  (g/update! term)
  (apply list (g/text term)))

(def (screen-has? s)
  (if (exists (fn (row) (string-contains? row s)) (screen))
      #t
      #f))

(check "child output" #t (pump-until (fn () (screen-has? "READY")) 5000))
(for-each (fn (row) (unless (equal? (string-trim row) "") (println "| " row))) (screen))
(check "stty size" #t (screen-has? "33 77"))
(check "tty name" #t (screen-has? (p :tty)))

;; ps reports ?? for a process with no controlling terminal; + marks the foreground group.
(check "controlling terminal" #f (screen-has? "??"))

(pty/write! p "\x3;")

(def (wait-exit! q)
  (pump-until (fn ()
                (let ((s (pty/status q)))
                  (when s (put! q :exit s))
                  s))
              5000))

;; sh and zsh take a controlling terminal themselves, so check with a child
;; that doesn't: the spawn must have made the PTY its controlling terminal.
(let ((q (pty/spawn "/usr/bin/python3"
                    '("python3" "-c" "import os; print('CTTY', os.tcgetpgrp(0) == os.getpgrp() == os.getsid(0))")
                    80
                    24)))
  (let ((saved p))
    (set! p q)
    (wait-exit! q)
    (pump-until (fn () (screen-has? "CTTY")) 2000)
    (check "python sees a controlling terminal" #t (screen-has? "CTTY True"))
    (pty/close! q)
    (set! p saved)))

(check "ctrl-c ends the child"
       #t
       (pump-until (fn ()
                     (let ((s (pty/status p)))
                       (when s (put! p :exit s))
                       s))
                   5000))
(check "killed by SIGINT" 2 (get (p :exit) :signal))
(check "sleep was interrupted" #f (screen-has? "after"))
(pty/close! p)
(g/free! term)
(report "pty")
