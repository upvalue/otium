(require otium.test :refer (check report))
(require manse.apps.repl :as repl)
(require manse.backend :as backend)
(require manse.pty :as pty)
(require otium.ffi :as ffi)
(require otium.thread :as thread)

(def state {:namespace "user" :result #f :busy? #f})

(def terminal (repl/start state))

(def (type! text)
  (backend/write! terminal (string->utf8 text))
  (thread/sleep 0.02))

(def (shown)
  (let ((p (terminal :pty))
        (out ""))
    (let loop ()
      (let ((n (pty/output p)))
        (when (and n (> n 0))
          (set! out (str out (utf8->string (ffi/read-bytes (pty/output-data p) n))))
          (pty/consume! p)
          (loop))))
    out))

(thread/sleep 0.02)
(check "greets with a prompt" #t (string-contains? (shown) "user> "))
(type! "(+ 20 22)\r")
(check "in-process evaluation" 42 (get (state :result) 0))
(check "prints the result" #t (string-contains? (shown) "42"))
(type! "(def dev-test-value [1 2 3])\r")
(type! "dev-test-value\r")
(check "definition visible in live runtime" [1 2 3] (get (state :result) 0))
(type! "(+ 1\r")
(check "an incomplete form continues" #t (string-contains? (shown) "… "))
(type! "2)\r")
(check "and evaluates once complete" 3 (get (state :result) 0))
(type! "(println \"from user code\")\r")
(check "user output reaches the terminal" #t (string-contains? (shown) "from user code"))
(type! "(let loop () (loop))\r")
(check "long eval yields to observer" #t (state :busy?))
(type! "\x03;")
(check "interrupt restores prompt" #f (state :busy?))
(check "and says so" #t (string-contains? (shown) "Interrupted."))
(type! "(+ 1 2)\r")
(check "prompt usable after interruption" 3 (get (state :result) 0))
(type! ":ns dev-test\r")
(check ":ns changes namespace" "dev-test" (state :namespace))
(type! "\x04;")
(check "Ctrl+D closes the REPL" 0 ((backend/status terminal) :exit))
(backend/close! terminal)
(report "REPL")
