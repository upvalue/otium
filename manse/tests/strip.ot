(require manse.strip :as strip)
(require otium.test :refer (check report))

(def s (strip/strip))

(def (order)
  (array-to-list (strip/ids s)))

(strip/sync! s '(1 2))
(check "sync appends columns" '(1 2) (order))
(check "sync focuses the first column" 1 (strip/focused s))
(strip/add! s 3)
(check "new column opens right of focus" '(1 3 2) (order))
(check "new column focused" 3 (strip/focused s))
(strip/focus-move! s 1)
(check "focus right" 2 (strip/focused s))
(strip/focus-move! s 3)
(check "focus clamps" 2 (strip/focused s))
(strip/column-move! s -1)
(check "column move" '(1 2 3) (order))
(check "column move keeps focus" 2 (strip/focused s))
(check "default width is a half" 0.5 (strip/width-of s 2))
(strip/width-step! s 1)
(check "width widens" 0.6667 (strip/width-of s 2))
(strip/width-step! s 5)
(check "width stops at full" 1.0 (strip/width-of s 2))
(strip/width-step! s -5)
(check "width stops at a third" 0.3333 (strip/width-of s 2))
(check "other widths unchanged" 0.5 (strip/width-of s 1))
(strip/remove! s 2)
(check "close removes column" '(1 3) (order))
(check "close focuses right neighbour" 3 (strip/focused s))
(strip/remove! s 3)
(check "closing the last column focuses the left" 1 (strip/focused s))
(strip/remove! s 1)
(check "closing everything clears focus" nil (strip/focused s))
(strip/add! s 4)
(check "add into an empty strip" '(4) (order))
(strip/sync! s '(4 5 6))
(strip/focus! s 6)
(strip/sync! s '(4 5))
(check "sync drops closed apps" '(4 5) (order))
(check "sync moves focus off a dropped column" 5 (strip/focused s))
(strip/focus! s 99)
(check "focusing an unknown column is ignored" 5 (strip/focused s))

(check "single letter hints" '("A" "S") (array-to-list (strip/hint-labels 2)))
(check "two letter hints when letters run out" "AA" (get (strip/hint-labels 20) 0))
(check "hint labels unique" 20 (length (strip/hint-labels 20)))
(strip/hints-start! s)
(check "hinting" #t (strip/hinting? s))
(check "first column labelled" "A" (strip/label-of s 4))
(strip/hint-type! s "A")
(check "jump ends hinting" #f (strip/hinting? s))
(check "jump focuses column" 4 (strip/focused s))
(check "labels hidden after a jump" nil (strip/label-of s 4))
(strip/hints-start! s)
(strip/hint-type! s "Z")
(check "no match cancels" #f (strip/hinting? s))
(strip/hints-start! s)
(strip/remove! s 5)
(check "closing a column cancels hints" #f (strip/hinting? s))

(def many (strip/strip))

(strip/sync! many (range 1 21))
(strip/hints-start! many)
(strip/hint-type! many "A")
(check "prefix narrows without jumping" #t (strip/hinting? many))
(check "matching labels stay visible" "AA" (strip/label-of many 1))
(check "non-matching labels hide" nil (strip/label-of many 18))
(strip/hint-type! many "S")
(check "second letter jumps" 2 (strip/focused many))

(def empty (strip/strip))

(strip/hints-start! empty)
(check "empty strip does not hint" #f (strip/hinting? empty))

(report "manse strip")
