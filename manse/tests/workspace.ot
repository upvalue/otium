(require manse.workspace :as workspace)
(require manse.session :as sessions)
(require manse.apps :as apps)
(require manse.strip :as strip)
(require manse.terminal :as terminal)
(require manse.ghostty :as g)
(require otium.ui :as ui)
(require otium.ui.input :as input)
(require otium.test :refer (check report))

;; Report input bytes without shell editing or terminal echo hiding their origin.
(def args
  '("sh"
    "-c"
    "stty raw -echo; exec /usr/bin/python3 -u -c 'import os; print(\"READY\", flush=True)\nwhile True:\n b=os.read(0,1)\n if b==b\"!\": break\n print(b.hex(), flush=True)'"))

(def session-1 (sessions/open! 1 (sessions/pty-backend "/bin/sh" args)))

(def session-2 (sessions/open! 2 (sessions/pty-backend "/bin/sh" args)))

(def tree (ui/root))

(def nodes nil)

(def (has? session text)
  (if (exists (fn (row) (string-contains? row text)) (apply list (g/text (session :term))))
      #t
      #f))

(def (wait-for predicate)
  (let ((deadline (+ (current-jiffy) 5000000000)))
    (let loop ()
      (sessions/pump! session-1)
      (sessions/pump! session-2)
      (cond
        ((predicate) #t)
        ((> (current-jiffy) deadline) (println (g/text (session-1 :term))) (println (g/text (session-2 :term))) #f)
        (else (loop))))))

;; Like the window loop, reconcile after every event.
(def (reconcile!)
  (ui/reconcile! tree (workspace/view tree)))

(def (key! name)
  (input/keyboard! tree {:kind :key-down :key name})
  (reconcile!))

;; SDL sends a key's text after its keydown, so send both.
(def (text! text)
  (key! (string-upcase text))
  (input/keyboard! tree {:kind :text-input :text text})
  (reconcile!))

(def (strip-node)
  (ui/find-key tree :strip))

(def (column-node id)
  (find (fn (node) (equal? (node :key) id)) (ui/children (strip-node))))

(def (terminal-node id)
  (find (fn (node) (equal? (node :key) :body)) (ui/children (column-node id))))

(def (focused-id)
  (strip/focused (workspace/workspace :strip)))

(workspace/add-app! "Terminal 1" (make terminal/TerminalApp :session session-1))
(workspace/add-app! "Terminal 2" (make terminal/TerminalApp :session session-2))
(strip/focus! (workspace/workspace :strip) 1)
(reconcile!)
(require manse.apps :reload)
(require manse.terminal :reload)
(require manse.workspace :reload)
(check "reload preserves live sessions" session-1 ((workspace/find-app 1) :session))
(check "reload preserves columns" '(1 2) (array-to-list (strip/ids (workspace/workspace :strip))))

(unwind-protect
  (begin
    (reconcile!)
    (check "both children ready" #t (wait-for (fn () (and (has? session-1 "READY") (has? session-2 "READY")))))
    (check "first terminal focused" (terminal-node 1) (ui/focused tree))
    (key! "Tab")
    (check "Tab reaches first PTY" #t (wait-for (fn () (has? session-1 "09"))))
    (check "Tab retains focus" (terminal-node 1) (ui/focused tree))
    (check "Tab does not reach second PTY" #f (has? session-2 "09"))
    (key! "Meta+Right")
    (check "Cmd+Right focuses the model's second column" 2 (focused-id))
    (check "Cmd+Right moves UI focus" (terminal-node 2) (ui/focused tree))
    (text! "z")
    (check "text reaches second PTY" #t (wait-for (fn () (has? session-2 "7a"))))
    (check "text does not reach first PTY" #f (has? session-1 "7a"))
    (key! "Meta+Left")
    (check "Cmd+Left focuses first" (terminal-node 1) (ui/focused tree))
    ;; Jump hints: the letter's text must not reach the shell.
    (key! "Meta+J")
    (check "Cmd+J starts hinting" #t (strip/hinting? (workspace/workspace :strip)))
    (text! "s")
    (check "hint jumps to second" (terminal-node 2) (ui/focused tree))
    (text! "y")
    (check "later text reaches second PTY" #t (wait-for (fn () (has? session-2 "79"))))
    (check "hint letter never reaches a PTY" #f (or (has? session-1 "73") (has? session-2 "73")))
    ;; A click on a terminal moves the model's focus too.
    (let ((root (get (ui/children tree) 0)))
      (set! (root :bounds) (ui/bounds 0 0 800 600))
      (set! ((strip-node) :bounds) (ui/bounds 0 0 800 600))
      (set! ((column-node 1) :bounds) (ui/bounds 0 0 400 600))
      (set! ((column-node 2) :bounds) (ui/bounds 400 0 400 600))
      (set! ((terminal-node 1) :bounds) (ui/bounds 0 30 400 570))
      (set! ((terminal-node 2) :bounds) (ui/bounds 400 30 400 570)))
    (input/dispatch! (input/pointer) tree {:kind :pointer-down :x 20 :y 320})
    (reconcile!)
    (check "click focuses first terminal" (terminal-node 1) (ui/focused tree))
    (check "click updates the model" 1 (focused-id))
    (put! session-1 :cell-w 8)
    (put! session-1 :cell-h 16)
    (terminal/fit! session-1 (ui/bounds 0 0 652 332))
    (check "first grid resized" 20 (length (g/text (session-1 :term))))
    (check "second grid unchanged" 24 (length (g/text (session-2 :term))))
    (reconcile!)
    (check "reload keeps first session" session-1 ((workspace/find-app 1) :session))
    (check "reload keeps focus" (terminal-node 1) (ui/focused tree))
    (input/keyboard! tree {:kind :focus-lost})
    (reconcile!)
    (check "window focus loss clears UI focus" nil (ui/focused tree))
    (let ((real workspace/window-focused?))
      (set! workspace/window-focused? (fn () #t))
      (reconcile!)
      (set! workspace/window-focused? real))
    (check "window focus returns to the focused column" (terminal-node 1) (ui/focused tree))
    (key! "Ctrl+A")
    (check "control key reaches first PTY" #t (wait-for (fn () (has? session-1 "01"))))
    (key! "Alt+Left")
    (check "word backward reaches first PTY" #t (wait-for (fn () (has? session-1 "62"))))
    (key! "Alt+Right")
    (check "word forward reaches first PTY" #t (wait-for (fn () (has? session-1 "66"))))
    (key! "Alt+Backspace")
    (check "delete word reaches first PTY" #t (wait-for (fn () (has? session-1 "7f"))))
    (text! "!")
    (check "first child exits" #t (wait-for (fn () (session-1 :exit))))
    (check "second child remains running" nil (session-2 :exit))
    (check "query reports exited app"
           '(1)
           (array-to-list (map :id (workspace/query-apps (fn (info) (eq? (info :status) :exited))))))
    (check "query exposes terminal kind" :terminal ((get (workspace/query-apps) 0) :kind))
    (check "query exposes resized grid" 20 ((get (workspace/query-apps) 0) :rows))
    (check "clean exit finishes the app" #t (apps/finished? (workspace/find-app 1)))
    (workspace/step! {:tick 100})
    (reconcile!)
    (check "clean exit closes the column" '(2) (array-to-list (strip/ids (workspace/workspace :strip))))
    (check "focus moves to the remaining column" (terminal-node 2) (ui/focused tree))
    (key! "Tab")
    (check "second remains interactive" #t (wait-for (fn () (has? session-2 "09"))))
    (key! "Meta+W")
    (check "Cmd+W closes the focused column" '() (array-to-list (strip/ids (workspace/workspace :strip))))
    (check "Cmd+W closes the session" #t (session-2 :closed?))
    (check "Cmd+W refuses the menu's close request" #f (workspace/close-request? {}))
    (workspace/after-frame! {})
    (check "later close requests close the window" #t (workspace/close-request? {}))
    (check "nothing focused in an empty strip" nil (ui/focused tree)))
  (ui/dispose! tree)
  (sessions/close! session-1)
  (sessions/close! session-2))

(defclass Note
  :is apps/App
  (ticks :init 0)
  (closed? :init #f))

(defmethod (apps/info (app Note))
  {:kind :note :ticks (app :ticks)})

(defmethod (apps/view (app Note))
  (ui/label {} "A nonterminal app"))

(defmethod (apps/step! (app Note))
  (set! (app :ticks) (+ 1 (app :ticks)))
  #t)

(defmethod (apps/close! (app Note))
  (set! (app :closed?) #t))

(def note (make Note))

(def note-id (workspace/add-app! "Notes" note))

(def mixed-tree (ui/root))

(def window {:tick 0})

(ui/reconcile! mixed-tree (workspace/view mixed-tree))

(def (mixed-strip)
  (get (ui/children (get (ui/children mixed-tree) 0)) 0))

(check "workspace accepts app-owned nonterminal view"
       "A nonterminal app"
       ((ui/instance (get (ui/children (get (ui/children (mixed-strip)) 0)) 2)) :text))
(workspace/step! window)
(check "workspace polls nonterminal apps" 1 (note :ticks))
(check "app changes invalidate window" #t (window :dirty?))
(check "workspace does not quit without terminals" nil (workspace/workspace :quit?))
(workspace/close-app! note-id)
(check "workspace closes nonterminal apps" #t (note :closed?))
(ui/reconcile! mixed-tree (workspace/view mixed-tree))
(check "empty workspace renders" 0 (length (ui/children (mixed-strip))))
(ui/dispose! mixed-tree)
(report "manse workspace")
