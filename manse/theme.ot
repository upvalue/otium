;; Colours after Zed's One Dark. Plain defs, so reloading restyles Manse.
(ns manse.theme)
(require otium.ui :as ui)

(def background 0x282c33ff)

(def panel 0x2f343eff)

(def surface 0x3b414dff)

(def hover 0x363c46ff)

(def selected 0x454a57ff)

(def border 0x464b57ff)

(def border-variant 0x363c46ff)

(def scrim 0x00000099)

(def text 0xdce0e5ff)

(def muted 0xa9afbcff)

(def faint 0x6e7380ff)

(def accent 0x74ade8ff)

(def green 0xa1c181ff)

(def yellow 0xe5c07bff)

(def red 0xd07277ff)

(def purple 0xb477cfff)

(def cyan 0x6eb4bfff)

(def hint 0xe5c07bff)

(def hint-text 0x282c33ff)

(def hint-typed 0x8a7140ff)

(def ui-size 13)

;; Update widget defaults when this module is reloaded.
(put! ui/palette
      :text text
      :muted faint
      :selection selected
      :focus accent
      :input background
      :disabled panel
      :accent-pressed selected
      :accent accent
      :surface surface
      :on-accent background)
