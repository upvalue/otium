;; Manse's colours and UI font, after Delta: near-black content, a slightly
;; lighter sidebar, hairline edges and flat rows. Constants by convention, but
;; plain defs, so reloading this file restyles Manse.
(ns manse.theme)
(require otium.ui :as ui)
(require otium.gfx :as gfx)
(require manse.fonts :as fonts)

(def BACKGROUND 0x191c1fff)

(def PANEL 0x202327ff)

(def SURFACE 0x2d2f35ff)

(def HOVER 0x26292dff)

(def SELECTED 0x2d3036ff)

(def BORDER 0x33363cff)

(def BORDER_VARIANT 0x292c31ff)

(def SCRIM 0x00000099)

(def TEXT 0xe6e8ebff)

(def MUTED 0xa0a4abff)

(def FAINT 0x6b7078ff)

(def ACCENT 0x74ade8ff)

(def GREEN 0xa1c181ff)

(def YELLOW 0xe5c07bff)

(def RED 0xd07277ff)

(def PURPLE 0xb477cfff)

(def CYAN 0x6eb4bfff)

(def HINT 0xe5c07bff)

(def HINT_TEXT 0x191c1fff)

(def HINT_TYPED 0x8a7140ff)

(def SIDEBAR 0x202327ff)

(def SIDEBAR_EDGE 0x292c31ff)

(def SIDEBAR_HOVER 0x272a2eff)

(def SIDEBAR_SELECTED 0x2d2f35ff)

(def UI_SIZE 13)

(def UI_FONT "Inter-Regular.otf")

;; Update widget defaults when this module is reloaded.
(put! ui/palette
      :text TEXT
      :muted FAINT
      :selection SELECTED
      :focus ACCENT
      :input BACKGROUND
      :disabled PANEL
      :accent-pressed SELECTED
      :accent ACCENT
      :surface SURFACE
      :on-accent BACKGROUND)

;; Fall back to the built-in face when Inter isn't installed.
(gfx/set-font! :ui (try
                     (fonts/resolve UI_FONT)
                     (catch (error? _) nil)))
