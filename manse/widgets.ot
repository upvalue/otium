;; Small workspace widgets: dots and hint badges.
(ns manse.widgets)

(require (otium.ui :as ui))
(require (otium.gfx :as gfx))
(require (manse.theme :as theme))

(defclass Dot
  :is ui/Widget
  (color :init 0xffffffff)
  (size :init 8))

(def (dot color . size)
  (ui/new Dot
          {:color color
           :size (if (null? size)
                     8
                     (car size))}))

(defmethod (ui/layout-style (w Dot))
  {:width (w :size) :height (w :size)})

(defmethod (ui/paint (w Dot) g bounds)
  (gfx/rect g bounds (w :color) (/ (w :size) 2)))

(def (spacer)
  (ui/row {:grow 1}))

(def (text color size string)
  (ui/label {:color color :size size :wrap #f} string))

(def (hint-badge label typed)
  "A Vimium-style label; the typed prefix is dimmed."
  (ui/row {:background theme/hint :radius 3 :padding-x 5 :padding-y 1}
          (unless (equal? typed "") (ui/label {:font :mono :size 11 :color theme/hint-typed :wrap #f} typed))
          (ui/label {:font :mono :size 11 :color theme/hint-text :wrap #f} (substring label (string-length typed)))))

(def (key-cap key)
  (ui/row {:background theme/surface :radius 3 :padding-x 5 :padding-y 1}
          (ui/label {:font :mono :size 11 :color theme/muted :wrap #f} key)))
