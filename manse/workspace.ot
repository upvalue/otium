(ns manse.workspace)
(require otium.ui :as ui)
(require otium.process :as process)
(require otium.sdl :as sdl)
(require manse.apps :as apps)
(require manse.session :as sessions)
(require manse.strip :as strip)
(require manse.workspaces :as groups)
(require manse.sidebar :as sidebar)
(require manse.sysinfo :as sysinfo)
(require manse.apps.terminal :as terminal)
(require manse.apps.echo :as echo)
(require manse.apps.repl :as repl)
(require manse.apps.browser :as browser)
(require manse.pty :as pty)
(require manse.settings :as settings)
(require manse.theme :as theme)
(require manse.widgets :as w)

(defonce workspace {:apps (apps/registry) :strip (strip/strip)})

;; Adopt the old strip once, retaining every live app through reload.
(unless (workspace :groups) (put! workspace :groups (groups/new (workspace :strip))))

(def (activate! id)
  (groups/select! (workspace :groups) id)
  (put! workspace
        :strip ((groups/active (workspace :groups)) :strip)
        :ui-focus nil
        :requested-focus nil
        :focus-content? #t
        :drawer? #f
        :sidebar-focus? #f))

(def (new-workspace!)
  (activate! (groups/create! (workspace :groups))))

(def (move-app! id destination)
  (groups/move! (workspace :groups) id destination)
  (activate! destination)
  (invalidate!))

;; lint: allow(rest-arguments) forwards any number of predicates
(def (query-apps . predicates)
  "Inspect app metadata, optionally filtering with a predicate."
  (apply apps/query (workspace :apps) predicates))

(def (find-app id)
  "Get a live app for further inspection."
  (apps/find (workspace :apps) id))

(def (invalidate!)
  (when (workspace :window) (ui/invalidate! (workspace :window))))

(def (add-app! name app)
  "Register an app and open its column to the right of the focused one."
  (let ((id (apps/add! (workspace :apps) name app)))
    (groups/add! (workspace :groups) id)
    (put! workspace :focus-content? #t :sidebar-focus? #f)
    (invalidate!)
    id))

(def (close-app! id)
  (let ((app (apps/remove! (workspace :apps) id)))
    (groups/remove! (workspace :groups) id)
    (when (workspace :focus-keys) (put! (workspace :focus-keys) id nil))
    (invalidate!)
    app))

(def (new-terminal!)
  (let ((id ((workspace :apps) :next-id)))
    (add-app! (str "Terminal " id)
              (terminal/open-shell! id (or (workspace :shell) (process/getenv "SHELL") "/bin/sh")))))

(def (new-repl!)
  (add-app! "REPL" (repl/open! ((workspace :apps) :next-id))))

(def (new-browser!)
  (add-app! "Object browser" (browser/open!)))

(def (inspect-last-result!)
  "Open a browser on the last REPL result."
  (let ((app (browser/open!)))
    (browser/inspect-last-result! app)
    (add-app! "Object browser" app)))

(def (new-echo!)
  (add-app! "Echo" (terminal/open! ((workspace :apps) :next-id) (echo/start))))

(def (terminal-sessions)
  (map (fn (entry) ((entry :app) :session))
       (filter (fn (entry) (eq? (dispatch-type (entry :app)) terminal/TerminalApp)) ((workspace :apps) :entries))))

;; Keys

(def bindings
  "Key, label for the help panel, action and description."
  [["Meta+B" "Cmd+B" :sidebar "Focus or hide workspace sidebar"]
   ["Meta+P" "Cmd+P" :palette "Run a command by name"]
   ["Meta+T" "Cmd+T" :new "New terminal to the right"]
   ["Meta+E" "Cmd+E" :echo "New echo program to the right"]
   ["Meta+W" "Cmd+W" :close "Close the focused column"]
   ["Meta+Left" "Cmd+Left" :left "Focus the column to the left"]
   ["Meta+Right" "Cmd+Right" :right "Focus the column to the right"]
   ["Meta+Shift+Left" "Cmd+Shift+Left" :move-left "Move the column left"]
   ["Meta+Shift+Right" "Cmd+Shift+Right" :move-right "Move the column right"]
   ["Meta+=" "Cmd+=" :widen "Widen the column"]
   ["Meta+-" "Cmd+-" :narrow "Narrow the column"]
   ["Meta+Shift+=" "Cmd+Shift+=" :font-larger "Larger text"]
   ["Meta+Shift+-" "Cmd+Shift+-" :font-smaller "Smaller text"]
   ["Meta+J" "Cmd+J" :jump "Jump to a column by its letters"]
   ["Meta+I" "Cmd+I" :sysinfo "Show or hide system info"]
   ["Meta+Shift+/" "Cmd+?" :help "Show or hide these keys"]])

(def (keymap)
  (let ((map {}))
    (for-each (fn (b) (put! map (get b 0) (get b 2))) bindings)
    (when (strip/hinting? (workspace :strip))
      (put! map "Escape" :cancel)
      (put! map "Meta+J" :cancel)
      (for-each (fn (letter) (put! map letter (list :hint letter))) strip/alphabet))
    map))

;; The command palette

(def commands
  "Name and action for commands with no key of their own."
  [["New workspace" :workspace-new]
   ["Rename workspace" :workspace-rename]
   ["Delete empty workspace" :workspace-delete]
   ["Next workspace" :workspace-next]
   ["Previous workspace" :workspace-previous]
   ["New REPL on Manse's runtime" :repl]
   ["New object browser" :browser]
   ["Inspect the last REPL result" :inspect-result]])

(def (palette-commands)
  "Every command as {:name :action :key}: the ones above, then each binding."
  (append (for ((item :in ((workspace :groups) :items))
                (out :collect {:name (str "Move selected app to " (item :name)) :action (list :app-move (item :id))}))
            => out)
          (map (fn (c) {:name (get c 0) :action (get c 1)}) (array-to-list commands))
          (for ((b :in bindings)
                (out :collect {:name (get b 3) :action (get b 2) :key (get b 1)} :when (not (eq? (get b 2) :palette))))
            => out)))

(def (palette-matches)
  "Commands whose name contains every word typed, ignoring case."
  (let ((words (string-split (string-downcase ((workspace :palette) :query)))))
    (filter (fn (c)
              (let ((name (string-downcase (c :name))))
                (not (exists (fn (word) (not (string-contains? name word))) words))))
            (palette-commands))))

(def (palette-move! delta)
  (let ((p (workspace :palette))
        (count (length (palette-matches))))
    (put! p :selected (max 0 (min (- count 1) (+ (p :selected) delta))))))

(def (palette-run!)
  (let ((matches (palette-matches))
        (selected ((workspace :palette) :selected)))
    (put! workspace :popup nil)
    (when (< selected (length matches)) (action! ((nth matches selected) :action)))))

(def (action! action)
  (let ((s (workspace :strip)))
    (if (pair? action)
        (case (car action)
          ((:workspace-select) (activate! (cadr action)))
          ((:app-select) (activate! (cadr action)) (strip/focus! (workspace :strip) (caddr action)))
          ((:workspace-expand)
           (let ((item (groups/lookup (workspace :groups) (cadr action))))
             (put! item :expanded? (not (item :expanded?)))))
          ((:app-move) (when (strip/focused s) (move-app! (strip/focused s) (cadr action))))
          ((:hint) (strip/hint-type! s (cadr action)))
          (else nil))
        (case action
          ((:workspace-new) (new-workspace!))
          ((:workspace-delete)
           (groups/delete! (workspace :groups) ((workspace :groups) :active))
           (activate! ((workspace :groups) :active)))
          ((:workspace-next :workspace-previous)
           (let ((items ((workspace :groups) :items))
                 (index (find-index (fn (item) (equal? (item :id) ((workspace :groups) :active))) items))
                 (next (modulo (+ index
                                  (if (eq? action :workspace-next)
                                      1
                                      -1)
                                  (length items))
                               (length items))))
             (activate! ((get items next) :id))))
          ((:workspace-rename) (put! workspace :popup :rename :rename ((groups/active (workspace :groups)) :name)))
          ((:rename-save)
           (unless (equal? (workspace :rename) "")
             (groups/rename! (workspace :groups) ((workspace :groups) :active) (workspace :rename))
             (put! workspace :popup nil :focus-content? #t)))
          ((:sidebar)
           (put! workspace
                 :drawer? (not (workspace :drawer?))
                 :sidebar-focus? (not (workspace :sidebar-focus?))
                 :focus-content? (not (workspace :sidebar-focus?))))
          ((:sidebar-up :sidebar-down)
           (sidebar-move! (if (eq? action :sidebar-up)
                              -1
                              1)))
          ((:sidebar-dismiss) (put! workspace :drawer? #f :sidebar-focus? #f :focus-content? #t))
          ((:cancel) (strip/hints-cancel! s))
          ((:new) (new-terminal!))
          ((:echo) (new-echo!))
          ((:repl) (new-repl!))
          ((:browser) (new-browser!))
          ((:inspect-result) (inspect-last-result!))
          ((:palette)
           (if (eq? (workspace :popup) :palette)
               (put! workspace :popup nil)
               (put! workspace :popup :palette :palette {:query "" :selected 0})))
          ((:palette-up :palette-down)
           (palette-move! (if (eq? action :palette-up)
                              -1
                              1)))
          ((:palette-run) (palette-run!))
          ((:close) (put! workspace :closed-column? #t) (when (strip/focused s) (close-app! (strip/focused s))))
          ((:left) (strip/focus-move! s -1))
          ((:right) (strip/focus-move! s 1))
          ((:move-left) (strip/column-move! s -1))
          ((:move-right) (strip/column-move! s 1))
          ((:widen) (strip/width-step! s 1))
          ((:narrow) (strip/width-step! s -1))
          ((:font-larger :font-smaller)
           (let ((spec (settings/setting-specs :font-size)))
             (settings/configure! {:font-size (clamp (+ (settings/options :font-size)
                                                        (if (eq? action :font-larger)
                                                            1
                                                            -1))
                                                     (spec :min)
                                                     (spec :max))})))
          ((:jump) (strip/hints-start! s))
          ((:help :sysinfo)
           (put! workspace
                 :popup (if (eq? action (workspace :popup))
                            nil
                            action)))
          ((:close-popup) (put! workspace :popup nil :focus-content? #t))
          (else nil)))
    (when (memq action '(:left :right :jump :cancel :close)) (put! workspace :focus-content? #t :sidebar-focus? #f))
    (invalidate!)
    :handled))

;; The frame hook: pass PTY output to the terminal, then update its render state.

(def (scripted! window)
  "MANSE_TYPE and MANSE_TYPE_2 type into separate shells at loop iteration 30.
MANSE_KEYS runs actions by key name, separated by spaces, at iteration 40."
  (let ((frame (get window :tick 0))
        (frames (string->number (or (process/getenv "MANSE_FRAMES") "0"))))
    (put! window :tick (+ frame 1))
    (when (= frame 30)
      (for-each (fn (session)
                  (let ((text (process/getenv (if (= (session :id) 1)
                                                  "MANSE_TYPE"
                                                  "MANSE_TYPE_2"))))
                    (when (and text (not (session :exit))) (sessions/send! session (string->utf8 text)))))
                (terminal-sessions)))
    (when (and (= frame 40) (process/getenv "MANSE_KEYS"))
      (for-each (fn (name) (let ((action (get (keymap) name))) (when action (action! action))))
                (string-split (process/getenv "MANSE_KEYS") " ")))
    (when (and frames (> frames 0))
      (when (= frame (- frames 1)) (ui/capture! window (or (process/getenv "MANSE_CAPTURE") "/tmp/manse.png")))
      (when (>= frame frames) (put! workspace :quit? #t)))))

(def (step! window)
  (pty/reap!)
  (scripted! window)
  (for-each (fn (entry)
              (when (apps/step! (entry :app)) (ui/invalidate! window))
              (when (apps/finished? (entry :app)) (close-app! (entry :id))))
            (copy ((workspace :apps) :entries)))
  ;; System info counts seconds, so redraw it when the uptime ticks over.
  (when (eq? (workspace :popup) :sysinfo)
    (let ((uptime (sysinfo/uptime)))
      (unless (equal? uptime (workspace :sysinfo-shown))
        (put! workspace :sysinfo-shown uptime)
        (ui/invalidate! window)))))

;; On macOS, SDL's default menu binds Cmd+W to Window > Close. SDL delivers
;; the keydown first, then the menu asks to close the window in the same
;; batch of events, and SDL follows that with a quit for the last window.
(def (close-request? _)
  "Refuse to close the window in the frame that Cmd+W closed a column."
  (not (workspace :closed-column?)))

;; Closing from :step! would leave the frame painting with a freed renderer.
(def (after-frame! window)
  (when (window :tree) (apply-pending-focus! (window :tree)))
  (put! workspace :closed-column? #f)
  (when (workspace :quit?) (ui/close! window)))

;; The view

(def padding 8)

(def gap 8)

(def (column-width fraction viewport)
  "Width of a column taking fraction of the window, so that fractions summing to 1 fill it exactly."
  (max 160 (- (* fraction (+ (- viewport (* 2 padding)) gap)) gap)))

(def (focused-column tree)
  "Only a direct child of the content strip is an app column."
  (let ((content (ui/find-key tree :strip)))
    (let loop ((node (ui/focused tree)))
      (cond
        ((not (ui/mounted? node)) nil)
        ((eq? (node :parent) content) (node :key))
        (else (loop (node :parent)))))))

(def (column-node tree id)
  (let ((content (ui/find-key tree :strip)))
    (when content (find (fn (node) (equal? (node :key) id)) (ui/children content)))))

(def (focusables node)
  (if (not node)
      '()
      (append (if (ui/focusable? node)
                  (list node)
                  '())
              (apply append (map focusables (array-to-list (ui/children node)))))))

(def (sidebar-move! delta)
  (let ((window (workspace :window))
        (tree (and window (window :tree)))
        (nodes (and tree (focusables (ui/find-key tree :sidebar)))))
    (when (and nodes (not (null? nodes)))
      (let ((index (or (find-index (fn (node) (eq? node (ui/focused tree))) nodes) 0)))
        (let ((node (nth nodes (clamp (+ index delta) 0 (- (length nodes) 1)))))
          (ui/focus! tree node)
          (put! (workspace :groups) :sidebar-key (node :key)))))))

(def (apply-pending-focus! tree)
  (let ((before (ui/focused tree)))
    (unless (workspace :popup)
      (cond
        ((workspace :sidebar-focus?)
         (let ((nodes (focusables (ui/find-key tree :sidebar))))
           (unless (or (null? nodes) (member (ui/focused tree) nodes)) (ui/focus! tree (car nodes)))))
        ((workspace :focus-content?)
         (let ((content (ui/find-key tree :strip))
               (id (strip/focused (workspace :strip)))
               (column (and content id (column-node tree id)))
               (key (get (get workspace :focus-keys {}) id))
               (saved (and column key (ui/find-key column key)))
               (nodes (focusables column)))
           (when column
             (cond
               ((and saved (ui/focusable? saved)) (ui/focus! tree saved))
               ((not (null? nodes)) (ui/focus! tree (car nodes)))))
           (put! workspace :focus-content? #f)))))
    (unless (eq? before (ui/focused tree)) (invalidate!))))

(def (window-focused?)
  (let ((window (workspace :window)))
    (and window
         (not (window :closed?))
         (sdl/flag-set? (sdl/get-window-flags (window :window)) sdl/WINDOW_INPUT_FOCUS))))

(def (restore-focus! tree)
  "Give UI focus back to the focused column when the window becomes active again;
losing window focus clears it."
  (when (and (not (workspace :popup))
             (not (workspace :sidebar-focus?))
             (not (ui/focused tree))
             (strip/focused (workspace :strip))
             (window-focused?))
    (let ((strip-node (ui/find-key tree :strip))
          (column (and strip-node (column-node tree (strip/focused (workspace :strip)))))
          (body (and column (ui/find-key column :body))))
      (if (and body (ui/focusable? body))
          (ui/focus! tree body)
          (put! workspace :focus-content? #t)))))

(def (adopt-focus! tree)
  "Follow UI focus that moved since the last view to a column other than the
one the last view asked for, e.g. by a click. Record the focus this view asks for."
  (let ((id (focused-column tree))
        (s (workspace :strip)))
    (when (and id (not (equal? id (workspace :ui-focus))) (not (equal? id (workspace :requested-focus))))
      (strip/focus! s id))
    (when (and id (ui/focused tree) ((ui/focused tree) :key))
      (unless (workspace :focus-keys) (put! workspace :focus-keys {}))
      (put! (workspace :focus-keys) id ((ui/focused tree) :key)))
    (put! workspace :ui-focus id)
    (put! workspace :requested-focus (strip/focused s))))

(def (status-color status)
  (cond
    ((eq? status :running) theme/green)
    ((eq? status :exited) theme/red)
    ((eq? status :closed) theme/faint)
    (else theme/muted)))

(def (header s entry focused?)
  (let ((info (apps/info (entry :app)))
        (label (strip/label-of s (entry :id))))
    (ui/row {:height 30 :padding-x 10 :gap 8 :align-items :center}
            (w/dot (status-color (get info :status)) 6)
            (w/text (if focused?
                        theme/text
                        theme/muted)
                    theme/ui-size
                    (apps/label entry))
            (w/spacer)
            (if label
                (w/hint-badge label (strip/typed s))
                (w/text theme/faint 11 (strip/width-label s (entry :id)))))))

(def (column s entry viewport)
  (let ((id (entry :id))
        (focused? (equal? id (strip/focused s)))
        (source (apps/view (entry :app)))
        (body (make ui/Description
                    :properties (source :properties)
                    :key
                    :body
                    :children (source :children)
                    :options (put (or (source :options) {})
                                  :focus (and focused? (not (workspace :popup)) (not (workspace :sidebar-focus?)))))))
    (ui/column {:key id
                :cache #t
                :animate-size #t
                :align-items :stretch
                :width (column-width (strip/width-of s id) viewport)
                :padding-x 1
                :padding-y 1
                :radius 6
                :background theme/background
                :border (if focused?
                            theme/accent
                            theme/border-variant)
                :on-press (fn ()
                            (strip/focus! s id)
                            (put! workspace :sidebar-focus? #f)
                            (invalidate!))}
               (header s entry focused?)
               (ui/column {:height 1 :background theme/border-variant})
               body)))

(def (card title children)
  (ui/column {:width 360
              :padding 16
              :gap 10
              :radius 8
              :background theme/panel
              :border theme/border
              ;; Take clicks so only the backdrop closes the popup.
              :on-press (fn () nil)}
             (w/text theme/text theme/ui-size title)
             children))

(def (help)
  (card "Keys"
        (map (fn (b)
               (ui/row {:gap 10 :align-items :center}
                       (ui/row {:width 130} (w/key-cap (get b 1)))
                       (ui/label {:color theme/muted :size 12 :width 0 :grow 1} (get b 3))))
             bindings)))

(def- (duration seconds)
  (let ((h (quotient seconds 3600))
        (m (quotient (modulo seconds 3600) 60))
        (s (modulo seconds 60))
        (two (fn (n)
               (if (< n 10)
                   (str "0" n)
                   (str n)))))
    (str h ":" (two m) ":" (two s))))

(def- (megabytes bytes)
  (str (/ (round (/ bytes 104857.6)) 10.0) " MB"))

(def- (milliseconds nanoseconds)
  (str (/ (round (/ nanoseconds 10000.0)) 100.0) " ms"))

(def (sysinfo-panel)
  (let ((info (sysinfo/snapshot))
        (fp (info :footprint))
        (heap (info :heap))
        (row (fn (label value)
               (ui/row {:gap 10 :align-items :center}
                       (ui/label {:color theme/muted :size 12 :width 130} label)
                       (ui/label {:color theme/text :size 12 :width 0 :grow 1} value)))))
    (card "System"
          (list (row "Uptime" (duration (info :uptime)))
                (row "Process memory"
                     (if fp
                         (str (megabytes (fp :current)) " (peak " (megabytes (fp :peak)) ")")
                         "unknown"))
                (row "Otium heap" (str (megabytes (heap :live)) " live, " (megabytes (heap :held)) " held"))
                (row "Peak heap in use" (megabytes (heap :peak)))
                (row "Collections" (str (heap :collections)))
                (row "Time collecting"
                     (str (milliseconds (* 1000000 (heap :gc-ms))) ", longest " (milliseconds (info :longest-gc-ns))))
                (row "Allocated in total" (megabytes (info :allocated)))
                (row "Native threads"
                     (if (info :native-threads)
                         (str (info :native-threads))
                         "unknown"))
                (row "Otium threads" (str (info :threads)))))))

(def (palette)
  (let ((p (workspace :palette))
        (matches (palette-matches))
        (selected (min (p :selected) (- (length matches) 1))))
    (ui/column {:width 520
                :padding 8
                :gap 2
                :radius 8
                :background theme/panel
                :border theme/border
                :on-press (fn () nil)}
               (ui/text-field {:key :palette-query
                               :focus #t
                               :height 36
                               :size 14
                               :font :ui
                               :value (p :query)
                               :placeholder "Run a command"
                               :on-change (fn (text)
                                            (put! p :query text :selected 0)
                                            (invalidate!))})
               (ui/column {:height 6})
               (if (null? matches)
                   (ui/row {:padding 10} (ui/label {:size 13 :color theme/faint} "No matching commands"))
                   (for ((c :in matches)
                         (i :range (length matches))
                         (out :collect (ui/row {:key i
                                                :padding-x 10
                                                :padding-y 7
                                                :gap 10
                                                :radius 4
                                                :align-items :center
                                                :background (when (= i selected) theme/selected)
                                                :on-press (fn ()
                                                            (put! p :selected i)
                                                            (palette-run!))}
                                               (ui/label {:size 13
                                                          :wrap #f
                                                          :width 0
                                                          :grow 1
                                                          :color (if (= i selected)
                                                                     theme/text
                                                                     theme/muted)}
                                                         (c :name))
                                               (when (c :key) (w/key-cap (c :key))))))
                     => out)))))

(def (popup name)
  "A card over the whole window. Escape, its own key or a click outside closes it;
the other popup's key switches to that one. The palette sits near the top."
  (ui/column {:key :popup
              :overlay #t
              :modal #t
              :align-items :center
              :background theme/scrim
              :keymap (case name
                        ((:palette)
                         {"Escape" :close-popup
                          "Meta+P" :palette
                          "Up" :palette-up
                          "Down" :palette-down
                          "Return" :palette-run})
                        ((:rename) {"Escape" :close-popup "Return" :rename-save})
                        (else {"Escape" :close-popup "Meta+I" :sysinfo "Meta+Shift+/" :help}))
              :on-action (fn (action) (action! action))
              :on-press (fn () (action! :close-popup))}
             (if (eq? name :palette)
                 (ui/column {:height 96})
                 (w/spacer))
             (case name
               ((:help) (help))
               ((:sysinfo) (sysinfo-panel))
               ((:palette) (palette))
               ((:rename)
                (card "Rename workspace"
                      (list (ui/text-field {:key :rename
                                            :focus #t
                                            :height 36
                                            :value (workspace :rename)
                                            :on-change (fn (value) (put! workspace :rename value))})
                            (ui/button {:on-press (fn () (action! :rename-save))} "Save")))))
             (w/spacer)))

(def (view tree)
  (let ((s (workspace :strip))
        (entries ((workspace :apps) :entries))
        (window-width (if (workspace :window)
                          ((workspace :window) :width)
                          900))
        (narrow? (< window-width 640))
        (viewport (if narrow?
                      window-width
                      (- window-width sidebar/width))))
    ;; Membership is explicit; never append every registered app to this strip.
    (for-each (fn (item)
                (for-each (fn (id) (unless (apps/find (workspace :apps) id) (strip/remove! (item :strip) id)))
                          (strip/ids (item :strip))))
              ((workspace :groups) :items))
    (restore-focus! tree)
    (adopt-focus! tree)
    (list (ui/row {:key :workspace
                   :grow 1
                   :background theme/background
                   :keymap (keymap)
                   :on-action (fn (action) (action! action))}
                  (unless narrow? (sidebar/view (workspace :groups) (workspace :apps) (fn (action) (action! action))))
                  (ui/column {:width 0 :grow 1}
                             (when narrow?
                               (ui/button {:on-press (fn () (action! :sidebar)) :height 32}
                                          ((groups/active (workspace :groups)) :name)))
                             (when (empty? (strip/ids s))
                               (ui/button {:on-press (fn () (action! :palette)) :height 48} "Open an app · Cmd+P"))
                             (ui/scroll {:key :strip
                                         :axis :x
                                         :grow 1
                                         :padding padding
                                         :gap gap
                                         :reveal (strip/focused s)}
                                        (map (fn (id)
                                               (column s (find (fn (entry) (equal? (entry :id) id)) entries) viewport))
                                             (strip/ids s)))))
          (when (and narrow? (workspace :drawer?))
            (ui/row {:key :workspace-drawer :overlay #t :modal #t :background theme/scrim}
                    (sidebar/view (workspace :groups) (workspace :apps) (fn (action) (action! action)))
                    (ui/column {:grow 1 :on-press (fn () (action! :sidebar-dismiss))})))
          (when (workspace :popup) (popup (workspace :popup))))))

(def- (script-path relative fallback)
  (let ((script (process/script-name)))
    (if (and script (or (equal? script "manse/app.ot") (string-ends-with? script "/manse/app.ot")))
        (str (substring script 0 (- (string-length script) (string-length "manse/app.ot"))) relative)
        fallback)))

(def (config-path)
  "ui-config.ot in OTIUM_BUILD, which ./otium sets."
  (let ((build (process/getenv "OTIUM_BUILD")))
    (unless build (error "OTIUM_BUILD is not set; run Manse through ./otium"))
    (str build "/ui-config.ot")))

(def (icon-path)
  (script-path "manse/assets/manse-mark.png" "assets/manse-mark.png"))

(def (main)
  (unless (and (workspace :window) (not ((workspace :window) :closed?)))
    (settings/load!)
    (let ((shell (or (settings/options :shell) (process/getenv "SHELL") "/bin/sh")))
      (process/setenv! "TERM" "xterm-256color")
      (put! workspace :quit? #f :focus-keys {} :popup nil)
      (put! workspace :apps (apps/registry))
      (put! workspace :groups (groups/new))
      (activate! ((workspace :groups) :active))
      (put! workspace :shell shell)
      (unwind-protect
        (begin
          (dotimes (i (settings/options :terminals))
            (new-terminal!))
          (strip/focus-move! (workspace :strip) (- (settings/options :terminals)))
          (let ((window (ui/open {:title "Manse"
                                  :width (settings/options :width)
                                  :height (settings/options :height)
                                  :config (config-path)
                                  :icon (icon-path)
                                  :app-name "Manse"
                                  :app-id "sh.otium.manse"
                                  :background-color theme/background
                                  :render-on-demand? #t
                                  :poll-ms (settings/options :poll-ms)
                                  :background-poll-ms (settings/options :background-poll-ms)
                                  :step! (fn (window) (step! window))
                                  :after-frame! (fn (window) (after-frame! window))
                                  :on-close-request (fn (window) (close-request? window))})))
            (put! workspace :window window)
            (ui/set-view! window (fn () (view (window :tree))))
            (ui/run)))
        (for-each (fn (entry) (apps/remove! (workspace :apps) (entry :id))) (copy ((workspace :apps) :entries)))))))
