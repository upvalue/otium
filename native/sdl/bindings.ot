;; Shared declarations. Layouts are checked against the header probe before SDL calls.
(def SDL_FRect (ffi/define-struct! 'SDL_FRect '((x float) (y float) (w float) (h float))))

(def SDL_AudioSpec (ffi/define-struct! 'SDL_AudioSpec '((format u32) (channels int) (freq int))))

(def SDL_CommonEvent (ffi/define-struct! 'SDL_CommonEvent '((type u32) (reserved u32) (timestamp u64))))

(def SDL_KeyboardEvent
  (ffi/define-struct! 'SDL_KeyboardEvent
                      '((type u32)
                        (reserved u32)
                        (timestamp u64)
                        (windowID u32)
                        (which u32)
                        (scancode u32)
                        (key u32)
                        (mod u16)
                        (raw u16)
                        (down bool)
                        (repeat bool))))

(def SDL_MouseMotionEvent
  (ffi/define-struct! 'SDL_MouseMotionEvent
                      '((type u32)
                        (reserved u32)
                        (timestamp u64)
                        (windowID u32)
                        (which u32)
                        (state u32)
                        (x float)
                        (y float)
                        (xrel float)
                        (yrel float))))

(def SDL_TextInputEvent
  (ffi/define-struct! 'SDL_TextInputEvent '((type u32) (reserved u32) (timestamp u64) (windowID u32) (text pointer))))

(def SDL_Rect (ffi/define-struct! 'SDL_Rect '((x int) (y int) (w int) (h int))))

(def SDL_WindowEvent
  (ffi/define-struct! 'SDL_WindowEvent
                      '((type u32) (reserved u32) (timestamp u64) (windowID u32) (data1 i32) (data2 i32))))

(def SDL_MouseButtonEvent
  (ffi/define-struct! 'SDL_MouseButtonEvent
                      '((type u32)
                        (reserved u32)
                        (timestamp u64)
                        (windowID u32)
                        (which u32)
                        (button u8)
                        (down bool)
                        (clicks u8)
                        (padding u8)
                        (x float)
                        (y float))))

(def SDL_MouseWheelEvent
  (ffi/define-struct! 'SDL_MouseWheelEvent
                      '((type u32)
                        (reserved u32)
                        (timestamp u64)
                        (windowID u32)
                        (which u32)
                        (x float)
                        (y float)
                        (direction u32)
                        (mouse_x float)
                        (mouse_y float)
                        (integer_x i32)
                        (integer_y i32))))

(def SDL_Event
  (ffi/define-union! 'SDL_Event
                     (list (list 'type 'u32)
                           (list 'common SDL_CommonEvent)
                           (list 'key SDL_KeyboardEvent)
                           (list 'motion SDL_MouseMotionEvent)
                           (list 'text SDL_TextInputEvent)
                           (list 'window SDL_WindowEvent)
                           (list 'button SDL_MouseButtonEvent)
                           (list 'wheel SDL_MouseWheelEvent)
                           (list 'padding '(array u8 128)))))

(sdl-verify-layouts!)

(def sdl-library (ffi/open-library sdl-library-names))

(def SDL_GetVersion (ffi/bind sdl-library "SDL_GetVersion" '() 'int #t))

(def SDL_SetMainReady (ffi/bind sdl-library "SDL_SetMainReady" '() 'void #t))

(def SDL_Init (ffi/bind sdl-library "SDL_Init" '(u32) 'bool #t))

(def SDL_Quit (ffi/bind sdl-library "SDL_Quit" '() 'void #t))

(def SDL_WasInit (ffi/bind sdl-library "SDL_WasInit" '(u32) 'u32 #t))

(def SDL_GetError (ffi/bind sdl-library "SDL_GetError" '() 'utf8 #t))

(def SDL_ClearError (ffi/bind sdl-library "SDL_ClearError" '() 'bool #t))

(def SDL_CreateWindow (ffi/bind sdl-library "SDL_CreateWindow" '(utf8 int int u64) 'pointer #t))

(def SDL_DestroyWindow (ffi/bind sdl-library "SDL_DestroyWindow" '(pointer) 'void #t))

(def SDL_SetWindowTitle (ffi/bind sdl-library "SDL_SetWindowTitle" '(pointer utf8) 'bool #t))

(def SDL_CreateRenderer (ffi/bind sdl-library "SDL_CreateRenderer" '(pointer utf8) 'pointer #t))

(def SDL_DestroyRenderer (ffi/bind sdl-library "SDL_DestroyRenderer" '(pointer) 'void #t))

(def SDL_GetRendererName (ffi/bind sdl-library "SDL_GetRendererName" '(pointer) 'utf8 #t))

(def SDL_SetRenderLogicalPresentation
  (ffi/bind sdl-library "SDL_SetRenderLogicalPresentation" '(pointer int int u32) 'bool #t))

(def SDL_SetRenderVSync (ffi/bind sdl-library "SDL_SetRenderVSync" '(pointer int) 'bool #t))

(def SDL_SetRenderDrawColor (ffi/bind sdl-library "SDL_SetRenderDrawColor" '(pointer u8 u8 u8 u8) 'bool #t))

(def SDL_RenderClear (ffi/bind sdl-library "SDL_RenderClear" '(pointer) 'bool #t))

(def SDL_RenderFillRect (ffi/bind sdl-library "SDL_RenderFillRect" '(pointer pointer) 'bool #t))

(def SDL_RenderLine (ffi/bind sdl-library "SDL_RenderLine" '(pointer float float float float) 'bool #t))

(def SDL_RenderDebugText (ffi/bind sdl-library "SDL_RenderDebugText" '(pointer float float utf8) 'bool #t))

(def SDL_RenderPresent (ffi/bind sdl-library "SDL_RenderPresent" '(pointer) 'bool #t))

(def SDL_RenderReadPixels (ffi/bind sdl-library "SDL_RenderReadPixels" '(pointer pointer) 'pointer #t))

(def SDL_SaveBMP (ffi/bind sdl-library "SDL_SaveBMP" '(pointer utf8) 'bool #t))

(def SDL_DestroySurface (ffi/bind sdl-library "SDL_DestroySurface" '(pointer) 'void #t))

(def SDL_ReadSurfacePixel
  (ffi/bind sdl-library "SDL_ReadSurfacePixel" '(pointer int int pointer pointer pointer pointer) 'bool #t))

(def SDL_CreateTexture (ffi/bind sdl-library "SDL_CreateTexture" '(pointer u32 u32 int int) 'pointer #t))

(def SDL_UpdateTexture (ffi/bind sdl-library "SDL_UpdateTexture" '(pointer pointer pointer int) 'bool #t))

(def SDL_DestroyTexture (ffi/bind sdl-library "SDL_DestroyTexture" '(pointer) 'void #t))

(def SDL_RenderTexture (ffi/bind sdl-library "SDL_RenderTexture" '(pointer pointer pointer pointer) 'bool #t))

(def SDL_PollEvent (ffi/bind sdl-library "SDL_PollEvent" '(pointer) 'bool #t))

(def SDL_PushEvent (ffi/bind sdl-library "SDL_PushEvent" '(pointer) 'bool #t))

(def SDL_GetTicksNS (ffi/bind sdl-library "SDL_GetTicksNS" '() 'u64 #t))

(def SDL_Delay (ffi/bind sdl-library "SDL_Delay" '(u32) 'void #t))

(def SDL_StartTextInput (ffi/bind sdl-library "SDL_StartTextInput" '(pointer) 'bool #t))

(def SDL_OpenAudioDeviceStream
  (ffi/bind sdl-library "SDL_OpenAudioDeviceStream" '(u32 pointer callback-pointer pointer) 'pointer #t))

(def SDL_DestroyAudioStream (ffi/bind sdl-library "SDL_DestroyAudioStream" '(pointer) 'void #t))

(def SDL_PutAudioStreamData (ffi/bind sdl-library "SDL_PutAudioStreamData" '(pointer pointer int) 'bool #t))

(def SDL_GetAudioStreamQueued (ffi/bind sdl-library "SDL_GetAudioStreamQueued" '(pointer) 'int #t))

(def SDL_ResumeAudioStreamDevice (ffi/bind sdl-library "SDL_ResumeAudioStreamDevice" '(pointer) 'bool #t))

(if (or (< (SDL_GetVersion) 3004012) (not (= (quotient (SDL_GetVersion) 1000000) 3)))
    (sdl-abi-error "SDL runtime must be major 3 and >= 3.4.12")
    #f)

(def SDL_StopTextInput (ffi/bind sdl-library "SDL_StopTextInput" '(pointer) 'bool #t))
