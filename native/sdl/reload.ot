;; Status publishing uses libc; source reads use the common file API.
(def host-libc (ffi/open-library host-libc-names))

(def host-fopen (ffi/bind host-libc "fopen" '(utf8 utf8) 'pointer #t))

(def host-fclose (ffi/bind host-libc "fclose" '(pointer) 'int #t))

(def source-text read-file)

(def scene-observed #f)

(def scene-reloads 0)

(def scene-reload-errors 0)

(def scene-render-errors 0)

(def scene-broken? #f)

(def scene-ticks 0)

(def scene-phase 0.0)

(def (render! elapsed dt)
  (clear! 45 17 28))

(def (reload-scene! force?)
  (try
    (let ((source (source-text scene-path)))
      (if (or force? (not (equal? source scene-observed)))
          (begin
            (set! scene-observed source)
            (eval (host-read (string-append "(begin\n" source "\n)")))
            (set! scene-reloads (+ scene-reloads 1))
            (set! scene-broken? #f)
            (display "reload ")
            (display scene-reloads)
            (newline))
          #f))
    (catch ((fn (c) #t) c)
      (set! scene-reload-errors (+ scene-reload-errors 1))
      (display "RELOAD ERROR / fix source and save: ")
      (display c)
      (newline))))

(def (render-scene! elapsed dt)
  (if scene-broken?
      (clear! 45 17 28)
      (try
        (render! elapsed dt)
        (catch ((fn (c) #t) c)
          (set! scene-broken? #t)
          (set! scene-render-errors (+ scene-render-errors 1))
          (display "RENDER ERROR / fix source and save: ")
          (display c)
          (newline)))))

;; Status is optional and published atomically, after each completed frame.
(def host-fputs (ffi/bind host-libc "fputs" '(utf8 pointer) 'int #t))

(def host-rename (ffi/bind host-libc "rename" '(utf8 utf8) 'int #t))

(def (frame-status! frames window renderer)
  (and status-path
       (let ((temporary (str status-path ".tmp"))
             (file (host-fopen temporary "wb")))
         (when (ffi/null? file) (error "Cannot write SDL status"))
         (defer
           (let ((text (str (string-join " "
                                         (list frames
                                               scene-ticks
                                               scene-reloads
                                               scene-reload-errors
                                               scene-render-errors
                                               (if (ffi/pointer=? window sdl-window)
                                                   1
                                                   0)
                                               (if (ffi/pointer=? renderer sdl-renderer)
                                                   1
                                                   0)))
                            "\n")))
             (when (< (host-fputs text file) 0) (error "Cannot write SDL status")))
           (host-fclose file))
         (unless (= 0 (host-rename temporary status-path)) (error "Cannot publish SDL status"))
         #t)))
