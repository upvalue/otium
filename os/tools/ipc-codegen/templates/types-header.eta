#pragma once
#include "ot/common.h"
#include "ot/user/string.hpp"
#include "ot/user/vector.hpp"
#include "ot/lib/string-view.hpp"
#include "ot/lib/array-view.hpp"
#include "ot/lib/buffer-view.hpp"
#include "ot/lib/mpack/mpack-reader.hpp"
#include "ot/lib/mpack/mpack-writer.hpp"
#include "ot/lib/result.hpp"
#include "ot/lib/error-codes.hpp"
#include "ot/user/gen/message-types.hpp"

// Auto-generated types for <%= it.service.name %> service

<% it.service.methods.forEach(method => { %>
<% if (method.returns.length > 1) { %>
struct <%= it.toPascalCase(method.name) %>Result {
<% method.returns.forEach(ret => { %>
  <%= it.getType(ret, true) %> <%= ret.name %>;
<% }) %>
};

<% } %>
<% }) %>
