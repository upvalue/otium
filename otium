#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1-}" in
    attach|mcp)
        PYTHONPATH="$root/tools" exec "${PYTHON:-python3}" -m otium_tools.client "$@" ;;
    fmt)
        shift
        set -- --no-project "$root/lib/otium/tools/fmt.ot" -- "$@" ;;
    lint|explain|compile)
        tool=$1
        shift
        set -- "$root/lib/otium/tools/$tool.ot" -- "$@" ;;
esac
# Builds are per machine type, so a checkout synced between machines keeps one
# for each. Exported so programs find native libraries in the same build.
OTIUM_BUILD=${OTIUM_BUILD:-$root/build/$(uname -m)-$(uname -s | tr A-Z a-z)/default}
export OTIUM_BUILD
binary=$OTIUM_BUILD/otium
if [ ! -x "$binary" ]; then
    printf 'otium: %s is missing; run just build\n' "$binary" >&2
    exit 127
fi
exec "$binary" "$@"
