# The LLVM toolchain file in cross/: homebrew on macOS, llvm-21 elsewhere.
# Pick another with `just toolchain=NAME build`.
toolchain := if os() == "macos" { "homebrew" } else { "llvm-21" }

# Configure and build the kernel
build:
    @test -d build || meson setup build --cross-file=cross/cortex-m33.txt --cross-file=cross/{{toolchain}}.txt
    meson compile -C build

# Build and boot on QEMU's mps2-an505; the console is this terminal
run: build
    qemu-system-arm -machine mps2-an505 -nographic -no-reboot -kernel build/otos.elf
