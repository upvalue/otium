# The LLVM toolchain file in cross/: homebrew on macOS, llvm-21 elsewhere.
# Pick another with `just toolchain=NAME build`.
toolchain := if os() == "macos" { "homebrew" } else { "llvm-21" }

# Configure and build the kernel
build:
    @test -d build || meson setup build --cross-file=cross/riscv32.txt --cross-file=cross/{{toolchain}}.txt
    meson compile -C build

# Build and boot in QEMU; output goes to this terminal
run: build
    qemu-system-riscv32 -machine virt -m 256M -bios default -nographic -no-reboot -kernel build/otos.elf

# Boot with a virtio-gpu display window; the REPL stays in this terminal
run-display: build
    qemu-system-riscv32 -machine virt -m 256M -bios default -no-reboot -kernel build/otos.elf -serial mon:stdio -device virtio-gpu-device -global virtio-mmio.force-legacy=false
