# Configure and build the kernel
build:
    @test -d build || meson setup build --cross-file=cross/riscv32.txt
    meson compile -C build

# Build and boot in QEMU; output goes to this terminal
run: build
    qemu-system-riscv32 -machine virt -m 256M -bios default -nographic -no-reboot -kernel build/otos.elf
