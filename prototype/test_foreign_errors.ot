(require otium.ffi :as ffi)
(require otium.test :refer (check report))

(def (error-fields thunk)
  (try (begin (thunk) 'no-error)
       (catch (ffi/error? c)
         (list (ffi/error-operation c) (ffi/error-reason c)
               (ffi/error-argument c) (ffi/error-expected-type c)))))
(def bytes (ffi/alloc 'u8 8))
(check '(ref null 0 pointer) (error-fields (fn () (ffi/ref ffi/null 'u8 0))))
(check '(ref type 1 #f) (error-fields (fn () (ffi/ref bytes 'nonsense 0))))
(check '(ref range 2 size-t) (error-fields (fn () (ffi/ref bytes 'u8 -1))))
(check '(set! range 3 u8) (error-fields (fn () (ffi/set! bytes 'u8 0 256))))
(check '(set! type 3 bool) (error-fields (fn () (ffi/set! bytes 'bool 0 1))))
(check '(alloc range 1 size-t) (error-fields (fn () (ffi/alloc 'u8 -1))))
(check '(sizeof type 0 #f) (error-fields (fn () (ffi/sizeof 'void))))
(check '(alignof type 0 #f) (error-fields (fn () (ffi/alignof 'utf8))))
(check '(view type 1 size-t) (error-fields (fn () (ffi/view bytes #f 1))))
(check '(view range 2 size-t) (error-fields (fn () (ffi/view bytes 0 -1))))
(check '(view bounds 0 pointer) (error-fields (fn () (ffi/view bytes 0 9))))
(check '(copy! type 1 pointer) (error-fields (fn () (ffi/copy! bytes #f 1))))
(check '(copy! bounds 1 pointer) (error-fields (fn () (ffi/copy! bytes (ffi/view bytes 0 1) 2))))
(check '(copy! bounds 0 pointer) (error-fields (fn () (ffi/copy! (ffi/view bytes 0 1) bytes 2))))
(check '(copy! range 2 size-t) (error-fields (fn () (ffi/copy! bytes bytes -1))))
(check '(read-bytes type 1 size-t) (error-fields (fn () (ffi/read-bytes bytes #f))))
(check '(write-bytes! type 1 #f) (error-fields (fn () (ffi/write-bytes! bytes "no"))))
(check '(write-bytes! range 2 size-t) (error-fields (fn () (ffi/write-bytes! bytes #u8(1) 2))))
(check '(write-bytes! range 3 size-t) (error-fields (fn () (ffi/write-bytes! bytes #u8(1) 0 2))))
(check '(read-utf8 range 1 size-t) (error-fields (fn () (ffi/read-utf8 bytes -1))))
(ffi/set! bytes 'u8 0 255)
(check '(read-utf8-bytes encoding 0 pointer) (error-fields (fn () (ffi/read-utf8-bytes bytes 1))))
(check '(alloc-utf8 type 0 utf8) (error-fields (fn () (ffi/alloc-utf8 #f))))
(check '(free! type 0 pointer) (error-fields (fn () (ffi/free! #f))))
(check '(pointer=? type 1 pointer) (error-fields (fn () (ffi/pointer=? bytes #f))))
(def Record (ffi/define-struct! 'Record '((a u8))))
(check '(field-ref null 0 pointer) (error-fields (fn () (ffi/field-ref ffi/null Record '(a)))))
(check '(field-set! range 3 u8) (error-fields (fn () (ffi/field-set! bytes Record '(a) 256))))
(check '(field-view null 0 pointer) (error-fields (fn () (ffi/field-view ffi/null Record '(a)))))
(check '(offset-of type 1 #f) (error-fields (fn () (ffi/offset-of Record '(missing)))))
(check '(field-ref type 2 #f) (error-fields (fn () (ffi/field-ref bytes Record '(missing)))))
(ffi/free! bytes)
(check '(read-bytes released 0 pointer) (error-fields (fn () (ffi/read-bytes bytes 1))))

;; Candidate diagnostics must survive beyond the runtime's short display buffer.
(def missing (string-append "/no-such-library/" (apply string (map (fn (i) #\x) (range 300)))))
(def missing-last "/no-such-library/final-candidate")
(check #t
       (try (ffi/open-library (list missing missing-last))
            (catch (ffi/error? c)
              (and (eq? 'load (ffi/error-reason c))
                   (eq? 'open-library (ffi/error-operation c))
                   (contains? (condition-message c) missing)
                   (contains? (condition-message c) missing-last)))))
(check 0 (ffi/allocation-count))
(report "ffi error metadata")
