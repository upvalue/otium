;; Loaded after the public ownership suite, with collection at every allocation.
(def destroyed 0)
(def storage (ffi/alloc 'u8 8))
(def managed (ffi/own storage (fn (p) (set! destroyed (+ destroyed 1)) (ffi/free! p))))
(def derived (ffi/view managed 1 4))
(check #t (resource-closable? managed))
(check #f (resource-closable? derived))
(check #f (resource-closable? ffi/null))
(check #t (fails? (fn () (ffi/free! derived))))
(ffi/free! managed)
(check 1 destroyed)
(check #t (fails? (fn () (ffi/ref derived 'u8 0))))
(ffi/free! managed)
(check 1 destroyed)

(def reentrant nil)
(set! reentrant (ffi/own ffi/null (fn (p) (set! destroyed (+ destroyed 1)) (close reentrant nil))))
(close reentrant nil)
(check 2 destroyed)
(check #t (fails? (fn () (ffi/own ffi/null 42))))
(check #t (fails? (fn () (ffi/own managed (fn (p) nil)))))
(check 0 (ffi/allocation-count))
