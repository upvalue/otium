(require otium.ffi :as ffi)
(require otium.thread :as thread :refer (spawn receive))
(require otium.actor :as actor)
(def lib (ffi/open-library (list "/tmp/otium-conditions-review-build/ffi-fixture-17.so")))
(def invoke (ffi/bind lib "call_n" '(callback-pointer int) 'int #t))
(for-each (fn (payload)
  (let ((cb (ffi/callback '(int) 'int (fn (x) (error payload)))))
    (println :ffi payload (try (list :returned (invoke cb 1)) (catch c (list :caught c))))
    (ffi/free-callback! cb))
  (println :actor payload (try (list :returned (actor/call (spawn (fn () (receive (:call _ (error payload))))) 'x)) (catch c (list :caught c)))))
  (list nil #f 42))
(def cb (ffi/callback '(int) 'int (fn (x) (if (= x 0) (error nil) (error 'second)))))
(println :ffi-first-error (try (invoke cb 2) (catch c c)))
(ffi/free-callback! cb)
