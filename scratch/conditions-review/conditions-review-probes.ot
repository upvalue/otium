(require otium.ffi :as ffi)
(require otium.thread :as thread :refer (spawn receive))
(require otium.actor :as actor)
(def lib (ffi/open-library (list "/tmp/otium-conditions-review-build/ffi-fixture-17.so")))
(def invoke (ffi/bind lib "call_n" '(callback-pointer int) 'int #t))
(def cb (ffi/callback '(int) 'int (fn (x) (error nil))))
(println :ffi-nil (try (list :returned (invoke cb 1)) (catch c (list :caught c))))
(ffi/free-callback! cb)
(println :actor-nil (try (list :returned (actor/call (spawn (fn () (receive (:call _ (error nil))))) 'x)) (catch c (list :caught c))))
(println :timeout-subtype (condition-of-type? (thread/timeout-condition "probe") 'error))
(println :thread-subtype (try (thread/join (spawn (fn () (error "probe")))) (catch c (list (condition-type c) (condition-of-type? c 'error)))))
(defrecord ProbeCondition (type message))
(def pc (record-new ProbeCondition 'error "record condition"))
(println :record-condition (try (error pc) (catch c (list (eq? c pc) (error? c) (condition-message c)))))
(println :caught-location (try (car 42) (catch c c)))
