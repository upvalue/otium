;; Closure conversion: hand-written IR in, printed IR out. Every output must
;; pass the verifier's :closed stage.
(require (otium.test :refer (check report))
         (otium.compiler.closures :as closures)
         (otium.compiler.core :as core)
         (otium.compiler.ir-text :as text)
         (otium.compiler.verify :as verify))

(def- (closed datum)
  "datum read, checked as converted IR, closure-converted, checked as closed IR and printed."
  (let ((x (text/read datum)))
    (verify/check x :converted)
    (let ((y (closures/run x)))
      (verify/check y :closed)
      (text/print y))))

(check "a nested lambda capturing a parameter, explicit closure operands"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "make-adder"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (return v2)))
            (fn f2
              "add"
              :parent f1
              :params (v3)
              :signature (1 0 #f)
              :entry b2
              (b2 () (v4 env-ref :aux 0) (v5 + v3 v4) (return v5))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "make-adder"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure v1 :aux f2) (return v2)))
                    (fn f2
                      "add"
                      :parent f1
                      :params (v3)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (v4 + v3 v1) (return v4))))))

(check "a capture through two levels"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (return v2)))
            (fn f2
              "middle"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 () (v3 env-ref :aux 0) (v4 const 1) (v5 make-closure v3 v4 :aux f3) (return v5)))
            (fn f3
              "inner"
              :parent f2
              :params ()
              :signature (0 0 #f)
              :entry b3
              (b3 () (v6 env-ref :aux 0) (v7 env-ref :aux 1) (v8 + v6 v7) (return v8))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (return v2)))
                    (fn f2
                      "middle"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (v3 const 1) (v4 closure :aux f3) (return v4)))
                    (fn f3
                      "inner"
                      :parent f2
                      :params ()
                      :signature (0 0 #f)
                      :entry b3
                      (b3 () (v5 + v1 v3) (return v5))))))

(check "no free variables: static"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params ()
              :signature (0 0 #f)
              :entry b1
              (b1 () (v1 static-closure :aux f2) (return v1)))
            (fn f2
              "constant"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 () (v2 const 7) (return v2))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params ()
                      :signature (0 0 #f)
                      :entry b1
                      (b1 () (v1 closure :aux f2) (return v1)))
                    (fn f2
                      "constant"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (v2 const 7) (return v2))))))

(check "facts and names carry over to env-refs"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params ((v1 :name n :fact (fixnum 0 10)))
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (return v2)))
            (fn f2
              "inner"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 () (v3 env-ref :aux 0 :name n :fact (fixnum 0 10)) (return v3))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params ((v1 :name n :fact (fixnum 0 10)))
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (return v2)))
                    (fn f2
                      "inner"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (return v1))))))

(check "a well-known function takes its free variables as parameters"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1 v2)
              :signature (2 0 #f)
              :entry b1
              (b1 () (v3 static-closure :aux f2) (v4 const 3) (call known f2 (v1 v2 v4) b2))
              (b2 (v5) (tail-call known f2 (v1 v2 v5))))
            (fn f2
              "helper"
              :parent f1
              :params (v6 v7 v8)
              :signature (3 0 #f)
              :entry b3
              (b3 () (v9 + v8 v6) (v10 + v9 v7) (return v10))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1 v2)
                      :signature (2 0 #f)
                      :entry b1
                      (b1 () (v3 closure :aux f2) (v4 const 3) (call known f2 (v4) b2))
                      (b2 (v5) (tail-call known f2 (v5))))
                    (fn f2
                      "helper"
                      :parent f1
                      :params (v6)
                      :signature (1 0 #f)
                      :entry b3
                      (b3 () (v7 + v6 v1) (v8 + v7 v2) (return v8))))))

(check "a lifted function calling itself passes its own extra parameters"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 const 10) (tail-call known f2 (v1 v2))))
            (fn f2
              "loop"
              :parent f1
              :params (v3 v4)
              :signature (2 0 #f)
              :entry b2
              (b2 () (v5 const 0) (branch-prim = (v4 v5) b4 b3))
              (b3 () (v6 const 1) (v7 - v4 v6) (tail-call known f2 (v3 v7)))
              (b4 () (return v3))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 const 10) (tail-call known f2 (v2))))
                    (fn f2
                      "loop"
                      :parent f1
                      :params (v3)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (v4 const 0) (branch-prim = (v3 v4) b3 b4))
                      (b3 () (return v1))
                      (b4 () (v5 const 1) (v6 - v3 v5) (tail-call known f2 (v6)))))))

(check "a jump to a lifted function's entry passes the extra parameters"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 const 3) (tail-call known f2 (v1 v2))))
            (fn f2
              "loop"
              :parent f1
              :params (v3 v4)
              :signature (2 0 #f)
              :entry b2
              (b2 () (branch v4 b4 b3))
              (b3 () (return v3))
              (b4 () (v5 const #f) (jump b2 v3 v5))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 const 3) (tail-call known f2 (v2))))
                    (fn f2
                      "loop"
                      :parent f1
                      :params (v3)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (branch v3 b3 b4))
                      (b3 () (v4 const #f) (jump b2 v4))
                      (b4 () (return v1))))))

(check "a lifted function's caller captures what it passes"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 static-closure :aux f2) (v3 make-closure v1 :aux f3) (return v3)))
            (fn f2
              "helper"
              :parent f1
              :params (v4 v5)
              :signature (2 0 #f)
              :entry b2
              (b2 () (v6 + v5 v4) (return v6)))
            (fn f3
              "user"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b3
              (b3 () (v7 env-ref :aux 0) (v8 const 2) (tail-call known f2 (v7 v8)))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (v3 closure :aux f3) (return v3)))
                    (fn f2
                      "helper"
                      :parent f1
                      :params (v4)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (v5 + v4 v1) (return v5)))
                    (fn f3
                      "user"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b3
                      (b3 () (v6 const 2) (tail-call known f2 (v6)))))))

(check "a well-known function with five free variables keeps its closure"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1 v2 v3 v4 v5)
              :signature (5 0 #f)
              :entry b1
              (b1 () (v6 make-closure v1 v2 v3 v4 v5 :aux f2) (tail-call value v6 ())))
            (fn f2
              "helper"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 ()
                  (v7 env-ref :aux 0)
                  (v8 env-ref :aux 1)
                  (v9 env-ref :aux 2)
                  (v10 env-ref :aux 3)
                  (v11 env-ref :aux 4)
                  (v12 + v7 v8)
                  (v13 + v12 v9)
                  (v14 + v13 v10)
                  (v15 + v14 v11)
                  (return v15))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1 v2 v3 v4 v5)
                      :signature (5 0 #f)
                      :entry b1
                      (b1 () (v6 closure :aux f2) (tail-call known f2 ())))
                    (fn f2
                      "helper"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (v7 + v1 v2) (v8 + v7 v3) (v9 + v8 v4) (v10 + v9 v5) (return v10))))))

(check "without a closure to call, the parent makes one at the call"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1 v2 v3 v4 v5)
              :signature (5 0 #f)
              :entry b1
              (b1 () (v6 make-closure v1 v2 v3 v4 v5 :aux f2) (tail-call value v6 ())))
            (fn f2
              "helper"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 ()
                  (v7 env-ref :aux 0)
                  (v8 env-ref :aux 1)
                  (v9 env-ref :aux 2)
                  (v10 env-ref :aux 3)
                  (v11 env-ref :aux 4)
                  (v12 + v7 v8)
                  (v13 + v12 v9)
                  (v14 + v13 v10)
                  (v15 + v14 v11)
                  (return v15))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1 v2 v3 v4 v5)
                      :signature (5 0 #f)
                      :entry b1
                      (b1 () (tail-call known f2 ())))
                    (fn f2
                      "helper"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (v7 + v1 v2) (v8 + v7 v3) (v9 + v8 v4) (v10 + v9 v5) (return v10))))))

(check "a known call to a function with captures becomes a value call"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (v3 const 1) (call value v2 (v3) b2))
              (b2 (v4) (v5 cons v4 v2) (return v5)))
            (fn f2
              "add"
              :parent f1
              :params (v6)
              :signature (1 0 #f)
              :entry b3
              (b3 () (v7 env-ref :aux 0) (v8 + v6 v7) (return v8))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (v3 const 1) (call known f2 (v3) b2))
                      (b2 (v4) (v5 cons v4 v2) (return v5)))
                    (fn f2
                      "add"
                      :parent f1
                      :params (v6)
                      :signature (1 0 #f)
                      :entry b3
                      (b3 () (v7 + v6 v1) (return v7))))))

(check "a known call from a nested function captures the callee's closure"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (v3 make-closure v2 :aux f3) (v4 cons v2 v3) (return v4)))
            (fn f2
              "add"
              :parent f1
              :params (v5)
              :signature (1 0 #f)
              :entry b2
              (b2 () (v6 env-ref :aux 0) (v7 + v5 v6) (return v7)))
            (fn f3
              "user"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b3
              (b3 () (v8 env-ref :aux 0) (v9 const 2) (tail-call value v8 (v9)))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (v3 closure :aux f3) (v4 cons v2 v3) (return v4)))
                    (fn f2
                      "add"
                      :parent f1
                      :params (v5)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (v6 + v5 v1) (return v6)))
                    (fn f3
                      "user"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b3
                      (b3 () (v7 const 2) (tail-call known f2 (v7)))))))

(check "a known call to itself with captures calls self"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 make-closure v1 :aux f2) (return v2)))
            (fn f2
              "loop"
              :parent f1
              :params (v3)
              :signature (1 0 #f)
              :entry b2
              (b2 () (v4 env-ref :aux 0) (branch v3 b4 b3))
              (b3 () (v5 self) (tail-call value v5 (v4)))
              (b4 () (return v4))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (return v2)))
                    (fn f2
                      "loop"
                      :parent f1
                      :params (v3)
                      :signature (1 0 #f)
                      :entry b2
                      (b2 () (branch v3 b3 b4))
                      (b3 () (return v1))
                      (b4 () (tail-call known f2 (v1)))))))

(check "a function both called and passed as a value"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 static-closure :aux f2) (call known f2 (v1) b2))
              (b2 (v3) (v4 cons v3 v2) (return v4)))
            (fn f2
              "twice"
              :parent f1
              :params (v5)
              :signature (1 0 #f)
              :entry b3
              (b3 () (v6 + v5 v5) (return v6))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 closure :aux f2) (call known f2 (v1) b2))
                      (b2 (v3) (v4 cons v3 v2) (return v4)))
                    (fn f2
                      "twice"
                      :parent f1
                      :params (v5)
                      :signature (1 0 #f)
                      :entry b3
                      (b3 () (v6 + v5 v5) (return v6))))))

(check "self inside a nested function"
       '(ir (fn f0
              "top"
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 static-closure :aux f1) (return v0)))
            (fn f1
              "outer"
              :parent f0
              :params (v1)
              :signature (1 0 #f)
              :entry b1
              (b1 () (v2 self) (v3 make-closure v1 v2 :aux f2) (return v3)))
            (fn f2
              "inner"
              :parent f1
              :params ()
              :signature (0 0 #f)
              :entry b2
              (b2 () (v4 env-ref :aux 0) (v5 env-ref :aux 1) (v6 self) (v7 cons v5 v6) (v8 cons v4 v7) (return v8))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params ()
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 closure :aux f1) (return v0)))
                    (fn f1
                      "outer"
                      :parent f0
                      :params (v1)
                      :signature (1 0 #f)
                      :entry b1
                      (b1 () (v2 self) (v3 closure :aux f2) (return v3)))
                    (fn f2
                      "inner"
                      :parent f1
                      :params ()
                      :signature (0 0 #f)
                      :entry b2
                      (b2 () (v4 self) (v5 cons v2 v4) (v6 cons v1 v5) (return v6))))))

(check "functions nothing creates are dropped"
       '(ir (fn f0
              "top"
              :parent nil
              :params (v0)
              :signature (1 0 #f)
              :entry b0
              (b0 () (return v0))))
       (closed '(ir (fn f0
                      "top"
                      :parent nil
                      :params (v0)
                      :signature (1 0 #f)
                      :entry b0
                      (b0 () (return v0)))
                    (fn f1
                      "dead"
                      :parent f0
                      :params ()
                      :signature (0 0 #f)
                      :entry b1
                      (b1 () (return v0))))))

;; A known call needing a closure that neither the caller, an enclosing
;; function, nor the callee's parent can provide.
(check "a known call with no closure in reach is unsupported"
       #t
       (try
         (begin
           (closed '(ir (fn f0
                          "top"
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v0 closure :aux f1) (return v0)))
                        (fn f1
                          "outer"
                          :parent f0
                          :params (v1 v2 v3 v4 v5)
                          :signature (5 0 #f)
                          :entry b1
                          (b1 () (v6 closure :aux f3) (return v6)))
                        (fn f2
                          "helper"
                          :parent f1
                          :params ()
                          :signature (0 0 #f)
                          :entry b2
                          (b2 () (v7 + v1 v2) (v8 + v7 v3) (v9 + v8 v4) (v10 + v9 v5) (return v10)))
                        (fn f3
                          "user"
                          :parent f1
                          :params ()
                          :signature (0 0 #f)
                          :entry b3
                          (b3 () (tail-call known f2 ())))))
           #f)
         (catch (error? c) (core/unsupported? c))))

(report "closures")
