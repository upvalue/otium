;; lint: allow-file(unbound-name) %resolve-global, %cell-info and %set-optimizer! are C runtime builtins
;; lint: allow-file(captured-binding) expected IR is data that looks like fn forms
;; lint: allow-file(rest-arguments) expected IR looks like fn forms, and interpreted closures take any arguments
;; Convert: Core to the block IR.
(require (otium.test :refer (check report))
         (otium.compiler.core :as core)
         (otium.compiler.inline :as inline)
         (otium.compiler.convert :as convert)
         (otium.compiler.ir :as ir)
         (otium.compiler.ir-text :as ir-text)
         (otium.compiler.verify :as verify))

(def- (core-of text &optional (inline? #t))
  (let ((c (core/resolve (macroexpand-all (read-string text)) 'user)))
    (if inline?
        (inline/run c)
        c)))

(def- (converted text &optional (inline? #t))
  ;; The verified IR for source text.
  (let ((x (convert/run (core-of text inline?))))
    (verify/check x :converted)
    x))

(def- (dump text &optional (inline? #t))
  (ir-text/print (converted text inline?)))

(def- (inner text &optional (inline? #t))
  ;; The printed functions after the entry, for a text that is one fn.
  (cdr (cdr (dump text inline?))))

(def- (op-codes text)
  ;; Every operation's code, in creation order.
  (let ((x (converted text))) (map (fn (o) (ir/op-code x o)) (array-to-list (range (ir/op-count x))))))

(def- (cell sym)
  (%resolve-global 'user sym))

;; --- shapes ----------------------------------------------------------------

(check "constant"
       '(ir (fn f0
              nil
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 const 1) (return v0))))
       (dump "1"))

(check "named let in tail position is a loop with block parameters"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name n))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 0) (v3 const 0) (jump b2 v2 v3))
           (b2 ((v4 :name i) (v5 :name acc)) (branch-prim < (v4 v1) b3 b4))
           (b3 () (v6 refine v4 :aux 3 :name i) (v7 const 1) (v8 + v6 v7) (v9 + v5 v6) (jump b2 v8 v9))
           (b4 () (v10 refine v4 :aux 3 :name i) (return v5))))
       (inner "(fn (n) (let loop ((i 0) (acc 0)) (if (< i n) (loop (+ i 1) (+ acc i)) acc)))"))

(check "named let in value position returns to one place"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name n))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 1) (v3 const 0) (jump b2 v3))
           (b2 ((v4 :name i)) (branch-prim < (v4 v1) b3 b4))
           (b3 () (v5 refine v4 :aux 3 :name i) (v6 const 1) (v7 + v5 v6) (jump b2 v7))
           (b4 () (v8 refine v4 :aux 3 :name i) (v9 + v2 v8) (return v9))))
       (inner "(fn (n) (+ 1 (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i))))"))

(check "set! in both arms joins with a block parameter"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name x))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 0 :name y) (branch v1 b2 b3))
           (b2 () (v3 refine v1 :aux 65487 :name x) (v4 const 1) (v5 const nil) (jump b4 v4))
           (b3 () (v6 refine v1 :aux 48 :name x) (v7 const 2) (v8 const nil) (jump b4 v7))
           (b4 ((v9 :name y)) (return v9))))
       (inner "(fn (x) (let ((y 0)) (if x (set! y 1) (set! y 2)) y))"))

(check "a variable assigned in a contified loop is a loop parameter"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name xs))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 0 :name n) (jump b2 v1 v2))
           (b2 ((v3 :name xs) (v4 :name n)) (branch-prim pair? (v3) b3 b4))
           (b3 () (v5 refine v3 :aux 4 :name xs) (v6 const 1) (v7 + v4 v6) (v8 const nil) (v9 cdr v5) (jump b2 v9 v7))
           (b4 () (v10 refine v3 :aux 65531 :name xs) (v11 const nil) (return v4))))
       (inner "(fn (xs) (let ((n 0)) (let loop ((xs xs)) (when (pair? xs) (set! n (+ n 1)) (loop (cdr xs)))) n))"))

(check "a captured, assigned variable is a box"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name x))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 0 :name y) (v3 box v2 :name y) (v4 closure :aux f2) (return v4)))
         (fn f2
           nil
           :parent f1
           :params ()
           :signature (0 0 #f)
           :entry b2
           (b2 () (v5 box-ref v3) (v6 const 1) (v7 + v5 v6) (v8 box-set v3 v7) (v9 box-ref v3) (return v9))))
       (inner "(fn (x) (let ((y 0)) (fn () (set! y (+ y 1)) y)))"))

(check "refinement after pair?"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name x))
           :signature (1 0 #f)
           :entry b1
           (b1 () (branch-prim pair? (v1) b2 b3))
           (b2 () (v2 refine v1 :aux 4 :name x) (v3 car v2) (return v3))
           (b3 () (v4 refine v1 :aux 65531 :name x) (return v4))))
       (inner "(fn (x) (if (pair? x) (car x) x))"))

(check "optional parameter"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name a) (v2 :name b))
           :signature (1 1 #f)
           :entry b1
           (b1 () (v3 bound? v2) (branch v3 b2 b3))
           (b2 () (jump b4 v2))
           (b3 () (v4 const 2) (jump b4 v4))
           (b4 ((v5 :name b)) (v6 + v1 v5) (return v6))))
       (inner "(fn (a &optional (b 2)) (+ a b))"))

(check "rest parameter"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name a) (v2 :name r))
           :signature (1 0 #t)
           :entry b1
           (b1 () (return v2))))
       (inner "(fn (a . r) r)"))

(check "try with catch clauses"
       `((fn f1
           nil
           :parent f0
           :params ((v1 :name x))
           :signature (1 0 #f)
           :entry b1
           (b1 ()
               (try
                 b2
                 b3))
           (b2 () (call global ,(cell 'g) (v1) b4))
           (b3 ((v2 :name e)) (v3 string? v2) (branch v3 b5 b6))
           (b4 (v4) (v5 pop-try) (return v4))
           (b5 () (v6 const 1) (return v6))
           (b6 () (call global ,(cell 'error?) (v2) b7))
           (b7 (v7) (branch v7 b8 b9))
           (b8 () (v8 const 2) (return v8))
           (b9 () (v9 raise v2) (unreachable))))
       (inner "(fn (x) (try (g x) (catch (string? e) 1) (catch (error? e) 2)))"))

(check "a variable assigned in a try body is a box"
       '(box box-set box-ref)
       (filter (fn (c) (memq c '(box box-set box-ref)))
               (op-codes "(fn (x) (let ((y 0)) (try (begin (set! y 1) (car x)) (catch (string? e) y))))")))
(check "a variable assigned in a try body but bound inside it isn't"
       '()
       (filter (fn (c) (memq c '(box box-set box-ref)))
               (op-codes "(fn (x) (try (let ((y 0)) (set! y (car x)) y) (catch (string? e) 1)))")))

(check "defer"
       `((fn f1
           nil
           :parent f0
           :params ((v1 :name x))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 closure :aux f2) (v3 push-cleanup v2) (call global ,(cell 'g) (v1) b2))
           (b2 (v4) (v5 run-cleanup) (return v4)))
         (fn f2
           nil
           :parent f1
           :params ()
           :signature (0 0 #f)
           :entry b3
           (b3 () (tail-call global ,(cell 'h) (v1)))))
       (inner "(fn (x) (defer (g x) (h x)))"))

(check "while is a loop and gives nil"
       '((fn f1
           nil
           :parent f0
           :params ((v1 :name n))
           :signature (1 0 #f)
           :entry b1
           (b1 () (v2 const 0 :name i) (jump b2 v2))
           (b2 ((v3 :name i)) (branch-prim < (v3 v1) b3 b4))
           (b3 () (v4 refine v3 :aux 3 :name i) (v5 const 1) (v6 + v4 v5) (v7 const nil) (jump b2 v6))
           (b4 () (v8 refine v3 :aux 3 :name i) (v9 const nil) (return v9))))
       (inner "(fn (n) (let ((i 0)) (while (< i n) (set! i (+ i 1)))))"))

(check "top-level def gives its value"
       `(ir (fn f0
              nil
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 closure :aux f1) (v1 global-def v0 :aux ,(%global-cell 'user 'convert-test-f)) (return v0)))
            (fn f1
              "convert-test-f"
              :parent f0
              :params ((v2 :name x))
              :signature (1 0 #f)
              :entry b1
              (b1 () (return v2))))
       (dump "(def (convert-test-f x) x)"))

(check "global set! and global calls"
       `(ir (fn f0
              nil
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 ()
                  (v0 const 1)
                  (v1 global-set v0 :aux ,(cell 'some-global))
                  (v2 prim-ref :aux car)
                  (tail-call global ,(cell 'g) (v2)))))
       (dump "(begin (set! some-global 1) (g car))"))

(check "a call whose arguments may call reads the global first"
       `(ir (fn f0
              nil
              :parent nil
              :params ()
              :signature (0 0 #f)
              :entry b0
              (b0 () (v0 global-ref :aux ,(cell 'g)) (call global ,(cell 'h) () b1))
              (b1 (v1) (tail-call value v0 (v1)))))
       (dump "(g (h))"))

(check "escaping body functions: self and boxes"
       '((fn f1
           nil
           :parent f0
           :params ()
           :signature (0 0 #f)
           :entry b1
           (b1 ()
               (v1 unbound)
               (v2 box v1 :name odd)
               (v3 closure :aux f2 :name even)
               (v4 closure :aux f3 :name odd)
               (v5 box-set v2 v4)
               (v6 list v3 v4)
               (return v6)))
         (fn f2
           "even"
           :parent f1
           :params ((v7 :name n))
           :signature (1 0 #f)
           :entry b2
           (b2 () (v8 self) (branch-prim null? (v7) b3 b4))
           (b3 () (v9 refine v7 :aux 8 :name n) (v10 const #t) (return v10))
           (b4 () (v11 refine v7 :aux 65527 :name n) (v12 box-ref v2) (v13 cdr v11) (call value v12 (v13) b5))
           (b5 (v14) (v15 list v8 v14) (return v15)))
         (fn f3
           "odd"
           :parent f1
           :params ((v16 :name n))
           :signature (1 0 #f)
           :entry b6
           (b6 () (branch-prim null? (v16) b7 b8))
           (b7 () (v17 refine v16 :aux 8 :name n) (v18 const #f) (return v18))
           (b8 () (v19 refine v16 :aux 65527 :name n) (v20 cdr v19) (tail-call value v3 (v20)))))
       (inner "(fn () (def (even n) (if (null? n) #t (list even (odd (cdr n))))) (def (odd n) (if (null? n) #f (even (cdr n)))) (list even odd))"
              #f))

(check "a letrec value read before it is set checks"
       #t
       (not (not (memq 'check-bound (op-codes "(fn () (def x (list x)) x)")))))

(check "a test of a test" #t (not (nil? (converted "(fn (a b c) (if (if a b c) 1 2))"))))
(check "unsupported nodes raise"
       #t
       (try
         (convert/run {:op :mystery})
         (catch (core/unsupported? _) #t)))

;; Forms the runtime reads carry positions. Convert some through the
;; optimizer hook, declining to compile them.
(def- hooked [])

(%set-optimizer! (fn (form space)
                   (push! hooked
                          (try
                            (convert/run (inline/run (core/resolve form space)))
                            (catch e e)))
                   nil))

(def (convert-position-sample xs)
  (let loop ((xs xs)
             (n 0))
    (if (pair? xs)
        (loop (cdr xs) (+ n (g (car xs))))
        n)))

(%set-optimizer! nil)

(let ((x (hooked 0)))
  (check "the hook's form converts" #t (verify/check x :converted))
  (check "calls keep positions"
         '()
         (filter (fn (b) (and (memq (ir/term-kind x b) '(:call :tail-call)) (nil? (ir/term-pos x b))))
                 (array-to-list (range (ir/block-count x)))))
  (check "operations keep positions"
         '()
         (filter (fn (o) (and (not (memq (ir/op-code x o) '(refine))) (nil? (ir/op-pos x o))))
                 (array-to-list (range (ir/op-count x)))))
  (check "functions keep positions" '() (filter (fn (f) (nil? (ir/fn-pos x f))) (ir/functions x))))

;; --- running converted code ------------------------------------------------
;;
;; A small interpreter for converted IR, so the tests can check that a
;; program computes what the runtime computes. Values live in frames chained
;; to the frame that created the closure; nested functions use their
;; parents' values directly. Closures are real procedures, so builtins and
;; the runtime can call them.

(def- unbound-marker {:unbound #t})

(def- (global-value cell)
  (eval ((%cell-info cell) :name)))

;; Tables can't hold nil, so frames store this in its place.
(def- nil-marker {:nil #t})

(def- (frame-set! frame v x)
  (put! (frame :vals)
        v
        (if (nil? x)
            nil-marker
            x)))

(def- (frame-ref frame v)
  (let loop ((fr frame))
    (cond
      ((nil? fr) (error (str "interp: no value v" v)))
      ((contains? (fr :vals) v)
       (let ((x ((fr :vals) v)))
         (if (eq? x nil-marker)
             nil
             x)))
      (else (loop (fr :parent))))))

(def- (truthy? x)
  (not (or (nil? x) (eq? x #f))))

(def- (make-closure x f parent)
  (let ((proc nil))
    (set! proc (fn args (run-fn x f parent proc args)))
    proc))

(def- (run-fn x f parent proc args)
  (let ((sig (ir/fn-signature x f))
        (frame {:vals {} :parent parent :self proc})
        (params (ir/fn-params x f)))
    (let ((required (sig 0))
          (optional (sig 1)))
      (when (or (< (length args) required) (and (not (sig 2)) (> (length args) (+ required optional))))
        (error "interp: wrong number of arguments"))
      (let loop ((ps params)
                 (as args)
                 (i 0))
        (when (pair? ps)
          (cond
            ((< i (+ required optional))
             (frame-set! frame
                         (car ps)
                         (if (pair? as)
                             (car as)
                             unbound-marker))
             (loop (cdr ps)
                   (if (pair? as)
                       (cdr as)
                       as)
                   (+ i 1)))
            (else (frame-set! frame (car ps) as))))))
    (let ((outcome (run-region x frame (ir/fn-entry x f) (ir/block-ops x (ir/fn-entry x f)) nil))) (outcome 1))))

(def- (run-op x frame o)
  (let ((code (ir/op-code x o))
        (args (map (fn (v) (frame-ref frame v)) (ir/op-args x o)))
        (aux (ir/op-aux x o)))
    (cond
      ((eq? code 'const) aux)
      ((eq? code 'global-ref) (global-value aux))
      ((eq? code 'prim-ref) (eval aux))
      ((eq? code 'box) [(car args)])
      ((eq? code 'box-ref)
       (let ((v ((car args) 0)))
         (when (eq? v unbound-marker) (error "interp: unbound"))
         v))
      ((eq? code 'box-set) (put! (car args) 0 (second args)) nil)
      ((eq? code 'unbound) unbound-marker)
      ((eq? code 'check-bound) (when (eq? (car args) unbound-marker) (error "interp: unbound")) (car args))
      ((eq? code 'bound?) (not (eq? (car args) unbound-marker)))
      ((eq? code 'refine) (car args))
      ((eq? code 'closure)
       ;; Captures are values at this point, as the VM copies them.
       (make-closure x aux {:vals (copy (frame :vals)) :parent (frame :parent) :self (frame :self)}))
      ((eq? code 'self) (frame :self))
      ((eq? code 'raise) (error (car args)))
      ((memq code '(global-set global-def)) (error "interp: globals can't be written"))
      (else (apply (eval code) args)))))

;; Runs from block b with ops still to run. Returns [:return value], or
;; [:closed b ops] when it reaches the operation that closes the region
;; (pop-try or run-cleanup); closer is that code, or nil for a whole body.
(def- (run-region x frame b ops closer)
  (let ((result nil))
    (while (nil? result)
      (if (pair? ops)
          (let ((o (car ops))
                (code (ir/op-code x o)))
            (set! ops (cdr ops))
            (cond
              ((and closer (eq? code closer)) (frame-set! frame (ir/op-value x o) nil) (set! result [:closed b ops]))
              ((eq? code 'push-cleanup)
               (frame-set! frame (ir/op-value x o) nil)
               (let ((cleanup (frame-ref frame (car (ir/op-args x o))))
                     (inside (defer
                               (run-region x frame b ops 'run-cleanup)
                               (cleanup))))
                 (if (eq? (inside 0) :closed)
                     (begin
                       (set! b (inside 1))
                       (set! ops (inside 2)))
                     (error "interp: returned inside a cleanup region"))))
              (else (frame-set! frame (ir/op-value x o) (run-op x frame o)))))
          (let ((kind (ir/term-kind x b))
                (args (map (fn (v) (frame-ref frame v)) (ir/term-args x b)))
                (succ (ir/succs x b)))
            (def (go! target values)
              (let loop ((ps (ir/block-params x target))
                         (vs values))
                (when (pair? ps)
                  (frame-set! frame (car ps) (car vs))
                  (loop (cdr ps) (cdr vs))))
              (set! b target)
              (set! ops (ir/block-ops x target)))
            (def (callee)
              (let ((c (ir/term-callee x b)))
                (if (eq? (ir/term-call-kind x b) :global)
                    (global-value c)
                    (frame-ref frame c))))
            (cond
              ((eq? kind :jump) (go! (car succ) args))
              ((eq? kind :branch)
               (go! (if (truthy? (car args))
                        (car succ)
                        (second succ))
                    '()))
              ((eq? kind :branch-prim)
               (go! (if (truthy? (apply (eval (ir/term-prim x b)) args))
                        (car succ)
                        (second succ))
                    '()))
              ((eq? kind :call) (go! (car succ) (list (apply (callee) args))))
              ((eq? kind :tail-call) (set! result [:return (apply (callee) args)]))
              ((eq? kind :return) (set! result [:return (car args)]))
              ((eq? kind :try)
               (let ((inside (try
                               (run-region x frame (car succ) (ir/block-ops x (car succ)) 'pop-try)
                               (catch e [:raised e]))))
                 (cond
                   ((eq? (inside 0) :closed) (set! b (inside 1)) (set! ops (inside 2)))
                   ((eq? (inside 0) :raised) (go! (second succ) (list (inside 1))))
                   (else (error "interp: returned inside a try region")))))
              (else (error (str "interp: reached " kind)))))))
    result))

(def- (outcome-of thunk)
  (try
    (list :value (thunk))
    (catch _ (list :error))))

(def- (interpreted text)
  ;; Run text's converted IR; text should be closed, defining nothing.
  (let ((x (converted text))) (outcome-of (fn () (run-fn x 0 nil nil '())))))

(def- (native text)
  (outcome-of (fn () (eval (read-string text)))))

(def- (same-as-runtime label text)
  (check label (native text) (interpreted text)))

(same-as-runtime "constant" "42")
(same-as-runtime "loop" "((fn (n) (let loop ((i 0) (acc 0)) (if (< i n) (loop (+ i 1) (+ acc i)) acc))) 10)")
(same-as-runtime "non-tail loop" "((fn (n) (+ 1 (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i)))) 5)")
(same-as-runtime "loop in test position"
                 "((fn (n) (if (let loop ((i 0)) (if (< i n) (loop (+ i 1)) (= i 3))) :yes :no)) 3)")
(same-as-runtime "nested loops"
                 "((fn (n) (let outer ((i 0) (acc '())) (if (< i n) (outer (+ i 1) (let inner ((j 0) (acc acc)) (if (< j i) (inner (+ j 1) (cons j acc)) acc))) acc))) 4)")
(same-as-runtime "set! joins" "((fn (x) (let ((y 0)) (if x (set! y 1) (set! y 2)) y)) #f)")
(same-as-runtime "set! in a loop"
                 "((fn (xs) (let ((n 0)) (let loop ((xs xs)) (when (pair? xs) (set! n (+ n 1)) (loop (cdr xs)))) n)) '(1 2 3))")
(same-as-runtime "set! before the loop"
                 "((fn (c) (let ((x 0)) (let loop ((i 0)) (if (< i 3) (begin (set! x (+ x i)) (loop (+ i 1))) x)))) 1)")
(same-as-runtime "set! in one arm of a loop body"
                 "((fn (n) (let ((evens 0) (odds 0)) (let loop ((i 0)) (when (< i n) (if (even? i) (set! evens (+ evens 1)) (set! odds (+ odds 1))) (loop (+ i 1)))) (list evens odds))) 7)")
(same-as-runtime "counter closure"
                 "((fn () (let ((n 0)) (let ((inc (fn () (set! n (+ n 1)) n))) (inc) (inc) (list (inc) n)))))")
(same-as-runtime "closures over loop variables"
                 "(map (fn (f) (f)) ((fn () (let loop ((i 0) (fs '())) (if (< i 3) (loop (+ i 1) (cons (fn () i) fs)) fs)))))")
(same-as-runtime "while"
                 "((fn (n) (let ((i 0) (s 0)) (while (< i n) (set! s (+ s i)) (set! i (+ i 1))) (list i s))) 5)")
(same-as-runtime "while gives nil" "((fn () (let ((i 0)) (while (< i 2) (set! i (+ i 1))))))")
(same-as-runtime "optionals" "((fn (a &optional (b (+ a 1)) (c (* b 2))) (list a b c)) 1)")
(same-as-runtime "optionals passed" "((fn (a &optional (b (+ a 1)) (c (* b 2))) (list a b c)) 1 5)")
(same-as-runtime "rest" "((fn (a . r) (list a r)) 1 2 3)")
(same-as-runtime "and/or" "((fn (a b) (list (and a b) (or a b) (and (pair? a) (car a)) (or (pair? b) b))) '(1) #f)")
(same-as-runtime "cond" "((fn (x) (cond ((pair? x) :pair) ((null? x) :null) ((< x 0) :neg) (else :other))) -3)")
(same-as-runtime "not in a test" "((fn (x) (if (not (pair? x)) 1 2)) 5)")
(same-as-runtime "try, matching clause"
                 "((fn (x) (try (car x) (catch (string? e) :string) (catch (error? e) :error))) 5)")
(same-as-runtime "try, normal exit" "((fn (x) (try (car x) (catch (error? e) :error))) '(1))")
(same-as-runtime "try, no clause matches" "((fn (x) (try (car x) (catch (string? e) :string))) 5)")
(same-as-runtime "try, catch-all" "((fn (x) (try (error \"boom\") (catch e (condition-message e)))) 5)")
(same-as-runtime "try in a loop"
                 "((fn (xs) (let loop ((xs xs) (n 0)) (if (pair? xs) (loop (cdr xs) (+ n (try (car (car xs)) (catch (error? e) 100)))) n))) '((1) 2 (3)))")
(same-as-runtime "assigned in a try body"
                 "((fn (x) (let ((y 0)) (try (begin (set! y 1) (car x)) (catch (error? e) (list :caught y))))) 5)")
(same-as-runtime "defer"
                 "((fn () (let ((log '())) (let ((r (defer (begin (set! log (cons :body log)) 1) (set! log (cons :cleanup log))))) (list r log)))))")
(same-as-runtime "defer when raising"
                 "((fn () (let ((log '())) (try (defer (car 1) (set! log (cons :cleanup log))) (catch (error? e) log)))))")
(same-as-runtime "mutual recursion"
                 "((fn () (def (ev? n) (if (= n 0) #t (od? (- n 1)))) (def (od? n) (if (= n 0) #f (ev? (- n 1)))) (list (ev? 10) (od? 7))))")
(same-as-runtime "escaping mutual recursion"
                 "((fn () (def (ev? n) (if (= n 0) #t (od? (- n 1)))) (def (od? n) (if (= n 0) #f (ev? (- n 1)))) (map (fn (f) (f 3)) (list ev? od?))))")
(same-as-runtime "non-tail recursion" "((fn () (def (len xs) (if (pair? xs) (+ 1 (len (cdr xs))) 0)) (len '(1 2 3))))")
(same-as-runtime "letrec value read early" "((fn () (def x (list x)) x))")
(same-as-runtime "letrec value set late" "((fn () (def (f) y) (def x (fn () (f))) (def y 1) (x)))")
(same-as-runtime "builtins as values" "(map car '((1) (2)))")
(same-as-runtime "apply" "(apply + 1 '(2 3))")
(same-as-runtime "a primop with an unusual count" "((fn (x) (car x x)) '(1))")
(same-as-runtime "quasiquote" "((fn (x) `(a ,x ,@(list x x))) 1)")
(same-as-runtime "match" "((fn (e) (match e ({:kind :move :x x} (list :move x)) (_ :other))) {:kind :move :x 3})")
(same-as-runtime "for collect" "((fn (xs) (for ((x :in xs) (out :collect (* x x))) => out)) '(1 2 3))")
(same-as-runtime "dotimes" "((fn () (let ((s 0)) (dotimes (i 4) (set! s (+ s i))) s)))")
(same-as-runtime "string ports" "((fn () (with-output-to-string (fn () (write 1) (display \" \") (write \"a\")))))")
(same-as-runtime "a contified function entered from two places"
                 "(list ((fn (c) (def (f i) (if (< i 3) (f (+ i 1)) i)) (if c (f 0) (f 10))) #t) ((fn (c) (def (f i) (if (< i 3) (f (+ i 1)) i)) (if c (f 0) (f 10))) #f))")
(same-as-runtime "assigned before entering a contified function"
                 "((fn (c) (let ((x 0)) (def (f i) (if (< i 3) (f (+ i 1)) (+ i x))) (if c (begin (set! x 5) (f 0)) (f 1)))) #t)")
(same-as-runtime "refined, then assigned" "((fn (x) (if (pair? x) (begin (set! x (car x)) (list x)) x)) '(7))")
(same-as-runtime "a loop in a catch body"
                 "((fn () (let loop ((i 0)) (try (car i) (catch (error? e) (if (< i 3) (loop (+ i 1)) i))))))")
(same-as-runtime "optional default uses a captured variable"
                 "(((fn (k) (fn (a &optional (b k)) (set! b (+ b 1)) (list a b))) 10) 1)")
(same-as-runtime "a body variable assigned after a function captures it"
                 "((fn () (def x 1) (def (f) x) (set! x 2) (f)))")
(same-as-runtime "self-reference from a nested lambda"
                 "((fn () (def (count n) (if (= n 0) '() (cons n ((fn () (count (- n 1))))))) (count 3)))")
(same-as-runtime "try in a while loop"
                 "((fn (xs) (let ((n 0)) (while (pair? xs) (try (set! n (+ n (car (car xs)))) (catch (error? e) (set! n (+ n 100)))) (set! xs (cdr xs))) n)) '((1) 2 (3)))")
(same-as-runtime "defer in a loop"
                 "((fn () (let ((log '())) (dotimes (i 2) (defer (set! log (cons i log)) (set! log (cons :c log)))) log)))")
(same-as-runtime "grandparent values" "((((fn (a) (fn (b) (fn (c) (list a b c)))) 1) 2) 3)")
(same-as-runtime "and/or in a test" "((fn (a b) (if (or (null? a) (and (pair? b) (car b))) :yes :no)) '(1) '(#f))")
(same-as-runtime "an if for effect" "((fn (c) (let ((x 0)) (if c (set! x 1) (set! x 2)) (if c (list x) x) x)) #t)")
(same-as-runtime "loop in a test with an assigned variable"
                 "((fn () (let ((n 0)) (if (let loop ((i 0)) (set! n (+ n 1)) (if (< i 2) (loop (+ i 1)) #f)) n (list n)))))")
(same-as-runtime "a let in a test" "((fn (x) (if (let ((y (car x))) (pair? y)) 1 2)) '((1)))")
(same-as-runtime "unbound letrec variable captured" "((fn () (def (f) y) (def x (f)) (def y 1) x))")
(same-as-runtime "without inlining, a loop in a let"
                 "((fn (n) (let ((r (let loop ((i n)) (if (> i 0) (loop (- i 1)) i)))) (list r n))) 3)")

;; --- corpus ----------------------------------------------------------------
;;
;; Every program the Resolve tests use and every top-level form of the
;; ported r7rs benchmarks goes through Resolve, Inline, Convert and the
;; verifier. Forms are read and expanded here rather than evaluated, so
;; nothing in the benchmarks runs or replaces this file's definitions.

(def- (forms-of path)
  (let ((port (open-input-string (read-file path))))
    (let loop ((x (read port))
               (out '()))
      (if (eof-object? x)
          (reverse out)
          (loop (read port) (cons x out))))))

(def- (strings-in x out)
  ;; The source texts of the front end's tests: (shown "...") and friends.
  (cond
    ((and (pair? x) (memq (car x) '(shown resolved unsupported)) (pair? (cdr x)) (string? (second x)))
     (push! out (second x)))
    ((pair? x) (strings-in (car x) out) (strings-in (cdr x) out)))
  out)

(def- corpus-stats {:converted 0 :unsupported 0 :failed 0})

(def- corpus-reasons {})

(def- corpus-failures [])

(def- (corpus-form! form label)
  (try
    (let ((x (convert/run (inline/run (core/resolve (macroexpand-all form) 'user)))))
      (verify/check x :converted)
      (put! corpus-stats :converted (+ 1 (corpus-stats :converted))))
    (catch e
      (if (core/unsupported? e)
          (begin
            (put! corpus-stats :unsupported (+ 1 (corpus-stats :unsupported)))
            (put! corpus-reasons (e :what) (+ 1 (get corpus-reasons (e :what) 0))))
          (begin
            (put! corpus-stats :failed (+ 1 (corpus-stats :failed)))
            (push! corpus-failures (list label (condition-message e))))))))

(def- benchmarks
  '(ack array1
        bv2string
        cat
        conform
        cpstak
        deriv
        destruc
        diviter
        divrec
        earley
        equal
        fft
        fib
        fibfp
        gcbench
        graphs
        lattice
        matrix
        mazefun
        mbrot
        mperm
        nboyer
        nqueens
        ntakl
        nucleic
        paraffins
        peval
        pnpoly
        primes
        quicksort
        ray
        read1
        sboyer
        simplex
        string
        sum
        sum1
        sumfp
        tail
        tak
        takl
        triangl
        wc))

(for-each (fn (text) (corpus-form! (read-string text) text))
          (array-to-list (strings-in (forms-of "tests/compiler/core.ot") [])))
(for-each (fn (name)
            (let ((path (str "benchmarks/r7rs/ports/" name ".ot")))
              (for-each (fn (form) (corpus-form! form path)) (forms-of path))))
          benchmarks)

(check "corpus: nothing fails to convert or verify" '() (array-to-list corpus-failures))
(check "corpus: most forms convert" #t (> (corpus-stats :converted) 700))
(println "convert corpus: " corpus-stats " unsupported: " corpus-reasons)

(report "compiler convert")
