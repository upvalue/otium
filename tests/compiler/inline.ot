;; Inline: what each simplification produces, and that the result still
;; means the same thing.
(require (otium.test :refer (check report)) (otium.compiler.core :as core) (otium.compiler.inline :as inline))

(def- (resolved text)
  (core/resolve (macroexpand-all (read-string text)) 'user))

(def- (inlined text)
  (core/show (inline/run (resolved text))))

;; Folding and propagation
(check "fold arithmetic" '(def user/x 3) (inlined "(def x (+ 1 2))"))
(check "fold through let" '(def user/f (fn () 2)) (inlined "(def (f) (let ((a 1) (b a)) (+ a b)))"))
(check "fold predicates" '(def user/x #t) (inlined "(def x (pair? '(1)))"))
(check "fold not" '(def user/x #f) (inlined "(def x (not 1))"))
(check "fold comparisons" '(def user/x #t) (inlined "(def x (< 1 2))"))
(check "no fold of an error" '(def user/x (/ 1 0)) (inlined "(def x (/ 1 0))"))
(check "no fold of car on constant data" '(def user/x (car (quote (1)))) (inlined "(def x (car '(1)))"))
(check "no fold of allocation" '(def user/x (cons 1 2)) (inlined "(def x (cons 1 2))"))
(check "copy propagation" '(fn (x.1) (call (global user/g) x.1 x.1)) (inlined "(fn (x) (let ((y x)) (g y y)))"))
(check "no propagation of assigned variables"
       '(fn (x.1)
          (let ((y.2 x.1))
            (begin
              (set! y.2 2)
              y.2)))
       (inlined "(fn (x) (let ((y x)) (set! y 2) y))"))
(check "builtin values propagate to calls" '(fn (x.1) (car x.1)) (inlined "(fn (x) (let ((f car)) (f x)))"))

;; Inlining
(check "inline a local function"
       '(def user/f (fn (x.1) (* x.1 x.1)))
       (inlined "(def (f x) (let ((sq (fn (y) (* y y)))) (sq x)))"))
(check "inline a direct lambda" '(def user/f (fn (x.1) (+ x.1 1))) (inlined "(def (f x) ((fn (y) (+ y 1)) x))"))
(check "inline and fold" '(def user/f (fn () 9)) (inlined "(def (f) (let ((sq (fn (y) (* y y)))) (sq 3)))"))
(check "inline a body function"
       '(def user/f (fn (x.1) (+ x.1 2)))
       (inlined "(def (f x) (def (add2 y) (+ y 2)) (add2 x))"))
(check "inline twice gives separate copies"
       '(fn (a.1 b.2) (list (call (global user/g) a.1) (call (global user/g) b.2)))
       (inlined "(fn (a b) (let ((h (fn (x) (g x)))) (list (h a) (h b))))"))
(check "keep global calls" '(def user/f (fn () (call (global user/g) 1))) (inlined "(def (f) (g 1))"))
(check "keep recursive local functions"
       '(def user/f
          (fn (n.1)
            (fix ((loop.2 (fn (i.3)
                            (if (> i.3 0)
                                (call loop.2 (- i.3 1))
                                i.3))))
                 (call loop.2 n.1))))
       (inlined "(def (f n) (let loop ((i n)) (if (> i 0) (loop (- i 1)) i)))"))
(check "keep functions with optionals"
       '(fn (x.1) (let ((h.2 (fn (a.3 &optional (b.4 1)) (+ a.3 b.4)))) (call h.2 x.1)))
       (inlined "(fn (x) (let ((h (fn (a &optional (b 1)) (+ a b)))) (h x)))"))
(check "keep calls with the wrong argument count"
       '(fn (x.1) (let ((h.2 (fn (a.3) a.3))) (call h.2 x.1 x.1)))
       (inlined "(fn (x) (let ((h (fn (a) a))) (h x x)))"))
(check "unused fix functions are dropped" '(fn () 1) (inlined "(fn () (def (a) (b)) (def (b) (a)) 1)"))

(def- (with-limits size effort thunk)
  (let ((saved-size inline/size-limit)
        (saved-effort inline/effort-limit))
    (set! inline/size-limit size)
    (set! inline/effort-limit effort)
    (defer
      (thunk)
      (set! inline/size-limit saved-size)
      (set! inline/effort-limit saved-effort))))

;; Budgets
(def- big-body "(+ a (+ a (+ a (+ a (+ a (+ a (+ a (+ a (+ a (+ a a))))))))))")

(check "the size limit stops inlining"
       #t
       (let ((out (inlined (str "(fn (x) (let ((g (fn (a) " big-body "))) (g (g (g x)))))"))))
         ;; The innermost call is inlined; the outer two would be too big.
         (and (eq? (first (third out)) 'let) (eq? (first (third (third out))) 'call))))
(check "a body too big to try isn't inlined"
       'call
       (let ((huge (str "(fn (a) " big-body " " big-body " " big-body " " big-body " " big-body ")")))
         (first (third (third (inlined (str "(fn (x) (let ((g " huge ")) (g x)))")))))))

(def- small-call "(fn (x) (let ((g (fn (a) (+ a (+ a (+ a a)))))) (g x)))")

(check "inlined within the limits" '+ (first (third (inlined small-call))))
(check "the effort limit stops inlining" 'let (with-limits 20 5 (fn () (first (third (inlined small-call))))))
(check "the size limit stops inlining" 'let (with-limits 2 200 (fn () (first (third (inlined small-call))))))

;; Effects and dead code
(check "drop an unused pure binding" '(def user/f (fn () 2)) (inlined "(def (f) (let ((a (cons 1 2))) 2))"))
(check "keep an unused binding's effect"
       '(def user/f
          (fn ()
            (begin
              (call (global otium.core/println) 1)
              2)))
       (inlined "(def (f) (let ((a (println 1))) 2))"))
(check "drop allocation for effect" '(def user/f (fn () 3)) (inlined "(def (f) (begin (cons 1 2) 3))"))
(check "keep reads that may fail"
       '(def user/f
          (fn (x.1)
            (begin
              (car x.1)
              3)))
       (inlined "(def (f x) (car x) 3)"))
(check "keep evaluation order"
       '(def user/f (fn () (let ((a.1 (call (global user/g)))) (let ((b.2 (call (global user/h)))) (list b.2 a.1)))))
       (inlined "(def (f) (let ((a (g)) (b (h))) (list b a)))"))
(check "drop a variable only assigned"
       '(fn ()
          (begin
            (call (global user/g))
            1))
       (inlined "(fn () (let ((a 0)) (set! a (g)) 1))"))
(check "dead after a folded test"
       '(def user/f (fn (x.1) 1))
       (inlined "(def (f x) (let ((p (cons x x))) (if (pair? p) 1 2)))"))
(check "while false" '(fn () (quote nil)) (inlined "(fn () (while #f (g)))"))
(check "unused fn for effect" '(fn () 1) (inlined "(fn () (fn (x) x) 1)"))

;; Conditionals
(check "fold if" '(def user/x 1) (inlined "(def x (if #t 1 2))"))
(check "if not swaps branches"
       '(def user/f
          (fn (x.1)
            (if x.1
                2
                1)))
       (inlined "(def (f x) (if (not x) 1 2))"))
(check "tests know their predicate"
       '(def user/f
          (fn (x.1)
            (if (pair? x.1)
                1
                3)))
       (inlined "(def (f x) (if (pair? x) (if (pair? x) 1 2) 3))"))
(check "tests know a false predicate"
       '(def user/f
          (fn (x.1)
            (if (pair? x.1)
                3
                2)))
       (inlined "(def (f x) (if (pair? x) 3 (if (pair? x) 1 2)))"))
(check "tests know truthiness"
       '(def user/f
          (fn (x.1)
            (if x.1
                1
                3)))
       (inlined "(def (f x) (if x (if x 1 2) 3))"))
(check "or keeps its value"
       '(def user/f
          (fn (x.1)
            (if x.1
                x.1
                5)))
       (inlined "(def (f x) (or x 5))"))
(check "and in a test"
       '(def user/f
          (fn (x.1 y.2)
            (if (if x.1
                    y.2
                    #f)
                1
                2)))
       (inlined "(def (f x y) (if (and x y) 1 2))"))
(check "same branches"
       '(fn (x.1)
          (begin
            (call (global user/g) x.1)
            1))
       (inlined "(fn (x) (if (g x) 1 1))"))
(check "a fn is true" '(fn () 1) (inlined "(fn () (if (fn () 2) 1 2))"))

;; Other nodes pass through
(check "try"
       '(fn ()
          (try
            (call (global user/g))
            (catch ((global otium.core/error?) e.1) e.1)))
       (inlined "(fn () (try (g) (catch (error? e) e)))"))
(check "defer"
       '(fn ()
          (defer
            (call (global user/g))
            (begin
              (call (global user/h))
              (quote nil))))
       (inlined "(fn () (defer (g) (h) 1))"))
(check "unbound letrec variables stay"
       '(fn ()
          (let ((x.1 (unbound)))
            (begin
              (set! x.1 (list x.1))
              x.1)))
       (inlined "(fn () (def x (list x)) x)"))

;; Exact counts, cell ids and positions
(let ((out (inline/run (resolved "(fn (x) (let ((f (fn (y) (+ x y)))) (f 1) (fn () x)))")))
      (x (car (out :params))))
  (check "refs are exact after inlining" 2 (x :refs))
  (check "captured is recomputed" #t (x :captured)))
(let ((out (inline/run (resolved "(fn (x) (let ((f (fn () x))) (f)))"))))
  (check "captured is cleared when inlining removes the fn" #f ((car (out :params)) :captured)))
(check "cells survive"
       (%resolve-global 'user 'g)
       (((car (((inline/run (resolved "(fn () (g) 1)")) :body) :exprs)) :fn) :cell))
(let ((n (resolved "(fn (x) (g x))")))
  (put! n :pos 7)
  (put! (n :body) :pos 9)
  (let ((out (inline/run n)))
    (check "positions survive" 7 (out :pos))
    (check "inner positions survive" 9 ((out :body) :pos))))

;; A small evaluator for Core, to check that inlined code computes the same
;; values as the original.

(def- unbound-marker (gensym "unbound"))

(def- (lookup env x)
  (let ((entry (assq (x :id) env)))
    (if entry
        (cdr entry)
        (error (str "eval: unbound variable " (x :name))))))

(def- (bare sym)
  (let ((s (symbol->string sym))
        (slash (string-index s "/")))
    (symbol (substring s (+ slash 1) (string-length s)))))

(def- (ev n env)
  (let ((op (n :op)))
    (cond
      ((eq? op :const) (n :value))
      ((eq? op :unbound) unbound-marker)
      ((eq? op :ref)
       (let ((v ((lookup env (n :var)) 0)))
         (when (eq? v unbound-marker) (error "eval: variable used before its definition"))
         v))
      ((eq? op :set) (put! (lookup env (n :var)) 0 (ev (n :value) env)) nil)
      ((eq? op :global) (eval (n :name)))
      ((eq? op :gset) (eval (list 'set! (n :name) (list 'quote (ev (n :value) env)))) nil)
      ((eq? op :prim) (eval (symbol (str "otium.core/" (n :name)))))
      ((eq? op :primcall) (apply (eval (symbol (str "otium.core/" (n :name)))) (map (fn (a) (ev a env)) (n :args))))
      ((eq? op :call) (let ((f (ev (n :fn) env))) (apply f (map (fn (a) (ev a env)) (n :args)))))
      ((eq? op :if)
       (if (ev (n :test) env)
           (ev (n :then) env)
           (ev (n :else) env)))
      ((eq? op :seq) (reduce (fn (_ e) (ev e env)) nil (n :exprs)))
      ((eq? op :let) (ev (n :body) (cons (cons ((n :var) :id) [(ev (n :value) env)]) env)))
      ((eq? op :fix)
       (let ((inner (append (map (fn (b) (cons ((car b) :id) [nil])) (n :bindings)) env)))
         (for-each (fn (b) (put! (lookup inner (car b)) 0 (ev (cdr b) inner))) (n :bindings))
         (ev (n :body) inner)))
      ((eq? op :fn) (fn args (apply-fn n env args)))
      ((eq? op :while) (while (ev (n :test) env) (ev (n :body) env)) nil)
      ((eq? op :try)
       (try
         (ev (n :body) env)
         (catch c
           (let ((handler (find-catch (n :catches) c env)))
             (if handler
                 (ev (third handler) (cons (cons ((second handler) :id) [c]) env))
                 (error c))))))
      ((eq? op :defer)
       (defer
         (ev (n :body) env)
         (ev (n :cleanup) env)))
      ((eq? op :def) (eval (list 'def (bare (n :name)) (list 'quote (ev (n :value) env)))) nil)
      (else (error (str "eval: unknown node " op))))))

(def- (find-catch catches c env)
  (cond
    ((null? catches) nil)
    (((ev (first (car catches)) env) c) (car catches))
    (else (find-catch (cdr catches) c env))))

(def- (apply-fn n env args)
  (let ((inner env))
    (for-each (fn (x)
                (when (null? args) (error "eval: too few arguments"))
                (set! inner (cons (cons (x :id) [(car args)]) inner))
                (set! args (cdr args)))
              (n :params))
    (for-each (fn (o)
                (let ((v (if (null? args)
                             (ev (cdr o) inner)
                             (car args))))
                  (unless (null? args) (set! args (cdr args)))
                  (set! inner (cons (cons ((car o) :id) [v]) inner))))
              (n :optionals))
    (if (n :rest)
        (set! inner (cons (cons ((n :rest) :id) [args]) inner))
        (unless (null? args) (error "eval: too many arguments")))
    (ev (n :body) inner)))

(def- (read-all text)
  (let ((port (open-input-string text))
        (forms '())
        (form (read port)))
    (while (not (eof-object? form))
      (set! forms (cons form forms))
      (set! form (read port)))
    (reverse forms)))

(def- (run-direct text)
  (reduce (fn (_ f) (eval f)) nil (read-all text)))

(def- (run-core text optimize)
  (reduce (fn (_ f)
            (let ((n (core/resolve (macroexpand-all f) 'user)))
              (ev (if optimize
                      (inline/run n)
                      n)
                  '())))
          nil
          (read-all text)))

(def- programs
  '("(def (sum-squares xs) (for ((x :in xs) (s :sum (* x x))) => s)) (sum-squares '(1 2 3))"
    "(def (sum-squares xs) (for ((x :in xs) (s :sum (* x x))) => s)) (sum-squares [1 2 3])"
    "(def (classify v) (match v ({:kind :move :x x} x) ([p q] (* p q)) (_ :other))) [(classify {:kind :move :x 4}) (classify [3 4]) (classify 7)]"
    "(def (sq-list n) (let ((acc [])) (dotimes (i n) (push! acc (* i i))) acc)) (sq-list 5)"
    "(def (opt x &optional (y 10) (z (+ x y))) (list x y z)) [(opt 1) (opt 1 2) (opt 1 2 3)]"
    "(def (rev . xs) (reverse xs)) (rev 1 2 3)"
    "(def (k x) (or (and (pair? x) (car x)) (when (nil? x) :none) x)) [(k '(1)) (k nil) (k 3) (k '())]"
    "(def (q x) `(a ,x ,@(list x x) b)) (q 1)"
    "(def (safe-div a b) (try (/ a b) (catch (error? e) :failed))) [(safe-div 6 3) (safe-div 1 0)]"
    "(def (walk tree) (cond ((pair? tree) (+ (walk (car tree)) (walk (cdr tree)))) ((nil? tree) 0) ((null? tree) 0) (else 1))) (walk '((a b) (c (d e)) f))"
    "(def (parity n) (def (ev? n) (if (= n 0) #t (od? (- n 1)))) (def (od? n) (if (= n 0) #f (ev? (- n 1)))) (list (ev? n) (od? n))) (parity 7)"
    "(def (counter) (let ((n 0)) (fn () (set! n (+ n 1)) n))) (let ((c (counter))) (c) (c) (c))"
    "(def (early) (def (f) y) (def y 5) (def x (f)) (+ x y)) (early)"
    "(def (too-early) (def (f) y) (def x (f)) (def y 5) x) (try (too-early) (catch e :raised))"
    "(def (logged) (let ((log [])) (defer (push! log 1) (push! log 2)) log)) (logged)"
    "(def (and-value) (list (and nil 1) (and 1 2) (or #f nil) (or nil 3) (and) (or))) (and-value)"
    "(def (loop-sum n) (let ((s 0) (i 0)) (while (< i n) (set! s (+ s i)) (set! i (+ i 1))) s)) (loop-sum 10)"
    "(def (pick x) (let ((inc2 (fn (v) (+ v 2)))) (if (int? x) (inc2 x) (if (int? x) 0 (list x))))) [(pick 1) (pick :a)]"
    "(def (nested-qq x) `(a `(b ,,x))) (nested-qq 3)"
    "(def (rethrow) (try (try (error {:type :mine :message \"m\"}) (catch (string? s) s)) (catch e (condition-type e)))) (rethrow)"))

(for-each (fn (text)
            (let ((expected (run-direct text)))
              (check (str "resolved: " text) expected (run-core text #f))
              (check (str "inlined: " text) expected (run-core text #t))))
          programs)

(report "compiler inline")
