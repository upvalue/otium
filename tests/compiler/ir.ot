;; The block IR: builder, printer and reader, analyses, verifier.
(require (otium.test :refer (check report))
         (otium.compiler.column :as column)
         (otium.compiler.ir :as ir)
         (otium.compiler.ir-text :as text)
         (otium.compiler.types :as types)
         (otium.compiler.verify :as verify))

(def- (error-text thunk)
  "The message thunk raises, or nil if it returns."
  (try
    (begin
      (thunk)
      nil)
    (catch (error? c) (condition-message c))))

(defmacro raises (label pattern expr)
  #`(let ((m# (error-text (fn () ,expr))))
      (unless (and (string? m#) (string-contains? m# ,pattern)) (println "message: " m#))
      (check ,label #t (and (string? m#) (string-contains? m# ,pattern)))))

(def- (round-trip datum)
  (text/print (text/read datum)))

(def- (verify-text datum stage)
  (verify/check (text/read datum) stage))

(def- (block-map table n)
  (map (fn (b) (get table b)) (array-to-list (range n))))

;; --- bitsets ---------------------------------------------------------------------

(let ((s (column/bitset 130)))
  (column/bitset-set! s 0)
  (column/bitset-set! s 59)
  (column/bitset-set! s 60)
  (column/bitset-set! s 129)
  (check "bitset members" '(0 59 60 129) (column/bitset->list s))
  (check "bitset words stay fixnums" #t (null? (filter (fn (w) (< w 0)) (array-to-list s))))
  (column/bitset-clear! s 59)
  (check "bitset clear" '(0 60 129) (column/bitset->list s))
  (check "bitset has" '(#t #f) (list (column/bitset-has? s 60) (column/bitset-has? s 61)))
  (let ((t (column/bitset 130)))
    (column/bitset-set! t 5)
    (check "union changes" #t (column/bitset-union! t s))
    (check "union again doesn't" #f (column/bitset-union! t s))
    (check "union members" '(0 5 60 129) (column/bitset->list t))
    (check "not equal" #f (column/bitset-equal? s t))
    (column/bitset-set! s 5)
    (check "equal" #t (column/bitset-equal? s t))))

;; --- builder and printer ---------------------------------------------------------

(def fib-text
  '(ir (fn f0
         "fib"
         :parent nil
         :params (v0)
         :signature (1 0 #f)
         :entry b0
         (b0 () (v1 const 2) (branch-prim < (v0 v1) b1 b2))
         (b1 () (return v0))
         (b2 () (v2 const 1) (v3 - v0 v2) (call global 17 (v3) b3))
         (b3 (v4) (v5 const 2) (v6 - v0 v5) (call global 17 (v6) b4))
         (b4 (v7) (v8 + v4 v7) (return v8)))))

(def (build-fib)
  (let ((x (ir/new)))
    (let ((f (ir/add-function! x "fib" nil nil)))
      (let ((b0 (ir/add-block! x f))
            (b1 (ir/add-block! x f))
            (b2 (ir/add-block! x f))
            (b3 (ir/add-block! x f))
            (b4 (ir/add-block! x f)))
        (let ((n (ir/add-param! x b0)))
          (ir/set-entry! x f b0)
          (ir/set-signature! x f (list n) 1 0 #f)
          (ir/branch-prim! x b0 '< (list n (ir/emit! x b0 'const '() 2)) b1 b2)
          (ir/return! x b1 n)
          (let ((a (ir/emit! x b2 '- (list n (ir/emit! x b2 'const '() 1)))))
            (ir/call! x b2 :global 17 (list a) b3 nil))
          (let ((r1 (ir/add-param! x b3)))
            (let ((a (ir/emit! x b3 '- (list n (ir/emit! x b3 'const '() 2)))))
              (ir/call! x b3 :global 17 (list a) b4 nil))
            (let ((r2 (ir/add-param! x b4))) (ir/return! x b4 (ir/emit! x b4 '+ (list r1 r2))))))))
    x))

(def fib (build-fib))

(check "fib prints as the spec says" fib-text (text/print fib))
(check "fib round trips" fib-text (round-trip fib-text))
(check "fib verifies" #t (verify/check fib :converted))
(check "fib verifies closed" #t (verify/check fib :closed))

;; Builder order doesn't matter to the printed form: blocks filled out of
;; order, values numbered as printed.
(let ((x (ir/new)))
  (let ((f (ir/add-function! x nil nil 4)))
    (let ((b0 (ir/add-block! x f))
          (b1 (ir/add-block! x f)))
      (let ((late (ir/add-param! x b1)))
        (ir/set-entry! x f b0)
        (ir/set-signature! x f '() 0 0 #f)
        (ir/return! x b1 late)
        (ir/jump! x b0 b1 (list (ir/emit! x b0 'const '() 'sym 12)))))
    (check "renumbered in print order"
           '(ir (fn f0
                  nil
                  :parent nil
                  :params ()
                  :signature (0 0 #f)
                  :entry b0
                  :pos 4
                  (b0 () (v0 const 'sym :pos 12) (jump b1 v0))
                  (b1 (v1) (return v1))))
           (text/print x))))

(def everything
  '(ir (fn f0
         "outer"
         :parent nil
         :params ((v0 :name x :fact (fixnum 0 10)) v1)
         :signature (1 1 #f)
         :entry b0
         (b0 ()
             (v2 const (quote (1 2)))
             (v3 const (quote ()))
             (v4 const nil)
             (v5 const "s" :pos 3)
             (v6 bound? v1)
             (v7 global-ref :aux 17 :name g)
             (v8 prim-ref :aux car)
             (v9 unbound)
             (v10 box v9)
             (v11 closure v10 :aux f1)
             (v12 refine v0 :aux 1 :fact (fixnum 0 10))
             (branch v6 b1 b2))
         (b1 ()
             (try
               b3
               b4))
         (b2 () (call value v8 (v2) b5 :pos 9))
         (b3 () (v13 pop-try) (tail-call known f1 () :pos 10))
         (b4 ((v14 :name c)) (v15 raise v14) (unreachable))
         (b5 (v16) (v17 box-set v10 v16) (jump b6 v16 v17))
         (b6 (v18 v19) (return v18)))
       (fn f1
         "inner"
         :parent f0
         :params ()
         :signature (0 0 #f)
         :entry b7
         (b7 () (v20 self) (v21 box-ref v10) (return v21)))))

(check "everything round trips" everything (round-trip everything))
(check "everything verifies" #t (verify-text everything :converted))
(let ((x (text/read everything)))
  (check "const list" '(1 2) (ir/op-aux x 0))
  (check "names" 'x (ir/value-name x (car (ir/fn-params x 0))))
  (check "facts" #t (types/same-fact? (types/fixnum-fact 0 10) (ir/value-fact x (car (ir/fn-params x 0)))))
  (check "signature" [1 1 #f] (ir/fn-signature x 0))
  (check "closure aux is a function" 1 (ir/op-aux x 9))
  (check "call kind" :value (ir/term-call-kind x 2))
  (check "term pos" 9 (ir/term-pos x 2))
  (check "known callee" 1 (ir/term-callee x 3))
  (check "edge args" (ir/term-args x 5) (ir/edge-args x 5 0))
  (check "no edge args on branch" '() (ir/edge-args x 0 1))
  (check "succs of try" '(3 4) (ir/succs x 1))
  (check "value-def of a param" [:param 4 0] (ir/value-def x (car (ir/block-params x 4))))
  (check "value-fn" 1 (ir/value-fn x (ir/op-value x (car (ir/block-ops x 7))))))

;; An entry block that differs from the signature prints its own parameters.
(let ((bad-entry '(ir (fn f0
                        nil
                        :parent nil
                        :params (v0)
                        :signature (1 0 #f)
                        :entry b0
                        (b0 (v0 v1) (return v1))))))
  (check "entry with extra parameters round trips" bad-entry (round-trip bad-entry))
  (raises "and doesn't verify" "aren't the signature's" (verify-text bad-entry :converted)))

;; --- builder misuse ----------------------------------------------------------------

(let ((x (build-fib)))
  (raises "second terminator" "already ends in" (ir/return! x 1 0))
  (raises "emit after terminator" "already ends in" (ir/emit! x 1 'const '() 1))
  (raises "unknown block" "unknown block b99" (ir/emit! x 99 'const '() 1))
  (raises "unknown value" "unknown value v99" (ir/emit! x (ir/add-block! x 0) '+ '(0 99)))
  (raises "unknown function" "unknown function f5" (ir/add-block! x 5))
  (raises "unknown op" "unknown operation" (ir/op-code x 1000))
  (raises "IR code operand count" "box takes 1 operands" (ir/emit! x (ir/add-block! x 0) 'box '()))
  (raises "IR code aux" "global-ref needs a :cell aux" (ir/emit! x (ir/add-block! x 0) 'global-ref '() 'g))
  (raises "no aux" "takes no aux" (ir/emit! x (ir/add-block! x 0) 'box '(0) 5))
  (raises "closure of an unknown function" "closure needs a :fn aux" (ir/emit! x (ir/add-block! x 0) 'closure '() 7))
  (raises "call kind" "call kind must be" (ir/call! x (ir/add-block! x 0) :bogus 1 '() 1 nil))
  (raises "signature count" "has 1 parameters but the signature says 2" (ir/set-signature! x 0 '(0) 1 1 #f))
  (raises "entry in another function"
          "belongs to f1"
          (let ((g (ir/add-function! x "g" 0 nil))) (ir/set-entry! x 0 (ir/add-block! x g))))
  (let ((b (ir/add-block! x 0)))
    (ir/emit! x b 'raise '(0))
    (raises "op after raise" "must end in unreachable" (ir/emit! x b 'const '() 1))
    (raises "return after raise" "must end in unreachable" (ir/return! x b 0))
    (ir/unreachable! x b)
    (check "unreachable after raise" :unreachable (ir/term-kind x b))))

;; --- reader errors -----------------------------------------------------------------

(raises "reader: not an ir" "expected (ir" (text/read '(fn)))
(raises "reader: unknown value names the form"
        "unknown value v9 in (v1 + v0 v9)"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params (v0)
                          :signature (1 0 #f)
                          :entry b0
                          (b0 () (v1 + v0 v9) (return v1))))))
(raises "reader: duplicate value"
        "value v1 is defined twice"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v1 const 1) (v1 const 2) (return v1))))))
(raises "reader: terminator not last"
        "terminator must come last in its block in (return v1)"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v1 const 1) (return v1) (v2 const 2))))))
(raises "reader: unquoted symbol constant"
        "must be quoted"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v1 const x) (return v1))))))
(raises "reader: builder errors name the form"
        "box takes 1 operands, got 0 in (v1 box)"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v1 box) (return v1))))))
(raises "reader: bad annotation"
        "unknown annotation :bogus"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v1 const 1 :bogus 2) (return v1))))))
(raises "reader: bad fact names the form"
        "in (v0 const 1 :fact (bogus))"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (v0 const 1 :fact (bogus)) (return v0))))))
(raises "reader: parent must come first"
        "unknown function f1"
        (text/read '(ir (fn f0
                          nil
                          :parent f1
                          :params ()
                          :signature (0 0 #f)
                          :entry b0
                          (b0 () (unreachable)))
                        (fn f1
                          nil
                          :parent nil
                          :params ()
                          :signature (0 0 #f)
                          :entry b1
                          (b1 () (unreachable))))))
(raises "reader: bad terminator shape"
        "expected (branch value then else)"
        (text/read '(ir (fn f0
                          nil
                          :parent nil
                          :params (v0)
                          :signature (1 0 #f)
                          :entry b0
                          (b0 () (branch v0 b0))))))

;; --- analyses ----------------------------------------------------------------------

(def diamond
  (text/read '(ir (fn f0
                    nil
                    :parent nil
                    :params (v0)
                    :signature (1 0 #f)
                    :entry b0
                    (b0 () (branch v0 b1 b2))
                    (b1 () (jump b3))
                    (b2 () (jump b3))
                    (b3 () (return v0))))))

(check "diamond rpo" '(0 2 1 3) (ir/rpo diamond 0))
(check "diamond preds" '(1 2) (ir/preds diamond 3))
(check "diamond entry preds" '() (ir/preds diamond 0))
(check "diamond dominators" '(0 0 0 0) (block-map (ir/dominators diamond 0) 4))
(let ((d (ir/dominators diamond 0)))
  (check "diamond children, in rpo" '(2 1 3) (ir/dominated-children diamond d 0))
  (check "leaf has no children" '() (ir/dominated-children diamond d 3)))
(check "diamond depths" '(0 0 0 0) (block-map (ir/loop-depths diamond 0) 4))

(def simple-loop
  (text/read '(ir (fn f0
                    nil
                    :parent nil
                    :params (v0)
                    :signature (1 0 #f)
                    :entry b0
                    (b0 () (jump b1))
                    (b1 () (branch v0 b2 b3))
                    (b2 () (jump b1))
                    (b3 () (return v0))
                    (b4 () (jump b1))))))

(check "loop rpo skips unreachable" '(0 1 3 2) (ir/rpo simple-loop 0))
(check "loop preds include unreachable" '(0 2 4) (ir/preds simple-loop 1))
(check "loop dominators" '(0 0 1 1 nil) (block-map (ir/dominators simple-loop 0) 5))
(check "loop depths" '(0 1 1 0 nil) (block-map (ir/loop-depths simple-loop 0) 5))

(def nested-loops
  (text/read '(ir (fn f0
                    nil
                    :parent nil
                    :params (v0)
                    :signature (1 0 #f)
                    :entry b0
                    (b0 () (jump b1))
                    (b1 () (branch v0 b2 b6))
                    (b2 () (jump b3))
                    (b3 () (branch v0 b4 b5))
                    (b4 () (jump b3))
                    (b5 () (jump b1))
                    (b6 () (return v0))))))

(check "nested rpo" '(0 1 6 2 3 5 4) (ir/rpo nested-loops 0))
(check "nested dominators" '(0 0 1 2 3 3 1) (block-map (ir/dominators nested-loops 0) 7))
(check "nested depths" '(0 1 1 2 2 1 0) (block-map (ir/loop-depths nested-loops 0) 7))
(let ((d (ir/dominators nested-loops 0)))
  (check "nested children" '(6 2) (ir/dominated-children nested-loops d 1))
  (check "nested children of inner header" '(5 4) (ir/dominated-children nested-loops d 3))
  (check "dominates?" '(#t #f) (list (ir/dominates? nested-loops d 1 4) (ir/dominates? nested-loops d 4 5))))

;; A loop whose only way in skips the header's dominator chain: irreducible
;; cycles aren't loops.
(def irreducible
  (text/read '(ir (fn f0
                    nil
                    :parent nil
                    :params (v0)
                    :signature (1 0 #f)
                    :entry b0
                    (b0 () (branch v0 b1 b2))
                    (b1 () (jump b2))
                    (b2 () (jump b1))))))

(check "irreducible dominators" '(0 0 0) (block-map (ir/dominators irreducible 0) 3))
(check "irreducible depths" '(0 0 0) (block-map (ir/loop-depths irreducible 0) 3))

;; Edits invalidate the cached predecessors.
(let ((x (ir/new)))
  (let ((f (ir/add-function! x nil nil nil)))
    (let ((b0 (ir/add-block! x f))
          (b1 (ir/add-block! x f)))
      (check "no preds yet" '() (ir/preds x b1))
      (ir/jump! x b0 b1 '())
      (check "preds after an edit" '(0) (ir/preds x b1)))))

(let ((x (ir/new)))
  (let ((f (ir/add-function! x nil nil nil)))
    (let ((b0 (ir/add-block! x f))
          (b1 (ir/add-block! x f)))
      (let ((p (ir/add-param! x b0)))
        (let ((s (ir/emit! x b0 '+ (list p p))))
          (ir/call! x b0 :value p (list s) b1 nil)
          (let ((r (ir/add-param! x b1)))
            (ir/return! x b1 r)
            (let ((u (ir/uses x)))
              (check "uses of a param" (list [:op 0] [:op 0] [:term 0]) (u p))
              (check "uses of an op value" (list [:term 0]) (u s))
              (check "uses of a call result" (list [:term 1]) (u r))
              (check "uses are per value" (ir/value-count x) (length u)))))))))

;; Copying a function shell maps the parent.
(let ((from (text/read everything))
      (to (ir/new)))
  (let ((g (ir/copy-function-shell! from to 0))
        (h (ir/copy-function-shell! from to 1)))
    (check "copied shell" (list "inner" g) (list (ir/fn-name to h) (ir/fn-parent to h)))
    (check "copied-function" h (ir/copied-function to 1))
    (raises "copy twice" "already copied" (ir/copy-function-shell! from to 1))
    (raises "child before parent" "parent f0 first" (ir/copy-function-shell! from (ir/new) 1))))

;; A copy of fib through the usage pattern in ir.ot.
(let ((old fib)
      (out (ir/new)))
  (let ((vmap (column/filled (ir/value-count old) nil)))
    (for-each (fn (f)
                (let ((nf (ir/copy-function-shell! old out f))
                      (bmap {})
                      (order (ir/rpo old f)))
                  (for-each (fn (b)
                              (let ((nb (ir/add-block! out nf)))
                                (put! bmap b nb)
                                (for-each (fn (p) (put! vmap p (ir/add-param! out nb))) (ir/block-params old b))))
                            order)
                  (ir/set-entry! out nf (bmap (ir/fn-entry old f)))
                  (let ((sig (ir/fn-signature old f)))
                    (ir/set-signature! out nf (map vmap (ir/fn-params old f)) (sig 0) (sig 1) (sig 2)))
                  (for-each (fn (b)
                              (for-each (fn (o)
                                          (put! vmap
                                                (ir/op-value old o)
                                                (ir/emit! out
                                                          (bmap b)
                                                          (ir/op-code old o)
                                                          (map vmap (ir/op-args old o))
                                                          (ir/op-aux old o)
                                                          (ir/op-pos old o))))
                                        (ir/block-ops old b)))
                            order)
                  (for-each (fn (b) (ir/copy-term! old b out (bmap b) vmap bmap)) order)))
              (ir/functions old))
    (check "copy pattern reproduces fib, blocks in rpo"
           '(ir (fn f0
                  "fib"
                  :parent nil
                  :params (v0)
                  :signature (1 0 #f)
                  :entry b0
                  (b0 () (v1 const 2) (branch-prim < (v0 v1) b4 b1))
                  (b1 () (v2 const 1) (v3 - v0 v2) (call global 17 (v3) b2))
                  (b2 (v4) (v5 const 2) (v6 - v0 v5) (call global 17 (v6) b3))
                  (b3 (v7) (v8 + v4 v7) (return v8))
                  (b4 () (return v0))))
           (text/print out))
    (check "and verifies" #t (verify/check out :converted))))

;; --- verifier ----------------------------------------------------------------------

;; lint: allow(rest-arguments) test inputs take any number of blocks
(def- (one-fn params sig . blocks)
  (list 'ir (append (list 'fn 'f0 nil :parent nil :params params :signature sig :entry 'b0) blocks)))

(raises "verify: stage" "stage must be" (verify/check fib :later))
(raises "verify: no terminator"
        "block has no terminator"
        (verify-text (one-fn '() '(0 0 #f) '(b0 () (v0 const 1))) :converted))
(raises "verify: no entry"
        "function has no entry block"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params ()
                            :signature (0 0 #f)
                            :entry nil
                            (b0 () (unreachable))))
                     :converted))
(raises "verify: no signature"
        "function has no signature"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params ()
                            :signature nil
                            :entry b0
                            (b0 () (unreachable))))
                     :converted))
(raises "verify: successor in another function"
        "successor b1 belongs to f1"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params ()
                            :signature (0 0 #f)
                            :entry b0
                            (b0 () (jump b1)))
                          (fn f1
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b1
                            (b1 () (unreachable))))
                     :converted))
(raises "verify: jump argument count"
        "jump passes 1 values but b1 has 2 parameters"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (jump b1 v0)) '(b1 (v1 v2) (return v1))) :converted))
(raises "verify: call return block"
        "call returns to b1, which has no parameter"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (call value v0 () b1)) '(b1 () (return v0))) :converted))
(raises "verify: handler parameter"
        "handler b2 has no parameter"
        (verify-text (one-fn '(v0)
                             '(1 0 #f)
                             '(b0 ()
                                  (try
                                    b1
                                    b2))
                             '(b1 () (return v0))
                             '(b2 () (return v0)))
                     :converted))
(raises "verify: entry parameters"
        "aren't the signature's"
        (verify-text (one-fn '() '(0 0 #f) '(b0 (v0) (return v0))) :converted))
(raises "verify: known call arity"
        "f0 doesn't take 2 arguments"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (tail-call known f0 (v0 v0)))) :converted))
(check "verify: known call with a rest parameter"
       #t
       (verify-text (one-fn '(v0) '(0 0 #t) '(b0 () (tail-call known f0 (v0 v0)))) :converted))
(raises "verify: unknown primop"
        "unknown primop no-such-prim"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (v1 no-such-prim v0) (return v1))) :converted))
(raises "verify: unknown branch primop"
        "unknown primop no-such-prim"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (branch-prim no-such-prim (v0) b1 b1)) '(b1 () (return v0)))
                     :converted))
(raises "verify: primop arity"
        "car takes 1 arguments, got 2"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (v1 car v0 v0) (return v1))) :converted))
(raises "verify: branch primop arity"
        "< takes"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (branch-prim < () b1 b1)) '(b1 () (return v0))) :converted))

;; Dominance.
(raises "verify: use in a later block not dominated"
        "v1 is used where its definition doesn't dominate"
        (verify-text (one-fn '(v0)
                             '(1 0 #f)
                             '(b0 () (branch v0 b1 b2))
                             '(b1 () (v1 const 1) (jump b3))
                             '(b2 () (jump b3))
                             '(b3 () (return v1)))
                     :converted))
(raises "verify: use before definition in a block"
        "v2 is used where its definition doesn't dominate (in f0 b0: (v1 + v0 v2))"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (v2 + v0 v1) (v1 const 1) (return v2))) :converted))
(raises "verify: definition in an unreachable block"
        "v1 is used where"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (return v1)) '(b1 () (v1 const 1) (jump b0 v1))) :converted))
(check "verify: unreachable uses aren't checked"
       #t
       (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (return v0)) '(b1 () (return v1)) '(b2 () (v1 const 1) (jump b1)))
                    :converted))
(check "verify: loop-carried parameter"
       #t
       (verify-text (one-fn '(v0)
                            '(1 0 #f)
                            '(b0 () (jump b1 v0))
                            '(b1 (v1) (branch-prim < (v1 v0) b2 b3))
                            '(b2 () (v2 + v1 v0) (jump b1 v2))
                            '(b3 () (return v1)))
                    :converted))
(raises "verify: callee is a use"
        "v1 is used where"
        (verify-text (one-fn '(v0) '(1 0 #f) '(b0 () (tail-call value v1 ())) '(b1 () (v1 const 1) (return v1)))
                     :converted))

;; Uses from nested functions count at the closure that creates them.
(def- (nested order)
  (list 'ir
        (append '(fn f0
                   "outer"
                   :parent nil
                   :params (v0)
                   :signature (1 0 #f)
                   :entry b0)
                (list (append '(b0 ()) order '((return v1)))))
        '(fn f1
           "inner"
           :parent f0
           :params ()
           :signature (0 0 #f)
           :entry b1
           (b1 () (v3 + v0 v2) (return v3)))))

(check "verify: free variable defined before the closure"
       #t
       (verify-text (nested '((v2 const 1) (v1 closure :aux f1))) :converted))
(raises "verify: free variable defined after the closure"
        "v2 is used where its definition doesn't dominate"
        (verify-text (nested '((v1 closure :aux f1) (v2 const 1))) :converted))
(raises "verify: and the message names the closure"
        "through the closure in f0 b0: (v1 closure :aux f1)"
        (verify-text (nested '((v1 closure :aux f1) (v2 const 1))) :converted))

(def- (two-deep order)
  (list 'ir
        (append '(fn f0
                   "outer"
                   :parent nil
                   :params ()
                   :signature (0 0 #f)
                   :entry b0)
                (list (append '(b0 ()) order '((return v1)))))
        '(fn f1
           "middle"
           :parent f0
           :params ()
           :signature (0 0 #f)
           :entry b1
           (b1 () (v3 closure :aux f2) (return v3)))
        '(fn f2
           "inner"
           :parent f1
           :params ()
           :signature (0 0 #f)
           :entry b2
           (b2 () (return v2)))))

(check "verify: two levels, defined before" #t (verify-text (two-deep '((v2 const 1) (v1 closure :aux f1))) :converted))
(raises "verify: two levels, defined after"
        "v1 is used where its definition doesn't dominate (in f2 b2: (return v1), through the closure in f1 b1: (v2 closure :aux f2), through the closure in f0 b0: (v0 closure :aux f1))"
        (verify-text (two-deep '((v1 closure :aux f1) (v2 const 1))) :converted))

;; A middle function's own value used two levels down counts at f1's closure
;; of f2, not at f0's closure of f1.
(check "verify: value of the middle function"
       #t
       (verify-text '(ir (fn f0
                           nil
                           :parent nil
                           :params ()
                           :signature (0 0 #f)
                           :entry b0
                           (b0 () (v0 closure :aux f1) (return v0)))
                         (fn f1
                           nil
                           :parent f0
                           :params ()
                           :signature (0 0 #f)
                           :entry b1
                           (b1 () (v1 const 1) (v2 closure :aux f2) (return v2)))
                         (fn f2
                           nil
                           :parent f1
                           :params ()
                           :signature (0 0 #f)
                           :entry b2
                           (b2 () (return v1))))
                    :converted))
(raises "verify: value of a sibling"
        "belongs to f1, which doesn't enclose f2"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params ()
                            :signature (0 0 #f)
                            :entry b0
                            (b0 () (v0 closure :aux f1) (v1 closure :aux f2) (return v0)))
                          (fn f1
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b1
                            (b1 () (v2 const 1) (return v2)))
                          (fn f2
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b2
                            (b2 () (return v2))))
                     :converted))
(raises "verify: closure in one branch, value in the other"
        "through the closure in f0 b2"
        (verify-text (list 'ir
                           '(fn f0
                              nil
                              :parent nil
                              :params (v0)
                              :signature (1 0 #f)
                              :entry b0
                              (b0 () (branch v0 b1 b2))
                              (b1 () (v2 const 1) (return v2))
                              (b2 () (v1 closure :aux f1) (return v1)))
                           '(fn f1
                              nil
                              :parent f0
                              :params ()
                              :signature (0 0 #f)
                              :entry b3
                              (b3 () (return v2))))
                     :converted))

;; :closed
(raises "verify: closed, cross-function use"
        "after Closures functions use only their own values"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params ()
                            :signature (0 0 #f)
                            :entry b0
                            (b0 () (v0 const 1) (v1 static-closure :aux f1) (return v1)))
                          (fn f1
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b1
                            (b1 () (return v0))))
                     :closed))
(raises "verify: closed, closure remains"
        "closure appears after Closures"
        (verify-text (one-fn '() '(0 0 #f) '(b0 () (v0 closure :aux f0) (return v0))) :closed))
(raises "verify: converted, env-ref too early"
        "env-ref appears before Closures"
        (verify-text (one-fn '() '(0 0 #f) '(b0 () (v0 env-ref :aux 0) (return v0))) :converted))

(def- (closed-pair inner-ops)
  (list 'ir
        '(fn f0
           nil
           :parent nil
           :params (v0)
           :signature (1 0 #f)
           :entry b0
           (b0 () (v1 make-closure v0 v0 :aux f1) (return v1)))
        (list 'fn 'f1 nil :parent 'f0 :params '() :signature '(0 0 #f) :entry 'b1 (append '(b1 ()) inner-ops))))

(check "verify: closed, env-ref in range" #t (verify-text (closed-pair '((v2 env-ref :aux 1) (return v2))) :closed))
(raises "verify: closed, env-ref out of range"
        "env-ref 2 but the function has 2 captures"
        (verify-text (closed-pair '((v2 env-ref :aux 2) (return v2))) :closed))
(raises "verify: closed, env-ref without captures"
        "env-ref 0 but the function has 0 captures"
        (verify-text (one-fn '() '(0 0 #f) '(b0 () (v0 env-ref :aux 0) (return v0))) :closed))
(raises "verify: closed, capture counts disagree"
        "is made elsewhere with 2 captures"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params (v0)
                            :signature (1 0 #f)
                            :entry b0
                            (b0 () (v1 make-closure v0 v0 :aux f1) (v2 make-closure v0 :aux f1) (return v1)))
                          (fn f1
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b1
                            (b1 () (v3 env-ref :aux 0) (return v3))))
                     :closed))
(raises "verify: closed, static closure with captures"
        "has captures, so it can't have a static closure"
        (verify-text '(ir (fn f0
                            nil
                            :parent nil
                            :params (v0)
                            :signature (1 0 #f)
                            :entry b0
                            (b0 () (v1 make-closure v0 :aux f1) (v2 static-closure :aux f1) (return v1)))
                          (fn f1
                            nil
                            :parent f0
                            :params ()
                            :signature (0 0 #f)
                            :entry b1
                            (b1 () (v3 env-ref :aux 0) (return v3))))
                     :closed))
(check "verify: closed, static closure"
       #t
       (verify-text '(ir (fn f0
                           nil
                           :parent nil
                           :params ()
                           :signature (0 0 #f)
                           :entry b0
                           (b0 () (v0 static-closure :aux f1) (return v0)))
                         (fn f1
                           nil
                           :parent f0
                           :params ()
                           :signature (0 0 #f)
                           :entry b1
                           (b1 () (v1 self) (return v1))))
                    :closed))

(report "ir")
