(println "start")
(println (+ 1 2))
(def (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(println (fib 20))
(def (sum n) (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s i)))))
(println (sum 100))
(println (- 10 3) (* 6 7) (< 1 2) (> 1 2) (= 3 3))
(def (counter) (let ((n 0)) (fn () (set! n (+ n 1)) n)))
(def c (counter))
(c) (c)
(println (c))
(println (car '(1 2)) (cdr '(1 2)) (cons 1 2))
(def (opt a &optional (b 10)) (+ a b))
(println (opt 1) (opt 1 2))
(def (rst a . r) r)
(println (rst 1 2 3))
(println (map (fn (x) (* x x)) '(1 2 3)))
