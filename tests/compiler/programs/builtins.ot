;; Core builtins called directly, with inline fast paths, and transformed.

(def (show label x)
  (display label)
  (display " ")
  (write x)
  (newline))

(def (attempt label thunk)
  (show label (try (thunk) (catch e (list :error (condition-message e))))))

;; Direct calls to builtins, including wrong arguments.
(def (classify x) (list (symbol? x) (string? x) (number? x) (keyword? x)))
(show "classify" (map classify (list 'a "b" 3 :d)))
(attempt "string-length" (fn () (string-length 3)))
(attempt "arity" (fn () (apply symbol? '(1 2))))
(show "str" (str "a" 1 :b))
(show "many" (string-append "a" "b" "c" "d" "e" "f" "g" "h"))

;; list and append.
(def (effects)
  (let ((log []))
    (list (begin (push! log 1) :a) (begin (push! log 2) :b) (begin (push! log 3) :c) log)))
(show "list order" (effects))
(show "list 7" (list 1 2 3 4 5 6 7))
(show "append" (append '(1 2) '(3)))
(show "append empty" (append '() '(3)))
(attempt "append improper tail" (fn () (append (quote (1)) 2)))
(attempt "append improper" (fn () (append '(1 . 2) '(3))))
(attempt "append not a list" (fn () (append 1 '(3))))

;; set-car! and set-cdr!, including a frozen key and a non-pair.
(def p (cons 1 2))
(show "set-car!" (set-car! p 10))
(show "set-cdr!" (set-cdr! p '(20)))
(attempt "set-car! not a pair" (fn () (set-car! 5 1)))
(def t {})
(put! t (list 1 2) :x)
(attempt "set-cdr! frozen" (fn () (set-cdr! (get (keys t) 0) 3)))

;; get, put! and length on tables, arrays and strings.
(def a [1 2 3])
(def tbl {:k 1})
(show "get" (list (get a 1) (get tbl :k) (get tbl :missing) (get "abc" 1)))
(attempt "get out of range" (fn () (get a 9)))
(show "put!" (list (put! a 0 :z) (put! tbl :j 2)))
(show "length" (list (length a) (length tbl) (length "abcd") (length '(1 2))))
(attempt "length bad" (fn () (length 5)))

;; Type predicates and bitwise operations, inline natively.
(def samples (list nil #f #t 0 -5 4611686018427387903 1.5 #\a "s" 'sym :kw [1] {:a 1} '(1) '()
                   (make-bytevector 2 0) car))
(def (tests x)
  (list (nil? x) (int? x) (char? x) (number? x) (string? x) (symbol? x) (keyword? x) (array? x)
        (table? x) (bytevector? x) (float? x) (record? x)))
(show "predicates" (map tests samples))
(show "in tests" (map (fn (x) (cond ((nil? x) :nil) ((int? x) :int) ((string? x) :string) (else :other)))
                      samples))
(def (bits a b)
  (list (bitwise-and a b) (bitwise-ior a b) (bitwise-xor a b) (bitwise-not a)))
(show "bits" (map (fn (p) (bits (car p) (cdr p)))
                  (list (cons 12 10) (cons -1 5) (cons -12 -7) (cons 0 0)
                        (cons 4611686018427387903 -4611686018427387904))))
(def (shift n k) (bitwise-arithmetic-shift n k))
(show "shifts" (map (fn (k) (list (shift 1 k) (shift -1 k) (shift 12345 k) (shift -12345 k)))
                    '(0 1 2 7 30 48 -1 -2 -7 -61 -62 -63 -100)))
(show "shift limits" (list (shift 1 61) (shift -1 62) (shift 4611686018427387903 -61)
                           (shift (shift 1 61) -61)))
(attempt "shift overflow" (fn () (shift 1 62)))
(attempt "shift overflow 2" (fn () (shift 3 61)))
(attempt "shift overflow 3" (fn () (shift 12345 60)))
(attempt "shift too far" (fn () (shift 1 100)))
(attempt "shift a float" (fn () (shift 1.5 1)))
(attempt "and a float" (fn () (bitwise-and 1.5 1)))
(attempt "not a string" (fn () (bitwise-not "a")))
(show "equal transform" (map (fn (x) (case x ((:a) 1) ((2 #\c) 2) ((nil) 3) ((()) 4) (else 5)))
                             (list :a 2 #\c nil '() "a" 'a)))

;; Bytevector access, inline natively.
(def bv (make-bytevector 4 7))
(show "bytes" (list (bytevector-length bv) (bytevector-u8-ref bv 0) (bytevector-u8-ref bv 3)))
(bytevector-u8-set! bv 1 255)
(bytevector-u8-set! bv 2 0)
(show "set" (list (bytevector-u8-ref bv 1) (bytevector-u8-ref bv 2) (bytevector-u8-set! bv 3 9) bv))
(attempt "ref past end" (fn () (bytevector-u8-ref bv 4)))
(attempt "ref negative" (fn () (bytevector-u8-ref bv -1)))
(attempt "ref float index" (fn () (bytevector-u8-ref bv 1.0)))
(attempt "ref not bytes" (fn () (bytevector-u8-ref "abc" 0)))
(attempt "set too big" (fn () (bytevector-u8-set! bv 0 256)))
(attempt "set negative" (fn () (bytevector-u8-set! bv 0 -1)))
(attempt "set past end" (fn () (bytevector-u8-set! bv 4 1)))
(attempt "set char" (fn () (bytevector-u8-set! bv 0 #\a)))
(attempt "length not bytes" (fn () (bytevector-length [1 2])))
(show "empty" (bytevector-length (make-bytevector 0 0)))
(def (sum-bytes b)
  (let loop ((i 0) (total 0))
    (if (= i (bytevector-length b)) total (loop (+ i 1) (+ total (bytevector-u8-ref b i))))))
(show "sum" (sum-bytes bv))

;; push!, array literals, max and min, inline natively.
(def (grow n)
  (let ((a []))
    (dotimes (i n) (push! a (* i i)))
    a))
(show "push" (list (grow 0) (grow 1) (grow 9) (length (grow 1000)) (get (grow 1000) 999)))
(show "push returns" (let ((a [1])) (eq? (push! a 2) a)))
(attempt "push to table" (fn () (push! {} 5)))
(attempt "push to list" (fn () (push! '(1) 2)))
(def (lit x y) [x y (+ x y) :k "s" nil #f 1.5])
(show "literals" (list [] [1] (lit 1 2) (lit 5 6)))
(show "literal is fresh" (let ((a (lit 1 2)) (b (lit 1 2))) (push! a 9) (list a b)))
(show "literal length" (let ((a (lit 3 4))) (push! a 0) (list (length a) (get a 8))))
(def (many-arrays n) (let loop ((i 0) (acc '())) (if (= i n) (length acc) (loop (+ i 1) (cons [i i i] acc)))))
(show "allocating" (many-arrays 100000))
(show "extrema" (list (max 1 2) (max 2 1) (min 1 2) (min -3 -3) (max 4611686018427387903 -4611686018427387904)
                      (max 1 2.5) (min 1.5 1) (max 1 2 3)))
(attempt "max of a string" (fn () (max 1 "a")))
