;; Closures capture by value, boxes when assigned, fresh bindings per iteration.
(def (counter) (let ((n 0)) (fn () (set! n (+ n 1)) n)))
(def c (counter))
(c) (c)
(println (c))
(def (thunks) (let loop ((i 0) (acc '())) (if (= i 3) acc (loop (+ i 1) (cons (fn () i) acc)))))
(println (map (fn (f) (f)) (thunks)))
(def (adders) (map (fn (n) (fn (x) (+ x n))) '(1 10 100)))
(println (map (fn (f) (f 1)) (adders)))
(def (even-odd n)
  (def (ev? n) (if (= n 0) #t (od? (- n 1))))
  (def (od? n) (if (= n 0) #f (ev? (- n 1))))
  (list (ev? n) (od? n)))
(println (even-odd 10) (even-odd 7))
(def (opt a &optional (b (* a 2)) (c (+ a b))) (list a b c))
(println (opt 1) (opt 1 5) (opt 1 5 9))
(def (rest a . more) (list a more))
(println (rest 1) (rest 1 2 3) (apply rest 1 '(4 5)))
(def (many a b c d e f g h) (list h g f e d c b a))
(println (many 1 2 3 4 5 6 7 8) (apply many '(1 2 3 4 5 6 7 8)))
(def (tail-count n acc) (if (= n 0) acc (tail-count (- n 1) (+ acc 1))))
(println (tail-count 1000000 0))
(def (build n) (if (= n 0) '() (cons n (build (- n 1)))))
(println (length (build 10000)))
(defgeneric (area shape))
(defclass Square (side :init 1))
(defmethod (area (s Square)) (* (s :side) (s :side)))
(println (area (make Square :side 3)))
