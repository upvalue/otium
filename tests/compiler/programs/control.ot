;; try, defer, handlers, restarts and params, natively and on the VM.
(def (safe-car x) (try (car x) (catch (error? e) (list 'caught (condition-message e)))))
(println (safe-car '(1 2)) (safe-car 5))
(def log [])
(def (with-cleanup n)
  (defer (if (< n 0) (error "negative") n)
    (push! log n)))
(println (with-cleanup 3) (try (with-cleanup -1) (catch e 'failed)) log)
(defparam depth 0)
(def (show-depth) (depth))
(println (show-depth) (with-params ((depth 5)) (show-depth)) (show-depth))
(def seen [])
(println (try (handler-bind ((error? (fn (c) (push! seen (condition-message c)))))
                (error "boom"))
              (catch e 'unwound))
         seen)
(println (restart-case (invoke-restart 'use-value 42)
           (use-value (v) (* v 2))))
(println (restart-case (handler-bind ((error? (fn (c) (invoke-restart 'retry 7))))
                         (error "need retry"))
           (retry (n) (list 'retried n))))
(def (nested n)
  (try (if (= n 0) (error "bottom") (nested (- n 1)))
       (catch (error? e) (if (= n 3) (list 'caught-at n) (error "again")))))
(println (try (nested 5) (catch e 'outer)))
(println (try (raise-it) (catch e 'unbound)))
