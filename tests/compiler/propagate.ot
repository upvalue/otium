;; Propagate on hand-written block IR: folding, branches, ranges,
;; specialization, CSE, dead code, known calls, fuel.
(require (otium.test :refer (check report))
         (otium.compiler.core :as core)
         (otium.compiler.inline :as inline)
         (otium.compiler.convert :as convert)
         (otium.compiler.ir :as ir)
         (otium.compiler.ir-text :as text)
         (otium.compiler.propagate :as propagate)
         (otium.compiler.types :as types)
         (otium.compiler.verify :as verify))

(def- (fact-free e)
  "e, or v for a parameter written (v :fact f)."
  (if (and (pair? e) (symbol? (car e)) (pair? (cdr e)) (eq? (cadr e) :fact) (null? (cddr (cdr e))))
      (car e)
      (strip-facts e)))

(def- (strip-facts d)
  "d without :fact annotations, and parameters written (v :fact f) as v."
  (cond
    ((not (pair? d)) d)
    ((eq? (car d) :fact) (strip-facts (cddr d)))
    (else (cons (fact-free (car d)) (strip-facts (cdr d))))))

(def- (optimize d)
  "Propagate the IR d, check the result verifies, and print it without facts."
  (let ((out (propagate/run (text/read d))))
    (verify/check out :converted)
    (strip-facts (text/print out))))

(def- (optimize-with-facts d)
  (let ((out (propagate/run (text/read d))))
    (verify/check out :converted)
    (text/print out)))

(def- (show d)
  (for-each (fn (f)
              (write f)
              (newline))
            (cdr d)))

(defmacro expect (label input expected)
  #`(let ((got# (optimize ,input)))
      (unless (equal? got# ,expected) (show got#))
      (check ,label ,expected got#)))

(def- (one-fn name params sig & blocks) ; lint: allow(rest-arguments) tests list blocks inline
  (list 'ir (append (list 'fn 'f0 name :parent nil :params params :signature sig :entry 'b0) blocks)))

;; --- a counting loop -------------------------------------------------------------

;; i runs from 0 while (< i n), n a length: i stays below fixnum-max, so the
;; increment can't overflow and the comparison is of fixnums.
(def- counting
  (one-fn "count"
          '(v0)
          '(1 0 #f)
          '(b0 () (v1 const 0) (v2 length v0) (jump b1 v1))
          '(b1 (v3) (branch-prim < (v3 v2) b2 b3))
          '(b2 () (v4 const 1) (v5 + v3 v4) (jump b1 v5))
          '(b3 () (return v3))))

(expect "counting loop specializes"
        counting
        '(ir (fn f0
               "count"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 const 0) (v2 length v0) (jump b1 v1))
               (b1 (v3) (branch-prim %fx< (v3 v2) b2 b3))
               (b2 () (v4 const 1) (v5 %fx+/no-overflow v3 v4) (jump b1 v5))
               (b3 () (return v3)))))

(check "counting loop facts"
       '(ir (fn f0
              "count"
              :parent nil
              :params ((v0 :fact any))
              :signature (1 0 #f)
              :entry b0
              (b0 () (v1 const 0 :fact (const 0)) (v2 length v0 :fact (fixnum 0 4611686018427387903)) (jump b1 v1))
              (b1 ((v3 :fact (fixnum 0 4611686018427387903))) (branch-prim %fx< (v3 v2) b2 b3))
              (b2 ()
                  (v4 const 1 :fact (const 1))
                  (v5 %fx+/no-overflow v3 v4 :fact (fixnum 1 4611686018427387903))
                  (jump b1 v5))
              (b3 () (return v3))))
       (optimize-with-facts counting))

;; Without a bound on n the increment may wrap.
(expect "counting against anything"
        (one-fn "count"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 const 0) (jump b1 v1))
                '(b1 (v3) (branch-prim < (v3 v0) b2 b3))
                '(b2 () (v4 const 1) (v5 + v3 v4) (jump b1 v5))
                '(b3 () (return v3)))
        '(ir (fn f0
               "count"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 const 0) (jump b1 v1))
               (b1 (v2) (branch-prim < (v2 v0) b2 b3))
               (b2 () (v3 const 1) (v4 %fx+ v2 v3) (jump b1 v4))
               (b3 () (return v2)))))

;; Counting down to 0 by 1 from a length: (- i 1) stays in range too.
(expect "counting down"
        (one-fn "down"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 length v0) (jump b1 v1))
                '(b1 (v2) (v3 const 0) (branch-prim > (v2 v3) b2 b3))
                '(b2 () (v4 const 1) (v5 - v2 v4) (jump b1 v5))
                '(b3 () (return v2)))
        '(ir (fn f0
               "down"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 length v0) (jump b1 v1))
               (b1 (v2) (v3 const 0) (branch-prim %fx> (v2 v3) b2 b3))
               (b2 () (v4 const 1) (v5 %fx-/no-overflow v2 v4) (jump b1 v5))
               (b3 () (return v2)))))

;; --- constants -------------------------------------------------------------------

;; x enters the loop as 5 and goes round unchanged, so it's 5 everywhere and
;; its parameter goes away.
(expect "constant through a loop parameter"
        (one-fn "k"
                '()
                '(0 0 #f)
                '(b0 () (v0 const 5) (v1 const 0) (jump b1 v0 v1))
                '(b1 (v2 v3) (v4 const 10) (branch-prim < (v3 v4) b2 b3))
                '(b2 () (v5 const 1) (v6 + v3 v5) (jump b1 v2 v6))
                '(b3 () (v7 const 2) (v8 * v2 v7) (return v8)))
        '(ir (fn f0
               "k"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 0) (jump b1 v0))
               (b1 (v1) (v2 const 10) (branch-prim %fx< (v1 v2) b2 b3))
               (b2 () (v3 const 1) (v4 %fx+/no-overflow v1 v3) (jump b1 v4))
               (b3 () (v5 const 10) (return v5)))))

(expect "folding"
        (one-fn "fold"
                '()
                '(0 0 #f)
                '(b0 ()
                     (v0 const 1)
                     (v1 const 2)
                     (v2 + v0 v1)
                     (v3 const "abc")
                     (v4 string-length v3)
                     (v5 * v2 v4)
                     (return v5)))
        '(ir (fn f0
               "fold"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 9) (return v0)))))

;; A constant replaces a value, not an identity: a quoted list stays itself.
(expect "no constant for a pair"
        (one-fn "pair" '() '(0 0 #f) '(b0 () (v0 const '(1 2)) (jump b1 v0)) '(b1 (v1) (return v1)))
        '(ir (fn f0
               "pair"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const '(1 2)) (jump b1 v0))
               (b1 (v1) (return v1)))))

;; --- branches --------------------------------------------------------------------

(expect "branch on a constant"
        (one-fn "b"
                '()
                '(0 0 #f)
                '(b0 () (v0 const #t) (branch v0 b1 b2))
                '(b1 () (v1 const 1) (return v1))
                '(b2 () (v2 const 2) (return v2)))
        '(ir (fn f0
               "b"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (jump b1))
               (b1 () (v0 const 1) (return v0)))))

;; The join after a folded branch sees only the taken side's value.
(expect "folded branch feeds its join"
        (one-fn "j"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 const 3) (v2 const 4) (branch-prim < (v1 v2) b1 b2))
                '(b1 () (v3 const 10) (jump b3 v3))
                '(b2 () (jump b3 v0))
                '(b3 (v4) (v5 const 1) (v6 + v4 v5) (return v6)))
        '(ir (fn f0
               "j"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (jump b1))
               (b1 () (jump b2))
               (b2 () (v1 const 11) (return v1)))))

;; A comparison that can only raise keeps both arms, so it still raises.
(expect "raising comparison stays"
        (one-fn "r"
                '()
                '(0 0 #f)
                '(b0 () (v0 const "a") (v1 const 1) (branch-prim < (v0 v1) b1 b2))
                '(b1 () (return v1))
                '(b2 () (return v0)))
        '(ir (fn f0
               "r"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const "a") (v1 const 1) (branch-prim < (v0 v1) b1 b2))
               (b1 () (return v1))
               (b2 () (return v0)))))

;; The truthy arm of a branch knows its test isn't false or nil.
(expect "branch refines its test"
        (one-fn "t"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 not v0) (branch v0 b1 b2))
                '(b1 () (v2 not v0) (return v2))
                '(b2 () (v3 not v0) (return v3)))
        '(ir (fn f0
               "t"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (branch v0 b1 b2))
               (b1 () (v1 const #f) (return v1))
               (b2 () (v2 const #t) (return v2)))))

;; --- specialization --------------------------------------------------------------

(expect "car after pair?"
        (one-fn "c"
                '(v0)
                '(1 0 #f)
                '(b0 () (branch-prim pair? (v0) b1 b2))
                '(b1 () (v1 refine v0 :aux 4) (v2 car v1) (v3 cdr v0) (v4 cons v2 v3) (return v4))
                '(b2 () (v5 car v0) (return v5)))
        '(ir (fn f0
               "c"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (branch-prim pair? (v0) b1 b2))
               (b1 () (v1 %car v0) (v2 %cdr v0) (v3 cons v1 v2) (return v3))
               (b2 () (v4 car v0) (return v4)))))

;; car of something that can't be a pair always raises: it stays, and so does
;; the code after it, since the analysis knows it never runs.
(expect "car of a number"
        (one-fn "c" '() '(0 0 #f) '(b0 () (v0 const 1) (v1 car v0) (return v1)))
        '(ir (fn f0
               "c"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 1) (v1 car v0) (return v1)))))

(expect "float arithmetic"
        (one-fn "fl"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 refine v0 :aux 2) (v2 * v1 v1) (branch-prim < (v2 v1) b1 b2))
                '(b1 () (return v2))
                '(b2 () (return v1)))
        '(ir (fn f0
               "fl"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 refine v0 :aux 2) (v2 %fl* v1 v1) (branch-prim %fl< (v2 v1) b1 b2))
               (b1 () (return v2))
               (b2 () (return v1)))))

;; --- CSE and dead code -----------------------------------------------------------

;; eq? in b0 serves b1, which it dominates. pair? in b1 doesn't serve its
;; sibling b2.
(expect "CSE is scoped by dominators"
        (one-fn "cse"
                '(v0 v1)
                '(2 0 #f)
                '(b0 () (v2 eq? v0 v1) (branch v2 b1 b2))
                '(b1 () (v3 eq? v0 v1) (v4 pair? v1) (v5 cons v3 v4) (return v5))
                '(b2 () (v6 pair? v1) (return v6)))
        '(ir (fn f0
               "cse"
               :parent nil
               :params (v0 v1)
               :signature (2 0 #f)
               :entry b0
               (b0 () (v2 eq? v0 v1) (branch v2 b1 b2))
               (b1 () (v3 pair? v1) (v4 cons v2 v3) (return v4))
               (b2 () (v5 pair? v1) (return v5)))))

(expect "CSE of a pure op"
        (one-fn "cse"
                '(v0 v1)
                '(2 0 #f)
                '(b0 () (v2 eq? v0 v1) (jump b1))
                '(b1 () (v3 eq? v0 v1) (v4 cons v2 v3) (return v4)))
        '(ir (fn f0
               "cse"
               :parent nil
               :params (v0 v1)
               :signature (2 0 #f)
               :entry b0
               (b0 () (v2 eq? v0 v1) (jump b1))
               (b1 () (v3 cons v2 v2) (return v3)))))

(expect "no CSE of cons"
        (one-fn "cons" '(v0 v1) '(2 0 #f) '(b0 () (v2 cons v0 v1) (v3 cons v0 v1) (v4 eq? v2 v3) (return v4)))
        '(ir (fn f0
               "cons"
               :parent nil
               :params (v0 v1)
               :signature (2 0 #f)
               :entry b0
               (b0 () (v2 cons v0 v1) (v3 cons v0 v1) (v4 eq? v2 v3) (return v4)))))

;; Unused pure operations go; unused ones that may raise or write stay.
(expect "dead code"
        (one-fn "dead"
                '(v0 v1)
                '(2 0 #f)
                '(b0 ()
                     (v2 cons v0 v1)
                     (v3 eq? v0 v1)
                     (v4 not v3)
                     (v5 car v0)
                     (v6 + v0 v1)
                     (v7 set-car! v0 v1)
                     (v8 global-ref :aux 3)
                     (return v1)))
        '(ir (fn f0
               "dead"
               :parent nil
               :params (v0 v1)
               :signature (2 0 #f)
               :entry b0
               (b0 () (v2 car v0) (v3 + v0 v1) (v4 set-car! v0 v1) (v5 global-ref :aux 3) (return v1)))))

;; Loop parameters feeding operations that may raise stay.
(expect "parameters of ops that may raise"
        (one-fn "spin"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 const 0) (jump b1 v1 v1))
                '(b1 (v2 v3) (v4 const 1) (v5 + v3 v4) (v6 + v2 v4) (branch v0 b2 b3))
                '(b2 () (jump b1 v6 v5))
                '(b3 () (return v0)))
        '(ir (fn f0
               "spin"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 const 0) (jump b1 v1 v1))
               (b1 (v2 v3) (v4 const 1) (v5 %fx+ v3 v4) (v6 %fx+ v2 v4) (branch v0 b2 b3))
               (b2 () (jump b1 v6 v5))
               (b3 () (return v0)))))

;; A parameter only its own loop uses goes, with the values that fed it.
(expect "dead loop parameter"
        (one-fn "spin"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 const #f) (jump b1 v1))
                '(b1 (v2) (v3 not v2) (branch v0 b2 b3))
                '(b2 () (jump b1 v3))
                '(b3 () (return v0)))
        '(ir (fn f0
               "spin"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (jump b1))
               (b1 () (branch v0 b2 b3))
               (b2 () (jump b1))
               (b3 () (return v0)))))

;; length of nil or () is 0, but length may raise, so it stays and a
;; constant takes its uses.
(expect "constant after an op that may raise"
        (one-fn "len"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 refine v0 :aux 24) (v2 length v1) (v3 const 1) (v4 + v2 v3) (return v4)))
        '(ir (fn f0
               "len"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 refine v0 :aux 24) (v2 length v1) (v3 const 1) (return v3)))))

;; error never returns, so its result never reaches the branch.
(expect "branch on a value that never arrives"
        (one-fn "e" '(v0) '(1 0 #f) '(b0 () (v1 error v0) (branch v1 b1 b2)) '(b1 () (return v0)) '(b2 () (return v1)))
        '(ir (fn f0
               "e"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 error v0) (unreachable)))))

;; The entry is also reached by the call, so the branch back to it says
;; nothing there.
(expect "no refinement at the entry"
        (one-fn "back"
                '()
                '(0 0 #f)
                '(b0 () (jump b1))
                '(b1 () (v0 global-ref :aux 3) (v1 not v0) (branch v0 b2 b0))
                '(b2 () (return v1)))
        '(ir (fn f0
               "back"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (jump b1))
               (b1 () (v0 global-ref :aux 3) (v1 not v0) (branch v0 b2 b0))
               (b2 () (return v1)))))

;; In the arm where (= x 5) holds, x is 5.
(expect "equality narrows"
        (one-fn "eq"
                '(v0)
                '(1 0 #f)
                '(b0 () (v1 length v0) (v2 const 5) (branch-prim = (v1 v2) b1 b2))
                '(b1 () (v3 const 1) (v4 + v1 v3) (return v4))
                '(b2 () (return v1)))
        '(ir (fn f0
               "eq"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 length v0) (v2 const 5) (branch-prim %fx= (v1 v2) b1 b2))
               (b1 () (v3 const 6) (return v3))
               (b2 () (return v1)))))

;; --- checks ----------------------------------------------------------------------

(expect "check-bound of a closure goes; of a box read stays"
        '(ir (fn f0
               "cb"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 ()
                   (v0 unbound)
                   (v1 box v0)
                   (v2 closure :aux f1)
                   (v3 check-bound v2)
                   (v4 box-ref v1)
                   (v5 check-bound v4)
                   (v6 cons v3 v5)
                   (return v6)))
             (fn f1
               "inner"
               :parent f0
               :params ()
               :signature (0 0 #f)
               :entry b1
               (b1 () (v7 const 1) (return v7))))
        '(ir (fn f0
               "cb"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 ()
                   (v0 unbound)
                   (v1 box v0)
                   (v2 closure :aux f1)
                   (v3 box-ref v1)
                   (v4 check-bound v3)
                   (v5 cons v2 v4)
                   (return v5)))
             (fn f1
               "inner"
               :parent f0
               :params ()
               :signature (0 0 #f)
               :entry b1
               (b1 () (v6 const 1) (return v6)))))

;; An optional parameter: bound? on an entry parameter is unknown, but the
;; default arm's constant joins with it.
(expect "optional parameter"
        (one-fn "opt"
                '(v0)
                '(0 1 #f)
                '(b0 () (v3 bound? v0) (branch v3 b1 b2))
                '(b1 () (jump b3 v0))
                '(b2 () (v1 const 3) (jump b3 v1))
                '(b3 (v2) (return v2)))
        '(ir (fn f0
               "opt"
               :parent nil
               :params (v0)
               :signature (0 1 #f)
               :entry b0
               (b0 () (v1 bound? v0) (branch v1 b1 b2))
               (b1 () (jump b3 v0))
               (b2 () (v2 const 3) (jump b3 v2))
               (b3 (v3) (return v3)))))

;; --- functions and calls ---------------------------------------------------------

(expect "a call of a closure becomes known"
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 2) (v1 closure :aux f1) (call value v1 (v0) b1))
               (b1 (v2) (tail-call value v1 (v2))))
             (fn f1
               "inner"
               :parent f0
               :params (v3)
               :signature (1 0 #f)
               :entry b2
               (b2 () (return v3))))
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 2) (v1 closure :aux f1) (call known f1 (v0) b1))
               (b1 (v2) (tail-call known f1 (v2))))
             (fn f1
               "inner"
               :parent f0
               :params (v3)
               :signature (1 0 #f)
               :entry b2
               (b2 () (return v3)))))

(expect "a call with the wrong count stays a value call"
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v1 closure :aux f1) (tail-call value v1 ())))
             (fn f1
               "inner"
               :parent f0
               :params (v3)
               :signature (1 0 #f)
               :entry b2
               (b2 () (return v3))))
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 closure :aux f1) (tail-call value v0 ())))
             (fn f1
               "inner"
               :parent f0
               :params (v1)
               :signature (1 0 #f)
               :entry b1
               (b1 () (return v1)))))

(expect "self calls become known"
        (one-fn "loop" '(v0) '(1 0 #f) '(b0 () (v1 self) (tail-call value v1 (v0))))
        '(ir (fn f0
               "loop"
               :parent nil
               :params (v0)
               :signature (1 0 #f)
               :entry b0
               (b0 () (v1 self) (tail-call known f0 (v0))))))

;; A nested function sees its parent's facts; a function no live closure
;; creates goes.
(expect "nested functions"
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 const 2) (v1 const 3) (v2 + v0 v1) (v3 closure :aux f1) (v4 closure :aux f2) (return v3)))
             (fn f1
               "used"
               :parent f0
               :params ()
               :signature (0 0 #f)
               :entry b1
               (b1 () (v5 + v2 v2) (return v5)))
             (fn f2
               "unused"
               :parent f0
               :params ()
               :signature (0 0 #f)
               :entry b2
               (b2 () (return v2))))
        '(ir (fn f0
               "outer"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 () (v0 closure :aux f1) (return v0)))
             (fn f1
               "used"
               :parent f0
               :params ()
               :signature (0 0 #f)
               :entry b1
               (b1 () (v1 const 10) (return v1)))))

;; Call results and handler conditions are unknown; a try body and handler
;; both stay.
(expect "calls and handlers"
        (one-fn "try"
                '()
                '(0 0 #f)
                '(b0 ()
                     (try
                       b1
                       b2))
                '(b1 () (v0 const 1) (call global 7 (v0) b3))
                '(b2 (v1) (v2 raise v1) (unreachable))
                '(b3 (v3) (v4 pop-try) (v5 not v3) (return v5)))
        '(ir (fn f0
               "try"
               :parent nil
               :params ()
               :signature (0 0 #f)
               :entry b0
               (b0 ()
                   (try
                     b1
                     b2))
               (b1 () (v0 const 1) (call global 7 (v0) b3))
               (b2 (v1) (v2 raise v1) (unreachable))
               (b3 (v3) (v4 pop-try) (v5 not v3) (return v5)))))

;; --- fuel ------------------------------------------------------------------------

(def- fuel-input
  (one-fn "fuel"
          '(v0)
          '(1 0 #f)
          '(b0 () (v1 const 1) (v2 const 2) (v3 + v1 v2) (v4 eq? v0 v0) (v5 eq? v0 v0) (v6 cons v4 v5) (return v3))))

(check "no fuel copies"
       '(ir (fn f0
              "fuel"
              :parent nil
              :params (v0)
              :signature (1 0 #f)
              :entry b0
              (b0 () (v1 const 1) (v2 const 2) (v3 + v1 v2) (v4 eq? v0 v0) (v5 eq? v0 v0) (v6 cons v4 v5) (return v3))))
       (begin
         (propagate/set-fuel! 0)
         (optimize fuel-input)))

(check "one rewrite"
       '(ir (fn f0
              "fuel"
              :parent nil
              :params (v0)
              :signature (1 0 #f)
              :entry b0
              (b0 () (v1 const 1) (v2 const 2) (v3 const 3) (v4 eq? v0 v0) (v5 eq? v0 v0) (v6 cons v4 v5) (return v3))))
       (begin
         (propagate/set-fuel! 1)
         (optimize fuel-input)))

(check "fuel is spent" 0 (propagate/fuel-left))

(check "fuel off"
       '(ir (fn f0
              "fuel"
              :parent nil
              :params (v0)
              :signature (1 0 #f)
              :entry b0
              (b0 () (v1 const 3) (return v1))))
       (begin
         (propagate/set-fuel! nil)
         (optimize fuel-input)))

;; Every count of fuel gives IR that verifies.
(let ((inputs (list counting fuel-input)))
  (dotimes (n 12)
    (for-each (fn (d)
                (propagate/set-fuel! n)
                (check (str "fuel " n " verifies") #t (verify/check (propagate/run (text/read d)) :converted)))
              inputs))
  (propagate/set-fuel! nil))

;; --- Convert's output -------------------------------------------------------------
;;
;; Every form of a few benchmark ports, through Resolve, Inline and Convert,
;; propagates to IR that verifies.

(def- (forms-of path)
  (let ((port (open-input-string (read-file path))))
    (let loop ((x (read port))
               (out '()))
      (if (eof-object? x)
          (reverse out)
          (loop (read port) (cons x out))))))

(let ((failures [])
      (count 0))
  (for-each (fn (name)
              (let ((path (str "benchmarks/r7rs/ports/" name ".ot")))
                (for-each (fn (form)
                            (try
                              (let ((x (convert/run (inline/run (core/resolve (macroexpand-all form) 'user)))))
                                (verify/check (propagate/run x) :converted)
                                (set! count (+ count 1)))
                              (catch e
                                (unless (core/unsupported? e) (push! failures (list path (condition-message e)))))))
                          (forms-of path))))
            '(earley nboyer peval simplex ray fft quicksort))
  (check "benchmark forms propagate and verify" '() (array-to-list failures))
  (check "benchmark forms were converted" #t (> count 90)))

(report "propagate")
