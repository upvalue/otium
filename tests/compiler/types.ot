;; Type facts: the lattice operations, range arithmetic, and their laws on
;; random facts.
(require (otium.test :refer (check report)) (otium.compiler.types :as t))

(def (datum f)
  (t/fact->datum f))

(def- big t/fixnum-max)

(def- small t/fixnum-min)

;; The fixnum range is the C runtime's.
(check "fixnum-max" 4611686018427387903 big)
(check "fixnum-min" (- -4611686018427387903 1) small)
(check "fixnum-max wraps" small (+ big 1))

;; Checked arithmetic
(check "checked+ fits" 3 (t/checked+ 1 2))
(check "checked+ overflow" nil (t/checked+ big 1))
(check "checked+ underflow" nil (t/checked+ small -1))
(check "checked+ at the edge" big (t/checked+ (- big 1) 1))
(check "checked- overflow" nil (t/checked- small 1))
(check "checked- of min" nil (t/checked- 0 small))
(check "checked- to max" big (t/checked- -1 small))
(check "checked* fits" -15 (t/checked* 3 -5))
(check "checked* overflow" nil (t/checked* big 2))
(check "checked* min by -1" nil (t/checked* small -1))
(check "checked* -1 by min" nil (t/checked* -1 small))
(check "checked* min by 1" small (t/checked* small 1))
(check "checked* large" nil (t/checked* 3037000500 3037000500))
(check "checked* just fits" (* 2147483648 2147483647) (t/checked* 2147483648 2147483647))
(check "checked* half range" small (t/checked* 2 (quotient small 2)))
(check "checked* half range overflow" nil (t/checked* -2 (quotient small 2)))
(check "checked-negate" nil (t/checked-negate small))

;; Making facts
(check "fact defaults to the full range"
       (list t/t-fixnum small big)
       (list (t/fact-bits (t/fact t/t-fixnum)) (t/fact-lo (t/fact t/t-fixnum)) (t/fact-hi (t/fact t/t-fixnum))))
(check "non-fixnum facts have the full range"
       (list small big)
       (list (t/fact-lo (t/fact t/t-pair 0 1)) (t/fact-hi (t/fact t/t-pair 0 1))))
(check "empty range drops the fixnum bit" t/t-float (t/fact-bits (t/fact t/t-number 5 1)))
(check "empty fixnum range is none" #t (t/none? (t/fact t/t-fixnum 5 1)))
(check "one-number range is a constant" 7 (t/fact-const (t/fact t/t-fixnum 7 7)))
(check "nil is a constant" '(const nil) (datum (t/fact t/t-nil)))
(check "() is a constant" '(const ()) (datum (t/fact t/t-empty)))
(check "#f is a constant" '(const #f) (datum (t/fact t/t-false)))
(check "#t is a constant" '(const #t) (datum (t/fact t/t-true)))
(check "a boolean isn't" #f (t/const? (t/fact t/t-boolean)))
(check "const-fact of a fixnum" '(const 5) (datum (t/const-fact 5)))
(check "const-fact range" (list 5 5) (list (t/fact-lo (t/const-fact 5)) (t/fact-hi (t/const-fact 5))))
(check "const-fact of a string" t/t-string (t/fact-bits (t/const-fact "a")))
(check "no-const" t/no-const (t/fact-const t/any))
(check "any" 'any (datum t/any))
(check "none" 'none (datum t/none))

(check "value-bits"
       (list t/t-fixnum
             t/t-float
             t/t-pair
             t/t-empty
             t/t-nil
             t/t-false
             t/t-true
             t/t-char
             t/t-string
             t/t-symbol
             t/t-keyword
             t/t-array
             t/t-table
             t/t-procedure
             t/t-procedure
             t/t-other
             t/t-other)
       (map t/value-bits
            (list 1 1.5 '(1) '() nil #f #t #\a "s" 's :k [1] {:a 1} car (fn (x) x) (bytevector 1) (eof-object))))

;; Predicates on facts
(check "only?" #t (t/only? (t/fact t/t-fixnum) t/t-number))
(check "not only?" #f (t/only? (t/fact t/t-number) t/t-fixnum))
(check "never?" #t (t/never? (t/fact t/t-pair) t/t-number))
(check "not never?" #f (t/never? t/any t/t-pair))
(check "only? none" #t (t/only? t/none t/t-pair))
(check "truthiness of truthy" #t (t/truthiness (t/fact t/t-pair)))
(check "truthiness of falsy" #f (t/truthiness (t/fact t/t-falsy)))
(check "truthiness unknown" nil (t/truthiness t/any))

;; Constants
(check "same-const? -0.0" #f (t/same-const? -0.0 0.0))
(check "same-const? NaN" #t (t/same-const? (- (* 1e300 1e300) (* 1e300 1e300)) (- (* 1e300 1e300) (* 1e300 1e300))))
(check "same-const? floats" #t (t/same-const? 1.5 (+ 1.0 0.5)))
(check "same-const? fixnum and float" #f (t/same-const? 1 1.0))
(check "admits? in range" #t (t/admits? (t/fixnum-fact 0 10) 10))
(check "admits? out of range" #f (t/admits? (t/fixnum-fact 0 10) 11))
(check "admits? constant" #f (t/admits? (t/const-fact 'a) 'b))

;; join, meet, subfact?, widen
(check "join ranges" '(fixnum 1 5) (datum (t/join (t/const-fact 1) (t/const-fact 5))))
(check "join types" '(fixnum 1 1 float) (datum (t/join (t/const-fact 1) (t/const-fact 1.5))))
(check "join same constant" '(const a) (datum (t/join (t/const-fact 'a) (t/const-fact 'a))))
(check "join different constants" '(symbol) (datum (t/join (t/const-fact 'a) (t/const-fact 'b))))
(check "join with none" '(const 3) (datum (t/join t/none (t/const-fact 3))))
(check "join with none on the right" '(const 3) (datum (t/join (t/const-fact 3) t/none)))
(check "join keeps the only range" '(fixnum 0 3 pair) (datum (t/join (t/fixnum-fact 0 3) (t/fact t/t-pair))))
(check "meet ranges" '(fixnum 5 10) (datum (t/meet (t/fact t/t-number 0 10) (t/fact t/t-fixnum 5 20))))
(check "meet disjoint" 'none (datum (t/meet (t/fact t/t-pair) (t/fact t/t-number))))
(check "meet constant inside" '(const 3) (datum (t/meet (t/const-fact 3) (t/fixnum-fact 0 5))))
(check "meet constant outside" 'none (datum (t/meet (t/const-fact 9) (t/fixnum-fact 0 5))))
(check "subfact? range" #t (t/subfact? (t/fixnum-fact 1 2) (t/fixnum-fact 0 5)))
(check "subfact? wider range" #f (t/subfact? (t/fixnum-fact 1 9) (t/fixnum-fact 0 5)))
(check "subfact? constant" #t (t/subfact? (t/const-fact "x") (t/fact t/t-string)))
(check "subfact? into constant" #f (t/subfact? (t/fact t/t-string) (t/const-fact "x")))
(check "subfact? none" #t (t/subfact? t/none (t/const-fact 1)))
(check "widen moves the upper bound"
       '(fixnum 0 4611686018427387903)
       (datum (t/widen (t/fixnum-fact 0 1) (t/fixnum-fact 0 2))))
(check "widen moves the lower bound" (list 'fixnum small 1) (datum (t/widen (t/fixnum-fact 0 1) (t/fixnum-fact -1 0))))
(check "widen keeps a stable range" '(fixnum 0 5) (datum (t/widen (t/fixnum-fact 0 5) (t/fixnum-fact 1 2))))
(check "widen from none" '(fixnum 0 5) (datum (t/widen t/none (t/fixnum-fact 0 5))))

;; Printing
(check "datum round trip" '(fixnum 0 10 float) (datum (t/datum->fact '(fixnum 0 10 float))))
(check "datum full fixnum" '(fixnum pair) (datum (t/datum->fact '(fixnum pair))))
(check "datum const" '(const "a") (datum (t/datum->fact '(const "a"))))

;; --- laws on random facts ---------------------------------------------------------

(def- seed 12345)

(def- (rand31)
  (set! seed (modulo (* seed 48271) 2147483647))
  seed)

(def- (rand n)
  (modulo (rand31) n))

(def- (pick xs)
  (xs (rand (length xs))))

(def- bounds [small (+ small 1) -1000 -10 -1 0 1 2 10 1000 (- big 1) big])

(def- sample-values
  [0 1 -1 5 -5 1000 small big 1.5 -0.0 0.0 '(1) '() nil #f #t #\a "s" 'sym :kw [1] {:a 1} car (bytevector 1)])

(def- (random-fact)
  (let ((r (rand 6)))
    (cond
      ((= r 0) (t/const-fact (pick sample-values)))
      ((= r 1) t/none)
      (else (let ((a (pick bounds))
                  (b (pick bounds)))
              (t/fact (let ((bits (rand 65536)))
                        (if (= r 2)
                            (bitwise-ior bits t/t-fixnum)
                            bits))
                      (min a b)
                      (max a b)))))))

(def- failures [])

(def- (law! name ok a b)
  (unless ok (push! failures (list name (datum a) (datum b)))))

(dotimes (i 3000)
  (let ((a (random-fact))
        (b (random-fact)))
    (let ((j (t/join a b))
          (m (t/meet a b))
          (w (t/widen a b)))
      (law! "join covers a" (t/subfact? a j) a b)
      (law! "join covers b" (t/subfact? b j) a b)
      (law! "join commutes" (t/same-fact? j (t/join b a)) a b)
      (law! "meet is under a" (t/subfact? m a) a b)
      (law! "meet is under b" (t/subfact? m b) a b)
      (law! "widen covers join" (t/subfact? j w) a b)
      (law! "subfact? of itself" (t/subfact? a a) a b)
      (law! "datum round trip" (or (t/const? a) (t/same-fact? a (t/datum->fact (datum a)))) a b)
      (dotimes (k 4)
        (let ((v (pick sample-values)))
          (law! "join admits" (or (not (t/admits? a v)) (t/admits? j v)) a b)
          (law! "meet admits" (or (not (and (t/admits? a v) (t/admits? b v))) (t/admits? m v)) a b)
          (law! "subfact? agrees with admits"
                (or (not (t/subfact? a b)) (not (t/admits? a v)) (t/admits? b v))
                a
                b))))))

(check "lattice laws on random facts" [] failures)

;; Checked arithmetic against floating point: a result that is clearly in
;; range must be given exactly, and one clearly out of range must be nil.
(def- (random-fixnum)
  (let ((magnitude (case (rand 4)
                     ((0) (rand 100))
                     ((1) (rand31))
                     ((2) (+ (* (rand 2147483647) 2147483648) (rand31)))
                     (else (+ (* (rand31) (rand 4)) (rand 3))))))
    (if (= (rand 2) 0)
        magnitude
        (- -1 magnitude))))

(def- edge 4611686018427387904.0)

(def- (arith-law! name op exact a b)
  (let ((r (op a b))
        (approx (exact (inexact a) (inexact b))))
    (cond
      ((< (abs approx) (* edge 0.999999)) (unless (and r (= r (exact a b))) (push! failures (list name a b r))))
      ((> (abs approx) (* edge 1.000001)) (unless (nil? r) (push! failures (list name a b r)))))))

(dotimes (i 5000)
  (let ((a (if (= (rand 5) 0)
               (pick bounds)
               (random-fixnum)))
        (b (if (= (rand 5) 0)
               (pick bounds)
               (random-fixnum))))
    (arith-law! "checked+" t/checked+ + a b)
    (arith-law! "checked-" t/checked- - a b)
    (arith-law! "checked*" t/checked* * a b)))

(check "checked arithmetic on random fixnums" [] failures)

(report "types")
