;; lint: allow-file(unbound-name) %vm-install and %set-optimizer! are C runtime builtins
;; The VM backend end to end: source through Resolve, Inline, Convert and
;; Closures (not Propagate yet), then Select, Allocate and Emit, installed
;; and run. Each form's value must equal what compiler.c gives. Run on the C
;; runtime: ./otium --runtime=c tests/compiler/vm-e2e.ot
(require (otium.test :refer (check report))
         (otium.compiler.core :as core)
         (otium.compiler.inline :as inline)
         (otium.compiler.convert :as convert)
         (otium.compiler.closures :as closures)
         (otium.compiler.verify :as verify)
         (otium.compiler.select :as select)
         (otium.compiler.allocate :as allocate)
         (otium.compiler.emit :as emit))

(def (unit-of form)
  (let ((ir (closures/run (convert/run (inline/run (core/resolve (macroexpand-all form) 'user))))))
    (verify/check ir :closed)
    (emit/run (allocate/run (select/run ir)))))

(def (optimized form)
  "Evaluate form compiled by the optimizer."
  (let ((id (%vm-install (unit-of form) 'user))
        (used #f))
    (%set-optimizer! (fn (_form _space)
                       (if used
                           nil
                           (begin
                             (set! used #t)
                             id))))
    (let ((r (eval ''placeholder)))
      (%set-optimizer! nil)
      r)))

;; Pairs of (definition-or-nil test-expression), as source text. The
;; definition is compiled by the optimizer; the test runs with compiler.c
;; and its result is compared with the same test after compiler.c defines
;; the function under another name.
(def cases
  '(("(def (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))" "(fib 20)")
    ("(def (fib-loop n) (let loop ((i n) (a 0) (b 1)) (if (= i 0) a (loop (- i 1) b (+ a b)))))" "(fib-loop 30)")
    ("(def (opt a &optional (b 100)) (+ a b))" "(list (opt 1) (opt 1 2))")
    ("(def (counter n) (let ((c n)) (fn () (set! c (+ c 1)) c)))" "(let ((t (counter 5))) (t) (t))")
    ("(def (tryf msg) (try (error msg) (catch (string? c) :str) (catch (error? c) (condition-message c))))"
     "(tryf \"boom\")")
    ("(def (try2 x k) (let ((z (+ k 1))) (try (car x) (catch (error? c) (list k z)))))"
     "(list (try2 '(1) 5) (try2 5 5))")
    ("(def (rr) (try (try (error \"in\") (catch (string? c) :no)) (catch (error? c) (condition-message c))))" "(rr)")
    ("(def (catch-all m) (try (error m) (catch c (condition-message c))))" "(catch-all \"any\")")
    ("(def (many a b c d e f g) (list g f e d c b a))" "(many 1 2 3 4 5 6 7)")
    ("(def (rest a . r) (cons a r))" "(list (rest 1 2 3) (rest 1))")
    ("(def dd 0)" "dd")
    ("(def (deferf x) (defer (car x) (set! dd (+ dd 1))))" "(let ((before dd)) (list (deferf '(9)) (- dd before)))")
    ("(def (adder x) (fn (y) (fn () (list x y (* x y)))))" "(((adder 6) 7))")
    ("(def (evens xs) (let loop ((xs xs) (out '())) (cond ((null? xs) (reverse out)) ((even? (car xs)) (loop (cdr xs) (cons (car xs) out))) (else (loop (cdr xs) out)))))"
     "(evens '(1 2 3 4 5 6))")
    ("(def (qq x) `(a ,x ,@(list x x)))" "(qq 5)")
    ("(def (local-fns n) (def (ev? n) (if (= n 0) #t (od? (- n 1)))) (def (od? n) (if (= n 0) #f (ev? (- n 1)))) (ev? n))"
     "(list (local-fns 10) (local-fns 7))")
    ("(def (w n) (let ((s 0) (i 0)) (while (< i n) (set! s (+ s i)) (set! i (+ i 1))) s))" "(w 10)")
    ("(def (andor a b) (list (and a b) (or a b) (and) (or)))" "(andor 1 #f)")
    ("(def (mapper xs) (map (fn (x) (* x x)) xs))" "(mapper '(1 2 3))")
    ("(def (fl x) (* x 1.5))" "(fl 2)")
    ("(def (strs a) (string-append a \"!\" (number->string 42)))" "(strs \"hi\")")
    ("(def (sum-list xs) (let loop ((xs xs) (acc 0)) (if (pair? xs) (loop (cdr xs) (+ acc (car xs))) acc)))"
     "(sum-list '(1 2 3 4))")
    ("(def (cmp a b) (cond ((< a b) :lt) ((= a b) :eq) (else :gt)))"
     "(list (cmp 1 2) (cmp 2 2) (cmp 3 2) (cmp 1.5 1))")))

(for-each (fn (c)
            (let ((def-form (read-string (car c)))
                  (test (read-string (cadr c))))
              (optimized def-form)
              (let ((mine (optimized test))
                    (theirs (begin
                              (eval def-form)
                              (eval test))))
                (check (cadr c) theirs mine))))
          cases)

(report "vm-e2e")
