;; lint: allow-file(unbound-name) %vm-install, %set-optimizer!, %vm-opcodes, %resolve-global and %global-cell are C runtime builtins
;; lint: allow-file(captured-binding) hand-written IR is data that looks like fn forms
;; lint: allow-file(rest-arguments) hand-written IR is data that looks like fn forms
;; lint: allow-file(template-namespace-ref) the templates build IR data, not code
;; The VM backend: hand-written closed IR through Select, Allocate and Emit,
;; installed with %vm-install and run. Run on the C runtime:
;; ./otium --runtime=c tests/compiler/vm.ot
(require (otium.test :refer (check report))
         (otium.compiler.ir-text :as text)
         (otium.compiler.verify :as verify)
         (otium.compiler.core :as core)
         (otium.compiler.select :as select)
         (otium.compiler.allocate :as allocate)
         (otium.compiler.emit :as emit))

(def (compile-ir datum)
  (let ((ir (text/read datum)))
    (verify/check ir :closed)
    (emit/run (allocate/run (select/run ir)))))

(def (run-unit unit)
  "Install unit and run its entry once, returning its value."
  (let ((id (%vm-install unit 'user))
        (used #f))
    (%set-optimizer! (fn (_form _space)
                       (if used
                           nil
                           (begin
                             (set! used #t)
                             id))))
    (let ((r (eval ''placeholder)))
      (%set-optimizer! nil)
      r)))

(def (run-ir datum)
  (run-unit (compile-ir datum)))

;; A unit whose entry returns the static closure of f1, followed by fns.
(def (with-entry fns)
  `(ir (fn f0
         nil
         :signature (0 0 #f)
         :entry e0
         (e0 () (e1 static-closure :aux f1) (return e1)))
       ,@fns))

(def (function-ir fns)
  (run-ir (with-entry fns)))

(def opcode-names
  (let ((t {}))
    (for ((k v :in (%vm-opcodes)))
      (put! t v k))
    t))

(def (ops-of unit i)
  "The opcode keywords of unit function i, in order."
  (let ((code ((unit i) :code)))
    (for ((w :range (quotient (length code) 5)) (out :collect (opcode-names (code (* 5 w))))) => out)))

(def (count-op unit i op)
  (length (filter (fn (o) (eq? o op)) (ops-of unit i))))

(def (locals-of unit i)
  ((unit i) :locals))

(def (global name)
  (%resolve-global 'user name))

(def (core name)
  (%resolve-global 'otium.core name))

(def (disassemble unit i)
  "Unit function i's words as (index op x a b c)."
  (let ((code ((unit i) :code)))
    (for ((w :range (quotient (length code) 5))
          (out :collect (list w
                              (opcode-names (code (* 5 w)))
                              (code (+ 1 (* 5 w)))
                              (code (+ 2 (* 5 w)))
                              (code (+ 3 (* 5 w)))
                              (code (+ 4 (* 5 w))))))
      => out)))

(def- (error-text thunk)
  (try
    (begin
      (thunk)
      nil)
    (catch (error? c) (condition-message c))))

;; --- constants ---------------------------------------------------------------------

(check "immediate"
       42
       (run-ir '(ir (fn f0
                      nil
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 const 42) (return v0))))))
(check "string constant"
       "hello"
       (run-ir '(ir (fn f0
                      nil
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 const "hello") (return v0))))))
(check "quoted list"
       '(1 (2 x))
       (run-ir '(ir (fn f0
                      nil
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 const '(1 (2 x))) (return v0))))))
(check "float and char"
       '(2.5 . #\a)
       (run-ir '(ir (fn f0
                      nil
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 const 2.5) (v1 const #\a) (v2 cons v0 v1) (return v2))))))
(check "big fixnum"
       4000000000
       (run-ir '(ir (fn f0
                      nil
                      :signature (0 0 #f)
                      :entry b0
                      (b0 () (v0 const 4000000000) (return v0))))))
(let ((u (compile-ir '(ir (fn f0
                            nil
                            :signature (0 0 #f)
                            :entry b0
                            (b0 () (v0 const 42) (return v0)))))))
  (check "an immediate return is one word" '(:return-imm) (ops-of u 0))
  (check "no frame" 0 (locals-of u 0)))

;; --- arithmetic and branches -------------------------------------------------------

(def arith-ir
  (with-entry '((fn f1
                  "arith"
                  :parent f0
                  :params (a b)
                  :signature (2 0 #f)
                  :entry b0
                  (b0 ()
                      (v0 + a b)
                      (v1 - a b)
                      (v2 * v0 v1)
                      (v3 const 5)
                      (v4 + v2 v3)
                      (v5 const 3)
                      (v6 - v4 v5)
                      (v7 const 1)
                      (v8 + v7 v6)
                      (return v8))))))

(let ((u (compile-ir arith-ir)))
  (let ((f (run-unit u)))
    (check "arith" (+ (* (+ 7 3) (- 7 3)) 5 -3 1) (f 7 3))
    (check "arith floats" (+ (* (+ 1.5 1.0) (- 1.5 1.0)) 3.0) (f 1.5 1.0))
    (check "arith uses addi" 3 (count-op u 1 :addi))
    (check "arith has no constants" 0 (count-op u 1 :imm))
    (check "arith frame" 3 (locals-of u 1))))

(def max-ir
  (with-entry '((fn f1
                  "max"
                  :parent f0
                  :params (a b)
                  :signature (2 0 #f)
                  :entry b0
                  (b0 () (branch-prim > (a b) b1 b2))
                  (b1 () (return a))
                  (b2 () (return b))))))

(let ((u (compile-ir max-ir)))
  (let ((f (run-unit u)))
    (check "max" 9 (f 9 2))
    (check "max other" 9 (f 2 9))
    (check "max fused" '(:br-gt :jump :return :return) (ops-of u 1))))

(def classify-ir
  (with-entry '((fn f1
                  "classify"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry c0
                  (c0 () (branch-prim null? (x) c1 c2))
                  (c1 () (v0 const :empty) (return v0))
                  (c2 () (v1 const 'go) (branch-prim eq? (x v1) c3 c4))
                  (c3 () (v2 const :go) (return v2))
                  (c4 () (branch-prim nil? (x) c5 c6))
                  (c5 () (v3 const :nil) (return v3))
                  (c6 () (v4 pair? x) (branch-prim not (v4) c7 c8))
                  (c7 () (v5 const 10) (branch-prim < (x v5) c9 c10))
                  (c8 () (v6 const :pair) (return v6))
                  (c9 () (v7 const :small) (return v7))
                  (c10 () (v8 const :big) (return v8))))))

(let ((u (compile-ir classify-ir)))
  (let ((f (run-unit u)))
    (check "classify ()" :empty (f '()))
    (check "classify go" :go (f 'go))
    (check "classify nil" :nil (f nil))
    (check "classify pair" :pair (f '(1)))
    (check "classify small" :small (f 3))
    (check "classify big" :big (f 30))
    (check "classify float" :small (f 2.5))
    (check "classify br-eqk" 2 (count-op u 1 :br-eqk))
    (check "classify br-lti" 1 (count-op u 1 :br-lti))
    (check "classify br-null" 1 (count-op u 1 :br-null))))

;; branch on a materialized value, and a predicate without a branch opcode
(def string-ir
  (with-entry '((fn f1
                  "is-string"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry s0
                  (s0 () (branch-prim string? (x) s1 s2))
                  (s1 () (v0 const 1) (return v0))
                  (s2 () (v1 const 2) (return v1))))))

(let ((f (function-ir (cddr string-ir))))
  (check "string? yes" 1 (f "a"))
  (check "string? no" 2 (f 5)))

;; --- loops -------------------------------------------------------------------------

;; (let loop ((i n) (a 0) (b 1)) (if (= i 0) a (loop (- i 1) b (+ a b))))
(def fib-loop-ir
  (with-entry '((fn f1
                  "fib-loop"
                  :parent f0
                  :params (n)
                  :signature (1 0 #f)
                  :entry l0
                  (l0 () (v0 const 0) (v1 const 1) (jump l1 n v0 v1))
                  (l1 (i a b) (v2 const 0) (branch-prim = (i v2) l2 l3))
                  (l2 () (return a))
                  (l3 () (v3 const 1) (v4 - i v3) (v5 + a b) (jump l1 v4 b v5))))))

(let ((u (compile-ir fib-loop-ir)))
  (let ((f (run-unit u)))
    (check "fib loop" 6765 (f 20))
    (check "fib loop 0" 0 (f 0))
    (check "fib loop frame" 4 (locals-of u 1))))

;; (let loop ((n n) (x x) (y y)) (if (= n 0) (cons x y) (loop (- n 1) y x))): a swap
(def swap-ir
  (with-entry '((fn f1
                  "swap"
                  :parent f0
                  :params (n x y)
                  :signature (3 0 #f)
                  :entry w0
                  (w0 () (v0 const 0) (jump w1 n x y))
                  (w1 (k p q) (branch-prim = (k v0) w2 w3))
                  (w2 () (v1 cons p q) (return v1))
                  (w3 () (v2 const 1) (v3 - k v2) (jump w1 v3 q p))))))

(let ((u (compile-ir swap-ir)))
  (let ((f (run-unit u)))
    (check "swap even" '(a . b) (f 4 'a 'b))
    (check "swap odd" '(b . a) (f 3 'a 'b))
    (check "swap frame" 4 (locals-of u 1))))

;; --- calls -------------------------------------------------------------------------

(def (twice x)
  (* 2 x))

(def (pair-up a b)
  (list a b))

;; (+ x (twice x) (twice y)) with x and y live across calls; then a builtin
;; without an opcode, length, and a tail call to a global.
(def calls-ir
  (with-entry `((fn f1
                  "calls"
                  :parent f0
                  :params (x y)
                  :signature (2 0 #f)
                  :entry k0
                  (k0 () (call global ,(global 'twice) (x) k1))
                  (k1 (t1) (call global ,(global 'twice) (y) k2))
                  (k2 (t2)
                      (v0 + x t1)
                      (v1 + v0 t2)
                      (v2 const '(1 2 3))
                      (v3 length v2)
                      (v4 + v1 v3)
                      (tail-call global ,(global 'pair-up) (v4 y)))))))

(let ((u (compile-ir calls-ir)))
  (let ((f (run-unit u)))
    (check "calls" (list (+ 5 10 6 3) 3) (f 5 3))
    (check "calls global and builtin" 3 (count-op u 1 :call-global))
    (check "calls tail" 1 (count-op u 1 :tail-call-global))))

;; --- closures ----------------------------------------------------------------------

;; (fn (x) (fn (y) (fn () (list x y (* x y))))): f2 captures x from f1's
;; register; f3 captures x from f2's captures and y from f2's register.
(def closure-ir
  (with-entry `((fn f1
                  "outer"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry o0
                  (o0 () (v0 make-closure x :aux f2) (return v0)))
                (fn f2
                  "middle"
                  :parent f1
                  :params (y)
                  :signature (1 0 #f)
                  :entry m0
                  (m0 () (v1 env-ref :aux 0) (v2 make-closure v1 y :aux f3) (return v2)))
                (fn f3
                  "inner"
                  :parent f2
                  :signature (0 0 #f)
                  :entry n0
                  (n0 ()
                      (v3 env-ref :aux 0)
                      (v4 env-ref :aux 1)
                      (v5 * v3 v4)
                      (v6 const '())
                      (v7 cons v5 v6)
                      (v8 cons v4 v7)
                      (v9 cons v3 v8)
                      (return v9))))))

(let ((u (compile-ir closure-ir)))
  (let ((f (run-unit u)))
    (check "closure chain" '(6 7 42) (((f 6) 7)))
    (check "capture from a register" [[1 #t]] ((u 2) :captures))
    (check "capture from a capture and a register" [[0 #f] [1 #t]] ((u 3) :captures))
    (check "middle reads no upvalue" 0 (count-op u 2 :upvalue))))

;; A static closure called as a known function: (fn (n) (sq (+ n 1))) where
;; sq is a capture-free sibling.
(def known-ir
  `(ir (fn f0
         nil
         :signature (0 0 #f)
         :entry e0
         (e0 () (e1 static-closure :aux f1) (return e1)))
       (fn f1
         "caller"
         :parent f0
         :params (n)
         :signature (1 0 #f)
         :entry q0
         (q0 () (v0 const 1) (v1 + n v0) (call known f2 (v1) q1))
         (q1 (r) (v2 const 1) (v3 + r v2) (tail-call known f2 (v3))))
       (fn f2
         "sq"
         :parent f1
         :params (z)
         :signature (1 0 #f)
         :entry s0
         (s0 () (v4 * z z) (return v4)))))

(let ((u (compile-ir known-ir)))
  (let ((f (run-unit u)))
    (check "known calls" (let ((a (* 4 4))) (* (+ a 1) (+ a 1))) (f 3))
    (check "known callee is a static constant" [[0 2]] ((u 1) :statics))
    (check "known call" '(:addi :const :call :addi :const :tail-call) (ops-of u 1))))

;; --- parameters --------------------------------------------------------------------

;; (fn (a &optional (b 100)) (+ a b))
(def optional-ir
  (with-entry '((fn f1
                  "opt"
                  :parent f0
                  :params (a b)
                  :signature (1 1 #f)
                  :entry p0
                  (p0 () (v9 bound? b) (branch v9 p1 p2))
                  (p1 () (jump p3 b))
                  (p2 () (v0 const 100) (jump p3 v0))
                  (p3 (bb) (v1 + a bb) (return v1))))))

(let ((u (compile-ir optional-ir)))
  (let ((f (run-unit u)))
    (check "optional given" 3 (f 1 2))
    (check "optional default" 101 (f 1))
    (check "optional uses jbound" 1 (count-op u 1 :jbound))
    (check "optional default goes to b's register" 0 (count-op u 1 :move))
    (check "optional frame" 2 (locals-of u 1))))

;; bound? as a value
(def bound-value-ir
  (with-entry '((fn f1
                  "given?"
                  :parent f0
                  :params (a b)
                  :signature (0 2 #f)
                  :entry g0
                  (g0 () (v0 bound? a) (v1 bound? b) (v2 cons v0 v1) (return v2))))))

(let ((f (run-ir bound-value-ir)))
  (check "bound? none" '(#f . #f) (f))
  (check "bound? one" '(#t . #f) (f 1))
  (check "bound? both" '(#t . #t) (f 1 2)))

;; (fn (a . r) (cons a r))
(def rest-ir
  (with-entry '((fn f1
                  "rest"
                  :parent f0
                  :params (a r)
                  :signature (1 0 #t)
                  :entry r0
                  (r0 () (v0 cons a r) (return v0))))))

(let ((f (run-ir rest-ir)))
  (check "rest" '(1 2 3) (f 1 2 3))
  (check "rest empty" '(1) (f 1)))

;; --- boxes -------------------------------------------------------------------------

;; (fn (n) (let ((c n)) (fn () (set! c (+ c 1)) c)))
(def box-ir
  (with-entry '((fn f1
                  "counter"
                  :parent f0
                  :params (n)
                  :signature (1 0 #f)
                  :entry x0
                  (x0 () (v0 box n) (v1 make-closure v0 :aux f2) (return v1)))
                (fn f2
                  "tick"
                  :parent f1
                  :signature (0 0 #f)
                  :entry y0
                  (y0 ()
                      (v2 env-ref :aux 0)
                      (v3 box-ref v2)
                      (v4 const 1)
                      (v5 + v3 v4)
                      (v6 box-set v2 v5)
                      (v7 box-ref v2)
                      (return v7))))))

(let ((f (run-ir box-ir)))
  (let ((tick (f 10)))
    (tick)
    (check "box" 12 (tick))))

;; A box of a value that stays live: (let ((b (box x))) (cons x (unbox b)))
(def box-live-ir
  (with-entry '((fn f1
                  "box-live"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry z0
                  (z0 () (v0 box x) (v1 box-ref v0) (v2 cons x v1) (return v2))))))

(check "box keeps its operand" '(5 . 5) ((run-ir box-live-ir) 5))

;; An unbound box raises on box-ref; check-bound raises on unbound.
(def unbound-ir
  (with-entry '((fn f1
                  "unbound"
                  :parent f0
                  :params (flag)
                  :signature (1 0 #f)
                  :entry u0
                  (u0 () (v0 unbound) (branch flag u1 u2))
                  (u1 () (v1 box v0) (v2 box-ref v1) (return v2))
                  (u2 () (v3 check-bound v0) (return v3))))))

(let ((f (run-ir unbound-ir)))
  (check "box-ref of unbound" "uninitialized local" (error-text (fn () (f #t))))
  (check "check-bound" "uninitialized local" (error-text (fn () (f #f)))))

;; --- globals -----------------------------------------------------------------------

(def counter 0)

(def globals-ir
  `(ir (fn f0
         nil
         :signature (0 0 #f)
         :entry e0
         (e0 ()
             (v0 global-ref :aux ,(global 'counter))
             (v1 const 1)
             (v2 + v0 v1)
             (v3 global-set v2 :aux ,(global 'counter))
             (v4 const 7)
             (v5 global-def v4 :aux ,(%global-cell 'user 'defined-by-vm))
             (v6 prim-ref :aux car)
             (v7 cons v6 v5)
             (return v7)))))

(check "globals" (cons car nil) (run-ir globals-ir))
(check "global-set" 1 counter)
(check "global-def" 7 (eval 'defined-by-vm))

;; --- try and defer -----------------------------------------------------------------

;; (fn (msg keep) (try (begin (error msg) 0) (catch (c) (if (equal? (condition-message c) "mine") keep (raise c)))))
;; keep is live into the handler, so it keeps its register through the call to error.
(def try-ir
  (with-entry `((fn f1
                  "try"
                  :parent f0
                  :params (msg keep)
                  :signature (2 0 #f)
                  :entry t0
                  (t0 ()
                      (v0 const 1)
                      (v1 + keep v0)
                      (try
                        t1
                        t2))
                  (t1 () (v2 error msg) (unreachable))
                  (t2 (c) (call global ,(global 'condition-message) (c) t3))
                  (t3 (m) (v3 const "mine") (v4 equal? m v3) (branch v4 t4 t5))
                  (t4 () (v5 cons keep v1) (return v5))
                  (t5 () (v6 raise c) (unreachable))))))

(let ((u (compile-ir try-ir)))
  (let ((f (run-unit u)))
    (check "try caught" '(5 . 6) (f "mine" 5))
    (check "try re-raised" "other" (error-text (fn () (f "other" 5))))
    (check "try uses raise" 1 (count-op u 1 :raise))))

;; A try whose body returns normally: (try (car x) (catch (c) :bad)).
(def try-normal-ir
  (with-entry '((fn f1
                  "try-car"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry n0
                  (n0 ()
                      (try
                        n1
                        n2))
                  (n1 () (v0 car x) (v1 pop-try) (return v0))
                  (n2 (c) (v2 const :bad) (return v2))))))

(let ((f (run-ir try-normal-ir)))
  (check "try normal" 1 (f '(1)))
  (check "try caught car" :bad (f 5))
  (check "try stack is clean"
         2
         (try
           (f '(2))
           (catch _ :leak))))

(def cleanups 0)

;; (fn (x) (defer (car x) (set! cleanups (+ cleanups 1))))
(def defer-ir
  `(ir (fn f0
         nil
         :signature (0 0 #f)
         :entry e0
         (e0 () (e1 static-closure :aux f1) (return e1)))
       (fn f1
         "defer"
         :parent f0
         :params (x)
         :signature (1 0 #f)
         :entry d0
         (d0 () (v0 static-closure :aux f2) (v1 push-cleanup v0) (v2 car x) (v3 run-cleanup) (return v2)))
       (fn f2
         "cleanup"
         :parent f1
         :signature (0 0 #f)
         :entry d1
         (d1 ()
             (v4 global-ref :aux ,(global 'cleanups))
             (v5 const 1)
             (v6 + v4 v5)
             (v7 global-set v6 :aux ,(global 'cleanups))
             (return v7)))))

(let ((f (run-ir defer-ir)))
  (check "defer value" 1 (f '(1)))
  (check "defer ran" 1 cleanups)
  (check "defer raises" #t (string? (error-text (fn () (f 5)))))
  (check "defer ran on raise" 2 cleanups))

;; --- register pressure -------------------------------------------------------------

;; n values computed from x, all live at once, summed in reverse, with a call
;; in the middle: the window must go above all of them.
(def (pressure-ir n)
  (let ((defs (for ((i :range n) (out :collect (list (string->symbol (str "p" i)) '+ 'x (string->symbol (str "k" i)))))
                => out))
        (consts (for ((i :range n) (out :collect (list (string->symbol (str "k" i)) 'const (* 1000 i)))) => out))
        (sum (let loop ((i 1)
                        (acc 'p0)
                        (out '()))
               (if (= i n)
                   [(reverse out) acc]
                   (let ((name (string->symbol (str "s" i))))
                     (loop (+ i 1) name (cons (list name '+ acc (string->symbol (str "p" i))) out)))))))
    `(ir (fn f0
           nil
           :signature (0 0 #f)
           :entry e0
           (e0 () (e1 static-closure :aux f1) (return e1)))
         (fn f1
           "pressure"
           :parent f0
           :params (x)
           :signature (1 0 #f)
           :entry h0
           (h0 () ,@consts ,@defs (call global ,(global 'twice) (x) h1))
           (h1 (tw) ,@(sum 0) (v0 + ,(sum 1) tw) (return v0))))))

(let ((u (compile-ir (pressure-ir 40))))
  (let ((f (run-unit u)))
    (check "pressure" (+ (* 40 3) (* 1000 (quotient (* 40 39) 2)) 6) (f 3))
    (check "pressure frame" 43 (locals-of u 1))))

(let ((u (compile-ir (pressure-ir 300))))
  (check "pressure 300" (+ 300 (* 1000 (quotient (* 300 299) 2)) 2) ((run-unit u) 1)))

;; --- more shapes -------------------------------------------------------------------

;; A call whose ret block is also a jump target: (+ 1 (if c (twice x) x)).
(def join-ir
  (with-entry `((fn f1
                  "join"
                  :parent f0
                  :params (c x)
                  :signature (2 0 #f)
                  :entry j0
                  (j0 () (branch c j1 j2))
                  (j1 () (call global ,(global 'twice) (x) j3))
                  (j2 () (jump j3 x))
                  (j3 (r) (v0 const 1) (v1 + r v0) (return v1))))))

(let ((f (run-ir join-ir)))
  (check "join after call" 11 (f #t 5))
  (check "join without call" 6 (f #f 5)))

;; A mid-block builtin call whose result is live into a handler.
(def pinned-call-ir
  (with-entry '((fn f1
                  "pinned-call"
                  :parent f0
                  :params (xs)
                  :signature (1 0 #f)
                  :entry i0
                  (i0 ()
                      (v0 length xs)
                      (try
                        i1
                        i2))
                  (i1 () (v1 car xs) (v2 pop-try) (return v1))
                  (i2 (c) (return v0))))))

(let ((f (run-ir pinned-call-ir)))
  (check "pinned call result normal" 1 (f '(1 2)))
  (check "pinned call result in handler" 0 (f '())))

;; Self tail calls loop through window 0.
;; (fn (n acc) (if (= n 0) acc (self (- n 1) (+ acc n))))
(def self-tail-ir
  (with-entry '((fn f1
                  "sum-to"
                  :parent f0
                  :params (n acc)
                  :signature (2 0 #f)
                  :entry a0
                  (a0 () (v0 const 0) (branch-prim = (n v0) a1 a2))
                  (a1 () (return acc))
                  (a2 () (v1 const 1) (v2 - n v1) (v3 + acc n) (v4 self) (tail-call value v4 (v2 v3)))))))

(let ((u (compile-ir self-tail-ir)))
  (check "self tail call" 5050 ((run-unit u) 100 0))
  (check "self tail call deep" 50005000 ((run-unit u) 10000 0))
  (check "self tail call window"
         '((:tail-call 0 0 2 0))
         (map cdr (filter (fn (w) (eq? (cadr w) :tail-call)) (disassemble u 1)))))

;; (fn (f x) (let loop ((i 0) (acc '())) (if (= i 3) acc (loop (+ i 1) (cons (f x) acc)))))
;; f and x stay live across a value call in a loop.
(def loop-call-ir
  (with-entry '((fn f1
                  "loop-call"
                  :parent f0
                  :params (g x)
                  :signature (2 0 #f)
                  :entry c0
                  (c0 () (v0 const 0) (v1 const '()) (jump c1 v0 v1))
                  (c1 (i acc) (v2 const 3) (branch-prim = (i v2) c2 c3))
                  (c2 () (return acc))
                  (c3 () (call value g (x) c4))
                  (c4 (y) (v3 const 1) (v4 + i v3) (v5 cons y acc) (jump c1 v4 v5))))))

(check "loop with a call" '(6 6 6) ((run-ir loop-call-ir) twice 3))

;; Two make-closure sites of one function with its capture in the same register.
(def two-sites-ir
  (with-entry '((fn f1
                  "two-sites"
                  :parent f0
                  :params (x flag)
                  :signature (2 0 #f)
                  :entry t0
                  (t0 () (branch flag t1 t2))
                  (t1 () (v0 make-closure x :aux f2) (return v0))
                  (t2 () (v1 make-closure x :aux f2) (v2 cons v1 v1) (return v2)))
                (fn f2
                  "get"
                  :parent f1
                  :signature (0 0 #f)
                  :entry t3
                  (t3 () (v3 env-ref :aux 0) (return v3))))))

(let ((f (run-ir two-sites-ir)))
  (check "two sites" 4 ((f 4 #t)))
  (check "two sites other" 4 ((car (f 4 #f)))))

(def different-sites-ir
  (with-entry '((fn f1
                  "different-sites"
                  :parent f0
                  :params (x y)
                  :signature (2 0 #f)
                  :entry t0
                  (t0 () (v0 make-closure x :aux f2) (v1 make-closure y :aux f2) (v2 cons v0 v1) (return v2)))
                (fn f2
                  "get"
                  :parent f1
                  :signature (0 0 #f)
                  :entry t3
                  (t3 () (v3 env-ref :aux 0) (return v3))))))

(check "different capture registers are unsupported"
       #t
       (try
         (begin
           (compile-ir different-sites-ir)
           #f)
         (catch (core/unsupported? _c) #t)))

;; Source points
(def points-ir
  (with-entry '((fn f1
                  "points"
                  :parent f0
                  :params (x)
                  :signature (1 0 #f)
                  :entry q0
                  (q0 () (v0 car x :pos 10) (v1 cdr v0 :pos 20) (return v1))))))

(let ((u (compile-ir points-ir)))
  (check "points" [[0 10] [1 20]] ((u 1) :points))
  (check "points error" #t (string? (error-text (fn () ((run-unit u) '(5)))))))

;; --- frames against compiler.c -----------------------------------------------------

;; :locals compiler.c gives the same functions written as source (see the
;; report; measured with a small C program over build/c/libotium.a). The
;; optimizer's frames must be no larger.
(def fib-ir
  (with-entry '((fn f1
                  "fib"
                  :parent f0
                  :params (n)
                  :signature (1 0 #f)
                  :entry b1
                  (b1 () (v1 const 2) (branch-prim < (n v1) b2 b3))
                  (b2 () (return n))
                  (b3 () (v2 const 1) (v3 - n v2) (v9 self) (call value v9 (v3) b4))
                  (b4 (v4) (v5 const 2) (v6 - n v5) (call value v9 (v6) b5))
                  (b5 (v7) (v8 + v4 v7) (return v8))))))

(check "fib" 6765 ((run-ir fib-ir) 20))

(for-each (fn (e)
            (let ((mine (locals-of (compile-ir (e 1)) 1)))
              (check (str (e 0) " frame " mine " <= compiler.c " (e 2)) #t (<= mine (e 2)))))
          (list ["fib" fib-ir 5]
                ["arith" arith-ir 8]
                ["max" max-ir 3]
                ["classify" classify-ir 4]
                ["fib-loop" fib-loop-ir 7]
                ["swap" swap-ir 9]
                ["calls" calls-ir 10]
                ["optional" optional-ir 3]
                ["counter" box-ir 3]
                ["try" try-ir 9]
                ["defer" defer-ir 3]
                ["pressure" (pressure-ir 10) 25]))

(report "vm")
