;; Error codes only the Chez runtime raises so far.
(require otium.test :refer (check report))
(require otium.extra :refer (comp))

(def (code-of thunk)
  (try
    (begin
      (thunk)
      nil)
    (catch c (and (table? c) (get c :code)))))

(defmacro forever (x)
  (list 'forever x))

(defmacro explode ()
  (error "boom"))

(check "E0111" "E0111" (code-of (fn () (eval '(forever 1)))))
(check "E0112" "E0112" (code-of (fn () (eval '(explode)))))
(check "E0207" "E0207" (code-of (fn () (eval '(def comp 1)))))

(report "Chez diagnostic codes")
