;; Every error code the runtime raises, triggered once each. Run with
;; -L tests/diagnostics/lib for the namespace fixtures.
(require otium.test :refer (check report))
(require otium.extra :refer (comp))
(require otium.thread :as thread)

(def (raised thunk)
  ;; The condition thunk raises, or nil.
  (try
    (begin
      (thunk)
      nil)
    (catch c c)))

(def (code-of source)
  ;; The :code of the condition raised by reading and evaluating source.
  (let ((c (raised (fn () (eval (read-string source)))))) (and (table? c) (get c :code))))

(for-each (fn (case) (check (first case) (first case) (code-of (second case))))
          '(("E0001" "(def (f x)")
            ("E0002" "\"abc")
            ("E0003" ")")
            ("E0004" "12abc")
            ("E0005" "#(1 2)")
            ("E0006" "\"\\q\"")
            ("E0007" "(1 . 2 3)")
            ("E0008" ":")
            ("E0009" "'")
            ("E0010" "")
            ("E0011" "#\\unknown")
            ("E0101" "(if)")
            ("E0102" "(let [x 1] x)")
            ("E0103" "(fn (x x) x)")
            ("E0104" "(fn (if) if)")
            ("E0105" "(+ 1 (def x 2))")
            ("E0106" "(list ,x)")
            ("E0107" "(cond (else))")
            ("E0108" "(try (catch (error? e) nil) 1)")
            ("E0109" "(set! 3 4)")
            ("E0110" "(ns diagnostics.bad-clause (:use other))")
            ("E0111" "(begin (defmacro forever (x) (list 'forever x)) (forever 1))")
            ("E0113" "(let ((a/b 1)) a/b)")
            ("E0201" "(frobnicate 1)")
            ("E0202" "(require no.such.space)")
            ("E0203" "(require private-space :refer (missing))")
            ("E0204" "(require private-space :refer (hidden))")
            ("E0205" "(require cycle-a)")
            ("E0206" "(require wrong-name)")
            ("E0207" "(def comp 1)")
            ("E0208" "(require private-space :as otium.core)")
            ("E0209" "(set! map car)")
            ("E0210" "(begin (defrecord Point (x y)) (def (point-x p) 0))")
            ("E0301" "((fn (x) x) 1 2)")
            ("E0302" "(3)")
            ("E0401" "(car 5)")))

;; Thread errors, where threads work: native code only.
(when (try
        (begin
          (thread/self)
          #t)
        (catch _ #f))
  (check "E0502" "E0502" (code-of "(require thread-wait)"))
  (check "E0504" "E0504" (get (raised (fn () (thread/join (thread/spawn (fn () (car 1)))))) :code))
  (let ((sleeper (thread/spawn (fn () (thread/sleep 10)))))
    (check "E0505" "E0505" (get (raised (fn () (thread/join sleeper 0.01))) :code))
    (thread/kill! sleeper)
    (thread/join sleeper))
  (let ((sleeper (thread/spawn (fn () (thread/sleep 10)))))
    (check "E0506"
           "E0506"
           (get (raised (fn () (handler-bind ((error? (fn (c) (thread/join sleeper)))) (error "x"))))
                :code))
    (thread/kill! sleeper)
    (thread/join sleeper))
  ;; Last, since it leaves a thread waiting for good.
  (let ((main (thread/self)))
    (check "E0503" "E0503" (get (raised (fn () (thread/join (thread/spawn (fn () (thread/join main)))))) :code))))

;; Coded conditions carry their catalog type, an error subtype.
(let ((c (raised (fn () (car 5)))))
  (check "type" 'type-error (condition-type c))
  (check "error subtype" #t (condition-of-type? c 'error))
  (check "message" #t (string? (condition-message c))))

;; Raising a value that is not a table still works, and adds nothing to it.
(check "plain value" 42 (raised (fn () (error 42))))

(report "diagnostic codes")
