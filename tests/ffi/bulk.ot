(require otium.ffi :as ffi)
(require otium.test :refer (check fails? report))

(def p (ffi/alloc 'u8 16))

(def text "a\x0;é🙂")

(def bytes (string->utf8 text))

(ffi/write-bytes! p bytes)
(check "exact UTF-8 preserves NUL" text (ffi/read-utf8-bytes p (bytevector-length bytes)))
(check "C string stops at NUL" "a" (ffi/read-utf8 p 16))
(check "read bytes" (str bytes) (str (ffi/read-bytes p (bytevector-length bytes))))
(ffi/write-bytes! p #u8(9 8 7 6) 1 3)
(check "source range" "#u8(8 7)" (str (ffi/read-bytes p 2)))
(ffi/write-bytes! p #u8(9 8 7) 2)
(check "source start" "#u8(7)" (str (ffi/read-bytes p 1)))
(check "empty read" "#u8()" (str (ffi/read-bytes p 0)))
(check "empty UTF-8" "" (ffi/read-utf8-bytes p 0))
(check "empty write" #f (ffi/write-bytes! p #u8() 0 0))

(def view (ffi/view p 2 2))

(ffi/write-bytes! view #u8(4 5))
(check "view" "#u8(4 5)" (str (ffi/read-bytes view 2)))
(check #t (fails? (fn () (ffi/read-bytes view 3))))
(check #t (fails? (fn () (ffi/write-bytes! view #u8(1 2 3)))))
(check #t (fails? (fn () (ffi/write-bytes! p #u8(1) -1))))
(check #t (fails? (fn () (ffi/write-bytes! p #u8(1) 1 0))))
(check #t (fails? (fn () (ffi/write-bytes! p #u8(1) 0 2))))
(check #t (fails? (fn () (ffi/write-bytes! p '(1 2)))))
(check #t (fails? (fn () (ffi/read-bytes p -1))))
(check #t (fails? (fn () (ffi/read-bytes p 1.0))))
(ffi/write-bytes! p #u8(255))
(check #t (fails? (fn () (ffi/read-utf8-bytes p 1))))
(ffi/write-bytes! p #u8(195))
(check #t (fails? (fn () (ffi/read-utf8-bytes p 1))))

(def big (make-bytevector 131072 123))

(def large (ffi/alloc 'u8 (bytevector-length big)))

(ffi/write-bytes! large big)
(check "large bulk copy" 123 (bytevector-u8-ref (ffi/read-bytes large 131072) 131071))
(ffi/free! large)
(ffi/free! p)
(check #t (fails? (fn () (ffi/read-bytes p 0))))
(check #t (fails? (fn () (ffi/write-bytes! view #u8()))))
(check #t (fails? (fn () (ffi/read-utf8-bytes view 0))))
(report "ffi bulk")
