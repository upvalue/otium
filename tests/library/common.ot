(require otium.test :refer (check fails? report))

(check "ab" (substring "ab" -5 9))
(check "" (substring "ab" 9))
(check "" (substring "ab" 1 0))
(check "é🙂" (substring "aé🙂z" 1 3))
(check #t (nil? (string->number "nope")))
(check 42 (string->number " 42\n"))
(check "a1:k" (str "a" 1 :k))

(def b (buffer "é"))

(check "é" (buffer->string b))
(check "é" (buffer->string b))
(buffer-push! b "🙂" 7)
(check 3 (length b))
(check "é🙂7" (buffer->string b))
(check '("a" "b" "c") (array-to-list (string-split "  a\tb\nc ")))
(check '("a" "" "b" "") (array-to-list (string-split "a,,b," ",")))
(check #t (fails? (fn () (string-split "a" ""))))
(check "1:2:3" (string-join ":" [1 2 3]))
(check "" (string-join ":" nil))
(check "é" (string-trim " \té\n"))
(check "aXaX" (string-replace "abab" "b" "X"))
(check #t (string-contains? "a🙂b" "🙂"))
(check #t (string-starts-with? "abc" "ab"))
(check #t (string-ends-with? "abc" "bc"))
(check 7 ({:a 7} :a))
(check 8 ({:a 7} :missing 8))
(check 7 (:a {:a 7}))
(check 8 (:a nil 8))
(check 8 (:a 42 8))
(check 4 ([3 4] 1))
(check 9 ([3 4] 9 9))
(check #t (fails? (fn () ([3] "0"))))
(check 7 (apply {:a 7} [:a]))
(check '(2 3) (array-to-list (map inc [1 2])))
(check '(1 2) (array-to-list (map :a [{:a 1} {:a 2}])))
(check #t (fails? (fn () (map + '(1) '(2)))))
(check '(2 4) (array-to-list (filter even? [1 2 3 4])))
(check 10 (reduce + 0 [1 2 3 4]))
(check '(0 1 2) (array-to-list (range 3)))
(check '(2 3) (array-to-list (drop 1 [1 2 3])))
(check '(1 2) (array-to-list (take 2 [1 2 3])))
(check '(1 2 3) (array-to-list (sort [3 1 2])))
(check nil (exists (fn (a b) #f) '(1) '(2 3)))
(check 3 (fold-left + 0 '(1) '(2 3)))
(check 3 (fold-right + 0 '(1) '(2 3)))
(check #t (nil? (for-all (fn (a b) nil) '(1) '(2 3))))
(check '(a . 1) (assoc 'a '((a . 1) (b . 2))))

(def t {:a 1})

(check 2 (get (put t :b 2) :b))
(check 1 (length t))
(check 3 (get (update t :a + 2) :a))
(check 0 (length (dissoc t :a)))

(def times 0)

(def visits [])

(dotimes (i (begin
              (set! times (+ times 1))
              3))
  (push! visits i))
(check 1 times)
(check '(0 1 2) (array-to-list visits))
(check #t (nil? (condition-message 7)))
(check #t (nil? (signal "declined")))
(check #t (nil? (find-restart 'absent)))
(check #t (array? (compute-restarts)))
(try
  (error "oops" 1 2)
  (catch (error? c)
    (check #t (table? c))
    (check 'error (get c :type))
    (check '(1 2) (array-to-list (get c :data)))))
(check #t (int? (current-jiffy)))
(check 1000000000 (jiffies-per-second))
(let ((before (current-jiffy))
      (after (current-jiffy)))
  (check #t (<= before after)))
(check #t (> (current-second) 0))
(require otium.extra :as extra)
(check 12 (extra/-> 5 (+ 1) (* 2)))
(check 6 ((extra/partial + 1 2) 3))
(check 3 ((extra/comp inc inc) 1))
(check 2 (get (extra/frequencies [:a :a :b]) :a))
(check '(1 3) (array-to-list (get (extra/group-by odd? [1 2 3]) #t)))

(check "rest string" "🙂b" (rest "a🙂b"))
(check "rest empty string" "" (rest ""))
(check "unicode string-index" 2 (string-index "a🙂é🙂" "é🙂"))
(check "string-index start" 3 (string-index "a🙂é🙂" "🙂" 2))
(check "string-index missing" nil (string-index "abc" "z"))
(check "string-index empty at end" 3 (string-index "abc" "" 3))
(check "string-index beyond end" nil (string-index "abc" "" 4))
(check "repeat unicode" "é🙂é🙂" (string-repeat "é🙂" 2))
(check "repeat zero" "" (string-repeat "a" 0))
(check "find stops on an improper tail" 1 (find (fn (_) #t) '(1 . 2)))
(check "find-index list" 1 (find-index even? '(1 2 3)))
(check "find-index array" 1 (find-index even? [1 2 3]))
(check "find-index absent" nil (find-index even? [1 3]))
(check "insert list" '(1 2 3) (insert-at '(1 3) 1 2))
(check "insert array" '(1 2 3) (array-to-list (insert-at [1 3] 1 2)))
(check "remove list" '(1 3) (remove-at '(1 2 3) 1))
(check "remove array" '(1 3) (array-to-list (remove-at [1 2 3] 1)))
(check "clamp" 5 (clamp 9 1 5))
(check "exists arrays" 4 (exists (fn (x) (and (even? x) x)) [1 3 4 6]))
(check "exists mixed" 5 (exists (fn (a b) (and (= a 2) b)) [1 2 3] '(4 5)))
(check "for-all arrays" #t (for-all < [1 2] [2 3]))
(check "for-all shortest" #t (for-all < [1] '(2 0)))
(check "for-all preserves falsy result" nil (for-all (fn (_) nil) [1 2]))
(check "member array tail" '(2 3) (array-to-list (member 2 [1 2 3])))

(check "find list miss" nil (find even? '(1 3)))
(check "find array miss" nil (find even? [1 3]))
(check "find false element" #f (find (fn (_) #t) '(#f)))
(check "find nil element index" 0 (find-index nil? [nil]))
(check "member miss" nil (member 4 '(1 2)))
(check "member array miss" nil (member 4 [1 2]))
(check "memq miss" nil (memq 'z '(a b)))
(check "assoc miss" nil (assoc 'z '((a . 1))))
(check "assq miss" nil (assq 'z '((a . 1))))
(check "exists empty" nil (exists identity []))
(check "contains stays boolean" #f (contains? [1 2] 4))
(let ((t {:missing #f}))
  (put! t :missing (find even? [1 3]))
  (check "lookup absence removes table key" #f (contains? t :missing)))

(let ((calls 0))
  (check "case expression once and multiple forms"
         12
         (case (begin
                 (set! calls (+ calls 1))
                 :b)
           ((:a :b) (set! calls (+ calls 10)) 12)
           (else 0)))
  (check "case side effects" 11 calls))
(check "case structural datums" :yes (case '(a 1) (((a 1)) :yes)))
(check "case first match"
       1
       (case 7
         ((7) 1)
         ((7) 2)))
(check "case missing" nil (case :other ((:a) 1)))
(check "case empty" nil (case :other))
(check "case false datum" :yes (case #f ((#f nil) :yes)))
(check "case strings" 1 (case (str "a" "b") (("ab") 1)))

(check "case rejects nonfinal else"
       #t
       (fails? (fn ()
                 (eval '(case 1
                          (else 1)
                          ((2) 2))))))
(check "case rejects malformed alternatives" #t (fails? (fn () (eval '(case 1 (1 2))))))

;; Each pass binds the index afresh, so captured indices keep their value.
(let ((callbacks []))
  (dotimes (i 3) (push! callbacks (fn () i)))
  (check [0 1 2] (map (fn (f) (f)) callbacks)))
(let ((seen []))
  (check nil (dotimes (i 5) (push! seen i) (set! i (+ i 1))))
  (check [0 2 4] seen))

;; Iteration keeps the initial array length but reads current elements.
(for-each
  (fn (operation)
    (let ((source [1 2 3]) (seen []))
      (operation (fn (x) (push! seen x) (pop! source) x) source)
      (check [1 2 nil] seen))
    (let ((source [1 2]) (seen []))
      (operation (fn (x) (push! seen x) (push! source 9) x) source)
      (check [1 2] seen)))
  (list for-each map filter (fn (f xs) (reduce (fn (acc x) (f x) acc) nil xs))))
(for-each
  (fn (source)
    (check 17 (reduce #f 17 source))
    (check nil (for-each #f source)))
  (list nil '() []))
(check 4 (reduce {:a 4} :a '(9)))
(check '(1 2) (map :a (list {:a 1} {:a 2})))
(check '(0 2) (filter [#t nil #t] '(0 1 2)))
(check [0 2] (filter [#t nil #t] [0 1 2]))
(check '(1 2) (filter (fn (x) '()) '(1 2)))
(let ((calls 0))
  (check #t (fails? (fn () (reduce (fn (acc x) (set! calls (+ calls 1)) (+ acc x)) 0 '(1 . 2)))))
  (check 0 calls))

(report "library")
