(require otium.test :refer (check fails? report))

(check 42 (call-1cc (fn (k) (+ 1 (k 42)))))
(check 7 (call-1cc (fn (k) 7)))
(check nil (call-1cc (fn (k) (k))))
(check :found (call-1cc (fn (k)
                          (map (fn (x)
                                 (if (= x 3)
                                     (k :found)
                                     x))
                               '(1 2 3 4)))))
(check :found (call-1cc (fn (k) (apply (fn (x) (k x)) '(:found)))))

;; Escapes run the cleanups of the extents they leave, innermost first, each
;; with its own params.
(defparam level 0)

(def log [])

(check :out (call-1cc (fn (k)
                        (unwind-protect
                          (with-params ((level 1))
                            (unwind-protect
                              (k :out)
                              (push! log (list :inner (level)))))
                          (push! log (list :outer (level)))))))
(check ['(:inner 1) '(:outer 0)] log)
(check 2 (with-params ((level 1)) (call-1cc (fn (k) (with-params ((level 2)) (k (level)))))))
(check 0 (level))

;; with blocks see an escape as a normal exit.
(def outcome :unset)

(check :left (call-1cc (fn (k) (call-with-cleanup (fn () (k :left)) (fn (o) (set! outcome o))))))
(check nil outcome)

;; Errors and handlers inside the receiver
(check "boom"
       (try
         (call-1cc (fn (k) (error "boom")))
         (catch (error? e) (condition-message e))))
(check 5 (restart-case (call-1cc (fn (k) (invoke-restart 'use 5))) (use (v) v)))

;; One shot
(def saved nil)

(check 1
       (call-1cc (fn (k)
                   (set! saved k)
                   1)))
(check #t (fails? (fn () (saved 2))))

;; Generators
(def (make-generator items)
  (def return-k nil)
  (def resume-k nil)
  (fn ()
    (call-1cc (fn (r)
                (set! return-k r)
                (if resume-k
                    (resume-k nil)
                    (begin
                      (for-each (fn (x)
                                  (call-1cc (fn (c)
                                              (set! resume-k c)
                                              (return-k x))))
                                items)
                      (return-k :done)))))))

(def g (make-generator '(a b c)))

(check '(a b c :done) (list (g) (g) (g) (g)))

;; A generator resumed from a later top-level form
(def g2 (make-generator '(x y)))

(check 'x (g2))
(check 'y (g2))

;; Escaping out of a native callback, here a handler called by signal,
;; unwinds the native call and runs the cleanups on the way.
(set! log [])
(check :handled (call-1cc (fn (k)
                            (unwind-protect
                              (handler-bind (((fn (c) #t) (fn (c) (k :handled))))
                                (signal 'test)
                                :not-handled)
                              (push! log :cleanup)))))
(check [:cleanup] log)

;; Deep stacks
(def (deep n k)
  (if (= n 0)
      (k :bottom)
      (+ 1 (deep (- n 1) k))))

(check :bottom (call-1cc (fn (k) (deep 5000 k))))

(report "continuations")
