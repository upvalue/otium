;; Allocation checks for for and dotimes. Chez only: the C runtime interprets
;; and allocates where Chez compiles these loops to plain jumps.
(require otium.memory :as memory)
(require otium.test :refer (check report))

(def items (for ((i :range 1000) (out :collect i)) => out))

(def numbers (list-to-array items))

(def (sum xs)
  (for ((x :in xs) (total :sum x)) => total))

(def (count-skipping xs)
  (for next ((x :in xs) (n := 0 (+ n 1)))
    => n
    (if (odd? x)
        (next)
        (next))))

(def (count-to-big xs)
  (for next ((x :in xs) (n := 0 (+ n 1)))
    => n
    (if (> x 500)
        (next :done)
        (next))))

(def (sum-rebinding xs)
  (for next ((x :in xs) (total :sum x))
    => total
    (if (odd? x)
        (next)
        (let ((x 0)) (next)))))

(def (allocation thunk)
  (thunk)
  (let ((before (memory/allocated)))
    (thunk)
    (- (memory/allocated) before)))

(check "summing a list allocates nothing" 0 (allocation (fn () (sum items))))
(check "summing an array allocates nothing" 0 (allocation (fn () (sum numbers))))
(check "a named loop allocates nothing" 0 (allocation (fn () (count-skipping items))))
(check "a body that rebinds a clause name allocates nothing" 0 (allocation (fn () (sum-rebinding items))))
;; The loop name takes a rest list; see for-expand in lib/otium/core.ot.
(check "(next :done) allocates one pair" 16 (allocation (fn () (count-to-big items))))
(check "dotimes allocates nothing" 0 (allocation (fn () (dotimes (i 1000) i))))
;; One pair while collecting and one more from the final reverse.
(check "collecting allocates two pairs per element"
       (* 32 1000)
       (allocation (fn () (for ((x :in items) (out :collect x)) => out))))

(report "loops-cost")
