;; for and dotimes, on both runtimes. Allocation checks are in benchmarks/loops.ot.
(require otium.test :refer (check fails? report))

;; --- walking things ----------------------------------------------------------

(let ((seen []))
  (check "body runs for each element, result is nil"
         nil
         (for ((x :in '(1 2 3))) (push! seen x)))
  (check "elements in order" [1 2 3] seen))

(check "list" '(a b c) (for ((x :in '(a b c)) (out :collect x)) => out))
(check "array" '(1 2 3) (for ((x :in [1 2 3]) (out :collect x)) => out))
(check "string gives characters" '(#\h #\i) (for ((c :in "hi") (out :collect c)) => out))
(check "nil is empty" '() (for ((x :in nil) (out :collect x)) => out))
(check "empty array" '() (for ((x :in []) (out :collect x)) => out))

(check "table entries in insertion order"
       '((:b 2) (:a 1))
       (for ((k v :in {:b 2 :a 1}) (out :collect (list k v))) => out))

(check "range to end" '(0 1 2) (for ((i :range 3) (out :collect i)) => out))
(check "range from start" '(2 3 4) (for ((i :range 2 5) (out :collect i)) => out))
(check "range counting down" '(10 7 4 1) (for ((i :range 10 0 -3) (out :collect i)) => out))
(let ((step -2))
  (check "range with a step chosen at run time"
         '(4 2)
         (for ((i :range 4 0 step) (out :collect i)) => out)))

(check "a stepped variable"
       '(1 2 4 8)
       (for ((i :range 4) (n := 1 (* n 2)) (out :collect n)) => out))

;; --- several clauses step together -------------------------------------------

(check "clauses step side by side and stop at the shortest"
       '((0 a) (1 b) (2 c))
       (for ((x :in '(a b c)) (i :range 100) (pairs :collect (list i x))) => pairs))

;; Nesting is one loop inside another.
(check "nested loops"
       '(((0 0) (0 1) (0 2)) ((1 0) (1 1) (1 2)))
       (for ((r :range 2)
             (rows :collect (for ((c :range 3) (cells :collect (list r c))) => cells)))
         => rows))

;; --- results -----------------------------------------------------------------

(check "several results in one pass"
       [(list 2 4) 10]
       (for ((x :in '(1 2 3 4))
             (evens :collect x :when (even? x))
             (total :sum x))
         => [evens total]))

(check "a fold is a stepped variable"
       120
       (for ((i :range 1 6) (product := 1 (* product i))) => product))

(check "stepped variables are visible to =>"
       [3 6]
       (for ((x :in '(1 2 3)) (n := 0 (+ n 1)) (total :sum x)) => [n total]))

;; --- named loops: skip and stop ------------------------------------------------

(check "skip a pass by calling next early"
       '(1 3)
       (for next ((x :in '(1 nil 3)) (out :collect x :when x))
         => out
         (if (nil? x)
             (next)
             (next))))

(check "stop by not calling next; => does not run"
       :negative
       (for next ((x :in '(1 2 -1 4)) (total :sum x))
         => total
         (if (negative? x)
             :negative
             (next))))

(check "the loop runs to the end when next is always called"
       7
       (for next ((x :in '(1 2 4)) (total :sum x))
         => total
         (if (negative? x)
             :negative
             (next))))

(check "a sum is readable during the loop"
       6
       (for next ((x :in '(1 2 3 4 5)) (total :sum x))
         => total
         (if (> (+ total x) 6)
             total
             (next))))

(check "find the first match"
       :found-b
       (for next ((x :in [:a :b :c]))
         (if (eq? x :b)
             :found-b
             (next))))

;; Reading a C-style iterator, like manse/ghostty.ot's row walk.
(let ((rows [:r0 :r1 :r2])
      (cursor 0))
  (check "a loop with no driver that ends"
         '((0 :r0) (1 :r1) (2 :r2))
         (for next ((y := 0 (+ y 1)) (seen := '() (cons (list y (rows y)) seen)))
           (if (< cursor (length rows))
               (begin
                 (set! cursor (+ cursor 1))
                 (next))
               (reverse seen)))))

(check "an inner binding of next shadows the loop's, so this stops"
       :not-the-loop
       (for next ((x :in '(1 2)) (out :collect x))
         => out
         (let ((next (fn () :not-the-loop)))
           (next))))

;; --- evaluation -------------------------------------------------------------

(let ((calls 0))
  (for ((x :in (begin (set! calls (+ calls 1)) '(1 2 3)))))
  (check "the sequence is evaluated once" 1 calls))

(let ((order []))
  (for ((x :in '(1 2))
        (a :collect (begin (push! order [:a x]) x))
        (b :collect (begin (push! order [:b x]) x))))
  (check "accumulators run in clause order" [[:a 1] [:b 1] [:a 2] [:b 2]] order))

(check "unknown clause" #t (fails? '(for ((x :bogus 1)))))
(check "bad range" #t (fails? '(for ((i :range)))))
(check "step of zero" #t (fails? '(for ((i :range 0 10 0)))))

;; --- arrays --------------------------------------------------------------------

(check "collect into an array" [1 4 9] (for ((x :in '(1 2 3)) (out :collect-array (* x x))) => out))
(check "collect into an array with :when"
       [2 4]
       (for ((x :in [1 2 3 4]) (out :collect-array x :when (even? x))) => out))
(check "each loop gets a fresh array"
       [[0] [0]]
       (for ((_ :range 2) (outer :collect-array (for ((i :range 1) (inner :collect-array i)) => inner))) => outer))
(check "the array is readable during the loop"
       [0 1 2]
       (for next ((x :in '(a b c d)) (out :collect-array (length out)))
         => out
         (if (= (length out) 3)
             out
             (next))))

;; --- stopping with (next :done) ------------------------------------------------

(check "(next :done) steps this pass and runs =>"
       '(1 2 3)
       (for next ((x :in '(1 2 3 4 5)) (out :collect x))
         => out
         (if (= x 3)
             (next :done)
             (next))))

(check "(next :done) steps sums and stepped variables"
       [6 3]
       (for next ((x :in '(1 2 3 4 5)) (total :sum x) (n := 0 (+ n 1)))
         => [total n]
         (if (= x 3)
             (next :done)
             (next))))

(check "(next :done) on the last pass"
       '(1 2)
       (for next ((x :in '(1 2)) (out :collect x))
         => out
         (if (= x 2)
             (next :done)
             (next))))

(check "(next :done) without => returns nil"
       nil
       (for next ((x :in '(1 2)))
         (next :done)))

(check "anything but :done is an error"
       #t
       (fails? (fn ()
                 (for next ((x :in '(1 2)))
                   (next :stop)))))

;; --- names the body rebinds ------------------------------------------------------

(check "a body that rebinds a clause name still steps with the pass's value"
       '(1 2 3)
       (for next ((x :in '(1 2 3)) (out :collect x))
         => out
         (let ((x 100))
           (next))))

(check "the same for sums"
       6
       (for next ((x :in '(1 2 3)) (total :sum x))
         => total
         (let ((total 0))
           (next))))

;; --- dotimes -----------------------------------------------------------------------

(check "dotimes returns nil" nil (dotimes (i 3) i))
(check "dotimes with an empty body" nil (dotimes (i 3)))
(let ((seen []))
  (dotimes (i 0) (push! seen i))
  (check "dotimes zero times" [] seen))
(let ((seen []))
  (dotimes [i 3] (push! seen i))
  (check "dotimes accepts a bracketed spec" [0 1 2] seen))

(check "an empty body" nil (for ((i :range 3))))

(report "loops")
