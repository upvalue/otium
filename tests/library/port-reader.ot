(require otium.test :refer (check report))
(require reader-datums :as datums)
(for-each (fn (fixture)
            (let ((p (open-input-string (str (car fixture) "\n:tail"))))
              (check (cadr fixture) (read p))
              (check :tail (read p))
              (check #t (eof-object? (read p)))))
          datums/positive)
(report "port datum reader")
