(println "plain" "a b" 'symbol)
(println ["a b" 'symbol ["quote\"slash\\" "line\nbreak"]])
(println {"key" "value" :nested ["x"]})
(println '("a" "b" . "tail"))
(println (str ["x" 'x]))
(println (buffer->string (buffer ["x"])))
(write "a b" ["x"] '("x"))
(newline)
(println ["\0\e\t\r\n" "é🙂"])

; Opaque values print with their kind and, where there is one, a name.
(require otium.thread :as thread)
(def (named-fn) #t)
(def bound-fn (fn (a) a))
(defmacro twice (e) `(do ,e ,e))
(defgeneric (paint widget))
(defclass Widget label)
(defrecord Point (x y))
(def short (buffer "hello"))
(def long (buffer "012345678901234567890123456789012345678é tail"))
(println named-fn bound-fn (fn (a) a))
(println car + / paint)
(println twice Widget (make Widget :label "ok") Point (record-new Point 1 2))
(write short long)
(newline)
(println (thread/self) (thread/spawn-named 'worker (fn () nil)))
(println [named-fn] {:f car})
; Displayed on its own a buffer is its text; inside a collection it's opaque.
(println short (str short "!") [short])
