(ns docs-test)

(require otium.test :refer (check report))

(check 'docs-test (current-ns))

(def answer
  "The answer."
  42)

(check "docs-test/answer: The answer." (describe 'answer))

(def literal "A string value.")

(check "docs-test/literal: no documentation" (describe 'literal))

(def (square x)
  "Square the input."
  (* x x))

(check 36 (square 6))
(check "docs-test/square: Square the input." (describe 'square))

(defmacro twice (x)
  "Double an expression."
  `(+ ,x ,x))

(check 10 (twice 5))
(check "docs-test/twice: Double an expression." (describe 'twice))

(defonce saved
  "Original documentation."
  7)

(defonce saved
  "Replacement documentation."
  8)

(check 7 saved)
(check "docs-test/saved: Original documentation." (describe 'saved))
(check #t (string-starts-with? (describe 'eval) "otium.core/eval: "))

(def eval
  "My evaluator."
  123)

(check "docs-test/eval: My evaluator." (describe 'eval))

(def answer 9)

(check "docs-test/answer: no documentation" (describe 'answer))
(check nil (describe 'missing-binding))
(check #t (string-starts-with? (describe 'ns) "(ns name"))
(check #t
       (try
         (describe 123)
         (catch (error? e) #t)))
(check '() (append))
(check '(1 2) (append '(1) '(2)))
(check #t
       (try
         (append nil)
         (catch (error? e) #t)))
(println "reflection checks passed")
