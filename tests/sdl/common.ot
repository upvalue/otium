(require otium.test :refer (check report))

(def fixture (ffi/open-library (list fixture-path)))

(def fixture-poll (ffi/bind fixture "fixture_poll" '(pointer) 'bool #t))

(def event (ffi/alloc SDL_Event 1))

(unwind-protect
  (begin
    (fixture-poll event)
    (let ((first (event-copy event)))
      (fixture-poll event)
      (check (list 'text 123 SDL_EVENT_TEXT_INPUT "first text") first)
      (check (list 'text 123 SDL_EVENT_TEXT_INPUT "changed") (event-copy event)))
    (ffi/field-set! event SDL_Event '(type) 999)
    (check '(event 123 999) (event-copy event))
    (ffi/field-set! event SDL_Event '(type) SDL_EVENT_KEY_UP)
    (ffi/field-set! event SDL_Event '(key scancode) SDL_SCANCODE_R)
    (ffi/field-set! event SDL_Event '(key repeat) #f)
    (check (list 'key 123 SDL_EVENT_KEY_UP SDL_SCANCODE_R #f) (event-copy event))
    (check #f (event-action (event-copy event)))
    (ffi/field-set! event SDL_Event '(type) SDL_EVENT_MOUSE_BUTTON_DOWN)
    (ffi/field-set! event SDL_Event '(button button) 1)
    (ffi/field-set! event SDL_Event '(button x) 15.0)
    (ffi/field-set! event SDL_Event '(button y) 21.0)
    (check (list 'button 123 SDL_EVENT_MOUSE_BUTTON_DOWN 1 15.0 21.0) (event-copy event))
    (ffi/field-set! event SDL_Event '(type) SDL_EVENT_MOUSE_WHEEL)
    (ffi/field-set! event SDL_Event '(wheel x) 1.5)
    (ffi/field-set! event SDL_Event '(wheel y) -2.0)
    (check (list 'wheel 123 SDL_EVENT_MOUSE_WHEEL 1.5 -2.0) (event-copy event))
    (ffi/field-set! event SDL_Event '(type) SDL_EVENT_WINDOW_RESIZED)
    (ffi/field-set! event SDL_Event '(window data1) 800)
    (ffi/field-set! event SDL_Event '(window data2) 600)
    (check (list 'resize 123 SDL_EVENT_WINDOW_RESIZED 800 600) (event-copy event)))
  (ffi/free! event))

;; The same manifest mismatch path must be an FFI ABI condition on both hosts.
(check 'abi
       (try
         (sdl-layout-check 1 2)
         (catch (ffi/error? c) (ffi/error-reason c))))
(check 0 (ffi/allocation-count))

;; Dummy audio does not require a window or a display.
(unwind-protect
  (begin
    (SDL_SetMainReady)
    (sdl-check (SDL_Init SDL_INIT_AUDIO))
    (audio-open!)
    (audio-refill!)
    (check 9600 (SDL_GetAudioStreamQueued sdl-audio))
    (audio-refill!)
    (audio-refill!)
    (audio-refill!)
    (check 19200 (SDL_GetAudioStreamQueued sdl-audio))
    (sdl-check (SDL_ResumeAudioStreamDevice sdl-audio))
    (SDL_Delay 200)
    (check #t (< (SDL_GetAudioStreamQueued sdl-audio) 19200)))
  (sdl-close!))
(check 0 (SDL_WasInit 0))
(check 0 (ffi/allocation-count))
(report "sdl fixture")
