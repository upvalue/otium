(require otium.thread :as thread :refer (spawn sleep))

(def reader (spawn (fn () (read-line))))

(let wait ()
  (unless (eq? (thread/status reader) :waiting)
    (thread/yield)
    (wait)))
(thread/kill! reader)
(thread/join reader)
(write-string "ready\n" (current-error-port))
(println (read-line))
