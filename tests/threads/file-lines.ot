(require otium.thread :as thread :refer (spawn))

;; Threads writing whole lines to one buffered file port never split a line.
(def path (car (otium.process/arguments)))

(def port (open-output-file path))

(def (writer name)
  (dotimes (i 2000)
    (write-string (string-append name "-" (number->string i) "\n") port)))

(def threads (map (fn (name) (spawn writer name)) '("alpha" "beta" "gamma")))

(for-each thread/join threads)
(close-output-port port)

;; Each thread's lines arrive whole and in its own order.
(def lines (string-split (read-file path) "\n"))

(println (length lines))
(println (map (fn (name)
                (let ((mine (filter (fn (line) (string-starts-with? line (string-append name "-"))) lines)))
                  (equal? mine (map (fn (i) (string-append name "-" (number->string i))) (range 2000)))))
              '("alpha" "beta" "gamma")))
