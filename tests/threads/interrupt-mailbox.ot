(require otium.thread :as thread :refer (spawn send receive sleep self))
(def main (self))
(def target
  (spawn (fn ()
           (let ((first (%mailbox-next nil)))
             (send main :ready)
             (sleep 0.1)
             (%mailbox-take)
             (list first (%mailbox-next nil))))))
(send target :reserved)
(send target :next)
(receive (:ready nil))
(thread/interrupt! target
  (fn ()
    (send (self) :inner)
    (receive (:inner nil))))
(unless (equal? (thread/join target) '(:reserved :next))
  (error "interrupt corrupted outer mailbox cursor"))
(println "checks passed")
