;; Taking the first message is constant time: draining a mailbox of n
;; messages is linear. Taking each by shifting the rest took about 1.5 s
;; for 160k.
(require otium.test :refer (check report))
(require otium.thread :refer (self send receive))

(def n 160000)
(def start (otium.dev/%clock))
(dotimes (i n) (send (self) i))
(def total
  (let loop ((i 0) (sum 0))
    (if (= i n)
        sum
        (loop (+ i 1) (+ sum (receive (m m)))))))
(check "every message arrives once, in order" (/ (* n (- n 1)) 2) total)
(check "draining is linear" #t (< (- (otium.dev/%clock) start) 500))
(report "mailbox drain")
