;; With the real ticker, a loop that never yields is preempted, so a sleeper
;; and a second spinner both get to run.
(require otium.thread :as thread :refer (spawn sleep))

(def flag #f)

(def (spin n)
  (if flag
      n
      (spin (+ n 1))))

(def a (spawn spin 0))

(def b (spawn spin 0))

(sleep 0.02)
(set! flag #t)
(println (and (> (thread/join a) 0) (> (thread/join b) 0)))
