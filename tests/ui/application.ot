(require (otium.ui.window :as window))
(require (otium.sdl :as sdl))
(require (otium.ffi :as ffi))

(def calls [])

(def failed? #f)

(def icon-ok? #t)

(require otium.test :refer (check report))

(set! sdl/set-hint
      (fn (key value)
        (push! calls (list 'hint key value))
        #t))
(set! sdl/set-app-metadata
      (fn (name version id)
        (push! calls (list 'metadata name version id))
        #t))
(set! sdl/load-surface
      (fn (path)
        (push! calls (list 'load path))
        surface))
(set! sdl/set-window-icon
      (fn (window image)
        (push! calls (list 'icon window (eq? image surface)))
        icon-ok?))
(set! sdl/destroy-surface (fn (image) (push! calls (list 'destroy (eq? image surface)))))
(set! sdl/scale-surface
      (fn (image width height mode)
        (push! calls (list 'scale (eq? image surface) width height))
        scaled))
(set! sdl/raise-window
      (fn (window)
        (push! calls (list 'raise window))
        #t))
(set! sdl/get-error (fn () "icon failed"))

;; SDL_Surface begins with flags, format, w and h.
(def surface (ffi/alloc 'i32 4))

(def scaled (ffi/alloc 'i32 4))

(ffi/set! surface 'i32 2 16)

(ffi/set! surface 'i32 3 16)

(unwind-protect
  (begin
    (window/configure-app! {})
    (check '((hint "SDL_MAC_BACKGROUND_APP" "0") (metadata "Otium" "" "org.otium.application")) (array-to-list calls))
    (set! calls [])
    (window/configure-app! {:name "Example" :version "1" :id "org.example" :background #t})
    (check '((hint "SDL_MAC_BACKGROUND_APP" "1") (metadata "Example" "1" "org.example")) (array-to-list calls))
    (set! calls [])
    (window/present-window! 'window {})
    (check '((raise window)) (array-to-list calls))
    (set! calls [])
    (window/present-window! 'window {:icon "icon.png" :foreground #f})
    (check '((load "icon.png") (icon window #t) (destroy #t)) (array-to-list calls))
    (set! calls [])
    (set! icon-ok? #f)
    (try
      (window/present-window! 'window {:icon "icon.png"})
      (catch c (set! failed? #t)))
    (check #t failed?)
    (check '((load "icon.png") (icon window #t) (destroy #t)) (array-to-list calls))
    ;; Large icons are scaled down before the window system copies them.
    (set! calls [])
    (set! icon-ok? #t)
    (ffi/set! surface 'i32 2 1024)
    (ffi/set! surface 'i32 3 512)
    (window/present-window! 'window {:icon "icon.png" :foreground #f})
    (check '((load "icon.png") (scale #t 512 256) (icon window #f) (destroy #f) (destroy #t)) (array-to-list calls)))
  (ffi/free! surface)
  (ffi/free! scaled))
(report "ui application")
