(require otium.ui :as ui)
(require otium.ui.window :as window)
(require otium.ui.native :as native)
(require otium.ui.gpu :as gpu)
(require otium.ui.input :as input)
(require otium.sdl :as sdl)
(require otium.dev :as dev)
(require otium.test :refer (check report))

(def flags sdl/WINDOW_INPUT_FOCUS)

(def paints 0)

(def steps 0)

(def afters 0)

(def event nil)

(set! sdl/get-window-flags (fn (_) flags))
(set! native/poll-event
      (fn (_)
        (let ((e event))
          (set! event nil)
          e)))
(set! gpu/layout! (fn _ nil))
(set! gpu/paint! (fn _ (set! paints (+ paints 1))))
(set! native/gpu-frame (fn _ #t))

(def w
  {:tree (ui/root)
   :pointer (input/pointer)
   :renderer nil
   :window nil
   :initialized? #t
   :view #f
   :frame 0
   :capture ""
   :dirty? #t
   :options {:render-on-demand? #t
             :poll-ms 16
             :background-poll-ms 100
             :step! (fn (_) (set! steps (+ steps 1)))
             :after-frame! (fn (_) (set! afters (+ afters 1)))}})

(set! ui/open-windows (list w))
(window/frame! w)
(check "first frame paints" 1 paints)
(dotimes (i 10)
  (window/frame! w))
(check "idle skips painting" 1 paints)
(check "idle still services step" 11 steps)
(check "idle still services shutdown hook" 11 afters)
(check "foreground poll interval" 16 (window/wait-ms))
(ui/invalidate! w)
(window/frame! w)
(check "invalidation paints" 2 paints)
(set! dev/revision (+ dev/revision 1))
(window/frame! w)
(check "dev change paints" 3 paints)
(set! flags sdl/WINDOW_OCCLUDED)
(ui/invalidate! w)
(window/frame! w)
(check "occluded skips painting" 3 paints)
(check "hidden retains invalidation" #t (w :dirty?))
(check "background poll interval" 100 (window/wait-ms))
(ui/capture! w "/tmp/demand.png")
(window/frame! w)
(check "capture overrides visibility" 4 paints)
(set! flags sdl/WINDOW_INPUT_FOCUS)
(window/frame! w)
(check "becoming visible paints" 5 paints)
(set! event {:kind :expose})
(window/frame! w)
(check "exposure paints" 6 paints)
(put! (w :options) :render-on-demand? #f)
(window/frame! w)
(window/frame! w)
(check "default windows paint continuously" 8 paints)
(put! (w :options) :render-on-demand? #t)

(def builds 0)

(def layouts 0)

(set! gpu/layout! (fn _ (set! layouts (+ layouts 1))))
(set! native/text-input (fn _ #t))
(ui/set-view! w
              (fn ()
                (set! builds (+ builds 1))
                (ui/new ui/Box nil)))
(window/frame! w)

(def before-builds builds)

(def before-layouts layouts)

(def before-paints paints)

(set! ((get (ui/children (w :tree)) 0) :bounds) (ui/bounds 0 0 100 100))
(set! event {:kind :pointer-move :x 10 :y 10})
(window/frame! w)
(check "hover paints" (+ before-paints 1) paints)
(check "hover skips view" before-builds builds)
(check "hover skips layout" before-layouts layouts)
(set! event {:kind :pointer-move :x 11 :y 11})
(window/frame! w)
(check "unchanged hover skips painting" (+ before-paints 1) paints)
(set! event {:kind :pointer-leave})
(window/frame! w)
(check "leaving hover only repaints" before-builds builds)
(set! event {:kind :key-down :key "Unused"})
(window/frame! w)
(check "unhandled key skips view" before-builds builds)

(defclass Switcher
  :is ui/Widget)

(def switched? #f)

(def typed "")

(def text-enabled? #f)

(defmethod (ui/default-focusable? (widget Switcher))
  #t)

(defmethod (ui/handle-event (widget Switcher) event)
  (when (equal? (get event :key) "Switch")
    (set! switched? #t)
    :handled))

(set! native/text-input
      (fn (_ enabled?)
        (set! text-enabled? enabled?)
        #t))
(ui/set-view! w
              (fn ()
                (set! builds (+ builds 1))
                (if switched?
                    (ui/text-field {:focus #t :value typed :on-change (fn (value) (set! typed value))})
                    (ui/new Switcher {:autofocus #t}))))
(window/frame! w)

(def queued (list {:kind :key-down :key "Switch"} {:kind :text-input :text "x"}))

(def original-poll native/poll-event)

(set! native/poll-event
      (fn (_)
        (unless (null? queued)
          (let ((e (car queued)))
            (when (eq? (get e :kind) :text-input)
              ;; Dispatch, rather than polling, must see the rebuilt focus.
              (check "switch event changed state" #t switched?))
            (set! queued (cdr queued))
            e))))
(set! before-builds builds)
(window/frame! w)
(check "queued text reaches newly focused field" "x" typed)
(check "text input follows rebuilt focus" #t text-enabled?)
(check "handled events rebuild once each" (+ before-builds 2) builds)
(set! native/poll-event original-poll)

;; :on-close-request can refuse a close; without it, a close request closes.
(def closes 0)

(def requests 0)

(def real-close! window/close!)

(set! window/close! (fn (_) (set! closes (+ closes 1))))
(put! (w :options)
      :on-close-request (fn (_)
                          (set! requests (+ requests 1))
                          (> requests 1)))
(set! event {:kind :quit})
(window/frame! w)
(check "close request asks the window" 1 requests)
(check "refused close request keeps the window" 0 closes)
(set! event {:kind :quit})
(window/frame! w)
(check "allowed close request closes" 1 closes)
(put! (w :options) :on-close-request nil)
(set! event {:kind :quit})
(window/frame! w)
(check "close request closes by default" 2 closes)
(set! window/close! real-close!)
(ui/invalidate! w)
(ui/capture! w "/tmp/retry.png")

(def attempts 0)

(def ticks 0)

(def broken? #t)

(set! gpu/paint!
      (fn _
        (set! attempts (+ attempts 1))
        (when broken? (error "broken view"))))
(set! sdl/wait-event-timeout
      (fn _
        (set! ticks (+ ticks 1))
        (cond
          ((= ticks 2) (check "failed capture does not spin" 1 attempts) (set! dev/revision (+ dev/revision 1)))
          ((= ticks 3) (check "dev revision retries failed view" 2 attempts) (set! broken? #f) (ui/invalidate! w))
          ((= ticks 4) (set! ui/open-windows '())))))
(window/run)
(check "repaired view succeeds" 3 attempts)
(check "successful retry clears error" #f (w :last-error))
(check "pending capture completes after repair" "" (w :capture))
(report "ui demand")
