(require (otium.ui :as ui))
(require (otium.gfx :as gfx))
(require (otium.ui.gpu :as gpu))
(require (otium.ui.native :as native))
(require (otium.ffi :as ffi))
(require (otium.ui.input :as input))
(require (ui.layout :as demo))
(require (ui.terminal :as terminal))
(native/load-config! "build/ui-config.ot")

(require otium.test :refer (check fails? report))

(def (near label expected actual)
  (check label
         expected
         (if (< (abs (- expected actual)) 0.01)
             expected
             actual)))

(def (child parent i)
  (get (ui/children parent) i))

(defclass Box
  :is ui/Widget
  (grow :init 0)
  (w :init 40)
  (h :init 20))

(defmethod (ui/measure (w Box) limits)
  (check "constrained width mode" #t (not (nil? (ui/limit-ref limits :width-mode))))
  (ui/size (w :w) (w :h)))

(defmethod (ui/layout-style (w Box))
  {:grow (w :grow)})

(def modes {})

(defclass Wrapping
  :is ui/Widget)

(defmethod (ui/measure (w Wrapping) limits)
  (for-each (fn (axis)
              (let ((mode (ui/limit-ref limits
                                        (if (eq? axis :width)
                                            :width-mode
                                            :height-mode))))
                (check "constraint value present iff defined"
                       (not (eq? mode :undefined))
                       (not (nil? (ui/limit-ref limits axis))))))
            [:width :height])
  (put! modes (ui/limit-ref limits :width-mode) #t)
  (let ((width (ui/limit-ref limits :width 200)))
    (ui/size (min width 200)
             (if (< width 150)
                 60
                 20))))

(def tree (ui/root))

(def (view)
  (ui/column {:key :outer :grow 1 :padding 10 :gap 5}
             (ui/row {:height 60 :gap 10} (ui/new Box {:key :a}) (ui/new Box {:key :b :grow 1}))
             (ui/new Box {:key :c})))

(def outer nil)

(def row nil)

(def a nil)

(def b nil)

(def c nil)

(def saved nil)

(def (sized-strip width)
  (ui/scroll {:axis :x :width 200 :height 50 :reveal 1}
             (ui/column {:key 0 :width 100})
             (ui/column {:key 1 :width width :animate-size #t})))

(def (strip reveal)
  (ui/scroll {:axis :x :width 200 :height 50 :gap 10 :reveal reveal}
             (map (fn (i) (ui/column {:key i :width 120})) (range 0 4))))

(unwind-protect
  (begin
    (let ((empty (native/text-get "" 1 18 -1 1)))
      (check "empty text cache hit" #t (ffi/pointer=? empty (native/text-get "" 1 18 -1 1))))
    (ui/reconcile! tree (view))
    (gpu/layout! tree 300 200)
    (set! outer (child tree 0))
    (set! row (child outer 0))
    (set! a (child row 0))
    (set! b (child row 1))
    (set! c (child outer 1))
    (set! saved (b :layout))
    (near "root fills height" 200 ((outer :bounds) :height))
    (near "padding x" 10 ((a :bounds) :x))
    (near "padding y" 10 ((a :bounds) :y))
    (near "intrinsic width" 40 ((a :bounds) :width))
    (near "stretch height" 60 ((a :bounds) :height))
    (near "gap" 60 ((b :bounds) :x))
    (near "flex grow" 230 ((b :bounds) :width))
    (near "column gap" 75 ((c :bounds) :y))
    (check "persistent node count" 5 (native/live-nodes))
    (eval '(require otium.ui.native :reload))
    (gpu/layout! tree 400 240)
    (near "resize" 330 ((b :bounds) :width))
    (check "native node reused" #t (ffi/pointer=? saved (b :layout)))
    (check "repeated layout does not leak" 5 (native/live-nodes))
    (ui/reconcile! tree (ui/column {:key :outer :grow 1} (ui/new Box {:key :c})))
    (check "removed descendants released" 2 (native/live-nodes))
    (check "removed node handle cleared" nil (b :layout))
    (gpu/layout! tree 300 200)
    (check "remaining child identity" #t (eq? c (child outer 0)))
    (eval '(defmethod (ui/measure (w Box) limits)
             (ui/size 60 30)))
    (gpu/layout! tree 300 200)
    (near "redefined measure used" 30 ((c :bounds) :height))
    (remove-method! ui/measure (list Box Object))
    (gpu/layout! tree 300 200)
    (near "removed measure no longer supplies intrinsic height" 0 ((c :bounds) :height))
    (eval '(defmethod (ui/measure (w Box) limits)
             (ui/size 60 30)))
    (gpu/layout! tree 300 200)
    (near "added measure is detected on an existing node" 30 ((c :bounds) :height))
    (check "negative root rejected" #t (fails? (fn () (gpu/layout! tree -1 200))))
    (ui/reconcile! tree (ui/column {:padding -1}))
    (check "invalid style rejected" #t (fails? (fn () (gpu/layout! tree 300 200))))
    (ui/reconcile! tree (ui/column {:width 100} (ui/new Wrapping {})))
    (gpu/layout! tree 300 200)
    (near "exact width changes custom height" 60 (((child (child tree 0) 0) :bounds) :height))
    (check "custom measure sees exact width" #t (get modes :exactly))
    (ui/reconcile! tree (ui/row {} (ui/new Wrapping {})))
    (gpu/layout! tree 300 200)
    (check "custom measure sees at-most width" #t (get modes :at-most))
    (near "wide custom height" 20 (((child (child tree 0) 0) :bounds) :height))
    (ui/reconcile! tree (ui/label {:key :text} "office café naïve λ -- words wrap into lines"))
    (gpu/layout! tree 120 500)
    (let ((label (child tree 0)))
      (let ((narrow ((label :bounds) :height)))
        (gpu/layout! tree 400 500)
        (check "wide text needs fewer lines" #t (< ((label :bounds) :height) narrow))
        (ui/reconcile! tree (ui/label {:key :text :size 28} "New"))
        (gpu/layout! tree 120 500)
        (check "text updates reuse mounted node" #t (eq? label (child tree 0)))
        (check "text and size invalidate measurement" #t (< ((label :bounds) :height) narrow))))
    (ui/reconcile! tree (ui/label {:width 100 :height 10} "clipped text"))
    (gpu/layout! tree 300 200)
    (near "explicit text height" 10 (((child tree 0) :bounds) :height))
    (let ((one (ui/measure (make ui/Label :text "hello") {}))
          (two (ui/measure (make ui/Label :text "hello\nhello") {})))
      (check "explicit newline height" #t (> (two :height) (one :height)))
      (check "empty text width" 0.0 ((ui/measure (make ui/Label :text "") {}) :width))
      (check "zero width text measurement terminates"
             #t
             (> ((ui/measure (make ui/Label :text "hello") {:width 0}) :height) 0)))
    (let ((wide (ui/measure (make ui/Label :text "WWW" :font :mono) {}))
          (thin (ui/measure (make ui/Label :text "iii" :font :mono) {})))
      (near "bundled mono has equal advances" (wide :width) (thin :width)))
    (let ((wide (ui/measure (make ui/Label :text "WWW") {}))
          (thin (ui/measure (make ui/Label :text "iii") {})))
      (check "proportional font uses real glyph advances" #t (> (wide :width) (thin :width))))
    (let ((precomposed (ui/measure (make ui/Label :text "café") {}))
          (combining (ui/measure (make ui/Label :text "café") {})))
      (near "combining marks are shaped" (precomposed :width) (combining :width)))
    (check "unknown font rejected" #t (fails? (fn () (ui/measure (make ui/Label :text "bad" :font :missing) {}))))
    (check "invalid font size rejected" #t (fails? (fn () (ui/measure (make ui/Label :text "bad" :size -1) {}))))
    (let ((mono "native/ui/fonts/JetBrainsMono.ttf")
          (sans "native/ui/fonts/NotoSans.ttf")
          (face (gfx/font-index mono)))
      (check "custom font gets a separate ID" #t (>= face 2))
      (check "font registration is deduplicated" face (gfx/font-index mono))
      (check "custom font metrics match bundled font"
             (array-to-list (gpu/caret-positions "MMMM" :mono 20 1))
             (array-to-list (gpu/caret-positions "MMMM" mono 20 1)))
      (check "switching font changes metrics"
             #f
             (equal? (array-to-list (gpu/caret-positions "MMMM" mono 20 1))
                     (array-to-list (gpu/caret-positions "MMMM" sans 20 1))))
      (let ((before (native/text-resources)))
        (check "missing font rejected" -1 (native/font-register "missing-font.ttf"))
        (check "non-font rejected" -1 (native/font-register "project.ot"))
        (check "failed font loads retain no resources" before (native/text-resources)))
      (ui/reconcile! tree (ui/label {:font mono :size 20} "Custom font"))
      (gpu/layout! tree 300 200)
      (check "custom font participates in layout" #t (> (((child tree 0) :bounds) :width) 0)))
    (let ((path "native/ui/fonts/JetBrainsMono.ttf"))
      (dotimes (i 30)
        (set! path (str "./" path))
        (check "font registry accepts entries up to its bound" #t (>= (native/font-register path) 2)))
      (let ((before (native/text-resources)))
        (check "font registry rejects overflow" -1 (native/font-register (str "./" path)))
        (check "registry overflow retains no resources" before (native/text-resources))))
    (dotimes (i 4096)
      (native/text-get (str "tree entry " i " / src / module.ot") 1 14 -1 1))
    (check "text cache stays bounded under distinct output" #t (<= (native/text-resources) 224))
    (for-each (fn (density)
                (ui/reconcile! tree (demo/view))
                (gpu/layout! tree 640 480 density)
                (let ((header (child (child tree 0) 0)))
                  (let ((text-column (child header 1)))
                    (for-each (fn (label)
                                (let ((bounds (label :bounds)))
                                  (let ((needed (ui/measure (ui/instance label)
                                                            {:width (bounds :width) :scale density})))
                                    (check "header preserves full text height"
                                           #t
                                           (>= (bounds :height) (needed :height))))))
                              (ui/children text-column)))))
              [1 2])
    (ui/reconcile! tree
                   (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 200} (ui/label {} "Scrollable"))))
    (gpu/layout! tree 300 200)
    (let ((scroll (ui/instance (child tree 0))))
      (near "scroll content does not shrink" 200 (((child (child tree 0) 0) :bounds) :height))
      (near "scroll overflow" 120 (scroll :limit))
      (near "stick to bottom" 120 (scroll :offset))
      (near "scroll translates content" -120 (((child (child tree 0) 0) :bounds) :y))
      (ui/send! (child tree 0) {:kind :wheel :dy 1})
      (gpu/layout! tree 300 200)
      (near "wheel moves offset" 84 (scroll :offset))
      (ui/reconcile! tree (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 240})))
      (gpu/layout! tree 300 200)
      (near "new content preserves scrolled position" 84 (scroll :offset))
      (ui/scroll-to! scroll 10000)
      (gpu/layout! tree 300 200)
      (near "scroll clamps at bottom" 160 (scroll :offset))
      (ui/reconcile! tree (ui/scroll {:height 80 :stick-to-bottom #t} (ui/column {:height 20})))
      (gpu/layout! tree 300 200)
      (near "content shrink clamps offset" 0 (scroll :offset)))
    (ui/reconcile! tree
                   (ui/row {:padding-x 12 :padding-y 4 :height 40 :align-items :center}
                           (ui/column {:key :a :width 40 :height 20})
                           (ui/column {:key :b :width 40 :height 10})))
    (gpu/layout! tree 300 200)
    (let ((box (child (child tree 0) 0))
          (small (child (child tree 0) 1)))
      (near "horizontal padding" 12 ((box :bounds) :x))
      (near "centered cross axis" 10 ((box :bounds) :y))
      (near "centered smaller child" 15 ((small :bounds) :y))
      (near "aligned child keeps its height" 20 ((box :bounds) :height)))
    (ui/reconcile! tree (ui/row {:align-items :middle}))
    (check "unknown alignment rejected" #t (fails? (fn () (gpu/layout! tree 300 200))))
    (ui/reconcile! tree (strip nil))
    (gpu/layout! tree 300 200)
    (let ((node (child tree 0))
          (scroll (ui/instance (child tree 0))))
      (near "horizontal content does not shrink" 120 (((child node 1) :bounds) :width))
      (near "horizontal children fill height" 50 (((child node 1) :bounds) :height))
      (near "horizontal overflow" 310 (scroll :limit))
      (ui/send! node {:kind :wheel :dx 1 :dy 0})
      (gpu/layout! tree 300 200)
      (near "horizontal wheel moves offset" 36 (scroll :offset))
      (near "horizontal offset translates x" 94 (((child node 1) :bounds) :x))
      (ui/send! node {:kind :wheel :dy -1})
      (near "vertical wheel scrolls a horizontal view" 72 (scroll :offset))
      (ui/reconcile! tree (strip 3))
      (gpu/layout! tree 300 200)
      (near "reveal scrolls right edge into view" 310 (scroll :offset))
      (ui/scroll-to! scroll 0)
      (gpu/layout! tree 300 200)
      (near "unchanged reveal leaves manual scrolling" 0 (scroll :offset))
      (ui/reconcile! tree (strip 1))
      (ui/scroll-to! scroll 300)
      (gpu/layout! tree 300 200)
      (near "changed reveal targets left edge" 130 (scroll :target))
      (near "changed reveal animates from current offset" 300 (scroll :offset))
      (check "animation registered on the tree" #t (gpu/animating? tree))
      (check "first animation step continues" #t (gpu/animate! tree 0.0 1))
      (check "first step moves part way" #t (< 130 (scroll :offset) 300))
      (let ((moved (((child node 1) :bounds) :x)))
        (gpu/layout! tree 300 200)
        (near "shifted bounds match a relayout" moved (((child node 1) :bounds) :x)))
      (let loop ((step 1))
        (when (and (< step 120) (gpu/animate! tree (/ step 60.0) 1)) (loop (+ step 1)))
        (check "animation settles within half a second" #t (< step 30)))
      (near "animation ends on the target" 130 (scroll :offset))
      (check "settled animation unregistered" #f (gpu/animating? tree))
      (ui/reconcile! tree (strip 3))
      (gpu/layout! tree 300 200)
      (check "another reveal animates" #t (gpu/animating? tree))
      (ui/send! node {:kind :wheel :dx 1 :dy 0})
      (check "wheel ends the animation" #f (ui/scroll-animating? scroll))
      (ui/reconcile! tree
                     (ui/scroll {:axis :x :width 200 :height 50 :gap 10 :reveal 0 :smoothing 0}
                                (map (fn (i) (ui/column {:key i :width 120})) (range 0 4))))
      (gpu/layout! tree 300 200)
      (near "zero smoothing jumps" 0 (scroll :offset)))
    (ui/reconcile! tree (ui/row {:key :sized :width 100 :height 40 :animate-size #t}))
    (gpu/layout! tree 300 200)
    (let ((node (child tree 0)))
      (near "first size applies at once" 100 ((node :bounds) :width))
      (check "settled size is not resizing" #f (gpu/resizing? tree))
      (ui/reconcile! tree (ui/row {:key :sized :width 200 :height 40 :animate-size #t}))
      (gpu/layout! tree 300 200)
      (near "changed size starts from the old one" 100 ((node :bounds) :width))
      (check "changed size registers a resize" #t (gpu/resizing? tree))
      (gpu/step-sizes! tree 0.0)
      (gpu/layout! tree 300 200)
      (check "size eases part way" #t (< 100 ((node :bounds) :width) 200))
      (let loop ((step 1))
        (when (and (< step 120) (gpu/resizing? tree))
          (gpu/step-sizes! tree (/ step 60.0))
          (gpu/layout! tree 300 200)
          (loop (+ step 1))))
      (near "size settles on the target" 200 ((node :bounds) :width))
      (check "settled resize unregistered" #f (gpu/resizing? tree))
      (ui/reconcile! tree (ui/row {:key :sized :width 120 :height 40 :animate-size #t}))
      (gpu/layout! tree 320 200)
      (near "window resize applies sizes at once" 120 ((node :bounds) :width))
      (ui/reconcile! tree (ui/row {:key :sized :width 60 :height 40}))
      (gpu/layout! tree 320 200)
      (near "sizes without the option apply at once" 60 ((node :bounds) :width)))
    (ui/reconcile! tree (sized-strip 80))
    (gpu/layout! tree 320 200)
    (ui/reconcile! tree (sized-strip 180))
    (gpu/layout! tree 320 200)
    (let ((column (child (child tree 0) 1))
          (worst 0))
      (let loop ((step 0))
        (when (and (< step 120) (gpu/resizing? tree))
          (gpu/step-sizes! tree (/ step 60.0))
          (gpu/layout! tree 320 200)
          (set! worst (max worst (- (+ ((column :bounds) :x) ((column :bounds) :width)) 200)))
          (loop (+ step 1))))
      (check "scroll follows a resizing child's edge to the pixel" #t (<= worst 0.5)))
    (ui/reconcile! tree (ui/scroll {:axis :x :width 200 :height 50 :reveal 0} (ui/column {:key 0 :width 280})))
    (gpu/layout! tree 320 200)
    (gpu/layout! tree 320 200)
    (near "a child wider than the viewport shows its start" 0 ((ui/instance (child tree 0)) :target))
    (ui/reconcile! tree (ui/row {:key :outer :width 100 :height 100} (ui/column {:key :inner :width 50})))
    (gpu/layout! tree 300 200)
    (let ((pointer (input/pointer))
          (outer (child tree 0)))
      (input/dispatch! pointer tree {:kind :pointer-move :x 10 :y 10})
      (check "hover marks ancestors" (list #t #t) (list ((child outer 0) :hovered?) (outer :hovered?)))
      (input/dispatch! pointer tree {:kind :pointer-move :x 80 :y 10})
      (check "hover leaves a child" (list #f #t) (list ((child outer 0) :hovered?) (outer :hovered?)))
      (input/dispatch! pointer tree {:kind :pointer-leave})
      (check "pointer leave clears hover" #f (outer :hovered?)))
    (dotimes (i 40)
      (terminal/emit! (str "scroll line " i)))
    (ui/reconcile! tree (terminal/view))
    (gpu/layout! tree 640 480)
    (near "scrollback leaves input at full height" 44 (((ui/focused tree) :bounds) :height))
    (check "scrollback leaves heading visible" #t (> (((child (child tree 0) 0) :bounds) :height) 30))
    (ui/reconcile! tree (ui/text-field {:height -1}))
    (gpu/layout! tree 300 200)
    (near "automatic text field height" 44 (((child tree 0) :bounds) :height))
    (ui/reconcile! tree (ui/new Box {}))
    (eval '(defmethod (ui/measure (w Box) limits)
             (error "injected measure failure")))
    (check "measure failure escapes" #t (fails? (fn () (gpu/layout! tree 300 200))))
    (check "temporary root freed on failure" 1 (native/live-nodes))
    (eval '(defmethod (ui/measure (w Box) limits)
             (ui/size 60 30)))
    (gpu/layout! tree 300 200)
    (near "layout retries after measure failure" 30 (((child tree 0) :bounds) :height))
    (dotimes (i 4096)
      (native/text-get (str "tree entry " i " / src / module.ot") 1 14 -1 1))
    (check "text cache stays bounded under distinct output" #t (<= (native/text-resources) 224))
    (for-each (fn (density)
                (let ((positions (gpu/caret-positions "office éλ" :ui 24 density)))
                  (check "caret array uses codepoints" 10 (length positions))
                  (check "first caret retains shaped bearing" #t (>= (get positions 0) 0))
                  (check "ligature interior remains editable"
                         #t
                         (< (get positions 1) (get positions 2) (get positions 3) (get positions 4))))
                (near "empty field caret at origin" 0 (get (gpu/caret-positions "" :ui 24 density) 0)))
              [1 2]))
  (ui/dispose! tree))
(check "all fonts and shaped runs released" 0 (native/text-resources))
(check "all nodes released" 0 (native/live-nodes))
(check "no renderers needed" 0 (native/live-renderers))
(check "foreign memory released" 0 (ffi/allocation-count))
(let ((saved gfx/rect)
      (fills [])
      (box (make ui/Box :background 10 :hover 20)))
  (defer
    (begin
      (set! gfx/rect (fn (_g _bounds color . _radius) (push! fills color)))
      (ui/paint box {:hovered? #f} (ui/bounds 0 0 10 10))
      (ui/paint box {:hovered? #t} (ui/bounds 0 0 10 10))
      (check "Box hover chooses its fill" '(10 20) (array-to-list fills)))
    (set! gfx/rect saved)))
(report "ui layout")
