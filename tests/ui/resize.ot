(ns ui.resize)
(require (otium.ui :as ui))
(require (otium.ui.native :as native))
(require (otium.sdl :as sdl))
(require (ui.events :as events))

(def presses 0)

(def retained nil)

(def (view)
  (ui/row {:grow 1}
          (ui/column {:grow 1})
          (ui/button {:key :button :width 100 :on-press (fn () (set! presses (+ presses 1)))} "Resize")))

(def (step! tree frame context)
  (let ((button (get (ui/children (get (ui/children tree) 0)) 1))
        (renderer (get context :renderer)))
    (when (= frame 0)
      (set! retained button)
      (when (native/gpu-resize renderer 0 100 1) (error "Invalid resize accepted"))
      (sdl/check (native/gpu-resize renderer 5000 32 (if (native/gpu-offscreen? renderer) 1 0)))
      (events/resize! context 800 360)
      (events/pointer! context 750.0 30.0 #t)
      (events/pointer! context 750.0 30.0 #f))
    (when (= frame 1)
      (unless (and (= presses 1) (eq? retained button) (eq? (ui/focused tree) button))
        (error "Resize lost identity, focus, or used stale hit bounds" presses))
      (events/resize! context 320 240))
    (when (= frame 2)
      (unless (= ((button :bounds) :x) 220) (error "Shrink did not relayout"))
      (events/resize! context 480 300))
    (when (= frame 3)
      (unless (and (= ((button :bounds) :x) 380) (eq? retained button)) (error "Repeated resize did not retain widget"))
      (println "UI-RESIZE layout, input and identity passed")
      (events/quit!))))
