;; Export the namespace reference to docs/reference.json for the otium.sh site.
;; Run from the repository root: ./otium tools/export-reference.ot
;;
;; Public bindings come from the modules below; core also includes the
;; runtime builtins in lib/catalog/runtime.json. Module docs are a leading
;; string after the ns form (or the first form for the core prelude).
;; A binding docstring whose first line starts with ( gives the signatures,
;; with alternatives separated by " / ";
;; otherwise the signature comes from the definition's parameter list.

(ns tools.export-reference)
(require otium.dev :as dev)
(require otium.json :as json)
(require otium.syntax :as syntax)

;; Add a module here with its source path.
(def- modules [{:name 'otium.core :file "lib/otium/core.ot"} {:name 'otium.ui :file "lib/otium/ui.ot"}])

(def- catalog-file "lib/catalog/runtime.json")

(def- expander-file "lib/otium/expander.ot")

(def- output-file "docs/reference.json")

;; --- signatures --------------------------------------------------------------

;; A signature argument is a table with "name" or "group" (an array of
;; arguments, for patterns such as dotimes's (index count)), plus "optional"
;; and "repeat" when they apply.
(def- (signature-arg datum)
  (cond
    ((symbol? datum) {"name" (symbol->string datum)})
    ((string? datum) {"name" datum})
    ((keyword? datum) {"name" (str datum)})
    ((array? datum) (optional-group datum))
    ((and (pair? datum) (eq? (car datum) 'array)) (optional-group (cdr datum)))
    ((pair? datum) (let ((args (signature-args datum))) (and args {"group" args})))
    (else nil)))

;; [x] is the optional argument x; [x y] is an optional group.
(def- (optional-group items)
  (let ((args (signature-args items)))
    (and args
         (put (if (= (length args) 1)
                  (args 0)
                  {"group" args})
              "optional"
              #t))))

;; Returns an array of arguments, or nil when an element can't be shown as one.
(def- (signature-args items)
  (let ((out [])
        (ok #t))
    (for-each (fn (item)
                (if (eq? item '%repeat)
                    (if (> (length out) 0)
                        (put! out (- (length out) 1) (put (out (- (length out) 1)) "repeat" #t))
                        (set! ok #f))
                    (let ((arg (signature-arg item)))
                      (if arg
                          (push! out arg)
                          (set! ok #f)))))
              (if (array? items)
                  (array-to-list items)
                  items))
    (and ok out)))

;; Parse one signature such as "(get collection key [default])". The reader
;; doesn't accept ... as a symbol, so it's read as %repeat. Forms that aren't
;; written as a call, like "`template", keep only their text.
(def- (parse-signature text)
  (let ((datum (and (string-starts-with? text "(")
                    (try
                      (read-string (string-replace text "..." " %repeat "))
                      (catch (error? _) nil)))))
    (if (and (pair? datum) (symbol? (car datum)) (list? datum))
        (let ((args (signature-args (cdr datum))))
          (if args
              {"text" text "args" args}
              {"text" text}))
        {"text" text})))

;; Build a signature from a definition's parameters: (a b &optional (c 1) & rest).
(def- (params-signature name params)
  (let ((args [])
        (optional? #f))
    (let loop ((ps params))
      (cond
        ((null? ps) nil)
        ((symbol? ps) (push! args {"name" (symbol->string ps) "repeat" #t}))
        ((eq? (car ps) '&optional) (set! optional? #t) (loop (cdr ps)))
        ((eq? (car ps) '&) (push! args {"name" (symbol->string (cadr ps)) "repeat" #t}))
        ((pair? (car ps))
         (let ((default (cadr (car ps)))
               (arg {"name" (symbol->string (car (car ps))) "optional" #t}))
           (unless (equal? default "%missing-argument") (put! arg "default" default))
           (push! args arg)
           (loop (cdr ps))))
        (else (push! args
                     (if optional?
                         {"name" (symbol->string (car ps)) "optional" #t}
                         {"name" (symbol->string (car ps))}))
              (loop (cdr ps)))))
    {"text" (signature-text name args) "args" args}))

(def- (arg-text arg)
  (let ((base (if (get arg "group")
                  (str "(" (string-join " " (map arg-text (arg "group"))) ")")
                  (arg "name")))
        (shown (if (get arg "repeat")
                   (str base " ...")
                   base)))
    (if (get arg "optional")
        (str "[" shown "]")
        shown)))

(def- (signature-text name args)
  (if (empty? args)
      (str "(" name ")")
      (str "(" name " " (string-join " " (map arg-text args)) ")")))

;; Split a docstring into signatures and prose.
(def- (split-doc doc)
  (let ((newline (string-index doc "\n"))
        (head (if newline
                  (substring doc 0 newline)
                  doc)))
    (if (string-starts-with? head "(")
        {:signatures (map parse-signature (string-split head " / "))
         :doc (if newline
                  (string-trim (substring doc (+ newline 1) (string-length doc)))
                  "")}
        {:signatures nil :doc doc})))

;; --- source ------------------------------------------------------------------

;; A parameter node as data: a symbol, or (name default-text) for an
;; &optional pair. The dot in (a . rest) reads as &.
(def- (param-datum node)
  (cond
    ((and (eq? (node :kind) :atom) (equal? (node :text) ".")) '&)
    ((eq? (node :kind) :atom) (string->symbol (node :text)))
    ((eq? (node :kind) :list)
     (let ((parts (syntax/forms node))) (list (string->symbol ((car parts) :text)) ((cadr parts) :text))))
    (else (string->symbol (node :text)))))

(def- (module-doc path)
  (let ((forms (filter (fn (node) (not (eq? (node :kind) :comment))) (syntax/parse (read-file path))))
        (first (get forms 0))
        (doc (if (and first (equal? (syntax/head-name first) "ns"))
                 (get forms 1)
                 first)))
    (if (and doc (eq? (doc :kind) :string))
        (read-string (doc :text))
        "")))

;; Keep initializer expressions as source text; exporting must not evaluate them.
(def- (node-source node lines)
  (let ((end (syntax/end node))
        (start-line (node :line))
        (end-line (car end)))
    (if (= start-line end-line)
        (substring (get lines start-line) (node :column) (cadr end))
        (string-join "\n"
                     (concat [(substring (get lines start-line) (node :column) (string-length (get lines start-line)))]
                             (take (- end-line start-line 1) (drop (+ start-line 1) lines))
                             [(substring (get lines end-line) 0 (cadr end))])))))

(def- (option-node options key)
  (let loop ((rest options))
    (cond
      ((null? rest) nil)
      ((equal? ((car rest) :text) key) (cadr rest))
      (else (loop (cddr rest))))))

(def- (type-details head parts lines prose)
  (let ((record? (equal? head "defrecord"))
        (abstract? (equal? head "defabstract"))
        (rest (cddr parts))
        (parent? (and (pair? rest) (equal? ((car rest) :text) ":is")))
        (parent (if parent?
                    ((cadr rest) :text)
                    "Object"))
        (slots (cond
                 (record? (syntax/forms (car rest)))
                 (parent? (cddr rest))
                 (else rest)))
        (fields (map (fn (slot)
                       (let ((simple? (eq? (slot :kind) :atom))
                             (items (if simple?
                                        (list slot)
                                        (syntax/forms slot)))
                             (options (cdr items))
                             (init (option-node options ":init"))
                             (state (option-node options ":state"))
                             (accessor (option-node options ":accessor"))
                             (field {"name" ((car items) :text) "required" (not init)}))
                         (when init (put! field "default" (node-source init lines)))
                         (when state (put! field "state" (equal? (state :text) "#t")))
                         (when accessor (put! field "accessor" (accessor :text)))
                         field))
                     slots))
        (out {"kind" (cond
                       (record? "record")
                       (abstract? "abstract")
                       (else "class"))
              "doc" prose
              "fields" fields}))
    (if record?
        (let ((immutable (option-node (cdr rest) ":immutable")))
          (put! out "immutable" (and immutable (equal? (immutable :text) "#t"))))
        (put! out "parent" parent))
    out))

;; Source locations and signatures, plus type declarations. Comments directly
;; above a type declaration supply its prose documentation.
(def- (definition node lines comments)
  (let ((head (syntax/head-name node))
        (parts (and head (syntax/forms node))))
    (when (and head
               (member head
                       '("def"
                         "def-"
                         "defonce"
                         "defmacro"
                         "defparam"
                         "defgeneric"
                         "defclass"
                         "defabstract"
                         "defrecord"))
               (pair? (cdr parts)))
      (let ((target (cadr parts))
            (name ((if (eq? (target :kind) :list)
                       (car (syntax/forms target))
                       target)
                   :text))
            (params (cond
                      ((eq? (target :kind) :list) (cdr (syntax/forms target)))
                      ((and (equal? head "defmacro") (pair? (cddr parts))) (syntax/forms (caddr parts)))
                      (else nil))))
        {:name name
         :line (+ (node :line) 1)
         :params (and params (map param-datum params))
         :generic (equal? head "defgeneric")
         :type (and (member head '("defclass" "defabstract" "defrecord"))
                    (type-details head parts lines (string-join "\n" comments)))}))))

(def- (definitions path)
  (let ((found {})
        (lines (string-split (read-file path) "\n"))
        (comments []))
    (for-each (fn (node)
                (when (> (node :newlines) 1) (set! comments []))
                (if (eq? (node :kind) :comment)
                    (let ((text (node :text)))
                      (let loop ((start 0))
                        (if (and (< start (string-length text)) (equal? (substring text start (+ start 1)) ";"))
                            (loop (+ start 1))
                            (push! comments (string-trim (substring text start (string-length text)))))))
                    (let ((item (definition node lines comments)))
                      (when (and item (not (get found (item :name)))) (put! found (item :name) item))
                      (set! comments []))))
              (syntax/parse (read-file path)))
    found))

;; --- entries -----------------------------------------------------------------

;; The expander's core forms, read from its source since the list is private.
(def- (core-forms)
  (let ((found {}))
    (for-each (fn (node)
                (let ((parts (and (syntax/head-name node) (syntax/forms node))))
                  (when (and parts (pair? (cdr parts)) (equal? ((cadr parts) :text) "expander-core-forms"))
                    (syntax/walk (caddr parts)
                                 (fn (child) (when (eq? (child :kind) :atom) (put! found (child :text) #t)))))))
              (syntax/parse (read-file expander-file)))
    found))

;; What a builtin is: "special" for the expander's core forms, otherwise
;; "function", "macro" or "value". A name the runtime doesn't bind counts as a
;; function.
(def- (builtin-kind name special)
  (let ((value (try
                 (eval (string->symbol name))
                 (catch (error? _) :unbound))))
    (cond
      ((get special name) "special")
      ((macro? value) "macro")
      ((or (eq? value :unbound) (procedure? value)) "function")
      (else "value"))))

(def- (entry name kind doc params source)
  (let ((parts (split-doc doc))
        (signatures (or (parts :signatures)
                        (and params [(params-signature name params)])
                        (and (member kind '("function" "macro")) [{"text" (str "(" name " ...)")}])))
        (out {"name" name "kind" kind "doc" (parts :doc)}))
    (when signatures
      (put! out
            "signatures"
            (if (array? signatures)
                signatures
                (list-to-array signatures))))
    (when source (put! out "source" source))
    out))

(def- (module-entries module)
  (let ((path (module :file))
        (defs (definitions path)))
    (map (fn (b)
           (let ((name (symbol->string (b :name)))
                 (found (get defs name))
                 (doc (or (b :doc) "")))
             (let ((out (entry name
                               (keyword->string (b :kind))
                               (if (and (equal? doc "") found (found :generic))
                                   "Generic procedure."
                                   doc)
                               (and found (found :params))
                               (and found {"file" path "line" (found :line)})))
                   (details (and found (found :type))))
               (when details (for-each (fn (key) (put! out key (details key))) (keys details)))
               out)))
         ;; Core bindings not defined in core.ot are the runtime's builtins and
         ;; the expander's entry points; builtin-entries covers the builtins.
         (filter (fn (b)
                   (let ((name (symbol->string (b :name))))
                     (and (b :public)
                          (not (string-starts-with? name "%"))
                          (or (get defs name) (not (eq? (module :name) 'otium.core))))))
                 (dev/bindings (module :name))))))

(def- (builtin-entries defined)
  (let ((catalog (json/parse (read-file catalog-file)))
        (special (core-forms))
        (out []))
    (for-each (fn (name)
                ;; expander-* are the runtime's hooks for the expander, and % names
                ;; are internal.
                (unless (or (get defined name) (string-starts-with? name "expander-") (string-starts-with? name "%"))
                  (push! out (entry name (builtin-kind name special) (catalog name) nil nil))))
              (keys catalog))
    out))

(def- (json-ready value)
  (cond
    ((or (pair? value) (null? value)) (list-to-array (map json-ready value)))
    ((array? value) (map json-ready value))
    ((table? value)
     (let ((out {}))
       (for-each (fn (key) (put! out key (json-ready (value key)))) (keys value))
       out))
    (else value)))

(def- (export-module module)
  (unless (eq? (module :name) 'otium.core) (eval (list 'require (module :name))))
  (let ((entries (module-entries module)))
    (when (eq? (module :name) 'otium.core)
      (let ((defined {}))
        (for-each (fn (e) (put! defined (e "name") #t)) entries)
        (set! entries (concat entries (builtin-entries defined)))))
    {"name" (symbol->string (module :name))
     "doc" (module-doc (module :file))
     "entries" (sort-by (fn (e) (e "name")) entries)}))

(def- (export)
  (let ((namespaces (map export-module modules)))
    (write-file output-file (str (json/encode (json-ready {"namespaces" namespaces})) "\n"))
    (println (str "wrote " (length namespaces) " namespaces to " output-file))))

(export)
