#!/usr/bin/env python3
"""Regenerate docs from their .md.spec files with Pi.

docs/foo.md.spec holds YAML front matter (title, prompt) and an optional body
with more detail. The generated doc is written beside it as docs/foo.md. Docs
without a .spec are hand written and never touched. README.md and AGENTS.md
are always excluded.

A doc is only regenerated when its spec has changed since the doc was last
written. The last line of a generated doc records a hash of the spec it came
from; --force regenerates regardless.

Requires Pi (`pi`) with a provider login. In Pi, use /login and select OpenAI
Codex for the default provider. Defaults: openai-codex/gpt-6-astra, medium
reasoning, normal service tier. Override --provider/--model/--thinking to use
another model; DOCS_PROVIDER and DOCS_MODEL also set the defaults.
"""
import argparse
import hashlib
import json
import os
import re
import shlex
import tempfile
import urllib.parse
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DOCS = ROOT / 'docs'
MODEL = 'gpt-6-astra'
PROVIDER = 'openai-codex'
MARK = '✨'

RULES = f"""\
You write one Markdown documentation file for the Otium repository. Your final
reply is written verbatim to {{target}}, so reply with the document and nothing
else: no preamble, no code fence around the whole thing.

Rules:
- The first line is `# {MARK} {{title}}`. The {MARK} marks the doc as LLM generated;
  hand-written docs have no {MARK}. Use plain headings below it.
- Write for the reader the prompt describes and include only what they need
  for the doc's purpose. Before keeping a sentence, ask whether the reader
  would be worse off without it. Most of what you learn from the source fails
  that test.
- Read the source to get the facts right, not to report on it. Leave out how
  things are implemented, behaviour that is accidental or "in the current
  implementation", edge cases the reader is unlikely to hit, and which files
  hold the tests, catalogs or fixtures. Describe what the code does today, not
  what specs or tickets propose. Do not invent APIs, flags or files.
- The brief says what the reader should come away understanding. Write that
  in your own words for the reader; don't restate the brief's sentences.
- Ground the reader before giving recipes. Open with the problem the subject
  solves and why the reader would use it, then what it is and how it fits
  together: the values and terms the reader will meet and how they relate. For I/O, say what a port is and what kinds there are before showing
  how to read a file. When a section introduces a new idea, say what it is
  before showing how to use it. Explain what the reader needs to understand,
  not how the runtime implements it. Introduce an idea before the first
  section that depends on it.
- Write a guide, not a reference. The generated API reference already lists
  every function and its details, so cover the common path and leave out
  completeness details such as rarely used arguments, behaviour at odd edges
  and exhaustive tables of operations. Where it helps, build examples on each
  other so the page reads as one piece of work.
- Read AGENT-LANG.md before writing any Otium code examples. Keep examples short
  and check them against the source. Run each example with run_otium in the
  order a reader would type them, and make every result comment match what
  it prints. Don't tell the reader to do something that fails. Prefer examples that return a value over
  ones that print. Mark code blocks as ```otium.
- Leave out options and alternatives that don't help the reader understand the
  subject or use it.
- Write plainly. Prefer short sentences and ordinary words over jargon.
- Name a repository file only when the reader would open it. Use backticks
  and a path from the repository root, and only name files that exist.
- Link to a function or other binding in the API reference with
  `/reference/<namespace>/#<name>`, for example
  ``[`read-line`](/reference/otium.core/#read-line)``. The reference covers only
  these namespaces: {{reference}}. Only link names that exist there.
  When the page introduces one of these namespaces, link its reference page
  once, as `[otium.json](/reference/otium.json/)`.
- Link an error or lint code to its entry on the error code page, as
  ``[`E0001`](/reference/diagnostics/#E0001)``. The codes are in
  `lib/catalog/diagnostics.json`.
- Link to other docs with relative links from {{target}}. The docs that exist:
{{index}}
- Do not edit any files. Your only output is the reply.
"""


def parse_spec(path):
    """Return (front matter dict, body) for a spec file.

    Handles the small YAML subset specs use: `key: value` scalars, quoted
    strings and `|` or `>` block scalars."""
    lines = path.read_text().splitlines()
    if not lines or lines[0].strip() != '---':
        sys.exit(f'{path}: missing front matter')
    try:
        end = lines.index('---', 1)
    except ValueError:
        sys.exit(f'{path}: unterminated front matter')
    meta, i, head = {}, 0, lines[1:end]
    while i < len(head):
        line = head[i]
        i += 1
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        key, sep, value = line.partition(':')
        if not sep:
            sys.exit(f'{path}: bad front matter line: {line}')
        key, value = key.strip(), value.strip()
        if value in ('|', '>'):
            block = []
            while i < len(head) and (not head[i].strip() or head[i].startswith((' ', '\t'))):
                block.append(head[i].strip())
                i += 1
            value = ('\n' if value == '|' else ' ').join(block).strip()
        elif value.startswith('"'):
            value = json.loads(value)
        elif value.startswith("'"):
            value = value[1:-1].replace("''", "'")
        meta[key] = value
    for key in ('title', 'prompt'):
        if not meta.get(key):
            sys.exit(f'{path}: front matter needs {key}')
    return meta, '\n'.join(lines[end + 1:]).strip()


def target_of(spec):
    return spec.with_suffix('')


def spec_hash(spec):
    return hashlib.sha256(spec.read_bytes()).hexdigest()


def stamp(spec):
    return f'<!-- generated from {spec.name} sha256:{spec_hash(spec)} -->'


def up_to_date(spec):
    """True when the doc was generated from the spec as it is now."""
    target = target_of(spec)
    if not target.exists():
        return False
    lines = target.read_text().rstrip().splitlines()
    match = re.fullmatch(r'<!-- generated from \S+ sha256:([0-9a-f]{64}) -->', lines[-1] if lines else '')
    return bool(match) and match.group(1) == spec_hash(spec)


def doc_index():
    """List every doc, generated or hand written, with its title."""
    entries = []
    for doc in sorted(DOCS.rglob('*.md')):
        spec = doc.with_name(doc.name + '.spec')
        title = parse_spec(spec)[0]['title'] if spec.exists() else doc.stem
        entries.append((doc, title))
    for spec in sorted(DOCS.rglob('*.md.spec')):
        if not target_of(spec).exists():
            entries.append((target_of(spec), parse_spec(spec)[0]['title']))
    return '\n'.join(f'  - {d.relative_to(ROOT)}: {t}' for d, t in sorted(entries))


HUMANIZE = f"""\
You edit one generated Markdown document for the Otium repository. The user
message is the draft.

Otium is a small Lisp in the Scheme tradition, with namespaces from Clojure
and tables from Janet. The document was written from this brief, which says
who the reader is and what the page is for:

{{brief}}

Apply the humanizer skill below to the draft in file mode: change prose only,
and keep code blocks, inline code, paths, link targets and the first line
(`# {MARK} {{title}}`) unchanged. Keep every fact and add none. Otium terms
such as port, condition, restart, param and namespace have exact meanings;
keep them. Contrasts with Scheme, Clojure or other Lisps correct beliefs this
reader holds, so keep them. You may read the repository to check what a
sentence means before rewording it, but an edit must not change what it says.

Reply with the whole edited document and nothing else: no preamble, no list
of changes, no code fence around the whole thing.

<humanizer-skill>
{{skill}}
</humanizer-skill>
"""
SKILL = ROOT / '.agents/skills/humanizer/SKILL.md'
REFERENCE_DATA = json.loads((DOCS / 'reference.json').read_text())['namespaces']
REFERENCE = [ns['name'] for ns in REFERENCE_DATA]
REFERENCE_NAMES = {(ns['name'], e['name']) for ns in REFERENCE_DATA for e in ns['entries']}
REFERENCE_LINK = re.compile(r'\[([^\]]+)\]\(/reference/([^/)#\s]+)/(?:#([^)\s]+))?\)')


def check_reference_links(markdown):
    """Keep reference links that resolve; turn the rest back into their text."""
    def fix(m):
        ns, name = m.group(2), m.group(3) and urllib.parse.unquote(m.group(3))
        if ns == 'diagnostics' or (name and (ns, name) in REFERENCE_NAMES) or (not name and ns in REFERENCE):
            return m.group(0)
        return m.group(1)
    return REFERENCE_LINK.sub(fix, markdown)


def pi_command(system, args):
    return [
        'pi', '--print', '--mode', 'json', '--no-session',
        '--provider', args.provider, '--model', args.model,
        '--thinking', args.thinking,
        '--tools', 'read,grep,find,ls,run_otium',
        '--no-extensions', '--no-skills', '--no-prompt-templates',
        '--no-themes', '--no-approve',
        '--skill', str(ROOT / '.agents/skills/humanizer'),
        '--extension', str(ROOT / 'tools/docs-pi.mjs'),
        '--append-system-prompt', system,
    ]


def final_reply(output):
    """Use the last completed agent turn, never intermediate tool commentary."""
    final = None
    for line in output.splitlines():
        event = json.loads(line)
        if event.get('type') == 'agent_end':
            final = event
    if final is None:
        raise ValueError('Pi did not finish an agent turn')
    messages = [m for m in final.get('messages', []) if m.get('role') == 'assistant']
    if not messages:
        raise ValueError('Pi did not return an assistant reply')
    if messages[-1].get('stopReason') != 'stop':
        detail = messages[-1].get('errorMessage') or messages[-1].get('stopReason', 'unknown')
        raise ValueError(f'Pi did not finish a complete assistant reply: {detail}')
    return ''.join(block['text'] for block in messages[-1].get('content', [])
                   if block.get('type') == 'text').strip()


def examples_run(output):
    """How many times Pi called run_otium."""
    return sum(1 for line in output.splitlines()
               if (event := json.loads(line)).get('type') == 'tool_execution_start'
               and event.get('toolName') == 'run_otium')


def files_read(output):
    """Paths Pi opened with its read tool, in order, relative to the repo."""
    paths = []
    for line in output.splitlines():
        event = json.loads(line)
        if event.get('type') == 'tool_execution_start' and event.get('toolName') == 'read':
            path = Path(ROOT, event.get('args', {}).get('path', ''))
            name = str(path.resolve().relative_to(ROOT)) if path.resolve().is_relative_to(ROOT) else str(path)
            if name not in paths:
                paths.append(name)
    return paths


WIDTH = 80
# A line starting with one of these would turn into a heading, list or quote.
BLOCK_START = re.compile(r'(#+|>|[-*+]|\d+[.)]|\|)$')
LIST_ITEM = re.compile(r'(\s*(?:[-*+]|\d+[.)])\s+)(.*)')


def words(text):
    """Split on spaces, keeping each inline code span as one word."""
    out, i, word = [], 0, ''
    while i < len(text):
        if text[i] == '`':
            ticks = re.match(r'`+', text[i:]).group()
            end = text.find(ticks, i + len(ticks))
            end = len(text) if end < 0 else end + len(ticks)
            word += text[i:end]
            i = end
        elif text[i] == ' ':
            if word:
                out.append(word)
            word, i = '', i + 1
        else:
            word += text[i]
            i += 1
    return out + ([word] if word else [])


def wrap_line(first, rest, text):
    lines, line, empty = [], first, True
    for word in words(text):
        if not empty and len(line) + 1 + len(word) > WIDTH and not BLOCK_START.match(word):
            lines.append(line)
            line = rest + word
        else:
            line += ('' if empty else ' ') + word
        empty = False
    return lines + [line]


def straighten(line):
    """Replace curly quotes with straight ones outside inline code."""
    parts = re.split(r'(`+[^`]*`+)', line)
    table = str.maketrans({'\u2018': "'", '\u2019': "'", '\u201c': '"', '\u201d': '"'})
    return ''.join(p if p.startswith('`') else p.translate(table) for p in parts)


def wrap(markdown):
    """Wrap prose at WIDTH columns, leaving code, headings, tables and HTML alone."""
    out, fenced = [], False
    for line in markdown.split('\n'):
        if line.lstrip().startswith('```'):
            fenced = not fenced
        if not fenced:
            line = straighten(line)
        if fenced or line.lstrip().startswith('```') or len(line) <= WIDTH or \
                re.match(r'\s*(#|\||<|>)', line):
            out.append(line)
        elif item := LIST_ITEM.match(line):
            out += wrap_line(item.group(1), ' ' * len(item.group(1)), item.group(2))
        else:
            lead = re.match(r'\s*', line).group()
            out += wrap_line(lead, lead, line.strip())
    return '\n'.join(out)


def run_pi(command, prompt, args):
    result = subprocess.run(command, input=prompt, capture_output=True,
                            text=True, cwd=ROOT, timeout=args.timeout)
    if result.returncode != 0:
        raise ValueError(f'Pi exited {result.returncode}: {result.stderr.strip()}')
    return result.stdout


def generate(spec, index, args):
    meta, body = parse_spec(spec)
    target = target_of(spec)
    rel = target.relative_to(ROOT)
    if not args.force and up_to_date(spec):
        print(f'{rel}: unchanged spec, skipped', file=sys.stderr)
        return True
    system = RULES.format(target=rel, title=meta['title'], index=index,
                          reference=', '.join(REFERENCE))
    prompt = meta['prompt'] + ('\n\n' + body if body else '')
    command = pi_command(system, args)
    if args.dry_run:
        print(f'== {rel}\n-- command\n{shlex.join(command)}\n-- prompt\n{prompt}\n')
        return True
    title = f'# {MARK} {meta["title"]}'
    print(f'generating {rel}', file=sys.stderr)
    try:
        output = run_pi(command, prompt, args)
        draft = final_reply(output)
        print(f'{rel}: read {", ".join(files_read(output)) or "nothing"}', file=sys.stderr)
        print(f'{rel}: ran {examples_run(output)} examples', file=sys.stderr)
        if draft.splitlines()[:1] != [title]:
            raise ValueError('draft does not start with the expected document title')
        # The writer spends its attention on the facts, so a second pass with
        # only the draft and the humanizer skill does the editing.
        print(f'{rel}: humanizing', file=sys.stderr)
        editor = HUMANIZE.format(title=meta['title'], brief=meta['prompt'],
                                 skill=SKILL.read_text())
        text = final_reply(run_pi(pi_command(editor, args), draft, args))
        if text.splitlines()[:1] != [title]:
            raise ValueError('humanized reply does not start with the expected document title')
        target.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=target.parent,
                                         prefix=f'.{target.name}.', delete=False) as output:
            temporary = Path(output.name)
            output.write(f'{wrap(check_reference_links(text))}\n\n{stamp(spec)}\n')
        try:
            temporary.chmod(target.stat().st_mode & 0o777 if target.exists() else 0o644)
            temporary.replace(target)
        finally:
            temporary.unlink(missing_ok=True)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f'{rel}: not written: {error}', file=sys.stderr)
        return False
    print(f'wrote {rel}', file=sys.stderr)
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('docs', nargs='*',
                        help='docs or specs to regenerate (default: every spec)')
    parser.add_argument('-j', '--jobs', type=int, default=4)
    parser.add_argument('-f', '--force', action='store_true',
                        help='regenerate even when the spec is unchanged')
    parser.add_argument('-n', '--dry-run', action='store_true',
                        help='print the command and prompts instead of running Pi')
    parser.add_argument('--provider', default=os.environ.get('DOCS_PROVIDER', PROVIDER))
    parser.add_argument('--model', default=os.environ.get('DOCS_MODEL', MODEL))
    parser.add_argument('--thinking', default='medium',
                        choices=['off', 'minimal', 'low', 'medium', 'high', 'xhigh'])
    parser.add_argument('--timeout', type=float, default=900,
                        help='seconds allowed per document (default: 900)')
    args = parser.parse_args()
    if args.docs:
        specs = []
        for name in args.docs:
            path = Path(name).resolve()
            spec = path if path.name.endswith('.md.spec') else path.with_name(path.name + '.spec')
            if not spec.exists():
                sys.exit(f'{name}: no spec at {spec.relative_to(ROOT)}')
            specs.append(spec)
    else:
        specs = sorted(DOCS.rglob('*.md.spec'))
    protected = [s for s in specs if target_of(s).name in ('README.md', 'AGENTS.md')]
    if args.docs and protected:
        parser.error('README.md and AGENTS.md cannot be regenerated')
    specs = [s for s in specs if s not in protected]
    if args.timeout <= 0:
        parser.error('--timeout must be positive')
    index = doc_index()
    with ThreadPoolExecutor(max(1, args.jobs)) as pool:
        # Collect every result: all() would stop at the first failure and the
        # executor would cancel the docs still queued.
        ok = all(list(pool.map(lambda s: generate(s, index, args), specs)))
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
    main()
