#!/bin/sh
# meson-test SETUP [SUITE|TEST]...: suite names select a suite; anything else
# selects the tests whose names start with it.
set -eu
setup=$1
shift
count=$#
while [ "$count" -gt 0 ]; do
    case $1 in
        lang|c|native|gpu|bench) set -- "$@" --suite "$1" ;;
        *\**) set -- "$@" "$1" ;;
        *) set -- "$@" "$1*" ;;
    esac
    shift
    count=$((count - 1))
done
build=${OTIUM_BUILD:-$(dirname "$0")/../build/$(uname -m)-$(uname -s | tr A-Z a-z)/default}
exec meson test -C "$build" --setup "$setup" --print-errorlogs "$@"
