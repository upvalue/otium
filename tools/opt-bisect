#!/usr/bin/env python3
"""opt-bisect COMMAND...: find the optimizer rewrite that makes COMMAND fail.

Runs COMMAND with OTIUM_OPT_FUEL=n, which allows only the first n rewrites
in each process, and binary searches for the smallest n at which it fails
(exits non-zero). Prints the rewrite the compiler reports as the nth: pass,
rule or transform, and source offset. COMMAND must pass with no rewrites
and fail with all of them. See scratch/optimizer-design.md, section 9.6.
"""
import os
import subprocess
import sys


def run(command, fuel):
    env = dict(os.environ)
    if fuel is not None:
        env['OTIUM_OPT_FUEL'] = str(fuel)
    result = subprocess.run(command, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    return result.returncode == 0, result.stderr


def main():
    command = sys.argv[1:]
    if not command or command[0] in ('-h', '--help'):
        print(__doc__.strip())
        return 0 if command else 2
    if not run(command, 0)[0]:
        print('opt-bisect: fails with no rewrites, so the optimizer is not the cause', file=sys.stderr)
        return 1
    if run(command, None)[0]:
        print('opt-bisect: passes with every rewrite', file=sys.stderr)
        return 1
    # Find a fuel that fails, then the smallest one.
    good, bad = 0, 1
    while run(command, bad)[0]:
        good, bad = bad, bad * 2
    while bad - good > 1:
        middle = (good + bad) // 2
        if run(command, middle)[0]:
            good = middle
        else:
            bad = middle
    stderr = run(command, bad)[1]
    reported = [line for line in stderr.splitlines() if line.startswith('optimizer: rewrite ')]
    print(f'first failing fuel: {bad}')
    for line in reported:
        print(line)
    return 0


if __name__ == '__main__':
    sys.exit(main())
